{
  "name": "@skryensya/mcp",
  "version": "0.4.0",
  "type": "module",
  "description": "MCP server that lets an AI discover, compose and validate skryensya/ui components by intent, using docs/ai/schemas as the sole source of truth. It never authors new components.",
  "bin": {
    "skryensya-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
