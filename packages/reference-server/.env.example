REFERENCE_DATABASE_URL=postgres://reference:reference@127.0.0.1:5434/reference
REFERENCE_API_TOKEN=replace-with-a-long-random-token
REFERENCE_ALLOWED_ORIGINS=http://localhost:5174,chrome-extension://replace-with-your-extension-id
REFERENCE_PORT=4318
REFERENCE_HOST=127.0.0.1
# Paths relative to packages/reference-server when started by pnpm --filter.
REFERENCE_REPO_ROOT=../..
REFERENCE_ASSETS_DIR=../../tmp/reference-assets
# Optional: leave blank for manual classification.
TYPESAFE_API_KEY=
REFERENCE_JEV_MODEL=jev-1.13
# Optional: leave token blank to collect/review without GitHub publication.
REFERENCE_GITHUB_OWNER=Skryensya
REFERENCE_GITHUB_REPO=ui
REFERENCE_GITHUB_BASE=main
REFERENCE_GITHUB_TOKEN=
# Optional R2/S3 (otherwise use local filesystem storage).
# REFERENCE_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# REFERENCE_S3_BUCKET=references
# REFERENCE_S3_REGION=auto
# REFERENCE_S3_ACCESS_KEY_ID=
# REFERENCE_S3_SECRET_ACCESS_KEY=
# Tests must use a dedicated database, never production.
# REFERENCE_TEST_DATABASE_URL=postgres://reference:reference@127.0.0.1:5434/reference
