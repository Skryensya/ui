{
  "name": "@skryensya/editor",
  "version": "0.1.0",
  "type": "module",
  "description": "The ProseMirror engine behind the Editor contract: schema, commands, keymap, HTML/Markdown/JSON serialization. Framework-agnostic — no React, no Svelte.",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./commands": {
      "types": "./src/commands.ts",
      "default": "./src/commands.ts"
    },
    "./keymap": {
      "types": "./src/keymap.ts",
      "default": "./src/keymap.ts"
    },
    "./serialize": {
      "types": "./src/serialize.ts",
      "default": "./src/serialize.ts"
    },
    "./plugins": {
      "types": "./src/plugins.ts",
      "default": "./src/plugins.ts"
    },
    "./view": {
      "types": "./src/view.ts",
      "default": "./src/view.ts"
    },
    "./focus-modality": {
      "types": "./src/focus-modality.ts",
      "default": "./src/focus-modality.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@skryensya/core": "workspace:*",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
