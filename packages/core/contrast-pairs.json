    { "fg": "--color-text-primary",   "bg": "--color-bg-surface-overlay","min": 4.5, "modes": ["light", "dark"] },
    { "fg": "--color-text-primary",   "bg": "--color-bg-surface-sunken", "min": 4.5, "modes": ["light", "dark"] },

