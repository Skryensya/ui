{
  "name": "@skryensya/storybook-kit",
  "version": "0.0.1-dev",
  "private": true,
  "type": "module",
  "description": "What the React and Vanilla Storybooks share: the stories generator over the docs demos, the translator, the toolbar and the Vite settings. Each Storybook owns its stories and its renderer.",
  "exports": {
    "./generate": { "types": "./src/generate.ts", "default": "./src/generate.ts" },
    "./translate": { "types": "./src/translate.ts", "default": "./src/translate.ts" },
    "./shared": { "types": "./src/shared.ts", "default": "./src/shared.ts" },
    "./vite": { "types": "./src/vite.ts", "default": "./src/vite.ts" },
    "./button-playground": { "types": "./src/button-playground.ts", "default": "./src/button-playground.ts" }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@skryensya/ai-compiler": "workspace:*",
    "@skryensya/core": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
