{
  "name": "@skryensya/storybook-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "What the React and Vanilla Storybooks share: the stories generator over the docs demos, the translator, the toolbar and the Vite settings. Each Storybook owns its stories and its renderer.",
  "exports": {
    "./generate": {
      "types": "./src/generate.ts",
      "default": "./src/generate.ts"
    },
    "./translate": {
      "types": "./src/translate.ts",
      "default": "./src/translate.ts"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "default": "./src/shared.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./button-playground": {
      "types": "./src/button-playground.ts",
      "default": "./src/button-playground.ts"
    },
    "./command-palette-playground": {
      "types": "./src/command-palette-playground.ts",
      "default": "./src/command-palette-playground.ts"
    },
    "./tag-interactions": {
      "types": "./src/tag-interactions.ts",
      "default": "./src/tag-interactions.ts"
    },
    "./controls": {
      "types": "./src/controls.ts",
      "default": "./src/controls.ts"
    },
    "./manager": {
      "types": "./src/manager.ts",
      "default": "./src/manager.ts"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@skryensya/ai-compiler": "workspace:*",
    "@skryensya/core": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.1.6"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.2",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "storybook": "^10.6.2"
  }
}
