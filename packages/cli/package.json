{
  "name": "@skryensya/cli",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Wires skryensya/ui into a project: list the catalog, inspect a component, add it (its CSS, its packages) through a per-framework adapter. It never copies component source.",
  "bin": {
    "skryensya": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run"
  },
  "devDependencies": {
    "@skryensya/core": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
