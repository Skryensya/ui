{
  "name": "@skryensya/ai-compiler",
  "version": "0.0.1-dev",
  "private": true,
  "type": "module",
  "description": "Imports the contracts Core declares, reconciles them with the semantic overlay, and emits the manifest plus the usage-tree emitter that turns a composition into markup or TSX.",
  "scripts": {
    "build": "tsx src/cli.ts ../..",
    "check": "tsc -p tsconfig.json --noEmit && vitest run && tsx src/cli.ts ../..",
    "seed": "tsx src/seed-changelogs.ts ../.."
  },
  "dependencies": {
    "@skryensya/core": "workspace:*",
    "yaml": "^2.9.0",
    "typescript": "^5.9.3",
    "@skryensya/snippets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^4.1.11",
    "tsx": "^4.19.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./emit": {
      "types": "./src/emit.ts",
      "default": "./src/emit.ts"
    },
    "./validate": {
      "types": "./src/validate.ts",
      "default": "./src/validate.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./sheets-for-tree": {
      "types": "./src/sheets-for-tree.ts",
      "default": "./src/sheets-for-tree.ts"
    },
    "./artifact": {
      "types": "./src/artifact.ts",
      "default": "./src/artifact.ts"
    }
  }
}
