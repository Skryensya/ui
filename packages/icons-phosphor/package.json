{
  "name": "@skryensya/icons-phosphor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phosphor bound to skryensya/ui's stable icon vocabulary. Generated from the library; ships data, not a runtime.",
  "files": ["dist", "src", "LICENSE-phosphor"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./carousel.css": "./src/carousel.css"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "node scripts/generate.mjs --check && tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/generate.mjs --check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@skryensya/core": "workspace:*"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "typescript": "^5.9.3"
  }
}
