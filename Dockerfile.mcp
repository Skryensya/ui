# syntax=docker/dockerfile:1.7
# MCP server only (@skryensya/mcp), Streamable HTTP transport (packages/mcp/src/http.ts).
# Build context must be the monorepo root.
# Dokploy: Dockerfile path = Dockerfile.mcp

# POR DIGEST, no sólo por tag. `node:22-bookworm-slim` es un puntero que se mueve: quien controle
# el repo puede reapuntarlo, y dos builds del mismo commit pueden traer imágenes distintas sin que
# nada acá cambie. El digest es la imagen, no un nombre para ella.
#
# LO QUE CUESTA: los parches del sistema operativo de la base dejan de entrar solos al reconstruir.
# Hay que subir el digest a mano, y conviene hacerlo cada tanto. Para sacar el de hoy:
#   docker buildx imagetools inspect node:22-bookworm-slim
# El tag al lado del digest no lo usa Docker para nada, está para que se lea qué versión es.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS build

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.18.2 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/docs/package.json ./apps/docs/package.json
COPY apps/eval-viewer/package.json ./apps/eval-viewer/package.json
COPY packages/ai-compiler/package.json ./packages/ai-compiler/package.json
COPY packages/ai-gates/package.json ./packages/ai-gates/package.json
COPY packages/charts/package.json ./packages/charts/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/devtools/package.json ./packages/devtools/package.json
COPY packages/icons-lucide/package.json ./packages/icons-lucide/package.json
COPY packages/icons-material/package.json ./packages/icons-material/package.json
COPY packages/icons-phosphor/package.json ./packages/icons-phosphor/package.json
COPY packages/mcp/package.json ./packages/mcp/package.json
COPY packages/react/package.json ./packages/react/package.json
COPY packages/vanilla/package.json ./packages/vanilla/package.json
COPY contracts/recipes/package.json ./contracts/recipes/package.json
COPY contracts/snippets/package.json ./contracts/snippets/package.json
COPY evals/package.json ./evals/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store && pnpm fetch --frozen-lockfile

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile --offline

COPY packages/ai-compiler ./packages/ai-compiler
COPY packages/core ./packages/core
COPY packages/mcp ./packages/mcp
COPY packages/react ./packages/react
COPY contracts ./contracts
COPY artifacts ./artifacts

# The compiled manifest the server reads at runtime (packages/mcp/src/manifest.ts never falls back
# to reading source, per its own header comment), then both of the server's own entry points,
# bundled by esbuild with the whole workspace chain (ai-compiler -> core -> recipes -> snippets)
# inlined. Only the two REAL npm dependencies packages/mcp/scripts/build.mjs leaves external
# (@modelcontextprotocol/sdk, zod) are not in this bundle; the runtime stage installs those two
# directly instead of copying this stage's own node_modules, whose @skryensya/* workspace symlinks
# the bundle already made irrelevant.
RUN pnpm --filter @skryensya/ai-compiler build && pnpm --filter @skryensya/mcp build

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS runtime

WORKDIR /app

# Keep these two in sync with packages/mcp/package.json's own "dependencies" field: they are the
# only entries in that file this stage's install has to mirror, everything else there is a
# workspace link already inlined into dist/*.js above.
#
# VERSIONES EXACTAS, NO RANGOS, y --ignore-scripts. Esta línea era el único lugar del repo que
# resolvía dependencias por fuera de todas las reglas que el workspace define, porque es `npm` y no
# `pnpm`: no lee el lockfile, no ve `minimumReleaseAge` y no ve `onlyBuiltDependencies`. Con
# `^1.30.0` cada build tomaba lo más nuevo que hubiera ese día: exactamente la ventana de horas de
# la que el cooldown existe para sacarnos, reabierta acá adentro.
#
# Los dos números son los que `pnpm-lock.yaml` ya tiene resueltos para packages/mcp, así que la
# imagen corre las mismas versiones que la máquina de quien la construyó, y el `^` de
# packages/mcp/package.json sigue siendo la fuente: al subirlo, se suben estos también.
#
# --ignore-scripts es lo que npm no hace solo (pnpm 10 sí): sin eso, un postinstall de cualquiera de
# estos dos, o de sus transitivas, corre como root durante el build.
RUN npm install --omit=dev --no-save --ignore-scripts \
  "@modelcontextprotocol/sdk@1.30.0" "zod@3.25.76"

COPY --from=build /app/packages/mcp/dist ./packages/mcp/dist
COPY --from=build /app/artifacts ./artifacts

# 0.0.0.0, not http.ts's own local-dev default (127.0.0.1): a container is reached through Docker's
# own port mapping, on the container's network interface, never on its loopback. MCP_HTTP_TOKEN is
# deliberately unset here — a secret belongs in the deploy's own env config (`docker run -e
# MCP_HTTP_TOKEN=...`, Dokploy's own environment variables panel), never baked into an image layer.
ENV HOST=0.0.0.0
ENV PORT=8787

EXPOSE 8787

# NO ROOT. Las imágenes `node` traen un usuario `node` sin privilegios justo para esto, y hasta acá
# el proceso corría como root sin necesitarlo: este servidor lee `artifacts/` y `dist/`, escucha un
# puerto alto y no escribe nada. Root acá sólo cambia lo que puede hacer alguien que llegue a
# ejecutar código dentro del contenedor.
#
# Después de los COPY, a propósito: esos traen archivos de root, y el proceso sólo necesita leerlos.
USER node

CMD ["node", "packages/mcp/dist/http.js"]
