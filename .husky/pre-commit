# The icon vocabulary (packages/core/src/icon.ts, stableIconNames) has to be complete across the
# three published sets (CONTEXT.md, "Icon set": "Complete, never partial"). The check ALREADY
# EXISTS: every icon package does `xIcons: IconSet = generated satisfies IconSet`, so a new role
# not added to a set's MAP fails `tsc --noEmit`. But nothing forced it to run locally, and without
# this hook someone could add a stable icon name to core and commit with no warning until that role
# rendered empty in production. Scoped to when the commit actually touches that vocabulary, so the
# rest of the commits do not pay the cost (measured: about 0.9s with turbo/pnpm warm).
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# SECRETS, before anything else, because this is the only thing here that cannot be undone: a commit
# with a key inside stays in history even if the next one removes it, and cleaning it up afterwards
# means rewriting branches. The other checks protect against a bug; this one protects against
# something irreversible.
#
# THIS REPO HAS REAL KEYS WITHIN REACH: `evals/agent/` reads ANTHROPIC_API_KEY and OPENAI_API_KEY
# from the environment, so the shape of this is not hypothetical.
#
# `git --staged`, not `dir .`: it looks at exactly what is about to enter the commit. Measured in
# this repo, `dir .` over the whole tree gives 46 findings, all 46 in `apps/docs/dist/`: ignored
# build output that is never committed, and not one of them a real secret. A hook that shouts 46
# times for nothing is a hook people learn to skip. On what is staged, today: zero.
#
# IF IT IS NOT INSTALLED, IT WARNS AND CONTINUES, it does not block. Same criterion
# scripts/audit-gate.mjs uses with no network: a hook that breaks on a freshly cloned machine
# teaches people to use `--no-verify`, and that habit costs more than this check contributes. The
# warning is loud on purpose.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact --verbose; then
    echo "" >&2
    echo "pre-commit: gitleaks found something that looks like a secret in what you are committing." >&2
    echo "  Above is the file and the line (the value is redacted on purpose)." >&2
    echo "" >&2
    echo "  If it is a real secret: take it out of the file, and if it has been used, ROTATE it." >&2
    echo "  Removing it from the commit does not un-use it." >&2
    echo "" >&2
    echo "  If it is a false positive: add it to .gitleaksignore with the fingerprint that" >&2
    echo "  gitleaks prints above, on its own line and with a comment saying why." >&2
    exit 1
  fi
else
  echo "pre-commit: gitleaks is not installed, this commit was NOT checked for secrets." >&2
  echo "  Install it with 'brew install gitleaks'." >&2
fi

if echo "$staged" | grep -qE '^(packages/core/src/icon\.ts|packages/icons-(lucide|material|phosphor)/)'; then
  echo "pre-commit: the icon vocabulary changed, verifying the three sets are still complete..."
  if ! pnpm --filter @skryensya/icons-lucide --filter @skryensya/icons-material --filter @skryensya/icons-phosphor run check; then
    echo "" >&2
    echo "pre-commit: an icon set is incomplete or out of date." >&2
    echo "  Run 'pnpm --filter @skryensya/icons-lucide --filter @skryensya/icons-material --filter @skryensya/icons-phosphor generate'" >&2
    echo "  and add the missing role to each set's MAP (scripts/generate.mjs)." >&2
    exit 1
  fi
fi
