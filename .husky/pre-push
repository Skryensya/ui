# THE FIRST LINE OF DEFENSE, not the only one. Since `.github/workflows/check.yml` exists there is
# CI, and it runs these same checks on every pull request: it was needed because a PR from a fork runs
# no hook from this machine. This hook still matters just as much, because failing here in seconds is
# worth more than failing on a runner in minutes, and because the push is the last moment something
# can be stopped without rewriting history. That is why the expensive checks live here and not in
# pre-commit: committing stays cheap, publishing is what pays.
#
# ORDER: the one that takes seconds first, the one that takes minutes second.

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# 1. AUDIT. This is the half that warns about the 30-day cooldown (`minimumReleaseAge`,
# pnpm-workspace.yaml): that rule delays EVERY new patch, which is only safe if somebody finds out
# there is a CVE and decides to skip the wait for that package. Without this check, the quarantine
# becomes a delay nobody sees. It fails on high/critical; with no network it warns and continues (the
# script explains why).
echo "pre-push: checking dependencies..."
if ! node scripts/audit-gate.mjs; then
  echo "" >&2
  echo "pre-push: there are high or higher severity vulnerabilities in the dependencies." >&2
  echo "  Above is each one with its path and how to fix it." >&2
  echo "  If it is deliberate and you will resolve it later: 'git push --no-verify'." >&2
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# 2. CHECK. Lint + tests + tsc across the 16 deterministic packages.
#
# `@skryensya/ai-gates` is left OUT on purpose: 730 Playwright tests, about 19 minutes, and today they
# collapse partway through because of the stage rather than because of regressions (the ones that pass
# take 10-13s, the ones that fail 0.3-2s, symmetry aborts at 1ms). A push that takes 20 minutes and
# ends red because of something you did not break teaches people to use --no-verify, and that habit
# carries over to the secret check too. It comes in when it is stable.
#
# --concurrency=1 because in parallel this check has intermittent timeouts in this repo.
echo "pre-push: running check..."
if ! pnpm turbo run check --filter='!@skryensya/ai-gates' --concurrency=1; then
  echo "" >&2
  echo "pre-push: 'check' failed. The output above says which package and why." >&2
  echo "  If you are pushing work in progress to a branch of your own: 'git push --no-verify'." >&2
  exit 1
fi
