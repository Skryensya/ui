msg_file="$1"

# Git runs this hook BEFORE cleaning the message, so the comment lines the editor adds
# (`# Please enter the commit message...`) are still in the file. Validating over them made
# `git commit` without `-m` fail every time: they counted as a body. They are stripped first, the
# same way git does afterwards.
cleaned="$(grep -v '^#' "$msg_file")"
subject="$(printf '%s\n' "$cleaned" | head -n1)"
second="$(printf '%s\n' "$cleaned" | sed -n '2p')"

# Never a co-authorship trailer, from anyone (Cursor, Claude Code, or any other tool).
if printf '%s\n' "$cleaned" | grep -qiE '^(Co-authored-by|Signed-off-by):'; then
  echo "commit-msg: co-authorship trailers are not allowed (Co-authored-by / Signed-off-by)." >&2
  echo "  Remove that line from the message and commit again." >&2
  exit 1
fi

# THE SUBJECT HAS A HARD CAP. It is the only part visible in `git log --oneline`, in GitHub's history
# and in a `git blame`: past a certain length it stops summarizing and becomes a misplaced paragraph,
# which is exactly what the body now exists for. 100 rather than the classic 72 because this history
# already writes long subjects on purpose: measured over the last 200 commits, the median is 56 and
# the 90th percentile is 82, so 72 would have rejected 39 of them and 100 rejects 5.
max=100
if [ "${#subject}" -gt "$max" ]; then
  echo "commit-msg: the subject is ${#subject} characters and the maximum is $max." >&2
  echo "  Received:   $subject" >&2
  echo "  What does not fit is almost always detail: put it in the body, after a blank line." >&2
  exit 1
fi

# IF THERE IS A BODY, IT IS SEPARATED BY A BLANK LINE. This is not aesthetics: git treats the first
# line as the subject and the rest as the body ONLY if there is an empty line between them. Without
# it, `git log --oneline` and GitHub show the whole thing as one very long subject, which is exactly
# what the cap above is trying to avoid.
if [ -n "$second" ]; then
  echo "commit-msg: missing the blank line between the subject and the body." >&2
  echo "  Received on line 2:   $second" >&2
  echo "  A body is welcome, but it has to start after an empty line." >&2
  exit 1
fi

# type(optional scope): description.
#
# The description is free text: it may start uppercase and it may end with a period. Lowercase and no
# trailing period used to be required, and that rule was relaxed on purpose: it changed nothing
# readable in `git log` and it rejected correct messages. What is still required is the type, because
# that is what tells you at a glance what kind of change each commit is.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?: .+$'
if ! printf '%s\n' "$subject" | grep -qE "$pattern"; then
  echo "commit-msg: the message does not follow Conventional Commits." >&2
  echo "  Received:   $subject" >&2
  echo "  Expected:   type(optional scope): description" >&2
  echo "  Types:      feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  Example:    fix(command-palette): defer mobile mount until pointerdown" >&2
  exit 1
fi
