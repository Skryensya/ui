---
/*
 * /playground: this app's only page, and a TOOL rather than a document. It wears its own chrome for
 * exactly that reason (`layouts/Tool.astro`), not the documentation site's navbar.
 *
 * Everything a component page can tell you, it tells you about code you cannot touch. This route
 * exists for the next question, which is always "what if I change it": the same examples the
 * component pages render, opened in an editor that actually runs them, in both bindings.
 *
 * WHAT HAPPENS AT BUILD TIME AND WHAT DOES NOT. The catalogue is usage trees, and the emitters that
 * turn a tree into React and into markup run at build time in
 * `playground-catalogue-[locale].json.ts`. The browser gets strings; it never gets the compiler, the
 * contracts or the trees, which is the same split every ComponentPreview on this site already makes.
 * They arrive as a fetched asset rather than as props on this page: see that endpoint for why.
 */
import Tool from "../layouts/Tool.astro";
import Playground from "../components/react-demos/Playground.tsx";
import { defaultLocale, getLocale, localeNames, locales, useTranslations } from "../i18n";

/* The kit's own paint for the tool itself: the rail, the binding switch and the discard
 * confirmation are components, not one-off markup. Everything the CHROME around them needs - the
 * tokens, Button, typography, the scrollbar - is the layout's, because the layout is what renders
 * it. */
import "@skryensya/core/components/sidebar.css";
import "@skryensya/core/components/tree-view.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/components/tabs.css";
import "@skryensya/core/components/dialog.css";
/* The search palette over this tool's own catalogue, and the keycaps its footer and its trigger
 * badge are drawn with. Both are the kit's, composed here rather than restated. */
import "@skryensya/core/components/command-palette.css";
/* The palette is a Dialog Vaul by default now (the contract's `vaul`): below `desktop` it is a bottom
   sheet with a grab handle. The sheet is this opt-in pattern, so the page that renders a palette
   imports it, the same way the documentation's own shell does. */
import "@skryensya/core/patterns/dialog-vaul.css";
import "@skryensya/core/components/kbd.css";
/* The two icon-only controls in the bar say what they are on hover and on focus, the way the
 * documentation's own header controls do. Tooltip is an anchored box, so the pattern comes with it. */
import "@skryensya/core/components/tooltip.css";
/* The copy button in the file strip: an icon-toggle's faces over a button, which is the composition
 * decision 33 leaves to each consumer now that no CopyButton contract owns that markup. */
import "@skryensya/core/patterns/icon-toggle.css";
import "@skryensya/core/components/icon-state-button.css";
import "@skryensya/core/patterns/anchored.css";
/* The drag edge between the two panes composes the splitter pattern, and the wait inside the preview
 * is the kit's own Loader. Both are opt-in sheets, imported where the markup that uses them lives -
 * even though `sidebar.css` happens to pull the splitter in for its own rail, which is a fact about
 * that component and not a promise to this page. */
import "@skryensya/core/patterns/splitter.css";
import "@skryensya/core/components/loader.css";
/* The language switch is a Menu now (one row per translation, each a real link), so the bar needs
   the component's own sheet. `anchored.css` above already covers where the panel lands. */
import "@skryensya/core/components/menu.css";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const strings = {
  title: t("playground.title"),
  componentsLabel: t("playground.components"),
  bindingLabel: t("playground.binding"),
  react: "React",
  vanilla: "Vanilla",
  loading: t("playground.loading"),
  failed: t("playground.failed"),
  offline: t("playground.offline"),
  docsLink: t("playground.docsLink"),
  filesLabel: t("playground.files"),
  hideRail: t("playground.hideRail"),
  showRail: t("playground.showRail"),
  resizeRail: t("playground.resizeRail"),
  discardTitle: t("playground.discardTitle"),
  discardBody: t("playground.discardBody"),
  discardCancel: t("playground.discardCancel"),
  discardConfirm: t("playground.discardConfirm"),
  resizePanes: t("playground.resizePanes"),
  resizePanesBlock: t("playground.resizePanesBlock"),
  search: t("playground.search"),
  searchPlaceholder: t("playground.searchPlaceholder"),
  /* The three hints and the empty sentence are the CHROME's, shared with the documentation's own
   * palette: "navigate", "open", "close" and "no results" say the same thing in either app, and a
   * second copy here would be a second thing to keep translated. */
  searchEmpty: t("search.empty"),
  searchClose: t("action.close"),
  searchHintNavigate: t("search.hintNavigate"),
  searchHintOpen: t("search.hintOpen"),
  searchHintClose: t("search.hintClose"),
  reload: t("playground.reload"),
  copy: t("playground.copy"),
  copied: t("playground.copied"),
  layoutSideBySide: t("playground.layoutSideBySide"),
  layoutStacked: t("playground.layoutStacked"),
  showCode: t("playground.showCode"),
  showPreview: t("playground.showPreview"),
  language: t("prefs.language"),
};

/*
 * THE TRANSLATIONS OF THIS PAGE, as data for the island's language menu.
 *
 * The menu is rendered by the island (it portals every other control in this bar too), but WHICH
 * addresses exist is this route's knowledge, not the browser's: `/` in the default locale and
 * `/<locale>/` in every other, the same mapping the layout used for its old two-locale link. Passing
 * rows rather than letting the island compute paths keeps that rule in one place.
 */
const languages = locales.map((value) => ({
  value,
  label: localeNames[value],
  href: value === defaultLocale ? "/" : `/${value}/`,
  current: value === locale,
}));
---

<Tool title={t("playground.title")} description={t("playground.description")}>
  {/*
    `client:only` and not `client:load`: Sandpack mounts a bundler in an iframe and reads the
    document to size its editor, so there is no meaningful server render of it - and attempting one
    makes the build import a browser-only dependency graph for markup that would be thrown away on
    hydration anyway.
  */}
  <Playground
    client:only="react"
    catalogue={`/playground-catalogue-${locale}.json`}
    languages={languages}
    strings={strings}
  />
</Tool>

<style is:global>
  /*
   * The tool layout: a rail of components and a stage that fills what is left. Global rather than
   * scoped because the markup it styles is rendered by a React island, which Astro's scoped styles
   * cannot reach.
   */
  /*
   * FLEX, not grid, and the reason is the hide.
   *
   * As a two-track grid (`auto minmax(0, 1fr)`) this worked until the rail could disappear: a
   * `display: none` item leaves the grid entirely, so the stage slid into the FIRST track and sized
   * itself to `auto` - hiding the rail made the editor 794px narrower instead of wider, which is the
   * opposite of what the control promises. A flex row has no tracks to fall into: the rail is as
   * wide as it is, the stage takes what is left, and one of them not being there is not a special
   * case.
   */
  /*
   * SIZED BY ITS PARENT, not by arithmetic against a bar it does not own.
   *
   * This used to be `calc(100dvh - var(--docs-header-block-size))`: the docs layout's own token for
   * the height of the docs header, read from another app's stylesheet, in a page that no longer
   * renders that header. `tool.css` makes the shell a viewport-tall flex column, so the tool simply
   * takes what the chrome above it left - and a chrome that grows a row on a phone moves this with
   * it, which a number never did.
   */
  .playground {
    display: flex;
    flex: 1;
    min-inline-size: 0;
    min-block-size: 0;
    /* The containing block for the rail when it stops being a column and starts being a drawer over
       the stage (below 60rem, further down). Nothing else reads it. */
    position: relative;
  }

  /*
   * THE RAIL AS A DRAWER, below `60rem`.
   *
   * The rail is a fixed 208px, and in flow that is affordable only while the stage keeps a usable
   * width: measured at 390px, an open rail left the stage 182px, narrower than a single line of the
   * JSX it exists to show. So below that width the same panel (same component, same state, same
   * toggle) comes out of flow and is drawn OVER the stage, which is the arrangement a phone has for
   * an index: it covers the work while you pick, and it is gone once you have.
   *
   * `100%` of the block axis and an `inline-size` of its own, because out of flow it no longer
   * inherits the row's height or the flex basis the drag handle writes.
   */
  @media (width < 60rem) {
    .playground__rail {
      position: absolute;
      z-index: 2;
      inset-block: 0;
      inset-inline-start: 0;
      box-shadow: var(--elevation-overlay);
    }

    /*
     * THE SCRIM, which is both the dimming and the target that closes the drawer. A real `<button>`
     * (see `Playground.tsx`), so it is one Tab stop with a name rather than a div with a handler;
     * everything below is undoing what the button component's own reset would otherwise draw.
     */
    .playground__rail-scrim {
      position: absolute;
      z-index: 1;
      inset: 0;
      padding: 0;
      border: 0;
      /* The same veil `dialog.css` mixes for its own `::backdrop`, written from the same tokens: the
         kit publishes no standalone scrim token, and a hand-picked rgba here would be a second answer
         to "what does covered content look like" in one product. */
      background: light-dark(
        color-mix(in oklch, var(--color-text-primary) 40%, transparent),
        color-mix(in oklch, var(--color-bg-canvas) 80%, transparent)
      );
      cursor: pointer;
    }
  }

  @media (width >= 60rem) {
    /* The drawer's own furniture never exists at the widths where the rail is a column. */
    .playground__rail-scrim {
      display: none;
    }
  }

  .playground__rail {
    /*
     * The rail's first row starts level with the bar's title beside it. The component's own block
     * padding is `md`, which is right for a rail that begins at the top of a page; here there is a
     * strip of chrome to its right, and 16px against that strip's 4px left the two columns starting
     * at visibly different heights. Overridden through the hook the component publishes for it.
     */
    --sk-sidebar-padding-block: var(--space-inset-sm);
    /*
     * ONE STEP OFF THE INLINE INSET TOO, `md` (16px) down to `sm` (8px), and for a reason the block
     * padding above already states in the other axis: this rail is a CATALOGUE, not a page margin.
     * The tree already carries its own 8px row inset, so at the component's default the first
     * character of every row sat 24px in from the panel edge while the rail itself is only 13rem
     * wide. Halving the container's inset gives those pixels back to the longest component names
     * (`ComponentPreview`, `CommandPalette`) instead of to blank gutter.
     *
     * The base `--sk-sidebar-padding` hook is the one turned, not `--sk-sidebar-padding-inline`
     * directly: the component derives the inline value as `min(padding, inline-size / 4)`, so
     * setting the base keeps that narrow-rail clamp alive (sidebar.css) instead of pinning a flat
     * number the drag handle could then out-narrow. NOTHING ABOUT THE TREE MOVES: its own
     * `--sk-tree-row-inset` / `--sk-tree-row-gap` / type stay exactly as set below.
     */
    --sk-sidebar-padding: var(--space-inset-sm);
    /*
     * ROOM BETWEEN THE ROWS, through the hooks the tree publishes for it. At the component's default
     * caption type the rows are 24px tall and 6px apart, and sixty of them in a column read as a wall
     * rather than as a list you scan. One step on each hook (8px inset, 8px between rows) is what
     * turns it back into rows; the TYPE stays the component's, because a rail that speaks a different
     * size than every other rail in the kit is a different rail.
     */
    --sk-tree-row-inset: var(--space-inset-sm);
    --sk-tree-row-gap: var(--space-stack-xs);

    border-inline-end: 1px solid var(--color-border-subtle);
  }

  /*
   * THE BINDING SWITCH IN THE RAIL'S HEADER (below 60rem only; `Playground.tsx` decides).
   *
   * Full width of the panel rather than its own 124px: in a 208px drawer a control that stops short
   * of the edge reads as a stray box, while a segmented spanning the header reads as the panel's
   * own top row - which is what it is. The component's `.sk-sidebar__header > *` truncation rule is
   * meant for a brand or a title; a segmented has two labelled halves to keep, so it gets `visible`
   * back and shrinks by its own rules instead.
   */
  .playground__rail-binding > * {
    /* `flex`, not the component's own `inline-flex`: an inline-level track sizes to its content even
       when told to be 100% wide, so the two halves sat packed at the start edge with the rest of the
       header empty beside them. */
    display: flex;
    inline-size: 100%;
    overflow: visible;
  }

  /* EQUAL HALVES. The options size to their labels by default ("Vanilla" is wider than "React"), which
     reads as a control that could not decide where its middle is; in a panel this narrow the split
     should be the panel's, not the words'. */
  .playground__rail-binding .sk-segmented__option {
    flex: 1 1 0;
    min-inline-size: 0;
  }

  /*
   * COLLAPSED MEANS GONE HERE, not narrowed, and that is a deliberate departure from what the
   * component does by default.
   *
   * The kit collapses a sidebar to a rail of ICONS and keeps it in the accessibility tree, which is
   * right for site navigation: an icon per destination still says where each link goes. This rail
   * holds a TREE, where the icons say "folder" and "file" and nothing else - every example would
   * collapse to the same glyph, so the rail would be a column of identical rows. Worse, a zero-width
   * panel with `overflow: hidden` still holds focusable rows, so a keyboard would tab into a rail
   * nobody can see.
   *
   * `display: none` is the honest version of what this toggle promises: the reader asked for the
   * editor to have the room. The state, the storage and the trigger's ARIA are all still the
   * component's; only what "collapsed" LOOKS like is this screen's.
   */
  .playground__rail[data-state="collapsed"] {
    display: none;
  }

  /*
   * A LEAF HERE HAS NO CHEVRON TO ALIGN WITH, so it should not pay for the column.
   *
   * TreeView reserves the indicator column on leaves as well as branches, and that is right in the
   * general case: a folder and a file sitting in the SAME list have to start their labels at the
   * same x, or the list reads as ragged. This catalogue never mixes them - level one is components,
   * level two is examples - so every example row was indented 18px past its own icon for a
   * disclosure arrow that can never appear there.
   *
   * Done by re-declaring the hook the component publishes for that column, on the part that carries
   * it, which is the override surface `tokens.scss` documents. A custom property resolves per
   * element, so branches read their own `--sk-tree-indicator-size` and keep the chevron; only the
   * leaves collapse it. No tree-view rule is overridden and the component is unchanged for everyone
   * else - including the source browser under Referencia, where folders and files DO mix.
   */
  .playground__rail .sk-tree-view__item {
    --sk-tree-indicator-size: 0;
  }

  .playground__stage {
    display: flex;
    flex: 1;
    flex-direction: column;
    /* Both floors are load-bearing: without them a flex item refuses to shrink below its content,
       and the editor's own scrollers would push the page into a horizontal scroll instead. */
    min-inline-size: 0;
    min-block-size: 0;
  }

  /*
   * WHERE YOU ARE, inside the chrome row (`layouts/Tool.astro`): the heading is portalled up there
   * (`ChromeSlot`), so what used to be a strip of its own is now a group in one bar. The rules below
   * are what the group needs and nothing the strip needed: no padding, no border, no wrapping - the
   * row owns those now.
   */
  .playground__heading {
    display: flex;
    gap: var(--space-inline-sm);
    align-items: center;
    min-inline-size: 0;
  }

  /*
   * The `<h1>` at body size. It is still the page's heading and still the first thing a screen
   * reader lands on; it just has no reason to be typeset like a document title in a strip of
   * chrome, where the component name is a label for the panel below it.
   *
   * The element also carries `data-flush`: the site's global `h1:not([data-flush])` rule is a
   * type-plus-attribute selector and outranks this class, so without it the heading stays at
   * display size and the bar cannot get shorter no matter what is written here.
   */
  .playground__title {
    /* The one field in the row that must not be clipped away entirely: it names what everything else
       in the bar acts on. It truncates like the example beside it rather than wrapping the row. */
    overflow: hidden;
    margin: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-label);
    line-height: var(--font-line-height-display);
  }

  .playground__example {
    margin: 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-sm);
    line-height: var(--font-line-height-display);
    text-overflow: ellipsis;
    white-space: nowrap;
  }


  /*
   * THE PREVIEW PANE AND ITS OWN BAR.
   *
   * The wrapper is what Sandpack's row now sizes (the preview used to be the flex child itself), so
   * it carries the flex rules and the preview fills whatever the bar above it leaves. A column, not
   * a row, in both arrangements: the bar is always across the top of the pane it belongs to.
   */
  .playground__preview {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-inline-size: 0;
    min-block-size: 0;
  }

  /*
   * ITS BAR IS THE EDITOR'S TAB STRIP, on the other side of the split: same height, same hairline
   * underneath, same inline inset, so the two panes start at one line rather than at two.
   *
   * The two controls that act on the running demo sit at the leading edge, where the pane's own
   * content starts; the way OUT - the link to the page that documents this example - sits at the
   * trailing edge, which is where this tool already puts the things that leave it (the chrome's own
   * preferences, the wordmark's arrow read the other way). A reader scanning the pane meets what it
   * can do to itself first, and the exit last.
   */
  .playground__preview-bar {
    display: flex;
    gap: var(--space-inline-sm);
    align-items: center;
    justify-content: space-between;
    min-block-size: calc(var(--size-control-md) + 1px);
    /* Same treatment as the chrome above (`tool.css`): with one pane filling the window, this bar's
       two ends ARE the window's, and a landscape phone puts its notch on one of them. */
    padding-inline-start: max(var(--space-inset-md), env(safe-area-inset-left));
    padding-inline-end: max(var(--space-inset-md), env(safe-area-inset-right));
    border-block-end: 1px solid var(--color-border-subtle);
    background: var(--color-bg-canvas);
  }

  .playground__preview-tools {
    display: flex;
    gap: var(--space-inline-xs);
    align-items: center;
    /* The pane can be narrow; these two never wrap away from each other, the link beside them gives
       up its width first (`.playground__docs-link`). */
    flex: none;
    /* First in the bar and first in the source: with `space-between` above, an absent docs link (a
       demo handed over from a docs preview has none) leaves these two exactly where they already
       were, instead of sliding across the pane. */
    order: -1;
  }

  /*
   * Wraps for the same reason the bar around it does, and it is the half that actually overflowed: a
   * phone-width window cannot hold a sentence-long link to the documentation, a two-option switch and
   * two icon controls on one line, and a flex row that cannot wrap pushes them off the end edge into
   * a horizontal scroll of the whole tool instead. Aligned to the end so a wrapped line stays under
   * the controls it belongs to rather than drifting to the middle.
   */
  .playground__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-sm);
    align-items: center;
    justify-content: flex-end;
    /* The floor the link below needs to be ALLOWED to shorten: a flex item's automatic minimum is
       its content, so without this the cluster keeps its full width and hands the overflow up to the
       tool instead of down to the one control that knows how to shrink. */
    min-inline-size: 0;
  }

  /*
   * THE LINK NAMES ITS DESTINATION IN FULL, and gives up the width when there is none.
   *
   * "See the component in the docs" is a sentence, and at phone width, next to a rail that does not
   * collapse, the row it sits in is narrower than the sentence: a flex item's automatic minimum is
   * its content, so the link pushed the whole tool into a horizontal scroll rather than giving way.
   * Flooring that minimum hands the decision to the component, which already knows what to do with a
   * label longer than its box (`components/button.css` truncates it), so the link shortens to an
   * ellipsis and the row stays inside the window.
   */
  .playground__docs-link {
    min-inline-size: 0;
  }

  .playground__note,
  .playground__state {
    margin: 0;
    padding: var(--space-inset-sm) var(--space-inset-lg);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-sm);
  }

  /*
   * A stable node for `Playground.tsx`'s `input` listener to bind to across Sandpack's own
   * remounts (see `editorContainerRef` there) - invisible to layout on purpose, so it inserts
   * nothing between `.playground__stage` and `.sp-wrapper` for the flex rules below to skip past.
   */
  .playground__editor {
    display: contents;
  }

  /*
   * Sandpack ships its own layout and sizes itself from its `editorHeight`; what it does not do is
   * grow to fill a parent. These four rules hand it the leftover height and nothing else - the
   * editor, the preview and the console stay Sandpack's.
   */
  .playground__stage .sp-wrapper {
    display: flex;
    flex: 1;
    min-block-size: 0;
  }

  .playground__stage .sp-layout {
    flex: 1;
    min-block-size: 0;
    /* Square against the chrome above and the viewport edges: it is the tool's surface here, not a
     * card sitting on a page. */
    border-radius: 0;
    border-inline: 0;
    border-block-end: 0;
  }

  .playground__stage .sp-stack {
    block-size: auto;
  }

  /*
   * THE SPLIT, OWNED BY THE READER.
   *
   * The size is a custom property the drag writes on the row (`PaneSplitter`), and the arithmetic
   * that keeps it sane is HERE, in one `clamp()`: neither pane may fall under 16rem, which is about
   * where a line of emitted JSX stops being readable, and the fallback is the even split Sandpack
   * itself would have made. That is the whole value model - the handle writes a number of pixels and
   * reads back what this rule granted, so nothing in JavaScript has to know where the ends are.
   */
  /*
   * The child combinator is load-bearing, not decoration. Sandpack sizes its panes with
   * `.sp-c-ikJbEZ > .sp-c-euXojQ { flex: 1 1 0 }` - two classes, exactly the specificity of
   * `.playground__stage .sp-editor` - and it injects that stylesheet at runtime, so on a tie it
   * comes last and wins. Naming the row as well puts this rule one class ahead of theirs, which is
   * the smallest honest way to say "this pane's size is the reader's, not the library's".
   */
  .playground__stage .sp-layout > .playground__files {
    flex: 0 0 clamp(16rem, var(--playground-editor-size, 50%), calc(100% - 16rem));
  }

  /*
   * THE OTHER ARRANGEMENT: the preview UNDER the code rather than beside it.
   *
   * One flex-direction, and everything else follows from it, which is the whole reason the panes are
   * a flex row in the first place: the splitter already writes its size as a custom property on the
   * row (a different one per axis, see `PaneSplitter`), and a `flex-basis` means the main axis
   * whichever way that axis runs. So the clamp below is the same rule as the side-by-side one with
   * a floor suited to its own axis: 6rem is about four lines of code plus the tab strip, which is
   * where an editor stops being an editor.
   *
   * `flex-wrap: nowrap` is not decoration. Sandpack's own layout wraps, and a wrapping COLUMN breaks
   * into side-by-side columns rather than growing, so a pane that cannot fit would end up beside its
   * neighbour in the arrangement that exists precisely to put it below.
   */
  /*
   * WHERE SANDPACK ITSELF STOPS PUTTING THE PANES SIDE BY SIDE.
   *
   * `@media screen and (max-width: 768px)` is written into the library's own stylesheet (read in
   * `dist/index.js`): at that width its row wraps and each stack goes to `min-width: 100%`. Ours kept
   * a 50% flex-basis through it, so the editor sat alone on a full-width line at half its width, and
   * the preview below it kept a height meant for a row - measured at 768px: a 384px editor on a 768px
   * line, with a 818px preview inside a 819px stage.
   *
   * Matching the number rather than guessing near it, and then reusing the arrangement this tool
   * already has a control for: below it, the panes ARE the stacked layout, with the same clamp and
   * the same custom property the splitter writes.
   */
  @media (width <= 48rem) {
    .playground__stage .sp-layout {
      flex-direction: column;
      flex-wrap: nowrap;
    }

    .playground__stage .sp-layout > .playground__files {
      flex: 0 0 clamp(6rem, var(--playground-editor-block-size, 50%), calc(100% - 6rem));
    }
  }

  .playground__stage[data-pane-layout="stacked"] .sp-layout {
    flex-direction: column;
    flex-wrap: nowrap;
  }

  .playground__stage[data-pane-layout="stacked"] .sp-layout > .playground__files {
    flex: 0 0 clamp(6rem, var(--playground-editor-block-size, 50%), calc(100% - 6rem));
  }

  /*
   * ONE PANE AT A TIME, at the same `48rem` where Sandpack itself stops putting them side by side.
   *
   * Stacking two panes is the right answer while each half is still a pane. On a phone it is not:
