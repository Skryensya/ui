# Publishing sites to <name>.skryensya.dev (ADR-0033). Copy to .env.local, which git ignores.
# The token is the one set as the Worker's secret: `npx wrangler secret put PUBLISH_TOKEN` in apps/sites-worker.
SITES_PUBLISH_TOKEN=
# Defaults shown; change only to publish somewhere else.
# SITES_PUBLISH_URL=https://publish.skryensya.dev
# SITES_DOMAIN=skryensya.dev
