{
  /*
   * Only the code written by hand is checked here. The stories are `apps/storybook`'s generated
   * files, vouched for by its generator (every tree validated against its contracts) and by its
   * `generate-stories.ts --check`; see that app's tsconfig for why they are not type-checked.
   */
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@docs/*": ["../docs/src/*"]
    }
  },
  "include": [".storybook/**/*", "src/**/*"]
}
