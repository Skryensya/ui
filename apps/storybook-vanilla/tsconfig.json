{
  /*
   * Only the code written by hand is checked here, not the generated stories. They reach into the
   * docs' demo modules, which are written and checked (`astro check`) under Astro's base config,
   * which is not strict: under strictNullChecks their untyped tree literals widen and stop matching
   * `UsageTree`. What vouches for a generated file is the generator (every tree validated against its
   * contracts) and `generate-stories.ts --check`.
   */
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@docs/*": ["../docs/src/*"]
    }
  },
  "include": [".storybook/**/*", "scripts/**/*", "src/*.ts", "src/playgrounds/**/*"]
}
