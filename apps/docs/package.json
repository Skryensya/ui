{
  "name": "@skryensya/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Documentation site for skryensya/ui. Consumes @skryensya/core through the same exports map it documents.",
  "scripts": {
    "dev": "astro dev --port 4173",
    "dev:bg": "astro dev --background --port 4173",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:logs:follow": "astro dev logs --follow",
    "dev:restart": "astro dev stop ; astro dev --background --port 4173",
    "dev:clean": "astro dev stop ; rm -rf node_modules/.vite .astro ; astro dev --background --port 4173 --force",
    "check": "astro check && vitest run",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@skryensya/ai-compiler": "workspace:*",
    "@skryensya/charts": "workspace:*",
    "@skryensya/core": "workspace:*",
    "@skryensya/icons-lucide": "workspace:*",
    "@skryensya/icons-material": "workspace:*",
    "@skryensya/icons-phosphor": "workspace:*",
    "@skryensya/react": "workspace:*",
    "@skryensya/recipes": "workspace:*",
    "@skryensya/vanilla": "workspace:*",
    "@tanstack/charts": "0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@skryensya/devtools": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^7.1.0",
    "sass": "^1.83.0",
    "svelte": "^5.56.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
