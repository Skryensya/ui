{
  "name": "@skryensya/docs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Documentation site for skryensya/ui. Consumes @skryensya/core through the same exports map it documents.",
  "scripts": {
    "dev": "astro dev --port 4173",
    "dev:bg": "astro dev --background --port 4173",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:logs:follow": "astro dev logs --follow",
    "dev:restart": "astro dev stop || true ; astro dev --background --port 4173",
    "dev:clean": "astro dev stop || true ; rm -rf node_modules/.vite .astro ; astro dev --background --port 4173 --force",
    "check": "node scripts/generate-icon-sets.ts --check && astro check && vitest run",
    "preview-id": "node scripts/preview-id.ts",
    "build": "astro build",
    "preview": "astro preview",
    "perf:serve": "astro build && astro preview --port 4401",
    "perf:lighthouse": "pnpm dlx lighthouse@13.4.1 ${URL:-http://localhost:4401/} --preset=desktop --chrome-flags=--headless=new --output-path=.lighthouse/report.html --view",
    "perf:unlighthouse": "pnpm dlx @unlighthouse/cli@0.18.1 --site http://localhost:4401",
    "generate:templates": "vitest run src/demos/templates/artifact.test.ts --update",
    "icons": "node scripts/generate-icon-sets.ts"
  },
  "dependencies": {
    "@skryensya/ai-compiler": "workspace:*",
    "@skryensya/core": "workspace:*",
    "@skryensya/examples": "workspace:*",
    "@skryensya/phone": "workspace:*",
    "@skryensya/react": "workspace:*",
    "@skryensya/vanilla": "workspace:*",
    "@zag-js/react": "^1.43.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@iconify-json/bi": "catalog:",
    "@iconify-json/carbon": "catalog:",
    "@iconify-json/fluent": "catalog:",
    "@iconify-json/heroicons": "catalog:",
    "@iconify-json/hugeicons": "catalog:",
    "@iconify-json/iconoir": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/material-symbols": "catalog:",
    "@iconify-json/mdi": "catalog:",
    "@iconify-json/mingcute": "catalog:",
    "@iconify-json/ph": "catalog:",
    "@iconify-json/ri": "catalog:",
    "@iconify-json/solar": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@skryensya/devtools": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "~7.2.8",
    "playwright": "^1.62.0",
    "sass": "^1.83.0",
    "svelte": "^5.56.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
