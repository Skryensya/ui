---
/*
 * Diagnostic only: a `break` harness for Slider and SliderRange (Zag-backed). One scenario per
 * row, the REAL `@skryensya/react` controls in each, labels and nothing else around them.
 *
 * The environment is the site's own: `tokens.scss`, `components/slider.css` and
 * `styles/site.css`, the same ones the docs shell imports. No fonts, colours or token overrides
 * of this page's own - a slider observed under those is a different slider.
 *
 * Not linked from the site nav. `noindex`, like `/debug/layout-grid-rail`.
 *
 * Dev-only: `astro build` runs with NODE_ENV=production (see astro.config.ts), so this 404s out of
 * the static build instead of shipping the break-* classes and the SliderBreak island into dist.
 */
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import "@skryensya/core/tokens.scss";
import "@skryensya/core/components/slider.css";
import "../../styles/site.css";
import { SliderBreak } from "../../components/react-demos/debug-slider-break";

import DebugShell from "../../components/DebugShell.astro";
---

<DebugShell title="Slider">
<style is:global>
      .break-page {
        padding: var(--space-inset-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xl);
      }
      .break-intro {
        max-inline-size: 60ch;
        color: var(--color-text-secondary);
      }
      .break-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-lg);
        padding-block-start: var(--space-stack-md);
        border-block-start: 1px solid var(--color-border-subtle);
      }
      .break-group__title {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-body-sm);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-text-secondary);
      }
      .break-case {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xs);
      }
      .break-case__label {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-primary);
      }
      .break-case__note {
        margin: 0;
        font-size: var(--font-size-caption);
        color: var(--color-text-secondary);
      }
      .break-case__broke {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-danger);
      }
      .break-case__fixed {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-success);
      }
      .break-case__stage {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-stack-md);
        inline-size: 100%;
        max-inline-size: 24rem;
      }
      .break-stack {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-md);
      }
      .break-rtl {
        display: flex;
        gap: var(--space-inline-sm);
        inline-size: 100%;
        max-inline-size: 24rem;
      }
    </style>
<div class="break-page" data-toc-transparent>
  <header>
    <h1>break: Slider</h1>
    <p class="break-intro">
One scenario per row, the real <code>@skryensya/react</code> Slider / SliderRange in
each. Tab through the instances to check focus, and toggle OS dark mode, forced colors,
200% zoom and reduced motion while this page is open: those are viewing modes, so the
page renders nothing for them.
    </p>
  </header>
  <SliderBreak client:load />
</div>
</DebugShell>
