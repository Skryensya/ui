---

<DebugShell title="Index">
<style is:global>
      .break-index {
        max-inline-size: 80rem;
        margin-inline: auto;
        padding: var(--space-inset-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-lg);
      }
      .break-index__progress {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .break-index__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
        gap: var(--space-inline-md);
      }
      .break-index__row {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xs);
        min-inline-size: 0;
        padding: var(--space-inset-md);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-surface);
        background: var(--color-bg-surface);
      }
      .break-index__head {
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-inline-sm);
      }
      .break-index__head a {
        font-size: var(--font-size-body);
        overflow-wrap: anywhere;
      }
      .break-index__count {
        font-size: var(--font-size-caption);
        color: var(--color-text-secondary);
      }
      .break-index__open {
        margin: 0;
        padding-inline-start: var(--space-inset-md);
        font-size: var(--font-size-caption);
        color: var(--color-text-danger);
      }
      .break-index__clean {
        margin: 0;
        font-size: var(--font-size-caption);
        color: var(--color-text-success);
      }
    </style>
<div class="break-index">
      <header>
        <h1>break: index <span class="break-index__progress" data-break-coverage>{coverage.covered}/{coverage.total}</span></h1>
        <p>Componentes documentados con harness · {harnesses.length} páginas de break. No indica que estén libres de errores ni completamente validados.</p>
        <p>All component stress harnesses. Open a page to inspect its worst-case fixtures and findings.</p>
      </header>
      <div class="break-index__grid">
      {
        harnesses.map((h) => (
          <section class="break-index__row">
            <h2 class="break-index__head">
              <a href={h.href}>{h.name} →</a>
              <span class="break-index__count">
                {h.fixed} fixed{h.open.length > 0 ? `, ${h.open.length} open` : ""}
              </span>
            </h2>
            {h.open.length > 0 ? (
              <ul class="break-index__open">
                {h.open.map((item) => <li>{item}</li>)}
              </ul>
            ) : (
              <p class="break-index__clean">No open findings recorded; not a complete pass.</p>
            )}
          </section>
        ))
      }
      </div>
    </div>
</DebugShell>
