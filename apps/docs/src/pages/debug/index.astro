---
/*
 * Diagnostic only: an index of the break harnesses under /debug (same convention as
 * button-break.astro and box-break.astro — one page per component, each the REAL
 * `@skryensya/react` component under one stress scenario per row).
 *
 * The counts below are hand-kept, not derived. Update an entry when a harness gains or fixes a
 * reproducible issue so readers can see what's still open without opening every page.
 *
 * Not linked from the site nav. `noindex`, like every other /debug page. 404s out of the
 * production build (see button-break.astro's own comment on why).
 */
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import "@skryensya/core/tokens.scss";
import "../../styles/site.css";
import { openBreakFindings } from "../../lib/break-findings";
import { getBreakCoverage } from "../../lib/debug-coverage";
import { componentItems } from "../../lib/navigation";
import { catalogBreaks } from "../../lib/debug-catalog";

const harnesses = [
  ...catalogBreaks.map((entry) => ({
    href: entry.href,
    name: componentItems.find(({ href }) => href === entry.docsHref)?.label ?? entry.id,
    fixed: 0,
    open: openBreakFindings(entry.id),
  })),
  { href: "/debug/state-button-break", name: "StateButton", fixed: 0, open: openBreakFindings("state-button") },
  { href: "/debug/split-button-break", name: "SplitButton", fixed: 0, open: openBreakFindings("split-button") },
