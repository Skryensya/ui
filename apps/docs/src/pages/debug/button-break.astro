---
/*
 * Diagnostic only: a `break` harness for Button. One scenario per row, the REAL
 * `@skryensya/react` Button in each, labels and fixed-width containers around it and nothing else.
 *
 * The environment is the site's own: `tokens.scss`, `components/button.css` and `styles/site.css`,
 * the same three the docs shell imports. No fonts, colours or token overrides of this page's own -
 * a button observed under those is a different button.
 *
 * Not linked from the site nav. `noindex`, like `/debug/layout-grid-rail`.
 *
 * Dev-only: `astro build` runs with NODE_ENV=production (see astro.config.ts), so this 404s out of
 * the static build instead of shipping the break-* classes and the ButtonBreak island into dist.
 */
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import "@skryensya/core/tokens.scss";
import "@skryensya/core/components/button.css";
import "../../styles/site.css";
import { siteIconSet } from "../../icons";
import { ButtonBreak } from "../../components/react-demos/debug-button-break";
---

<!doctype html>
<html
  lang="en"
  class="sk-scrollbar"
  data-scheme="system"
  data-icon-set={siteIconSet}
  data-radius="md"
  style="--sk-density: 1"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>break: button</title>
    <style is:global>
      .break-page {
        padding: var(--space-inset-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xl);
      }
      .break-intro {
        max-inline-size: 60ch;
        color: var(--color-text-secondary);
      }
      .break-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-lg);
        padding-block-start: var(--space-stack-md);
        border-block-start: 1px solid var(--color-border-subtle);
      }
      .break-group__title {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-body-sm);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-text-secondary);
      }
      .break-case {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xs);
      }
      .break-case__label {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-primary);
      }
      .break-case__note {
        margin: 0;
        font-size: var(--font-size-caption);
        color: var(--color-text-secondary);
      }
      /* Marks a scenario that visibly broke. Written by the run, read as the report. */
      .break-case__broke {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-danger);
      }
      /* A scenario that broke and has since been fixed. Kept on the page beside the ones that still
         do, so the report reads as a history rather than only a snapshot. */
      .break-case__fixed {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-success);
      }
      .break-case__stage {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-stack-sm);
      }
      /* The only thing the page adds to a scenario: a fixed width to render inside. */
      .break-w-320 {
        inline-size: 320px;
        outline: 1px dashed var(--color-border-default);
      }
      .break-w-1100 {
        inline-size: min(1100px, 100%);
        outline: 1px dashed var(--color-border-default);
      }
      .break-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-inline-sm);
      }
      .break-rtl {
        display: flex;
        gap: var(--space-inline-sm);
      }
      .break-squeeze {
        display: flex;
        align-items: center;
        gap: var(--space-inline-sm);
      }
      .break-squeeze__text {
        flex: 1;
        margin: 0;
        font-size: var(--font-size-body-sm);
      }
      .break-stretch {
        display: grid;
        gap: var(--space-stack-sm);
      }
      .break-weld {
        display: flex;
      }
      /* Cases inside a group that render several buttons side by side. */
      .break-case__stage > .break-row {
        align-self: stretch;
      }
    </style>
  </head>
  <body>
    <div class="break-page">
      <header>
        <h1>break: Button</h1>
        <p class="break-intro">
          One scenario per row, the real <code>@skryensya/react</code> Button in each. Dashed outlines
          are the container the scenario renders inside, not part of the component. Tab through the
          instances to check focus, and toggle OS dark mode, forced colors, 200% zoom and reduced
          motion while this page is open: those are viewing modes, so the page renders nothing for them.
        </p>
      </header>
      <ButtonBreak client:load />
    </div>
  </body>
</html>
