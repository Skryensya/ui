---
/* Dev-only stress harness for tooltip content and placement. */
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import "@skryensya/core/components/button.css";
import "@skryensya/core/components/tooltip.css";
import "@skryensya/core/patterns/anchored.css";
import "../../styles/site.css";
import { TooltipBreak } from "../../components/react-demos/debug-tooltip-break";
import DebugShell from "../../components/DebugShell.astro";
---

<DebugShell title="Tooltip" docsHref="/components/tooltip">
  <TooltipBreak client:only="react" />
</DebugShell>

<style is:global>
  .break-tooltip-stage {
    min-block-size: 7rem;
    padding-block-start: 3rem;
  }
</style>
