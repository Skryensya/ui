---
/*
 * Diagnostic only: a `break` harness for Separator (Separator, LabelledSeparator). One scenario
 * per row, the REAL `@skryensya/react` components in each, labels and fixed-width containers
 * around them and nothing else.
 *
 * The environment is the site's own: `tokens.scss`, `components/separator.css` and
 * `styles/site.css`, the same ones the docs shell imports. No fonts, colours or token overrides
 * of this page's own - a separator observed under those is a different separator.
 *
 * Not linked from the site nav. `noindex`, like `/debug/tag-break`.
 *
 * Dev-only: `astro build` runs with NODE_ENV=production (see astro.config.ts), so this 404s out of
 * the static build instead of shipping the break-* classes and the SeparatorBreak island into dist.
 */
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import "@skryensya/core/tokens.scss";
import "@skryensya/core/components/separator.css";
import "../../styles/site.css";
import { SeparatorBreak } from "../../components/react-demos/debug-separator-break";

import DebugShell from "../../components/DebugShell.astro";
---

<DebugShell title="Separator">
<style is:global>
      .break-page {
        padding: var(--space-inset-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xl);
      }
      .break-intro {
        max-inline-size: 60ch;
        color: var(--color-text-secondary);
      }
      .break-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-lg);
        padding-block-start: var(--space-stack-md);
        border-block-start: 1px solid var(--color-border-subtle);
      }
      .break-group__title {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-body-sm);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-text-secondary);
      }
      .break-case {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xs);
      }
      .break-case__label {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-primary);
      }
      .break-case__note {
        margin: 0;
        font-size: var(--font-size-caption);
        color: var(--color-text-secondary);
      }
      /* Marks a scenario that visibly broke. Written by the run, read as the report. */
      .break-case__broke {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-danger);
      }
      /* A scenario that broke and has since been fixed. Kept on the page beside the ones that still
         do, so the report reads as a history rather than only a snapshot. */
      .break-case__fixed {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-success);
      }
      .break-case__stage {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-stack-sm);
      }
      /* The only thing the page adds to a scenario: a fixed width to render inside. */
      .break-w-320 {
        inline-size: 320px;
        outline: 1px dashed var(--color-border-default);
      }
    </style>
<div class="break-page" data-toc-transparent>
  <header>
    <h1>break: Separator</h1>
    <p class="break-intro">
One scenario per row, the real <code>@skryensya/react</code> Separator family in each.
Dashed outlines are the container the scenario renders inside, not part of the component.
Toggle OS dark mode and forced colors while this page is open: those are viewing modes, so
the page renders nothing for them.
    </p>
  </header>
  <SeparatorBreak client:load />
</div>
</DebugShell>
