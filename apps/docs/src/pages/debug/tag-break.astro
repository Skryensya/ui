---
/*
 * Diagnostic only: a `break` harness for Tag (its three signatures: inert/removable `<span>`,
 * navigable `<a>`, and the toggle `<button>`). One scenario per row, the REAL `@skryensya/react`
 * Tag in each, labels and fixed-width containers around it and nothing else.
 *
 * The environment is the site's own: `tokens.scss`, `components/tag.css`, `components/button.css`
 * (the remove control and Tag.toggle both borrow real Button chrome) and `styles/site.css`, the
 * same ones the docs shell imports. No fonts, colours or token overrides of this page's own - a tag
 * observed under those is a different tag.
 *
 * Not linked from the site nav. `noindex`, like `/debug/layout-grid-rail`.
 *
 * Dev-only: `astro build` runs with NODE_ENV=production (see astro.config.ts), so this 404s out of
 * the static build instead of shipping the break-* classes and the TagBreak island into dist.
 */
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import "@skryensya/core/tokens.scss";
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/button.css";
import "../../styles/site.css";
import { TagBreak } from "../../components/react-demos/debug-tag-break";

import DebugShell from "../../components/DebugShell.astro";
---

<DebugShell title="Tag">
<style is:global>
      .break-page {
        padding: var(--space-inset-lg);
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xl);
      }
      .break-intro {
        max-inline-size: 60ch;
        color: var(--color-text-secondary);
      }
      .break-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-lg);
        padding-block-start: var(--space-stack-md);
        border-block-start: 1px solid var(--color-border-subtle);
      }
      .break-group__title {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-body-sm);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-text-secondary);
      }
      .break-case {
        display: flex;
        flex-direction: column;
        gap: var(--space-stack-xs);
      }
      .break-case__label {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-primary);
      }
      .break-case__note {
        margin: 0;
        font-size: var(--font-size-caption);
        color: var(--color-text-secondary);
      }
      .break-case__broke {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-danger);
      }
      .break-case__fixed {
        margin: 0;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-caption);
        color: var(--color-text-success);
      }
      .break-case__stage {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-stack-sm);
      }
      .break-w-320 {
        inline-size: 320px;
        outline: 1px dashed var(--color-border-default);
      }
      .break-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-inline-sm);
        align-items: center;
      }
      .break-rtl {
        display: flex;
        gap: var(--space-inline-sm);
      }
      .break-squeeze {
        display: flex;
        align-items: center;
        gap: var(--space-inline-sm);
      }
      .break-squeeze__text {
        flex: 1;
        margin: 0;
        font-size: var(--font-size-body-sm);
      }
    </style>
<div class="break-page" data-toc-transparent>
  <header>
    <h1>break: Tag</h1>
    <p class="break-intro">
One scenario per row, the real <code>@skryensya/react</code> Tag in each (its three
signatures: inert/removable, link, toggle). Dashed outlines are the container the
scenario renders inside, not part of the component. Tab through the instances to check
focus, and toggle OS dark mode, forced colors, 200% zoom and reduced motion while this
page is open: those are viewing modes, so the page renders nothing for them.
    </p>
  </header>
  <TagBreak client:load />
</div>
</DebugShell>
