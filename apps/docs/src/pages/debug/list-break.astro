---
/* Dev-only stress harness for List row content and collection size. */
if (import.meta.env.PROD) return new Response(null, { status: 404 });
import "@skryensya/core/components/list.css";
import "../../styles/site.css";
import { ListBreak } from "../../components/react-demos/debug-list-break";
import DebugShell from "../../components/DebugShell.astro";
---
<DebugShell title="List" docsHref="/components/list">
  <ListBreak client:only="react" />
</DebugShell>
<style is:global>
  .break-list-viewport { max-block-size: min(70vh, 42rem); overflow: auto; }
</style>
