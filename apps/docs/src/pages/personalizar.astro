---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/accordion.css";
import "@skryensya/core/components/radio-group.css";
import "@skryensya/core/components/flyout.css";
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/dialog.css";
import "@skryensya/core/components/sidebar.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/stat.css";
import "@skryensya/core/components/steps.css";
import "@skryensya/core/components/slider.css";
import "@skryensya/core/components/progress.css";
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/checkbox.css";
/*
 * /personalizar, explicit ramp configuration, full-bleed tool shell.
 *
 * Left: DS Sidebar hosts the editor (color ramps, density, roundness, icons) with Flyouts.
 * Right: a framed product preview. Only `.sk-canvas` receives complete ramp overrides, so edits
 * stay in the preview while its semantic `--color-*` tokens re-resolve against them. The last edit
 * is saved to localStorage and encoded in the URL; reset clears both.
 */
import Base from "../layouts/Base.astro";
import { STORAGE_KEY } from "@skryensya/core/storage";
import { playgroundPreference } from "../lib/preferences";
import DimensionFlyout from "../components/DimensionFlyout.astro";
import DimensionSelect from "../components/DimensionSelect.astro";
import { allSets, iconMarkup } from "../icons";
import { tokens } from "../lib/tokens";
import { defaultRampColors, rampRecipe } from "../lib/ramps";

const checkboxIndicators = `<span
      class="sk-checkbox__indicator"
      data-state="checked"
    >${iconMarkup("check", { size: "sm" })}</span>
    <span
      class="sk-checkbox__indicator"
      data-state="indeterminate"
    >${iconMarkup("remove", { size: "sm" })}</span>`;
const paginationPrev = iconMarkup("chevron-left", { size: "sm" });
const paginationNext = iconMarkup("chevron-right", { size: "sm" });

/*
 * Curated named colors per role instead of a free picker. A selection is authoring input for this
 * tool only: the browser receives a complete --ramp-{role}-* override, never a hidden Core token.
 * The first preset of each role is its default (`def`).
 */
const RAMPS = [
  {
    role: "accent", label: "Acento", def: defaultRampColors.accent,
    /* Every option is verified (light + dark) for text-on-accent, accent-text and focus-ring contrast,
     * and kept ≥15° in hue from danger (27), warning (75) and success (150) so a brand fill never
     * reads like an error/success/warning state. Pure red, orange-red and grass-green are absent on
     * purpose, they collide with danger and success.
     *
     * Info (233) is the deliberate exception, half this list sits within 15° of it. Colliding with
     * info costs nothing: a brand that reads "informational" is not a false alarm, while a brand that
     * reads "error" is. Anyone who wants the two separated can choose another info ramp. */
    presets: [
      { name: "Azul", value: "oklch(50.4% 0.169 259.6)" },
      { name: "Zafiro", value: "oklch(49% 0.185 270)" },
      { name: "Índigo", value: "oklch(49.5% 0.185 283)" },
      { name: "Violeta", value: "oklch(51% 0.185 300)" },
      { name: "Lila", value: "oklch(52% 0.17 315)" },
      { name: "Magenta", value: "oklch(52% 0.2 344)" },
      { name: "Rosa", value: "oklch(56% 0.185 354)" },
      { name: "Naranja", value: "oklch(52% 0.15 50)" },
      { name: "Turquesa", value: "oklch(50% 0.1 190)" },
      { name: "Cian", value: "oklch(50% 0.115 210)" },
      { name: "Celeste", value: "oklch(54% 0.13 228)" },
      { name: "Cielo", value: "oklch(53% 0.14 242)" },
    ],
  },
  {
    role: "neutral", label: "Neutro", def: defaultRampColors.neutral,
    presets: [
      { name: "Gris", value: "oklch(58.8% 0.018 260)" },
      { name: "Acero", value: "oklch(58% 0.08 248)" },
      { name: "Pizarra", value: "oklch(56% 0.09 235)" },
      { name: "Arena", value: "oklch(59% 0.08 80)" },
      { name: "Piedra", value: "oklch(58% 0.06 55)" },
      { name: "Topo", value: "oklch(58% 0.09 45)" },
    ],
  },
  {
    role: "danger", label: "Peligro", def: defaultRampColors.danger,
    presets: [
      { name: "Rojo", value: "oklch(56% 0.208 27)" },
      { name: "Guinda", value: "oklch(52% 0.18 8)" },
      { name: "Carmesí", value: "oklch(57% 0.205 20)" },
      { name: "Ladrillo", value: "oklch(58% 0.165 40)" },
    ],
  },
  {
    role: "success", label: "Éxito", def: defaultRampColors.success,
    presets: [
      { name: "Verde", value: defaultRampColors.success },
      { name: "Jade", value: "oklch(56% 0.1 175)" },
      { name: "Lima", value: "oklch(63% 0.15 130)" },
      { name: "Esmeralda", value: "oklch(55% 0.15 160)" },
    ],
  },
  {
    role: "warning", label: "Aviso", def: defaultRampColors.warning,
    presets: [
      { name: "Ámbar", value: defaultRampColors.warning },
      { name: "Naranja", value: "oklch(62% 0.15 55)" },
      { name: "Oro", value: "oklch(70% 0.13 90)" },
      { name: "Mostaza", value: "oklch(61% 0.1 88)" },
    ],
  },
  {
    /* Info es el único rol de feedback que puede chocar de hue con el acento: los dos son azules por
     * defecto. Por eso las opciones se abren hacia el cian y el teal, para separar el aviso
     * informativo de la marca cuando la marca se queda en azul. */
    role: "info", label: "Info", def: defaultRampColors.info,
    presets: [
      { name: "Azur", value: "oklch(56% 0.12 233)" },
      { name: "Cian", value: "oklch(56% 0.11 215)" },
      { name: "Teal", value: "oklch(56% 0.1 198)" },
      { name: "Cobalto", value: "oklch(54% 0.14 245)" },
    ],
  },
];

const PAIRS = [
  { fg: "--color-text-primary", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-secondary", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-tertiary", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-on-accent", bg: "--color-action-primary", min: 4.5 },
  { fg: "--color-text-on-accent", bg: "--color-action-danger", min: 4.5 },
  { fg: "--color-text-accent", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-danger", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-success", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-warning", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-info", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-border-default", bg: "--color-bg-canvas", min: 3 },
  { fg: "--color-border-focus", bg: "--color-bg-canvas", min: 3 },
];

// Icon family is a preview-only theme variable: the options are the three published sets, and a small
// gallery in the preview makes the choice visible (swapped in place, scoped to .sk-canvas).
const ICON_SET_OPTIONS = allSets.map((s) => ({ value: s.id, label: s.label }));
const PREVIEW_ICONS = [
  "search", "settings", "user", "calendar",
  "download", "edit", "copy", "filter",
  "check", "info", "refresh", "delete",
] as const;

const clientData = JSON.stringify({
  pairs: PAIRS,
  ramps: RAMPS,
  recipe: rampRecipe,
  iconSets: allSets.map((s) => s.id),
});

/*
 * The preview is self-contained. Color tokens are re-declared so they re-resolve against complete
 * ramp overrides written on `.sk-canvas`. Space / size / radius tokens are re-declared for the same
 * reason the density and radius controls exist: they read `--sk-density` /
 * `--radius-multiplier`, and those are overridden on `.sk-canvas`. A token declared only on `:root`
 * keeps `:root`'s value no matter what a subtree sets the multiplier to (var() in a custom property
 * resolves where the property is declared). Component hooks inherit these and re-resolve for free.
 */

const SCOPED_PREFIXES = ["--color-", "--space-", "--size-", "--radius-"];
const semScopedCss =
  ".sk-canvas {\n" +
  tokens
    .filter((t) => t.tier === "semantic" && SCOPED_PREFIXES.some((p) => t.name.startsWith(p)))
    .map((t) => `  ${t.name}: ${t.value};`)
    .join("\n") +
  "\n}";

const stageCss = semScopedCss;

/*
 * The playground's share code is a SLOT in the one shared entry, not a key of its own. The inline
 * script below cannot import the storage primitive, so the key and the slot travel in from the real
 * declaration: the same arrangement, and the same reason, as `PREPAINT` in Base.astro.
 */
const STORAGE = { key: STORAGE_KEY, slot: playgroundPreference.slot };
---

<Base fullBleed title="Configurar la marca" description="Ajusta rampas de color, densidad y redondez; revisa el contraste y comparte el preset como un código corto.">
  <script type="application/json" id="sk-data" set:html={clientData} is:inline />
  <style is:global set:html={stageCss}></style>

  <div class="sk-config">
    <!-- Editor: DS Sidebar shell (no collapse). Sidebar pickers are DimensionFlyout → data-sk-flyout. -->
    <aside
      class="sk-sidebar sk-config__sidebar"
      aria-label="Editar marca"
    >
      {/* No header: the rail is a list of settings, one line each, and the page owns the title. */}
      <div class="sk-sidebar__content sk-scrollbar sk-scrollbar--reveal">
        <section class="sk-sec">
          <h2>Color</h2>
          <div class="sk-ramps">
            {
              RAMPS.map((ramp) => (
                <DimensionFlyout
                  id={`ramp-${ramp.role}`}
                  prop={ramp.role}
                  row={ramp.role}
                  value={ramp.def}
                  placeholder="Personalizado"
                  label={ramp.label}
                  options={ramp.presets.map((preset) => ({ value: preset.value, label: preset.name }))}
                />
              ))
            }
          </div>
        </section>

        <section class="sk-sec">
          <h2>Forma e íconos</h2>
          <div class="sk-dimensions">
            <DimensionFlyout
              id="sk-dim-density"
              prop="--sk-density"
              label="Densidad"
              value="1"
              options={[
                { value: "0.5", label: "Condensada" },
                { value: "0.6", label: "Densa" },
                { value: "0.8", label: "Compacta" },
                { value: "1", label: "Cómoda" },
                { value: "1.2", label: "Amplia" },
              ]}
            />
            <DimensionFlyout
              id="sk-dim-radius"
              prop="--radius-multiplier"
              label="Redondez"
              value="1"
              options={[
                { value: "0", label: "Recta" },
                { value: "0.5", label: "Sutil" },
                { value: "1", label: "Suave" },
                { value: "1.5", label: "Marcada" },
                { value: "2", label: "Redonda" },
              ]}
            />
            <DimensionFlyout
              id="sk-dim-icons"
              prop="icon-set"
              label="Íconos"
              value="lucide"
              options={ICON_SET_OPTIONS}
            />
          </div>
        </section>
      </div>

      {/* The whole footer is the preset: a ten-character code that IS the theme (it round-trips
          through the URL hash), so copying it copies the link that reproduces this configuration.
          The two icon buttons beside it are the audit and the reset, no export, nothing else. */}
      <div class="sk-sidebar__footer sk-config__footer">
        <button class="sk-preset sk-interactive" id="sk-preset" type="button" title="Copiar link del preset" aria-label="Copiar link del preset">
          <code class="sk-preset__code" id="sk-preset-code">··········</code>
          <span class="sk-preset__icon" aria-hidden="true">
            <span data-state="idle"><Fragment set:html={iconMarkup("copy", { size: "sm" })} /></span>
            <span data-state="copied"><Fragment set:html={iconMarkup("check", { size: "sm" })} /></span>
          </span>
        </button>
        <button class="sk-mini sk-mini--tally sk-interactive" id="sk-contrast-open" type="button" title="Revisar contraste" aria-label="Revisar contraste"><span id="sk-tally" class="sk-tally">00/00</span></button>
        <button class="sk-mini sk-interactive" id="sk-reset-all" type="button" title="Reiniciar" aria-label="Reiniciar"><Fragment set:html={iconMarkup("refresh", { size: "sm" })} /></button>
      </div>
      <span class="sk-sr" id="sk-copy-live" aria-live="polite"></span>
    </aside>

    <div class="sk-config__stage">
    <section class="sk-preview" aria-label="Showcase de componentes" data-sk-tabs id="sk-views" data-value="showcase">
      {/* Each site context is its own tab: the same tokens, judged across different products. */}
      <div class="sk-views sk-tabs__list sk-scrollbar" data-sk-tabs-list aria-label="Vistas del showcase">
        <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="showcase" type="button">Showcase</button>
        <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="dashboard" type="button">Dashboard</button>
        <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="landing" type="button">Landing</button>
        <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="store" type="button">Comercio</button>
      </div>
      {/* The frame is docs chrome and sits OUTSIDE the themed region on purpose: `.sk-canvas` is where
          every semantic --color-/--space-/--size-/--radius- token is re-declared, so a frame painted
          there would follow the edits. The card must hold still while its contents change. */}
      <div class="sk-frame">
      <div class="sk-canvas sk-scrollbar sk-scrollbar--reveal">
      <!-- probes resolve the PREVIEW's colors (they live inside the themed region), per scheme -->
      <span class="sk-probe" style="color-scheme: light"><span id="sk-probe-light"></span></span>
      <span class="sk-probe" style="color-scheme: dark"><span id="sk-probe-dark"></span></span>

      <div class="sk-tabs__content sk-view" data-sk-tabs-content data-value="showcase">
      <!-- Bento shelf: one dense grid, asymmetric spans so the theme reads as a composition. -->
      <div class="sk-bento">
        <div class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="kpi"><div class="sk-flow"><div class="sk-stat-row"><span class="sk-stat-ico" data-tone="accent"><Fragment set:html={iconMarkup("download")} /></span><div class="sk-stat"><span class="sk-stat__label">Ingresos</span><span class="sk-stat__value">$48.2k</span><span class="sk-stat__change" data-trend="up"><Fragment set:html={iconMarkup("arrow-up")} />12.5%</span></div></div></div></div>
        <div class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="cell"><div class="sk-flow"><div class="sk-stat-row"><span class="sk-stat-ico" data-tone="accent"><Fragment set:html={iconMarkup("user")} /></span><div class="sk-stat"><span class="sk-stat__label">Usuarios</span><span class="sk-stat__value">3,914</span><span class="sk-stat__change" data-trend="up"><Fragment set:html={iconMarkup("arrow-up")} />4.1%</span></div></div></div></div>
        <div class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="cell"><div class="sk-flow"><div class="sk-stat-row"><span class="sk-stat-ico" data-tone="accent"><Fragment set:html={iconMarkup("calendar")} /></span><div class="sk-stat"><span class="sk-stat__label">Órdenes</span><span class="sk-stat__value">1,204</span><span class="sk-stat__change" data-trend="down"><Fragment set:html={iconMarkup("arrow-down")} />2.3%</span></div></div></div></div>
        <div class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="kpi"><div class="sk-flow"><div class="sk-stat-row"><span class="sk-stat-ico" data-tone="danger"><Fragment set:html={iconMarkup("arrow-down")} /></span><div class="sk-stat"><span class="sk-stat__label">Churn</span><span class="sk-stat__value">0.9%</span><span class="sk-stat__change" data-trend="neutral">estable</span></div></div></div></div>

        <!-- derived ramps, the brand tool's own subject (decorative, no component) -->
        <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="wide">
          <header><Fragment set:html={iconMarkup("edit")} /><strong>Rampas explícitas</strong></header>
          <div class="sk-flow">
            <p class="sk-panel__desc">Son rampas explícitas; cada posición llega como un token tier 1.</p>
            {["neutral", "accent", "danger", "success", "warning", "info"].map((role) => (
              <div class="sk-ramp-row">
                <span class="sk-ramp-label">{role}</span>
                <div class="sk-ramp">
                  {[50, 100, 200, 300, 400, 500, 600, 700, 800, 900].map((s) => (
                    <i style={`background: var(--ramp-${role}-${s})`} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- chart (decorative): tall companion to the ramps hero -->
        <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="wide">
          <header><Fragment set:html={iconMarkup("calendar")} /><strong>Visitas por día</strong></header>
          <div class="sk-flow sk-flow--fill">
            <div class="sk-chart sk-chart--tall">
              <i style="height: 40%"></i><i style="height: 62%"></i><i style="height: 48%"></i>
              <i style="height: 78%"></i><i style="height: 92%"></i><i style="height: 70%"></i><i style="height: 55%"></i>
            </div>
          </div>
        </section>

        <!-- surfaces: every bg token, so the neutral undertone is legible directly -->
        <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="wide">
          <header><Fragment set:html={iconMarkup("copy")} /><strong>Superficies</strong></header>
          <div class="sk-flow">
            <p class="sk-panel__desc">Todas heredan el undertone del neutro elegido.</p>
            <div class="sk-surfaces">
              {[
                ["Canvas", "--color-bg-canvas"],
                ["Surface", "--color-bg-surface"],
                ["Raised", "--color-bg-surface-raised"],
                ["Sunken", "--color-bg-surface-sunken"],
                ["Well", "--color-bg-well"],
              ].map(([label, token]) => (
                <div class="sk-surf" style={`background: var(${token})`}>
                  <span>{label}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- icon family: preview-only theme variable -->
        <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="wide">
          <header><Fragment set:html={iconMarkup("settings")} /><strong>Iconografía</strong></header>
          <div class="sk-flow">
            <p class="sk-panel__desc">La familia de íconos elegida, aplicada al preview.</p>
            <div class="sk-icons">
              {PREVIEW_ICONS.map((name) => (
                <span class="sk-icon"><Fragment set:html={iconMarkup(name)} /></span>
              ))}
            </div>
          </div>
        </section>

        <!-- form: Field + Input + Select + Checkbox + Button -->
        <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="wide">
          <header><Fragment set:html={iconMarkup("user")} /><strong>Crear cuenta</strong></header>
          <div class="sk-flow">
            <p class="sk-panel__desc">Empieza con tu correo. Es gratis por 14 días.</p>
            <div class="sk-field">
              <label class="sk-field__label" for="cs-name">Nombre</label>
              <input class="sk-input" id="cs-name" value="Ada Lovelace" />
            </div>
            <div class="sk-field">
              <label class="sk-field__label" for="cs-mail">Correo</label>
              <input class="sk-input" id="cs-mail" type="email" value="ada@example.com" />
            </div>
            <DimensionSelect
              id="cs-plan"
              label="Plan"
              options={[
                { value: "starter", label: "Starter" },
                { value: "pro", label: "Pro" },
                { value: "enterprise", label: "Enterprise" },
              ]}
            />
            <label class="sk-checkbox">
              <input class="sk-checkbox__input" type="checkbox" checked />
              <span class="sk-checkbox__control sk-interactive" aria-hidden="true"><Fragment set:html={checkboxIndicators} /></span>
              <span class="sk-checkbox__label">Acepto los términos</span>
            </label>
            <div class="sk-row sk-row--end">
              <button class="sk-button sk-interactive" data-variant="ghost" type="button"><Fragment set:html={iconMarkup("close")} />Cancelar</button>
              <button class="sk-button sk-interactive" data-variant="primary" type="button"><Fragment set:html={iconMarkup("check")} />Crear cuenta</button>
            </div>
          </div>
        </section>

        <!-- validation summary -->
        <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="wide">
          <header><Fragment set:html={iconMarkup("warning")} /><strong>Revisar datos</strong><span class="sk-badge" data-tone="danger">2 errores</span></header>
          <div class="sk-flow">
            <p class="sk-panel__desc">Corrige estos campos antes de guardar los cambios.</p>
            <ul class="sk-validation-list">
              <li><Fragment set:html={iconMarkup("warning")} /><span><strong>Correo de facturación</strong><small>Incluye un dominio válido, por ejemplo ada@ejemplo.com.</small></span></li>
              <li><Fragment set:html={iconMarkup("warning")} /><span><strong>Empresa</strong><small>Indica el nombre legal que debe aparecer en las facturas.</small></span></li>
            </ul>
            <div class="sk-row sk-row--end"><button class="sk-button sk-interactive" data-variant="primary" type="button"><Fragment set:html={iconMarkup("check")} />Revisar y guardar</button></div>
          </div>
        </section>

        <!-- accordion -->
        <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="none" data-bento="wide">
          <header><Fragment set:html={iconMarkup("upload")} /><strong>Detalles del despliegue</strong></header>
          <div class="sk-flow">
            <div data-sk-accordion data-type="single" data-default-value="runtime">
              <section class="sk-tile sk-tile--expandable sk-interactive" data-part="item" data-value="runtime">
                <button class="sk-tile__trigger" type="button" data-part="trigger" aria-expanded="true" aria-controls="cs-deploy-runtime">
                  <span class="sk-tile__content"><span class="sk-tile__title">Runtime y región</span><span class="sk-tile__description">Producción · Frankfurt</span></span><span class="sk-tile__chevron" data-part="chevron" aria-hidden="true"><span data-state="closed"><Fragment set:html={iconMarkup("chevron-down")} /></span><span data-state="open"><Fragment set:html={iconMarkup("chevron-up")} /></span></span>
                </button>
                <div class="sk-tile__expandable-content" id="cs-deploy-runtime" data-part="content"><p class="sk-tile__description">Node 22 · 3 réplicas · desplegado hace 8 minutos.</p></div>
              </section>
              <section class="sk-tile sk-tile--expandable sk-interactive" data-part="item" data-value="rollout">
                <button class="sk-tile__trigger" type="button" data-part="trigger" aria-expanded="false" aria-controls="cs-deploy-rollout">
                  <span class="sk-tile__content"><span class="sk-tile__title">Estrategia de rollout</span><span class="sk-tile__description">Publicación gradual</span></span><span class="sk-tile__chevron" data-part="chevron" aria-hidden="true"><span data-state="closed"><Fragment set:html={iconMarkup("chevron-down")} /></span><span data-state="open"><Fragment set:html={iconMarkup("chevron-up")} /></span></span>
                </button>
                <div class="sk-tile__expandable-content" id="cs-deploy-rollout" data-part="content" hidden><p class="sk-tile__description">10% por cinco minutos, luego 50% y verificación de salud antes del 100%.</p></div>
              </section>
