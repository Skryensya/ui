<style>
  /* Full-bleed tool shell: starts at `main.sk-main` and grows past it. The DOCUMENT scrolls, so the
     rail sticks under the navbar instead of being a fixed-height column, and nothing here clips. */
  .sk-config {
    display: flex;
    /* `start`, not `stretch`: a stretched child fills the row and sticky has nothing left to do. */
    align-items: flex-start;
    max-inline-size: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .sk-config__sidebar {
    flex: none;
    /* Same sticky-under-navbar contract as the docs sidebar and toc (site.css): both the offset and
       the height read the navbar's MEASURED height, so the rail sits flush and fills exactly the
       viewport below it while the preview scrolls past. */
    position: sticky;
    top: var(--docs-navbar-h, var(--docs-header-block-size));
    /* Sticky creates a stacking context, so the rail's Flyout panels (`position: fixed` at
       `--z-popover`) are trapped inside it and can only rise as high as the rail itself. At
       `auto` the rail sits at 0 with the stage's positioned tab triggers, which come LATER in the
       DOM and win the tie, so an open panel had the view switcher printed through it. Same token
       as the navbar (`.dimensions`, site.css): this is pinned chrome that content scrolls under. */
    z-index: var(--z-sticky);
    block-size: calc(100dvh - var(--docs-navbar-h, var(--docs-header-block-size)));
    /* Clip the rail; `.sk-sidebar__content` owns the scroll inside it. */
    overflow: hidden;
  }

  .sk-config__sidebar .sk-sidebar__content {
    display: flex;
    flex-direction: column;
    /* Keep overflow:auto always. The enhanced Select positioner is `position: fixed` (CSS anchors),
       so open menus escape this scrollport without lifting it. Toggling overflow:visible on open
       dropped the scrollbar gutter and widened the form ~11px (CLS). */
  }

  /* One row: the preset code takes what is left, the two icon buttons are fixed lanes.
     minmax(0, …) on the code lane so a long-ish code can't push the buttons out (CLS). */
  .sk-config__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 4px;
    align-items: center;
    inline-size: 100%;
  }

  .sk-config__stage {
    flex: 1;
    min-inline-size: 0;
    display: flex;
    padding: clamp(12px, 2vw, 24px);
  }

  /* Not a framed window any more: the tabs sit ABOVE the card and `.sk-canvas` IS the card. This is
     only the column that stacks them, so it clips nothing and opens no scrollport: the document
     scrolls. (`overflow: clip` + `contain: paint` used to live here precisely to keep the tall canvas
     out of the document's scrollable overflow; that is now exactly what we want it to do.) */
  .sk-preview {
    flex: 1;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
  }

  /* The view switcher is a bare strip above the card, no window chrome behind it. core/tabs.css ships
     only styling-hook tokens (no element rules), so this page maps them to paint itself, the
     consumer's job, exactly as decisión 8 frames it. */
  .sk-views {
    flex: none;
    display: flex;
    align-items: stretch;
    gap: 2px;
    /* Match the showcase shelf gutter so the first tab lines up with the card content,
       clear of the frame's top-start curve. */
    padding-inline-start: clamp(20px, 3vw, 40px);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }
  .sk-views::-webkit-scrollbar { display: none; }
  .sk-views .sk-tabs__trigger {
    position: relative; flex: none; display: inline-flex; align-items: center; white-space: nowrap;
    /* -1px so the selected trigger's underline paints OVER the frame's top border instead of
       stacking a second line above it: the tab and the card read as one piece. The trigger is
       positioned, the frame is not, so the underline wins the paint order without a z-index. */
    /* Height comes from padding, not a floor: otherwise pt/pb never show. */
    min-block-size: 0;
    padding-block: 14px;
    padding-inline: 8px;
    margin-block-end: -1px;
    border: 0; border-radius: 8px 8px 0 0;
    background: transparent; color: var(--color-text-tertiary);
    font: inherit; font-size: var(--font-size-body-sm); font-weight: 500;
    cursor: pointer; transition: color 0.14s ease;
  }
  .sk-views .sk-tabs__trigger:hover { color: var(--color-text-secondary); }
  .sk-views .sk-tabs__trigger[data-selected] { color: var(--color-text-primary); }
  .sk-views .sk-tabs__trigger[data-selected]::after { content: ""; position: absolute; inset-inline: 6px; inset-block-end: 0; block-size: 2px; border-radius: 2px 2px 0 0; background: var(--color-action-primary); }
  .sk-views .sk-tabs__trigger:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: calc(-1 * var(--focus-ring-width)); }
  /* Product pages (dashboard, landing, store) own the full frame, no block gutter.
     Showcase is a component shelf: it needs equal inset on every side, so it must win
     after the tabs content reset. */
  .sk-canvas .sk-tabs__content { padding-block: 0; }
  .sk-canvas .sk-tabs__content[hidden] { display: none; }
  .sk-canvas .sk-tabs__content.sk-view[data-value="showcase"] {
    padding: clamp(20px, 3vw, 40px);
  }

  /* Stacked editor over preview: the rail is a full-width band at the top of the document, so it
     stops sticking (a sticky band would eat half the viewport on the way down). */
  @media (max-width: 860px) {
    .sk-config {
      flex-direction: column;
      align-items: stretch;
    }
    .sk-config__sidebar {
      position: static;
      inline-size: 100%;
      block-size: auto;
      border-inline-end: 0;
      border-block-end: 1px solid var(--color-border-subtle);
    }
    .sk-config__sidebar .sk-sidebar__content {
      max-block-size: min(28rem, 50dvh);
    }
    .sk-config__stage {
      padding: 12px;
    }
  }
  /* Two quiet groups, one hairline between them. No section chrome beyond the caption. */
  .sk-sec { padding-block: 12px; border-block-end: 1px solid var(--color-border-subtle); }
  .sk-sec:first-child { padding-block-start: 0; }
  .sk-sec:last-child { border-block-end: 0; padding-block-end: 0; }
  .sk-sec h2 {
    margin: 0 0 6px;
    padding-inline: 8px;
    color: var(--color-text-tertiary);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Both lists are the same thing: one Field per row, each wrapping a Flyout. Each row STACKS the
     label over the trigger (the Flyout's own default): a caption on its own line, then the
     value-carrying button below it. Stacked, not side-by-side, so the Material set's wider glyph
     never meets the label. The trigger keeps its box: it is always a visible, bordered button. */
  .sk-ramps,
  .sk-dimensions { display: grid; gap: var(--space-stack-lg); }

  /* Small gap between caption and button, so each pair groups tightly while the larger stack gap
     above pushes it clear of the row before. */
  .sk-config__sidebar :global(.sk-flyout) { gap: 4px; }
  /* Caption over the value: the label is a quiet header for the control beneath it. */
  .sk-config__sidebar :global(.sk-flyout__label) {
    padding-inline-start: 2px;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-caption);
    white-space: nowrap;
  }
  .sk-config__sidebar :global(.sk-flyout__trigger) {
    /* control-md already carries the minimum-target floor, so dropping the touch-target max
       shortens the button without taking the hit area below it. */
    --sk-flyout-height: var(--size-control-md);
    --sk-flyout-font-size: var(--font-size-body-sm);
  }

  /* refresh() marks the rows carrying an override. The row's VALUE is the text that says what
     changed ("Azul" → "Violeta"); the accent tint is a redundant cue on top of it, so nothing is
     carried by color alone (WCAG 1.4.1). */
  .sk-config__sidebar :global(.is-overridden .sk-flyout__value) { color: var(--color-text-accent); }

  /* Audit is compact in the builder and detailed only when asked for. */
  /* Same digit shape as the live audit ("22/22") so the footer track width is correct before JS runs. */
  .sk-tally { display: block; font-size: 11px; font-variant-numeric: tabular-nums; font-weight: 600; text-align: center; }
  .sk-tally.ok { color: var(--color-text-success); }
  .sk-tally.bad { color: var(--color-text-danger); }
  .sk-audit { display: grid; gap: 1px; }
  /* Rows are injected by JS, so scope through the static audit container. */
  #sk-audit :global(.sk-audit-row) { display: grid; grid-template-columns: 1fr 44px 44px; gap: 8px; align-items: center; padding: 4px 0; }
  #sk-audit :global(.sk-audit-head) { padding-bottom: 6px; }
  #sk-audit :global(.sk-audit-head span) { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-tertiary); text-align: center; }
  #sk-audit :global(.sk-audit-row code) { font-size: 11px; color: var(--color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #sk-audit :global(.sk-badge2) { font-variant-numeric: tabular-nums; font-weight: 600; padding: 3px 0; border-radius: 6px; font-size: 11px; text-align: center; }
  #sk-audit :global(.sk-badge2.ok) { background: var(--color-bg-success-subtle); color: var(--color-text-success); }
  #sk-audit :global(.sk-badge2.bad) { background: var(--color-bg-danger-subtle); color: var(--color-text-danger); }

  /* The preset chip: the code reads as data, so it is monospace on a sunken well, and the copy
     glyph is the only affordance. `is-copied` swaps the glyph for a check, no label swap, so the
     lane never resizes. */
  .sk-preset {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px;
    align-items: center;
    min-inline-size: 0;
    min-block-size: var(--size-control-sm);
    padding-inline: 8px;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-bg-surface-sunken);
    color: var(--color-text-secondary);
    font: inherit;
    cursor: pointer;
  }
  .sk-preset__code {
    overflow: hidden;
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-align: start;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sk-preset__icon { display: inline-grid; color: var(--color-text-tertiary); }
  .sk-preset__icon > span { grid-area: 1 / 1; }
  .sk-preset__icon > [data-state="copied"],
  .sk-preset.is-copied .sk-preset__icon > [data-state="idle"] { display: none; }
  .sk-preset.is-copied .sk-preset__icon > [data-state="copied"] { display: block; color: var(--color-text-success); }

  /* Same visually-hidden recipe the DS uses for CopyButton's label (copy-button.css). */
  .sk-sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }

  /* Audit tally and reset: two bare glyph-sized lanes, no button chrome. */
  .sk-mini {
    display: inline-grid;
    place-items: center;
    inline-size: var(--size-control-sm);
    block-size: var(--size-control-sm);
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--color-text-tertiary);
    font: inherit;
    cursor: pointer;
  }
  /* "22/22" needs more than a square; the lane grows with the digits instead of clipping them. */
  .sk-mini--tally { inline-size: auto; min-inline-size: var(--size-control-sm); padding-inline: 6px; }

  .sk-dialog { --sk-dialog-inline-size: min(42rem, calc(100vw - 2rem)); }
  .sk-dialog__footer--split { justify-content: space-between; }
  .sk-dialog__footer--split form { margin: 0; }
  .sk-dialog__note { margin: 0; padding: 10px 12px; border-radius: 8px; background: var(--color-bg-surface-sunken); color: var(--color-text-secondary); font-size: 12px; line-height: 1.5; }
  .sk-probe { position: absolute; inline-size: 0; block-size: 0; overflow: hidden; opacity: 0; pointer-events: none; }

  /* The canvas is the viewport of each product. Only the component shelf is inset.
     Only the preview owns local ramp, density and radius overrides. This frame reads the docs
     tokens and therefore holds still while its contents change. `clip` (not `hidden`) lets the
     themed content respect the corners without creating a scroll container. */
  .sk-frame {
    flex: 1;
    overflow: clip;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-surface);
    box-shadow: var(--elevation-raised);
  }

  /* Inside the frame: the themed surface. Sizes to its content, no scrollport, the document scrolls. */
  .sk-canvas {
    background: var(--color-bg-canvas);
    padding: 0;
  }

  /* Surface shells leave panel anatomy to each sandbox: bodies retain the former md inset. */
  .sk-bento > .sk-box > .sk-flow,
  .sk-dash__kpis > .sk-box > .sk-flow,
  .sk-dash__main > .sk-box > .sk-flow,
  .sk-lp-features > .sk-box > .sk-flow,
  .sk-lp-quotes > .sk-box > .sk-flow,
  .sk-lp-pricing > .sk-box > .sk-flow,
  .sk-products > .sk-box > .sk-flow { padding: var(--space-inset-md); }

  /* Showcase bento: 6-col dense grid. Spans are 1/2/3 only so every band can fill without holes.
     Items size to content; dense packing climbs into leftover pockets under shorter neighbors. */
  .sk-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-stack-md);
    grid-auto-flow: dense;
    grid-auto-rows: minmax(0, auto);
    align-items: start;
  }
  .sk-bento > .sk-box {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    inline-size: 100%;
    box-shadow: var(--elevation-raised);
  }
  .sk-bento > .sk-box > .sk-flow { flex: 1; min-block-size: 0; }
  .sk-bento > .sk-box > header {
    display: flex;
    align-items: center;
    gap: 10px;
    min-block-size: 3.25rem;
    padding-inline: var(--space-inset-md);
    background: var(--color-bg-surface-raised);
  }
  .sk-bento > .sk-box > header :global(.sk-icon) {
    flex: none;
    color: var(--color-text-tertiary);
    --sk-icon-size: 1.125rem;
  }
  .sk-flow--fill { display: grid; align-content: stretch; }
  .sk-chart--tall { block-size: 100%; min-block-size: 10rem; }
  /* 36rem / 52rem mirror semantic/_breakpoints.scss */
  @media (min-width: 36rem) {
    .sk-bento { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sk-bento > [data-bento="cell"] { grid-column: span 1; }
    .sk-bento > [data-bento="kpi"],
    .sk-bento > [data-bento="trio"],
    .sk-bento > [data-bento="slim"],
    .sk-bento > [data-bento="tall"] { grid-column: span 1; }
    .sk-bento > [data-bento="wide"],
    .sk-bento > [data-bento="feature"],
    .sk-bento > [data-bento="hero"],
    .sk-bento > [data-bento="quad"] { grid-column: span 2; }
  }
  @media (min-width: 52rem) {
    .sk-bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--space-stack-md);
    }
    /* 1 · 2 · 3, never 4+. Combinations always tile: 3+3, 2+2+2, 2+2+1+1, 3+2+1. */
    .sk-bento > [data-bento="cell"] { grid-column: span 1; }
    .sk-bento > [data-bento="kpi"],
    .sk-bento > [data-bento="trio"],
    .sk-bento > [data-bento="slim"],
    .sk-bento > [data-bento="tall"] { grid-column: span 2; }
    .sk-bento > [data-bento="wide"],
    .sk-bento > [data-bento="feature"],
    .sk-bento > [data-bento="hero"],
    .sk-bento > [data-bento="quad"] { grid-column: span 3; }
  }

  /* Landing and commerce are complete product pages, so their chrome reaches the preview frame. */
  .sk-landing.sk-store { min-block-size: 100%; overflow: hidden; background: var(--color-bg-surface); }
  .sk-sitebar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-block-size: 3.5rem; padding: 10px 16px; border-block-end: 1px solid var(--color-border-subtle); background: var(--color-bg-surface); }
  .sk-sitebar > strong { color: var(--color-text-primary); font-size: 14px; letter-spacing: -0.03em; }
  .sk-sitebar > div { display: flex; align-items: center; gap: 10px; }
  .sk-sitebar a { color: var(--color-text-secondary); font-size: 12px; text-decoration: none; }
  .sk-landing__hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(10rem.65fr); gap: 20px; align-items: center; padding: clamp(24px, 4vw, 48px); }
  .sk-landing__hero > div:first-child { display: grid; justify-items: start; gap: 12px; }
  .sk-landing__hero h3 { max-inline-size: 20ch; margin: 0; color: var(--color-text-primary); font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.02; letter-spacing: -0.045em; text-wrap: balance; }
  .sk-landing__hero p { max-inline-size: 48ch; margin: 0; color: var(--color-text-secondary); font-size: 13px; line-height: 1.5; }
  .sk-coffee-box { display: grid; align-content: end; gap: 4px; aspect-ratio: 4 / 5; padding: 18px; border-radius: calc(var(--radius-surface) - 4px); background: var(--color-action-primary); color: var(--color-text-on-accent); box-shadow: var(--elevation-raised); }
  .sk-coffee-box span.sk-coffee-box small { font-size: 11px; opacity: .82; }
  .sk-coffee-box strong { font-size: 18px; }
  .sk-landing__proof { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--color-border-subtle); }
  .sk-landing__proof span { padding: 12px; color: var(--color-text-secondary); font-size: 11px; text-align: center; }
  .sk-landing__proof span + span { border-inline-start: 1px solid var(--color-border-subtle); }

  /* landing sections */
  .sk-lp-section { padding: clamp(28px, 5vw, 60px) clamp(20px, 4vw, 48px); border-block-end: 1px solid var(--color-border-subtle); }
  .sk-lp-head { display: grid; justify-items: center; gap: 8px; margin-bottom: 28px; text-align: center; }
  .sk-lp-head .sk-badge { justify-self: center; }
  .sk-lp-head h4 { max-inline-size: 24ch; margin: 0; color: var(--color-text-primary); font-size: clamp(1.25rem, 2.4vw, 1.85rem); line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
  .sk-lp-head p { max-inline-size: 52ch; margin: 0; color: var(--color-text-secondary); font-size: 13px; line-height: 1.5; }
  .sk-lp-logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 28px; padding: 20px; border-block-end: 1px solid var(--color-border-subtle); background: var(--color-bg-surface-sunken); }
  .sk-lp-logos span { color: var(--color-text-tertiary); font-size: 11px; }
  .sk-lp-logos b { color: var(--color-text-secondary); font-size: 15px; font-weight: 700; letter-spacing: -0.03em; opacity: .65; }
