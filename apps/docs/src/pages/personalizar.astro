      r = linear(r); g = linear(g); b = linear(b);
      var l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
      var m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
      var s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
      l = Math.cbrt(l); m = Math.cbrt(m); s = Math.cbrt(s);
      var lightness = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
      var a = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
      var chromaB = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
      var hue = Math.atan2(chromaB, a) * 180 / Math.PI;
      return { lightness: lightness, chroma: Math.sqrt(a * a + chromaB * chromaB), hue: hue < 0 ? hue + 360 : hue };
    }
    function oklchValue(parts) { return "oklch(" + (parts.lightness * 100).toFixed(1) + "% " + parts.chroma.toFixed(3) + " " + parts.hue.toFixed(1) + ")"; }
    // canvas normalises any colour string (rgb/oklch/color(srgb…)) to sRGB bytes
    var cv = document.createElement("canvas");
    var ctx = cv.getContext("2d", { willReadFrequently: true });
    function toRGB(s) { ctx.clearRect(0, 0, 1, 1); ctx.fillStyle = "#000"; ctx.fillStyle = s; ctx.fillRect(0, 0, 1, 1); var d = ctx.getImageData(0, 0, 1, 1).data; return [d[0], d[1], d[2]]; }
    function rgbOf(probe, e) { probe.style.color = ""; probe.style.color = e; var c = getComputedStyle(probe).color; return c ? toRGB(c) : null; }
    function hex(r) { return "#" + r.slice(0, 3).map(function (x) { var h = Math.round(x).toString(16); return h.length < 2 ? "0" + h : h; }).join(""); }
    function lum(r) { var f = function (x) { x /= 255; return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); }; return 0.2126 * f(r[0]) + 0.7152 * f(r[1]) + 0.0722 * f(r[2]); }
    function ratio(a, b) { if (!a || !b) return 0; var la = lum(a), lb = lum(b), hi = Math.max(la, lb), lo = Math.min(la, lb); return (hi + 0.05) / (lo + 0.05); }

    function applyOne(p, v) { if (v === "" || v == null) { delete overrides[p]; stage.style.removeProperty(p); } else { overrides[p] = v; stage.style.setProperty(p, v); } }
    function edit(p, v) { repairMessage = ""; applyOne(p, v); persist(); refresh(); }
    function setDimension(p, v) {
      if (v === dimensionDefaults[p]) delete overrides[p]; else overrides[p] = v;
      stage.style.setProperty(p, v);
      repairMessage = "";
      persist();
      refresh();
    }
    // Icon family is preview-only: swap the icons inside .ds-canvas via the layout's scoped helper,
    // touching neither the docs chrome nor the global icon preference.
    function applyIcons(setId) {
      iconSet = ICON_SETS.indexOf(setId) !== -1 ? setId : "lucide";
      if (typeof window.__dsApplyIconSetWithin === "function") window.__dsApplyIconSetWithin(stage, iconSet);
    }
    function setIconSet(setId) { applyIcons(setId); repairMessage = ""; persist(); refresh(); }
    function expr(p, fb) { return "var(" + p + (fb ? ", " + fb : "") + ")"; }
    function seedForPair(fg, bg) {
      var name = fg + " " + bg;
      if (name.indexOf("danger") !== -1) return "--seed-danger";
      if (name.indexOf("success") !== -1) return "--seed-success";
      if (name.indexOf("warning") !== -1) return "--seed-warning";
      if (name.indexOf("accent") !== -1 || name.indexOf("action-primary") !== -1 || name.indexOf("focus") !== -1) return "--seed-accent";
      return "--seed-neutral";
    }
    function seedDefault(seed) { return data.seeds.find(function (item) { return item.name === seed; }).def; }
    var auditFailures = [];
    var repairMessage = "";

    // ── audit ──
    function buildAudit() {
      var head = '<div class="ds-audit-row ds-audit-head"><span></span><span>claro</span><span>oscuro</span></div>';
      document.getElementById("ds-audit").innerHTML = head + data.pairs.map(function (p) {
        var name = p.fg.replace("--color-", "") + " / " + p.bg.replace("--color-", "");
        return '<div class="ds-audit-row" data-fg="' + p.fg + '" data-bg="' + p.bg + '" data-min="' + p.min + '"><code title="' + name + '">' + name + "</code><span class='ds-badge2' data-slot='light'></span><span class='ds-badge2' data-slot='dark'></span></div>";
      }).join("");
    }
    function refreshAudit() {
      var pass = 0, total = 0;
      auditFailures = [];
      document.querySelectorAll("#ds-audit .ds-audit-row[data-fg]").forEach(function (row) {
        var fg = row.getAttribute("data-fg"), bg = row.getAttribute("data-bg"), min = +row.getAttribute("data-min");
        [["light", probeL], ["dark", probeD]].forEach(function (pr) {
          var r = ratio(rgbOf(pr[1], "var(" + fg + ")"), rgbOf(pr[1], "var(" + bg + ")"));
          var el = row.querySelector("[data-slot=" + pr[0] + "]");
          var ok = r >= min;
          el.textContent = r ? r.toFixed(1) : "-";
          el.className = "ds-badge2 " + (ok ? "ok" : "bad");
          el.title = pr[0] + " · mín " + min + ":1";
          if (!ok) auditFailures.push({ fg: fg, bg: bg, min: min, seed: seedForPair(fg, bg) });
          total++; if (ok) pass++;
        });
      });
      var tally = document.getElementById("ds-tally");
      tally.textContent = pass + "/" + total;
      tally.className = "ds-tally " + (pass === total ? "ok" : "bad");
      var fix = document.getElementById("ds-contrast-fix");
      fix.disabled = auditFailures.length === 0;
      document.getElementById("ds-fix-note").textContent = repairMessage || (auditFailures.length ? auditFailures.length + " ratio(s) necesitan ajuste. La corrección mantiene hue y chroma y mueve como máximo 12 puntos de luminosidad." : "Todos los pares cumplen WCAG AA en claro y oscuro.");
    }
    function scoreSeed(seed) {
      var deficit = 0, failures = 0;
      data.pairs.forEach(function (pair) {
        if (seedForPair(pair.fg, pair.bg) !== seed) return;
        [["light", probeL], ["dark", probeD]].forEach(function (mode) {
          var difference = pair.min - ratio(rgbOf(mode[1], "var(" + pair.fg + ")"), rgbOf(mode[1], "var(" + pair.bg + ")"));
          if (difference > 0) { deficit += difference * difference; failures++; }
        });
      });
      return { deficit: deficit, failures: failures };
    }
    function repairSeed(seed) {
      var rgb = rgbOf(probeL, expr(seed, seedDefault(seed)));
      if (!rgb) return false;
      var base = oklchComponents(rgb);
      var original = stage.style.getPropertyValue(seed);
      var best = { value: null, score: scoreSeed(seed).deficit };
      for (var step = 1; step <= 12; step++) {
        [-1, 1].forEach(function (direction) {
          var lightness = Math.max(0, Math.min(1, base.lightness + direction * step / 100));
          var candidate = oklchValue({ lightness: lightness, chroma: base.chroma, hue: base.hue });
          stage.style.setProperty(seed, candidate);
          var score = scoreSeed(seed).deficit;
          if (score < best.score) best = { value: candidate, score: score };
        });
      }
      if (!best.value) {
        if (original) stage.style.setProperty(seed, original); else stage.style.removeProperty(seed);
        return false;
      }
      stage.style.setProperty(seed, best.value);
      overrides[seed] = best.value;
      return true;
    }
    function repairContrast() {
      var seeds = auditFailures.map(function (failure) { return failure.seed; }).filter(function (seed, index, list) { return list.indexOf(seed) === index; });
      var repaired = seeds.filter(repairSeed);
      repairMessage = repaired.length ? "Ajustamos " + repaired.join(", ") + " sin cambiar su hue ni chroma. Revisa los ratios antes de exportar." : "No encontramos una mejora dentro de 12 puntos de luminosidad; ajusta el seed de color de forma manual.";
      repaired.forEach(function (seed) { remountSeed(seed, overrides[seed]); });
      persist();
      refresh();
    }

    // The colour selects are DS Select instances; the enhancer owns their displayed value, so the page drives
    // them only on external changes (reset / repair / restore) by re-mounting with a new default value.
    function remountSeed(prop, value) {
      if (typeof window.__remountSeed === "function") window.__remountSeed(prop, value || seedDefault(prop));
    }

    function refresh() {
      document.querySelectorAll("[data-row]").forEach(function (row) {
        row.classList.toggle("is-overridden", !!overrides[row.getAttribute("data-row")]);
      });
      document.getElementById("ds-export-css").textContent = exportCss();
      refreshAudit();
    }

    // The colour dropdowns ARE the design system's Select (data-ds-select), enhanced by
    // initComponents(). Each emits ds-value-change with the picked OKLCH; picking the default preset
    // clears the override so the export stays minimal.
    var seedsContainer = document.querySelector(".ds-seeds");
    if (seedsContainer) {
      seedsContainer.addEventListener("ds-value-change", function (e) {
        var root = e.target.closest("[data-ds-select][data-prop]");
        if (!root) return;
        var prop = root.getAttribute("data-prop");
        var value = (e.detail && e.detail.value && e.detail.value[0]) || "";
        edit(prop, value === seedDefault(prop) ? "" : value);
      });
    }
    // Density, roundness and icon family are DS Select instances too (same as the colour dropdowns). Each
    // carries its target in data-prop; picking an item emits ds-value-change with the chosen value.
    var dimensionsContainer = document.querySelector(".ds-dimensions");
    if (dimensionsContainer) {
      dimensionsContainer.addEventListener("ds-value-change", function (e) {
        var root = e.target.closest("[data-ds-select][data-prop]");
        if (!root) return;
        var prop = root.getAttribute("data-prop");
        var value = (e.detail && e.detail.value && e.detail.value[0]);
        if (prop === "icon-set") { setIconSet(value || "lucide"); return; }
        setDimension(prop, value || dimensionDefaults[prop]);
      });
    }
    document.querySelectorAll("[data-reset]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var prop = btn.getAttribute("data-reset");
        edit(prop, "");
        remountSeed(prop, seedDefault(prop));
      });
    });
    document.getElementById("ds-reset-all").addEventListener("click", function () {
      Object.keys(overrides).forEach(function (p) { stage.style.removeProperty(p); });
      overrides = {};
      repairMessage = "";
      Object.keys(dimensionDefaults).forEach(function (p) { stage.style.setProperty(p, dimensionDefaults[p]); });
      applyIcons("lucide");
      localStorage.removeItem(KEY);
      var url = new URL(location.href);
      url.hash = "";
      history.replaceState(null, "", url.toString());
      data.seeds.forEach(function (s) { remountSeed(s.name, s.def); });
      // The dimension and icon pickers are Select instances too: remount each to its default so the trigger
      // reflects the reset (the enhancer owns its displayed value).
      Object.keys(dimensionDefaults).forEach(function (p) { remountSeed(p, dimensionDefaults[p]); });
      remountSeed("icon-set", "lucide");
      refresh();
    });

    function exportCss() {
      var lines = [":root {"];
      data.seeds.forEach(function (s) {
        var required = s.name === "--seed-accent" || s.name === "--seed-neutral";
        if (required || overrides[s.name]) lines.push("  " + s.name + ": " + (overrides[s.name] || s.def) + ";");
      });
      Object.keys(overrides).forEach(function (p) { if (p.indexOf("--seed-") !== 0) lines.push("  " + p + ": " + overrides[p] + ";"); });
      lines.push("}");
      // Icon family is a package choice, not a CSS custom property, record it as a note so the export
      // still carries the full theme.
      if (iconSet !== "lucide") lines.push("", "/* íconos: @skryensya/icons-" + iconSet + " */");
      return lines.join("\n");
    }
    function flash(btn, label) {
      var orig = btn.getAttribute("data-label") || btn.textContent;
      btn.setAttribute("data-label", orig);
      btn.textContent = label;
      setTimeout(function () { btn.textContent = orig; }, 1400);
    }
    function openDialog(id) {
      var dialog = document.getElementById(id);
      if (!dialog.open) dialog.showModal();
    }
    document.getElementById("ds-export-open").addEventListener("click", function () { openDialog("ds-export-dialog"); });
    document.getElementById("ds-contrast-open").addEventListener("click", function () { openDialog("ds-contrast-dialog"); });
    document.getElementById("ds-contrast-fix").addEventListener("click", repairContrast);
    document.getElementById("ds-export-copy").addEventListener("click", function () {
      var btn = this;
      if (navigator.clipboard) navigator.clipboard.writeText(exportCss()).then(function () { flash(btn, "¡Copiado!"); }, function () { flash(btn, "¡Copiado!"); });
      else flash(btn, "¡Copiado!");
    });
    // Compartir: the URL already carries the fixed code in its hash (kept in sync on every edit), copy
    // the whole link. The code is self-contained, so the link IS the theme.
    document.getElementById("ds-share").addEventListener("click", function () {
      var btn = this;
      persist(); // ensure the hash reflects the latest state even if nothing was edited yet
      var link = location.href;
      if (navigator.clipboard) navigator.clipboard.writeText(link).then(function () { flash(btn, "¡Link copiado!"); }, function () { flash(btn, "¡Link copiado!"); });
      else flash(btn, "¡Link copiado!");
    });

    // Stage-only defaults keep this workbench independent from the docs' global density and radius controls.
    Object.keys(dimensionDefaults).forEach(function (p) { stage.style.setProperty(p, dimensionDefaults[p]); });
    Object.keys(overrides).forEach(function (p) { stage.style.setProperty(p, overrides[p]); });
    buildAudit();
    // rAF runs after the deferred module scripts, so window.__remountSeed / __dsApplyIconSetWithin exist
    // by now: restore any saved/shared overrides into the Select instances and the preview (authored markup
    // starts on each seed's default and the docs' global icon set).
    requestAnimationFrame(function () {
      refresh();
      data.seeds.forEach(function (s) { if (overrides[s.name]) remountSeed(s.name, overrides[s.name]); });
      // Same for the dimension pickers: reflect a saved/shared override in the trigger.
      Object.keys(dimensionDefaults).forEach(function (p) { if (overrides[p]) remountSeed(p, overrides[p]); });
      // Icon family: apply the loaded set to the preview, and reflect a non-default choice in its trigger.
      applyIcons(iconSet);
      if (iconSet !== "lucide") remountSeed("icon-set", iconSet);
    });
  })();
</script>

<script>
  // Bridge so the inline playground (which can't import ESM) can re-point a DS Select at a new value:
  // reset, contrast-repair and shared-link restore all set a value the enhancer didn't pick itself.
  import { destroyMount, mountSelect } from "@skryensya/vanilla";
  window.__remountSeed = function (prop, value) {
    const root = document.querySelector('[data-ds-select][data-prop="' + prop + '"]');
    if (!root) return;
    destroyMount(root); // desmonta el enhancer Svelte (corre su cleanup) y libera el marcador ready
    if (value) root.setAttribute("data-value", value);
    else root.removeAttribute("data-value");
    mountSelect(root);
  };
</script>
