  .ds-lp-head .ds-badge { justify-self: center; }
  .ds-lp-head h4 { max-inline-size: 24ch; margin: 0; color: var(--color-text-primary); font-size: clamp(1.25rem, 2.4vw, 1.85rem); line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
  .ds-lp-head p { max-inline-size: 52ch; margin: 0; color: var(--color-text-secondary); font-size: 13px; line-height: 1.5; }
