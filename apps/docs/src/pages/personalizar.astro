  .ds-landing__proof span + span { border-inline-start: 1px solid var(--color-border-subtle); }

  /* landing sections */
  .ds-lp-section { padding: clamp(28px, 5vw, 60px) clamp(20px, 4vw, 48px); border-block-end: 1px solid var(--color-border-subtle); }
