<style>
  /* The builder is a bounded workbench, not a page-level theme switch. The two surfaces share one
     grid but each owns its own edge, depth and scroll region. */
  .ds-config { display: grid; grid-template-columns: minmax(18rem, 20rem) minmax(0, 1fr); gap: clamp(14px, 2vw, 24px); max-inline-size: 96rem; min-block-size: calc(100dvh - var(--docs-header-block-size)); margin-inline: auto; padding: clamp(14px, 2vw, 28px); align-items: start; }
  .ds-panel,
  /* `clip` (not `hidden`): a hidden-overflow frame is still programmatically scrollable, so focusing an
     input inside `.ds-canvas` would scroll the WHOLE frame, pushing the window bar and tabs out of view
     and clipping them. `clip` clips identically but creates no scroll container, so only `.ds-canvas`
     (overflow:auto) scrolls to reveal the focused control; the chrome stays put. */
  .ds-preview { min-inline-size: 0; border: 1px solid var(--color-border-subtle); border-radius: 14px; background: var(--color-bg-surface); box-shadow: var(--elevation-raised); overflow: clip; }

  /* The controls stay available without becoming a full-height left rail. */
  .ds-panel { position: sticky; top: calc(var(--docs-header-block-size) + 16px); display: flex; flex-direction: column; block-size: min(52rem, calc(100dvh - var(--docs-header-block-size) - 32px)); min-block-size: 0; }

  /* The window bar is an explicit boundary: changing a token only changes the framed preview below. */
  .ds-preview { position: sticky; top: calc(var(--docs-header-block-size) + 16px); display: flex; flex-direction: column; block-size: min(52rem, calc(100dvh - var(--docs-header-block-size) - 32px)); }
  .ds-preview__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-block-size: 3.5rem; padding: 10px 16px; border-block-end: 1px solid var(--color-border-subtle); background: var(--color-bg-surface-raised); }
  .ds-preview__identity { display: flex; align-items: center; gap: 9px; min-inline-size: 0; }
  .ds-preview__identity > span:last-child { display: grid; gap: 1px; min-inline-size: 0; }
  .ds-preview__identity strong { color: var(--color-text-primary); font-size: 12px; }
  .ds-preview__identity small { overflow: hidden; color: var(--color-text-tertiary); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
  .ds-preview__live { inline-size: 8px; block-size: 8px; border-radius: 999px; flex: none; background: var(--color-action-primary); box-shadow: 0 0 0 3px var(--color-bg-accent-subtle); }

  /* The view switcher is window chrome: it stays fixed while only the framed canvas below scrolls.
     core/tabs.css ships only styling-hook tokens (no element rules), so this page maps them to paint
     itself, the consumer's job, exactly as decisión 8 frames it. */
  .ds-views { flex: none; display: flex; align-items: stretch; gap: 2px; padding-inline: 12px; background: var(--color-bg-surface-raised); border-block-end: 1px solid var(--color-border-subtle); overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
  .ds-views::-webkit-scrollbar { display: none; }
  .ds-views .ds-tabs__trigger {
    position: relative; flex: none; display: inline-flex; align-items: center; white-space: nowrap;
    min-block-size: 2.5rem; padding-inline: 14px; margin-block-end: -1px;
    border: 0; border-radius: 8px 8px 0 0;
    background: transparent; color: var(--color-text-tertiary);
    font: inherit; font-size: var(--font-size-body-sm); font-weight: 500;
    cursor: pointer; transition: color 0.14s ease;
  }
  .ds-views .ds-tabs__trigger:hover { color: var(--color-text-secondary); }
  .ds-views .ds-tabs__trigger[data-selected] { color: var(--color-text-primary); }
  .ds-views .ds-tabs__trigger[data-selected]::after { content: ""; position: absolute; inset-inline: 12px; inset-block-end: 0; block-size: 2px; border-radius: 2px 2px 0 0; background: var(--color-action-primary); }
  .ds-views .ds-tabs__trigger:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: calc(-1 * var(--focus-ring-width)); }
  /* The component shelf needs a gutter; product pages own their full frame. */
  .ds-view[data-value="showcase"] { padding: clamp(20px, 3vw, 40px); }
  .ds-canvas .ds-tabs__content { padding-block: 0; }
  .ds-canvas .ds-tabs__content[hidden] { display: none; }

  @media (max-width: 860px) {
    .ds-config { grid-template-columns: 1fr; padding: 12px; }
    .ds-panel.ds-preview { position: static; block-size: auto; }
    .ds-panel__scroll.ds-canvas { overflow: visible; }
  }
  .ds-muted { color: var(--color-text-tertiary); font-size: 12px; font-weight: 400; }


  .ds-panel__scroll { flex: 1; min-block-size: 0; overflow-y: auto; padding: 6px 18px 12px; display: flex; flex-direction: column; }
  .ds-sec { padding-block: 14px; border-block-end: 1px solid var(--color-border-subtle); }
  .ds-sec:last-child { border-block-end: 0; }
  .ds-sec__head { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .ds-sec__head h2 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-tertiary); margin: 0; }
  .ds-pill { font-size: 10.5px; font-weight: 600; color: var(--color-text-tertiary); background: var(--color-bg-surface-sunken); padding: 1px 7px; border-radius: 999px; }
  .ds-code { overflow-x: auto; margin: 8px 0 0; padding: 10px 12px; border: 1px solid var(--color-border-subtle); border-radius: 8px; background: var(--color-bg-canvas); color: var(--color-text-primary); font-family: var(--font-family-mono, ui-monospace, monospace); font-size: 11px; line-height: 1.5; white-space: pre; }
  .ds-out { margin: 8px 0 0; }

  /* Each role is a row: the design system's Select (label + trigger) with the reset beside it.
     Clear gap between rows; the reset reveals on hover. */
  .ds-seeds { display: grid; gap: 14px; }
  .ds-seed { display: grid; align-items: end; }
  .ds-seed :global(.ds-select) { min-inline-size: 0; }
  .ds-seed :global(.ds-select__trigger) { inline-size: 100%; }

  .ds-dimensions { display: grid; gap: 16px; }
  .ds-dimension { display: grid; gap: 8px; }
  .ds-dimension__copy { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .ds-dimension__copy strong { color: var(--color-text-primary); font-size: 12px; }
  .ds-dimension__copy span { color: var(--color-text-tertiary); font-size: 11px; text-align: end; }
  /* The dimension picker is a DS Select: the visible title is the copy block above it, so the
     select's own label is kept for a11y but visually hidden (:global() to reach the component's
     class past Astro's scoping). The trigger spans the row. */
  .ds-dimension :global(.ds-select) { inline-size: 100%; }
  .ds-dimension :global(.ds-select__label) { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .ds-dimension :global(.ds-select__trigger) { inline-size: 100%; }

  /* Audit is compact in the builder and detailed only when asked for. */
  .ds-tally { display: block; font-variant-numeric: tabular-nums; font-weight: 700; }
  .ds-tally.ok { color: var(--color-text-success); }
  .ds-tally.bad { color: var(--color-text-danger); }
  .ds-audit { display: grid; gap: 1px; }
  /* Rows are injected by JS, so scope through the static audit container. */
  #ds-audit :global(.ds-audit-row) { display: grid; grid-template-columns: 1fr 44px 44px; gap: 8px; align-items: center; padding: 4px 0; }
  #ds-audit :global(.ds-audit-head) { padding-bottom: 6px; }
  #ds-audit :global(.ds-audit-head span) { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-tertiary); text-align: center; }
  #ds-audit :global(.ds-audit-row code) { font-size: 11px; color: var(--color-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #ds-audit :global(.ds-badge2) { font-variant-numeric: tabular-nums; font-weight: 600; padding: 3px 0; border-radius: 6px; font-size: 11px; text-align: center; }
  #ds-audit :global(.ds-badge2.ok) { background: var(--color-bg-success-subtle); color: var(--color-text-success); }
  #ds-audit :global(.ds-badge2.bad) { background: var(--color-bg-danger-subtle); color: var(--color-text-danger); }

  .ds-panel__foot { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 40px 40px; gap: 6px; padding: 12px 18px; border-block-start: 1px solid var(--color-border-subtle); background: var(--color-bg-surface); }
  .ds-btn { inline-size: 100%; min-inline-size: 0; display: inline-flex; align-items: center; justify-content: center; min-block-size: var(--ds-button-height); padding-inline: 8px; border: var(--ds-button-border-width) solid var(--ds-button-border-color); border-radius: var(--ds-button-radius); background: var(--ds-button-bg); box-shadow: var(--ds-button-shadow); color: var(--ds-button-fg); font: inherit; font-size: var(--ds-button-font-size); font-weight: var(--ds-button-font-weight); }
  .ds-btn--primary { min-inline-size: 0; }
  .ds-btn--ghost.ds-contrast-trigger { inline-size: 40px; min-inline-size: 40px; padding-inline: 0; }
  .ds-contrast-trigger { display: inline-grid; place-items: center; min-block-size: var(--ds-button-height); border: var(--ds-button-border-width) solid var(--ds-button-border-color); border-radius: var(--ds-button-radius); background: var(--ds-button-bg); color: var(--ds-button-fg); }

  .ds-dialog { --ds-dialog-inline-size: min(42rem, calc(100vw - 2rem)); }
  .ds-dialog__footer--split { justify-content: space-between; }
  .ds-dialog__footer--split form { margin: 0; }
  .ds-integration-step { display: grid; grid-template-columns: 24px 1fr; gap: 10px; }
  .ds-integration-step > span { display: grid; place-items: center; inline-size: 24px; block-size: 24px; border-radius: 999px; background: var(--color-bg-accent-subtle); color: var(--color-text-accent); font-size: 11px; font-weight: 700; }
  .ds-integration-step .ds-heading,
  .ds-integration-step p { margin: 0; }
  .ds-integration-step p { color: var(--color-text-secondary); font-size: 12px; line-height: 1.5; }
  .ds-dialog__note { margin: 0; padding: 10px 12px; border-radius: 8px; background: var(--color-bg-surface-sunken); color: var(--color-text-secondary); font-size: 12px; line-height: 1.5; }
  .ds-probe { position: absolute; inline-size: 0; block-size: 0; overflow: hidden; opacity: 0; pointer-events: none; }

  /* The canvas is the viewport of each product. Only the component shelf is inset. */
  .ds-canvas { flex: 1; min-block-size: 0; overflow: auto; background: var(--color-bg-canvas); padding: 0; }

  /* Surface shells leave panel anatomy to each sandbox: bodies retain the former md inset. */
  .ds-stats > .ds-box > .ds-flow,
  .ds-multicol > .ds-box > .ds-flow,
  .ds-dash__kpis > .ds-box > .ds-flow,
  .ds-dash__main > .ds-box > .ds-flow,
  .ds-lp-features > .ds-box > .ds-flow,
  .ds-lp-quotes > .ds-box > .ds-flow,
  .ds-lp-pricing > .ds-box > .ds-flow,
  .ds-products > .ds-box > .ds-flow { padding: var(--space-inset-md); }
  /* KPI stats establish the dashboard's reading order before the multi-column card wall. */
  .ds-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: 14px; margin-bottom: 18px; }
  .ds-stats .ds-flow { min-block-size: 7.25rem; }

  /* Landing and commerce are complete product pages, so their chrome reaches the preview frame. */
  .ds-landing.ds-store { min-block-size: 100%; overflow: hidden; background: var(--color-bg-surface); }
  .ds-sitebar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-block-size: 3.5rem; padding: 10px 16px; border-block-end: 1px solid var(--color-border-subtle); background: var(--color-bg-surface); }
  .ds-sitebar > strong { color: var(--color-text-primary); font-size: 14px; letter-spacing: -0.03em; }
  .ds-sitebar > div { display: flex; align-items: center; gap: 10px; }
  .ds-sitebar a { color: var(--color-text-secondary); font-size: 12px; text-decoration: none; }
  .ds-landing__hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(10rem.65fr); gap: 20px; align-items: center; padding: clamp(24px, 4vw, 48px); }
  .ds-landing__hero > div:first-child { display: grid; justify-items: start; gap: 12px; }
  .ds-landing__hero h3 { max-inline-size: 20ch; margin: 0; color: var(--color-text-primary); font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.02; letter-spacing: -0.045em; text-wrap: balance; }
  .ds-landing__hero p { max-inline-size: 48ch; margin: 0; color: var(--color-text-secondary); font-size: 13px; line-height: 1.5; }
  .ds-coffee-box { display: grid; align-content: end; gap: 4px; aspect-ratio: 4 / 5; padding: 18px; border-radius: calc(var(--radius-surface) - 4px); background: var(--color-action-primary); color: var(--color-text-on-accent); box-shadow: var(--elevation-raised); }
  .ds-coffee-box span.ds-coffee-box small { font-size: 11px; opacity: .82; }
  .ds-coffee-box strong { font-size: 18px; }
  .ds-landing__proof { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--color-border-subtle); }
