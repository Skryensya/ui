---
/*
 * /personalizar, runtime ramp configuration, full-bleed. Preview-only, saved and shareable.
 *
 * The docs theme never changes. Only `.ds-canvas` receives the ramp derivation, so edits stay in the
 * preview while its semantic `--color-*` tokens re-resolve against the edited ramps. The last edit is
 * saved to localStorage and encoded in the URL; reset clears both. The output is the `:root` CSS a
 * consumer copies into its own site, and the WCAG audit runs live.
 *
 * Left: color seeds plus density and roundness. Right: a product context to judge the result.
 */
import Base from "../layouts/Base.astro";
import DimensionSelect from "../components/DimensionSelect.astro";
import { allSets, iconMarkup } from "../icons";
import { compileString } from "sass";
import { tokens, CSS_DIR } from "../lib/tokens";
import "../examples/input.css";
import "../examples/checkbox.css";
import "../examples/radio-group.css";
import "../examples/switch.css";

const checkboxIndicators = `<span
      class="ds-checkbox__indicator"
      data-state="checked"
    >${iconMarkup("check", { size: "sm" })}</span>
    <span
      class="ds-checkbox__indicator"
      data-state="indeterminate"
    >${iconMarkup("remove", { size: "sm" })}</span>`;
const paginationPrev = iconMarkup("chevron-left", { size: "sm" });
const paginationNext = iconMarkup("chevron-right", { size: "sm" });

/*
 * Curated named presets per role instead of a free colour picker: the values are pre-vetted OKLCH
 * strings, so there is no hex↔OKLCH round-trip and every choice stays inside the role's lightness /
 * chroma band. The first preset of each seed is its default (its `def`).
 */
const SEEDS = [
  {
    name: "--seed-accent", label: "Acento", def: "oklch(50.4% 0.169 259.6)", hint: "el color de marca",
    /* Every option is verified (light + dark) for text-on-accent, accent-text and focus-ring contrast,
     * and kept ≥15° in hue from the feedback roles (danger 27 / warning 75 / success 150) so a brand
     * fill never reads like an error/success/warning state. Pure red, orange-red and grass-green are
     * absent on purpose, they collide with danger and success. */
    presets: [
      { name: "Azul", value: "oklch(50.4% 0.169 259.6)" },
      { name: "Zafiro", value: "oklch(49% 0.185 270)" },
      { name: "Índigo", value: "oklch(49.5% 0.185 283)" },
      { name: "Violeta", value: "oklch(51% 0.185 300)" },
      { name: "Lila", value: "oklch(52% 0.17 315)" },
      { name: "Magenta", value: "oklch(52% 0.2 344)" },
      { name: "Rosa", value: "oklch(56% 0.185 354)" },
      { name: "Naranja", value: "oklch(52% 0.15 50)" },
      { name: "Turquesa", value: "oklch(50% 0.1 190)" },
      { name: "Cian", value: "oklch(50% 0.115 210)" },
      { name: "Celeste", value: "oklch(54% 0.13 228)" },
      { name: "Cielo", value: "oklch(53% 0.14 242)" },
    ],
  },
  {
    name: "--seed-neutral", label: "Neutro", def: "oklch(58.8% 0.018 260)", hint: "el undertone de los grises",
    presets: [
      { name: "Gris", value: "oklch(58.8% 0.018 260)" },
      { name: "Acero", value: "oklch(58% 0.08 248)" },
      { name: "Pizarra", value: "oklch(56% 0.09 235)" },
      { name: "Arena", value: "oklch(59% 0.08 80)" },
      { name: "Piedra", value: "oklch(58% 0.06 55)" },
      { name: "Topo", value: "oklch(58% 0.09 45)" },
    ],
  },
  {
    name: "--seed-danger", label: "Peligro", def: "oklch(56% 0.208 27)", hint: "opcional · default sobrio",
    presets: [
      { name: "Rojo", value: "oklch(56% 0.208 27)" },
      { name: "Guinda", value: "oklch(52% 0.18 8)" },
      { name: "Carmesí", value: "oklch(57% 0.205 20)" },
      { name: "Ladrillo", value: "oklch(58% 0.165 40)" },
    ],
  },
  {
    name: "--seed-success", label: "Éxito", def: "oklch(55.8% 0.14 150)", hint: "opcional · default sobrio",
    presets: [
      { name: "Verde", value: "oklch(55.8% 0.14 150)" },
      { name: "Jade", value: "oklch(56% 0.1 175)" },
      { name: "Lima", value: "oklch(63% 0.15 130)" },
      { name: "Esmeralda", value: "oklch(55% 0.15 160)" },
    ],
  },
  {
    name: "--seed-warning", label: "Aviso", def: "oklch(58.4% 0.132 75)", hint: "opcional · default sobrio",
    presets: [
      { name: "Ámbar", value: "oklch(58.4% 0.132 75)" },
      { name: "Naranja", value: "oklch(62% 0.15 55)" },
      { name: "Oro", value: "oklch(70% 0.13 90)" },
      { name: "Mostaza", value: "oklch(61% 0.1 88)" },
    ],
  },
];

const PAIRS = [
  { fg: "--color-text-primary", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-secondary", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-tertiary", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-on-accent", bg: "--color-action-primary", min: 4.5 },
  { fg: "--color-text-on-accent", bg: "--color-action-danger", min: 4.5 },
  { fg: "--color-text-accent", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-danger", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-success", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-text-warning", bg: "--color-bg-canvas", min: 4.5 },
  { fg: "--color-border-default", bg: "--color-bg-canvas", min: 3 },
  { fg: "--color-border-focus", bg: "--color-bg-canvas", min: 3 },
];

// Icon family is a preview-only theme variable: the options are the three published sets, and a small
// gallery in the preview makes the choice visible (swapped in place, scoped to .ds-canvas).
const ICON_SET_OPTIONS = allSets.map((s) => ({ value: s.id, label: s.label }));
const PREVIEW_ICONS = [
  "search", "settings", "user", "calendar",
  "download", "edit", "copy", "filter",
  "check", "info", "refresh", "delete",
] as const;

const clientData = JSON.stringify({ pairs: PAIRS, seeds: SEEDS, iconSets: allSets.map((s) => s.id) });

/*
 * The preview is self-contained. It compiles the same root-ramp derivation onto `.ds-canvas` and
 * re-declares semantic tokens there, so edits do not leak into the surrounding docs page.
 *
 * Colour tokens must be re-declared so they re-resolve against the edited RAMPS. Space / size / radius
 * tokens must be re-declared for the same reason the density and radius controls exist: they read
 * `--ds-density` / `--radius-multiplier`, and those are overridden on `.ds-canvas`. A token declared
 * only on `:root` keeps `:root`'s value no matter what a subtree sets the multiplier to (var() in a
 * custom property resolves where the property is DECLARED); re-declaring here is what makes the two
 * dimension controls actually reach the preview. Component hooks (`--ds-button-radius: var(--radius-
 * control)`) are element-scoped, so they inherit these and re-resolve for free.
 */
const stageRampCss = compileString(
  `@use "primitives/ramp-recipe" as ramps;\n.ds-canvas { @include ramps.derive; }`,
  { loadPaths: [CSS_DIR], style: "expanded" },
).css;

const SCOPED_PREFIXES = ["--color-", "--space-", "--size-", "--radius-"];
const semScopedCss =
  ".ds-canvas {\n" +
  tokens
    .filter((t) => t.tier === "semantic" && SCOPED_PREFIXES.some((p) => t.name.startsWith(p)))
    .map((t) => `  ${t.name}: ${t.value};`)
    .join("\n") +
  "\n}";

const stageCss = `${stageRampCss}\n${semScopedCss}`;
---

<Base fullBleed title="Configurar la marca" description="Ajusta los seeds de color, densidad y redondez; revisa el contraste y copia el CSS resultante.">
  <script type="application/json" id="ds-data" set:html={clientData} is:inline />
  <style is:global set:html={stageCss}></style>

  <div class="ds-config">
    <!-- ═══════════ CONTROLS (left) ═══════════ -->
    <aside class="ds-panel">

      <div class="ds-panel__scroll ds-scrollbar">
        <section class="ds-sec">
          <div class="ds-sec__head"><h2>Color</h2></div>
          <div class="ds-seeds">
            {
              SEEDS.map((s) => (
                <div class="ds-seed" data-row={s.name}>
                  <DimensionSelect
                    id={`seed-${s.name.replace("--seed-", "")}`}
                    prop={s.name}
                    value={s.def}
                    placeholder="Personalizado"
                    label={s.label}
                    options={s.presets.map((p) => ({ value: p.value, label: p.name }))}
                  />
                </div>
              ))
            }
          </div>
        </section>

        <section class="ds-sec">
          <div class="ds-sec__head"><h2>Forma, espacio e íconos</h2></div>
          <div class="ds-dimensions">
            <div class="ds-dimension">
              <div class="ds-dimension__copy"><strong>Densidad</strong><span>Espacio y controles</span></div>
              <DimensionSelect
                id="ds-dim-density"
                prop="--ds-density"
                label="Densidad"
                value="1"
                options={[
                  { value: "0.5", label: "Condensada" },
                  { value: "0.6", label: "Densa" },
                  { value: "0.8", label: "Compacta" },
                  { value: "1", label: "Cómoda" },
                  { value: "1.2", label: "Amplia" },
                ]}
              />
            </div>
            <div class="ds-dimension">
              <div class="ds-dimension__copy"><strong>Redondez</strong><span>Esquinas de controles y superficies</span></div>
              <DimensionSelect
                id="ds-dim-radius"
                prop="--radius-multiplier"
                label="Redondez"
                value="1"
                options={[
                  { value: "0", label: "Recta" },
                  { value: "0.5", label: "Sutil" },
                  { value: "1", label: "Suave" },
                  { value: "1.5", label: "Marcada" },
                  { value: "2", label: "Redonda" },
                ]}
              />
            </div>
            <div class="ds-dimension">
              <div class="ds-dimension__copy"><strong>Íconos</strong><span>Familia aplicada al preview</span></div>
              <DimensionSelect
                id="ds-dim-icons"
                prop="icon-set"
                label="Íconos"
                value="lucide"
                options={ICON_SET_OPTIONS}
              />
            </div>
          </div>
        </section>

      </div>

      <footer class="ds-panel__foot">
        <button class="ds-button ds-interactive ds-btn ds-btn--primary" data-variant="primary" id="ds-export-open">Exportar</button>
        <button class="ds-button ds-interactive ds-btn" id="ds-share">Compartir</button>
        <button class="ds-button ds-interactive ds-contrast-trigger" data-variant="ghost" id="ds-contrast-open" title="Revisar contraste" aria-label="Revisar contraste"><span id="ds-tally">AA</span></button>
        <button class="ds-button ds-interactive ds-btn ds-btn--ghost" data-variant="ghost" data-icon-only id="ds-reset-all" title="Reiniciar" aria-label="Reiniciar">↺</button>
      </footer>
    </aside>

    <section class="ds-preview" aria-label="Showcase de componentes" data-ds-tabs id="ds-views" data-value="showcase">
      <header class="ds-preview__bar">
        <div class="ds-preview__identity">
          <span class="ds-preview__live" aria-hidden="true"></span>
          <span><strong>Componentes</strong><small>Estados, flujos y componentes en vivo</small></span>
        </div>
        <span class="ds-badge" data-tone="neutral">UI lab</span>
      </header>
      {/* Each site context is its own tab: the same tokens, judged across different products. */}
      <div class="ds-views ds-tabs__list ds-scrollbar" data-ds-tabs-list aria-label="Vistas del showcase">
        <button class="ds-tabs__trigger ds-interactive" data-ds-tabs-trigger data-value="showcase" type="button">Showcase</button>
        <button class="ds-tabs__trigger ds-interactive" data-ds-tabs-trigger data-value="dashboard" type="button">Dashboard</button>
        <button class="ds-tabs__trigger ds-interactive" data-ds-tabs-trigger data-value="landing" type="button">Landing</button>
        <button class="ds-tabs__trigger ds-interactive" data-ds-tabs-trigger data-value="store" type="button">Comercio</button>
      </div>
      <div class="ds-canvas ds-scrollbar">
      <!-- probes resolve the PREVIEW's colours (they live inside the themed region), per scheme -->
      <span class="ds-probe" style="color-scheme: light"><span id="ds-probe-light"></span></span>
      <span class="ds-probe" style="color-scheme: dark"><span id="ds-probe-dark"></span></span>

      <div class="ds-tabs__content ds-view" data-ds-tabs-content data-value="showcase">
      <!-- KPI stats, componente Stat dentro de Box, con un ícono destacado por métrica -->
      <div class="ds-stats">
        <div class="ds-box" data-surface="surface" data-border="subtle" data-padding="none"><div class="ds-flow"><div class="ds-stat-row"><span class="ds-stat-ico" data-tone="accent"><Fragment set:html={iconMarkup("download")} /></span><div class="ds-stat"><span class="ds-stat__label">Ingresos</span><span class="ds-stat__value">$48.2k</span><span class="ds-stat__change" data-trend="up"><Fragment set:html={iconMarkup("arrow-up")} />12.5%</span></div></div></div></div>
        <div class="ds-box" data-surface="surface" data-border="subtle" data-padding="none"><div class="ds-flow"><div class="ds-stat-row"><span class="ds-stat-ico" data-tone="accent"><Fragment set:html={iconMarkup("user")} /></span><div class="ds-stat"><span class="ds-stat__label">Usuarios</span><span class="ds-stat__value">3,914</span><span class="ds-stat__change" data-trend="up"><Fragment set:html={iconMarkup("arrow-up")} />4.1%</span></div></div></div></div>
        <div class="ds-box" data-surface="surface" data-border="subtle" data-padding="none"><div class="ds-flow"><div class="ds-stat-row"><span class="ds-stat-ico" data-tone="accent"><Fragment set:html={iconMarkup("calendar")} /></span><div class="ds-stat"><span class="ds-stat__label">Órdenes</span><span class="ds-stat__value">1,204</span><span class="ds-stat__change" data-trend="down"><Fragment set:html={iconMarkup("arrow-down")} />2.3%</span></div></div></div></div>
        <div class="ds-box" data-surface="surface" data-border="subtle" data-padding="none"><div class="ds-flow"><div class="ds-stat-row"><span class="ds-stat-ico" data-tone="danger"><Fragment set:html={iconMarkup("arrow-down")} /></span><div class="ds-stat"><span class="ds-stat__label">Churn</span><span class="ds-stat__value">0.9%</span><span class="ds-stat__change" data-trend="neutral">estable</span></div></div></div></div>
      </div>

      <div class="ds-multicol">
        <!-- derived ramps, the brand tool's own subject (decorative, no component) -->
        <section class="ds-box" data-surface="surface" data-border="subtle" data-padding="none">
          <header><Fragment set:html={iconMarkup("edit")} /><strong>Ramps derivados</strong></header>
          <div class="ds-flow">
            <p class="ds-panel__desc">Salen de tus seeds vía color-mix.</p>
            {["neutral", "accent", "danger", "success", "warning"].map((role) => (
              <div class="ds-ramp-row">
                <span class="ds-ramp-label">{role}</span>
                <div class="ds-ramp">
                  {[50, 100, 200, 300, 400, 500, 600, 700, 800, 900].map((s) => (
                    <i style={`background: var(--ramp-${role}-${s})`} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- surfaces: every bg token, so the neutral undertone is legible directly (not just via the ramp) -->
        <section class="ds-box" data-surface="surface" data-border="subtle" data-padding="none">
          <header><Fragment set:html={iconMarkup("copy")} /><strong>Superficies</strong></header>
          <div class="ds-flow">
            <p class="ds-panel__desc">Todas heredan el undertone del neutro elegido.</p>
            <div class="ds-surfaces">
              {[
                ["Canvas", "--color-bg-canvas"],
                ["Surface", "--color-bg-surface"],
                ["Raised", "--color-bg-surface-raised"],
                ["Sunken", "--color-bg-surface-sunken"],
                ["Well", "--color-bg-well"],
              ].map(([label, token]) => (
                <div class="ds-surf" style={`background: var(${token})`}>
                  <span>{label}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- icon family: a preview-only theme variable, swapped in place (scoped to .ds-canvas) -->
        <section class="ds-box" data-surface="surface" data-border="subtle" data-padding="none">
          <header><Fragment set:html={iconMarkup("settings")} /><strong>Iconografía</strong></header>
          <div class="ds-flow">
            <p class="ds-panel__desc">La familia de íconos elegida, aplicada al preview.</p>
            <div class="ds-icons">
              {PREVIEW_ICONS.map((name) => (
                <span class="ds-icon"><Fragment set:html={iconMarkup(name)} /></span>
              ))}
            </div>
          </div>
        </section>

        <!-- form: Field + Input + Select + Checkbox + Button -->
        <section class="ds-box" data-surface="surface" data-border="subtle" data-padding="none">
          <header><Fragment set:html={iconMarkup("user")} /><strong>Crear cuenta</strong></header>
          <div class="ds-flow">
            <p class="ds-panel__desc">Empieza con tu correo. Es gratis por 14 días.</p>
            <div class="ds-field">
              <label class="ds-field__label" for="cs-name">Nombre</label>
              <input class="ds-input" id="cs-name" value="Ada Lovelace" />
            </div>
            <div class="ds-field">
              <label class="ds-field__label" for="cs-mail">Correo</label>
              <input class="ds-input" id="cs-mail" type="email" value="ada@example.com" />
            </div>
            {/* An enhanced Select: real behaviour wired by initComponents(), not just painted markup. */}
            <DimensionSelect
              id="cs-plan"
              label="Plan"
              options={[
                { value: "starter", label: "Starter" },
                { value: "pro", label: "Pro" },
                { value: "enterprise", label: "Enterprise" },
              ]}
            />
            <label class="ds-checkbox">
              <input class="ds-checkbox__input" type="checkbox" checked />
              <span class="ds-checkbox__control ds-interactive" aria-hidden="true"><Fragment set:html={checkboxIndicators} /></span>
              <span class="ds-checkbox__label">Acepto los términos</span>
            </label>
            <div class="ds-row ds-row--end">
              <button class="ds-button ds-interactive" data-variant="ghost" type="button"><Fragment set:html={iconMarkup("close")} />Cancelar</button>
              <button class="ds-button ds-interactive" data-variant="primary" type="button"><Fragment set:html={iconMarkup("check")} />Crear cuenta</button>
            </div>
          </div>
        </section>

        <!-- validation summary: the detailed form stays in the account panel; this compact surface owns only the recovery overview -->
        <section class="ds-box" data-surface="surface" data-border="subtle" data-padding="none">
          <header><Fragment set:html={iconMarkup("warning")} /><strong>Revisar datos</strong><span class="ds-badge" data-tone="danger">2 errores</span></header>
          <div class="ds-flow">
            <p class="ds-panel__desc">Corrige estos campos antes de guardar los cambios.</p>
            <ul class="ds-validation-list">
              <li><Fragment set:html={iconMarkup("warning")} /><span><strong>Correo de facturación</strong><small>Incluye un dominio válido, por ejemplo ada@ejemplo.com.</small></span></li>
              <li><Fragment set:html={iconMarkup("warning")} /><span><strong>Empresa</strong><small>Indica el nombre legal que debe aparecer en las facturas.</small></span></li>
            </ul>
            <div class="ds-row ds-row--end"><button class="ds-button ds-interactive" data-variant="primary" type="button"><Fragment set:html={iconMarkup("check")} />Revisar y guardar</button></div>
          </div>
        </section>

        <!-- accordion coordinates its Tile disclosures: one deployment detail stays open at a time -->
        <section class="ds-box" data-surface="surface" data-border="subtle" data-padding="none">
          <header><Fragment set:html={iconMarkup("upload")} /><strong>Detalles del despliegue</strong></header>
          <div class="ds-flow">
            <div data-ds-accordion data-type="single" data-default-value="runtime">
              <section class="ds-tile ds-tile--expandable ds-interactive" data-part="item" data-value="runtime">
                <button class="ds-tile__trigger" type="button" data-part="trigger" aria-expanded="true" aria-controls="cs-deploy-runtime">
                  <span class="ds-tile__content"><span class="ds-tile__title">Runtime y región</span><span class="ds-tile__description">Producción · Frankfurt</span></span><span class="ds-tile__chevron" data-part="chevron" aria-hidden="true"><span data-state="closed"><Fragment set:html={iconMarkup("chevron-down")} /></span><span data-state="open"><Fragment set:html={iconMarkup("chevron-up")} /></span></span>
                </button>
                <div class="ds-tile__expandable-content" id="cs-deploy-runtime" data-part="content"><p class="ds-tile__description">Node 22 · 3 réplicas · desplegado hace 8 minutos.</p></div>
              </section>
              <section class="ds-tile ds-tile--expandable ds-interactive" data-part="item" data-value="rollout">
                <button class="ds-tile__trigger" type="button" data-part="trigger" aria-expanded="false" aria-controls="cs-deploy-rollout">
                  <span class="ds-tile__content"><span class="ds-tile__title">Estrategia de rollout</span><span class="ds-tile__description">Publicación gradual</span></span><span class="ds-tile__chevron" data-part="chevron" aria-hidden="true"><span data-state="closed"><Fragment set:html={iconMarkup("chevron-down")} /></span><span data-state="open"><Fragment set:html={iconMarkup("chevron-up")} /></span></span>
                </button>
                <div class="ds-tile__expandable-content" id="cs-deploy-rollout" data-part="content" hidden><p class="ds-tile__description">10% por cinco minutos, luego 50% y verificación de salud antes del 100%.</p></div>
              </section>
              <section class="ds-tile ds-tile--expandable ds-interactive" data-part="item" data-value="rollback">
                <button class="ds-tile__trigger" type="button" data-part="trigger" aria-expanded="false" aria-controls="cs-deploy-rollback">
                  <span class="ds-tile__content"><span class="ds-tile__title">Plan de reversión</span><span class="ds-tile__description">Última versión estable</span></span><span class="ds-tile__chevron" data-part="chevron" aria-hidden="true"><span data-state="closed"><Fragment set:html={iconMarkup("chevron-down")} /></span><span data-state="open"><Fragment set:html={iconMarkup("chevron-up")} /></span></span>
                </button>
                <div class="ds-tile__expandable-content" id="cs-deploy-rollback" data-part="content" hidden><p class="ds-tile__description">v2.18.4 queda disponible para restaurar tráfico con un solo cambio.</p></div>
              </section>
            </div>
          </div>
        </section>

        <!-- Button + Badge + SegmentedControl -->
        <section class="ds-box" data-surface="surface" data-border="subtle" data-padding="none">
          <header><Fragment set:html={iconMarkup("more")} /><strong>Botones y badges</strong></header>
          <div class="ds-flow">
            <div class="ds-row ds-wrap">
              <button class="ds-button ds-interactive" data-variant="primary" type="button"><Fragment set:html={iconMarkup("add")} />Primary</button>
              <button class="ds-button ds-interactive" type="button"><Fragment set:html={iconMarkup("edit")} />Neutral</button>
              <button class="ds-button ds-interactive" data-variant="danger" type="button"><Fragment set:html={iconMarkup("delete")} />Danger</button>
              <button class="ds-button ds-interactive" data-variant="ghost" type="button"><Fragment set:html={iconMarkup("download")} />Ghost</button>
              <button class="ds-button ds-interactive" data-variant="primary" type="button" disabled><Fragment set:html={iconMarkup("refresh")} />Disabled</button>
            </div>
            <div class="ds-row ds-wrap">
              <span class="ds-badge" data-tone="accent">accent</span>
              <span class="ds-badge" data-tone="success">success</span>
