---
/*
 * /presets reemplaza a /personalizar (el editor rampa por rampa, con densidad, radio, set de
 * íconos, auditoría de contraste en vivo y códigos compartibles). Ese editor exponía CADA variable
 * y pisaba todo el sitio.
 *
 * Un "preset" acá NO es el toggle de acento del header (ese cicla solo 6-7 tokens de color sobre
 * :root — ver lib/palette-presets.ts). Un preset es LOOK & FEEL, no solo paleta: color de acento,
 * color de feedback, LAS SUPERFICIES NEUTRAS (fondo, texto, bordes — no solo el acento), redondez,
 * tipografía, densidad de espaciado, sombra en reposo, peso de las etiquetas y hasta cuánto se hunde
 * un botón al presionarlo cambian todos juntos. Cada preset re-declara ese bundle sobre
 * `.preset-canvas`, nunca sobre :root, así que elegir uno no cambia esta página ni el resto del
 * sitio (por eso no hay localStorage acá, a diferencia del selector del header, que sí es una
 * preferencia del sitio).
 *
 * Los cinco viven simultáneamente como GALERÍA DE SOLO LECTURA: nada es seleccionable, no hay un
 * control que cicle entre ellos — cada tarjeta ya muestra su propio resultado, lado a lado con las
 * demás, para poder compararlos de un vistazo.
 *
 * El mecanismo es el mismo truco de re-declaración que usaba /personalizar (ver el historial): los
 * tokens semánticos de color y radio se vuelven a declarar sobre `.preset-canvas` (la línea base,
 * calcada de :root, para que la tarjeta no dependa de qué preset de acento tenga elegido el header
 * en ese momento). Cada preset con carácter propio agrega su `[data-preset="id"]` encima de esa base,
 * reemplazando solo lo que lo distingue: no necesita generar paletas privadas en runtime.
 *
 * LAYOUT: `sk-layout-grid` (packages/core/css/patterns/layout.css), el patrón publicado, no CSS
 * bespoke. Ni la prosa ni la galería llevan `data-width`, así que ambas resuelven a la misma medida
 * "content" (64rem) — el texto no queda en una columna más angosta que las tarjetas de abajo, todo
 * el bloque respira al mismo ancho. `<Toc rail>` es el rail publicado (`data-width="rail"`,
 * `packages/core/css/components/toc.css`) en vez de un nav lateral hecho a mano. `fullBleed` se
 * mantiene: esta página sigue sin el SidebarNav de documentación (navegar el árbol de componentes
 * no es lo mismo que saltar entre presets de esta única página), pero el rail del Toc reemplaza lo
 * que antes era un `<nav>` propio.
 */
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Toc from "../components/Toc.astro";
import { tokens } from "../lib/tokens";
import { dummyImage } from "../examples/card-data";
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/image-frame.css";

/* A real (if generic) placeholder photo, not a gradient wash: the same dummyimage.com trick every
 * other card example in these docs already uses (examples/card-data.ts). One shared URL for all 20
 * card instances (5 presets × 2 schemes) — the browser fetches it once and serves the rest from
 * cache, so this costs one network request, not twenty. */
const demoImage = dummyImage(640, 220, "d4d4d4", "737373", "Imagen");

interface Preset {
  id: string;
  name: string;
  description: string;
  fontImport?: string;
  vars: string[];
}

/*
 * Each card renders its demo TWICE, side by side, one half with `color-scheme: light` forced and
 * the other with `color-scheme: dark` forced — not a "current site theme" preview but both at once,
 * so a preset can be judged in either mode without the reader having to flip the header's theme
 * toggle and scroll back. This costs nothing extra to wire: every `--color-*` token here is already
 * `light-dark(...)`, and `light-dark()` resolves against whatever `color-scheme` is in effect on the
 * element consuming it — the exact mechanism the real theme toggle uses on `<html>`, just scoped to
 * a `<div>` instead.
 */
const SCHEMES = [
  { id: "light", label: "Claro" },
  { id: "dark", label: "Oscuro" },
] as const;

/*
 * Five presets, named for what they evoke, not for the hue that happens to carry them —
 * "Predeterminado" and "UC" are the two exceptions, and neither is a color name either (a baseline
 * and a real institution's initials). Each non-default preset pairs an accent family with a
 * DIFFERENT neutral family for its surfaces/text/borders (ADR 0019's constant, published palettes —
 * stone/gray/slate/neutral/zinc all ship full 50–950 ramps already), plus a radius multiplier and a
 * typeface, plus — where it earns its keep — a spacing density (`--sk-density-factor`, needs
 * `data-sk-density-scope` on the canvas below to have any effect), a resting shadow
 * (`--elevation-flat`, `none` by default), a label weight (`--font-weight-label`) and how far a
 * button sinks on press (`--motion-press-scale`, `0.98` by default, `1` means no squeeze at all).
 * Not every preset touches every dimension — a preset that leaves one alone is still a real choice,
 * not a gap.
 */
const PRESETS: Preset[] = [
  {
    id: "default",
    name: "Predeterminado",
    description: "El sistema tal como sale de fábrica: sin overrides.",
    vars: [],
