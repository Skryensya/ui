      "--color-text-danger: oklch(65.42% 0.1996 24.53);",
      "--color-border-danger: oklch(65.42% 0.1996 24.53);",
      "--color-bg-danger-subtle: light-dark(oklch(96% 0.04 25), oklch(26% 0.08 25));",
      "--color-text-success: oklch(63.94% 0.2176 142.5);",
      "--color-border-success: oklch(63.94% 0.2176 142.5);",
      "--color-bg-success-subtle: light-dark(oklch(96% 0.05 142), oklch(24% 0.08 142));",
      "--color-text-warning: oklch(45% 0.13 86);",
      "--color-border-warning: oklch(77.8% 0.1592 86.47);",
      "--color-bg-warning-subtle: light-dark(oklch(96% 0.08 86), oklch(27% 0.07 86));",
      "--color-bg-canvas: light-dark(var(--palette-gray-100), var(--palette-gray-950));",
      "--color-bg-surface: light-dark(var(--palette-white), var(--palette-gray-900));",
      "--color-bg-surface-raised: light-dark(var(--palette-white), var(--palette-gray-800));",
      "--color-bg-surface-sunken: light-dark(var(--palette-gray-200), var(--palette-gray-950));",
      "--color-text-primary: light-dark(var(--palette-gray-900), var(--palette-gray-100));",
      "--color-text-secondary: light-dark(var(--palette-gray-700), var(--palette-gray-300));",
