      "--color-bg-surface: light-dark(var(--palette-white), var(--palette-zinc-900));",
      "--color-bg-surface-raised: light-dark(var(--palette-white), var(--palette-zinc-800));",
      "--color-bg-surface-sunken: light-dark(var(--palette-zinc-200), var(--palette-zinc-950));",
      "--color-text-primary: light-dark(var(--palette-zinc-900), var(--palette-zinc-100));",
      "--color-text-secondary: light-dark(var(--palette-zinc-700), var(--palette-zinc-300));",
      "--color-text-tertiary: light-dark(var(--palette-zinc-600), var(--palette-zinc-400));",
      "--color-border-subtle: light-dark(var(--palette-zinc-300), var(--palette-zinc-800));",
      "--color-border-default: light-dark(var(--palette-zinc-500), var(--palette-zinc-500));",
      "--color-border-strong: light-dark(var(--palette-zinc-600), var(--palette-zinc-400));",
