---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { mediaGradientCardTree, mediaGradientEdgesTree } from "../../demos/media-gradient";
import { getLocale, useTranslations } from "../../i18n";

const install = `@import "@skryensya/core/patterns/media-gradient.css";
@import "@skryensya/core/patterns/image-frame.css";`;

const t = useTranslations(getLocale(Astro.url));

const vanillaApi = `<!-- The wash lives INSIDE the caption: it measures what the type measures -->
<div class="sk-image-frame" data-aspect="16/9">
  <img class="sk-image-frame__media" src="/foto.jpg" alt="…" />
  <div class="sk-media-caption" data-edge="bottom">
    <div
      class="sk-media-gradient"
      data-strength="md"
      aria-hidden="true"
    ></div>
    <h3 class="sk-heading" data-size="h4" data-flush>Title</h3>
  </div>
</div>

<!-- More opacity / tint (not more coverage of the photo) -->
<style>
  .hero-media .sk-media-gradient {
    --sk-media-gradient-mix: 48%;
    --sk-media-gradient-opacity: 88%;
  }
</style>`;

const reactApi = `import { ImageFrame } from "@skryensya/react/image-frame";
import { MediaCaption } from "@skryensya/react/media-gradient";

<ImageFrame aspect="16/9" src="/foto.jpg" alt="…" caption={
  <MediaCaption edge="bottom" strength="md">
    <h3 className="sk-heading" data-size="h4" data-flush>
      Title
    </h3>
  </MediaCaption>
} />;`;
---

<Base
  title="Gradients"
  documentLayout="grid"
  description="Media gradient: wash the size of the text, with accent tint, for contrast on photos."
>
  <h1>Gradients</h1>
  <p class="lede">
    When the type lives <strong>on a photo</strong>, the contrast is not guaranteed by the text
    token: it is guaranteed by a wash. <code>sk-media-gradient</code> lives
    <strong>inside</strong> the caption, so it is as tall (or as wide) as the text it protects, not
    a veil over the entire image. Dyed with accent. It is not the Backdrop of a dialog nor the State
    layer of a control.
  </p>

  <h2>Image card</h2>
  <p>
    ImageFrame crops; the caption carries the type and wash at its own measure. The card below is
    still <a href="/en/components/box">Box</a> + composition (there is no <code>sk-card</code>).
  </p>
  <ComponentPreview tree={mediaGradientCardTree(t)} label="Card + media gradient" />

  <h2>Install</h2>
  <CodeBlock code={install} label="CSS" />

  <h2>From code</h2>
  <p>
    The caption has <code>data-edge</code>; its child wash has <code>data-strength</code> (opacity /
    tint). In React, <code>MediaCaption strength</code> injects the wash. The tint comes from
    <code>--sk-media-gradient-tint</code> (default <code>--color-action-accent</code>). ImageFrame
    takes the caption as a slot/prop, not as a second media source.
  </p>
  <CodeBlock code={vanillaApi} label="HTML + CSS" />
  <CodeBlock code={reactApi} label="React" lang="tsx" />

  <h2>Edges</h2>
  <p>
    <code>top</code>/<code>bottom</code>: the band is as tall as the text (full width).
    <code>start</code>/<code>end</code>: as wide as the text (height to content).
  </p>
  <ComponentPreview tree={mediaGradientEdgesTree()} label="Edges" />

  <h2>Contract</h2>
  <ul>
    <li>
      Host positioned: <code>sk-image-frame</code> is already <code>position: relative</code>.
    </li>
    <li>
      Caption: <code>sk-media-caption</code> with <code>data-edge</code>
      (<code>top|bottom|start|end</code>). Its box is the measure of the wash.
    </li>
    <li>
      Wash: <code>sk-media-gradient</code> <strong>child</strong> of the caption, with
      <code>aria-hidden="true"</code> and <code>data-strength</code> (<code>sm|md|lg</code>).
    </li>
    <li>
      With <a href="/en/transparency"><code>prefers-reduced-transparency</code></a>, the gradient is
      replaced by the opaque base color within the same caption box.
    </li>
    <li>
      Tint: <code>--sk-media-gradient-tint</code>, <code>--sk-media-gradient-mix</code>,
      <code>--sk-media-gradient-opacity</code>.
    </li>
    <li>
      React: <code>ImageFrame caption</code>, <code>MediaCaption</code> (with optional
      <code>strength</code>) and <code>MediaGradient</code> from
      <code>@skryensya/react/media-gradient</code>.
    </li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "patterns/media-gradient.css",
        probe: "sk-media-gradient",
        title: "Media gradient",
      },
    ]}
  />
</Base>
