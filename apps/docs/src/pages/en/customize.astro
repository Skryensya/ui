      s += b36(Math.max(0, RADIUS_LEVELS.indexOf(overrides["--radius-multiplier"] || dimensionDefaults["--radius-multiplier"])));
      s += b36(Math.max(0, ICON_SETS.indexOf(iconSet)));
      return s;
    }

    // Rebuilds state from a code; returns false (leaving state untouched) if it is not a current-version code of the
    // expected length, so stale/foreign strings fall through to the next source instead of corrupting.
    function decodeCode(str) {
      if (!str || str.charAt(0) !== CODE_VERSION || str.length !== CODE_LENGTH) return false;
      var next = {}, i = 1;
      data.ramps.forEach(function (ramp) {
        var preset = ramp.presets[fromB36(str.charAt(i++))];
        if (preset && preset.value !== ramp.def) next[ramp.role] = preset.value;
      });
      var dv = DENSITY_LEVELS[fromB36(str.charAt(i++))];
      if (dv && dv !== dimensionDefaults["--sk-density"]) next["--sk-density"] = dv;
      var rv = RADIUS_LEVELS[fromB36(str.charAt(i++))];
      if (rv && rv !== dimensionDefaults["--radius-multiplier"]) next["--radius-multiplier"] = rv;
      overrides = next;
      iconSet = ICON_SETS[fromB36(str.charAt(i++))] || "lucide";
      return true;
    }

    function isDefaultState() { return Object.keys(overrides).length === 0 && iconSet === "lucide"; }

    // ── load: URL hash (shared) first, else localStorage ──
    (function initState() {
      if (decodeCode((location.hash || "").replace(/^#/, ""))) return;
      decodeCode(readCode());
    })();

    function persist() {
      var code = encodeCode();
      writeCode(code);
      var url = new URL(location.href);
      url.hash = isDefaultState() ? "" : code;
      history.replaceState(null, "", url.toString());
    }

    function oklchComponents(rgb) {
      var r = rgb[0] / 255, g = rgb[1] / 255, b = rgb[2] / 255;
      var linear = function (channel) { return channel <= 0.04045 ? channel / 12.92 : Math.pow((channel + 0.055) / 1.055, 2.4); };
      r = linear(r); g = linear(g); b = linear(b);
      var l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
      var m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
      var s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
      l = Math.cbrt(l); m = Math.cbrt(m); s = Math.cbrt(s);
      var lightness = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
      var a = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
      var chromaB = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
      var hue = Math.atan2(chromaB, a) * 180 / Math.PI;
      return { lightness: lightness, chroma: Math.sqrt(a * a + chromaB * chromaB), hue: hue < 0 ? hue + 360 : hue };
    }
    function oklchValue(parts) { return "oklch(" + (parts.lightness * 100).toFixed(1) + "% " + parts.chroma.toFixed(3) + " " + parts.hue.toFixed(1) + ")"; }
    // canvas normalises any color string (rgb/oklch/color(srgb…)) to sRGB bytes
    var cv = document.createElement("canvas");
    var ctx = cv.getContext("2d", { willReadFrequently: true });
    function toRGB(s) { ctx.clearRect(0, 0, 1, 1); ctx.fillStyle = "#000"; ctx.fillStyle = s; ctx.fillRect(0, 0, 1, 1); var d = ctx.getImageData(0, 0, 1, 1).data; return [d[0], d[1], d[2]]; }
    function rgbOf(probe, e) { probe.style.color = ""; probe.style.color = e; var c = getComputedStyle(probe).color; return c ? toRGB(c) : null; }
    function hex(r) { return "#" + r.slice(0, 3).map(function (x) { var h = Math.round(x).toString(16); return h.length < 2 ? "0" + h : h; }).join(""); }
    function lum(r) { var f = function (x) { x /= 255; return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); }; return 0.2126 * f(r[0]) + 0.7152 * f(r[1]) + 0.0722 * f(r[2]); }
    function ratio(a, b) { if (!a || !b) return 0; var la = lum(a), lb = lum(b), hi = Math.max(la, lb), lo = Math.min(la, lb); return (hi + 0.05) / (lo + 0.05); }

    function eachRampValue(role, color, visit) {
      var stop;
      if (role === "neutral") {
        visit("--ramp-neutral-0", "oklch(100% 0 0)");
        for (stop in data.recipe.neutral) {
          var neutral = data.recipe.neutral[stop];
          visit(
            "--ramp-neutral-" + stop,
            "color-mix(in oklab, color-mix(in oklab, black " + neutral[0] +
              "%, white) " + (100 - neutral[1]) + "%, " + color + ")",
          );
        }
        visit("--ramp-neutral-1000", "oklch(0% 0 0)");
        return;
      }
      for (stop in data.recipe.chromaticLight) {
        visit(
          "--ramp-" + role + "-" + stop,
          "color-mix(in oklab, " + color + " " +
            (100 - data.recipe.chromaticLight[stop]) + "%, white)",
        );
      }
      visit("--ramp-" + role + "-600", color);
      for (stop in data.recipe.chromaticDark) {
        visit(
          "--ramp-" + role + "-" + stop,
          "color-mix(in oklab, " + color + " " +
            (100 - data.recipe.chromaticDark[stop]) + "%, black)",
        );
      }
    }
    function applyRamp(role, color) {
      eachRampValue(role, color, function (property, value) {
        stage.style.setProperty(property, value);
      });
    }
    function rampDefault(role) {
      return data.ramps.find(function (item) { return item.role === role; }).def;
    }
    function editRamp(role, color) {
      if (color === rampDefault(role)) delete overrides[role];
      else overrides[role] = color;
      applyRamp(role, color);
      repairMessage = "";
      persist();
      refresh();
    }
    function setDimension(p, v) {
      if (v === dimensionDefaults[p]) delete overrides[p]; else overrides[p] = v;
      stage.style.setProperty(p, v);
      repairMessage = "";
      persist();
      refresh();
    }
    // Icon family is preview-only: swap the icons inside .sk-canvas via the layout's scoped helper,
    // touching neither the docs chrome nor the global icon preference.
    function applyIcons(setId) {
      iconSet = ICON_SETS.indexOf(setId) !== -1 ? setId : "lucide";
      if (typeof window.__dsApplyIconSetWithin === "function") window.__dsApplyIconSetWithin(stage, iconSet);
    }
    function setIconSet(setId) { applyIcons(setId); repairMessage = ""; persist(); refresh(); }
    function roleForPair(fg, bg) {
      var name = fg + " " + bg;
      if (name.indexOf("danger") !== -1) return "danger";
      if (name.indexOf("success") !== -1) return "success";
      if (name.indexOf("warning") !== -1) return "warning";
      if (name.indexOf("info") !== -1) return "info";
      if (name.indexOf("accent") !== -1 || name.indexOf("action-primary") !== -1 || name.indexOf("focus") !== -1) return "accent";
      return "neutral";
    }
    var auditFailures = [];
    var repairMessage = "";

    // ── audit ──
    function buildAudit() {
      var head = '<div class="sk-audit-row sk-audit-head"><span></span><span>clear</span><span>dark</span></div>';
      document.getElementById("sk-audit").innerHTML = head + data.pairs.map(function (p) {
        var name = p.fg.replace("--color-", "") + " / " + p.bg.replace("--color-", "");
        return '<div class="sk-audit-row" data-fg="' + p.fg + '" data-bg="' + p.bg + '" data-min="' + p.min + '"><code title="' + name + '">' + name + "</code><span class='sk-badge2' data-slot='light'></span><span class='sk-badge2' data-slot='dark'></span></div>";
      }).join("");
    }
    function refreshAudit() {
      var pass = 0, total = 0;
      auditFailures = [];
      document.querySelectorAll("#sk-audit .sk-audit-row[data-fg]").forEach(function (row) {
        var fg = row.getAttribute("data-fg"), bg = row.getAttribute("data-bg"), min = +row.getAttribute("data-min");
        [["light", probeL], ["dark", probeD]].forEach(function (pr) {
          var r = ratio(rgbOf(pr[1], "var(" + fg + ")"), rgbOf(pr[1], "var(" + bg + ")"));
          var el = row.querySelector("[data-slot=" + pr[0] + "]");
          var ok = r >= min;
          el.textContent = r ? r.toFixed(1) : "-";
          el.className = "sk-badge2 " + (ok ? "ok" : "bad");
          el.title = pr[0] + " · min " + min + ":1";
          if (!ok) auditFailures.push({ fg: fg, bg: bg, min: min, role: roleForPair(fg, bg) });
          total++; if (ok) pass++;
        });
      });
      var tally = document.getElementById("sk-tally");
      tally.textContent = pass + "/" + total;
      tally.className = "sk-tally " + (pass === total ? "ok" : "bad");
      var fix = document.getElementById("sk-contrast-fix");
      fix.disabled = auditFailures.length === 0;
      document.getElementById("sk-fix-note").textContent = repairMessage || (auditFailures.length ? auditFailures.length + " ratio(s) need adjustment. The correction maintains hue and chroma and moves a maximum of 12 brightness points." : "All pairs are WCAG AA compliant in light and dark.");
    }
    function scoreRamp(role) {
      var deficit = 0, failures = 0;
      data.pairs.forEach(function (pair) {
        if (roleForPair(pair.fg, pair.bg) !== role) return;
        [["light", probeL], ["dark", probeD]].forEach(function (mode) {
          var difference = pair.min - ratio(rgbOf(mode[1], "var(" + pair.fg + ")"), rgbOf(mode[1], "var(" + pair.bg + ")"));
          if (difference > 0) { deficit += difference * difference; failures++; }
        });
      });
      return { deficit: deficit, failures: failures };
    }
    function repairRamp(role) {
      var original = overrides[role] || rampDefault(role);
      var rgb = rgbOf(probeL, original);
      if (!rgb) return false;
      var base = oklchComponents(rgb);
      var best = { value: null, score: scoreRamp(role).deficit };
      for (var step = 1; step <= 12; step++) {
        [-1, 1].forEach(function (direction) {
          var lightness = Math.max(0, Math.min(1, base.lightness + direction * step / 100));
          var candidate = oklchValue({ lightness: lightness, chroma: base.chroma, hue: base.hue });
          applyRamp(role, candidate);
          var score = scoreRamp(role).deficit;
          if (score < best.score) best = { value: candidate, score: score };
        });
      }
      if (!best.value) {
        applyRamp(role, original);
        return false;
      }
      applyRamp(role, best.value);
      overrides[role] = best.value;
      return true;
    }
    function repairContrast() {
      var roles = auditFailures.map(function (failure) { return failure.role; }).filter(function (role, index, list) { return list.indexOf(role) === index; });
      var repaired = roles.filter(repairRamp);
      repairMessage = repaired.length ? "Ajustamos " + repaired.join(", ") + " without changing its hue or chroma. Review the ratios before sharing." :"We did not find an improvement within 12 brightness points; choose another color for the ramp.";
      repaired.forEach(function (role) { remountControl(role, overrides[role]); });
      persist();
      refresh();
    }

    // Flyout enhancers own the displayed value; external changes remount with a new default.
    function remountControl(prop, value) {
      if (typeof window.__remountControl === "function") window.__remountControl(prop, value);
    }

    function refresh() {
      document.querySelectorAll("[data-row]").forEach(function (row) {
        row.classList.toggle("is-overridden", !!overrides[row.getAttribute("data-row")]);
      });
      // The footer shows the live code: it IS the state, so it re-reads on every edit.
      document.getElementById("sk-preset-code").textContent = encodeCode();
      refreshAudit();
    }

    // Color / dimension pickers are Flyout instances (data-sk-flyout). Each emits sk-value-change;
    // choosing the default color keeps the complete default ramp but clears the stored override.
    var rampsContainer = document.querySelector(".sk-ramps");
    if (rampsContainer) {
      rampsContainer.addEventListener("sk-value-change", function (e) {
        var root = e.target.closest("[data-sk-flyout][data-prop]");
        if (!root) return;
        var role = root.getAttribute("data-prop");
        var value = (e.detail && e.detail.value && e.detail.value[0]) || rampDefault(role);
        editRamp(role, value);
      });
    }
    var dimensionsContainer = document.querySelector(".sk-dimensions");
    if (dimensionsContainer) {
      dimensionsContainer.addEventListener("sk-value-change", function (e) {
        var root = e.target.closest("[data-sk-flyout][data-prop]");
        if (!root) return;
        var prop = root.getAttribute("data-prop");
        var value = (e.detail && e.detail.value && e.detail.value[0]);
        if (prop === "icon-set") { setIconSet(value || "lucide"); return; }
        setDimension(prop, value || dimensionDefaults[prop]);
      });
    }
    document.getElementById("sk-reset-all").addEventListener("click", function () {
      overrides = {};
      repairMessage = "";
      data.ramps.forEach(function (ramp) {
        applyRamp(ramp.role, ramp.def);
        remountControl(ramp.role, ramp.def);
      });
      Object.keys(dimensionDefaults).forEach(function (p) {
        stage.style.setProperty(p, dimensionDefaults[p]);
        remountControl(p, dimensionDefaults[p]);
      });
      applyIcons("lucide");
      remountControl("icon-set", "lucide");
      writeCode(null);
      var url = new URL(location.href);
      url.hash = "";
      history.replaceState(null, "", url.toString());
      refresh();
    });

    function openDialog(id) {
      var dialog = document.getElementById(id);
      if (!dialog.open) dialog.showModal();
    }
    document.getElementById("sk-contrast-open").addEventListener("click", function () { openDialog("sk-contrast-dialog"); });
    document.getElementById("sk-contrast-fix").addEventListener("click", repairContrast);

    // The preset IS the code: the URL already carries it in its hash (kept in sync on every edit), so
    // copying the link copies a self-contained theme. The glyph swaps to a check for a beat, and the
    // live region says it out loud for anyone who cannot see the swap.
    var presetBtn = document.getElementById("sk-preset");
    var copyLive = document.getElementById("sk-copy-live");
    var copiedTimer;
    presetBtn.addEventListener("click", function () {
      persist(); // ensure the hash reflects the latest state even if nothing was edited yet
      var link = location.href;
      var done = function () {
        presetBtn.classList.add("is-copied");
        copyLive.textContent = "Link of the copied preset";
        clearTimeout(copiedTimer);
        copiedTimer = setTimeout(function () {
          presetBtn.classList.remove("is-copied");
          copyLive.textContent = "";
        }, 1600);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(link).then(done, done);
      else done();
    });

    // Stage-only defaults keep this workbench independent from the docs' global color and dimensions.
    data.ramps.forEach(function (ramp) {
      applyRamp(ramp.role, overrides[ramp.role] || ramp.def);
    });
    Object.keys(dimensionDefaults).forEach(function (p) {
      stage.style.setProperty(p, overrides[p] || dimensionDefaults[p]);
    });
    buildAudit();
    // Deferred module scripts do not have a guaranteed relationship with the first animation frame.
    // Restore controls when the bridge announces readiness; rAF covers an already-loaded bridge.
    var didRestoreControls = false;
    function restoreControlState() {
      if (didRestoreControls || typeof window.__remountControl !== "function") return;
      didRestoreControls = true;
      refresh();
      data.ramps.forEach(function (ramp) {
        if (overrides[ramp.role]) remountControl(ramp.role, overrides[ramp.role]);
      });
      Object.keys(dimensionDefaults).forEach(function (p) {
        if (overrides[p]) remountControl(p, overrides[p]);
      });
      applyIcons(iconSet);
      if (iconSet !== "lucide") remountControl("icon-set", iconSet);
    }
    window.addEventListener("sk-playground-controls-ready", restoreControlState, { once: true });
    requestAnimationFrame(restoreControlState);
  })();
</script>

<script>
  // Bridge so the inline playground can re-point a Flyout at a new value (reset / repair / share restore).
  import { mountFlyout } from "@skryensya/vanilla/flyout";
  import { destroyMount } from "@skryensya/vanilla/runtime";

  // The consumer is an `is:inline` script, which has no import graph to share a type through, so the
  // bridge is declared on Window: that IS the interface between the two scripts.
  declare global {
    interface Window {
      __remountControl?: (prop: string, value: string | null) => void;
    }
  }

  window.__remountControl = function (prop: string, value: string | null) {
    const root = document.querySelector<HTMLElement>('[data-sk-flyout][data-prop="' + prop + '"]');
    if (!root) return;
    destroyMount(root);
    if (value) root.setAttribute("data-value", value);
    else root.removeAttribute("data-value");
    mountFlyout(root);
  };
  window.dispatchEvent(new Event("sk-playground-controls-ready"));
</script>
