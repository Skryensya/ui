---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import "@skryensya/core/patterns/transparency.css";

const install = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/patterns/box.css";
@import "@skryensya/core/patterns/transparency.css";`;

const basicHtml = `<article
  class="sk-box sk-translucent"
  data-strength="md"
  data-border="subtle"
  data-padding="lg"
  data-surface="surface"
>
  <h2>Weekly Summary</h2>
  <p>Content always lives on an opaque fallback.</p>
</article>`;

const navbarReact = `import {
  Navbar,
  NavbarActions,
  NavbarBrand,
} from "@skryensya/react/navbar";
import { Button } from "@skryensya/react/button";

<Navbar className="sk-translucent" data-strength="sm">
  <NavbarBrand>Atlas</NavbarBrand>
  <NavbarActions>
    <Button variant="ghost">Search</Button>
    <Button variant="accent">Crear</Button>
  </NavbarActions>
</Navbar>;`;

const boxReact = `import { Box } from "@skryensya/react/box";

<Box
  as="article"
  className="sk-translucent"
  data-strength="md"
  surface="surface"
  border="subtle"
  padding="lg"
>
  <h2>Activity</h2>
  <p>12 changes since your last visit.</p>
</Box>;`;

const dialogHtml = `<dialog
  class="sk-dialog sk-translucent"
  data-strength="sm"
  aria-labelledby="invite-title"
>
  <header class="sk-dialog__header">
    <h2 id="invite-title" class="sk-dialog__title">
      Invite team
    </h2>
  </header>
  <div class="sk-dialog__body">
    <p>The backdrop and surface are reduced separately.</p>
  </div>
</dialog>`;

const customize = `.hero-glass {
  /* The opaque fallback against which contrast is validated. */
  --sk-translucent-surface: var(--color-bg-surface-raised);

  /* They are only used when transparency is allowed. */
  --sk-translucent-opacity: 76%;
  --sk-translucent-blur: 20px;
  --sk-translucent-saturation: 120%;
}`;

const manualReduction = `.legacy-glass {
  background: rgb(255 255 255 / 72%);
  backdrop-filter: blur(16px);
}

@media (prefers-reduced-transparency: reduce) {
  .legacy-glass {
    background: var(--color-bg-surface);
    backdrop-filter: none;
  }
}`;
---

<Base
  title="Transparencias"
  documentLayout="grid"
  description="Reusable translucent surfaces, with progressive blur, opaque fallback and automatic reduction."
>
  <h1>Transparency</h1>
  <p class="lede">
    A translucent surface allows the context to be seen without giving it contrast. The <code>sk-translucent</code> class composes alpha and backdrop blur on known components, but always starts from an opaque surface. If the browser does not understand the preference, or the person asks to reduce transparency, the content retains exactly the same box and reading.
  </p>

  <div class="sk-callout" data-tone="info">
    <div class="sk-callout__content">
      <p>
        <strong><code>prefers-reduced-transparency</code> remains experimental. </strong> That is why the system does not depend on the <code>reduce</code> branch to be secure: transparency and blur are only enabled under <code>no-preference</code>. Without support, the fallback is opaque.
      </p>
    </div>
  </div>

  <h2>What's happening</h2>
  <p>
    There are three layers. The <strong>backdrop</strong> is what was already behind; the
    <strong>surface</strong> mixes its opaque color with alpha and blurs that backdrop; the
    <strong>content</strong> remains on top, at 100% opacity. Never applied
    <code>opacity</code> to the entire container because it would also degrade text, icons, and borders.
  </p>

  <figure class="transparency-lab">
    <div class="transparency-lab__stage">
      <div class="transparency-lab__backdrop" aria-hidden="true">
        <span>ALPHA</span>
        <span>BLUR</span>
        <span>CONTRASTE</span>
      </div>

      <div class="transparency-lab__status">
        <span class="transparency-lab__status-fallback">Fallback opaco</span>
        <span class="transparency-lab__status-allowed">Transparencia permitida</span>
        <span class="transparency-lab__status-reduced">Transparencia reducida</span>
      </div>

      <div class="transparency-lab__samples">
        <article
          class="sk-box sk-translucent transparency-lab__panel"
          data-strength="sm"
          data-border="subtle"
        >
          <code>sm</code>
          <strong>Discreet</strong>
          <span>92% surface · 8px blur</span>
        </article>
        <article
          class="sk-box sk-translucent transparency-lab__panel"
          data-strength="md"
          data-border="subtle"
        >
          <code>md</code>
          <strong>Standard</strong>
          <span>82% surface · 16px blur</span>
        </article>
        <article
          class="sk-box sk-translucent transparency-lab__panel"
          data-strength="lg"
          data-border="subtle"
        >
          <code>lg</code>
          <strong>Expressive</strong>
          <span>70% surface · 24px blur</span>
        </article>
      </div>
    </div>
    <figcaption>
      The calibration background combines fine borders, color changes and typography so that alpha and blur are visible. With reduction, the three samples converge on the same opaque surface.
    </figcaption>
  </figure>

  <h2>Install</h2>
  <p>
    The pattern is opt-in. First import the tokens and styles of the component you want to paint; <code>transparency.css</code> provides the composable class and its accessible policy.
  </p>
  <CodeBlock code={install} label="CSS" />

  <h2>One class, three intensities</h2>
  <p>
    Adds <code>sk-translucent</code> to the same node that already paints the surface. Without <code>data-strength</code>, the value is <code>md</code>. Intensity describes how much the effect is perceived: <code>lg</code> lets you see more of the backdrop and blurs it more.
  </p>
  <CodeBlock code={basicHtml} label="HTML" lang="html" />

  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Strength</th>
          <th class="sk-table__header">Surface</th>
          <th class="sk-table__header">Blur</th>
          <th class="sk-table__header">Recommended use</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row">
          <td class="sk-table__cell"><code>sm</code></td>
          <td class="sk-table__cell">92%</td>
          <td class="sk-table__cell">8px</td>
          <td class="sk-table__cell">Navbar, Sidebar, Dialog</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><code>md</code></td>
          <td class="sk-table__cell">82%</td>
          <td class="sk-table__cell">16px</td>
          <td class="sk-table__cell">Box, cards y paneles flotantes</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><code>lg</code></td>
          <td class="sk-table__cell">70%</td>
          <td class="sk-table__cell">24px</td>
          <td class="sk-table__cell">Hero o pieza editorial; nunca UI densa</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Components conocidos</h2>
  <p>
    The class already binds the <strong>Box, Navbar, Dialog, Sidebar, Vaul and Drawer</strong> surface hooks. It does not change its anatomy or create a parallel variant: the same component gains an optional paint.
  </p>

  <h3>Navbar: persistent and unobtrusive</h3>
  <p>
    Use <code>sm</code>: Navigation remains stable while content passes behind.
  </p>
  <CodeBlock code={navbarReact} label="React · Navbar" lang="tsx" />

  <h3>Box: a card on media</h3>
  <p>
    <code>md</code> works when the card floats over an image or editorial background. On a flat canvas, an opaque Box is simpler and does not need this pattern.
  </p>
  <CodeBlock code={boxReact} label="React · Box" lang="tsx" />

  <h3>Dialog: the panel and the backdrop are different things</h3>
  <p>
    The class paints the panel. The <code>:: backdrop</code> still belongs to Dialog and becomes opaque with reduced transparency. For a modal preserves <code>sm</code>: the task should dominate, not the background.
  </p>
  <CodeBlock code={dialogHtml} label="HTML · Dialog" lang="html" />

  <h2>Customize without breaking the fallback</h2>
  <p>
    <code>--sk-translucent-surface</code> is the actual opaque surface. The other three hooks only affect transparent enhancement. Changing the alpha should never be the way to fix contrast: first choose a correct opaque surface and validate text and borders against it.
  </p>
  <CodeBlock code={customize} label="CSS · hooks" />

  <h2>When not to use it</h2>
  <ul>
    <li>On a flat canvas: there is no useful context to reveal.</li>
    <li>In tables, long forms or dense UI: the backdrop competes with the reading.</li>
    <li>As the only separation between two regions: preserves edge, space or elevation.</li>
    <li>Applying <code>opacity</code> to the container: also makes the contents translucent.</li>
    <li>In State layer: that alpha communicates interaction and is not a glassmorphism surface.</li>
  </ul>

  <h2>Inherited surfaces</h2>
  <p>
    If you cannot adopt <code>sk-translucent</code>, add an explicit reduction. This form works for older code, but the baseline remains transparent in browsers without support; for new code, the system class is safer.
  </p>
  <CodeBlock code={manualReduction} label="CSS legado" />

  <h2>System Contract</h2>
  <ul>
    <li>
      <strong>Dialog and Vaul. </strong> Your backdrops go from a mix with <code>transparent</code> to an opaque background. Modality and drag remain.
    </li>
    <li>
      <strong>Half gradient. </strong> The wash becomes the opaque base color inside the caption box; It does not cover the entire image.
    </li>
    <li>
      <strong>State layer. </strong> It is kept because it is essential feedback; selection and focus have independent indicators.
    </li>
    <li>
      <strong>Transition blur. </strong> Belongs to <a href="/en/motion"><code>prefers-reduced-motion</code></a>, not this surface policy.
    </li>
  </ul>

  <h2>Checklist</h2>
  <ul>
    <li>The opaque fallback works before any media query.</li>
    <li>The class lives on the same node that paints the surface.</li>
    <li>Text and icons remain at 100% opacity.</li>
    <li>The edge or elevation continues to separate the box from the bottom.</li>
    <li>The UI works if the browser completely ignores the preference.</li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "patterns/transparency.css",
        probe: "sk-translucent",
        title: "Transparencia",
      },
    ]}
  />

  <p>
    Platform reference: <a
 href="https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@media/prefers-reduced-transparency"
 >MDN, <code>prefers-reduced-transparency</code></a>.
  </p>
</Base>

<style>
  .transparency-lab {
    display: grid;
    gap: var(--space-stack-sm);
    margin: var(--space-stack-md) 0 var(--space-section);
  }

  .transparency-lab__stage {
    position: relative;
    min-block-size: 30rem;
    padding: clamp(var(--space-inset-md), 5vw, var(--space-inset-xl));
    overflow: clip;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-surface);
    background:
      repeating-linear-gradient(
        0deg,
        color-mix(in oklab, var(--color-text-primary) 18%, transparent) 0 1px,
        transparent 1px 24px
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in oklab, var(--color-text-primary) 18%, transparent) 0 1px,
        transparent 1px 24px
      ),
      linear-gradient(
        135deg,
        var(--color-bg-accent-subtle) 0 32%,
        var(--color-action-accent) 32% 42%,
        var(--color-bg-warning-subtle) 42% 72%,
        var(--color-bg-success-subtle) 72% 100%
      );
    isolation: isolate;
  }

  .transparency-lab__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    align-content: space-between;
    padding: var(--space-inset-md);
    color: color-mix(in oklab, var(--color-text-primary) 72%, transparent);
    font-family: var(--font-family-mono);
    font-size: clamp(2.5rem, 10vw, 7rem);
    font-weight: var(--font-weight-heading);
    letter-spacing: -0.08em;
    line-height: 0.72;
    overflow: hidden;
  }

  .transparency-lab__backdrop span:nth-child(2) {
    justify-self: center;
  }

  .transparency-lab__backdrop span:last-child {
    justify-self: end;
  }

  .transparency-lab__status {
    position: relative;
    z-index: 1;
    display: inline-flex;
    justify-self: start;
    margin-block-end: var(--space-stack-lg);
    padding: var(--space-inset-xs) var(--space-inset-sm);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-pill);
    background: var(--color-bg-surface);
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-label);
  }

  .transparency-lab__status-allowed,
  .transparency-lab__status-reduced {
    display: none;
  }

  .transparency-lab__samples {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-inline-md);
    align-items: end;
  }

  .transparency-lab__panel {
    display: grid;
    gap: var(--space-stack-xs);
    min-block-size: 13rem;
    padding: var(--space-inset-md);
    align-content: end;
    border-color: color-mix(
      in oklab,
      var(--color-border-strong) 72%,
      transparent
    );
    border-radius: var(--radius-surface);
    box-shadow: var(--elevation-raised);
  }

  .transparency-lab__panel code {
    justify-self: start;
    padding: 0.15em 0.45em;
    border-radius: var(--radius-control);
    background: var(--color-bg-surface-sunken);
    color: var(--color-text-accent);
  }

  .transparency-lab__panel strong {
    font-size: var(--font-size-heading-sm);
  }

  .transparency-lab__panel span {
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
  }

  .transparency-lab figcaption {
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
    line-height: var(--font-line-height-caption);
    text-wrap: pretty;
  }

  @media (prefers-reduced-transparency: no-preference) {
    .transparency-lab__status-fallback {
      display: none;
    }

    .transparency-lab__status-allowed {
      display: inline;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .transparency-lab__status-fallback {
      display: none;
    }

    .transparency-lab__status-reduced {
      display: inline;
    }
  }

  @media (max-width: 48rem) {
    .transparency-lab__samples {
      grid-template-columns: 1fr;
    }

    .transparency-lab__panel {
      min-block-size: 8rem;
    }
  }
</style>
