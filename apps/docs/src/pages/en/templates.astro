---
import Base from "../../layouts/Base.astro";
import TemplatesPage from "../../components/pages/TemplatesPage.astro";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
---

{/* The phone's jump links to each template live in the drawer's own tree now (Base builds a
    "Templates" collapsible section from `templateSections`), not in a per-page rail poured in above
    it. */}
<Base fullBleed title={t("templates.title")} description={t("templates.description")}>
  <TemplatesPage />
</Base>
