---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";
import ComponentPreview from "../../components/ComponentPreview.astro";

/* The site remains an honest consumer: input/field needs its authored paint rules. */

const componentMarkup = `<section
  class="sk-box sk-stack"
  data-sk-density-scope
  style="--sk-density-factor: 0.72"
  data-surface="surface"
  data-border="subtle"
  data-padding="lg"
  data-gap="sm"
>
  <header>
    <strong>Order Summary</strong>
  </header>

  <div class="sk-form-field">
    <label class="sk-form-field__label" for="delivery-email">Email</label>
    <input class="sk-input" id="delivery-email" type="email" />
  </div>

  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-tone="accent"
    type="button"
  >
    Save changes
  </button>
</section>`;

const absoluteDensity = `<section
  data-sk-density-scope
  style="--sk-density: 0.72"
>
  <!-- normal component content -->
</section>`;

const densityLabScript = `document.querySelectorAll("[data-density-lab]").forEach((lab) => {
  const slider = lab.querySelector("[data-density-slider]");
  const target = lab.querySelector("[data-density-target]");
  const factorOutput = lab.querySelector("[data-density-factor-output]");
  const effectiveOutput = lab.querySelector("[data-density-effective-output]");
  const paddingOutput = lab.querySelector("[data-density-padding-output]");
  const buttonOutput = lab.querySelector("[data-density-button-output]");
  const button = target?.querySelector(".sk-button");

  if (
    !(slider instanceof HTMLElement)
    || !(target instanceof HTMLElement)
    || !(factorOutput instanceof HTMLElement)
    || !(effectiveOutput instanceof HTMLElement)
    || !(paddingOutput instanceof HTMLElement)
    || !(buttonOutput instanceof HTMLElement)
    || !(button instanceof HTMLButtonElement)
  ) return;

  const render = () => {
    const thumb = slider.querySelector('[role="slider"]');
    const value = Number(thumb?.getAttribute("aria-valuenow") ?? slider.getAttribute("data-value"));
    const factor = value / 100;

    target.style.setProperty("--sk-density-factor", String(factor));
    thumb?.setAttribute("aria-valuetext", \`\${factor.toFixed(2)} veces la densidad del sistema\`);
    factorOutput.textContent = \`\${factor.toFixed(2)}×\`;

    const density = Number.parseFloat(getComputedStyle(target).getPropertyValue("--sk-density"));
    effectiveOutput.textContent = \`\${density.toFixed(2)}×\`;
    paddingOutput.textContent = getComputedStyle(target).paddingInlineStart;
    buttonOutput.textContent = \`\${Math.round(button.getBoundingClientRect().height)}px\`;
  };

  slider.addEventListener("sk-value-change", render);
  render();
});`;

const densityPreviewTree: UsageTree = {
  contract: "layout",
  signature: "Stack",
  options: { gap: "lg" },
  attrs: { "data-density-lab": "", style: "inline-size: 100%" },
  children: [
    {
      contract: "layout",
      signature: "Stack",
      options: { gap: "xs" },
      children: [
        {
          contract: "layout",
          signature: "Inline",
          options: { gap: "sm", inlineAlign: "baseline" },
          children: ["Local factor", { contract: "typography", signature: "Code", attrs: { "data-density-factor-output": "" }, children: "1.00×" }],
        },
        { contract: "slider", signature: "Slider", options: { value: 72, min: 50, max: 120, step: 1 }, attrs: { id: "density-factor-control", "aria-label": "Local factor", "data-density-slider": "", "aria-valuetext": "0.72 veces la densidad del sistema" } },
      ],
    },
    {
      // Raw `data-sk-density-scope` + `--sk-density-factor`, hand-authored on the attrs the same
      // way `CopyButton.astro` and the presets gallery already do it: the scope is a plain
      // attribute contract, not something that ever needed its own signature to exist.
      contract: "box",
      signature: "Box",
      options: { surface: "surface", border: "subtle", padding: "lg" },
      attrs: {
        class: "sk-stack",
        "data-density-target": "",
        "data-gap": "sm",
        "data-sk-density-scope": "",
        style: "--sk-density-factor: 0.72",
      },
      children: [
        "Order summary",
        {
          contract: "form-field",
          signature: "FormField",
          slots: {
            label: "Email",
            children: { contract: "input", signature: "Input", options: { type: "email" }, attrs: { id: "delivery-email" } },
          },
        },
        { contract: "button", signature: "Button.action", options: { tone: "accent" }, children: "Save changes" },
        {
          contract: "layout",
          signature: "Inline",
          options: { gap: "sm", inlineAlign: "baseline" },
          children: [
            { contract: "button", signature: "Button.action", options: { variant: "ghost" }, children: "Cancel" },
            { contract: "typography", signature: "Code", attrs: { "data-density-effective-output": "" }, children: "0.72×" },
            { contract: "typography", signature: "Code", attrs: { "data-density-padding-output": "" }, children: "0px" },
            { contract: "typography", signature: "Code", attrs: { "data-density-button-output": "" }, children: "44px" },
          ],
        },
      ],
    },
  ],
};
---

<Base
  title="Component Density"
  documentLayout="grid"
  description="Adjust the spacing and controls of an isolated component without compacting the rest of the interface."
>
  <h1>Component Density</h1>
  <p class="lede">
    Local density is not a component variant. It is a scope that recalculates the <strong>space and control tokens at the boundary of your</strong> component, without touching its neighbors or the density chosen for the application.
  </p>

  <div class="sk-callout" data-tone="info">
    <div class="sk-callout__content">
      <p>
        <strong>The entire contract lives on the same node: </strong> <code>data-sk-density-scope</code> triggers local reprojection; <code>--sk-density-factor</code> or <code>--sk-density</code>, written in <code>style</code>, decides its value. This scope does not add classes, selectors, required presets or a prop to each component.
      </p>
    </div>
  </div>

  <h2>Set it to the limit you already have</h2>
  <p>
    Put the attribute once, at the root of the component you want to compact, and write the value there as an inline style. Their descendants continue to read the same semantic tokens; you do not need to create a class for the scope or mark each button, field or row separately.
  </p>
  <CodeBlock code={componentMarkup} label="Component HTML" />

  <h2>Use a relative factor by default</h2>
  <p>
    <code>--sk-density-factor</code> preserves the user's intent. If the application is in <code>0.8</code> and the component uses <code>0.72</code>, its effective density is <code>0.576</code>. The value can be any valid number, without depending on presets.
  </p>

  <p>
    Use an absolute value only when the component needs an application-independent measurement. The absolute value wins over the factor; choose one or the other, not both.
  </p>
  <CodeBlock code={absoluteDensity} label="HTML with absolute value" />

  <h2>Test an isolated component</h2>
  <p>
    Control is out of scope. Drag it: change the padding, gaps and semantic sizes within the summary; the rest of the page does not move.
  </p>
  <ComponentPreview tree={densityPreviewTree} previewScript={densityLabScript} label="Local Scope in action" note="scope and value live inline on the same node" />

  <h2>What changes, and what does not</h2>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row"><th class="sk-table__header">Within the scope</th><th class="sk-table__header">Comportamiento</th></tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row"><td class="sk-table__cell"><code>--space-*</code></td><td class="sk-table__cell">Padding, gaps and insets are recalculated with the effective density.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell"><code>--size-control-*</code></td><td class="sk-table__cell">They are recalculated, with the minimum floor size incorporated.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Typography, icons and radio</td><td class="sk-table__cell">They remain invariant: density brings content closer, the visual scale does not change.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Focus ring and touch area</td><td class="sk-table__cell">They remain protected. A default Button does not drop <code>44px</code> paint; <code>data-size="sm"</code> can paint at 32px and the hit is still on <code>44px</code>.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Wrappers y <code>--space-section</code></td><td class="sk-table__cell">Not compacted: The page geometry does not belong to the component.</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Nested Scopes do not shrink twice</h2>
  <p>
    Each scope calculates its factor against the captured density of the system, not against the parent scope. A <code>0.72</code> component inside a <code>0.72</code> component still resolves to <code>0.72 × sistema</code>, not <code>0.5184 × sistema</code>. Thus a subcomponent is not made unreadable by accidental composition.
  </p>

  <p>
    To configure the density of the entire application, use <a href="/en/dimensions#densidad--un-multiplicador-con-el-piso-adentro">the</a> global dimension. For a local exception, keep the scope at the edge of the component and let its tokens do the rest.
  </p>
</Base>

