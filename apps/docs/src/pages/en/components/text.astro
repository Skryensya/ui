---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import { TextInlineDemo } from "../../../components/react-demos/text";
import {
  textFeedbackTree,
  textReadingTree,
  textTitleTree,
} from "../../../demos/typography";
import { getLocale, useTranslations } from "../../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));

/*
 * Inline stays authored: the point is `<strong>` inside the paragraph. Trees escape text, so nested
 * HTML is inexpressible.
 */
const inlineHtml = `<p class="sk-text">
  The <strong>Pro</strong> plan includes five active environments and
  preserves the reading flow within the same paragraph.
</p>`;

const inlineReact = `import { Text } from "@skryensya/react/text";

<Text>
  The <strong>Pro</strong> plan includes five active environments and
  preserves the reading flow within the same paragraph.
</Text>;`;
---

<Base title="Text" description="Text: reading copy with typographic roles and explicit HTML semantics.">
  <h1>Text</h1>
  <p class="lede">
    Text presents reading content with named typographic roles. Choose the HTML element that
    describes the content; Text does not create heading semantics.
  </p>

  <h2>Title block</h2>
  <p>
    <strong>Eyebrow, title and subtitle as one unit.</strong> Two roles compose the header:
    <code>eyebrow</code> is the uppercase overline, <code>subtitle</code> is the line under the
    title. Spacing between roles comes from the sibling below (<code>padding-block-start</code> on
    the heading and subtitle), so the block's stack uses <code>data-gap="none"</code>.
  </p>
  <ComponentPreview tree={textTitleTree(t)} label="Title block" />

  <h2>Reading with context</h2>
  <p>
    Metadata should accompany reading without competing with the body; hierarchy comes from role,
    tone and weight, not arbitrary sizes. The overline above uses the <code>eyebrow</code> role.
  </p>
  <ComponentPreview tree={textReadingTree(t)} label="Update text" />

  <h2>Emphasis inside a sentence</h2>
  <p>
    Use the <strong>semantic tag</strong>, not a weighted span: <code>&lt;strong&gt;</code> inside
    Text takes the system's <code>emphasis</code> weight (not the browser's heaviest bold) and a
    screen reader announces it. <code>&lt;em&gt;</code> stays italic. The <code>data-weight</code>
    axis is for a whole Text; this is for emphasis <em>inside</em> the sentence.
  </p>
  <ComponentPreview html={inlineHtml} react={inlineReact} label="Inline text">
    <Fragment slot="react">
      <TextInlineDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Validation feedback</h2>
  <p>
    The <code>danger</code> tone communicates the problem; the live-region role remains a decision of
    the context that uses Text.
  </p>
  <ComponentPreview tree={textFeedbackTree(t)} label="Validation message" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of the preview.</p>

  <h2>Contract</h2>
  <ul>
    <li><code>sk-text</code> provides the base reading style.</li>
    <li><code>data-size</code>: <code>caption</code>, <code>sm</code>, <code>body</code> or <code>lg</code>.</li>
    <li><code>data-tone</code>: <code>primary</code>, <code>secondary</code>, <code>tertiary</code> or <code>danger</code>.</li>
    <li><code>data-weight</code>: <code>body</code>, <code>emphasis</code> or <code>label</code>.</li>
    <li>
      <code>data-role</code>: <code>eyebrow</code> (uppercase overline) or <code>subtitle</code>
      (line under a title). A role composes several axes at once; in React pass
      <code>data-role</code>.
    </li>
    <li>In React, <code>as</code> accepts <code>p</code>, <code>div</code> or <code>span</code>; default is <code>p</code>.</li>
    <li>For headings, use Heading and an <code>h1</code>–<code>h6</code> element, not Text.</li>
  </ul>
</Base>