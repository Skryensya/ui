---
import Base from "../../../layouts/Base.astro";
import Showcase from "../../../components/Showcase.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import "@skryensya/core/components/popover.css";

const install = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/popover.css";`;
const html = `<div class="sk-popover">
  <button
    class="sk-button sk-interactive sk-popover__trigger sk-anchor"
    popovertarget="filters-popup"
    style="--sk-anchored-name: --filters-anchor"
    type="button"
  >
    Filtros
  </button>
  <div
    class="sk-popover__positioner sk-anchored sk-popover__content"
    id="filters-popup"
    popover="auto"
    style="--sk-anchored-name: --filters-anchor; --sk-anchored-box-name: --filters-box"
  >
    <!-- The arrow, optional: is authored or does not exist. A popup wants it, a select does not. -->
    <span class="sk-anchored-arrow" aria-hidden="true"></span>
    <label><input type="checkbox" /> Active only</label>
  </div>
</div>`;
const react = `import { Popup } from "@skryensya/react/popup";

// \`arrow\` is the same as authoring <span className="sk-anchored-arrow" /> inside
// positioner: optional in both bindings, and off by default.
<Popup trigger="Filtros" arrow>
  <label>
    <input type="checkbox" /> Active only
  </label>
</Popup>`;
---

<Base
  title="Popup"
  description="Minimal floating surface for compositions that do not need Popover chrome."
>
  <h1>Popup</h1>
  <p class="lede">Minimal floating surface for compositions that do not need Popover chrome.</p>

  <h2>Installation</h2>
  <Showcase
    html={html}
    react={react}
    label="Popup"
    viewport="menu"
  />

  <h2>Contrato</h2>
  <p>Popup provides anchor and surface, not internal semantics. If the pattern has title and closing actions, use Popover.</p>

  <h2>Accesibilidad</h2>
  <p>The content must provide its own semantics; Popup does not invent dialog or menu roles.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/popover.css",
        probe: "sk-popover",
        title: "Popup",
      },
      { file: "patterns/anchored.css", probe: "sk-anchored", title: "Anchor Inherits" },
    ]}
  />
</Base>
