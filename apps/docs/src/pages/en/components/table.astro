---
import Base from "../../../layouts/Base.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import {
  tableInBoxTree,
  tableStickyColumnTree,
  tableStickyHeaderTree,
  tableTree,
} from "../../../demos/table";
import { getLocale, useTranslations } from "../../../i18n";
import CodeBlock from "../../../components/CodeBlock.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import DimensionSelect from "../../../components/DimensionSelect.astro";
import { TablePagerDemo } from "../../../components/react-demos/table";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;

const services = ["API", "Worker", "Gateway", "Billing", "Auth", "Search"] as const;
const envs = ["prod", "staging", "dev"] as const;
const statuses = ["Successful", "In progress", "Failed"] as const;

const pagerRows = Array.from({ length: 28 }, (_, index) => {
  const n = index + 1;
  return {
    id: `dep-${1040 + n}`,
    service: services[index % services.length],
    env: envs[index % envs.length],
    status: statuses[index % statuses.length],
    when: n === 1 ? "2 min ago" : n < 10 ? `${n * 3} min ago` : `${n} h ago`,
  };
});

const densityTable = (factor: string) => `<div
  data-sk-density-scope
  style="--sk-density-factor: ${factor}"
>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <caption class="sk-table__caption">
        Service activity
      </caption>
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="col">Servicio</th>
          <th class="sk-table__header" scope="col">Status</th>
          <th class="sk-table__header" scope="col">
            Last activity
          </th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="row">API</th>
          <td class="sk-table__cell">Estable</td>
          <td class="sk-table__cell">2 min ago</td>
        </tr>
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="row">Worker</th>
          <td class="sk-table__cell">Estable</td>
          <td class="sk-table__cell">8 min ago</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>`;

const spaciousDensityHtml = densityTable("1.2");
const compactDensityHtml = densityTable("0.6");

const pagerRowHtml = (row: (typeof pagerRows)[number]) => `        <tr
          class="sk-table__row"
          data-sk-table-pager-row
        >
          <th class="sk-table__header" scope="row">${row.id}</th>
          <td class="sk-table__cell">${row.service}</td>
          <td class="sk-table__cell">${row.env}</td>
          <td class="sk-table__cell">${row.status}</td>
          <td class="sk-table__cell">${row.when}</td>
        </tr>`;

const pagerShell = (tbody: string) => `<div
  class="sk-table-pager"
  data-sk-table-pager
  data-page-size="5"
  data-status-template="{start}–{end} of {total}"
  data-previous-label="Previous page"
  data-next-label="Next page"
  data-page-label="Page"
>
  <div
    aria-label="Recent deployments"
    class="sk-table-scroll"
    data-sticky-column
    role="region"
    tabindex="0"
  >
    <table class="sk-table" data-layout="fixed">
      <caption class="sk-table__caption">
        Recent deployments
      </caption>
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="col">ID</th>
          <th class="sk-table__header" scope="col">Servicio</th>
          <th class="sk-table__header" scope="col">Entorno</th>
          <th class="sk-table__header" scope="col">Status</th>
          <th class="sk-table__header" scope="col">When</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
${tbody}
      </tbody>
    </table>
  </div>

  <div class="sk-table-pager__bar">
    <div class="sk-table-pager__size">
      <div class="sk-select" data-sk-select data-value="5">
        <label class="sk-select__label" data-sk-select-label>
          Rows per page
        </label>
        <button
          class="sk-select__trigger sk-anchor sk-interactive"
          data-sk-select-trigger
          type="button"
        >
          <span class="sk-select__value" data-sk-select-value>
            5
          </span>
          <span
            class="sk-select__indicator"
            data-sk-select-indicator
            aria-hidden="true"
          >
            <span data-state="closed">
              <span data-sk-icon="chevron-down"></span>
            </span>
            <span data-state="open">
              <span data-sk-icon="chevron-up"></span>
            </span>
          </span>
        </button>
        <div
          class="sk-select__positioner sk-anchored"
          data-sk-select-positioner
        >
          <ul class="sk-select__content" data-sk-select-content>
            <li
              class="sk-select__item sk-interactive"
              data-sk-select-item
              data-value="5"
            >
              5
            </li>
            <li
              class="sk-select__item sk-interactive"
              data-sk-select-item
              data-value="10"
            >
              10
            </li>
            <li
              class="sk-select__item sk-interactive"
              data-sk-select-item
              data-value="25"
            >
              25
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="sk-table-pager__end">
      <div
        class="sk-table-pager__status"
        data-sk-table-pager-status
      ></div>

      <nav
        class="sk-pagination"
        aria-label="Pagination"
        data-sk-table-pager-nav
      ></nav>
    </div>
  </div>
</div>`;

const pagedCode = pagerShell(
  [
    ...pagerRows.slice(0, 2).map(pagerRowHtml),
    `        <!-- … ${pagerRows.length - 2} more rows with data-sk-table-pager-row -->`,
  ].join("\n"),
);

const pagedCodeFull = pagerShell(pagerRows.map(pagerRowHtml).join("\n"));


const pagedReact = `import { useMemo, useState } from "react";
import { Icon } from "@skryensya/react/icon";
import { Pagination } from "@skryensya/react/pagination";
import { Select } from "@skryensya/react/select";
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
  TableScroll,
} from "@skryensya/react/table";

const PAGE_SIZES = ["5", "10", "25"] as const;

function DeploymentsTable({ rows }: { rows: Deployment[] }) {
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] =
    useState<(typeof PAGE_SIZES)[number]>("5");

  const size = Number(pageSize);
  const pageCount = Math.max(1, Math.ceil(rows.length / size));
  const current = Math.min(page, pageCount);
  const slice = useMemo(() => {
    const start = (current - 1) * size;
    return rows.slice(start, start + size);
  }, [current, rows, size]);

  const start = (current - 1) * size + 1;
  const end = Math.min(current * size, rows.length);

  return (
    <div className="sk-table-pager">
      <TableScroll
        aria-label="Recent deployments"
        role="region"
        stickyColumn
        tabIndex={0}
      >
        <Table data-layout="fixed">
          <TableCaption>Recent deployments</TableCaption>
          <TableHead>
            <TableRow>
              <TableHeader>ID</TableHeader>
              <TableHeader>Servicio</TableHeader>
              <TableHeader>Entorno</TableHeader>
              <TableHeader>Status</TableHeader>
              <TableHeader>When</TableHeader>
            </TableRow>
          </TableHead>
          <TableBody>
            {slice.map((row) => (
              <TableRow key={row.id}>
                <TableHeader scope="row">{row.id}</TableHeader>
                <TableCell>{row.service}</TableCell>
                <TableCell>{row.env}</TableCell>
                <TableCell>{row.status}</TableCell>
                <TableCell>{row.when}</TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </TableScroll>

      <div className="sk-table-pager__bar">
        <div className="sk-table-pager__size">
          <Select
            label="Rows per page"
            defaultValue={["5"]}
            indicator={<Icon name="chevron-down" />}
            openIndicator={<Icon name="chevron-up" />}
            itemIndicator={<Icon name="check" />}
            options={PAGE_SIZES.map((n) => ({ value: n, label: n }))}
            onValueChange={(details) => {
              const next = details.value[0];
              if (next === "5" || next === "10" || next === "25") {
                setPageSize(next);
                setPage(1);
              }
            }}
          />
        </div>
        <div className="sk-table-pager__end">
          <div className="sk-table-pager__status">
            {start}–{end} de {rows.length}
          </div>
          <Pagination
            page={current}
            total={pageCount}
            onPageChange={setPage}
            label="Pagination"
            previousLabel="Previous page"
            nextLabel="Next page"
          />
        </div>
      </div>
    </div>
  );
}`;---

<Base
  title="Table"
  description="Readable native table with horizontal scroll and sticky rows or columns."
>
  <h1>Table</h1>
  <p class="lede">
    Table maintains the native semantics of <code>&lt;table&gt;</code>. The overflow wrapper preserves a readable width per column and scrolls the table instead of compressing it. Header and first sticky column are opt-in and use the same contract on mobile and desktop.
  </p>

  <ComponentPreview tree={tableTree(t)} label="Table" />

  <h2>Uncompressed horizontal scroll</h2>
  <p>
    Within <code>.sk-table-scroll</code>, each cell retains floor <code>--sk-table-cell-min-inline-size</code>; row headers retain a larger one. A table <code>data-layout="fixed"</code> additionally uses <code>--sk-table-fixed-min-inline-size</code>. On narrow screens a scroll appears, not 56px columns or letter-by-letter text. The wrapper supports focus for keyboard scrolling and paints a compact but visible scrollbar.
  </p>

  <h2>Sticky first column</h2>
  <p>
    Use <code>data-sticky-column</code> in HTML or <code>stickyColumn</code> in React. The first cell of each row is frozen and its shadow separates the identifier from the data passing below it. It should be a <code>&lt;th scope="row"&gt;</code>. It does not depend on a breakpoint: it works the same with touch, mouse, zoom or a narrow window.
  </p>
  <ComponentPreview tree={tableStickyColumnTree(t)} label="Sticky first column" />

  <h2>Sticky header row</h2>
  <p>
    Use <code>data-sticky-header</code> or <code>stickyHeader</code>. The wrapper gains vertical scroll and a maximum height of <code>20rem</code>, which you can override as in this example. The header is visible on both desktop and mobile; If you combine both modifiers, the corner cell is on top of the two layers.
  </p>
  <ComponentPreview tree={tableStickyHeaderTree(t)} label="Sticky header row" />

  <h2>With pagination</h2>
  <p>
    <code>data-sk-table-pager</code> is the vanilla enhancer;
    <code>sk-table-pager</code> is the layout pattern (table + bar). You mark the lines, you leave the
    empty <code>nav</code> and (optional) a status and a
    <a class="sk-link sk-interactive" href="/en/components/select"><code>Select</code></a>
    of page size. The size goes to the beginning of the bar; status and
    <a class="sk-link sk-interactive" href="/en/components/pagination"><code>Pagination</code></a>
    they go together in <code>sk-table-pager__end</code>. Use <code>data-layout="fixed"</code> so that no
    the column widths dance.
  </p>
  <ComponentPreview
    code={pagedCode}
    codeFull={pagedCodeFull}
    react={pagedReact}
    label="Table + Pagination"
    lang="html"
  >
    <div
      class="sk-table-pager"
      data-sk-table-pager
      data-page-size="5"
      data-status-template={"{start}–{end} of {total}"}
      data-previous-label="Previous page"
      data-next-label="Next page"
      data-page-label="Page"
    >
      <div
        aria-label="Recent deployments"
        class="sk-table-scroll"
        data-sticky-column
        role="region"
        tabindex="0"
      >
        <table class="sk-table" data-layout="fixed">
          <caption class="sk-table__caption">Recent deployments</caption>
          <thead class="sk-table__head">
            <tr class="sk-table__row">
              <th class="sk-table__header" scope="col">ID</th>
              <th class="sk-table__header" scope="col">Servicio</th>
              <th class="sk-table__header" scope="col">Entorno</th>
              <th class="sk-table__header" scope="col">Status</th>
              <th class="sk-table__header" scope="col">When</th>
            </tr>
          </thead>
          <tbody class="sk-table__body">
            {
              pagerRows.map((row) => (
                <tr class="sk-table__row" data-sk-table-pager-row>
                  <th class="sk-table__header" scope="row">{row.id}</th>
                  <td class="sk-table__cell">{row.service}</td>
                  <td class="sk-table__cell">{row.env}</td>
                  <td class="sk-table__cell">{row.status}</td>
                  <td class="sk-table__cell">{row.when}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="sk-table-pager__bar">
        <div class="sk-table-pager__size">
          <DimensionSelect
            id="table-page-size"
            label="Rows per page"
            value="5"
            options={[
              { value: "5", label: "5" },
              { value: "10", label: "10" },
              { value: "25", label: "25" },
            ]}
          />
        </div>
        <div class="sk-table-pager__end">
          <div class="sk-table-pager__status" data-sk-table-pager-status></div>
          <nav class="sk-pagination" aria-label="Pagination" data-sk-table-pager-nav></nav>
        </div>
      </div>
    </div>
    <Fragment slot="react">
      <TablePagerDemo client:load lang="en" />
    </Fragment>
  </ComponentPreview>

  <h2>Inside a Box</h2>
  <p>
    Within the <code>padding</code> of a <code>.sk-box</code>, the <code>.sk-table</code> rounds with the nested element radius (<code>--radius-control</code>) instead of the surface: Box provides the surface and the table is an element within it. This way the radius is tighter, never collapses into a square box, and continues to accompany the <code>data-radius</code> axis.
  </p>
  <ComponentPreview tree={tableInBoxTree(t)} label="Table in Box" />

  <h2>Local density</h2>
  <p>
    The scope contract is just <code>data-sk-density-scope</code> and a density value. Here <code>--sk-density-factor</code> is relative to the system; write <code>--sk-density</code> in the same node if you need an absolute value. The numbers are still continuous.
  </p>
  <ComponentPreview html={spaciousDensityHtml} label="System wide table · 1.2×" />
  <ComponentPreview html={compactDensityHtml} label="Compact table · 0.6× system" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>
    The binding is in <strong>Vanilla |React</strong>. In Vanilla, the HTML with <code>data-sk-*</code> is enough; <code>initComponents</code> (and <code>mountIcons</code>) are loaded by the site.
  </p>
  <StylingHooks groups={[{ file: "components/table.css", probe: "sk-table" }]} />
</Base>

