const stickyHeaderReact = `import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
  TableScroll,
} from "@skryensya/react/table";

const deployments = [
  ["DEP-1082", "API", "Exitoso", "2 min ago"],
  ["DEP-1081", "Worker", "In progress", "6 min ago"],
  ["DEP-1080", "Gateway", "Exitoso", "18 min ago"],
  ["DEP-1079", "Billing", "Fallido", "31 min ago"],
  ["DEP-1078", "Auth", "Exitoso", "48 min ago"],
] as const;

<TableScroll
  aria-labelledby="deployment-history"
  role="region"
  stickyHeader
  style={{ maxBlockSize: "14rem" }}
