---
import Base from "../../../layouts/Base.astro";
import Showcase from "../../../components/Showcase.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import DimensionSelect from "../../../components/DimensionSelect.astro";

const install = `pnpm add @skryensya/core @skryensya/react`;

const services = ["API", "Worker", "Gateway", "Billing", "Auth", "Search"] as const;
const envs = ["prod", "staging", "dev"] as const;
const statuses = ["Exitoso", "In progress", "Fallido"] as const;

const pagerRows = Array.from({ length: 28 }, (_, index) => {
  const n = index + 1;
  return {
    id: `dep-${1040 + n}`,
    service: services[index % services.length],
    env: envs[index % envs.length],
    status: statuses[index % statuses.length],
    when: n === 1 ? "2 min ago" : n < 10 ? `${n * 3} min ago` : `${n} h ago`,
  };
});

const html = `<div class="sk-table-scroll">
  <table class="sk-table">
    <caption class="sk-table__caption">Planes disponibles</caption>
    <thead class="sk-table__head">
      <tr class="sk-table__row">
        <th class="sk-table__header" scope="col">Plan</th>
        <th class="sk-table__header" scope="col">Uso</th>
        <th class="sk-table__header" scope="col">Status</th>
      </tr>
    </thead>
    <tbody class="sk-table__body">
      <tr class="sk-table__row">
        <th class="sk-table__header" scope="row">Starter</th>
        <td class="sk-table__cell">Small teams</td>
        <td class="sk-table__cell">Activo</td>
      </tr>
    </tbody>
    <tfoot class="sk-table__foot">
      <tr class="sk-table__row">
        <td class="sk-table__cell" colspan="3">
          Prices do not include taxes.
        </td>
      </tr>
