        <td class="sk-table__cell">Exitoso</td>
        <td class="sk-table__cell">2 min ago</td>
      </tr>
      <tr class="sk-table__row">
        <th class="sk-table__header" scope="row">DEP-1081</th>
        <td class="sk-table__cell">Worker</td>
        <td class="sk-table__cell">In progress</td>
        <td class="sk-table__cell">6 min ago</td>
      </tr>
      <tr class="sk-table__row">
        <th class="sk-table__header" scope="row">DEP-1080</th>
