---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import { FlyoutPlaceholderDemo } from "../../../components/react-demos/flyout";
import {
  flyoutTree,
  flyoutRailTree,
  flyoutExclusiveTree,
  flyoutDisabledItemTree,
  flyoutDisabledTree,
  flyoutLongTree,
} from "../../../demos/flyout";
import { getLocale, useTranslations } from "../../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/components/flyout.css";`;

/*
 * The one demo on this page that is still hand-written, and the only one whose subject the contract
 * cannot state: the placeholder shows when the current value matches NO item, and `data-value` is
 * the way to say that — an attribute the Flyout contract maps nowhere (it declares `defaultValue`
 * over `data-default-value`, which the enhancer never reads). See `src/demos/flyout.ts`.
 */
const placeholderHtml = `<div
  class="sk-flyout"
  data-sk-flyout
  id="theme-custom"
  data-value="custom"
  data-placeholder="${t("demo.flyout.themeCustom")}"
>
  <label class="sk-flyout__label" data-sk-flyout-label>
    ${t("demo.flyout.theme")}
  </label>

  <button class="sk-flyout__trigger sk-interactive" data-sk-flyout-trigger type="button">
    <span class="sk-flyout__value" data-sk-flyout-value>
      ${t("demo.flyout.themeCustom")}
    </span>
    <span class="sk-flyout__indicator" data-sk-flyout-indicator aria-hidden="true">
      <span data-state="closed">
        <span data-sk-icon="chevron-right"></span>
      </span>
      <span data-state="open">
        <span data-sk-icon="chevron-left"></span>
      </span>
    </span>
  </button>

  <ul class="sk-flyout__panel" data-sk-flyout-panel>
${["Dawn", "Dusk", "Ember"]
  .map(
    (name) => `    <li
      class="sk-flyout__item sk-interactive"
      data-sk-flyout-item
      data-value="${name.toLowerCase()}"
    >
      <span class="sk-flyout__item-text" data-sk-flyout-item-text>
        ${name}
      </span>
      <span class="sk-flyout__item-indicator" data-sk-flyout-item-indicator aria-hidden="true">
        <span data-sk-icon="check"></span>
      </span>
    </li>`,
  )
  .join("\n")}
  </ul>
</div>`;

const reactPlaceholder = `import { Icon } from "@skryensya/react/icon";
import { Flyout } from "@skryensya/react/flyout";

function Example() {
  return (
    <Flyout
      label="${t("demo.flyout.theme")}"
      defaultValue={["custom"]}
      placeholder="${t("demo.flyout.themeCustom")}"
      indicator={<Icon name="chevron-right" />}
      openIndicator={<Icon name="chevron-left" />}
      itemIndicator={<Icon name="check" />}
      options={[
        { value: "dawn", label: "Dawn" },
        { value: "dusk", label: "Dusk" },
        { value: "ember", label: "Ember" },
      ]}
    />
  );
}`;

const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);

await initComponents();`;

const listen = `document
  .getElementById("plan")
  .addEventListener("sk-value-change", (event) => {
    console.log(event.detail.value); // ["pro"]
  });`;

const remount = `import { mountFlyout } from "@skryensya/vanilla/flyout";
import { destroyMount } from "@skryensya/vanilla/runtime";

function remountFlyout(root, value) {
  destroyMount(root);
  if (value) root.setAttribute("data-value", value);
  else root.removeAttribute("data-value");
  mountFlyout(root);
}`;
---

<Base
  title="Flyout"
  description="Flyout: Choose a value like Select, with the panel next to the trigger."
>
  <h1>Flyout</h1>
  <p class="lede">
    A value selector like <a href="/en/components/select">Select</a>, but the panel opens to the <strong>inline-end</strong> of the trigger (not below it). Intended for narrow rails — for example the <a href="/en/customize">Customize</a> sidebar — where a downward menu does not fit.
  </p>

  <p>
    It is not a navigation “menu” (ADR-0017): it is a picker. It opens on <strong>click</strong> of the trigger (and from the keyboard). Choosing an item emits <code>sk-value-change</code> and closes it. Escape or a click outside close it too. Only one Flyout can be open at a time.
  </p>

  <ComponentPreview tree={flyoutTree} label="Flyout" viewport="menu" />

  <h2>When to use it</h2>
  <ul>
    <li>
      <strong>Flyout</strong> — the space under the control is limited (sidebar, toolbar, rail) and the panel must open to the side.
    </li>
    <li>
      <strong>Select</strong> — there is room below, you want typeahead / Zag positioning, or it is a standard form. For a platform-native choice, use the <a href="/en/components/select#native-select">native Select</a>.
    </li>
  </ul>

  <h2>Behavior</h2>
  <ul>
    <li>
      <strong>Open:</strong> click on the trigger, or keyboard (<code>Enter</code>, <code>Space</code>, <code>ArrowDown</code>, <code>ArrowRight</code>). Does not open on hover.
    </li>
    <li>
      <strong>Choose:</strong> click an item, or press <code>Enter</code> / <code>Space</code> on it. Emits
      <code>sk-value-change</code> with <code>{'{ value: string[] }'}</code> and closes.
    </li>
    <li>
      <strong>Close:</strong> Escape (returns focus to the trigger), click outside, or choose an item.
    </li>
    <li>
      <strong>Exclusive:</strong> when one opens, the others hear <code>sk-flyout-open</code> and close.
    </li>
    <li>
      <strong>Width:</strong> the panel is at least <code>280px</code> wide and grows with the longest item (capped by the viewport).
    </li>
    <li>
      <strong>Viewport:</strong> if it does not fit at the inline-end, it opens at the inline-start; the top is clamped so it never leaves the viewport (on scroll and resize too).
    </li>
  </ul>

  <h2>Anatomy</h2>
  <CodeBlock
    code={`.sk-flyout[data-sk-flyout][data-value]
  .sk-flyout__label
  .sk-flyout__trigger[data-sk-flyout-trigger]
    .sk-flyout__value[data-sk-flyout-value]
    .sk-flyout__indicator
  .sk-flyout__panel[data-sk-flyout-panel]
    .sk-flyout__item[data-sk-flyout-item][data-value]
      .sk-flyout__item-text
      .sk-flyout__item-indicator`}
    label="parts"
  />
  <p>
    The items <strong>are</strong> the collection: the enhancer reads them from the DOM. Every <code>data-sk-flyout-item</code> needs a <code>data-value</code>. The panel lives on the root (<code>position: absolute</code> by default; the enhancer pins it with <code>position: fixed</code> when an ancestor clips).
  </p>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" lang="css" />

  <h2>Initialize Vanilla</h2>
  <CodeBlock code={js} label="JavaScript" />

  <h2>Listen to the change</h2>
  <CodeBlock code={listen} label="JavaScript" />

  <h2>On a narrow rail</h2>
  <p>
    The typical case: a control about 13.5rem wide. The panel opens at the inline-end and does not compete with the height of the rail.
  </p>
  <ComponentPreview tree={flyoutRailTree(t)} label="Rail flyout" viewport="menu" measure="13.5rem" />

  <h2>Only one open</h2>
  <p>
    Open one and then the other: the first closes by itself. Same contract in Vanilla and React, via the document event <code>sk-flyout-open</code>.
  </p>
  <ComponentPreview
    tree={flyoutExclusiveTree(t)}
    label="Two Flyouts"
    viewport="menu"
    measure="13.5rem"
  />

  <h2>Disabled item</h2>
  <p>
    Mark the item with <code>data-disabled</code> (or <code>disabled: true</code> in React). It cannot be chosen; the rest stay active.
  </p>
  <ComponentPreview tree={flyoutDisabledItemTree(t)} label="Disabled item" viewport="menu" />

  <h2>Flyout disabled</h2>
  <p>
    <code>data-disabled</code> on the root (or <code>disabled</code> in React) blocks both opening and changing the value.
  </p>
  <ComponentPreview tree={flyoutDisabledTree} label="Flyout disabled" viewport="menu" />

  <h2>Long list</h2>
  <p>
    The panel limits its height (<code>--sk-flyout-panel-max-block-size</code>, 18rem by default) and scrolls when necessary.
  </p>
  <ComponentPreview tree={flyoutLongTree(t)} label="Long list" viewport="menu" />

  <h2>Placeholder</h2>
  <p>
    If no <code>data-value</code> matches an item — for example an external “custom” value — the trigger shows the placeholder.
  </p>
  <ComponentPreview html={placeholderHtml} react={reactPlaceholder} label="Placeholder" viewport="menu">
    <Fragment slot="react">
      <FlyoutPlaceholderDemo
        label={t("demo.flyout.theme")}
        placeholder={t("demo.flyout.themeCustom")}
        client:load
      />
    </Fragment>
  </ComponentPreview>

  <h2>Remount with another value</h2>
  <p>
    The enhancer owns the trigger text. To force a value from outside (reset, URL, repair), unmount, write <code>data-value</code>, and mount again — the same pattern <a href="/en/customize">Customize</a> uses.
  </p>
  <CodeBlock code={remount} label="JavaScript" />

  <h2>Contract</h2>
  <ul>
    <li>The root carries <code>data-sk-flyout</code> and the documented part anatomy.</li>
    <li>
      The value event is the same as Select: <code>sk-value-change</code> with <code>{'{ value: string[] }'}</code>.
    </li>
    <li>
      Exclusive opening via <code>sk-flyout-open</code> (detail <code>{'{ root }'}</code>).
    </li>
    <li>No Zag machine in v1: a dedicated enhancer opens it by click or keyboard.</li>
    <li>React renders the same contract without a portal (panel in root).</li>
    <li>The enhancer does not invent classes; only connects authored nodes.</li>
  </ul>

  <StylingHooks groups={[{ file: "components/flyout.css", probe: "sk-flyout" }]} />
</Base>
