---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";

const import_ = `/* a drawer IS a Vaul */
@import "@skryensya/core/patterns/vaul.css";
@import "@skryensya/core/components/drawer.css";
@import "@skryensya/core/patterns/scroll-lock.css";`;

const html = `<button
  class="sk-button sk-interactive"
  data-sk-button
  data-sk-vaul-open="demo-drawer"
  type="button"
>
  Open navigation
</button>

<dialog
  class="sk-vaul sk-drawer demo-drawer"
  id="demo-drawer"
  data-sk-vaul
  data-edge="inline-start"
  aria-label="Navigation"
>
  <div
    class="sk-vaul__handle"
    data-part="handle"
    aria-hidden="true"
  ></div>

  <header class="demo-drawer__header">
    <span class="demo-drawer__brand">Estudio</span>
    <button
      class="sk-button sk-interactive"
      data-sk-button
      data-variant="ghost"
      data-icon-only
      data-sk-vaul-close
      type="button"
      aria-label="Close"
    >
      <span data-sk-icon="close"></span>
    </button>
  </header>

  <nav class="sk-nav-list demo-drawer__nav" aria-label="Principal">
    <div class="sk-nav-list__group">
      <div class="sk-nav-list__group-label" id="demo-drawer-trabajo">
        Trabajo
      </div>
      <ul
        class="sk-nav-list__list"
        aria-labelledby="demo-drawer-trabajo"
      >
        <li class="sk-nav-list__item">
          <a
            class="sk-nav-list__link sk-interactive"
            href="#summary"
            aria-current="page"
          >
            <span data-sk-icon="info"></span>
            <span class="sk-nav-list__label">Summary</span>
          </a>
        </li>
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#agenda">
            <span data-sk-icon="calendar"></span>
            <span class="sk-nav-list__label">Agenda</span>
            <span class="sk-nav-list__trailing">3</span>
          </a>
        </li>
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#archivos">
            <span data-sk-icon="download"></span>
            <span class="sk-nav-list__label">Files</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sk-nav-list__group">
      <div class="sk-nav-list__group-label" id="demo-drawer-cuenta">
        Account
      </div>
      <ul
        class="sk-nav-list__list"
        aria-labelledby="demo-drawer-cuenta"
      >
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#equipo">
            <span data-sk-icon="user"></span>
            <span class="sk-nav-list__label">Team</span>
          </a>
        </li>
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#settings">
            <span data-sk-icon="settings"></span>
            <span class="sk-nav-list__label">Settings</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <footer class="demo-drawer__footer">
    <span class="sk-avatar" data-size="sm" aria-hidden="true">
      <span class="sk-avatar__fallback">AK</span>
    </span>
    <span class="demo-drawer__user">
      <span class="demo-drawer__user-name">Ada Kovač</span>
      <span class="demo-drawer__user-meta">ada@estudio.cl</span>
    </span>
  </footer>
</dialog>`;

const composition = `/* The drawer does not declare a panel, border, slide or
   backdrop: re-declares them from their hooks. */
.sk-drawer {
  --sk-vaul-size: var(--sk-drawer-inline-size);
  --sk-vaul-bg: var(--sk-drawer-bg);
  /* touches three edges of the viewport: a radius there reads as
     a mistake */
  --sk-vaul-radius: 0;
}`;

const tuning = `.mi-drawer {
  --sk-drawer-inline-size: 24rem;
  --sk-drawer-bg: var(--color-bg-surface-raised);
}`;

const nativeHtml = `<button
  class="sk-button sk-interactive"
  data-native-drawer-open="native-drawer"
  type="button"
>
  Open native drawer
</button>

<dialog
  class="sk-vaul sk-drawer demo-drawer"
  id="native-drawer"
  data-edge="inline-start"
  aria-label="Example native drawer"
>
  <div class="demo-drawer__body">
    <strong>Native panel</strong>
    <p>The platform has mode, focus, Escape and restoration.</p>
    <form method="dialog">
      <button
        class="sk-button sk-interactive"
        data-variant="ghost"
        type="submit"
      >
        Close
      </button>
    </form>
  </div>
</dialog>`;

const nativeJs = `const trigger = document.querySelector(
  '[data-native-drawer-open="native-drawer"]',
);
const drawer = document.getElementById("native-drawer");

trigger?.addEventListener("click", () => {
  if (drawer instanceof HTMLDialogElement) drawer.showModal();
});`;
---

<Base title="Drawer" description="A Vaul on the inline edge, at the top of the screen. Send hooks and no structure.">
  <h1>Drawer</h1>
  <p class="lede">
    A <strong>drawer is</strong> a <a href="/en/vaul">Vaul</a> on the inline edge, running along the top of the screen. That sentence is the entire component: the border, the slide, the backdrop, the drag and the top layer are from the pattern, and this file only tells <em>which Vaul is a</em> drawer and what it looks like.
  </p>

  <ComponentPreview html={html} label="HTML" viewport="overlay" />

  <h2>Sends hooks and no structure</h2>
  <p>
    By the system rule: each line of structure that a drawer could have is structure that a lower sheet needs identical, and that shared structure <strong>is</strong> the pattern. A drawer that reimplemented the panel would be a second Vaul with a different name.
  </p>
  <CodeBlock code={composition} label="components/drawer.css" lang="css" />
  <p>
    The <strong>drawer hooks are</strong> those of the Vaul, re-declared. A consumer tunes <code>--sk-drawer-*</code> and never finds out that there is a Vaul below: the pattern remains an implementation detail instead of a second public surface to keep synchronized.
  </p>
  <CodeBlock code={tuning} label="CSS" lang="css" />

  <h2>When it is a drawer and when it is not</h2>
  <table class="sk-table">
    <thead><tr><th>Necesitas</th><th>Use</th></tr></thead>
    <tbody>
      <tr><td>Navigation or filters on the side, at the top</td><td><code>sk-drawer</code></td></tr>
      <tr><td>A sheet that rises from below in mobile</td><td><a href="/en/components/dialog">Dialog</a> (Vaul option)</td></tr>
      <tr><td>A centered box</td><td><a href="/en/components/dialog">Dialog</a></td></tr>
      <tr><td>A permanent rail that does not cover the page</td><td><a href="/en/components/sidebar">Sidebar</a></td></tr>
    </tbody>
  </table>
  <p>
    The sidebar andThe drawer does not compete: a <a href="/en/components/sidebar">sidebar</a> is a shell that lives in the layout, and a drawer is modal and covers the page. This site uses both, the 52rem rail above, the drawer below, with <strong>a single</strong> nav-list inside of both.
  </p>

  <h2>Markup contract</h2>
  <p>
    Root carries <code>sk-vaul sk-drawer</code> on a native <code>&lt;dialog&gt;</code>, Vaul requires it, plus its <code>data-edge</code>. The handle is optional: without it there is no drag, and the drawer remains complete.
  </p>

  <h2>Native drawer</h2>
  <p class="lede">
    The same surface can remain on the platform. Keep <code>&lt;dialog class="sk-vaul sk-drawer"&gt;</code>, omit <code>data-sk-vaul</code> and open it with <code>showModal()</code>: it does not load enhancer, drag or light-dismiss.
  </p>
  <p>
    <code>&lt;form method="dialog"&gt;</code> closes without a listener of its own; Escape, focus, dead page, backdrop and restore belong to the browser. The styles and transition remain the same because they live in Core, not the enhancer.
  </p>
  <ComponentPreview html={nativeHtml} previewScript={nativeJs} label="Native drawer" viewport="overlay" />

  <h3>Opening</h3>
  <CodeBlock code={nativeJs} label="JavaScript" />

  <h3>Native contract</h3>
  <ul>
    <li>The root is still a <code>&lt;dialog&gt;</code> opened with <code>showModal()</code>.</li>
    <li>Without <code>data-sk-vaul</code>, the auto-loader does not mount anything.</li>
    <li>Without handle, a drag interaction that does not exist is not announced.</li>
    <li>The enhancer is only needed for drag-to-dismiss and light-dismiss.</li>
  </ul>

  <h2>Install</h2>
  <CodeBlock code={import_} label="CSS" />

  <StylingHooks
    groups={[
      { file: "components/drawer.css", probe: "sk-drawer", title: "Drawer" },
      { file: "patterns/vaul.css", probe: "sk-vaul", title: "Inherited from Vaul" },
    ]}
  />

</Base>

<style is:global>
  /* The drawer IS the column: fixed header, scrolling navigation, account at the bottom. It's
     the same anatomy as this site's rail, which is the point of the component. */
  .demo-drawer[open] {
    display: flex;
    flex-direction: column;
  }

  /* Inset `md`, not `lg`: a drawer is narrow by definition, and the padding it takes up is width
     the labels don't have. The bands are separated with a line, which costs 1px. */
  .demo-drawer__header {
    display: flex;
    gap: var(--space-inline-md);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-inset-sm) var(--space-inset-md);
    border-block-end: 1px solid var(--color-border-subtle);
  }

  .demo-drawer__brand {
    font-weight: var(--font-weight-heading);
  }

  .demo-drawer__nav {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-inset-sm);
  }

  .demo-drawer__footer {
    display: flex;
    gap: var(--space-inline-sm);
    align-items: center;
    padding: var(--space-inset-sm) var(--space-inset-md);
    border-block-start: 1px solid var(--color-border-subtle);
  }

  .demo-drawer__user {
    display: grid;
    gap: 2px;
    min-inline-size: 0;
  }

  .demo-drawer__user-name {
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-label);
  }

  .demo-drawer__user-meta {
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
  }

  /* The native demo further down is deliberately minimal: it shows that without the enhancer the
     drawer is still complete, so it carries no extra content to distract from that. */
  .demo-drawer__body {
    display: grid;
    gap: var(--space-stack-md);
    justify-items: start;
    padding: var(--space-inset-md);
  }

  .demo-drawer__body p {
    margin: 0;
  }
</style>

