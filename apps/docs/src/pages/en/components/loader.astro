      </div>
      <p class="sk-text" data-tone="secondary">
        Previous content remains visible while the region is updated.
      </p>
      <div class="sk-stack" data-gap="xs">
        <div class="sk-inline" data-justify="between" data-wrap="false">
          <span class="sk-text" data-tone="secondary">Procesados</span>
          <span class="sk-text" data-weight="label">128</span>
        </div>
        <div class="sk-inline" data-justify="between" data-wrap="false">
          <span class="sk-text" data-tone="secondary">Pendientes</span>
          <span class="sk-text" data-weight="label">24</span>
        </div>
      </div>
    </div>
  </section>

  <section
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="lg"
    aria-busy="true"
    aria-labelledby="analytics-title"
  >
    <div class="sk-stack" data-gap="sm">
      <div class="sk-inline" data-justify="center">
        <span
          class="sk-loader"
          data-size="lg"
          data-variant="sweep"
          role="status"
          aria-label="Loading analytics panel"
        ></span>
      </div>
      <h3 class="sk-heading" data-size="h4" id="analytics-title">
        Preparing analytics
      </h3>
      <p class="sk-text" data-tone="secondary">
        The initial load maintains a useful title and explanation.
      </p>
    </div>
  </section>
</div>`;

const contextsReact = `import { Button } from "@skryensya/react/button";
import { Heading } from "@skryensya/react/heading";
import { Loader } from "@skryensya/react/loader";
import { Box, Grid, Inline, Stack } from "@skryensya/react/layout";
import { Text } from "@skryensya/react/text";

function Example() {
  return (
    <Grid columns={3} data-multicol="">
      <Box
        as="article"
        aria-labelledby="save-title"
        border="subtle"
        padding="lg"
        surface="surface"
      >
        <Stack>
          <Text as="span" data-role="eyebrow">Local action</Text>
          <Stack gap="xs">
            <Heading as="h3" id="save-title" size="h4">
              Save report
            </Heading>
            <Text tone="secondary">
              The button retains the action and the Loader remains decorative.
            </Text>
          </Stack>
          <Button aria-busy={true} disabled variant="primary">
            <Loader size="sm" /> Guardando…
          </Button>
        </Stack>
      </Box>

      <Box
        as="section"
        aria-busy={true}
        aria-labelledby="orders-title"
        border="subtle"
        padding="lg"
        surface="surface"
      >
        <Stack>
          <Inline justify="between" wrap={false}>
            <Heading as="h3" id="orders-title" size="h4">
              Recent orders
            </Heading>
            <Loader label="Updating orders" variant="dots" />
          </Inline>
          <Text tone="secondary">
            Previous content remains visible while the region is updated.
          </Text>
          <Stack gap="xs">
            <Inline justify="between" wrap={false}>
              <Text as="span" tone="secondary">Procesados</Text>
              <Text as="span" weight="label">128</Text>
            </Inline>
            <Inline justify="between" wrap={false}>
              <Text as="span" tone="secondary">Pendientes</Text>
              <Text as="span" weight="label">24</Text>
            </Inline>
          </Stack>
        </Stack>
      </Box>

      <Box
        as="section"
        aria-busy={true}
        aria-labelledby="analytics-title"
        border="subtle"
        padding="lg"
        surface="surface"
      >
        <Stack gap="sm">
          <Inline justify="center">
            <Loader
              label="Loading analytics panel"
              size="lg"
              variant="sweep"
            />
          </Inline>
          <Heading as="h3" id="analytics-title" size="h4">
            Preparing analytics
          </Heading>
          <Text tone="secondary">
            The initial load maintains a helpful title and explanation.
          </Text>
        </Stack>
      </Box>
    </Grid>
  );
}`;

const sizesHtml = `<div class="loader-specimens" role="group" aria-label="Loader Sizes">
  <div class="sk-box loader-specimen" data-surface="surface" data-border="subtle" data-padding="lg">
    <div class="sk-stack" data-align="center" data-gap="sm">
      <span class="sk-loader" data-size="sm" aria-hidden="true"></span>
      <span class="loader-specimen__name">sm</span>
      <p class="loader-specimen__description">Within controls</p>
    </div>
  </div>
  <div class="sk-box loader-specimen" data-surface="surface" data-border="subtle" data-padding="lg">
    <div class="sk-stack" data-align="center" data-gap="sm">
      <span class="sk-loader" data-size="md" aria-hidden="true"></span>
      <span class="loader-specimen__name">md</span>
      <p class="loader-specimen__description">Inline state</p>
    </div>
  </div>
  <div class="sk-box loader-specimen" data-surface="surface" data-border="subtle" data-padding="lg">
    <div class="sk-stack" data-align="center" data-gap="sm">
      <span
        class="sk-loader"
        data-size="lg"
        role="status"
        aria-label="Loading results"
      ></span>
      <span class="loader-specimen__name">lg</span>
      <p class="loader-specimen__description">Region or initial load</p>
    </div>
  </div>
</div>`;

const sizesReact = `import { Loader } from "@skryensya/react/loader";

function Example() {
  return (
    <div className="sk-inline">
      <Loader size="sm" />
      <Loader />
      <Loader size="lg" label="Loading results" />
    </div>
  );
}`;

const speedHtml = `<div class="loader-specimens" role="group" aria-label="Loader Speeds">
  <div class="sk-box loader-specimen" data-surface="surface" data-border="subtle" data-padding="lg">
    <div class="sk-stack" data-align="center" data-gap="sm">
      <span
        class="sk-loader"
        data-variant="bars"
        data-speed="fast"
        data-size="lg"
        aria-hidden="true"
      ></span>
      <span class="loader-specimen__name">fast</span>
      <p class="loader-specimen__description">Ciclo corto</p>
    </div>
  </div>
  <div class="sk-box loader-specimen" data-surface="surface" data-border="subtle" data-padding="lg">
    <div class="sk-stack" data-align="center" data-gap="sm">
      <span
        class="sk-loader"
        data-variant="bars"
        data-speed="normal"
        data-size="lg"
        aria-hidden="true"
      ></span>
      <span class="loader-specimen__name">normal</span>
      <p class="loader-specimen__description">Ciclo base</p>
    </div>
  </div>
  <div class="sk-box loader-specimen" data-surface="surface" data-border="subtle" data-padding="lg">
    <div class="sk-stack" data-align="center" data-gap="sm">
      <span
        class="sk-loader"
        data-variant="bars"
        data-speed="slow"
        data-size="lg"
        role="status"
        aria-label="Syncing in the background"
      ></span>
      <span class="loader-specimen__name">slow</span>
      <p class="loader-specimen__description">Ciclo largo</p>
    </div>
  </div>
</div>`;

const speedReact = `import { Loader } from "@skryensya/react/loader";

function Example() {
  return (
    <div className="sk-inline">
      <Loader speed="fast" size="lg" variant="bars" />
      <Loader speed="normal" size="lg" variant="bars" />
      <Loader
        label="Syncing in the background"
        speed="slow"
        size="lg"
        variant="bars"
      />
    </div>
  );
}`;

const customSpeed = `.sk-loader.mi-loader {
  --sk-loader-duration: 2s;
}`;
---

<Base
  title="Loader"
  description="Loader: Simulation of indeterminate load, usage patterns, sizes and speed."
>
  <h1>Loader</h1>
  <p class="lede">
    Loader reports work <strong>indeterminate</strong> - The operation is active, but there is no honest fraction to display. The system offers two circular and two linear layouts with the same semantic rules for composing actions, regions and initial charges.
  </p>

  <div class="sk-alert" data-tone="info" data-presentation="accent">
    <div class="sk-alert__content">
      <div class="sk-alert__description">
        The contract contains <code>ring</code>, <code>sweep</code>, <code>bars</code>, and
        <code>dots</code>. They are visual designs of the same Loader, not separate components.
      </div>
    </div>
  </div>

  <h2>Simulation</h2>
  <p>
    A single container changes from busy to ready. You do not need a screen, metrics or an external card: just the brand, the text that explains the work and an action to repeat it.
  </p>
  <Showcase
    html={simulationHtml}
    js={simulationJs}
    previewScript={simulationJs}
    react={simulationReact}
    label="Mixture analysis"
    note="Busy → ready"
  >
    <Fragment slot="react">
      <LoaderSimulationDemo client:load />
    </Fragment>
  </Showcase>
  <p>
    <code>bars</code> provides movement without pretending a percentage. The container keeps <code>aria-busy</code> and the visible state makes the advertisement accessible.
  </p>

  <h2>Complete patterns</h2>
  <p>
    Loader owns the brand, not the surface or the life cycle. The context decides where it lives, who contributes the accessible name, and what region <code>aria-busy="true"</code> keeps.
  </p>
  <Showcase
    html={contextsHtml}
    react={contextsReact}
    label="Loader in context"
    note="Local action · region update · initial load"
  >
    <Fragment slot="react">
      <LoaderContextsDemo client:load />
    </Fragment>
  </Showcase>
  <ul>
    <li>On a button, Loader is decorative: “Saving…” already names the state.</li>
    <li>In a local update, preserves the previous content and marks the region as busy.</li>
    <li>In an initial load, accompany the mark with a title and an explanation; avoid an empty screen.</li>
  </ul>

  <h2>Size</h2>
  <p>
    Use <code>sm</code> within controls, <code>md</code> next to text, and <code>lg</code> when the mark occupies its own region. Size does not communicate how much work remains.
  </p>
  <Showcase html={sizesHtml} react={sizesReact} label="Loader Sizes">
    <Fragment slot="react">
      <LoaderSizesDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Speed</h2>
  <p>
    <code>speed</code> rewrites the <code>--sk-loader-duration</code> styling hook from intent tokens (<code>--motion-loading-duration*</code>), not from raw milliseconds. Choose the cadence based on visual presence, not as a promise about the actual duration of the operation.
  </p>
  <Showcase html={speedHtml} react={speedReact} label="Loader Speeds">
    <Fragment slot="react">
      <LoaderSpeedDemo client:load />
    </Fragment>
  </Showcase>
  <CodeBlock code={customSpeed} label="override local" lang="css" />

  <h2>Semantics</h2>
  <ul>
    <li>With accessible name use <code>role="status"</code>; React writes it by passing <code>label</code>.</li>
    <li>Without <code>label</code>, React makes it decorative to accompany text without duplicating it.</li>
    <li>Mark the affected region with <code>aria-busy="true"</code>; Loader does not control the operation.</li>
    <li>If you know the progress, use <a href="/en/components/progress">Progress</a>, not a different speed.</li>
  </ul>

  <h2>Reduced motion</h2>
  <p>
    All four designs retain a recognizable silhouette and stop all movement with <code>prefers-reduced-motion: reduce</code>. The status text remains: Reduce Motion cannot convert a pending operation to an invisible signal.
  </p>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" lang="css" />

  <h2>React</h2>
  <p>
    Props: <code>size</code>, <code>variant</code>, <code>speed</code> and <code>label</code>. The default values are <code>md</code>, <code>ring</code> and <code>normal</code>.
  </p>

  <StylingHooks groups={[{ file: "components/loader.css", probe: "sk-loader" }]} />
</Base>
