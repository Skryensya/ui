---
import "@skryensya/core/components/progress.css";
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import Showcase from "../../../components/Showcase.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";

const install = `pnpm add @skryensya/core @skryensya/react`;

/*
 * The demo, as a USAGE TREE. The markup below the stage, the TSX beside it and the live React
 * island are all emitted from this, so the snippet a reader copies is what they just saw render.
 */
const tree = {
  contract: "layout",
  signature: "Stack",
  options: { gap: "md" },
  children: [
    { contract: "progress", signature: "Progress", options: { value: 68, label: "Upload" } },
    { contract: "progress", signature: "Progress", options: { value: 100, tone: "success", label: "Complete" } },
    { contract: "progress", signature: "Progress", options: { value: 24, tone: "danger", label: "Quota" } },
  ],
} as const satisfies UsageTree;
---

<Base title="Progress" description="Progress: determined bar with fraction cut in core, tones and React component.">
  <h1>Progress</h1>
  <p class="lede">
    Progress is a given <strong>bar</strong> - the value is known to the consumer. The fraction is trimmed to <code>[0, max]</code> in the core (<code>progressFraction</code>), so that the painted width and <code>aria-valuenow</code> can never diverge.
  </p>

  <Showcase tree={tree} label="Progress" />
  <p>For work without a measurable value use <a href="/en/components/loader">Loader</a>: its semantics are indeterminate.</p>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of the preview.</p>
</Base>
