---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import Showcase from "../../../components/Showcase.astro";

const install = `pnpm add @skryensya/core @skryensya/react`;

/* A completed step is marked with the real `check` icon, not a ✓ glyph; the pending steps keep numbers. */
const html = `<ol class="sk-steps">
  <li class="sk-steps__item" data-status="complete">
    <span class="sk-steps__marker">
      <span data-sk-icon="check"></span>
    </span>
    <span>
      <span class="sk-steps__label">Choose brand</span>
      <span class="sk-steps__description">Your chromatic intention</span>
    </span>
  </li>
  <li class="sk-steps__item" data-status="current" aria-current="step">
    <span class="sk-steps__marker">2</span>
    <span>
      <span class="sk-steps__label">Adjust ramps</span>
      <span class="sk-steps__description">
        Defines light and shadow
      </span>
    </span>
  </li>
  <li class="sk-steps__item" data-status="upcoming">
    <span class="sk-steps__marker">3</span>
    <span>
      <span class="sk-steps__label">Audit contrast</span>
      <span class="sk-steps__description">
        Try each color pair
      </span>
    </span>
  </li>
  <li class="sk-steps__item" data-status="upcoming">
    <span class="sk-steps__marker">4</span>
    <span>
      <span class="sk-steps__label">Export</span>
      <span class="sk-steps__description">Publish the contract</span>
    </span>
  </li>
</ol>`;

const react = `import { Steps } from "@skryensya/react/steps";

<Steps
  current={1}
  steps={[
    { label: "Elegir marca", description: "Your chromatic intention" },
    {
      label: "Definir rampas",
      description: "Export each position",
    },
    {
      label: "Auditar contraste",
      description: "Try each color pair",
    },
    { label: "Exportar", description: "Publish the contract" },
  ]}
/>;`;
---

<Base title="Steps" description="Steps: indicador de progreso lineal con estados complete / current / upcoming.">
  <h1>Steps</h1>
  <p class="lede">
    Steps shows progress in an ordered sequence. Each step reports one of three states
<code>complete</code>, <code>current</code>, <code>upcoming</code>; The component displays the
    sequence, it does not govern which is active or save navigation between steps.
  </p>

  <Showcase html={html} react={react} label="Steps" />
  <p>In React, <code>current</code> derives state from steps that do not declare theirs; one step can overwrite it with <code>status</code>. <code>description</code> adds context without converting the step to a card.</p>

  <h2>On mobile</h2>
  <p>
    When the container does not reach <code>36rem</code>, the path becomes a vertical rail: the
    marker is on the left and each label retains its full width. There is no truncation or scrolling
    horizontal.
  </p>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of the preview.</p>
</Base>
