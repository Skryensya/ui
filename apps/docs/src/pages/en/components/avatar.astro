---
/*
 * The English Avatar page — and the proof that the i18n setup holds.
 *
 * A translated page is a REAL FILE, not a parameterized render of the Spanish one: the demo markup,
 * the React source and the prose are the content of a documentation page, and content is translated
 * rather than interpolated. What it does share is everything structural — the layout, the chrome,
 * the rail, the ComponentPreview — all of which read the locale off the URL on their own.
 *
 * Route: `/en/components/avatar`, from the `componentes → components` segment map in `src/i18n`.
 */
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import { avatarTree } from "../../../demos/avatar";
import { getLocale, useTranslations } from "../../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;

/*
 * Demo photos, as dummyimage.com placeholders painted in the accent fill.
 *
 * The hexes are the DEFAULT brand's `--color-action-primary` / `--color-text-on-accent`: a URL is a
 * string and cannot hold a var(). `previewScript` re-resolves both tokens inside the frame and
 * rewrites `src`, so the demo follows the reader's mode and brand while the source stays a URL
 * anyone can paste.
 */
const ACCENT_HEX = "1f5fc3";
const ON_ACCENT_HEX = "ffffff";
/*
 * Repaint the placeholders in the accent the reader is actually looking at.
 *
 * Never displayed, and nothing the component needs: the src above is a working URL on its own. This
 * only keeps the demo from claiming to be "the accent" while showing the default blue to someone
 * who just swapped the brand in /customize or flipped to dark, where the fill drops to
 * `--ramp-accent-500` and the on-accent text stops being white.
 *
 * Two moves the site makes elsewhere, for the same two reasons:
 *   - the token goes through a PROBE, because getComputedStyle() returns a custom property's
 *     specified value, light-dark() unresolved, never its used one (see scripts/used-values.ts); and
 *   - the conversion goes through a CANVAS, because Chrome serialises these tokens as oklab() and
 *     dummyimage only speaks hex.
 * The frame runtime mirrors the parent's root attributes and inline style, so observing our own
 * <html> is enough to catch a mode, contrast or brand change.
 */
const t = useTranslations(getLocale(Astro.url));

const previewScript = `
const probe = document.createElement("span");
probe.hidden = true;
document.body.append(probe);

const canvas = document.createElement("canvas");
canvas.width = 1;
canvas.height = 1;
const ctx = canvas.getContext("2d", { willReadFrequently: true });

function hexOf(token, fallback) {
  if (!ctx) return fallback;
  probe.style.removeProperty("color");
  probe.style.setProperty("color", "var(" + token + ")");
  const used = getComputedStyle(probe).color;
  if (!used) return fallback;
  ctx.clearRect(0, 0, 1, 1);
  ctx.fillStyle = "#000";
  ctx.fillStyle = used;
  ctx.fillRect(0, 0, 1, 1);
  const pixel = ctx.getImageData(0, 0, 1, 1).data;
  if (pixel[3] === 0) return fallback;
  return [pixel[0], pixel[1], pixel[2]]
    .map((channel) => channel.toString(16).padStart(2, "0"))
    .join("");
}

function retint() {
  const bg = hexOf("--color-action-primary", "${ACCENT_HEX}");
  const fg = hexOf("--color-text-on-accent", "${ON_ACCENT_HEX}");
  for (const img of document.querySelectorAll('img[src*="dummyimage.com"]')) {
    // The authored src is the template; keep it, the first repaint would otherwise consume it.
    const template = (img.dataset.skTintTemplate ||= img.getAttribute("src"));
    const url = new URL(template);
    const segments = url.pathname.split("/");
    if (segments.length !== 4) continue;
    segments[2] = bg;
    segments[3] = fg;
    url.pathname = segments.join("/");
    if (img.getAttribute("src") !== url.href) img.setAttribute("src", url.href);
  }
}

retint();
const observer = new MutationObserver(retint);
observer.observe(document.documentElement, { attributes: true });
window.addEventListener("pagehide", () => observer.disconnect(), { once: true });
`;
---

<Base title="Avatar" description="Avatar: ImageFrame or initials, AvatarGroup with +N collapse, and the React component.">
  <h1>Avatar</h1>
  <p class="lede">
    Avatar is the visual token of a person or entity: a cropped photo with <strong>ImageFrame</strong> (1/1, cover, pill) or, without an image, the first two letters of the name. <strong>AvatarGroup</strong> stacks a set and collapses the excess into a "+N" counter.
  </p>

  <ComponentPreview tree={avatarTree(t)} previewScript={previewScript} label="Avatar" />
  <p>
    With image, the avatar nests <code>sk-image-frame</code> and the <code>&lt;img alt&gt;</code> provides the semantics. Without it, the container takes <code>role="img"</code> and the initials remain decorative. In React, <code>avatarInitials(name)</code> derives the fallback when you do not pass children: two words → first letter of each; a single → the first two characters.
  </p>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of the preview.</p>
</Base>
