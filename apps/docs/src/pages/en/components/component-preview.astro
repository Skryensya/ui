---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import { buildPreviewFrameDocument } from "../../../lib/preview-frame";
import { SaveActionDemo, ScreensGridDemo } from "../../../components/react-demos/component-preview";
import { componentPreviewBareTree } from "../../../demos/component-preview";
import { getLocale, useTranslations } from "../../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add shiki @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/segmented.css";
@import "@skryensya/core/components/copy-button.css";
@import "@skryensya/core/components/code-preview.css";
@import "@skryensya/core/components/component-preview.css";`;

const demoHtml = `<button class="sk-button sk-interactive" data-sk-button type="button">
  Save changes
</button>`;

const demoJs = `const button = document.querySelector("[data-sk-button]");
button?.addEventListener("click", saveChanges);`;

/* Multicol, because its lanes are keyed to the system's OWN named breakpoints: one lane below
   compact (36rem), two at compact, three at desktop (52rem). Each preset therefore lands in a
   different band (mobile 1, tablet 2, libre 3), which is the claim the prose makes, shown instead
   of asserted. The media queries resolve against the FRAME's viewport, which is the preset width;
   that is what the iframe buys over a container query on a plain div. */
const screensHtml = `<div class="sk-grid" data-multicol data-columns="3">
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Billing</span>
      <span class="sk-tile__description">Plans, payments, and receipts.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Team</span>
      <span class="sk-tile__description">People, roles, and permissions.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Domains</span>
      <span class="sk-tile__description">DNS and certificates.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Logs</span>
      <span class="sk-tile__description">Activity and audit.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Integrations</span>
      <span class="sk-tile__description">Webhooks and API keys.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Notifications</span>
      <span class="sk-tile__description">Mail and alerts.</span>
    </span>
  </a>
</div>`;

const screensReact = `import { Grid } from "@skryensya/react/grid";
import { TileLink } from "@skryensya/react/tile-link";

// Grid does not yet have prop \`multicol\`; the attribute goes straight through the props.
<Grid columns={3} data-multicol>
  <TileLink href="/billing">
    <span className="sk-tile__content">
      <span className="sk-tile__title">Billing</span>
      <span className="sk-tile__description">Plans, payments, and receipts.</span>
    </span>
  </TileLink>
  {/* … */}
</Grid>;`;

const demoReact = `import { Button } from "@skryensya/react/button";

export function SaveAction() {
  return <Button onClick={saveChanges}>Save changes</Button>;
}`;

const anatomy = `<div class="sk-component-preview" data-sk-component-preview>
  <header class="sk-component-preview__header">
    <span class="sk-component-preview__title">Button</span>
    <div class="sk-component-preview__actions">
      <button
        class="sk-button sk-interactive sk-component-preview__reload"
        data-sk-component-preview-reload
        data-variant="ghost"
        data-size="sm"
        data-icon-only
        type="button"
        aria-label="Reload preview: Button"
        title="Reload"
      >
        <span data-sk-icon="refresh"></span>
      </button>
    </div>
  </header>

  <!-- The srcdoc is static: there is no second path. It is put together by the JS tab. -->
  <iframe
    class="sk-component-preview__stage"
    title="Rendered preview: Button"
    allow="clipboard-write"
    aria-busy="true"
  ></iframe>

  <!-- Drag the bottom edge of the stage to make it taller or shorter. -->
  <div
    class="sk-component-preview__resizer"
    data-sk-component-preview-resizer
    role="separator"
    aria-orientation="horizontal"
    aria-label="Adjust preview height: Button"
    tabindex="0"
  ></div>

  <!-- It is hidden only when the frame warns that it has already painted. -->
  <div class="sk-component-preview__loading">
    <span class="sk-loader" data-size="lg" role="status" aria-label="Loading preview: Button"></span>
  </div>
</div>`;

const anatomyFull = `<div class="sk-component-preview" data-sk-component-preview>
  <header class="sk-component-preview__header">
    <span class="sk-component-preview__title">Button</span>
    <span class="sk-component-preview__note">primary</span>
    <div class="sk-component-preview__actions">
      <button
        class="sk-button sk-interactive sk-component-preview__reload"
        data-sk-component-preview-reload
        data-variant="ghost"
        data-size="sm"
        data-icon-only
        type="button"
        aria-label="Reload preview: Button"
      >
        <span data-sk-icon="refresh"></span>
      </button>

      <!-- The binding tabs are a normal SegmentedControl. -->
      <div
        class="sk-segmented sk-component-preview__binding-tabs"
        data-sk-segmented
        data-sk-component-preview-binding-tabs
        data-value="vanilla"
        role="radiogroup"
        aria-label="Binding"
      >
        <span class="sk-segmented__indicator" aria-hidden="true"></span>
        <button class="sk-segmented__option sk-interactive" data-sk-segmented-option data-value="vanilla" type="button" role="radio">
          Vanilla
        </button>
        <button class="sk-segmented__option sk-interactive" data-sk-segmented-option data-value="react" type="button" role="radio">
          React
        </button>
      </div>
    </div>
  </header>

  <!-- Same stage as the minimal example: the srcdoc is created by the JS tab. -->
  <iframe
    class="sk-component-preview__stage"
    title="Rendered preview: Button"
    allow="clipboard-write"
    aria-busy="true"
  ></iframe>

  <div
    class="sk-component-preview__resizer"
    data-sk-component-preview-resizer
    role="separator"
    aria-orientation="horizontal"
    aria-label="Adjust preview height: Button"
    tabindex="0"
  ></div>

  <div class="sk-component-preview__loading">
    <span class="sk-loader" data-size="lg" role="status" aria-label="Loading preview: Button"></span>
  </div>

  <!-- One panel per binding. CodePreview owns every code surface. -->
  <section class="sk-component-preview__binding" data-sk-component-preview-binding="vanilla">
    <div class="sk-component-preview__code" data-sk-component-preview-source="html">
      <div class="sk-code-preview" data-sk-code-preview>
        <!-- HTML highlighted by Shiki + CopyButton -->
      </div>
    </div>
  </section>

  <section class="sk-component-preview__binding" data-sk-component-preview-binding="react" hidden>
    <div class="sk-component-preview__code">
      <div class="sk-code-preview" data-sk-code-preview>
        <!-- TSX highlighted by Shiki + CopyButton -->
      </div>
    </div>
  </section>
</div>`;

/*
 * The other half of the example: without the stage document and without the assembly, the HTML above is a
 * empty frame. It is the same code that runs this page, not a brochure version.
 */
const anatomyJs = `import { mountComponentPreview } from "@skryensya/vanilla/component-preview";
import { mountCodePreview } from "@skryensya/vanilla/code-preview";
// The entry point of the frame (that of "runtime inside srcdoc", below) as URL.
import frameRuntimeUrl from "./component-preview-frame.ts?worker&url";

/* The stage is a separate document: its <head> loads the runtime, which clones the parent's styles,
   sync mode/contrast/radius/density, mount Vanilla inside and adjust iframe height. */
const frameDocument = \`<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <base target="_top">
    <script type="module" src="\${frameRuntimeUrl}"><\\/script>
  </head>
  <body class="sk-component-preview__frame-body">
    ${demoHtml.replace(/\n/g, "\n    ")}
  </body>
</html>\`;

const stage = document.querySelector(".sk-component-preview__stage");
stage.srcdoc = frameDocument;

// The documentation surfaces are opt-in: tabs, reload and resizer of the preview…
mountComponentPreview();
// …and copy, density and disclosure of each code block, if the preview has panels.
mountCodePreview();`;

/*
 * The stage of the two examples below is a ComponentPreview: the same srcdoc document that uses
 * ComponentPreview, mounted one level further inside. The frame runtime mounts the surfaces of
 * documentation, oh the nested preview has its own tabs, reload, resizer and disclosure.
 */
const nestedFrame = buildPreviewFrameDocument({ body: demoHtml });

const mount = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountCodePreview } from "@skryensya/vanilla/code-preview";
import { mountComponentPreview } from "@skryensya/vanilla/component-preview";

// Button, SegmentedControl and CopyButton are discovered by selector.
await initComponents();

// Documentation surfaces are opt-in.
mountCodePreview();
mountComponentPreview();`;

const frameMount = `// Entry point loaded by srcdoc; runs in the iframe realm.
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";

mountIcons(document, lucideIcons);
await initComponents(document);`;
---

<Base
  title="ComponentPreview"
  description="Render of a component and its code on a documented surface, with optional bindings and sources."
>
  <h1>ComponentPreview</h1>
  <p class="lede">
    Joins the actual <strong>render of the</strong> component and its implementation on a single surface. The stage is a static <code>iframe srcdoc</code>: it does not create a route, but it does create its own DOM, viewport and top layer. Below, CodePreview shows the code.
  </p>

  <ComponentPreview html={demoHtml} js={demoJs} react={demoReact} label="Button">
    <Fragment slot="react">
      <SaveActionDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Responsibilities</h2>
  <ul>
    <li>
      <strong>ComponentPreview</strong> has the frame, the header, the rendered stage and the binding or source panels.
    </li>
    <li>
      <strong>CodePreview</strong> owns every code surface: Shiki, copy, density, and long block expansion.
    </li>
    <li>
      The frame is at <code>about: srcdoc</code>. Toast, Dialog, Drawer, fixed styles and viewport queries are resolved against the example, not against the chrome documentation.
    </li>
  </ul>
  <p>
    CSS and JavaScript do not cross the document boundary automatically. The adapter on this site copies its stylesheets, synchronizes mode, contrast, radius and density, and runs the same vanilla bootstrap within the frame realm. The content is authored and trusted; not used for arbitrary third-party HTML.
  </p>

  <h2>Minimal anatomy</h2>
  <p>
    The stage of this example is another ComponentPreview: the same <code>srcdoc</code>, one level deeper. The nested frame clones its parent's styles and sets up its own runtime, so reloading, dragging the border or changing the color mode works on both levels at the same time.
  </p>
  <ComponentPreview
    label="ComponentPreview"
    note="inside a ComponentPreview"
    code={anatomy}
    js={anatomyJs}
    lang="html"
  >
    {/*
     * The stage arranges its children as flex items, so a specimen shrinks to its content.
     * This is a surface: it occupies all the available width, inside the inset of the stage.
     */}
    <div class="sk-component-preview" data-sk-component-preview style="inline-size: 100%">
      <header class="sk-component-preview__header">
        <span class="sk-component-preview__title">Button</span>
        <div class="sk-component-preview__actions">
          <button
            class="sk-button sk-interactive sk-component-preview__reload"
            data-sk-component-preview-reload
            data-variant="ghost"
            data-size="sm"
            data-icon-only
            type="button"
            aria-label="Reload preview: Button"
            title="Reload"
          >
            <span data-sk-icon="refresh"></span>
          </button>
        </div>
      </header>

      <iframe
        class="sk-component-preview__stage"
        srcdoc={nestedFrame}
        title="Rendered preview: Button"
        allow="clipboard-write"
        aria-busy="true"></iframe>

      <div
        class="sk-component-preview__resizer"
        data-sk-component-preview-resizer
        role="separator"
        aria-orientation="horizontal"
        aria-label="Adjust preview height: Button"
        title="Drag to adjust height double click to reset"
        tabindex="0"
      >
      </div>

      <div class="sk-component-preview__loading">
        <span
          class="sk-loader"
          data-size="lg"
          role="status"
          aria-label="Loading preview: Button"></span>
      </div>
    </div>
  </ComponentPreview>
  <p>
    Add <code>data-sk-component-preview-flush</code> to the iframe and its body when the component is a layout. Use <code>data-sk-component-preview-viewport="menu"</code> for listboxes and popovers, or <code>overlay</code> for dialogs, drawers and toasts. The reload button goes back to <code>srcdoc</code> (useful for count-ups and loaders). The tabs are normal <code>SegmentedControl</code>.
  </p>
  <p>
    The <code>resizer</code> is the stage's lower edge, like a <code>textarea</code> handle. Dragging
    it (or pressing <kbd class="sk-kbd">↑</kbd> / <kbd class="sk-kbd">↓</kbd> while it has focus) sets
    <code>data-sk-component-preview-resized</code>. From then on, the reader owns the height: the
    frame runtime stops auto-sizing and gives its document <code>overflow: auto</code>, so shrinking
    the frame reveals scrolling instead of clipping the example. Double-clicking it, or pressing
    <kbd class="sk-kbd">Home</kbd>, returns the height to the content.
  </p>

  <h2>Screen size</h2>
  <p>
    <code>screens</code> adds a segmented header <strong>Free · Tablet · Mobile</strong>. <em>Free</em> is the usual stage: full width and height adjusted to the content. The two presets set <strong>width and</strong> height, because a device is both: a width-only preset shows the reflow but never what is below the waterline, which is half of what a small screen does to a layout.
  </p>
  <p>
    The measurements purposely fall on either side of the system breakpoints (<code>compact</code> 36rem, <code>desktop</code> 52rem): mobile phone 390×844 is below the two, tablet 768×1024 is in the middle. So the two presets exercise the bands where the layout actually changes, instead of being two arbitrary widths. They go in <code>px</code> and not in <code>rem</code> because a device's viewport is a physical measurement: whoever uploads the root font size wants to see <em>that</em> reflow on a phone screen, not a phone that grew.
  </p>
  <p>
    The example below is a multicol <code>Grid</code>, whose lanes are tied precisely to those breakpoints: one below <code>compact</code>, two from there, three from <code>desktop</code>. Each preset falls into a different band, so all three look different. The media queries resolve against the <strong>viewport of the</strong> frame, which is the width of the preset: that is what the <code>iframe</code> buys and I would not buy a container query on a <code>div</code>.
  </p>
  <p>
    With an active preset the stage is a device: the runtime stops auto-adjusting and the document scrolls inside, just like on the real device. The resizer hides - the preset already owns the pitch, and two owners of the same pitch is the bug; return to <em>Free</em> returns the drag. The stop is at <code>80svh</code> so that the code below remains reachable: the frame scrolls, so the only thing that is lost is the fidelity of the <code>vh</code> units of the example itself.
  </p>
  <ComponentPreview
    label="Grid multicol"
    note="3 free lanes · 2 on tablet · 1 on mobile"
    html={screensHtml}
    react={screensReact}
  >
    <Fragment slot="react">
      <ScreensGridDemo client:load />
    </Fragment>
  </ComponentPreview>
  <p>
    It <strong>comes on in every preview</strong> of the site. “Does this hold up on a phone?” is a
    question worth asking of any component, not only the ones that are obviously a layout: a button
    label wraps, a table overflows, a dialog does not fit. Leaving it to the discretion of whoever
    writes each page would mean having the answer precisely in the demos somebody already thought
    about, which are the ones that were already fine.
  </p>
  <p>
    The choice belongs <strong>to the document, not to the preview</strong>, and is shared just like
    the Vanilla | React preference: changing it in one example changes it in all. It lives in
    <code>&lt;html data-sk-component-preview-screen-pref&gt;</code> and is saved in
    <code>localStorage["sk"].screen</code>, so it survives reloads and navigation between pages. The
    reason is the same as for the binding: the reader is asking the question <em>of the page</em>,
    not of a loose demo, and choosing again in every example along the way would be exactly the work
    the shared preference exists to avoid. <em>Free</em> is the absence of the attribute, not a third
    value.
  </p>
  <p>
    The three controls are icons of the stable vocabulary (<code>screen-desktop</code>, <code>screen-tablet</code> and <code>screen-mobile</code>), so the three approved sets draw them. With no visible text, each option has its name in <code>aria-label</code> and in <code>title</code>: the glyph is decorative, exactly like in an icon-only Button.
  </p>
  <p>
    It is turned off by preview with <code>screens={false}</code>, for cases where the preset deceives more than it reports.
  </p>

  <h2>The complete example</h2>
  <p>
    The entire surface, also nested: header with note, reload and binding tabs, stage, resizer and a CodePreview per binding. The inside tabs are independent of the outside ones: the Vanilla preference |React is shared per document, and the frame is its own document.
  </p>
  <ComponentPreview
    label="ComponentPreview"
    note="the entire surface"
    code={anatomyFull}
    js={anatomyJs}
    lang="html"
  >
    <div class="sk-component-preview" data-sk-component-preview style="inline-size: 100%">
      <header class="sk-component-preview__header">
        <span class="sk-component-preview__title">Button</span>
        <span class="sk-component-preview__note">primary</span>
        <div class="sk-component-preview__actions">
          <button
            class="sk-button sk-interactive sk-component-preview__reload"
            data-sk-component-preview-reload
            data-variant="ghost"
            data-size="sm"
            data-icon-only
            type="button"
            aria-label="Reload preview: Button"
            title="Reload"
          >
            <span data-sk-icon="refresh"></span>
          </button>
          <div
            class="sk-segmented sk-component-preview__binding-tabs"
            data-sk-segmented
            data-sk-component-preview-binding-tabs
            data-value="vanilla"
            role="radiogroup"
            aria-label="Binding"
          >
            <span class="sk-segmented__indicator" aria-hidden="true"></span>
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-value="vanilla"
              type="button"
              role="radio"
            >
              Vanilla
            </button>
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-value="react"
              type="button"
              role="radio"
            >
              React
            </button>
          </div>
        </div>
      </header>

      <iframe
        class="sk-component-preview__stage"
        srcdoc={nestedFrame}
        title="Rendered preview: Button"
        allow="clipboard-write"
        aria-busy="true"></iframe>

      <div
        class="sk-component-preview__resizer"
        data-sk-component-preview-resizer
        role="separator"
        aria-orientation="horizontal"
        aria-label="Adjust preview height: Button"
        title="Drag to adjust height double click to reset"
        tabindex="0"
      >
      </div>

      <div class="sk-component-preview__loading">
        <span
          class="sk-loader"
          data-size="lg"
          role="status"
          aria-label="Loading preview: Button"></span>
      </div>

      <div class="sk-component-preview__binding" data-sk-component-preview-binding="vanilla">
        <div class="sk-component-preview__code" data-sk-component-preview-source="html">
          <CodeBlock code={demoHtml} lang="html" />
        </div>
      </div>

      <div class="sk-component-preview__binding" data-sk-component-preview-binding="react" hidden>
        <div class="sk-component-preview__code">
          <CodeBlock code={demoReact} lang="tsx" />
        </div>
      </div>
    </div>
  </ComponentPreview>

  <h2 id="bare">The portable part</h2>
  <p>
    Everything above (the Vanilla/React switch, the screen presets, the tree compiler that builds
    each stage) is THIS SITE's own machinery for comparing two bindings of ANOTHER component. None
    of it is something a consumer would compose into their product.
  </p>
  <p>
    What is portable: a title with its note, a stage with whatever is shown, and its code
    underneath, composed from <code>CodePreview</code>, not reimplemented. That is
    <code>ComponentPreview.bare</code>, the same root and the same parts with less anatomy, the
    same way <code>Popover.bare</code> is.
  </p>
  <ComponentPreview tree={componentPreviewBareTree(t)} label="ComponentPreview.bare" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" lang="css" />

  <h2>Explicitly mount</h2>
  <p>
    ComponentPreview and CodePreview are left out of <code>initComponents()</code>: An application does not accidentally download documentation surfaces. That assembly controls the host surface; the content of <code>srcdoc</code> executes its own entry point.
  </p>
  <CodeBlock code={mount} label="TypeScript" lang="ts" />
  <CodeBlock code={frameMount} label="runtime inside srcdoc" lang="ts" />
</Base>
