---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import {
  ToastActionDemo,
  ToastEmitDemo,
  ToastSimpleDemo,
  ToastStackDemo,
  ToastStatusDemo,
} from "../../../components/react-demos/toast";

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;

/* THE MAIN EXAMPLE: a toast is not authored "already visible", it appears because something happened. The markup
   stable is the trigger, the empty region and the <template> of the item; the rest is done by the app. */
const emitHtml = `<button
  class="sk-button sk-interactive"
  data-sk-button
  data-variant="primary"
  data-emit-toast
  type="button"
>
  Archive document
</button>

<div class="sk-toast-region" aria-live="polite"></div>

<template data-toast-template>
  <div
    class="sk-alert"
    data-sk-toast
    data-presentation="banner"
    data-tone="neutral"
    data-timeout="4000"
    role="status"
    aria-live="polite"
  >
    <div class="sk-alert__content">
      <div class="sk-alert__description">
        Document archived.
      </div>
    </div>
    <div class="sk-alert__actions">
      <button
        class="sk-alert__dismiss sk-button sk-interactive"
        data-sk-button
        data-size="sm"
        data-icon-only
        data-variant="ghost"
        type="button"
        aria-label="Descartar"
      >
        <span data-sk-icon="close"></span>
      </button>
    </div>
  </div>
</template>`;

const emitJs = `import { initComponents } from "@skryensya/vanilla/auto";

const region = document.querySelector(".sk-toast-region");
const template = document.querySelector("[data-toast-template]");

document
  .querySelector("[data-emit-toast]")
  .addEventListener("click", async () => {
    region.append(template.content.cloneNode(true));
    // initComponents is idempotent: it mounts only what was recently
    // inserted, and with that the toast gains ✕ and timeout.
    await initComponents(region);
  });

// The toast NEVER withdraws on its own: ask permission with sk-dismiss
// (detail.reason: "timeout" | "dismiss") and the app decides.
region.addEventListener("sk-dismiss", (event) => {
  event.target.remove();
});`;

const emitScript = `const region = document.querySelector(".sk-toast-region");
const template = document.querySelector("[data-toast-template]");

document.querySelector("[data-emit-toast]").addEventListener("click", async () => {
  region.append(template.content.cloneNode(true));
  await window.skMount(region);
});

region.addEventListener("sk-dismiss", (event) => {
  event.target.remove();
});`;

const emitReact = `import { useState } from "react";
import { Button } from "@skryensya/react/button";
import {
  Toast,
  ToastRegion,
} from "@skryensya/react/content";

const [toasts, setToasts] = useState([]);
const remove = (id) =>
  setToasts((all) => all.filter((toast) => toast.id !== id));

<Button
  variant="primary"
  onClick={() => setToasts((all) => [...all, { id: crypto.randomUUID() }])}
>
  Archive document
</Button>

<ToastRegion>
  {toasts.map((toast) => (
    <Toast
      key={toast.id}
      timeout={4000}
      onDismiss={() => remove(toast.id)}
    >
      Document archived.
    </Toast>
  ))}
</ToastRegion>;`;

const simpleHtml = `<div class="sk-toast-region" aria-live="polite">
