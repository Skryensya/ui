/* Action + closure in the same column. No timeout on purpose: a toast with action should not
   evaporate before it can be used. */
const actionHtml = `<div class="sk-toast-region" aria-live="polite">
  <div
    class="sk-alert"
    data-sk-toast
    data-presentation="banner"
