---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

const install = `pnpm add shiki @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/copy-button.css";
@import "@skryensya/core/components/switch.css";
@import "@skryensya/core/components/code-preview.css";`;

const highlight = `import { codeToHtml } from "shiki";

// Runs during build/SSR, never in the browser.
const highlighted = await codeToHtml(source, {
  lang: "ts",
  themes: {
    light: "github-light",
    dark: "github-dark",
  },
});`;

const mount = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountCodePreview } from "@skryensya/vanilla/code-preview";

// CopyButton and normal components: dynamic imports per selector.
await initComponents();

// CodePreview is opt-in and is outside the auto-loader.
mountCodePreview();`;

const example = `const registrations = [
  { selector: "[data-sk-button]", load: () => import("./button.js") },
  { selector: "[data-sk-select]", load: () => import("./select.js") },
];`;
---

<Base
  title="CodePreview"
  description="Shiki code preview with build-time SSR highlighting and opt-in Vanilla behavior."
>
  <h1>CodePreview</h1>
  <p class="lede">
    Surface for HTML highlighted by Shiki, with copy, condensed/full view and long block preview. Shiki finishes his work in build or SSR; The browser receives HTML and only mounts the controls that the document authored.
  </p>

  <CodeBlock code={example} label="TypeScript" lang="ts" />
  <p>
    To present this block below the actual render of a component, use <a href="/en/components/component-preview">ComponentPreview</a>.
  </p>

  <h2>Load contract</h2>
  <ul>
    <li>
      <code>@skryensya/core/components/code-preview.css</code> contains the anatomy and consumes the dual variables <code>--shiki-light</code> and <code>--shiki-dark</code>.
    </li>
    <li>
      <code>initComponents()</code> does not know <code>[data-sk-code-preview]</code>. Importing the auto-loader never downloads this enhancer.
    </li>
    <li>
      <code>mountCodePreview()</code> is the only behavioral seam and is idempotent. Highlighting is not part of that runtime.
    </li>
  </ul>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" lang="css" />

  <h2>Highlight in build or SSR</h2>
  <CodeBlock code={highlight} label="TypeScript" lang="ts" />

  <h2>Explicitly mount</h2>
  <p>
    Normal components are discovered by selector. CodePreview is mounted in a second deliberate call, so that no application loads a documentation preview by accident.
  </p>
  <CodeBlock code={mount} label="TypeScript" lang="ts" />
</Base>
