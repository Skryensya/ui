---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import { inlineTree } from "../../../demos/layout";
import { getLocale, useTranslations } from "../../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
---

<Base title="Inline" description="Inline, the horizontal and adaptable layout pattern.">
  <h1>Inline</h1>
  <p class="lede">
    Arranges elements horizontally and returns them to another line when space runs out. Use it for action bars and label–control pairs; the semantics belong to the element you choose.
  </p>

  <ComponentPreview
    tree={inlineTree(t)}
    label="Action bar"
    note="Box + Stack + Inline + Button"
  />

  <h2>Authored HTML</h2>
  <p>
    Use <code>sk-inline</code> in the appropriate semantic element. The attributes describe the spacing, vertical alignment, horizontal layout, and whether the row can wrap its children.
  </p>
  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />


  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of the preview.</p>

  <h2>Contract</h2>
  <ul>
    <li><code>as</code> choose the root element; The default is <code>div</code>.</li>
    <li><code>gap</code> accepts <code>none</code>, <code>xs</code>, <code>sm</code>, <code>md</code>, <code>lg</code> or <code>xl</code>; The default is <code>md</code>.</li>
    <li><code>align</code> accepts <code>start</code>, <code>center</code>, <code>end</code> or <code>baseline</code>; The default is <code>center</code>.</li>
    <li><code>justify</code> accepts <code>start</code>, <code>center</code>, <code>end</code> or <code>between</code>; in HTML it is written with <code>data-justify</code>.</li>
    <li><code>wrap</code> allows wrapping children; The default is <code>true</code>. Use <code>data-wrap="false"</code> for a single row in HTML.</li>
  </ul>
</Base>
