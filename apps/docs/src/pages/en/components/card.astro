  </Box>
</Grid>`;

/* Media card, interactive: the whole surface navigates, so it is a TileLink. data-padding="none"
   lets the media reach the edges; the body class pads the text. The title names the link, so no
   stretched-link CSS and no nested anchor. Same 3-column grid keeps it card-width. */
const mediaLinkHtml = `<div class="sk-grid" data-columns="3" data-gap="md" data-multicol>
  <a
    class="sk-tile sk-tile--interactive sk-interactive"
