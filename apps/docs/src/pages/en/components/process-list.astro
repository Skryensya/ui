---
import "@skryensya/core/components/process-list.css";
import "@skryensya/core/components/code-preview.css";
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import { processListTree } from "../../../demos/process-list";
import { getLocale, useTranslations } from "../../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;

const styles = `@import "@skryensya/core/components/process-list.css";
@import "@skryensya/core/components/code-preview.css";`;

/* A Process List is static instructional content, not workflow progress. */

---

<Base
  title="ProcessList"
  description="ProcessList: Ordered sequence of instructions with connected markers and arbitrary content."
>
  <h1>ProcessList</h1>
  <p class="lede">
    A static sequence of instructions where the content is the main thing. Use a real <code>&lt;ol&gt;</code>, number each <code>&lt;li&gt;</code>, and visually connect the steps without turning them into progress states.
  </p>

  <ComponentPreview tree={processListTree(t)} label="ProcessList" />

  <h2>When to use it</h2>
  <ul>
    <li>
      Use ProcessList for recipes, installations, and procedures whose order matters.
    </li>
    <li>
      Use <a href="/en/components/list">List</a> for static or interactive row collections.
    </li>
    <li>
      Use <a href="/en/components/steps">Steps</a> when states <code>complete</code>, <code>current</code>, or <code>upcoming</code> exist.
    </li>
  </ul>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" />

  <h2>Contract</h2>
  <ul>
    <li>
      The root is always <code>&lt;ol class="sk-process-list"&gt;</code>.
    </li>
    <li>
      Each instruction is a <code>&lt;li class="sk-process-list__item"&gt;</code>.
    </li>
    <li>
      <code>sk-process-list__title</code> identifies the step and <code>sk-process-list__content</code> supports any stream content.
    </li>
    <li>
      The counter generates the numbers; They are not manually typed nor do they represent progress.
    </li>
    <li>
      There are no persistent states or fully clickable rows. For progress use Steps.
    </li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "components/process-list.css",
        probe: "sk-process-list",
      },
    ]}
  />
</Base>
