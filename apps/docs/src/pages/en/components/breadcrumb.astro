---
import Base from "../../../layouts/Base.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import {
  breadcrumbIconTree,
  breadcrumbLongTree,
  breadcrumbMultiTree,
  breadcrumbTwoTree,
} from "../../../demos/breadcrumb";
import { getLocale, useTranslations } from "../../../i18n";
import "@skryensya/core/components/breadcrumb.css";

const install = `@import "@skryensya/core/components/breadcrumb.css";`;
const t = useTranslations(getLocale(Astro.url));
---

<Base
  title="Breadcrumb"
  description="Hierarchical location with real links and explicit current page."
>
  <h1>Breadcrumb</h1>
  <p class="lede">Hierarchical location with real links and explicit current page.</p>

  <h2>Examples</h2>

  <h3>Two levels</h3>
  <p>The minimum case: a link to the previous level and the current page, without a link or trailing separator.</p>
  <ComponentPreview tree={breadcrumbTwoTree(t)} label="Two Tier Breadcrumb" viewport="auto" />

  <h3>Multiple levels</h3>
  <p>Each intermediate level is a real link followed by its separator; only the last element loses both.</p>
  <ComponentPreview
    tree={breadcrumbMultiTree(t, {
      projects: "/projects",
      kit: "/projects/kit-digital",
    })}
    label="Multi-tiered breadcrumb"
    viewport="auto"
  />

  <h3>Separator with icon</h3>
  <p>
    The separator is a content slot: leave it empty and the template writes <code>/</code>; fill it
    with text (<code>·</code>, <code>›</code>) or an <a href="/en/components/icon">Icon</a>, such as
    <code>chevron-right</code>. Nothing else: punctuation with a heading inside is not punctuation.
  </p>
  <ComponentPreview
    tree={breadcrumbIconTree(t, "/projects")}
    label="Breadcrumb with icon separator"
    viewport="auto"
  />

  <h3>Long labels</h3>
  <p>
    A long intermediate level should not push the rest of the trail out of the column, and the current page should not be truncated: it is just the tag that the breadcrumb exists to display in full. Each part resolves the excess in a different way.
  </p>
  <ul>
    <li>
      <code>sk-breadcrumb__link</code> cuts with ellipses to <code>--sk-breadcrumb-link-max</code> (16ch by default) and exposes the full text in <code>title</code>; a long ancestor is read as a reference, not the focus of the page.
    </li>
    <li>
      <code>sk-breadcrumb__current</code> never truncates: wraps over multiple lines (<code>overflow-wrap: anywhere</code>) so that the entire title remains readable even if it does not fit on a single line.
    </li>
  </ul>
  <ComponentPreview
    tree={breadcrumbLongTree(t, "/projects")}
    label="Breadcrumb with long labels"
    viewport="auto"
  />

  <h2>Contract</h2>
  <p>Use nav + ol; the last element takes aria-current=page and is not a link.</p>

  <h2>Accessibility</h2>
  <p>The label distinguishes these crumbs from other navigations on the page.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/breadcrumb.css",
        probe: "sk-breadcrumb",
        title: "Breadcrumb",
      },
    ]}
  />
</Base>
