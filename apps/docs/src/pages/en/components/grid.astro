---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import { GridBasicDemo, GridMulticolDemo } from "../../../components/react-demos/layout";

const install = `pnpm add @skryensya/core @skryensya/react`;

const html = `<section
  class="sk-grid"
  data-columns="3"
  data-gap="md"
  aria-label="Recent projects"
>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    Atlas Project
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    Breeze Project
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    Cauce Project
  </article>
</section>`;

const react = `import { Grid } from "@skryensya/react/grid";

function Example() {
  return (
    <Grid
      as="section"
      columns={3}
      gap="md"
      aria-label="Recent projects"
    >
      <article>Atlas Project</article>
      <article>Breeze Project</article>
      <article>Cauce Project</article>
    </Grid>
  );
}`;

const multicolHtml = `<section
  class="sk-grid"
  data-columns="4"
  data-gap="md"
  data-multicol
  aria-label="Notas"
>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Atlas</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">
      One line.
    </p>
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Brisa</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">
      This note is longer: it occupies several lines and that is why its card is taller than the other two.
    </p>
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Cauce</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">
      Two lines of content here.
    </p>
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Delta</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">Corta.</p>
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Eco</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">
      Another card with enough text so that its height differs and the packaging in lanes is noticeable.
    </p>
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Faro</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">Media.</p>
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Gala</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">
      Brief summary, with another rhythm.
    </p>
  </article>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="md"
  >
    <strong>Humo</strong>
    <p class="sk-text" data-size="sm" data-tone="secondary">
      An additional note for occupying the fourth lane on a wide screen.
    </p>
  </article>
</section>`;

const multicolReact = `import { Grid } from "@skryensya/react/grid";

// data-multicol activa CSS Multi-column Layout. data-columns es
// the maximum number of lanes.
function Example() {
  return (
    <Grid
      as="section"
      columns={4}
      gap="md"
      data-multicol
      aria-label="Notas"
    >
      {notes.map((n) => (
        <article key={n.id}>{n.body}</article>
      ))}
    </Grid>
  );
}`;

const multicolCss = `/* data-columns="4": 1 lane → 2 → 3 → 4,
   depending on the viewport. */
.sk-grid[data-multicol] {
  column-count: 1;
  column-gap: var(--sk-grid-gap);
}

.sk-grid[data-multicol] > * {
  break-inside: avoid;
  margin-block-end: var(--sk-grid-gap);
}

@media (min-width: 36rem) {
  .sk-grid[data-multicol][data-columns="2"],
  .sk-grid[data-multicol][data-columns="3"],
  .sk-grid[data-multicol][data-columns="4"] {
    column-count: 2;
  }
}

@media (min-width: 52rem) {
  .sk-grid[data-multicol][data-columns="3"],
  .sk-grid[data-multicol][data-columns="4"] {
    column-count: 3;
  }
}

@media (min-width: 72rem) {
  .sk-grid[data-multicol][data-columns="4"] {
    column-count: 4;
  }
}`;
---

<Base title="Grid" description="Grid: equal columns with named gap and semantics chosen by the user.">
  <h1>Grid</h1>
  <p class="lede">
    A grid of equal columns for content groups. Each column uses <code>minmax(0, 1fr)</code>: prevents the intrinsic minimum size from widening the columns.
  </p>

  <ComponentPreview html={html} react={react} label="Grid">
    <Fragment slot="react">
      <GridBasicDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>CSS Multi-column Layout</h2>
  <p>
    <a href="https://www.w3.org/TR/css-multicol-1/">CSS Multi-column Layout Module Level 1</a> calls <strong>multi-column layout</strong> to this flow. <code>data-multicol</code> activates CSS columns: each card ends before splitting and the next continues in the same lane.
  </p>
  <p>
    <code>data-columns</code> marks the maximum number of lanes. With <code>data-columns="4"</code>, the collection uses 1 lane before <code>36rem</code>, 2 from <code>36rem</code>, 3 from <code>52rem</code>, and 4 from <code>72rem</code>. Values <code>1</code>, <code>2</code> and <code>3</code> stop at that maximum.
  </p>
  <CodeBlock code={multicolCss} label="patterns/layout.css" />
  <ComponentPreview html={multicolHtml} react={multicolReact} label="Multi-column layout">
    <Fragment slot="react">
      <GridMulticolDemo client:load />
    </Fragment>
  </ComponentPreview>
  <p>
    Columns fill a lane from top to bottom before moving to the next. Preserve a useful order in the DOM and use it for independent cards; not for a sequence whose visual order from left to right has meaning.
  </p>

  <h2>Authored HTML</h2>
  <p>
    Choose the semantic element, such as <code>section</code>, and apply <code>sk-grid</code>. Does not require vanilla initialization.
  </p>
  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />


  <h2>React</h2>
  <p>The <code>as</code> prop preserves that semantic choice.</p>
  <p>The code is in the <strong>React</strong> tab of the preview.</p>

  <h2>Contract</h2>
  <ul>
    <li><code>sk-grid</code> creates a grid of equal columns; <code>data-columns</code> supports <code>1</code>, <code>2</code>, <code>3</code>, or <code>4</code>.</li>
    <li><code>data-gap</code> supports <code>none</code>, <code>xs</code>, <code>sm</code>, <code>md</code>, <code>lg</code> or <code>xl</code>; The default value is <code>md</code>.</li>
    <li>
      <code>data-multicol</code> activates the column card wall. <code>data-columns</code> defines its maximum number of lanes: 1 → 2 → 3 → 4 at breakpoints <code>36rem</code>, <code>52rem</code> and <code>72rem</code>. In React it is passed as <code>data-multicol</code>.
    </li>
    <li>In React, <code>Grid</code> receives <code>as</code>, <code>columns</code>, and <code>gap</code>; <code>columns</code> defaults to <code>1</code>.</li>
  </ul>
</Base>
