const vanilla = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// Chevrons are authored as <span data-sk-icon="chevron-*"> placeholders;
// mountIcons replaces them with the <svg> of the linked set (it does not
// initComponents: set is always explicit).
mountIcons(document, lucideIcons);

// The accordion is authored in the HTML: the root with data-sk-accordion and data-type,
// each item with data-part="item" and a unique data-value. initComponents hydrate
// all markup [data-sk-*] with your Zag machine (the same one that React uses).
await initComponents();

// The status is heard by event on the root, not by callback.
const root = document.querySelector("[data-sk-accordion]");
root.addEventListener("sk:accordionvaluechange", (event) => {
  console.log(event.detail.value);
});`;

const react = `import { Accordion } from "@skryensya/react/accordion";
import { Icon } from "@skryensya/react/icon";

function Example() {
