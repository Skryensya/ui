  data-sk-accordion
  data-type="single"
  data-default-value="environment"
>
  <section
    class="sk-tile sk-tile--interactive sk-tile--expandable sk-interactive"
    data-part="item"
    data-value="environment"
  >
    <button
      type="button"
      class="sk-tile__trigger"
      data-part="trigger"
      aria-expanded="true"
      aria-controls="environment-content"
    >
      <span class="sk-tile__content">
        <span class="sk-tile__title">Environment</span>
        <span class="sk-tile__description">
          Production · Frankfurt
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="environment-content"
      class="sk-tile__expandable-content"
      data-part="content"
    >
      <div class="sk-stack" data-gap="sm">
        <p class="sk-tile__description">
          Node 22 runs in three replicas behind the Frankfurt balancer. Traffic is distributed round-robin and a replica recycles itself if it fails two health checks in a row.
        </p>
        <p class="sk-tile__description">
          Secrets are injected at boot from the regional vault, so no sensitive value is left in the image or build log.
        </p>
      </div>
    </div>
  </section>
</div>`;

