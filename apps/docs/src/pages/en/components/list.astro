---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import Showcase from "../../../components/Showcase.astro";
import StylingHooks from "../../../components/StylingHooks.astro";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/components/list.css";`;

/* THE LADDER. Six examples that add exactly one slot each, so the page reads as anatomy being
   assembled rather than six finished screens. Step 1 is a bare `<li>`, step 6 is the full row. */

/* 1 — The floor: a real `<ul>` with rows and dividers, and nothing else. No slots at all. */
