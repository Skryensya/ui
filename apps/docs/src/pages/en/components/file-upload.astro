---
import Base from "../../../layouts/Base.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import { FileUploadBasicDemo } from "../../../components/react-demos/file-upload";
import "@skryensya/core/components/file-upload.css";

const install = `@import "@skryensya/core/components/file-upload.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
const html = `<div
  class="sk-file-upload"
  data-sk-file-upload
  data-max-files="3"
>
  <label class="sk-file-upload__label" data-sk-file-upload-label>
    Adjuntos
  </label>
  <div
    class="sk-file-upload__dropzone"
    data-sk-file-upload-dropzone
  >
    <span>Drag files here</span>
  </div>
  <input
    class="sk-file-upload__input"
    data-sk-file-upload-input
    name="attachments"
    type="file"
    multiple
  />
  <button
    class="sk-button sk-interactive"
    data-sk-file-upload-trigger
    type="button"
  >
    Choose files
  </button>
</div>`;
const react = `import { FileUpload } from "@skryensya/react/file-upload";

function Example() {
  return (
    <FileUpload
      label="Adjuntos"
      maxFiles={3}
      maxFileSize={10_000_000}
      name="attachments"
    />
  );
}`;
---

<Base
  title="FileUpload"
  description="Selection and drag-and-drop with limits, rejection and file list."
>
  <h1>FileUpload</h1>
  <p class="lede">Selection and drag-and-drop with limits, rejection and file list.</p>

  <h2>Facility</h2>
  <ComponentPreview
    html={html}
    js={js}
    react={react}
    label="FileUpload"
    viewport="auto"
  >
    <Fragment slot="react">
      <FileUploadBasicDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Contract</h2>
  <p>Vanilla issues sk-file-change and never invents a remote load. React exposes accepted and rejected files.</p>

  <h2>Accessibility</h2>
  <p>Actual input remains available for forms and assistive technology; the dropzone does not replace it.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/file-upload.css",
        probe: "sk-file-upload",
        title: "FileUpload",
      },
    ]}
  />
</Base>
