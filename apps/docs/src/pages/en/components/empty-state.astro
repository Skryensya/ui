---
import Base from "../../../layouts/Base.astro";
import Showcase from "../../../components/Showcase.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";
import StylingHooks from "../../../components/StylingHooks.astro";
import "@skryensya/core/components/empty-state.css";

const install = `@import "@skryensya/core/components/empty-state.css";`;
/*
 * The demo, as a USAGE TREE. The markup below the stage, the TSX beside it and the live React
 * island are all emitted from this, so the snippet a reader copies is what they just saw render.
 */
const tree = {
  contract: "empty-state",
  signature: "EmptyState",
  slots: {
    icon: { contract: "icon", signature: "Icon", options: { name: "search" } },
    title: "There are no projects yet",
    description: "Create the first one to organize the team's work.",
    actions: { contract: "button", signature: "Button.action", children: "Create project" },
  },
} as const satisfies UsageTree;
---

<Base
  title="EmptyState"
  description="Explain why there is no content and offer a concrete next action."
>
  <h1>EmptyState</h1>
  <p class="lede">Explains why there is no content and offers a concrete next action.</p>

  <h2>Facility</h2>
  <Showcase tree={tree} label="Empty State" />

  <h2>Contract</h2>
  <p>The title names the state, the description explains, and the action resolves. Do not use EmptyState during loading.</p>

  <h2>Accessibility</h2>
  <p>The icon is decorative; the text and action support the meaning without depending on an illustration.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/empty-state.css",
        probe: "sk-empty-state",
        title: "EmptyState",
      },
    ]}
  />
</Base>
