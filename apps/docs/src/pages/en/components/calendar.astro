---
import Base from "../../../layouts/Base.astro";
import Showcase from "../../../components/Showcase.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import {
  CalendarBasicDemo,
  CalendarMinMaxDemo,
  CalendarRangeDemo,
} from "../../../components/react-demos/calendar";
import "@skryensya/core/components/calendar.css";

const install = `@import "@skryensya/core/components/calendar.css";`;

const html = `<div class="sk-calendar" data-sk-calendar data-locale="en-US"></div>`;

const react = `import { Calendar } from "@skryensya/react/calendar";

function Example() {
  return <Calendar label="Availability" locale="en-US" />;
}`;

const rangeHtml = `<div class="sk-calendar" data-sk-calendar data-locale="en-US" data-selection-mode="range"></div>`;

const rangeReact = `import { Calendar } from "@skryensya/react/calendar";

function Example() {
  return <Calendar label="Stay" locale="en-US" selectionMode="range" />;
}`;

// Anchors the demo to TODAY on every build/load instead of a fixed date: it never goes stale.
const today = new Date();
const minMaxDate = new Date(today);
minMaxDate.setDate(minMaxDate.getDate() + 14);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const minDate = isoDate(today);
const maxDate = isoDate(minMaxDate);

const minMaxHtml = `<div
  class="sk-calendar"
  data-sk-calendar
  data-locale="en-US"
  data-min="${minDate}"
  data-max="${maxDate}"
></div>`;

const minMaxReact = `import { Calendar } from "@skryensya/react/calendar";

function Example() {
  return (
    <Calendar
      label="Check-in"
      locale="en-US"
      min="${minDate}"
      max="${maxDate}"
    />
  );
}`;
---

<Base
  title="Calendar"
  description="Standalone date grid for a day, month, or year/decade view, with no field or popover and the same button changing views."
>
  <h1>Calendar</h1>
  <p class="lede">
    The date grid itself, separate from the field that opens it. <a href="/en/components/date-picker">DatePicker</a> nests it inside a popover; This page is the same footer component, for when the calendar <em>is</em> the UI (a reservations page, a dashboard filter) and no input is needed behind it.
  </p>

  <h2>Grid</h2>
  <p>
    Behind it still running <code>@zag-js/date-picker</code> (there is no separate calendar machine in this stack), configured <code>inline</code>: same keyboard navigation, same grid with six fixed weeks.
  </p>
  <Showcase html={html} react={react} label="Calendar" viewport="auto">
    <Fragment slot="react">
      <CalendarBasicDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Switch view: buttons, no selects</h2>
  <p>
    The header does not carry two month and year <code>&lt;select&gt;</code> elements: it is a single
    button, <code>sk-calendar__view-trigger</code>, which shows the visible date (“March 2026” in day
    view, “2026” in month view, “2020–2029” in year view) and on click <strong>climbs</strong> one
    level — day → month → year — instead of forcing you to page month by month toward a distant date.
  </p>
  <p>
    Choosing a month or a year in its grid <strong>descends</strong> one level: tapping “Jan” in the
    month view returns to the day view already parked on January; tapping a year in the year view
    returns to the month view for that year. Going up and back down — climb to pick the decade,
    descend by tapping a cell — replaces what two native selects used to do, without giving up
    keyboard navigation of the grid (roles <code>grid</code>/<code>gridcell</code>, focus managed by
    Zag).
  </p>

  <h2>Range selection</h2>
  <p>
    <code>data-selection-mode="range"</code> changes the selection rule: the first click sets the
    start, the second the end. Zag marks every day in between <code>data-in-range</code> (not
    <code>data-selected</code>, which stays for the two endpoints only) and, while the end is still
    being chosen, the same state appears as <code>data-in-hover-range</code> as the pointer moves —
    with no JavaScript of your own: the <code>onPointerMove</code> that feeds it only turns on when
    the mode is <code>range</code>.
  </p>
  <p>
    That attribute lives on the <em>trigger</em>, not on the cell, so a fill limited to its own button
    would leave a gap between days. <code>sk-calendar__cell:has(...)</code> reaches the trigger's
    state from the cell — the same technique Combobox's focus ring already uses — so the whole cell is
    painted and the band reads as continuous under <code>border-collapse</code>.
  </p>
  <Showcase html={rangeHtml} react={rangeReact} label="Calendar (range)" viewport="auto">
    <Fragment slot="react">
      <CalendarRangeDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Bounded range: min and max</h2>
  <p>
    <code>data-min</code> / <code>data-max</code> (ISO dates) disable everything falling outside the
    range. In day view Zag already marks those cells <code>data-disabled</code>/
    <code>aria-disabled</code>, and the day's own <code>onClick</code> refuses to fire the selection.
  </p>
  <p>
    Min/max reaches month and year just the same: <code>getMonthsGrid</code>/<code>getYearsGrid</code>
    resolve their own native <code>disabled</code> per cell, comparing against min/max the focused
    date <em>carried into that month or year</em> (not “does this month have any valid day?” — a
    nuance that can disable a month which does touch the range, if the focused day moved into that
    month falls outside it). Neither view needed new CSS: both already go through
    <code>.sk-button:disabled</code>.
  </p>
  <Showcase html={minMaxHtml} react={minMaxReact} label="Calendar (min/max)" viewport="auto">
    <Fragment slot="react">
      <CalendarMinMaxDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Contract</h2>
  <ul>
    <li>
      <code>sk-calendar__header</code> groups previous, view button and next; all three read "previous/next <em>from active view</em> " (month in day view, year in month view, decade in year view), Zag wraps the accessible label alone.
    </li>
    <li>
      <code>sk-calendar__table</code> is reused in all three views; <code>sk-calendar__month-grid</code> and <code>sk-calendar__year-grid</code> are modifier hooks on the same table, not distinct markup.
    </li>
    <li>
      <code>sk-calendar__cell-trigger</code> is the same cell button in day, month, and year views:
      same size and the same selected, today, and disabled states.
    </li>
  </ul>

  <h2>Accessibility</h2>
  <p>
    The grid is <code>role="grid"</code> keyboard navigable in all three views. The locale determines months and the two-letter abbreviations visible in the day grid; the localized full name remains in each <code>&lt;abbr&gt;</code>.
  </p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[{ file: "components/calendar.css", probe: "sk-calendar", title: "Calendar" }]}
  />
</Base>
