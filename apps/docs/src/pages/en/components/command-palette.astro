---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/components/dialog.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/command-palette.css";
@import "@skryensya/core/patterns/scroll-lock.css";`;

const html = `<button
  class="sk-button sk-interactive"
  data-variant="secondary"
  type="button"
  aria-controls="demo-cmdk"
  aria-expanded="false"
  data-sk-command-palette-open
>
  <span data-sk-icon="search"></span>
  Open command palette
</button>

<dialog
  class="sk-dialog sk-command-palette"
  id="demo-cmdk"
  data-sk-command-palette
  data-sk-command-palette-index="demo-cmdk-index"
  aria-label="Search"
>
  <div class="sk-command-palette__search">
    <span data-sk-icon="search"></span>
    <input
      class="sk-command-palette__input"
      type="text"
      role="combobox"
      placeholder="Search…"
      autocomplete="off"
      spellcheck="false"
      aria-controls="demo-cmdk-list"
      aria-expanded="true"
      aria-autocomplete="list"
      data-sk-command-palette-input
    />
    <form method="dialog">
      <button
        class="sk-button sk-interactive sk-dialog__close sk-command-palette__close"
        data-sk-button
        data-variant="ghost"
        data-size="sm"
        data-icon-only
        type="submit"
        value="cancel"
        aria-label="Close"
      >
        <span data-sk-icon="close"></span>
      </button>
    </form>
  </div>
  <ul
    class="sk-command-palette__list sk-scrollbar"
    id="demo-cmdk-list"
    role="listbox"
    aria-label="Results"
    data-sk-command-palette-list
  ></ul>
  <p
    class="sk-command-palette__empty"
    data-sk-command-palette-empty
    hidden
  >
    No results.
  </p>
  <footer class="sk-command-palette__footer">
    <span>
      <kbd class="sk-kbd">↑</kbd>
      <kbd class="sk-kbd">↓</kbd>
      navigate
    </span>
    <span><kbd class="sk-kbd">↵</kbd> open</span>
    <span><kbd class="sk-kbd">Esc</kbd> close</span>
  </footer>
</dialog>
<script type="application/json" id="demo-cmdk-index">[{"label":"Button","href":"/en/components/button","section":"Components","group":"Controls"},{"label":"Dialog","href":"/en/components/dialog","section":"Components","group":"Overlays"},{"label":"Hotkey","href":"/en/hotkey","aliases":["shortcut"],"section":"Foundations","group":"Behavior"}]</script>`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
await initComponents();`;
---

<Base
  title="CommandPalette"
  description="CommandPalette: searchable listbox within a native Dialog, with opt-in shortcut and closure by IconButton."
>
  <h1>CommandPalette</h1>
  <p class="lede">
    A <strong>command palette</strong>: a field that filters an index and a listbox with <code>aria-activedescendant</code>, hosted in a native <a href="/en/components/dialog"><code>Dialog</code></a> (<code>showModal</code>, Esc, focus). The shortcut ( <a href="/en/hotkey">Hotkey</a> ) is opt-in by attribute; this site uses it with <kbd class="sk-kbd" data-sk-command-palette-hint>⌘K</kbd>.
  </p>

  <ComponentPreview html={html} js={js} label="CommandPalette" viewport="overlay" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" />

  <h2>Contract</h2>
  <ul>
    <li>
      Root: <code>&lt;dialog class="sk-dialog sk-command-palette" data-sk-command-palette&gt;</code>.
    </li>
    <li>
      JSON index via <code>data-sk-command-palette-index</code> (id of <code>&lt;script type="application/json"&gt;</code>).
    </li>
    <li>
      Open: <code>data-sk-command-palette-open</code> + <code>aria-controls</code> to the dialog id (or the attribute value equal to the id).
    </li>
    <li>
      Optional shortcut: <code>data-sk-command-palette-hotkey="mod+k"</code>. Without it, only the button opens.
    </li>
    <li>
      Close: <code>&lt;form method="dialog"&gt;</code> with IconButton (<code>sk-dialog__close sk-command-palette__close</code>), Esc, or click on the backdrop.
    </li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "components/command-palette.css",
        probe: "sk-command-palette",
      },
    ]}
  />
</Base>
