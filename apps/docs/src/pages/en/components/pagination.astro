---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import Showcase from "../../../components/Showcase.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import { PaginationDemo } from "../../../components/react-demos/pagination";

const install = `pnpm add @skryensya/core @skryensya/react`;

const html = `<nav class="sk-pagination" aria-label="Pagination">
  <button
    class="sk-pagination__previous sk-interactive"
    type="button"
    aria-label="Previous page"
  >
    <span data-sk-icon="chevron-left" data-sk-icon-size="sm"></span>
  </button>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Page 1"
  >
    1
  </button>
  <span class="sk-pagination__ellipsis" aria-hidden="true">…</span>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Page 4"
  >
    4
  </button>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-current="page"
    aria-label="Page 5"
  >
    5
  </button>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Page 6"
  >
    6
  </button>
  <span class="sk-pagination__ellipsis" aria-hidden="true">…</span>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Page 12"
  >
    12
  </button>
  <button
    class="sk-pagination__next sk-interactive"
    type="button"
    aria-label="Next page"
  >
    <span data-sk-icon="chevron-right" data-sk-icon-size="sm"></span>
  </button>
</nav>`;

const react = `import { useState } from "react";
import { Pagination } from "@skryensya/react/pagination";

function Example() {
  const [page, setPage] = useState(5);
  return (
    <Pagination
      page={page}
      total={12}
      onPageChange={setPage}
      label="Pagination"
      previousLabel="Previous page"
      nextLabel="Next page"
    />
  );
}`;

const rangeExample = `import { paginationRange } from "@skryensya/core/pagination";

paginationRange(5, 20);
// → [1, "ellipsis", 4, 5, 6, "ellipsis", 20]`;
---

<Base title="Pagination" description="Pagination: page window as a pure function of the core, with first, last and ellipsis.">
  <h1>Pagination</h1>
  <p class="lede">
    Pagination cycles through a paginated set, one page at a time. The visible window is the interesting part, and it lives as a pure function in the core: first and last always present, the current one with a brother on each side, and the hidden runs collapse into an ellipsis.
  </p>

  <Showcase html={html} react={react} label="Pagination">
    <Fragment slot="react">
      <PaginationDemo client:load />
    </Fragment>
  </Showcase>
  <p>
    Prev/next use the <code>chevron-left</code> and <code>chevron-right</code> roles from the set. The current page has <code>aria-current="page"</code>; prev/next are disabled on borders. The ellipsis is inert text, not an objective. The targets carry <code>sk-interactive</code>.
  </p>

  <h2>The window, in the core</h2>
  <p>The rendering and handlers are from the binding; The calculation is from the core and can be tested in isolation:</p>
  <CodeBlock code={rangeExample} lang="ts" label="@skryensya/core/pagination" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of the preview. React draws the chevrons of the linked set.</p>
  <StylingHooks groups={[{ file: "components/pagination.css", probe: "sk-pagination" }]} />
</Base>
