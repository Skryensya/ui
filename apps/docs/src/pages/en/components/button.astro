---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import Showcase from "../../../components/Showcase.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import {
  ButtonBasicDemo,
  ButtonIconDemo,
  ButtonIconOnlyDemo,
  ButtonIconOnlySmDemo,
  ButtonAsLinkDemo,
  ButtonSizeDemo,
  TileButtonDemo,
} from "../../../components/react-demos/button";


const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const html = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="primary"
  >
    Save
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="neutral"
  >
    Cancel
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="danger"
  >
    Delete
  </button>
</div>`;

/* Icon + text: no extra hook. The button is already an inline-flex row with a gap, so an authored
   <svg class="sk-icon"> and the label lay themselves out. The icon is DECORATIVE, the label already
   names the action, so it stays aria-hidden. */
const iconHtml = `<button
  class="sk-button sk-interactive"
  data-sk-button
  data-variant="primary"
>
  <span data-sk-icon="download"></span>
  Download
</button>`;

/* Icon-only: data-icon-only makes the box a square, and the name, with no text to carry it, MUST
   be authored as aria-label. The icon stays decorative. Default size matches the control (md). */
const iconOnlyHtml = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-icon-only
    aria-label="Settings"
  >
    <span data-sk-icon="settings"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-icon-only
    data-variant="ghost"
    aria-label="Edit"
  >
    <span data-sk-icon="edit"></span>
  </button>
</div>`;

/* Same shape at sm: face paints at control-sm; ::after keeps the 44px hit. */
const iconOnlySmHtml = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    aria-label="Settings"
  >
    <span data-sk-icon="settings"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    data-variant="ghost"
    aria-label="Edit"
  >
    <span data-sk-icon="edit"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    data-variant="primary"
    aria-label="Add"
  >
    <span data-sk-icon="add"></span>
  </button>
</div>`;

const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// Icons are authored as <span data-sk-icon> placeholders;
// mountIcons replaces them with the <svg> of the linked set.
mountIcons(document, lucideIcons);

await initComponents();`;

const react = `import { Button } from "@skryensya/react/button";

function Example() {
  return (
    <div className="sk-inline">
      <Button variant="primary">Save</Button>
      <Button variant="neutral">Cancel</Button>
      <Button variant="danger">Delete</Button>
    </div>
  );
}`;

const sizeHtml = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-variant="primary"
  >
    Save
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="md"
    data-variant="primary"
  >
    Save
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="lg"
    data-variant="primary"
  >
    Save
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    data-variant="ghost"
    aria-label="More actions"
  >
    <span data-sk-icon="more"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="md"
    data-icon-only
    data-variant="ghost"
    aria-label="More actions"
  >
    <span data-sk-icon="more"></span>
  </button>
</div>`;

const sizeReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  return (
    <div className="sk-inline">
      <Button size="sm" variant="primary">Save</Button>
      <Button variant="primary">Save</Button>
      {/* md is the default: skip size or size="md" */}
      <Button size="lg" variant="primary">Save</Button>
      <Button
        size="sm"
        iconOnly
        variant="ghost"
        aria-label="More actions"
      >
        <Icon name="more" />
      </Button>
      <Button iconOnly variant="ghost" aria-label="More actions">
        <Icon name="more" />
      </Button>
    </div>
  );
}`;

const sizeHit = `/* Already ships in components/button.css. No need
   to write it: it's here because it's the part of the
   component that surprises most, and it's worth knowing
   it exists.

   Positioning is NOT declared here on purpose: it's set
   by .sk-interactive (state layer). A position of its own
   would turn any button into the containing block for
   whatever it holds in absolute. */
.sk-button::after {
  content: "";
  position: absolute;
  inset-block: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
  inset-inline: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
}`;

const iconReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  return (
    <Button variant="primary">
      <Icon name="download" />
      Download
    </Button>
  );
}`;


const iconOnlyReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  // no visible text, name is required: aria-label
  return (
    <div className="sk-inline">
      <Button iconOnly aria-label="Settings">
        <Icon name="settings" />
      </Button>
      <Button iconOnly variant="ghost" aria-label="Edit">
        <Icon name="edit" />
      </Button>
    </div>
  );
}`;

const iconOnlySmReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  // Face sm (32px) + hit 44px via ::after. aria-label is required.
  return (
    <div className="sk-inline">
      <Button size="sm" iconOnly aria-label="Settings">
        <Icon name="settings" />
      </Button>
      <Button
        size="sm"
        iconOnly
        variant="ghost"
        aria-label="Edit"
      >
        <Icon name="edit" />
      </Button>
      <Button
        size="sm"
        iconOnly
        variant="primary"
        aria-label="Add"
      >
        <Icon name="add" />
      </Button>
    </div>
  );
}`;

const tileButtonHtml = `<button
  class="sk-tile sk-tile--interactive sk-interactive"
  type="button"
>
  <span class="sk-tile__content">
    <span class="sk-tile__title">Run deployment</span>
    <span class="sk-tile__description">
      Start the production deployment now.
    </span>
  </span>
</button>`;

const tileButtonVanilla = `import { createTileButton } from "@skryensya/vanilla/tile-button";

const button = createTileButton();
button.textContent = "Run deployment";
button.addEventListener("click", runDeployment);`;

const tileButtonReact = `import { TileButton } from "@skryensya/react/tile-button";

function Example() {
  return (
    <TileButton onClick={SomeFunction}>
      <span className="sk-tile__content">
        <span className="sk-tile__title">Run deployment</span>
        <span className="sk-tile__description">
          Start the production deployment now.
        </span>
      </span>
    </TileButton>
  );
}`;
const linkHtml = `<div class="sk-inline">
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="primary"
    href="/en/first-component"
  >
    Go to first component
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-variant="neutral"
    href="/en/first-component"
  >
    Small
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-size="lg"
    data-variant="neutral"
    href="/en/first-component"
  >
    Large
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="neutral"
    href="/en/first-component"
  >
    <span data-sk-icon="download"></span>
    With icon
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-icon-only
    data-variant="ghost"
    aria-label="Go to first component"
    href="/en/first-component"
  >
    <span data-sk-icon="arrow-right"></span>
  </a>
</div>`;

const linkReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  // Same Button, an href switches the tag to <a>. Every shape follows: size, icon, iconOnly.
  return (
    <div className="sk-inline">
      <Button variant="primary" href="/en/first-component">
        Go to first component
      </Button>
      <Button size="sm" variant="neutral" href="/en/first-component">
        Small
      </Button>
      <Button size="lg" variant="neutral" href="/en/first-component">
        Large
      </Button>
      <Button variant="neutral" href="/en/first-component">
        <Icon name="download" />
        With icon
      </Button>
      <Button
        iconOnly
        variant="ghost"
        aria-label="Go to first component"
        href="/en/first-component"
      >
        <Icon name="arrow-right" />
      </Button>
    </div>
  );
}`;

---

<Base title="Button" description="Button: style hooks, minimal vanilla enhancer and React component.">
  <h1>Button</h1>
  <p class="lede">
    Styling hooks over the native <code>&lt;button&gt;</code>, a vanilla enhancer, and a React component.
  </p>

  <h2>Variants</h2>
  <Showcase html={html} react={react} label="Button">
    <Fragment slot="react">
      <ButtonBasicDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Sizes</h2>
  <Showcase
    html={sizeHtml}
    react={sizeReact}
    label="Button · sm / md / lg"
  >
    <Fragment slot="react">
      <ButtonSizeDemo client:load />
    </Fragment>
  </Showcase>
  <CodeBlock
    code={sizeHit}
    label="components/button.css"
    lang="css"
    note="ships already: the sm face paints at 32px, the hit stays 44px"
  />

  <h2>With icon</h2>
  <Showcase html={iconHtml} react={iconReact} label="Button with icon">
    <Fragment slot="react">
      <ButtonIconDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Icon only</h2>
  <Showcase html={iconOnlyHtml} react={iconOnlyReact} label="Icon only">
    <Fragment slot="react">
      <ButtonIconOnlyDemo client:load />
    </Fragment>
  </Showcase>
  <Showcase
    html={iconOnlySmHtml}
    react={iconOnlySmReact}
    label="Icon only · sm"
  >
    <Fragment slot="react">
      <ButtonIconOnlySmDemo client:load />
    </Fragment>
  </Showcase>

  <h2>As a link</h2>
  <p>
    Any shape above — variant, size, icon, icon-only — also renders as a link: same classes, same
    <code>data-*</code> attributes, only the tag changes (<code>&lt;a href&gt;</code> instead of
    <code>&lt;button&gt;</code>). In React, passing <code>href</code> to <code>Button</code> does the
    switch. A link cannot be <code>disabled</code>: render unbound content instead.
  </p>
  <Showcase html={linkHtml} react={linkReact} label="Button as link">
    <Fragment slot="react">
      <ButtonAsLinkDemo client:load />
    </Fragment>
  </Showcase>

  <h2>TileButton</h2>
  <p>When the whole surface is one action, not just a label inside it.</p>
  <Showcase html={tileButtonHtml} react={tileButtonReact} label="TileButton">
    <Fragment slot="react">
      <TileButtonDemo client:load />
    </Fragment>
  </Showcase>
  <CodeBlock code={tileButtonVanilla} label="JavaScript" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>Initialize vanilla</h2>
  <CodeBlock code={js} label="JavaScript" />

  <StylingHooks groups={[{"file":"components/button.css","probe":"sk-button"}]} />
</Base>
