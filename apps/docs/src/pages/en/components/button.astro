---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import {
  buttonAsLinkTree,
  buttonIconOnlySmTree,
  buttonIconOnlyTree,
  buttonIconTree,
  buttonSizesTree,
  buttonVariantsTree,
  tileButtonTree,
} from "../../../demos/button";
import { getLocale, useTranslations } from "../../../i18n";
import StylingHooks from "../../../components/StylingHooks.astro";

const t = useTranslations(getLocale(Astro.url));
/* The link demo points at a real docs page, and that page's path differs per locale. */
const LINK_HREF = "/en/first-component";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// Icons are authored as <span data-sk-icon> placeholders;
// mountIcons replaces them with the <svg> of the linked set.
mountIcons(document, lucideIcons);

await initComponents();`;

const sizeHit = `/* Already ships in components/button.css. No need
   to write it: it's here because it's the part of the
   component that surprises most, and it's worth knowing
   it exists.

   Positioning is NOT declared here on purpose: it's set
   by .sk-interactive (state layer). A position of its own
   would turn any button into the containing block for
   whatever it holds in absolute. */
.sk-button::after {
  content: "";
  position: absolute;
  inset-block: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
  inset-inline: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
}`;



const tileButtonVanilla = `import { createTileButton } from "@skryensya/vanilla/tile-button";

const button = createTileButton();
button.textContent = "Run deployment";
button.addEventListener("click", runDeployment);`;

---

<Base title="Button" description="Button: style hooks, minimal vanilla enhancer and React component.">
  <h1>Button</h1>
  <p class="lede">
    Styling hooks over the native <code>&lt;button&gt;</code>, a vanilla enhancer, and a React component.
  </p>

  <h2>Variants</h2>
  <ComponentPreview tree={buttonVariantsTree(t)} label="Button" />

  <h2>Sizes</h2>
  <ComponentPreview tree={buttonSizesTree(t)} label="Button · sm / md / lg" />
  <CodeBlock
    code={sizeHit}
    label="components/button.css"
    lang="css"
    note="ships already: the sm face paints at 32px, the hit stays 44px"
  />

  <h2>With icon</h2>
  <ComponentPreview tree={buttonIconTree(t)} label="Button with icon" />

  <h2>Icon only</h2>
  <ComponentPreview tree={buttonIconOnlyTree(t)} label="Icon only" />
  <ComponentPreview tree={buttonIconOnlySmTree(t)} label="Icon only · sm" />

  <h2>As a link</h2>
  <p>
    Any shape above — variant, size, icon, icon-only — also renders as a link: same classes, same
    <code>data-*</code> attributes, only the tag changes (<code>&lt;a href&gt;</code> instead of
    <code>&lt;button&gt;</code>). In React, passing <code>href</code> to <code>Button</code> does the
    switch. A link cannot be <code>disabled</code>: render unbound content instead.
  </p>
  <ComponentPreview tree={buttonAsLinkTree(t, LINK_HREF)} label="Button as link" />

  <h2>TileButton</h2>
  <p>When the whole surface is one action, not just a label inside it.</p>
  <ComponentPreview tree={tileButtonTree(t)} label="TileButton" />
  <CodeBlock code={tileButtonVanilla} label="JavaScript" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>Initialize vanilla</h2>
  <CodeBlock code={js} label="JavaScript" />

  <StylingHooks groups={[{"file":"components/button.css","probe":"sk-button"}]} />
</Base>
