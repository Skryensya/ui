---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import { carouselBareTree, carouselCardsTree } from "../../../demos/carousel";
import { getLocale, useTranslations } from "../../../i18n";
import "@skryensya/core/components/carousel.css";
import "@skryensya/icons-lucide/carousel.css";
import "../../../examples/carousel.css";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla \\
  @skryensya/icons-lucide`;

const styles = `@import "@skryensya/core/components/carousel.css";
@import "@skryensya/icons-lucide/carousel.css";
@import "@skryensya/core/patterns/image-frame.css";
@import "@skryensya/core/patterns/media-gradient.css";`;

const bootstrap = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);
await initComponents(); // run the machine at every [data-sk-carousel]`;

const demoSrc = "/demos/media-gradient.svg";

const featureSlide = (opts: {
  eyebrow: string;
  title: string;
  body: string;
  position?: string;
}) => {
  const position = opts.position
    ? `\n        data-position="${opts.position}"`
    : "";
  return `  <div class="sk-carousel__slide">
    <article
      class="sk-box carousel-card"
      data-surface="surface"
      data-border="subtle"
      data-padding="none"
    >
      <div
        class="sk-image-frame"
        data-aspect="16/9"
        data-radius="top"${position}
      >
        <img
          class="sk-image-frame__media"
          src="${demoSrc}"
          alt=""
        />
        <div class="sk-media-caption" data-edge="bottom">
          <div
            class="sk-media-gradient"
            data-strength="md"
            aria-hidden="true"
          ></div>
          <h3
            class="sk-heading"
            data-size="h4"
            data-flush
          >
            ${opts.title}
          </h3>
        </div>
      </div>
      <div class="carousel-card__body">
        <p class="sk-text" data-role="eyebrow">
          ${opts.eyebrow}
        </p>
        <p
          class="sk-text"
          data-tone="secondary"
          data-size="sm"
        >
          ${opts.body}
        </p>
      </div>
    </article>
  </div>`;
};

const slides = [
  featureSlide({
    eyebrow: "Productivity",
    title: "Search",
    body: "Find any project instantly, with live shortcuts and filters.",
    position: "top",
  }),
  featureSlide({
    eyebrow: "Context",
    title: "Activity",
    body: "Six months of changes in a timeline that does not lose track.",
    position: "center",
  }),
  featureSlide({
    eyebrow: "Analytics",
    title: "Reports",
    body: "Cohorts, scheduled export and metrics that fit on one card.",
    position: "bottom",
  }),
  featureSlide({
    eyebrow: "Collaboration",
    title: "Team",
    body: "Invite, assign roles and share spaces without leaving the flow.",
    position: "left",
  }),
].join("\n");

/* The base without JS: the SAME markup without data-sk-carousel, so the enhancer does not touch it and the
   Native pseudo-elements draw controls with zero JavaScript. */
const nativeHtml = `<section
  class="sk-carousel"
  aria-label="What's new (without JS)"
  style="--sk-carousel-slide-size: min(85%, 22rem)"
>
  <div class="sk-carousel__track">
${slides}
  </div>
</section>`;

const nativeCss = `@import "@skryensya/icons-lucide/carousel.css";

/* zero JS: platform draws controls */
.sk-carousel__track { scroll-marker-group: after; }
.sk-carousel__track::scroll-button(inline-start) {
  content: var(--sk-carousel-native-previous-icon) / "Previous";
  grid-column: 1;
}
.sk-carousel__track::scroll-button(inline-end) {
  content: var(--sk-carousel-native-next-icon) / "Next";
  grid-column: 3;
}
.sk-carousel__track::scroll-marker-group {
  grid-column: 2; /* the dot row */
}
.sk-carousel__slide::scroll-marker { content: ""; }
.sk-carousel__slide::scroll-marker:target-current { /* activo */ }

/* The ::scroll-button boxes are laid out after the scroller, in the
   parent flow. The 3-column grid reserves the extremes for them. */`;

const person = (name: string, initials: string, role: string) => `    <div class="sk-carousel__slide">
      <article
        class="sk-box carousel-person"
        data-surface="surface"
        data-border="subtle"
        data-padding="lg"
      >
        <span
          class="sk-avatar"
          data-size="lg"
          role="img"
          aria-label="${name}"
        >
          <span
            class="sk-avatar__fallback"
            aria-hidden="true"
          >${initials}</span>
        </span>
        <div class="carousel-person__meta">
          <p class="sk-text" data-weight="label">
            ${name}
          </p>
          <p
            class="sk-text"
            data-tone="secondary"
            data-size="sm"
          >
            ${role}
          </p>
        </div>
      </article>
    </div>`;

/* Multi-up + loop + autoplay: the slides are narrower, several words fit per page, and the
   machine counts them by measuring, not dividing. */
const autoHtml = `<section
  class="sk-carousel"
  data-sk-carousel
  data-loop
  data-autoplay="3500"
  aria-label="Team"
  style="--sk-carousel-slide-size: min(42%, 14rem)"
>
  <div class="sk-carousel__track">
${[
  person("Ada Lovelace", "AL", "Platform"),
  person("Grace Hopper", "GH", "Compilers"),
  person("Radia Perlman", "RP", "Networks"),
  person("Barbara McClintock", "BM", "Genetics"),
  person("Karen Spärck Jones", "KS", "Retrieval"),
].join("\n")}
  </div>
</section>`;

const api = `const carousel = document.querySelector("[data-sk-carousel]");

// pin to a page (0-based) — the same command that sends snapTo() from the React ref
carousel.dispatchEvent(new CustomEvent("sk-carousel-goto", { detail: { index: 2 } }));

// read the active page every time it changes (swipe, wheel, button, key, drag or goto)
carousel.addEventListener("sk-carousel-change", (event) => {
  console.log(event.detail); // { index, count } ← count are measured PAGES, not slides
});`;
---

<Base
  title="Carousel"
  description="Carousel: Native slides scroll-snap region with machine-backed (Zag) controls, snap-to-index and a JS-free base."
>
  <h1>Carousel</h1>
  <p class="lede">
    Scrollable sections <strong>native</strong>: the track is a <code>&lt;div&gt;</code> with
    <code>scroll-snap-type</code>, so scrolling, tactile momentum and anchor points
    They are from the platform, not from a script. Above are two layers of control on that same substrate: one
    base <strong>without JS</strong> with native carousel pseudo-elements, and an enhancer
    <strong>machine-backed</strong> on <code>@zag-js/carousel</code> which measures the track, derives the
    pages and draw buttons and dots. Each slide is any content — a card, an image, a stat.
  </p>

  <h2>Card carousel</h2>
  <p>
    With <code>data-sk-carousel</code>, the enhancer runs the machine: prev/next (disabled at the
    ends), one dot per <strong>page</strong>, keyboard navigation, drag, and re-measurement on resize.
    Each slide is a card composed from <a href="/en/components/image-frame">ImageFrame</a>,
    <code>Box</code>, <code>Stack</code>, and <code>Text</code> —without local classes. The default
    CSS size lets the next card peek through.
  </p>
  <ComponentPreview
    tree={carouselCardsTree(t)}
    js={bootstrap}
    label="Card carousel"
    note="ImageFrame + layout + typography · scroll-snap + Zag"
  />

  <h2>One dot per page, not per slide</h2>
  <p>
    This is the specific reason why there is a machine here and not an accountant. Anchor positions
    <strong>reachable</strong> are not one per slide: when a slide appears, the last ones are cropped
    all against the maximum scroll and collapse in the same position. A handmade carousel draws there
    one dot per slide and ends with dots that <em>never</em> can be activated and a “next” button that
    It is never disabled. The machine derives pages from <code>getScrollSnapPositions</code>—measurements,
    cropped and deduplicated—so the dots and scroll match by construction. It looks
    shrinking the window on any of the examples: the slides that enter change, the
    number of dots, and the last one can always be reached.
  </p>

  <h2>Multi-up, loop and autoplay</h2>
  <p>
    Narrower slides enter several per page, and the machine counts them by measuring. With <code>data-loop</code> the carousel turns around, with <code>data-autoplay</code> it advances by itself (empty for the default 4000 ms, or a delay in ms). Autoplay is paused only when the tab is no longer visible.
  </p>
  <p>
    With <code>data-autoplay</code> there is also a <strong>pause button</strong>: something that moves only has to be able to stop (WCAG 2.2.2), so option and control are one thing. And whoever declares <code>prefers-reduced-motion</code> is not started: the carousel remains still and the button offers to play.
  </p>
  <ComponentPreview html={autoHtml} label="Multi-up + autoplay" note="Avatar + meta · data-loop · data-autoplay" />

  <h2>No controls</h2>
  <p>
    <code>data-controls="none"</code> turns off the <strong>two</strong> layers: neither enhancer buttons and dots, nor native <code>:: scroll-button</code> and <code>:: scroll-marker</code>. What remains is the bare track, which is still a scroller with snap: each slide is a stop (<code>scroll-snap-stop: always</code>), so sliding never skips a card.
  </p>
  <p>
    What does not change is the behavior: the controls were chrome. The keyboard continues walking with the focus on the track, and <code>sk-carousel-goto</code> / <code>sk-carousel-change</code> They are still the same pair of events.
  </p>
  <p>
    And here you see why the <strong>mouse drag comes on</strong>: a vertical wheel
    Scroll the <em>page</em>, not the horizontal track you have under the cursor. Without drag, a
    desktop pointer would have no way to loop through this. The cursor
    <code>grab</code> is the entire prompt, and only appears where dragging actually works. turn it off
    with <code>data-mouse-drag="off"</code> when the slide text is to be selected: the
    Drag deletes the selection.
  </p>
  <ComponentPreview
    tree={carouselBareTree(t)}
    label="No controls"
    note='data-controls="none" · drag and swipe'
  />

  <h2>Without JS: native controls</h2>
  <p>
    The <strong>same markup</strong> without <code>data-sk-carousel</code>: the enhancer does not touch it and the native pseudo-elements (<code>:: scroll-button</code> and <code>:: scroll-marker</code>) draw the controls with <strong>zero JavaScript</strong>. The CSS adapter of the chosen set gives you the SVGs of <code>chevron-left</code> and <code>chevron-right</code>, without replacing them with typographic glyphs. Today it works in Chrome/Edge; In the rest it degrades to a scroller with native snap (without arrows or dots, but it slides the same). When the enhancer mounts, this layer is turned off so as not to duplicate.
  </p>
  <ComponentPreview html={nativeHtml} label="No JS (native CSS)" note="set icons + native scroll buttons" />
  <CodeBlock code={nativeCss} label="the base without JS" lang="css" />

  <h2>Snap-to-index and events</h2>
  <p>
    Programmatic control is a pair of events at the root: it sends <code>sk-carousel-goto</code> to pin to a page and listens to <code>sk-carousel-change</code> to find out which one is active. In React, the <code>ref</code> of the <code>&lt;Carousel&gt;</code> exposes <code>snapTo(index)</code>, which sends that same event.
  </p>
  <CodeBlock code={api} label="JS" lang="ts" />

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" />
  <CodeBlock code={bootstrap} label="JavaScript" lang="ts" />

  <h2>Contract</h2>
  <ul>
    <li>
      Root: <code>&lt;section class="sk-carousel" data-sk-carousel&gt;</code> with a hint <code>&lt;div class="sk-carousel__track"&gt;</code> of <code>&lt;div class="sk-carousel__slide"&gt;</code>.
            Not a list: the machine gives each slide <code>role="group"</code>, which takes it out of
            the list and would leave a list with no list items.
    </li>
    <li>
      Slides: any content. <code>--sk-carousel-slide-size</code> sets the width (peek or multi-up)
      and it is the <strong>only</strong> size knob: it is the same with and without JS, because the machine measures
      the track instead of imposing widths on it.
    </li>
    <li>
      Options in root: <code>data-controls="none"</code>, <code>data-loop</code>, <code>data-autoplay</code> (empty or ms), <code>data-orientation="vertical"</code>.
    </li>
    <li>
      Mouse drag: <strong>on</strong>. <code>data-mouse-drag="off"</code> turns it off, for slides whose text must be selectable.
    </li>
    <li>
      Snap: Each slide is a stop, with <code>scroll-snap-stop: always</code>, so swiping never skips one. The reachable <em>stops</em> are clipped against the end of the scroll, so the last slides can share the last one.
    </li>
    <li>
      Controls: the enhancer draws them, one per measured page; At one end the button is disabled. Prev/next respect the touch floor. The dots look compact; The clickable area grows in bulk without widening the layout or overlapping. Without JS, the native pseudo-elements act as a baseline (Chrome/Edge) and the <code>@skryensya/icons-*/carousel.css</code> adapter provides them with the same stable chevron roles that the enhancer uses.
    </li>
    <li>
      Keyboard: With focus on the track, <kbd class="sk-kbd">←</kbd>/<kbd class="sk-kbd">→</kbd> move one page and <kbd class="sk-kbd">Home</kbd>/<kbd class="sk-kbd">Fin</kbd> jump to the extremes; The same keys work with focus on dots.
    </li>
    <li>
      API: <code>sk-carousel-goto</code> (command) and <code>sk-carousel-change</code> (output, with <code>{"{ index, count }"}</code>); in React, <code>ref.snapTo(index)</code>.
    </li>
    <li>Reduced Motion: Smooth scrolling is turned off with <code>prefers-reduced-motion</code>.</li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "components/carousel.css",
        probe: "sk-carousel",
      },
    ]}
  />
</Base>
