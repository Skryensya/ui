const eventsJs = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// The placeholders <span data-sk-icon="…"> replaces mountIcons with the <svg> of the
// boundset; the set is always explicit, initComponents does not choose it.
mountIcons(document, lucideIcons);
await initComponents();

// The state is read by event on the root, not by callback: the same Zag machine
// that uses React, exposed as a CustomEvent.
const root = document.querySelector("[data-sk-tree-view]");
const log = document.querySelector("[data-sk-tree-log]");

root.addEventListener("sk-selection-change", (event) => {
  const [value] = event.detail.selectedValue;
  log.textContent = value ? \`Seleccionado: \${value}\` : "No selection";
});

root.addEventListener("sk-expanded-change", (event) => {
  console.log(event.detail.expandedValue);
});`;

const previewScript = `const root = document.querySelector("[data-sk-tree-view]");
const log = document.querySelector("[data-sk-tree-log]");
root.addEventListener("sk-selection-change", (event) => {
  const [value] = event.detail.selectedValue;
  log.textContent = value ? "Seleccionado: " + value : "No selection";
});`;

const react = `import { Icon } from "@skryensya/react/icon";
import { TreeView } from "@skryensya/react/tree-view";

const nodes = [
  {
    id: "cuenta",
    label: "Account",
    children: [
      { id: "perfil", label: "Profile" },
      {
        id: "seguridad",
        label: "Seguridad",
        children: [
          { id: "sesiones", label: "Sesiones" },
          { id: "claves", label: "Claves", disabled: true },
        ],
      },
    ],
  },
  { id: "facturacion", label: "Billing" },
];

// branchIndicator and leafIndicator are ONE for the entire tree; one icon per node
// It is authored in the markup (vanilla) or put on the label.
<TreeView
  label="Settings"
  nodes={nodes}
  selectionMode="multiple"
  defaultExpandedValue={["cuenta", "seguridad"]}
  defaultSelectedValue={["perfil"]}
  branchIndicator={<Icon name="chevron-right" />}
  onSelectionChange={({ selectedValue }) => {
    console.log(selectedValue);
  }}
/>`;

const install = `@import "@skryensya/core/components/tree-view.css";`;

const indentHook = `.sk-tree-view {
  /* A wider level, and without the vertical guides. */
  --sk-tree-indent: var(--space-inset-xl);
  --sk-tree-guide-color: transparent;
}`;
---

<Base
  title="TreeView"
  description="Expandable hierarchies with single or multiple selection."
>
  <h1>TreeView</h1>
  <p class="lede">
    A hierarchy that is traversed with the keyboard: branches are opened and closed, nodes are selected. Use TreeView when the parent-child relationship <em>is</em> the content: files, categories, an organization. For sister disclosures without hierarchy use <a href="/en/components/accordion">Accordion</a>; to navigate sections, <a href="/en/components/sidebar">Sidebar</a>.
  </p>

  <h2>Minimum tree</h2>
  <p>
    The minimum is the complete anatomy and nothing more: a root, the list, and for each node a branch (<code>branch</code> + <code>branch-control</code> + <code>branch-content</code>) or a leaf (<code>item</code>). Without state attributes, everything starts closed and without selection.
  </p>
  <ComponentPreview html={minimal} label="Minimal TreeView" />

  <h2>Initial State</h2>
  <p>
    <code>data-expanded-value</code> and <code>data-selected-value</code> list the <code>data-value</code>s that boot open and selected. They accept spaces or commas as a separator, and are only the initial <em>state</em>: the machine commands from there.
  </p>
  <ComponentPreview html={initialState} label="Open and selected input" />

  <h2>Multiple selection</h2>
  <p>
    <code>data-selection-mode="multiple"</code> lets mark several nodes with
    <kbd class="sk-kbd">Ctrl</kbd>/<kbd class="sk-kbd">⌘</kbd> and extend the range with
    <kbd class="sk-kbd">Shift</kbd>. Branches nest without limit: a branch is a node with
    <code>branch-content</code>, regardless of depth, and the vertical guide shows which parent each level belongs to.
  </p>
  <ComponentPreview html={multiple} label="Multiple selection and three levels" />

  <h2>Disabled nodes</h2>
  <p>
    A node with <code>disabled</code> is not selected or given focus, but is still read. A disabled branch also will not open, so do not use it to hide content: do not author it for that.
  </p>
  <ComponentPreview html={disabled} label="Disabled node" />

  <h2>Icons and events</h2>
  <p>
    The sheet reserves the same column as the branch's chevron, so the labels of a level are aligned even if not all sheets have an icon. That gap is the empty <code>&lt;span aria-hidden="true"&gt;</code> from the previous examples; here it has an icon. The selection and opening are heard as events above the root.
  </p>
  <ComponentPreview
    html={events}
    js={eventsJs}
    react={react}
    previewScript={previewScript}
    label="Settings with icons"
  >
    <Fragment slot="react">
      <TreeViewSettingsDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Contract</h2>
  <ul>
    <li>
      The root is authored with <code>data-sk-tree-view</code> and <code>class="sk-tree-view"</code>; your <code>aria-label</code> names the tree.
    </li>
    <li>
      The list has <code>data-sk-tree-view-tree</code>. Each direct child is a branch (<code>data-sk-tree-view-branch</code>) or a leaf (<code>data-sk-tree-view-item</code>).
    </li>
    <li>
      A branch contains its control (<code>data-sk-tree-view-branch-control</code>, with indicator and text) and its contents (<code>data-sk-tree-view-branch-content</code>), which is another list of branches and leaves.
    </li>
    <li>
      <code>data-value</code> identifies the node: it is what appears in the events and in <code>data-expanded-value</code> / <code>data-selected-value</code>. It is unique in the entire tree; without it, the enhancer derives an id from the position, which is broken when reordering the markup.
    </li>
    <li>
      Each clickable row has <code>sk-interactive</code>: from there come hover, focus, pressed, selection and the focus ring. The component does not paint states on its own.
    </li>
    <li>
      Events on the root: <code>sk-selection-change</code> with <code>detail.selectedValue</code> and <code>sk-expanded-change</code> with <code>detail.expandedValue</code>, both arrays of <code>data-value</code>.
    </li>
  </ul>

  <h2>Accessibility</h2>
  <p>
    The public machine <code>role="tree"</code>/<code>treeitem</code> with the level and position of each node, and manages the keyboard: arrows to move,
    <kbd class="sk-kbd">→</kbd>/<kbd class="sk-kbd">←</kbd> to open and close branches,
    <kbd class="sk-kbd">Home</kbd>/<kbd class="sk-kbd">End</kbd> and typeahead by letter. The focus is roving: the entire tree is a single tab stop, not one per node.
  </p>

  <h2>CSS</h2>
  <CodeBlock code={install} label="CSS" lang="css" />
  <p>
    Indentation and vertical guide are hooks: change the indentation step or turn off the guide without touching the rest.
  </p>
  <CodeBlock code={indentHook} label="CSS" lang="css" />
  <StylingHooks
    groups={[
      {
        file: "components/tree-view.css",
        probe: "sk-tree-view",
        title: "TreeView",
      },
      {
        file: "patterns/state-layer.css",
        probe: "sk-interactive",
        title: "Inherited from State layer",
      },
    ]}
  />
</Base>
