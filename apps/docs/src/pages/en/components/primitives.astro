---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import { primitivesTree } from "../../../demos/layout";
import { getLocale, useTranslations } from "../../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
---

<Base title="Primitivas" description="Layout and typography primitives: reusable structure, reading roles and React adapters.">
  <h1>Primitives</h1>
  <p class="lede">
    Box, Wrapper, ImageFrame, Stack, Inline and Grid are layout patterns. Text, Heading and Link express the reading role; They do not replace semantics: you choose the element that corresponds to the content.
  </p>

  <ComponentPreview tree={primitivesTree(t, "/en/components/primitives")} label="Primitivas" />

  <h2>Authored HTML</h2>
  <p>
    Imports <code>patterns/layout.css</code> for Box, Wrapper, ImageFrame, Stack, Inline, and Grid, and <code>components/typography.css</code> for Text, Heading, and Link. They do not require vanilla initialization.
  </p>
  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />


  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of the preview.</p>

  <h2>Contracts</h2>
  <ul>
    <li><code>Box</code> controls surface, edge and padding; the consumer chooses <code>as</code>.</li>
    <li><code>Wrapper</code> sets the page column ceiling to a scale (<code>sm</code>, <code>md</code>, <code>lg</code>, <code>full</code>).</li>
    <li><code>ImageFrame</code> crop media to an aspect ratio and control <code>object-fit</code> / position.</li>
    <li><code>Stack</code>, <code>Inline</code> and <code>Grid</code> have named gaps that follow the density dimension.</li>
    <li><code>Heading</code> separates hierarchy (<code>as</code>) from visual size (<code>size</code>).</li>
    <li><code>Link</code> underlines by default: it does not depend only on color to be recognized.</li>
  </ul>
</Base>
