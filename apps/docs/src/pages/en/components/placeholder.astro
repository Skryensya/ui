---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import { PublicationDemo, PublicationPlaceholderDemo } from "../../../components/react-demos/placeholder";
import "../../../examples/placeholder.css";

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/placeholder.css";
@import "@skryensya/core/patterns/layout.css";
@import "@skryensya/core/components/badge.css";
@import "@skryensya/core/components/avatar.css";
@import "@skryensya/core/components/typography.css";`;

const mediaSrc = "/demos/media-gradient.svg";

const placeholderLayoutHtml = `<div
  class="sk-box"
  data-surface="surface"
  data-border="subtle"
  data-padding="lg"
>
  <div class="sk-stack" data-gap="md">
    <div
      class="sk-image-frame"
      data-aspect="16/9"
      data-radius="control"
      data-border="subtle"
    >
      <span
        class="sk-placeholder sk-image-frame__media placeholder-example__media"
        data-shape="block"
        aria-hidden="true"
      ></span>
    </div>
    <div class="sk-stack" data-gap="sm">
      <span
        class="sk-placeholder placeholder-example__line--eyebrow"
        data-shape="text"
        aria-hidden="true"
      ></span>
      <div class="sk-stack" data-gap="xs">
        <span
          class="sk-placeholder placeholder-example__line--title"
          data-shape="text"
          aria-hidden="true"
        ></span>
        <span
          class="sk-placeholder placeholder-example__line--title-short"
          data-shape="text"
          aria-hidden="true"
        ></span>
      </div>
      <div class="sk-stack" data-gap="xs">
        <span
          class="sk-placeholder placeholder-example__line--body"
          data-shape="text"
          aria-hidden="true"
        ></span>
        <span
          class="sk-placeholder placeholder-example__line--body-short"
          data-shape="text"
          aria-hidden="true"
        ></span>
      </div>
      <div
        class="sk-inline"
        data-gap="sm"
        data-align="center"
      >
        <span
          class="sk-placeholder placeholder-example__avatar"
          data-shape="circle"
          aria-hidden="true"
        ></span>
        <span class="sk-stack placeholder-example__byline-copy" data-gap="xs">
          <span
            class="sk-placeholder"
            data-shape="text"
            aria-hidden="true"
          ></span>
          <span
            class="sk-placeholder"
            data-shape="text"
            aria-hidden="true"
          ></span>
        </span>
      </div>
    </div>
  </div>
</div>`;

const staticHtml = `<div class="placeholder-example" aria-busy="true">
  <p
    class="sk-text"
    data-size="sm"
    data-tone="secondary"
    role="status"
  >
    Loading publication…
  </p>
  ${placeholderLayoutHtml}
</div>`;

const staticReact = `import { Placeholder } from "@skryensya/react/placeholder";
import { ImageFrame } from "@skryensya/react/image-frame";
import { Box, Inline, Stack } from "@skryensya/react/layout";
import { Text } from "@skryensya/react/text";

function PublicationPlaceholder() {
  return (
    <Box border="subtle" padding="lg" surface="surface">
      <Stack gap="md">
        <ImageFrame
          aspect="16/9"
          border="subtle"
          radius="control"
        >
          <Placeholder
            className="sk-image-frame__media placeholder-example__media"
            shape="block"
          />
        </ImageFrame>
        <Stack gap="sm">
          <Placeholder className="placeholder-example__line--eyebrow" />
          <Stack gap="xs">
            <Placeholder className="placeholder-example__line--title" />
            <Placeholder className="placeholder-example__line--title-short" />
          </Stack>
          <Stack gap="xs">
            <Placeholder className="placeholder-example__line--body" />
            <Placeholder className="placeholder-example__line--body-short" />
          </Stack>
          <Inline align="center" gap="sm">
            <Placeholder
              className="placeholder-example__avatar"
              shape="circle"
            />
            <Stack
              className="placeholder-example__byline-copy"
              gap="xs"
            >
              <Placeholder />
              <Placeholder />
            </Stack>
          </Inline>
        </Stack>
      </Stack>
    </Box>
  );
}

export function PublicationPlaceholderDemo() {
  return (
    <div className="placeholder-example" aria-busy="true">
      <Text as="p" role="status" size="sm" tone="secondary">
        Loading post…
      </Text>
      <PublicationPlaceholder />
    </div>
  );
}`;

const loadedLayoutHtml = `<article
  class="sk-box"
  data-surface="surface"
  data-border="subtle"
  data-padding="lg"
  aria-labelledby="publication-title"
>
  <div class="sk-stack" data-gap="md">
    <div
      class="sk-image-frame"
      data-aspect="16/9"
      data-fit="cover"
      data-radius="control"
      data-border="subtle"
    >
      <img
        class="sk-image-frame__media"
        src="${mediaSrc}"
        alt=""
      />
    </div>
    <div class="sk-stack" data-gap="sm">
      <span class="sk-badge" data-tone="accent">
        Research
      </span>
      <div class="sk-stack" data-gap="xs">
        <h3
          class="sk-heading"
          data-size="h3"
          id="publication-title"
        >
          When a route stops being linear
        </h3>
        <p class="sk-text" data-tone="secondary">
          Twelve interviews show where context is lost and what signs help to recover it.
        </p>
      </div>
      <div
        class="sk-inline"
        data-gap="sm"
        data-align="center"
      >
        <span
          class="sk-avatar"
          role="img"
          aria-label="Rocio Mora"
        >
          <span
            class="sk-avatar__fallback"
            aria-hidden="true"
          >RM</span>
        </span>
        <span class="sk-stack" data-gap="none">
          <span
            class="sk-text"
            data-size="sm"
            data-weight="label"
          >Rocio Mora</span>
          <span
            class="sk-text"
            data-size="caption"
            data-tone="tertiary"
          >8 min read · updated today</span>
        </span>
      </div>
    </div>
  </div>
</article>`;

const loadingHtml = `<section
  class="placeholder-example"
  data-placeholder-demo
  aria-busy="true"
>
  <p
    class="sk-text"
    data-size="sm"
    data-tone="secondary"
    data-placeholder-status
    role="status"
    aria-live="polite"
  >
    Loading publication…
  </p>
  <div
    class="placeholder-example__swap"
    data-placeholder-swap
    data-state="loading"
  >
    <div data-placeholder-loading aria-hidden="false">
      ${placeholderLayoutHtml}
    </div>
    <div data-placeholder-content aria-hidden="true">
      ${loadedLayoutHtml}
    </div>
  </div>
</section>`;

const loadingJs = `const demo = document.querySelector(
  "[data-placeholder-demo]",
);

if (demo instanceof HTMLElement) {
  const loading = demo.querySelector(
    "[data-placeholder-loading]",
  );
  const content = demo.querySelector(
    "[data-placeholder-content]",
  );
  const swap = demo.querySelector(
    "[data-placeholder-swap]",
  );
  const status = demo.querySelector(
    "[data-placeholder-status]",
  );

  window.setTimeout(() => {
    demo.setAttribute("aria-busy", "false");
    swap?.setAttribute("data-state", "loaded");
    loading?.setAttribute("aria-hidden", "true");
    content?.setAttribute("aria-hidden", "false");
    if (status) status.textContent = "Post loaded.";
  }, 5000);
}`;

const loadingReact = `import { useEffect, useState } from "react";
import { Avatar } from "@skryensya/react/avatar";
import { Badge } from "@skryensya/react/badge";
import { Heading } from "@skryensya/react/heading";
import { ImageFrame } from "@skryensya/react/image-frame";
import { Box, Inline, Stack } from "@skryensya/react/layout";
import { Placeholder } from "@skryensya/react/placeholder";
import { Text } from "@skryensya/react/text";

function PublicationPlaceholder() {
  return (
    <Box border="subtle" padding="lg" surface="surface">
      <Stack gap="md">
        <ImageFrame
          aspect="16/9"
          border="subtle"
          radius="control"
        >
          <Placeholder
            className="sk-image-frame__media placeholder-example__media"
            shape="block"
          />
        </ImageFrame>
        <Stack gap="sm">
          <Placeholder className="placeholder-example__line--eyebrow" />
          <Stack gap="xs">
            <Placeholder className="placeholder-example__line--title" />
            <Placeholder className="placeholder-example__line--title-short" />
          </Stack>
          <Stack gap="xs">
            <Placeholder className="placeholder-example__line--body" />
            <Placeholder className="placeholder-example__line--body-short" />
          </Stack>
          <Inline align="center" gap="sm">
            <Placeholder
              className="placeholder-example__avatar"
              shape="circle"
            />
            <Stack
              className="placeholder-example__byline-copy"
              gap="xs"
            >
              <Placeholder />
              <Placeholder />
            </Stack>
          </Inline>
        </Stack>
      </Stack>
    </Box>
  );
}

function Publication() {
  return (
    <Box
      as="article"
      aria-labelledby="publication-title"
      border="subtle"
      padding="lg"
      surface="surface"
    >
      <Stack gap="md">
        <ImageFrame
          aspect="16/9"
          border="subtle"
          fit="cover"
          radius="control"
        >
          <img
            alt=""
            className="sk-image-frame__media"
            src="${mediaSrc}"
          />
        </ImageFrame>
        <Stack gap="sm">
          <Badge tone="accent">Research</Badge>
          <Stack gap="xs">
            <Heading as="h3" id="publication-title" size="h3">
              When a route stops being linear
            </Heading>
            <Text tone="secondary">
              Twelve interviews show where context is lost and what signs help to recover it.
            </Text>
          </Stack>
          <Inline align="center" gap="sm">
            <Avatar name="Rocio Mora">RM</Avatar>
            <Stack gap="none">
              <Text as="span" size="sm" weight="label">
                Rocio Mora
              </Text>
              <Text as="span" size="caption" tone="tertiary">
                8 min read · updated today
              </Text>
            </Stack>
          </Inline>
        </Stack>
      </Stack>
    </Box>
  );
}

export function PublicationDemo() {
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const timer = window.setTimeout(
      () => setLoading(false),
      5000,
    );
    return () => window.clearTimeout(timer);
  }, []);

  return (
    <section
      aria-busy={loading}
      className="placeholder-example"
    >
      <Text
        as="p"
        aria-live="polite"
        role="status"
        size="sm"
        tone="secondary"
      >
        {loading
          ? "Loading post…"
          : "Post loaded."}
      </Text>
      <div
        className="placeholder-example__swap"
        data-state={loading ? "loading" : "loaded"}
      >
        <div aria-hidden={!loading} data-placeholder-loading>
          <PublicationPlaceholder />
        </div>
        <div aria-hidden={loading} data-placeholder-content>
          <Publication />
        </div>
      </div>
    </section>
  );
}`;
---

<Base
  title="Placeholder"
  description="Placeholder: Decorative geometry to reserve the place of content while loading."
>
  <h1>Placeholder</h1>
  <p class="lede">
    Placeholder reserves the form of content that has not yet arrived. Reduces layout breaks and offers a brief visual cue; The container retains the responsibility of explaining what it is loading.
  </p>

  <div class="sk-alert" data-tone="info" data-presentation="accent">
    <div class="sk-alert__content">
      <div class="sk-alert__description">
        Placeholder is always decorative. Use <code>aria-busy="true"</code> and a status message in the region waiting for the data.
      </div>
    </div>
  </div>

  <h2>Pending layout</h2>
  <p>
    The geometry follows the final layout: a card from the kit (<code>Box</code> + <code>Stack</code>) with media, text and byline. This first example always remains loaded so that the Placeholder can be inspected.
  </p>
  <ComponentPreview
    html={staticHtml}
    react={staticReact}
    label="Layout with Placeholder"
    note="Always pending"
  >
    <Fragment slot="react">
      <PublicationPlaceholderDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Simulated loading</h2>
  <p>
    The second example waits <strong>5 seconds</strong>, removes the temporary layout and displays the actual content in the same space: <code>ImageFrame</code>, <code>Badge</code>, <code>Heading</code>, <code>Text</code> and <code>Avatar</code>.
  </p>
  <ComponentPreview
    html={loadingHtml}
    js={loadingJs}
    previewScript={loadingJs}
    react={loadingReact}
    label="Placeholder → content"
    note="Simulated load · 5 s"
  >
    <Fragment slot="react">
      <PublicationDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Shapes</h2>
  <ul>
    <li><code>text</code>: one line; is the default value.</li>
    <li><code>block</code>: media, tables, or rectangular regions.</li>
    <li><code>circle</code>: avatars and circular controls.</li>
  </ul>
  <p>
    Sets <code>--sk-placeholder-inline-size</code>, <code>--sk-placeholder-block-size</code> or <code>--sk-placeholder-size</code> from the consumer layout. The form does not know the content.
  </p>

  <h2>Reduced motion</h2>
  <p>
    Brightness scrolls with <code>transform</code>. With <code>prefers-reduced-motion: reduce</code>, the animation disappears and the static fill remains.
  </p>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" lang="css" />

  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of each preview.</p>

  <StylingHooks groups={[{ file: "components/placeholder.css", probe: "sk-placeholder" }]} />
</Base>
