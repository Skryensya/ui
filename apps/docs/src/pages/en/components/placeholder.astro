---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import ComponentPreview from "../../../components/ComponentPreview.astro";
import StylingHooks from "../../../components/StylingHooks.astro";
import { publicationPlaceholderTree, publicationSwapScript, publicationSwapTree } from "../../../demos/placeholder";
import { getLocale, useTranslations } from "../../../i18n";
// The CSS block below documents this import; the page never actually made it. Without the base
// `.sk-placeholder` rule nothing sets `block-size`, so every text-shaped line measured 0px and the
// skeleton painted only its media block — the one thing this page exists to show.
import "@skryensya/core/components/placeholder.css";
import "../../../examples/placeholder.css";

const install = `pnpm add @skryensya/core @skryensya/react`;

const t = useTranslations(getLocale(Astro.url));
const swapScript = publicationSwapScript(t);
const styles = `@import "@skryensya/core/components/placeholder.css";
@import "@skryensya/core/patterns/layout.css";
@import "@skryensya/core/components/badge.css";
@import "@skryensya/core/components/avatar.css";
@import "@skryensya/core/components/typography.css";`;


---

<Base
  title="Placeholder"
  description="Placeholder: Decorative geometry to reserve the place of content while loading."
>
  <h1>Placeholder</h1>
  <p class="lede">
    Placeholder reserves the form of content that has not yet arrived. Reduces layout breaks and offers a brief visual cue; The container retains the responsibility of explaining what it is loading.
  </p>

  <div class="sk-alert" data-tone="info" data-presentation="accent">
    <div class="sk-alert__content">
      <div class="sk-alert__description">
        Placeholder is always decorative. Use <code>aria-busy="true"</code> and a status message in the region waiting for the data.
      </div>
    </div>
  </div>

  <h2>Pending layout</h2>
  <p>
    The geometry follows the final layout: a card from the kit (<code>Box</code> + <code>Stack</code>) with media, text and byline. This first example always remains loaded so that the Placeholder can be inspected.
  </p>
  <ComponentPreview tree={publicationPlaceholderTree(t)} label="Layout with Placeholder" note="Always pending" />

  <h2>Simulated loading</h2>
  <p>
    The second example waits <strong>5 seconds</strong>, removes the temporary layout and displays the actual content in the same space: <code>ImageFrame</code>, <code>Badge</code>, <code>Heading</code>, <code>Text</code> and <code>Avatar</code>.
  </p>
  <ComponentPreview
    tree={publicationSwapTree(t)}
    js={swapScript}
    previewScript={swapScript}
    label="Placeholder → content"
    note="Simulated load · 5 s"
  />

  <h2>Shapes</h2>
  <ul>
    <li><code>text</code>: one line; is the default value.</li>
    <li><code>block</code>: media, tables, or rectangular regions.</li>
    <li><code>circle</code>: avatars and circular controls.</li>
  </ul>
  <p>
    Sets <code>--sk-placeholder-inline-size</code>, <code>--sk-placeholder-block-size</code> or <code>--sk-placeholder-size</code> from the consumer layout. The form does not know the content.
  </p>

  <h2>Reduced motion</h2>
  <p>
    Brightness scrolls with <code>transform</code>. With <code>prefers-reduced-motion: reduce</code>, the animation disappears and the static fill remains.
  </p>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" lang="css" />

  <h2>React</h2>
  <p>The code is in the <strong>React</strong> tab of each preview.</p>

  <StylingHooks groups={[{ file: "components/placeholder.css", probe: "sk-placeholder" }]} />
</Base>
