---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import Showcase from "../../../components/Showcase.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;

/*
 * The demo, as a USAGE TREE. The markup below the stage, the TSX beside it and the live React
 * island are all emitted from this, so the snippet a reader copies is what they just saw render.
 */
const tree = {
  contract: "layout",
  signature: "Inline",
  options: { gap: "md" },
  children: [
    {
      contract: "theme-toggle",
      signature: "ThemeToggle",
      options: { labelSystem: "Mode: system", labelLight: "Mode: light", labelDark: "Mode: dark" },
    },
    {
      contract: "theme-toggle",
      signature: "ThemeToggle",
      options: { size: "sm", labelSystem: "Mode: system", labelLight: "Mode: light", labelDark: "Mode: dark" },
    },
  ],
} as const satisfies UsageTree;

const css = `@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/theme-toggle.css";`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
await initComponents();

// Persistence (optional): the enhancer applies the mode,
// the app stores the preference. The preference itself is
// already declared, see /en/storage.
import { setPreference } from "@skryensya/vanilla/storage";
import { colorModePreference } from "@skryensya/core/theme-toggle";

document.addEventListener("sk-theme-toggle-change", (event) => {
  setPreference(colorModePreference, event.detail.value);
});`;

---

<Base
  title="Theme Toggle"
  description="Theme Toggle: Cycle the color system → light → dark mode and re-theme with color-scheme."
>
  <h1>Theme Toggle</h1>
  <p class="lede">
    Theme Toggle cycles the <strong>color mode</strong> (system → light → dark → system). It is a ghost icon-only Button with three stacked faces; when clicked it writes <code>data-scheme</code> and <code>color-scheme</code> to <code>&lt;html&gt;</code> for <code>light-dark()</code> to re-theme. The size is that of the Button: <strong>md</strong> (default) or <code>data-size="sm"</code> / <code>size="sm"</code>. The persistence is provided by the app.
  </p>

  <Showcase tree={tree} js={js} label="Theme Toggle" note="md · sm" />

  <h2>Contract</h2>
  <ul>
    <li>
      The faces use the stable roles <code>mode-system</code>, <code>mode-light</code>, and <code>mode-dark</code>, marked <code>data-sk-theme-toggle-icon</code>.
    </li>
    <li>
      The enhancer applies the mode to <code>document.documentElement</code> and triggers <code>sk-theme-toggle-change</code> with <code>detail.value</code>.
    </li>
    <li>
      A FOUC script in the <code>&lt;head&gt;</code> you must read the saved preference and paint
      <code>data-scheme</code> / <code>color-scheme</code> before the first paint (see
      <a href="/en/first-component">First component</a>).
    </li>
  </ul>

  <h2>Install</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>CSS</h2>
  <CodeBlock code={css} label="CSS" lang="css" />
</Base>
