---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const imports = `/* Base: ramps, escala, semánticos y state layer. */
@import "@skryensya/core/tokens.scss";

/* Opt-in: import only the components you ship. */
@import "@skryensya/core/components/button.css";`;

const usageTree: UsageTree = {
  contract: "layout",
  signature: "Inline",
  children: [
    {
      contract: "button",
      signature: "Button.action",
      options: { tone: "accent" },
      children: "Guardar",
    },
    {
      contract: "button",
      signature: "Button.action",
      children: "Cancelar",
    },
    {
      contract: "button",
      signature: "Button.action",
      options: { tone: "danger" },
      children: "Borrar",
    },
  ],
};
---

<Base
  title="Instalación"
  description="Tokens Sass y componentes: core compartido, vanilla progressive enhancement y React."
  documentLayout="grid"
>
  <h1>skryensya/ui</h1>
  <p class="lede">
    Tokens Sass que compilan a CSS runtime y componentes. Los tokens siguen usando custom properties,
    cascade layers y funciones nativas; los componentes añaden comportamiento cuando la plataforma no lo trae.
    Si esos términos no te suenan, empieza por los <a href="/prerequisites">prerrequisitos</a>.
  </p>

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>Importar</h2>
  <p>
    Los especificadores desnudos se resuelven por el <code>exports</code> map del paquete, así que
    necesitas un bundler (Vite, webpack, Parcel). Este sitio se construye exactamente así.
  </p>
  <CodeBlock code={imports} label="CSS" />

  <h2>Usar</h2>
  <p>
    Para componentes estáticos alcanza con la clase: el CSS trae la estructura y sus styling hooks.
    Para componentes con máquina, <code>@skryensya/vanilla</code> hidrata el HTML escrito a mano y
    <code>@skryensya/react</code> renderiza el mismo contrato.
  </p>

  <ComponentPreview tree={usageTree} label="Button" />

  <h2>Componentes con comportamiento</h2>
  <p>
    Tabs ya está montado en el sitio como slice vertical completo: <a href="/components/tabs">ver el
    componente</a>.
  </p>

  <h2>Pruébalo en vivo</h2>
  <p>
    Los controles de arriba cambian el modo, la paleta de color y el contraste. Las ramps se configuran
    una vez desde <code>:root</code>, sin combinaciones ni selectores de marca en disco. Cámbialos y mira
    los botones. Después mira la <a class="sk-link sk-interactive" href="/reference">referencia de
    tokens</a>, donde cada valor resuelto se relee en vivo.
  </p>
</Base>
