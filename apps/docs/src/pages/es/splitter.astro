---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import { sidebarResizableTree } from "../../demos/sidebar";
import { getLocale, useTranslations } from "../../i18n";

import "@skryensya/core/components/tree-view.css";

const t = useTranslations(getLocale(Astro.url));

const import_ = `@import "@skryensya/core/patterns/splitter.css";`;

/*
 * Escritos a mano, no sacados del corpus de lib/tokens.ts: `--sk-splitter-*` se declara aquí, en
 * patterns/splitter.css, Y se vuelve a declarar como override adentro de components/sidebar.css (el
 * hook propio de su handle de resize). El corpus deduplica por nombre, gana el primer archivo, y
 * `components/` ordena antes que `patterns/`: así que los cuatro se atribuirían a sidebar.css, y la
 * sonda de Used.astro los leería de un `.sk-sidebar` pelado, no de `.sk-splitter`. Archivo
 * equivocado, valor equivocado.
 */
const hooks = [
  ["--sk-splitter-hit", "var(--space-inset-sm)", "Ancho de la zona de agarre; el hairline vive adentro, más angosto."],
  ["--sk-splitter-line", "2px", "Grosor del hairline visible."],
  ["--sk-splitter-color", "var(--color-border-strong)", "Color del hairline en hover."],
  ["--sk-splitter-active-color", "var(--color-border-accent)", "Color del hairline en foco o durante el arrastre."],
] as const;

const handleHtml = `<!-- Sidebar: acota UN valor contra un límite fijo -->
<div
  class="sk-sidebar__resize-handle sk-splitter"
  role="separator"
  aria-orientation="vertical"
  aria-label="Redimensionar panel"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="38"
  tabindex="0"
></div>`;

const columnHtml = `<!-- Table y Treegrid: redistribuyen entre un PAR de columnas vecinas -->
<th>
  Nombre
  <div
    class="sk-table__column-resizer sk-splitter"
    role="separator"
    aria-orientation="vertical"
    aria-label="Redimensionar columna Nombre"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="52"
    tabindex="0"
  ></div>
</th>`;

const keyboard = [
  ["←", "Un paso (16px por defecto) hacia el borde de inicio."],
  ["→", "Un paso hacia el borde de fin."],
  ["Shift + ←/→", "Paso grueso (64px por defecto): la misma tecla, cuatro veces más lejos."],
  ["Home", "Salta al mínimo de su recorrido."],
  ["End", "Salta al máximo de su recorrido."],
  ["Enter", "Vuelve al valor por defecto. Por convención, el doble clic hace lo mismo."],
];
---

<Base
  title="Splitter"
  documentLayout="grid"
  description="El handle de arrastre compartido: role=separator, un modelo de valor por consumidor, la misma franja visual en Sidebar, Table y Treegrid."
>
  <h1>Splitter</h1>
  <p class="lede">
    El patrón <strong>Window Splitter</strong> de WAI-ARIA: una franja fina, arrastrable con puntero
    o teclado, que redimensiona lo que tiene al lado. <code>Sidebar</code> la usa para el ancho de su
    panel; <code>Table</code> y <code>Treegrid</code> la usan entre cada par de columnas. Los tres
    comparten una sola primitiva: <code>@skryensya/core/splitter.ts</code> para el comportamiento,
    <code>.sk-splitter</code> para la franja visual, en vez de reimplementar el arrastre y el manejo
    de teclado cada vez.
  </p>

  <h2>Una primitiva, dos modelos de valor</h2>
  <p>
    Los dos son "un splitter", pero mueven cantidades distintas. La primitiva no se entera de cuál:
    lo único que devuelve es un <code>delta</code> (o una intención <code>home</code>/<code>end</code>/
    <code>reset</code>) y le deja el "qué significa moverlo" a quien la consume.
  </p>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Consumidor</th>
          <th class="sk-table__header">Qué mueve</th>
          <th class="sk-table__header">Aritmética</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row">
          <td class="sk-table__cell"><strong>Sidebar</strong></td>
          <td class="sk-table__cell">Un valor contra un límite fijo</td>
          <td class="sk-table__cell">
            Un <code>clamp()</code> de CSS: no hay "otro panel" con el que conservar un ancho total.
          </td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><strong>Table / Treegrid</strong></td>
          <td class="sk-table__cell">Un par de columnas vecinas</td>
          <td class="sk-table__cell">
            <code>resolveColumnResize</code>: el ancho combinado del par queda fijo, así que ninguna
            otra columna se mueve.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Marcar el separator</h2>
  <p>
    <code>.sk-splitter</code> solo dibuja la franja: tamaño, posición, cursor y color en
    hover/foco/arrastre. No sabe qué está redimensionando. El bloque contenedor lo pone el consumidor
    (Sidebar la flota contra el borde del panel; Treegrid pone una adentro de cada <code>th</code>), y
    el binding del propio consumidor escribe <code>data-dragging</code> mientras dura el gesto, el
    único estado que lee este archivo.
  </p>
  <CodeBlock code={handleHtml} label="HTML · Sidebar" note="un valor, clamp de CSS" />
  <CodeBlock code={columnHtml} label="HTML · Table / Treegrid" note="par de columnas vecinas" />

  <h2>En vivo</h2>
  <p>
    El mismo demo que <a href="/es/componentes/sidebar">Sidebar</a>: arrastra el borde del panel con el
    puntero, o enfócalo y usa las flechas.
  </p>
  <ComponentPreview
    tree={sidebarResizableTree(t)}
    label={t("sidebarPage.resizableLabel")}
    flush
  />

  <h2>Teclado</h2>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Tecla</th>
          <th class="sk-table__header">Acción</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        {
          keyboard.map(([key, action]) => (
            <tr class="sk-table__row">
              <td class="sk-table__cell mono">{key}</td>
              <td class="sk-table__cell">{action}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Accesibilidad</h2>
  <ul>
    <li>
      <code>role="separator"</code> más <code>aria-orientation</code> lo identifican como el patrón
      Window Splitter, no como un <code>slider</code> ni un <code>scrollbar</code>.
    </li>
    <li>
      <code>aria-valuemin</code>/<code>aria-valuemax</code>/<code>aria-valuenow</code> reportan la
      posición como porcentaje de su propio recorrido (<code>splitterValuePercent</code>), nunca como
      una cuenta cruda de píxeles: un lector de pantalla no aprende nada de un número sin un rango que
      lo enmarque.
    </li>
    <li>
      <code>aria-label</code> es obligatorio, no opcional: el separator lo inserta el binding, nunca
      lo escribe el consumidor, así que no hay nada más que lo nombre para un lector de pantalla. El
      gate de accesibilidad del contrato (<code>resizeLabel</code> en Table y Treegrid) lo exige.
    </li>
    <li>
      El anillo de foco es <code>inset</code>: un handle pegado al borde de su contenedor tendría el
      outline dibujado por fuera, recortado por el <code>overflow: hidden</code> de ese mismo
      contenedor (el caso de Sidebar). Inset funciona recorte o no recorte el consumidor.
    </li>
    <li>
      Bajo <code>forced-colors</code>, la franja se dibuja con <code>CanvasText</code>: ahí se caen
      tanto la capa de estado como el acento, así que el borde necesita existir como borde real.
    </li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={import_} label="CSS" />

  <h2>Styling hooks</h2>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Hook</th>
          <th class="sk-table__header">Valor por defecto</th>
          <th class="sk-table__header">Qué controla</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        {
          hooks.map(([name, value, note]) => (
            <tr class="sk-table__row">
              <td class="sk-table__cell mono">{name}</td>
              <td class="sk-table__cell mono">{value}</td>
              <td class="sk-table__cell">{note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    Sidebar vuelve a declarar los cuatro contra sus propios <code>--sk-sidebar-resize-*</code> (ver
    <a href="/es/componentes/sidebar">Sidebar</a>), igual que cualquier anfitrión vuelve a declarar el
    hook de un patrón sin tocarle el markup.
  </p>

  <h2>Dónde vive</h2>
  <ul>
    <li><a href="/es/componentes/sidebar">Sidebar</a>: <code>SidebarResizeHandle</code>, un solo valor.</li>
    <li><a href="/es/componentes/table">Table</a>: <code>resizableColumns</code>/<code>resizeLabel</code>, opt-in.</li>
    <li><a href="/es/componentes/treegrid">Treegrid</a>: el mismo par <code>resizableColumns</code>/<code>resizeLabel</code>, más <code>columnWeights</code> para el reparto inicial.</li>
  </ul>
</Base>
