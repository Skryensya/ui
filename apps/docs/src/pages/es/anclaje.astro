---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";

const import_ = `@import "@skryensya/core/patterns/anchored.css";`;

const anatomy = `<!-- ANCHOR: the element everything is measured against. -->
<button class="sk-button sk-interactive sk-anchor" data-sk-anchor-trigger>
  Guardar
</button>

<!-- POSITIONER: placement, with no paint or interaction of its own. -->
<span class="sk-tooltip__positioner sk-anchored" data-sk-placement="block-start">
  <!-- ARROW: opcional y decorativa. -->
  <span class="sk-anchored-arrow" aria-hidden="true"></span>

  <!-- CONTENT: the visible, interactive box. -->
  <span class="sk-tooltip__content" data-sk-anchor-content>
    Se guarda solo cada 30 segundos
  </span>
</span>`;

const sameWidth = `@supports (anchor-name: --a) {
  .sk-select__positioner {
    --sk-anchored-size: anchor-size(width);
  }
}`;

const submenu = `.sk-menu__positioner[data-sk-submenu] {
  --sk-anchored-position-area: inline-end span-block-end;
  --sk-anchored-justify: auto;
  --sk-anchored-align: start;
  --sk-anchored-position-try: flip-inline;
}`;

const arrowReact = `<Tooltip arrow content="Se guarda solo">
  <button className="sk-button sk-interactive">Guardar</button>
</Tooltip>

<Popover arrow trigger="Ver perfil" title="Ada Lovelace">
  Matemática y escritora.
</Popover>`;

const anchorTree: UsageTree = {
  contract: "layout",
  signature: "Inline",
  attrs: { class: "sk-anclaje-demo" },
  children: ["block-start", "block-end", "inline-start", "inline-end"].map((placement) => ({
    contract: "tooltip",
    signature: "Tooltip",
    options: { placement, arrow: true },
    slots: {
      children: {
        contract: "button",
        signature: "Button.action",
        attrs: { class: "sk-tooltip__trigger" },
        children: placement,
      },
      content: "Tooltip",
    },
  })),
};
---

<Base
  title="Anclaje"
  documentLayout="grid"
  description="Pattern compartido para colocar contenido contra un elemento: anchor, positioner, content y arrow."
>
  <h1>Anclaje</h1>
  <p class="lede">
    <strong>Anclaje es un Pattern</strong>: coloca una caja contra un elemento, no contra la
    página. Tooltip, Popover, Popup, Menu, Select, Combobox y DatePicker consumen la misma estructura:
    <strong>anchor</strong>, <strong>positioner</strong>, <strong>content</strong> y
    <strong>arrow</strong> opcional.
  </p>

  <ComponentPreview tree={anchorTree} label="Anclaje" />

  <h2>Consumidores</h2>
  <p>
    El Pattern existe porque varios componentes necesitan el mismo Markup contract geométrico. La
    pintura y la Machine siguen siendo de cada componente; el Pattern solo fija dónde vive la
    colocación.
  </p>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th scope="col" class="sk-table__header">Componente</th>
          <th scope="col" class="sk-table__header">Anchor</th>
          <th scope="col" class="sk-table__header">Arrow</th>
          <th scope="col" class="sk-table__header">Motor</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row">
          <td class="sk-table__cell"><a href="/components/tooltip">Tooltip</a></td>
          <td class="sk-table__cell">trigger</td>
          <td class="sk-table__cell">sí</td>
          <td class="sk-table__cell">navegador + Machine de Zag</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><a href="/components/popover">Popover</a></td>
          <td class="sk-table__cell">trigger</td>
          <td class="sk-table__cell">sí</td>
          <td class="sk-table__cell">navegador</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><a href="/components/popup">Popup</a></td>
          <td class="sk-table__cell">trigger</td>
          <td class="sk-table__cell">opt-in</td>
          <td class="sk-table__cell">navegador</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><a href="/components/menu">Menu</a></td>
          <td class="sk-table__cell">trigger o ítem padre</td>
          <td class="sk-table__cell">no</td>
          <td class="sk-table__cell">navegador</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><a href="/components/select">Select</a></td>
          <td class="sk-table__cell">control entero</td>
          <td class="sk-table__cell">no</td>
          <td class="sk-table__cell">navegador</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><a href="/components/combobox">Combobox</a></td>
          <td class="sk-table__cell">control entero</td>
          <td class="sk-table__cell">no</td>
          <td class="sk-table__cell">navegador</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><a href="/components/date-picker">DatePicker</a></td>
          <td class="sk-table__cell">control entero</td>
          <td class="sk-table__cell">no</td>
          <td class="sk-table__cell">navegador</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Mecanismo</h2>
  <p>
    CSS Anchor Positioning coloca el positioner, lo voltea al lado opuesto del mismo eje cuando no
    entra y lo oculta si el anchor sale de pantalla. Donde la API no está disponible, el Binding usa
    la Machine que ya gobierna el componente. Los dos caminos realizan el mismo Contract: nunca se
    dejan activos a la vez, para que los estilos inline del fallback no ganen sobre el Pattern.
  </p>
  <CodeBlock code={anatomy} label="HTML" />

  <h2>Restricciones</h2>
  <ul>
    <li>
      <code>sk-anchor</code> nombra el rol geométrico. Casi siempre es el trigger, pero Select,
      Combobox y DatePicker anclan el control entero para alinear la lista con el campo.
    </li>
    <li>
      <code>sk-anchored</code> es el positioner. No pinta, no recibe clicks y lleva
      <code>data-sk-placement</code> porque en React puede portearse fuera del root.
    </li>
    <li>
      El content es hijo del positioner y conserva la pintura del componente consumidor.
    </li>
    <li>
      <code>sk-anchored-arrow</code> se autora solo cuando la relación visual lo necesita. Es
      decorativa y siempre lleva <code>aria-hidden="true"</code>.
    </li>
  </ul>

  <h2>Placement y styling hooks</h2>
  <p>
    Las cuatro colocaciones públicas son lógicas: <code>block-start</code>, <code>block-end</code>,
    <code>inline-start</code> e <code>inline-end</code>. Una colocación es preferencia, no garantía:
    el navegador puede voltear dentro del mismo eje, pero no cambiar un costado por arriba.
  </p>
  <p>
    Las excepciones no agregan valores al vocabulario público. Un submenú que sale al costado y se
    alinea por arriba redefine el styling hook del positioner:
  </p>
  <CodeBlock code={submenu} label="CSS" />
  <p>Select y Combobox usan el mismo escape hatch para igualar el ancho al anchor:</p>
  <CodeBlock code={sameWidth} label="CSS" />

  <h2>Arrow</h2>
  <p>
    Tooltip, Popover y Popup pueden mostrar una arrow porque son chrome flotante que debe señalar el
    control que describe. Menu y Select no la usan: el borde compartido con el anchor ya expresa la
    relación. En React, la arrow sigue siendo opt-in.
  </p>
  <CodeBlock code={arrowReact} label="React" lang="tsx" />

  <h2>Compatibilidad y fallback</h2>
  <ul>
    <li>
      El camino de plataforma exige <code>@supports (anchor-name: --a)</code>. Los styling hooks que
      usan <code>anchor-size()</code> viven dentro de ese bloque porque sin anchor resuelto son inválidos.
    </li>
    <li>
      El fallback por Machine conserva la misma geometría observable y existe para navegadores sin
      CSS Anchor Positioning.
    </li>
    <li>
      No se usa <code>!important</code>: <code>position-try</code> solo puede voltear declaraciones
      normales.
    </li>
    <li>
      Vaul no consume este Pattern. Vaul se ancla a un borde del viewport; Anclaje se ancla a otro
      elemento.
    </li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={import_} label="CSS" />

  <StylingHooks groups={[{ file: "patterns/anchored.css", probe: "sk-anchored" }]} />
</Base>

<style is:global>
  .sk-anclaje-demo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-md);
    align-items: center;
    justify-content: center;
    padding-block: var(--space-stack-xl);
  }
</style>
