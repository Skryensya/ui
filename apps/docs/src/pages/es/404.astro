---
/* La ruta en español; la página es la misma (`NotFoundPage.astro`), en el idioma que dice la URL. */
import Base from "../../layouts/Base.astro";
import NotFoundPage from "../../components/pages/NotFoundPage.astro";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
---

<Base railIndex title={t("notFound.title")} description={t("notFound.description")}>
  <NotFoundPage />
</Base>
