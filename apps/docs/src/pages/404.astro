---
/*
 * The route. Everything about the page is in `NotFoundPage.astro`, which both languages render:
 * this file exists to own the URL and to ask the layout for the full index in the rail.
 */
import Base from "../layouts/Base.astro";
import NotFoundPage from "../components/pages/NotFoundPage.astro";
import { getLocale, useTranslations } from "../i18n";

const t = useTranslations(getLocale(Astro.url));
---

<Base railIndex title={t("notFound.title")} description={t("notFound.description")}>
  <NotFoundPage />
</Base>
