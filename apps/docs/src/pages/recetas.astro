---
/*
 * The recipes, rendered.
 *
 * Nothing on this page is written twice. The trees live in `contracts/recipes/`, the compiler
 * validates all four states of each against the contracts before it will emit a catalogue, and this
 * page hands the same trees to `ComponentPreview`, which emits the markup, the TSX and the live React
 * island from them.
 *
 * So a recipe cannot rot into prose that no longer works: the build fails first.
 */
import Base from "../layouts/Base.astro";
import ComponentPreview from "../components/ComponentPreview.astro";
import { recipes, type RecipeState } from "@skryensya/recipes";

import "@skryensya/core/components/callout.css";
import "@skryensya/core/components/accordion.css";
import "@skryensya/core/components/empty-state.css";
import "@skryensya/core/components/loader.css";
import "@skryensya/core/components/navbar.css";
import "@skryensya/core/components/pagination.css";
import "@skryensya/core/components/sidebar.css";
import "@skryensya/core/components/stat.css";
import "@skryensya/core/components/table.css";
import "@skryensya/core/components/theme-toggle.css";
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/toolbar.css";

/*
 * Reading order, not alphabetical: a screen is nothing until it has come back, and the state that
 * teaches the most is the one everybody skips. Success last, on purpose.
 */
const stateOrder: readonly RecipeState[] = ["loading", "empty", "error", "success"];

const stateLabel: Record<RecipeState, string> = {
  loading: "Cargando",
  empty: "Vacío",
  error: "Error",
  success: "Con datos",
};

const stateBlurb: Record<RecipeState, string> = {
  loading: "Todavía no llegó. La navegación se queda; lo que cambia es la columna.",
  empty: "Llegó, y no hay nada. Es una pantalla distinta de «todavía no llegó».",
  error: "No pudo llegar. Dice qué pasó y ofrece una salida.",
  success: "Llegó con datos.",
};
---

<Base
  title="Recetas"
  description="Pantallas completas como usage trees: app shell, formulario, tabla, preferencias y confirmación destructiva, cada una en sus cuatro estados."
>
  <h1>Recetas</h1>
  <p class="lede">
    El catálogo contesta <em>qué componente</em>. Una receta contesta <em>cómo se ve una pantalla
    entera</em>, y sobre todo cómo se ve cuando todavía no cargó, cuando volvió vacía y cuando falló,
    que es donde una interfaz generada suele estar mal.
  </p>
  <p>
    Cada receta es un <a href="/plataforma-ai">usage tree</a> por estado, guardado en
    <code>contracts/recipes/</code>. El compilador valida los cuatro contra los contratos antes de
    emitir el catálogo: una receta que nombra una firma que cambió <strong>rompe el build</strong> en
    vez de quedar enseñando algo que ya no funciona. El markup, el TSX y el demo React de acá abajo
    salen todos del mismo árbol.
  </p>

  {
    recipes.map((recipe) => (
      <section>
        <h2 id={recipe.id}>{recipe.intent}</h2>
        <ul>
          {recipe.notes.map((note) => (
            <li set:html={note.replace(/`([^`]+)`/g, "<code>$1</code>")} />
          ))}
        </ul>
        {stateOrder.map((state) => (
          <>
            <h3>{stateLabel[state]}</h3>
            <p>{stateBlurb[state]}</p>
            <ComponentPreview
              tree={recipe.states[state]}
              label={`${recipe.id} · ${stateLabel[state]}`}
              flush
            />
          </>
        ))}
      </section>
    ))
  }
</Base>
