---
import "@skryensya/core/components/slider.css";
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";
import ComponentPreview from "../components/ComponentPreview.astro";

/* The site remains an honest consumer: input/field needs its authored paint rules. */

const componentMarkup = `<section
  class="sk-box sk-stack"
  data-sk-density-scope
  style="--sk-density-factor: 0.72"
  data-surface="surface"
  data-border="subtle"
  data-padding="lg"
  data-gap="sm"
>
  <header>
    <strong>Order Summary</strong>
  </header>

  <div class="sk-form-field">
    <label class="sk-form-field__label" for="delivery-email">Email</label>
    <input class="sk-input" id="delivery-email" type="email" />
  </div>

  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-tone="accent"
    type="button"
  >
    Save changes
  </button>
</section>`;

const absoluteDensity = `<section
  data-sk-density-scope
  style="--sk-density: 0.72"
>
  <!-- the component's ordinary content -->
</section>`;

const densityLabScript = `document.querySelectorAll("[data-density-lab]").forEach((lab) => {
  const slider = lab.querySelector("[data-density-slider]");
  const target = lab.querySelector("[data-density-target]");
  const factorOutput = lab.querySelector("[data-density-factor-output]");
  const effectiveOutput = lab.querySelector("[data-density-effective-output]");
  const paddingOutput = lab.querySelector("[data-density-padding-output]");
  const buttonOutput = lab.querySelector("[data-density-button-output]");
  const button = target?.querySelector(".sk-button");

  if (
    !(slider instanceof HTMLElement)
    || !(target instanceof HTMLElement)
    || !(factorOutput instanceof HTMLElement)
    || !(effectiveOutput instanceof HTMLElement)
    || !(paddingOutput instanceof HTMLElement)
    || !(buttonOutput instanceof HTMLElement)
    || !(button instanceof HTMLButtonElement)
  ) return;

  const render = () => {
    const thumb = slider.querySelector('[role="slider"]');
    const value = Number(thumb?.getAttribute("aria-valuenow") ?? slider.getAttribute("data-value"));
    const factor = value / 100;

    target.style.setProperty("--sk-density-factor", String(factor));
    thumb?.setAttribute("aria-valuetext", \`\${factor.toFixed(2)} times the system density\`);
    factorOutput.textContent = \`\${factor.toFixed(2)}×\`;

    const density = Number.parseFloat(getComputedStyle(target).getPropertyValue("--sk-density"));
    effectiveOutput.textContent = \`\${density.toFixed(2)}×\`;
    paddingOutput.textContent = getComputedStyle(target).paddingInlineStart;
    buttonOutput.textContent = \`\${Math.round(button.getBoundingClientRect().height)}px\`;
  };

  slider.addEventListener("sk-value-change", render);
  render();
});`;

const densityPreviewTree: UsageTree = {
  contract: "layout",
  signature: "Stack",
  options: { gap: "lg" },
  attrs: { "data-density-lab": "", style: "inline-size: 100%" },
  children: [
    {
      contract: "layout",
      signature: "Stack",
      options: { gap: "xs" },
      children: [
        {
          contract: "layout",
          signature: "Inline",
          options: { gap: "sm", inlineAlign: "baseline" },
          children: ["Local factor", { contract: "typography", signature: "Code", attrs: { "data-density-factor-output": "" }, children: "1.00×" }],
        },
        { contract: "slider", signature: "Slider", options: { value: 72, min: 50, max: 120, step: 1 }, attrs: { id: "density-factor-control", "aria-label": "Local factor", "data-density-slider": "", "aria-valuetext": "0.72 times the system density" } },
      ],
    },
    {
      // Raw `data-sk-density-scope` + `--sk-density-factor`, hand-authored on the attrs the same
      // way `CopyButton.astro` and the presets gallery already do it: the scope is a plain
      // attribute contract, not something that ever needed its own signature to exist.
      contract: "box",
      signature: "Box",
      options: { surface: "surface", border: "subtle", padding: "lg" },
      attrs: {
        class: "sk-stack",
        "data-density-target": "",
        "data-gap": "sm",
        "data-sk-density-scope": "",
        style: "--sk-density-factor: 0.72",
      },
      children: [
        "Order summary",
        {
          contract: "form-field",
          signature: "FormField",
          slots: {
            label: "Email",
            children: { contract: "input", signature: "Input", options: { type: "email" }, attrs: { id: "delivery-email" } },
          },
        },
        { contract: "button", signature: "Button.action", options: { tone: "accent" }, children: "Save changes" },
        {
          contract: "layout",
          signature: "Inline",
          options: { gap: "sm", inlineAlign: "baseline" },
          children: [
            { contract: "button", signature: "Button.action", options: { variant: "ghost" }, children: "Cancel" },
            { contract: "typography", signature: "Code", attrs: { "data-density-effective-output": "" }, children: "0.72×" },
            { contract: "typography", signature: "Code", attrs: { "data-density-padding-output": "" }, children: "0px" },
            { contract: "typography", signature: "Code", attrs: { "data-density-button-output": "" }, children: "44px" },
          ],
        },
      ],
    },
  ],
};
---

<Base
  title="Component Density"
  documentLayout="grid"
  description="Adjust the spacing and controls of an isolated component without compacting the rest of the interface."
>
  <h1>Component Density</h1>
  <p class="lede">
    Local density is not a component variant. It is a scope that recalculates the <strong>spacing and control tokens at your component's boundary</strong>, without touching its neighbours or the density the application chose.
  </p>

  <div class="sk-callout" data-tone="info">
    <div class="sk-callout__content">
      <p>
        <strong>The entire contract lives on the same node: </strong> <code>data-sk-density-scope</code> turns local reprojection on; <code>--sk-density-factor</code> or <code>--sk-density</code>, written in <code>style</code>, sets the value. The scope adds no classes, no selectors, no mandatory presets and no prop on each component.
      </p>
    </div>
  </div>

  <h2>The global scope comes first</h2>
  <p>
    The application-wide value lives in <code>--sk-density</code>, usually on <code>html</code>. The semantic
    spacing and control tokens read it at runtime, so no component takes a density prop: everything below
    that declaration already resolves against it.
  </p>
  <CodeBlock code={`html { --sk-density: 0.8; }`} label="CSS" />

  <h2>Put the local scope on the boundary you already have</h2>
  <p>
    Put the attribute once, on the root of the component you want to compact, and write the value there as an inline style. Its descendants go on reading the same semantic tokens: no class to invent for the scope, and no marking each button, field or row one by one.
  </p>
  <CodeBlock code={componentMarkup} label="Component HTML" />

  <h2>Use a relative factor by default</h2>
  <p>
    <code>--sk-density-factor</code> keeps the reader's own choice in play. If the application is at <code>0.8</code> and the component asks for <code>0.72</code>, its effective density is <code>0.576</code>. The value can be any valid number; it does not have to come from a preset.
  </p>

  <p>
    Use an absolute value only when the component needs a measurement independent of the application. An absolute value beats a factor, so use one or the other and never both.
  </p>
  <CodeBlock code={absoluteDensity} label="HTML with absolute value" />

  <h2>Test an isolated component</h2>
  <p>
    The control below sits outside the scope. Drag it: padding, gaps and semantic sizes change inside the panel, and the rest of the page stays where it is.
  </p>
  <ComponentPreview tree={densityPreviewTree} previewScript={densityLabScript} label="Local Scope in action" note="scope and value live inline on the same node" />

  <h2>What changes, and what does not</h2>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row"><th class="sk-table__header">Within the scope</th><th class="sk-table__header">Behaviour</th></tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row"><td class="sk-table__cell"><code>--space-*</code></td><td class="sk-table__cell">Padding, gaps and insets are recalculated against the effective density.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell"><code>--size-control-*</code></td><td class="sk-table__cell">Recalculated too, with the minimum-size floor already inside them.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Typography, icons and radius</td><td class="sk-table__cell">Invariant: density pulls content closer together, it does not change the visual scale.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Focus ring and touch area</td><td class="sk-table__cell">Protected. A default Button never paints below <code>44px</code>; <code>data-size="sm"</code> may paint at 32px and still keep its hit area at <code>44px</code>.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Wrappers and <code>--space-section</code></td><td class="sk-table__cell">Not compacted: page geometry does not belong to the component.</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Nested scopes do not shrink twice</h2>
  <p>
    Each scope computes its factor against the system density it captured, never against the scope above it. A <code>0.72</code> component inside another <code>0.72</code> component still resolves to <code>0.72 × system</code>, not <code>0.5184 × system</code>, so nesting two of them by accident cannot shrink a subcomponent out of legibility.
  </p>

  <h2>Limits</h2>
  <p>
    Density never touches type, radius, focus or touch area. To set it for the whole application, use
    <a href="/dimensions">the global dimension</a>, which is where the axis itself is defined. For a local
    exception, keep the scope on the component's own boundary and let its tokens do the rest. It continues in
    <a href="/elevation">Elevation</a>, which shows the visual fallbacks, and in
    <a href="/reference">Reference</a>, for looking up the resolved values.
  </p>
</Base>

