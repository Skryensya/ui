---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import "../../examples/loader.css";
import {
  LoaderContextsDemo,
  LoaderSimulationDemo,
  LoaderSizesDemo,
  LoaderSpeedDemo,
} from "../../components/react-demos/loader";

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/loader.css";`;

const simulationHtml = `<div
  class="loader-demo"
  data-loader-demo
  aria-busy="true"
>
  <div
    class="loader-demo__status"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <div class="loader-demo__state" data-loader-busy>
      <span
        class="sk-loader"
        data-size="md"
        data-variant="bars"
        aria-hidden="true"
      ></span>
      <span class="loader-demo__copy">
        <strong>Analizando mezcla</strong>
        <span>Buscando resonancias y picos transitorios…</span>
      </span>
    </div>
    <div class="loader-demo__state" data-loader-ready hidden>
      <span class="loader-demo__ready-dot" aria-hidden="true"></span>
      <span class="loader-demo__copy">
        <strong>Análisis actualizado</strong>
        <span>La mezcla está lista para revisar.</span>
      </span>
    </div>
  </div>

  <button
    class="sk-button sk-interactive"
    data-variant="ghost"
    data-loader-replay
    type="button"
    hidden
  >
    Analizar de nuevo
  </button>
</div>`;

const simulationJs = `const demo = document.querySelector("[data-loader-demo]");

if (demo instanceof HTMLElement) {
  const replay = demo.querySelector("[data-loader-replay]");
  const busy = demo.querySelector("[data-loader-busy]");
  const ready = demo.querySelector("[data-loader-ready]");
  let timer = 0;

  const setBusy = (active) => {
    demo.setAttribute("aria-busy", String(active));
    busy?.toggleAttribute("hidden", !active);
    ready?.toggleAttribute("hidden", active);
    replay?.toggleAttribute("hidden", active);
  };

  const analyze = () => {
    window.clearTimeout(timer);
    setBusy(true);
    timer = window.setTimeout(() => setBusy(false), 2200);
  };

  replay?.addEventListener("click", analyze);
  analyze();
}`;

const simulationReact = `import { useEffect, useState } from "react";
import { Button } from "@skryensya/react/button";
import { Loader } from "@skryensya/react/loader";

function Example() {
  const [analyzing, setAnalyzing] = useState(true);
  const [run, setRun] = useState(0);

  useEffect(() => {
    const timer = window.setTimeout(() => setAnalyzing(false), 2200);
    return () => window.clearTimeout(timer);
  }, [run]);

  const analyze = () => {
    setAnalyzing(true);
    setRun((current) => current + 1);
  };

  return (
    <div className="loader-demo" aria-busy={analyzing}>
      <div
        aria-atomic="true"
        aria-live="polite"
        className="loader-demo__status"
        role="status"
      >
        {analyzing ? (
          <div className="loader-demo__state">
            <Loader size="md" variant="bars" />
            <span className="loader-demo__copy">
              <strong>Analizando mezcla</strong>
              <span>Buscando resonancias y picos transitorios…</span>
            </span>
          </div>
        ) : (
          <div className="loader-demo__state">
            <span className="loader-demo__ready-dot" aria-hidden="true" />
            <span className="loader-demo__copy">
              <strong>Análisis actualizado</strong>
              <span>La mezcla está lista para revisar.</span>
            </span>
          </div>
        )}
      </div>

      {!analyzing && (
        <Button onClick={analyze} variant="ghost">
          Analizar de nuevo
        </Button>
      )}
    </div>
  );
}`;

const contextsHtml = `<div class="sk-grid" data-columns="3" data-gap="md" data-multicol>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="lg"
