    </div>
  </article>

  <section
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    data-padding="lg"
    aria-busy="true"
    aria-labelledby="orders-title"
  >
    <div class="sk-stack" data-gap="md">
      <div class="sk-inline" data-justify="between" data-wrap="false">
        <h3 class="sk-heading" data-size="h4" id="orders-title">
          Pedidos recientes
        </h3>
        <span
          class="sk-loader"
