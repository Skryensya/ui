const mediaSrc = "/demos/media-gradient.svg";

/* Media card, read-only: Box owns the surface and clips (overflow: hidden), so ImageFrame with
   radius none bleeds edge to edge and inherits the card radius. The card carries no padding; the
   body class supplies the inset. The card sits in the first cell of a 3-column grid so it keeps a
   card's width instead of stretching across the stage. */
const mediaHtml = `<div class="sk-grid" data-columns="3" data-gap="md" data-multicol>
  <article
    class="sk-box"
    data-surface="surface"
    data-border="subtle"
    aria-labelledby="media-title"
  >
    <div class="sk-image-frame" data-aspect="16/9" data-radius="top">
      <img
        class="sk-image-frame__media"
        src="${mediaSrc}"
        alt=""
      />
    </div>
    <div class="sk-card-body">
      <div class="sk-stack" data-gap="sm">
        <span class="sk-badge" data-tone="accent">Guía</span>
        <div class="sk-stack" data-gap="xs">
          <h3 class="sk-heading" data-size="h3" id="media-title">
            Ritmo visual en tableros
          </h3>
          <p class="sk-text" data-tone="secondary">
            Cómo la imagen fija la jerarquía antes de que el texto
            entre a explicar el detalle.
          </p>
        </div>
      </div>
    </div>
  </article>
</div>`;

const mediaReact = `import { Badge } from "@skryensya/react/badge";
import { Heading } from "@skryensya/react/heading";
import { ImageFrame } from "@skryensya/react/image-frame";
import { Box, Grid, Stack } from "@skryensya/react/layout";
import { Text } from "@skryensya/react/text";

<Grid columns={3} data-multicol="" gap="md">
  <Box
    as="article"
    aria-labelledby="media-title"
    border="subtle"
    surface="surface"
  >
    <ImageFrame aspect="16/9" radius="top">
      <img
        className="sk-image-frame__media"
