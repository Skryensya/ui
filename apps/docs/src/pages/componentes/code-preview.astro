---
import "@skryensya/core/components/select.css";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";

const install = `pnpm add shiki @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/copy-button.css";
@import "@skryensya/core/components/switch.css";
@import "@skryensya/core/components/code-preview.css";`;

const highlight = `import { codeToHtml } from "shiki";

// Se ejecuta en build/SSR, nunca en el navegador.
const highlighted = await codeToHtml(source, {
  lang: "ts",
  themes: {
    light: "github-light",
    dark: "github-dark",
  },
});`;

const mount = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountCodePreview } from "@skryensya/vanilla/code-preview";

// CopyButton y los componentes normales: imports dinámicos por selector.
await initComponents();

// CodePreview es opt-in y queda fuera del auto-loader.
mountCodePreview();`;

const example = `const registrations = [
  { selector: "[data-sk-button]", load: () => import("./button.js") },
  { selector: "[data-sk-select]", load: () => import("./select.js") },
];`;
---

<Base
  title="CodePreview"
  description="Preview de código Shiki con resaltado en build/SSR y comportamiento Vanilla opt-in."
>
  <h1>CodePreview</h1>
  <p class="lede">
    Superficie para HTML resaltado por Shiki, con copiar, vista condensada/completa y preview de
    bloques largos. Shiki termina su trabajo en build o SSR; el navegador recibe HTML y sólo monta
    los controles que el documento autoró.
  </p>

  <CodeBlock code={example} label="TypeScript" lang="ts" />
  <p>
    Para presentar este bloque debajo del render real de un componente, usa
    <a href="/componentes/component-preview">ComponentPreview</a>.
  </p>

  <h2>Contrato de carga</h2>
  <ul>
    <li>
      <code>@skryensya/core/components/code-preview.css</code> contiene la anatomía y consume las
      variables duales <code>--shiki-light</code> y <code>--shiki-dark</code>.
    </li>
    <li>
      <code>initComponents()</code> no conoce <code>[data-sk-code-preview]</code>. Importar el
      auto-loader nunca descarga este enhancer.
    </li>
    <li>
      <code>mountCodePreview()</code> es el único seam de comportamiento y es idempotente. El
      resaltado no forma parte de ese runtime.
    </li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" lang="css" />

  <h2>Resaltar en build o SSR</h2>
  <CodeBlock code={highlight} label="TypeScript" lang="ts" />

  <h2>Montar explícitamente</h2>
  <p>
    Los componentes normales se descubren por selector. CodePreview se monta en una segunda llamada
    deliberada, para que ninguna aplicación cargue un preview de documentación por accidente.
  </p>
  <CodeBlock code={mount} label="TypeScript" lang="ts" />
</Base>
