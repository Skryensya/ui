---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { PaginationDemo } from "../../components/react-demos/pagination";

const install = `pnpm add @skryensya/core @skryensya/react`;

const html = `<nav class="sk-pagination" aria-label="Paginación">
  <button
    class="sk-pagination__previous sk-interactive"
    type="button"
    aria-label="Página anterior"
  >
    <span data-sk-icon="chevron-left" data-sk-icon-size="sm"></span>
  </button>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Página 1"
  >
    1
  </button>
  <span class="sk-pagination__ellipsis" aria-hidden="true">…</span>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Página 4"
  >
    4
  </button>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-current="page"
    aria-label="Página 5"
  >
    5
  </button>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Página 6"
  >
    6
  </button>
  <span class="sk-pagination__ellipsis" aria-hidden="true">…</span>
  <button
    class="sk-pagination__item sk-interactive"
    type="button"
    aria-label="Página 12"
  >
    12
  </button>
  <button
    class="sk-pagination__next sk-interactive"
    type="button"
    aria-label="Página siguiente"
  >
    <span data-sk-icon="chevron-right" data-sk-icon-size="sm"></span>
  </button>
</nav>`;

const react = `import { useState } from "react";
import { Pagination } from "@skryensya/react/pagination";

function Example() {
  const [page, setPage] = useState(5);
  return (
    <Pagination
      page={page}
      total={12}
      onPageChange={setPage}
      label="Paginación"
      previousLabel="Página anterior"
      nextLabel="Página siguiente"
    />
  );
}`;

const rangeExample = `import { paginationRange } from "@skryensya/core/pagination";

paginationRange(5, 20);
// → [1, "ellipsis", 4, 5, 6, "ellipsis", 20]`;
---

<Base title="Pagination" description="Pagination: ventana de páginas como función pura del core, con primera, última y elipsis.">
  <h1>Pagination</h1>
  <p class="lede">
    Pagination recorre un conjunto paginado, una página a la vez. La ventana visible es la parte
    interesante, y vive como función pura en el core: primera y última siempre presentes, la actual
    con un hermano a cada lado, y las corridas ocultas colapsan en una elipsis.
  </p>

  <Showcase html={html} react={react} label="Pagination">
    <Fragment slot="react">
      <PaginationDemo client:load />
    </Fragment>
  </Showcase>
  <p>
    Prev/next usan los roles <code>chevron-left</code> y <code>chevron-right</code> del set.
    La página actual lleva <code>aria-current="page"</code>; prev/next se deshabilitan en los bordes.
    La elipsis es texto inerte, no un objetivo. Los targets llevan <code>sk-interactive</code>.
  </p>

  <h2>La ventana, en el core</h2>
  <p>El renderizado y los handlers son del binding; el cálculo es del core y es testeable en aislamiento:</p>
  <CodeBlock code={rangeExample} lang="ts" label="@skryensya/core/pagination" />

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>El código está en la pestaña <strong>React</strong> del preview. React dibuja los chevrons del set enlazado.</p>
  <StylingHooks groups={[{ file: "components/pagination.css", probe: "sk-pagination" }]} />
</Base>
