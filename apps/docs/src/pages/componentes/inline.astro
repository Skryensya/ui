---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import { InlineActionBarDemo } from "../../components/react-demos/layout";

const install = `pnpm add @skryensya/core @skryensya/react`;

const html = `<section
  class="sk-box"
  data-surface="raised"
  data-border="subtle"
  data-padding="lg"
  aria-labelledby="project-title"
>
  <div
    class="sk-inline"
    data-gap="md"
    data-align="center"
    data-justify="between"
  >
    <div class="sk-stack" data-gap="none">
      <h2 class="sk-heading" data-size="h4" id="project-title">
        Proyecto Atlas
      </h2>
      <p class="sk-text" data-size="sm" data-tone="secondary">
        3 cambios sin publicar
      </p>
    </div>

    <div class="sk-inline" data-gap="sm" data-wrap="false">
      <button
        class="sk-button sk-interactive"
        data-sk-button
        data-variant="ghost"
        type="button"
      >
        Vista previa
      </button>
      <button
        class="sk-button sk-interactive"
        data-sk-button
        data-variant="primary"
        type="button"
      >
        Publicar
      </button>
    </div>
  </div>
</section>`;

const react = `import { Button } from "@skryensya/react/button";
import { Heading } from "@skryensya/react/heading";
import { Box, Inline, Stack } from "@skryensya/react/layout";
import { Text } from "@skryensya/react/text";

function Example() {
  return (
    <Box
      as="section"
      aria-labelledby="project-title"
      border="subtle"
      padding="lg"
      surface="raised"
    >
      <Inline gap="md" justify="between">
        <Stack gap="none">
          <Heading as="h2" id="project-title" size="h4">
            Proyecto Atlas
          </Heading>
          <Text size="sm" tone="secondary">3 cambios sin publicar</Text>
        </Stack>

        <Inline gap="sm" wrap={false}>
          <Button variant="ghost">Vista previa</Button>
          <Button variant="primary">Publicar</Button>
        </Inline>
      </Inline>
    </Box>
  );
}`;
---

<Base title="Inline" description="Inline, el pattern de layout horizontal y adaptable.">
  <h1>Inline</h1>
  <p class="lede">
    Organiza elementos en horizontal y los devuelve a otra línea cuando el espacio se agota. Úsalo
    para barras de acciones y pares label–control; la semántica pertenece al elemento que eliges.
  </p>

  <Showcase html={html} react={react} label="Barra de acciones" note="Box + Stack + Inline + Button">
    <Fragment slot="react">
      <InlineActionBarDemo client:load />
    </Fragment>
  </Showcase>

  <h2>HTML autorado</h2>
  <p>
    Usa <code>sk-inline</code> en el elemento semántico que corresponda. Los atributos describen el
    espaciado, la alineación vertical, la distribución horizontal y si la fila puede envolver sus hijos.
  </p>
  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />


  <h2>React</h2>
  <p>El código está en la pestaña <strong>React</strong> del preview.</p>

  <h2>Contrato</h2>
  <ul>
    <li><code>as</code> elige el elemento raíz; por defecto es <code>div</code>.</li>
    <li><code>gap</code> acepta <code>none</code>, <code>xs</code>, <code>sm</code>, <code>md</code>, <code>lg</code> o <code>xl</code>; por defecto es <code>md</code>.</li>
    <li><code>align</code> acepta <code>start</code>, <code>center</code>, <code>end</code> o <code>baseline</code>; por defecto es <code>center</code>.</li>
    <li><code>justify</code> acepta <code>start</code>, <code>center</code>, <code>end</code> o <code>between</code>; en HTML se escribe con <code>data-justify</code>.</li>
    <li><code>wrap</code> permite envolver los hijos; por defecto es <code>true</code>. Usa <code>data-wrap="false"</code> para una sola fila en HTML.</li>
  </ul>
</Base>
