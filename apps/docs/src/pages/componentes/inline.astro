---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import { inlineTree } from "../../demos/layout";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
---

<Base title="Inline" description="Inline, el pattern de layout horizontal y adaptable.">
  <h1>Inline</h1>
  <p class="lede">
    Organiza elementos en horizontal y los devuelve a otra línea cuando el espacio se agota. Úsalo
    para barras de acciones y pares label–control; la semántica pertenece al elemento que eliges.
  </p>

  <ComponentPreview
    tree={inlineTree(t)}
    label="Barra de acciones"
    note="Box + Stack + Inline + Button"
  />

  <h2>HTML autorado</h2>
  <p>
    Usa <code>sk-inline</code> en el elemento semántico que corresponda. Los atributos describen el
    espaciado, la alineación vertical, la distribución horizontal y si la fila puede envolver sus hijos.
  </p>
  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />


  <h2>React</h2>
  <p>El código está en la pestaña <strong>React</strong> del preview.</p>

  <h2>Contrato</h2>
  <ul>
    <li><code>as</code> elige el elemento raíz; por defecto es <code>div</code>.</li>
    <li><code>gap</code> acepta <code>none</code>, <code>xs</code>, <code>sm</code>, <code>md</code>, <code>lg</code> o <code>xl</code>; por defecto es <code>md</code>.</li>
    <li><code>align</code> acepta <code>start</code>, <code>center</code>, <code>end</code> o <code>baseline</code>; por defecto es <code>center</code>.</li>
    <li><code>justify</code> acepta <code>start</code>, <code>center</code>, <code>end</code> o <code>between</code>; en HTML se escribe con <code>data-justify</code>.</li>
    <li><code>wrap</code> permite envolver los hijos; por defecto es <code>true</code>. Usa <code>data-wrap="false"</code> para una sola fila en HTML.</li>
  </ul>
</Base>
