---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import { StackBasicDemo } from "../../components/react-demos/layout";

const install = `pnpm add @skryensya/core @skryensya/react`;

const html = `<section
  class="sk-stack"
  data-gap="md"
  data-align="start"
  aria-labelledby="stack-demo-title"
>
  <h3 class="sk-heading" data-size="h3" id="stack-demo-title">
    Resumen
  </h3>
  <p>La solicitud está lista para revisar.</p>
  <a class="sk-link sk-interactive" href="/componentes/stack">
    Ver detalles
  </a>
</section>`;

const react = `import { Stack } from "@skryensya/react/stack";
import { Heading } from "@skryensya/react/heading";

function Example() {
  return (
    <Stack
      as="section"
      gap="md"
      align="start"
      aria-labelledby="resumen-title"
    >
      <Heading as="h2" size="h2" id="resumen-title">
        Resumen
      </Heading>
      <p>La solicitud está lista para revisar.</p>
      <a href="/detalles">Ver detalles</a>
    </Stack>
  );
}`;
---

<Base title="Stack" description="Stack: primitive de layout vertical con separación y alineación transversal.">
  <h1>Stack</h1>
  <p class="lede">
    Stack apila contenido en el eje vertical. Es un pattern estructural: el elemento que lo lleva conserva
    la semántica del contenido, y el gap expresa la separación entre sus hijos.
  </p>

  <Showcase html={html} react={react} label="Stack">
    <Fragment slot="react">
      <StackBasicDemo client:load />
    </Fragment>
  </Showcase>

  <h2>HTML autorado</h2>
  <p>
    Elige directamente el elemento semántico; Stack no requiere inicialización vanilla.
  </p>
  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />


  <h2>React</h2>
  <p>
    Usa <code>as</code> para elegir el elemento que renderiza el adapter sin perder el contrato de layout.
  </p>
  <p>El código está en la pestaña <strong>React</strong> del preview.</p>

  <h2>Contrato</h2>
  <ul>
    <li><code>sk-stack</code> crea una grilla de una columna y apila sus hijos verticalmente.</li>
    <li><code>data-gap</code> acepta <code>none</code>, <code>xs</code>, <code>sm</code>, <code>md</code>, <code>lg</code> o <code>xl</code>; al omitirlo usa <code>md</code>.</li>
    <li><code>data-align</code> alinea en el eje transversal: <code>start</code>, <code>center</code>, <code>end</code> o <code>stretch</code>. Al omitirlo, la grilla estira los hijos.</li>
    <li>En React, <code>as</code> es opcional y renderiza <code>div</code> si no se indica.</li>
  </ul>
</Base>
