---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";
import StylingHooks from "../../components/StylingHooks.astro";
import { badgeDotsTree, badgeHoldersTree } from "../../demos/badge";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;

/*
 * The demo, as a USAGE TREE. The markup below the stage, the TSX beside it and the live React
 * island are all emitted from this, so the snippet a reader copies is what they just saw render.
 */
const tree = {
  contract: "layout",
  signature: "Inline",
  options: { gap: "sm" },
  children: [
    { contract: "badge", signature: "Badge", options: { tone: "neutral" }, children: "Neutral" },
    { contract: "badge", signature: "Badge", options: { tone: "accent" }, children: "Accent" },
    { contract: "badge", signature: "Badge", options: { tone: "success" }, children: "Success" },
    { contract: "badge", signature: "Badge", options: { tone: "warning" }, children: "Warning" },
    { contract: "badge", signature: "Badge", options: { tone: "danger" }, children: "Danger" },
  ],
} as const satisfies UsageTree;



---

<Base title="Badge" description="Badge: etiqueta estática con tonos semánticos, styling hooks y componente React.">
  <h1>Badge</h1>
  <p class="lede">
    Badge es una etiqueta visual estática para estados, categorías o metadatos cortos. No comunica
    selección, contador ni navegación por sí sola; esa semántica pertenece al contenido o al contenedor.
  </p>

  <h2>Etiqueta</h2>
  <p>La forma con texto: un estado, una categoría o un metadato corto. Cada tono lleva un borde de su
    propio color, así el neutral, cuyo fondo es el lienzo, no queda como un rectángulo invisible.</p>
  <ComponentPreview tree={tree} label="Badge" />

  <h2>Dot</h2>
  <p>
    Un badge que es <strong>sólo un punto</strong>: sin texto, comunica por color y posición. Suelto es
    una luz de estado; su relleno es un tono saturado para que se lea a unos pocos píxeles.
  </p>
  <ComponentPreview tree={badgeDotsTree(t)} label="Badge dot" />

  <h3>En la esquina de un elemento</h3>
  <p>
    Envuelve el elemento en <code>sk-badge-holder</code> y el dot se ancla arriba a la derecha, un
    indicador de novedades sobre un botón, de presencia sobre un avatar. Un anillo del color de la
    superficie lo despega del contenido de abajo. El punto lleva su propio <code>aria-label</code>
    porque significa algo; el elemento anfitrión no cambia.
  </p>
  <ComponentPreview tree={badgeHoldersTree(t)} label="Badge dot en la esquina" />

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />


  <h2>React</h2>
  <p>El código está en la pestaña <strong>React</strong> del preview.</p>
  <StylingHooks groups={[{"file":"components/badge.css","probe":"sk-badge"}]} />
</Base>
