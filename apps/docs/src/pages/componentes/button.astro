---
import "@skryensya/core/components/tile.css";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import {
  buttonAsLinkTree,
  buttonIconOnlySmTree,
  buttonIconOnlyTree,
  buttonIconTree,
  buttonSizesTree,
  buttonVariantsTree,
  tileButtonTree,
} from "../../demos/button";
import { getLocale, useTranslations } from "../../i18n";
import StylingHooks from "../../components/StylingHooks.astro";

const t = useTranslations(getLocale(Astro.url));
/* The link demo points at a real docs page, and that page's path differs per locale. */
const LINK_HREF = "/primer-componente";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// Los iconos se autoran como placeholders <span data-sk-icon>;
// mountIcons los reemplaza por el <svg> del set enlazado.
mountIcons(document, lucideIcons);

await initComponents();`;

const sizeHit = `/* Ya viene en components/button.css. No hay que
   escribirlo: está acá porque es la parte del componente
   que más sorprende, y conviene saber que existe.

   El positioning NO se declara acá a propósito: lo pone
   .sk-interactive (state layer). Un position propio haría
   de cualquier botón el bloque contenedor de lo que tenga
   dentro en absoluto. */
.sk-button::after {
  content: "";
  position: absolute;
  inset-block: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
  inset-inline: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
}`;



const tileButtonVanilla = `import { createTileButton } from "@skryensya/vanilla/tile-button";

const button = createTileButton();
button.textContent = "Run deployment";
button.addEventListener("click", runDeployment);`;

---

<Base title="Button" description="Button: hooks de estilo, enhancer vanilla mínimo y componente React.">
  <h1>Button</h1>
  <p class="lede">
    Styling hooks sobre el <code>&lt;button&gt;</code> nativo, un enhancer vanilla y un componente React.
  </p>

  <h2>Variantes</h2>
  <ComponentPreview tree={buttonVariantsTree(t)} label="Button" />

  <h2>Tamaños</h2>
  <ComponentPreview tree={buttonSizesTree(t)} label="Button · sm / md / lg" />
  <CodeBlock
    code={sizeHit}
    label="components/button.css"
    lang="css"
    note="ya incluido: la cara sm pinta a 32px, el hit sigue en 44px"
  />

  <h2>Con icono</h2>
  <ComponentPreview tree={buttonIconTree(t)} label="Button con icono" />

  <h2>Solo icono</h2>
  <ComponentPreview tree={buttonIconOnlyTree(t)} label="Solo icono" />
  <ComponentPreview tree={buttonIconOnlySmTree(t)} label="Solo icono · sm" />

  <h2>Como enlace</h2>
  <p>
    Cualquier forma de arriba —variante, tamaño, icono, solo icono— también renderiza como enlace:
    mismas clases, mismos atributos <code>data-*</code>, solo cambia el tag (<code>&lt;a href&gt;</code>
    en vez de <code>&lt;button&gt;</code>). En React, pasarle <code>href</code> a <code>Button</code>
    hace el cambio. Un enlace no puede ser <code>disabled</code>: renderiza contenido no enlazado en su lugar.
  </p>
  <ComponentPreview tree={buttonAsLinkTree(t, LINK_HREF)} label="Button como enlace" />

  <h2>TileButton</h2>
  <p>Cuando toda la superficie es una acción, no solo una etiqueta adentro.</p>
  <ComponentPreview tree={tileButtonTree(t)} label="TileButton" />
  <CodeBlock code={tileButtonVanilla} label="JavaScript" />

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>Inicializar vanilla</h2>
  <CodeBlock code={js} label="JavaScript" />

  <StylingHooks groups={[{"file":"components/button.css","probe":"sk-button"}]} />
</Base>
