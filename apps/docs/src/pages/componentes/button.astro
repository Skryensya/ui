---
import "@skryensya/core/components/tile.css";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import {
  ButtonBasicDemo,
  ButtonIconDemo,
  ButtonIconOnlyDemo,
  ButtonIconOnlySmDemo,
  ButtonAsLinkDemo,
  ButtonSizeDemo,
  TileButtonDemo,
} from "../../components/react-demos/button";


const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const html = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="primary"
  >
    Guardar
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="neutral"
  >
    Cancelar
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="danger"
  >
    Borrar
  </button>
</div>`;

/* Icon + text: no extra hook. The button is already an inline-flex row with a gap, so an authored
   <svg class="sk-icon"> and the label lay themselves out. The icon is DECORATIVE, the label already
   names the action, so it stays aria-hidden. */
const iconHtml = `<button
  class="sk-button sk-interactive"
  data-sk-button
  data-variant="primary"
>
  <span data-sk-icon="download"></span>
  Descargar
</button>`;

/* Icon-only: data-icon-only makes the box a square, and the name, with no text to carry it, MUST
   be authored as aria-label. The icon stays decorative. Default size matches the control (md). */
const iconOnlyHtml = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-icon-only
    aria-label="Configuración"
  >
    <span data-sk-icon="settings"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-icon-only
    data-variant="ghost"
    aria-label="Editar"
  >
    <span data-sk-icon="edit"></span>
  </button>
</div>`;

/* Same shape at sm: face paints at control-sm; ::after keeps the 44px hit. */
const iconOnlySmHtml = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    aria-label="Configuración"
  >
    <span data-sk-icon="settings"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    data-variant="ghost"
    aria-label="Editar"
  >
    <span data-sk-icon="edit"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    data-variant="primary"
    aria-label="Añadir"
  >
    <span data-sk-icon="add"></span>
  </button>
</div>`;

const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// Los iconos se autoran como placeholders <span data-sk-icon>;
// mountIcons los reemplaza por el <svg> del set enlazado.
mountIcons(document, lucideIcons);

await initComponents();`;

const react = `import { Button } from "@skryensya/react/button";

function Example() {
  return (
    <div className="sk-inline">
      <Button variant="primary">Guardar</Button>
      <Button variant="neutral">Cancelar</Button>
      <Button variant="danger">Borrar</Button>
    </div>
  );
}`;

const sizeHtml = `<div class="sk-inline">
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-variant="primary"
  >
    Guardar
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="md"
    data-variant="primary"
  >
    Guardar
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="lg"
    data-variant="primary"
  >
    Guardar
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-icon-only
    data-variant="ghost"
    aria-label="Más acciones"
  >
    <span data-sk-icon="more"></span>
  </button>
  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-size="md"
    data-icon-only
    data-variant="ghost"
    aria-label="Más acciones"
  >
    <span data-sk-icon="more"></span>
  </button>
</div>`;

const sizeReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  return (
    <div className="sk-inline">
      <Button size="sm" variant="primary">Guardar</Button>
      <Button variant="primary">Guardar</Button>
      {/* md es el default: omitir size o size="md" */}
      <Button size="lg" variant="primary">Guardar</Button>
      <Button
        size="sm"
        iconOnly
        variant="ghost"
        aria-label="Más acciones"
      >
        <Icon name="more" />
      </Button>
      <Button iconOnly variant="ghost" aria-label="Más acciones">
        <Icon name="more" />
      </Button>
    </div>
  );
}`;

const sizeHit = `/* Ya viene en components/button.css. No hay que
   escribirlo: está acá porque es la parte del componente
   que más sorprende, y conviene saber que existe.

   El positioning NO se declara acá a propósito: lo pone
   .sk-interactive (state layer). Un position propio haría
   de cualquier botón el bloque contenedor de lo que tenga
   dentro en absoluto. */
.sk-button::after {
  content: "";
  position: absolute;
  inset-block: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
  inset-inline: min(
    0px,
    calc((100% - var(--size-touch-target)) / 2)
  );
}`;

const iconReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  return (
    <Button variant="primary">
      <Icon name="download" />
      Descargar
    </Button>
  );
}`;


const iconOnlyReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  // sin texto visible, el nombre es obligatorio: aria-label
  return (
    <div className="sk-inline">
      <Button iconOnly aria-label="Configuración">
        <Icon name="settings" />
      </Button>
      <Button iconOnly variant="ghost" aria-label="Editar">
        <Icon name="edit" />
      </Button>
    </div>
  );
}`;

const iconOnlySmReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  // Face sm (32px) + hit 44px via ::after. aria-label is required.
  return (
    <div className="sk-inline">
      <Button size="sm" iconOnly aria-label="Configuración">
        <Icon name="settings" />
      </Button>
      <Button
        size="sm"
        iconOnly
        variant="ghost"
        aria-label="Editar"
      >
        <Icon name="edit" />
      </Button>
      <Button
        size="sm"
        iconOnly
        variant="primary"
        aria-label="Añadir"
      >
        <Icon name="add" />
      </Button>
    </div>
  );
}`;

const tileButtonHtml = `<button
  class="sk-tile sk-tile--interactive sk-interactive"
  type="button"
>
  <span class="sk-tile__content">
    <span class="sk-tile__title">Run deployment</span>
    <span class="sk-tile__description">
      Start the production deployment now.
    </span>
  </span>
</button>`;

const tileButtonVanilla = `import { createTileButton } from "@skryensya/vanilla/tile-button";

const button = createTileButton();
button.textContent = "Run deployment";
button.addEventListener("click", runDeployment);`;

const tileButtonReact = `import { TileButton } from "@skryensya/react/tile-button";

function Example() {
  return (
    <TileButton onClick={SomeFunction}>
      <span className="sk-tile__content">
        <span className="sk-tile__title">Run deployment</span>
        <span className="sk-tile__description">
          Start the production deployment now.
        </span>
      </span>
    </TileButton>
  );
}`;
const linkHtml = `<div class="sk-inline">
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="primary"
    href="/primer-componente"
  >
    Ir a primer componente
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-size="sm"
    data-variant="neutral"
    href="/primer-componente"
  >
    Chico
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-size="lg"
    data-variant="neutral"
    href="/primer-componente"
  >
    Grande
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-variant="neutral"
    href="/primer-componente"
  >
    <span data-sk-icon="download"></span>
    Con icono
  </a>
  <a
    class="sk-button sk-interactive"
    data-sk-button
    data-icon-only
    data-variant="ghost"
    aria-label="Ir a primer componente"
    href="/primer-componente"
  >
    <span data-sk-icon="arrow-right"></span>
  </a>
</div>`;

const linkReact = `import { Button } from "@skryensya/react/button";
import { Icon } from "@skryensya/react/icon";

function Example() {
  // Es el mismo Button: un href cambia el tag a <a>. Cada forma lo sigue: tamaño, icono, iconOnly.
  return (
    <div className="sk-inline">
      <Button variant="primary" href="/primer-componente">
        Ir a primer componente
      </Button>
      <Button size="sm" variant="neutral" href="/primer-componente">
        Chico
      </Button>
      <Button size="lg" variant="neutral" href="/primer-componente">
        Grande
      </Button>
      <Button variant="neutral" href="/primer-componente">
        <Icon name="download" />
        Con icono
      </Button>
      <Button
        iconOnly
        variant="ghost"
        aria-label="Ir a primer componente"
        href="/primer-componente"
      >
        <Icon name="arrow-right" />
      </Button>
    </div>
  );
}`;

---

<Base title="Button" description="Button: hooks de estilo, enhancer vanilla mínimo y componente React.">
  <h1>Button</h1>
  <p class="lede">
    Styling hooks sobre el <code>&lt;button&gt;</code> nativo, un enhancer vanilla y un componente React.
  </p>

  <h2>Variantes</h2>
  <Showcase html={html} react={react} label="Button">
    <Fragment slot="react">
      <ButtonBasicDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Tamaños</h2>
  <Showcase
    html={sizeHtml}
    react={sizeReact}
    label="Button · sm / md / lg"
  >
    <Fragment slot="react">
      <ButtonSizeDemo client:load />
    </Fragment>
  </Showcase>
  <CodeBlock
    code={sizeHit}
    label="components/button.css"
    lang="css"
    note="ya incluido: la cara sm pinta a 32px, el hit sigue en 44px"
  />

  <h2>Con icono</h2>
  <Showcase html={iconHtml} react={iconReact} label="Button con icono">
    <Fragment slot="react">
      <ButtonIconDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Solo icono</h2>
  <Showcase html={iconOnlyHtml} react={iconOnlyReact} label="Solo icono">
    <Fragment slot="react">
      <ButtonIconOnlyDemo client:load />
    </Fragment>
  </Showcase>
  <Showcase
    html={iconOnlySmHtml}
    react={iconOnlySmReact}
    label="Solo icono · sm"
  >
    <Fragment slot="react">
      <ButtonIconOnlySmDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Como enlace</h2>
  <p>
    Cualquier forma de arriba —variante, tamaño, icono, solo icono— también renderiza como enlace:
    mismas clases, mismos atributos <code>data-*</code>, solo cambia el tag (<code>&lt;a href&gt;</code>
    en vez de <code>&lt;button&gt;</code>). En React, pasarle <code>href</code> a <code>Button</code>
    hace el cambio. Un enlace no puede ser <code>disabled</code>: renderiza contenido no enlazado en su lugar.
  </p>
  <Showcase html={linkHtml} react={linkReact} label="Button como enlace">
    <Fragment slot="react">
      <ButtonAsLinkDemo client:load />
    </Fragment>
  </Showcase>

  <h2>TileButton</h2>
  <p>Cuando toda la superficie es una acción, no solo una etiqueta adentro.</p>
  <Showcase html={tileButtonHtml} react={tileButtonReact} label="TileButton">
    <Fragment slot="react">
      <TileButtonDemo client:load />
    </Fragment>
  </Showcase>
  <CodeBlock code={tileButtonVanilla} label="JavaScript" />

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>Inicializar vanilla</h2>
  <CodeBlock code={js} label="JavaScript" />

  <StylingHooks groups={[{"file":"components/button.css","probe":"sk-button"}]} />
</Base>
