---
import Base from "../../layouts/Base.astro";
import Showcase from "../../components/Showcase.astro";
import type { UsageTree } from "@skryensya/ai-compiler/usage-tree";
import StylingHooks from "../../components/StylingHooks.astro";
import "@skryensya/core/components/empty-state.css";

const install = `@import "@skryensya/core/components/empty-state.css";`;
/*
 * The demo, as a USAGE TREE. The markup below the stage, the TSX beside it and the live React
 * island are all emitted from this, so the snippet a reader copies is what they just saw render.
 */
const tree = {
  contract: "empty-state",
  signature: "EmptyState",
  slots: {
    icon: { contract: "icon", signature: "Icon", options: { name: "search" } },
    title: "Todavía no hay proyectos",
    description: "Crea el primero para organizar el trabajo del equipo.",
    actions: { contract: "button", signature: "Button.action", children: "Crear proyecto" },
  },
} as const satisfies UsageTree;
---

<Base
  title="EmptyState"
  description="Explica por qué no hay contenido y ofrece una siguiente acción concreta."
>
  <h1>EmptyState</h1>
  <p class="lede">Explica por qué no hay contenido y ofrece una siguiente acción concreta.</p>

  <h2>Instalación</h2>
  <Showcase tree={tree} label="Empty State" />

  <h2>Contrato</h2>
  <p>El título nombra el estado, la descripción explica, y la acción resuelve. No uses EmptyState durante carga.</p>

  <h2>Accesibilidad</h2>
  <p>El icono es decorativo; el texto y la acción sostienen el significado sin depender de una ilustración.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/empty-state.css",
        probe: "sk-empty-state",
        title: "EmptyState",
      },
    ]}
  />
</Base>
