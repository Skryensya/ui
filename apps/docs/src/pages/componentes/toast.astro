/* Acción + cierre en la misma columna. Sin timeout a propósito: un toast con acción no debe
   evaporarse antes de que se pueda usar. */
const actionHtml = `<div class="sk-toast-region" aria-live="polite">
  <div
    class="sk-alert"
    data-sk-toast
    data-presentation="banner"
    data-tone="neutral"
    role="status"
    aria-live="polite"
  >
    <div class="sk-alert__content">
      <p class="sk-alert__title">Documento archivado</p>
