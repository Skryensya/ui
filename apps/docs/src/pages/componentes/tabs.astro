---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import {
  tabsAdvancedScript,
  tabsAdvancedTree,
  tabsBasicTree,
  tabsStatesTree,
} from "../../demos/tabs";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const css = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/tabs.css";
@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/patterns/layout.css";`;

const vanillaJs = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);
await initComponents();`;

const t = useTranslations(getLocale(Astro.url));

---

<Base
  title="Tabs"
  description="Tres ejemplos de Tabs, de la anatomía básica al control manual."
>
  <h1>Tabs</h1>
  <p class="lede">
    Empieza con dos vistas, añade estados e iconos y termina con una
    navegación vertical controlada. La anatomía no cambia al crecer:
    lista, triggers y un panel por cada valor.
  </p>

  <h2>1. Básico</h2>
  <p>
    Dos triggers y dos paneles. <code>data-value</code> enlaza cada
    opción con su contenido; el enhancer completa roles, foco y ARIA.
  </p>
  <ComponentPreview tree={tabsBasicTree(t)} label="Tabs básicos" />

  <h2>2. Estados e iconos</h2>
  <p>
    El mismo contrato admite labels compuestos y opciones
    deshabilitadas. El icono acompaña al texto; nunca reemplaza el
    nombre accesible del tab.
  </p>
  <ComponentPreview tree={tabsStatesTree(t)} label="Tabs con estados" />

  <h2>3. Orientación y estado</h2>
  <p>
    En orientación vertical, las flechas recorren el rail. Con
    activación manual, mover el foco no cambia el panel: Enter o
    Espacio confirma la selección. El evento actualiza la región viva
    debajo del componente.
  </p>
  <ComponentPreview
    tree={tabsAdvancedTree(t)}
    js={tabsAdvancedScript}
    previewScript={tabsAdvancedScript}
    label="Tabs verticales con control manual"
  />

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>CSS</h2>
  <CodeBlock code={css} label="CSS" lang="css" />

  <h2>Inicializar vanilla</h2>
  <p>
    <code>initComponents</code> conecta los Tabs. Los iconos se montan
    por separado con el set elegido por la aplicación.
  </p>
  <CodeBlock code={vanillaJs} label="JavaScript" />

  <h2>Contrato</h2>
  <ul>
    <li>
      La raíz usa <code>data-sk-tabs</code> y conserva el valor activo
      en <code>data-value</code>.
    </li>
    <li>
      Cada trigger y panel declara el mismo <code>data-value</code>.
    </li>
    <li>
      <code>data-disabled</code> retira una opción de la interacción.
    </li>
    <li>
      <code>data-orientation="vertical"</code> cambia el eje de
      navegación y del indicador.
    </li>
    <li>
      <code>data-activation-mode="manual"</code> separa foco y
      selección.
    </li>
    <li>
      Vanilla emite <code>sk-value-change</code>; React expone
      <code>onValueChange</code>.
    </li>
  </ul>

  <h2>React</h2>
  <p>
    El componente renderiza la misma anatomía desde <code>items</code>.
    Usa <code>value</code> y <code>onValueChange</code> cuando otro
    estado de la aplicación dependa de la pestaña activa.
  </p>

  <StylingHooks
    groups={[
      {
        file: "components/tabs.css",
        probe: "sk-tabs",
        title: "Tabs",
      },
    ]}
  />
</Base>
