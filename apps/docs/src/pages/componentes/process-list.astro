---
import "@skryensya/core/components/process-list.css";
import "@skryensya/core/components/code-preview.css";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { processListTree } from "../../demos/process-list";
import { getLocale, useTranslations } from "../../i18n";

/*
 * Authored on purpose, and it cannot be a usage tree yet.
 *
 * The first step's content is a CodePreview showing the install command, and `code-preview` has no
 * published contract. Everything around it (the list, the titles, the Stack, the Text, the Badge)
 * is expressible; the one block this walkthrough exists to hand you is not. A tree without it would
 * leave three steps of plain prose, which teaches less than this does. Revisit when code-preview is
 * published; that is F4 work, not F6.
 */

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;

const styles = `@import "@skryensya/core/components/process-list.css";
@import "@skryensya/core/components/code-preview.css";`;

/* A Process List is static instructional content, not workflow progress. */

---

<Base
  title="ProcessList"
  description="ProcessList: secuencia ordenada de instrucciones con marcadores conectados y contenido arbitrario."
>
  <h1>ProcessList</h1>
  <p class="lede">
    Una secuencia estática de instrucciones donde el contenido es lo principal. Usa un
    <code>&lt;ol&gt;</code> real, numera cada <code>&lt;li&gt;</code> y conecta visualmente los pasos sin
    convertirlos en estados de progreso.
  </p>

  <ComponentPreview tree={processListTree(t)} label="ProcessList" />

  <h2>Cuándo usarlo</h2>
  <ul>
    <li>
      Usa ProcessList para recetas, instalaciones y procedimientos cuyo orden importa.
    </li>
    <li>
      Usa <a href="/componentes/list">List</a> para colecciones de filas estáticas o interactivas.
    </li>
    <li>
      Usa <a href="/componentes/steps">Steps</a> cuando existan estados
      <code>complete</code>, <code>current</code> o <code>upcoming</code>.
    </li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" />

  <h2>Contrato</h2>
  <ul>
    <li>
      La raíz siempre es <code>&lt;ol class="sk-process-list"&gt;</code>.
    </li>
    <li>
      Cada instrucción es un <code>&lt;li class="sk-process-list__item"&gt;</code>.
    </li>
    <li>
      <code>sk-process-list__title</code> identifica el paso y
      <code>sk-process-list__content</code> admite cualquier contenido de flujo.
    </li>
    <li>
      El contador genera los números; no se escriben manualmente ni representan progreso.
    </li>
    <li>
      No existen estados persistentes ni filas completamente clicables. Para progreso usa Steps.
    </li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "components/process-list.css",
        probe: "sk-process-list",
      },
    ]}
  />
</Base>
