---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";

const install = `pnpm add @skryensya/core @skryensya/react`;

const styles = `@import "@skryensya/core/components/process-list.css";
@import "@skryensya/core/components/code-preview.css";`;

/* A Process List is static instructional content, not workflow progress. */
const html = `<ol
  class="sk-process-list"
  aria-label="Instalar @skryensya"
>
  <li class="sk-process-list__item">
    <div class="sk-process-list__content">
      <span class="sk-process-list__title">
        Instala la librería
      </span>
      <div class="sk-stack" data-gap="sm">
        <p class="sk-text" data-tone="secondary">
          Añade el núcleo y el binding de React al proyecto.
        </p>
        <div
          class="sk-code-preview"
          data-sk-code-preview
        >
          <div class="sk-code-preview__label">
            <span class="sk-code-preview__meta">
              <span>terminal</span>
            </span>
          </div>
          <div class="sk-code-preview__preview">
            <div class="sk-code-preview__viewport">
              <pre><code>pnpm add @skryensya/core \\
  @skryensya/react</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </li>
  <li class="sk-process-list__item">
    <div class="sk-process-list__content">
      <span class="sk-process-list__title">
        Importa ProcessList
      </span>
      <div class="sk-stack" data-gap="sm">
        <p class="sk-text" data-tone="secondary">
          Carga el CSS y después importa los componentes.
        </p>
        <ul>
          <li>
            <code>@import
  "@skryensya/core/components/code-preview.css";</code>
          </li>
          <li>
            <code>@import
  "@skryensya/core/components/process-list.css";</code>
          </li>
          <li>
            <code>import {
  ProcessList,
  ProcessListItem,
} from "@skryensya/react/process-list";</code>
          </li>
        </ul>
      </div>
    </div>
  </li>
  <li class="sk-process-list__item">
    <div class="sk-process-list__content">
      <span class="sk-process-list__title">
        Renderiza las instrucciones
      </span>
      <div class="sk-stack" data-gap="sm">
        <p class="sk-text" data-tone="secondary">
          El contador conserva la numeración sin estado adicional.
        </p>
        <code>&lt;ProcessList&gt;…&lt;/ProcessList&gt;</code>
        <div class="sk-inline" data-gap="sm">
          <span class="sk-badge" data-tone="success">
            Instalación lista
          </span>
          <a class="sk-link" href="/componentes/process-list">
            Abrir documentación
          </a>
        </div>
      </div>
    </div>
  </li>
</ol>`;

const react = `import { Badge } from "@skryensya/react/badge";
import { Inline, Stack } from "@skryensya/react/layout";
import { Link } from "@skryensya/react/link";
import {
  ProcessList,
  ProcessListItem,
} from "@skryensya/react/process-list";
import { Text } from "@skryensya/react/text";

<ProcessList aria-label="Instalar @skryensya">
  <ProcessListItem title="Instala la librería">
    <Stack gap="sm">
      <Text tone="secondary">
        Añade el núcleo y el binding de React al proyecto.
      </Text>
      <div
        className="sk-code-preview"
        data-sk-code-preview=""
      >
        <div className="sk-code-preview__label">
          <span className="sk-code-preview__meta">
            <span>terminal</span>
          </span>
        </div>
        <div className="sk-code-preview__preview">
          <div className="sk-code-preview__viewport">
            <pre><code>pnpm add @skryensya/core \\
  @skryensya/react</code></pre>
          </div>
        </div>
      </div>
    </Stack>
  </ProcessListItem>
  <ProcessListItem title="Importa ProcessList">
    <Stack gap="sm">
      <Text tone="secondary">
        Carga el CSS y después importa los componentes.
      </Text>
      <ul>
        <li>
          <code>@import
  "@skryensya/core/components/code-preview.css";</code>
        </li>
        <li>
          <code>@import
  "@skryensya/core/components/process-list.css";</code>
        </li>
        <li>
          <code>import {
  ProcessList,
  ProcessListItem,
} from "@skryensya/react/process-list";</code>
        </li>
      </ul>
    </Stack>
  </ProcessListItem>
  <ProcessListItem title="Renderiza las instrucciones">
    <Stack gap="sm">
      <Text tone="secondary">
        El contador conserva la numeración sin estado adicional.
      </Text>
      <code>{"<ProcessList>…</ProcessList>"}</code>
      <Inline gap="sm">
        <Badge tone="success">Instalación lista</Badge>
        <Link href="/componentes/process-list">
          Abrir documentación
        </Link>
      </Inline>
    </Stack>
  </ProcessListItem>
</ProcessList>;`;
---

<Base
  title="ProcessList"
  description="ProcessList: secuencia ordenada de instrucciones con marcadores conectados y contenido arbitrario."
>
  <h1>ProcessList</h1>
  <p class="lede">
    Una secuencia estática de instrucciones donde el contenido es lo principal. Usa un
    <code>&lt;ol&gt;</code> real, numera cada <code>&lt;li&gt;</code> y conecta visualmente los pasos sin
    convertirlos en estados de progreso.
  </p>

  <Showcase
    html={html}
    react={react}
    label="ProcessList de instalación"
    note="ol + contenido arbitrario + CodePreview"
  />

  <h2>Cuándo usarlo</h2>
  <ul>
    <li>
      Usa ProcessList para recetas, instalaciones y procedimientos cuyo orden importa.
    </li>
    <li>
      Usa <a href="/componentes/list">List</a> para colecciones de filas estáticas o interactivas.
    </li>
    <li>
      Usa <a href="/componentes/steps">Steps</a> cuando existan estados
      <code>complete</code>, <code>current</code> o <code>upcoming</code>.
    </li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" />

  <h2>Contrato</h2>
  <ul>
    <li>
      La raíz siempre es <code>&lt;ol class="sk-process-list"&gt;</code>.
    </li>
    <li>
      Cada instrucción es un <code>&lt;li class="sk-process-list__item"&gt;</code>.
    </li>
    <li>
      <code>sk-process-list__title</code> identifica el paso y
      <code>sk-process-list__content</code> admite cualquier contenido de flujo.
    </li>
    <li>
      El contador genera los números; no se escriben manualmente ni representan progreso.
    </li>
    <li>
      No existen estados persistentes ni filas completamente clicables. Para progreso usa Steps.
    </li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "components/process-list.css",
        probe: "sk-process-list",
      },
    ]}
  />
</Base>
