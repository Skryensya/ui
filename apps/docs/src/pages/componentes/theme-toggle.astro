---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import { ThemeToggleDemo } from "../../components/react-demos/theme-toggle";

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;

const html = `<div class="sk-inline" data-gap="md" data-align="center">
  <button
    class="sk-button sk-interactive sk-theme-toggle"
    data-sk-theme-toggle
    data-variant="ghost"
    data-icon-only
    type="button"
    aria-label="Modo: sistema"
    data-sk-theme-toggle-label-system="Modo: sistema"
    data-sk-theme-toggle-label-light="Modo: claro"
    data-sk-theme-toggle-label-dark="Modo: oscuro"
  >
    <span
      data-sk-icon="mode-system"
      data-sk-theme-toggle-icon="system"
    ></span>
    <span
      data-sk-icon="mode-light"
      data-sk-theme-toggle-icon="light"
    ></span>
    <span
      data-sk-icon="mode-dark"
      data-sk-theme-toggle-icon="dark"
    ></span>
  </button>
  <button
    class="sk-button sk-interactive sk-theme-toggle"
    data-sk-theme-toggle
    data-variant="ghost"
    data-size="sm"
    data-icon-only
    type="button"
    aria-label="Modo: sistema"
    data-sk-theme-toggle-label-system="Modo: sistema"
    data-sk-theme-toggle-label-light="Modo: claro"
    data-sk-theme-toggle-label-dark="Modo: oscuro"
  >
    <span
      data-sk-icon="mode-system"
      data-sk-theme-toggle-icon="system"
    ></span>
    <span
      data-sk-icon="mode-light"
      data-sk-theme-toggle-icon="light"
    ></span>
    <span
      data-sk-icon="mode-dark"
      data-sk-theme-toggle-icon="dark"
    ></span>
  </button>
</div>`;

const css = `@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/theme-toggle.css";`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
await initComponents();

// Persistencia (opcional): el enhancer aplica el modo;
// la app guarda la preferencia. La preferencia ya viene
// declarada, ver /almacenamiento.
import { setPreference } from "@skryensya/vanilla/storage";
import { colorModePreference } from "@skryensya/core/theme-toggle";

document.addEventListener("sk-theme-toggle-change", (event) => {
  setPreference(colorModePreference, event.detail.value);
});`;

const react = `import { ThemeToggle } from "@skryensya/react/theme-toggle";
import { IconSetProvider } from "@skryensya/react/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

const labels = {
  system: "Modo: sistema",
  light: "Modo: claro",
  dark: "Modo: oscuro",
};

<IconSetProvider set={lucideIcons}>
  <ThemeToggle labels={labels} />
  <ThemeToggle size="sm" labels={labels} />
</IconSetProvider>;`;
---

<Base
  title="Theme Toggle"
  description="Theme Toggle: cicla el modo de color system → claro → oscuro y re-tematiza con color-scheme."
>
  <h1>Theme Toggle</h1>
  <p class="lede">
    Theme Toggle cicla el <strong>modo de color</strong> (system → claro → oscuro → system). Es un
    Button ghost icon-only con tres caras apiladas; al hacer clic escribe
    <code>data-scheme</code> y <code>color-scheme</code> en <code>&lt;html&gt;</code> para que
    <code>light-dark()</code> re-tematice. El tamaño es el del Button:
    <strong>md</strong> (por defecto) o <code>data-size="sm"</code> /
    <code>size="sm"</code>. La persistencia la pone la app.
  </p>

  <Showcase
    html={html}
    js={js}
    react={react}
    label="Theme Toggle"
    note="md · sm"
  >
    <Fragment slot="react">
      <ThemeToggleDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Contrato</h2>
  <ul>
    <li>
      Las caras usan los roles estables <code>mode-system</code>, <code>mode-light</code> y
      <code>mode-dark</code>, marcadas con <code>data-sk-theme-toggle-icon</code>.
    </li>
    <li>
      El enhancer aplica el modo en <code>document.documentElement</code> y dispara
      <code>sk-theme-toggle-change</code> con <code>detail.value</code>.
    </li>
    <li>
      Un script FOUC en el <code>&lt;head&gt;</code> debe leer la preferencia guardada y pintar
      <code>data-scheme</code> / <code>color-scheme</code> antes del primer paint (ver
      <a href="/primer-componente">Primer componente</a>).
    </li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>CSS</h2>
  <CodeBlock code={css} label="CSS" lang="css" />
</Base>
