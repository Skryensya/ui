---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";

const disclosureIcon = `<span
        class="ds-tile__chevron"
        data-part="chevron"
        aria-hidden="true"
      >
        <span data-state="closed">
          <span data-ds-icon="chevron-down"></span>
        </span>
        <span data-state="open">
          <span data-ds-icon="chevron-up"></span>
        </span>
      </span>`;

const single = `<div
  class="ds-accordion"
  data-ds-accordion
  data-type="single"
  data-default-value="environment"
>
  <section
    class="ds-tile ds-tile--expandable ds-interactive"
    data-part="item"
    data-value="environment"
  >
    <button
      type="button"
      class="ds-tile__trigger"
      data-part="trigger"
      aria-expanded="true"
      aria-controls="environment-content"
    >
      <span class="ds-tile__content">
        <span class="ds-tile__title">Entorno</span>
        <span class="ds-tile__description">
          Producción · Fráncfort
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="environment-content"
      class="ds-tile__expandable-content"
      data-part="content"
    >
      <div class="ds-stack" data-gap="sm">
        <p class="ds-tile__description">
          Node 22 corre en tres réplicas detrás del balanceador de
          Fráncfort. El tráfico se reparte por round-robin y una
          réplica se recicla sola si falla dos health checks
          seguidos.
        </p>
        <p class="ds-tile__description">
          Los secretos se inyectan en el arranque desde el vault
          regional, así que ningún valor sensible queda en la
          imagen ni en el log de build.
        </p>
      </div>
    </div>
  </section>
</div>`;

const exclusive = `<div
  class="ds-accordion"
  data-ds-accordion
  data-type="single"
  data-default-value="runtime"
>
  <section
    class="ds-tile ds-tile--expandable ds-interactive"
    data-part="item"
    data-value="runtime"
  >
    <button
      type="button"
      class="ds-tile__trigger"
      data-part="trigger"
      aria-expanded="true"
      aria-controls="runtime-content"
    >
      <span class="ds-tile__content">
        <span class="ds-tile__title">Runtime</span>
        <span class="ds-tile__description">
          Versión y región
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="runtime-content"
      class="ds-tile__expandable-content"
      data-part="content"
    >
      <div class="ds-stack" data-gap="sm">
        <p class="ds-tile__description">
          Node 22 sobre el pool compartido de Fráncfort. Cada
          despliegue reserva dos vCPU y 512 MB, con autoscaling
          hasta seis réplicas cuando la cola de peticiones
          supera el umbral.
        </p>
        <p class="ds-tile__description">
          El healthcheck pega a <code>/status</code> cada diez
          segundos; tres fallos seguidos sacan la réplica del
          balanceador sin cortar el tráfico en vuelo.
        </p>
      </div>
    </div>
  </section>
  <section
    class="ds-tile ds-tile--expandable ds-interactive"
    data-part="item"
    data-value="rollout"
  >
    <button
      type="button"
      class="ds-tile__trigger"
      data-part="trigger"
      aria-expanded="false"
      aria-controls="rollout-content"
    >
      <span class="ds-tile__content">
        <span class="ds-tile__title">Rollout</span>
        <span class="ds-tile__description">
          Canary por porcentaje
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="rollout-content"
      class="ds-tile__expandable-content"
      data-part="content"
      hidden
    >
      <div class="ds-stack" data-gap="sm">
        <p class="ds-tile__description">
          El canary sube en tres tramos, 10%, 50% y 100%, y
          espera a que las métricas de error y latencia se
          mantengan estables antes de avanzar a cada tramo.
        </p>
        <p class="ds-tile__description">
          Si un tramo degrada, el rollout se detiene solo y
          avisa al canal de guardia: nada avanza sin luz verde.
        </p>
      </div>
    </div>
  </section>
  <section
    class="ds-tile ds-tile--expandable ds-interactive"
    data-part="item"
    data-value="rollback"
  >
    <button
      type="button"
      class="ds-tile__trigger"
      data-part="trigger"
      aria-expanded="false"
      aria-controls="rollback-content"
    >
      <span class="ds-tile__content">
        <span class="ds-tile__title">Rollback</span>
        <span class="ds-tile__description">
          Versión estable anterior
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="rollback-content"
      class="ds-tile__expandable-content"
      data-part="content"
      hidden
    >
      <p class="ds-tile__description">
        Restaura v2.18.4 si el canary falla las comprobaciones.
      </p>
    </div>
  </section>
</div>`;

/* Same group as exclusive, but multiple can keep several items open
   and needs unique content ids so both demos can live on one page. */
