        </p>
      </div>
    </div>
  </section>
  <section
    class="ds-tile ds-tile--expandable ds-interactive"
    data-part="item"
    data-value="rollback"
  >
    <button
      type="button"
      class="ds-tile__trigger"
      data-part="trigger"
      aria-expanded="false"
      aria-controls="multiple-rollback-content"
    >
      <span class="ds-tile__content">
        <span class="ds-tile__title">Rollback</span>
        <span class="ds-tile__description">
          Versión estable anterior
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="multiple-rollback-content"
      class="ds-tile__expandable-content"
