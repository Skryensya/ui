---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/accordion.css";
/* The "Details nativo" preview paints `.sk-details*`, and the page told the reader to import this
   stylesheet without importing it itself: the stage rendered as bare <details> with the browser's
   own marker. A preview frame copies the PAGE's styles, so a sheet the page never loads is a sheet
   the stage never gets. */
import "@skryensya/core/components/details.css";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import {
  AccordionExclusiveDemo,
  AccordionMultipleDemo,
  AccordionSingleDemo,
} from "../../components/react-demos/accordion";

const disclosureIcon = `<span
        class="sk-tile__chevron"
        data-part="chevron"
        aria-hidden="true"
      >
        <span data-state="closed">
          <span data-sk-icon="chevron-down"></span>
        </span>
        <span data-state="open">
          <span data-sk-icon="chevron-up"></span>
        </span>
      </span>`;

const single = `<div
  class="sk-accordion"
  data-sk-accordion
  data-type="single"
  data-default-value="environment"
>
  <section
    class="sk-tile sk-tile--interactive sk-tile--expandable sk-interactive"
    data-part="item"
    data-value="environment"
  >
    <button
      type="button"
      class="sk-tile__trigger"
      data-part="trigger"
      aria-expanded="true"
      aria-controls="environment-content"
    >
      <span class="sk-tile__content">
        <span class="sk-tile__title">Entorno</span>
        <span class="sk-tile__description">
          Producción · Fráncfort
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="environment-content"
      class="sk-tile__expandable-content"
      data-part="content"
    >
      <div class="sk-stack" data-gap="sm">
        <p class="sk-tile__description">
          Node 22 corre en tres réplicas detrás del balanceador de
          Fráncfort. El tráfico se reparte por round-robin y una
          réplica se recicla sola si falla dos health checks
          seguidos.
        </p>
        <p class="sk-tile__description">
          Los secretos se inyectan en el arranque desde el vault
          regional, así que ningún valor sensible queda en la
          imagen ni en el log de build.
        </p>
      </div>
    </div>
  </section>
</div>`;

const exclusive = `<div
  class="sk-accordion"
  data-sk-accordion
  data-type="single"
  data-default-value="runtime"
>
  <section
    class="sk-tile sk-tile--interactive sk-tile--expandable sk-interactive"
    data-part="item"
    data-value="runtime"
  >
    <button
      type="button"
      class="sk-tile__trigger"
      data-part="trigger"
      aria-expanded="true"
      aria-controls="runtime-content"
    >
      <span class="sk-tile__content">
        <span class="sk-tile__title">Runtime</span>
        <span class="sk-tile__description">
          Versión y región
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="runtime-content"
      class="sk-tile__expandable-content"
      data-part="content"
    >
      <div class="sk-stack" data-gap="sm">
        <p class="sk-tile__description">
          Node 22 sobre el pool compartido de Fráncfort. Cada
          despliegue reserva dos vCPU y 512 MB, con autoscaling
          hasta seis réplicas cuando la cola de peticiones
          supera el umbral.
        </p>
        <p class="sk-tile__description">
          El healthcheck pega a <code>/status</code> cada diez
          segundos; tres fallos seguidos sacan la réplica del
          balanceador sin cortar el tráfico en vuelo.
        </p>
      </div>
    </div>
  </section>
  <section
    class="sk-tile sk-tile--interactive sk-tile--expandable sk-interactive"
    data-part="item"
    data-value="rollout"
  >
    <button
      type="button"
      class="sk-tile__trigger"
      data-part="trigger"
      aria-expanded="false"
      aria-controls="rollout-content"
    >
      <span class="sk-tile__content">
        <span class="sk-tile__title">Rollout</span>
        <span class="sk-tile__description">
          Canary por porcentaje
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="rollout-content"
      class="sk-tile__expandable-content"
      data-part="content"
      hidden
    >
      <div class="sk-stack" data-gap="sm">
        <p class="sk-tile__description">
          El canary sube en tres tramos, 10%, 50% y 100%, y
          espera a que las métricas de error y latencia se
          mantengan estables antes de avanzar a cada tramo.
        </p>
        <p class="sk-tile__description">
          Si un tramo degrada, el rollout se detiene solo y
          avisa al canal de guardia: nada avanza sin luz verde.
        </p>
      </div>
    </div>
  </section>
  <section
    class="sk-tile sk-tile--interactive sk-tile--expandable sk-interactive"
    data-part="item"
    data-value="rollback"
  >
    <button
      type="button"
      class="sk-tile__trigger"
      data-part="trigger"
      aria-expanded="false"
      aria-controls="rollback-content"
    >
      <span class="sk-tile__content">
        <span class="sk-tile__title">Rollback</span>
        <span class="sk-tile__description">
          Versión estable anterior
        </span>
      </span>
      ${disclosureIcon}
    </button>
    <div
      id="rollback-content"
      class="sk-tile__expandable-content"
      data-part="content"
      hidden
    >
      <p class="sk-tile__description">
        Restaura v2.18.4 si el canary falla las comprobaciones.
      </p>
    </div>
  </section>
</div>`;

