const install = `pnpm add @skryensya/core @skryensya/react`;

const services = ["API", "Worker", "Gateway", "Billing", "Auth", "Search"] as const;
const envs = ["prod", "staging", "dev"] as const;
const statuses = ["Exitoso", "En curso", "Fallido"] as const;

const pagerRows = Array.from({ length: 28 }, (_, index) => {
