---
import "@skryensya/core/components/flyout.css";
import "@skryensya/core/components/select.css";
import Base from "../../layouts/Base.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import {
  tableInBoxTree,
  tableStickyColumnTree,
  tableStickyHeaderTree,
  tableTree,
} from "../../demos/table";
import { getLocale, useTranslations } from "../../i18n";
import CodeBlock from "../../components/CodeBlock.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import DimensionSelect from "../../components/DimensionSelect.astro";
import {
  TableBasicDemo,
  TablePagerDemo,
  TableStickyColumnDemo,
  TableStickyHeaderDemo,
} from "../../components/react-demos/table";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;

const services = ["API", "Worker", "Gateway", "Billing", "Auth", "Search"] as const;
const envs = ["prod", "staging", "dev"] as const;
const statuses = ["Exitoso", "En curso", "Fallido"] as const;

const pagerRows = Array.from({ length: 28 }, (_, index) => {
  const n = index + 1;
  return {
    id: `dep-${1040 + n}`,
    service: services[index % services.length],
    env: envs[index % envs.length],
    status: statuses[index % statuses.length],
    when: n === 1 ? "Hace 2 min" : n < 10 ? `Hace ${n * 3} min` : `Hace ${n} h`,
  };
});

const html = `<div class="sk-table-scroll">
  <table class="sk-table">
    <caption class="sk-table__caption">Planes disponibles</caption>
    <thead class="sk-table__head">
      <tr class="sk-table__row">
        <th class="sk-table__header" scope="col">Plan</th>
        <th class="sk-table__header" scope="col">Uso</th>
        <th class="sk-table__header" scope="col">Estado</th>
      </tr>
    </thead>
    <tbody class="sk-table__body">
      <tr class="sk-table__row">
        <th class="sk-table__header" scope="row">Starter</th>
        <td class="sk-table__cell">Equipos pequeños</td>
        <td class="sk-table__cell">Activo</td>
      </tr>
    </tbody>
    <tfoot class="sk-table__foot">
      <tr class="sk-table__row">
        <td class="sk-table__cell" colspan="3">
          Los precios no incluyen impuestos.
        </td>
      </tr>
    </tfoot>
  </table>
</div>`;

const densityTable = (factor: string) => `<div
  data-sk-density-scope
  style="--sk-density-factor: ${factor}"
>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <caption class="sk-table__caption">
        Actividad de servicios
      </caption>
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="col">Servicio</th>
          <th class="sk-table__header" scope="col">Estado</th>
          <th class="sk-table__header" scope="col">
            Última actividad
          </th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="row">API</th>
          <td class="sk-table__cell">Estable</td>
          <td class="sk-table__cell">Hace 2 min</td>
        </tr>
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="row">Worker</th>
          <td class="sk-table__cell">Estable</td>
          <td class="sk-table__cell">Hace 8 min</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>`;

const spaciousDensityHtml = densityTable("1.2");
const compactDensityHtml = densityTable("0.6");

const react = `import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableFooter,
  TableHead,
  TableHeader,
  TableRow,
  TableScroll,
} from "@skryensya/react/table";

function Example() {
  return (
    <TableScroll>
      <Table>
        <TableCaption>Planes disponibles</TableCaption>
        <TableHead>
          <TableRow>
            <TableHeader>Plan</TableHeader>
            <TableHeader>Uso</TableHeader>
            <TableHeader>Estado</TableHeader>
          </TableRow>
        </TableHead>
        <TableBody>
          <TableRow>
            <TableHeader scope="row">Starter</TableHeader>
            <TableCell>Equipos pequeños</TableCell>
            <TableCell>Activo</TableCell>
          </TableRow>
        </TableBody>
        <TableFooter>
          <TableRow>
            <TableCell colSpan={3}>
              Los precios no incluyen impuestos.
            </TableCell>
          </TableRow>
        </TableFooter>
      </Table>
    </TableScroll>
  );
}`;

const pagerRowHtml = (row: (typeof pagerRows)[number]) => `        <tr
          class="sk-table__row"
          data-sk-table-pager-row
        >
          <th class="sk-table__header" scope="row">${row.id}</th>
          <td class="sk-table__cell">${row.service}</td>
          <td class="sk-table__cell">${row.env}</td>
          <td class="sk-table__cell">${row.status}</td>
          <td class="sk-table__cell">${row.when}</td>
        </tr>`;

const pagerShell = (tbody: string) => `<div
  class="sk-table-pager"
  data-sk-table-pager
  data-page-size="5"
  data-status-template="{start}–{end} de {total}"
  data-previous-label="Página anterior"
  data-next-label="Página siguiente"
  data-page-label="Página"
>
  <div
    aria-label="Despliegues recientes"
    class="sk-table-scroll"
    data-sticky-column
    role="region"
    tabindex="0"
  >
    <table class="sk-table" data-layout="fixed">
      <caption class="sk-table__caption">
        Despliegues recientes
      </caption>
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header" scope="col">ID</th>
          <th class="sk-table__header" scope="col">Servicio</th>
          <th class="sk-table__header" scope="col">Entorno</th>
          <th class="sk-table__header" scope="col">Estado</th>
          <th class="sk-table__header" scope="col">Cuándo</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
${tbody}
      </tbody>
    </table>
  </div>

  <div class="sk-table-pager__bar">
    <div class="sk-table-pager__size">
      <div class="sk-select" data-sk-select data-value="5">
        <label class="sk-select__label" data-sk-select-label>
          Filas por página
        </label>
        <button
          class="sk-select__trigger sk-anchor sk-interactive"
          data-sk-select-trigger
          type="button"
        >
          <span class="sk-select__value" data-sk-select-value>
            5
          </span>
          <span
            class="sk-select__indicator"
            data-sk-select-indicator
            aria-hidden="true"
          >
            <span data-state="closed">
              <span data-sk-icon="chevron-down"></span>
            </span>
            <span data-state="open">
              <span data-sk-icon="chevron-up"></span>
            </span>
          </span>
        </button>
        <div
          class="sk-select__positioner sk-anchored"
          data-sk-select-positioner
        >
          <ul class="sk-select__content" data-sk-select-content>
            <li
              class="sk-select__item sk-interactive"
              data-sk-select-item
              data-value="5"
            >
              5
            </li>
            <li
              class="sk-select__item sk-interactive"
              data-sk-select-item
              data-value="10"
            >
              10
            </li>
            <li
              class="sk-select__item sk-interactive"
              data-sk-select-item
              data-value="25"
            >
              25
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="sk-table-pager__end">
      <div
        class="sk-table-pager__status"
        data-sk-table-pager-status
      ></div>

      <nav
        class="sk-pagination"
        aria-label="Paginación"
        data-sk-table-pager-nav
      ></nav>
    </div>
  </div>
</div>`;

const pagedCode = pagerShell(
  [
    ...pagerRows.slice(0, 2).map(pagerRowHtml),
    `        <!-- … ${pagerRows.length - 2} filas más con data-sk-table-pager-row -->`,
  ].join("\n"),
);

const pagedCodeFull = pagerShell(pagerRows.map(pagerRowHtml).join("\n"));


const pagedReact = `import { useMemo, useState } from "react";
import { Icon } from "@skryensya/react/icon";
import { Pagination } from "@skryensya/react/pagination";
import { Select } from "@skryensya/react/select";
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
  TableScroll,
} from "@skryensya/react/table";

const PAGE_SIZES = ["5", "10", "25"] as const;

function DeploymentsTable({ rows }: { rows: Deployment[] }) {
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] =
    useState<(typeof PAGE_SIZES)[number]>("5");

  const size = Number(pageSize);
  const pageCount = Math.max(1, Math.ceil(rows.length / size));
  const current = Math.min(page, pageCount);
  const slice = useMemo(() => {
    const start = (current - 1) * size;
    return rows.slice(start, start + size);
  }, [current, rows, size]);

  const start = (current - 1) * size + 1;
  const end = Math.min(current * size, rows.length);

  return (
    <div className="sk-table-pager">
      <TableScroll
        aria-label="Despliegues recientes"
        role="region"
        stickyColumn
        tabIndex={0}
      >
        <Table data-layout="fixed">
          <TableCaption>Despliegues recientes</TableCaption>
          <TableHead>
            <TableRow>
              <TableHeader>ID</TableHeader>
              <TableHeader>Servicio</TableHeader>
              <TableHeader>Entorno</TableHeader>
              <TableHeader>Estado</TableHeader>
              <TableHeader>Cuándo</TableHeader>
            </TableRow>
          </TableHead>
          <TableBody>
            {slice.map((row) => (
              <TableRow key={row.id}>
                <TableHeader scope="row">{row.id}</TableHeader>
                <TableCell>{row.service}</TableCell>
                <TableCell>{row.env}</TableCell>
                <TableCell>{row.status}</TableCell>
                <TableCell>{row.when}</TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </TableScroll>

      <div className="sk-table-pager__bar">
        <div className="sk-table-pager__size">
          <Select
            label="Filas por página"
            defaultValue={["5"]}
            indicator={<Icon name="chevron-down" />}
            openIndicator={<Icon name="chevron-up" />}
            itemIndicator={<Icon name="check" />}
            options={PAGE_SIZES.map((n) => ({ value: n, label: n }))}
            onValueChange={(details) => {
              const next = details.value[0];
              if (next === "5" || next === "10" || next === "25") {
                setPageSize(next);
                setPage(1);
              }
            }}
          />
        </div>
        <div className="sk-table-pager__end">
          <div className="sk-table-pager__status">
            {start}–{end} de {rows.length}
          </div>
          <Pagination
            page={current}
            total={pageCount}
            onPageChange={setPage}
            label="Paginación"
            previousLabel="Página anterior"
            nextLabel="Página siguiente"
          />
        </div>
      </div>
    </div>
  );
}`;---

<Base
  title="Table"
  description="Tabla nativa legible con scroll horizontal y filas o columnas sticky."
>
  <h1>Table</h1>
  <p class="lede">
    Table mantiene la semántica nativa de
    <code>&lt;table&gt;</code>. El wrapper de overflow preserva un
    ancho legible por columna y desplaza la tabla en vez de
    comprimirla. Header y primera columna sticky son opt-in y usan el
    mismo contrato en móvil y desktop.
  </p>

  <ComponentPreview tree={tableTree(t)} label="Table" />

  <h2>Scroll horizontal sin comprimir</h2>
  <p>
    Dentro de <code>.sk-table-scroll</code>, cada celda conserva el
    piso <code>--sk-table-cell-min-inline-size</code>; los encabezados
    de fila conservan uno mayor. Una tabla
    <code>data-layout="fixed"</code> usa además
    <code>--sk-table-fixed-min-inline-size</code>. En pantallas
    estrechas aparece scroll, no columnas de 56px ni texto letra por
    letra. El wrapper admite foco para desplazamiento por teclado y
    pinta un scrollbar compacto pero visible.
  </p>

  <h2>Primera columna sticky</h2>
  <p>
    Usa <code>data-sticky-column</code> en HTML o
    <code>stickyColumn</code> en React. La primera celda de cada fila
    queda congelada y su sombra separa el identificador de los datos
    que pasan por debajo. Conviene que sea un
    <code>&lt;th scope="row"&gt;</code>. No depende de un breakpoint:
    funciona igual con touch, mouse, zoom o una ventana angosta.
  </p>
  <ComponentPreview tree={tableStickyColumnTree(t)} label="Primera columna sticky" />

  <h2>Header row sticky</h2>
  <p>
    Usa <code>data-sticky-header</code> o
    <code>stickyHeader</code>. El wrapper gana scroll vertical y un
    alto máximo de <code>20rem</code>, que puedes sobrescribir como
    en este ejemplo. El encabezado queda visible tanto en desktop
    como en móvil; si combinas ambos modifiers, la celda de la esquina
    queda sobre las dos capas.
  </p>
  <ComponentPreview tree={tableStickyHeaderTree(t)} label="Header row sticky" />

  <h2>Con paginación</h2>
  <p>
    <code>data-sk-table-pager</code> es el enhancer vanilla;
    <code>sk-table-pager</code> es el pattern de layout (tabla + barra). Marcas las filas, dejas el
    <code>nav</code> vacío y (opcional) un status y un
    <a class="sk-link sk-interactive" href="/componentes/select"><code>Select</code></a>
    de tamaño de página. El tamaño va al inicio de la barra; status y
    <a class="sk-link sk-interactive" href="/componentes/pagination"><code>Pagination</code></a>
    van juntos en <code>sk-table-pager__end</code>. Usa <code>data-layout="fixed"</code> para que no
    bailen los anchos de columna.
  </p>
  <ComponentPreview
    code={pagedCode}
    codeFull={pagedCodeFull}
    react={pagedReact}
    label="Table + Pagination"
    lang="html"
  >
    <div
      class="sk-table-pager"
      data-sk-table-pager
      data-page-size="5"
      data-status-template={"{start}–{end} de {total}"}
      data-previous-label="Página anterior"
      data-next-label="Página siguiente"
      data-page-label="Página"
    >
      <div
        aria-label="Despliegues recientes"
        class="sk-table-scroll"
        data-sticky-column
        role="region"
        tabindex="0"
      >
        <table class="sk-table" data-layout="fixed">
          <caption class="sk-table__caption">Despliegues recientes</caption>
          <thead class="sk-table__head">
            <tr class="sk-table__row">
              <th class="sk-table__header" scope="col">ID</th>
              <th class="sk-table__header" scope="col">Servicio</th>
              <th class="sk-table__header" scope="col">Entorno</th>
              <th class="sk-table__header" scope="col">Estado</th>
              <th class="sk-table__header" scope="col">Cuándo</th>
            </tr>
          </thead>
          <tbody class="sk-table__body">
            {
              pagerRows.map((row) => (
                <tr class="sk-table__row" data-sk-table-pager-row>
                  <th class="sk-table__header" scope="row">{row.id}</th>
                  <td class="sk-table__cell">{row.service}</td>
                  <td class="sk-table__cell">{row.env}</td>
                  <td class="sk-table__cell">{row.status}</td>
                  <td class="sk-table__cell">{row.when}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="sk-table-pager__bar">
        <div class="sk-table-pager__size">
          <DimensionSelect
            id="table-page-size"
            label="Filas por página"
            value="5"
            options={[
              { value: "5", label: "5" },
              { value: "10", label: "10" },
              { value: "25", label: "25" },
            ]}
          />
        </div>
        <div class="sk-table-pager__end">
          <div class="sk-table-pager__status" data-sk-table-pager-status></div>
          <nav class="sk-pagination" aria-label="Paginación" data-sk-table-pager-nav></nav>
        </div>
      </div>
    </div>
    <Fragment slot="react">
      <TablePagerDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Dentro de un Box</h2>
  <p>
    Dentro del <code>padding</code> de un <code>.sk-box</code>, la <code>.sk-table</code> redondea con el
    radio de elemento anidado (<code>--radius-control</code>) en vez del de superficie: Box aporta la
    superficie y la tabla es un elemento dentro de ella. Así el radio queda más ajustado, nunca colapsa
    a una caja cuadrada, y sigue acompañando al eje <code>data-radius</code>.
  </p>
  <ComponentPreview tree={tableInBoxTree(t)} label="Table en Box" />

  <h2>Densidad local</h2>
  <p>
    El contrato del scope es solo <code>data-sk-density-scope</code> y un valor de densidad. Aquí
    <code>--sk-density-factor</code> es relativo al sistema; escribe <code>--sk-density</code> en el
    mismo nodo si necesitas un valor absoluto. Los números siguen siendo continuos.
  </p>
  <ComponentPreview html={spaciousDensityHtml} label="Table amplia · 1.2× del sistema" />
  <ComponentPreview html={compactDensityHtml} label="Table compacta · 0.6× del sistema" />

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />

  <h2>React</h2>
  <p>
    El binding está en <strong>Vanilla | React</strong>. En Vanilla basta el HTML con
    <code>data-sk-*</code>; <code>initComponents</code> (y <code>mountIcons</code>) los carga el sitio.
  </p>
  <StylingHooks groups={[{ file: "components/table.css", probe: "sk-table" }]} />
</Base>

