---
import Base from "../../layouts/Base.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import "@skryensya/core/components/split-button.css";
import "@skryensya/core/components/menu.css";
import { SplitButtonDemo } from "../../components/react-demos/split-button";

const install = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/split-button.css";
@import "@skryensya/core/components/menu.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
const html = `<div class="sk-split-button">
  <button
    class="sk-button sk-interactive sk-split-button__primary"
    data-variant="primary"
    type="button"
  >
    Guardar
  </button>
  <div class="sk-menu" data-sk-menu aria-label="Más opciones">
    <button
      class="
        sk-button sk-interactive
        sk-menu__trigger sk-anchor sk-split-button__trigger
      "
      data-sk-menu-trigger
      type="button"
    >
      <span data-sk-icon="chevron-down"></span>
    </button>
    <div class="sk-menu__positioner sk-anchored" data-sk-menu-positioner>
      <div class="sk-menu__content" data-sk-menu-content>
        <div
          class="sk-menu__item sk-interactive"
          data-sk-menu-item
          data-value="save-copy"
        >Guardar una copia</div>
      </div>
    </div>
  </div>
</div>`;
const react = `import { Icon } from "@skryensya/react/icon";
import { SplitButton } from "@skryensya/react/split-button";

function Example() {
  return (
    <SplitButton
      menuLabel="Más opciones"
      menuIndicator={<Icon name="chevron-down" />}
      menuItems={[
        { label: "Guardar una copia", value: "save-copy" },
      ]}
      onClick={SomeFunction}
    >
      Guardar
    </SplitButton>
  );
}`;
---

<Base
  title="SplitButton"
  description="Acción principal estable y menú adyacente con acciones alternativas."
>
  <h1>SplitButton</h1>
  <p class="lede">Acción principal estable y menú adyacente con acciones alternativas.</p>

  <h2>Instalación</h2>
  <Showcase
    html={html}
    js={js}
    react={react}
    label="SplitButton"
    viewport="menu"
  >
    <Fragment slot="react">
      <SplitButtonDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Contrato</h2>
  <p>La acción principal no cambia silenciosamente al elegir el menú. Si no hay una acción dominante, usa Menu.</p>

  <h2>Accesibilidad</h2>
  <p>Son dos botones independientes: uno ejecuta y el otro anuncia y abre las alternativas.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/split-button.css",
        probe: "sk-split-button",
        title: "SplitButton",
      },
      { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
    ]}
  />
</Base>
