---
import Base from "../../layouts/Base.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { comboboxTree } from "../../demos/combobox";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/combobox.css";
import "@skryensya/core/components/field.css";
import "@skryensya/core/patterns/scrollbar.css";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const install = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/field.css";
@import "@skryensya/core/components/combobox.css";
/* La lista hace scroll: el riel lo pinta el pattern, marcado con sk-scrollbar. */
@import "@skryensya/core/patterns/scrollbar.css";`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
---

<Base
  title="Combobox"
  description="Sugerencias editables con estados claros, ayuda contextual y navegación completa por teclado."
>
  <h1>Combobox</h1>
  <p class="lede">Sugerencias editables con contexto, estados claros y navegación completa por teclado.</p>

  <h2>Instalación</h2>
  <ComponentPreview tree={comboboxTree(t, locale)} js={js}
    label="Combobox"
    viewport="menu"
  />

  <h2>Contrato</h2>
  <p>
    Combobox filtra una colección autorada sin reemplazar sus opciones. Select
    conserva una lista cerrada e Input no muestra sugerencias.
  </p>
  <p>
    Lo escrito es trabajo del usuario: salir del campo sin elegir nada
    (desenfocar, clic afuera, Escape) cierra la lista pero <strong
      >no borra la búsqueda</strong
    >. Sólo elegir una opción reescribe el input (con la etiqueta elegida), y
    sólo el ✕ lo vacía. Al reabrir, el filtro vuelve a la lista completa: lo que
    se ve es la selección, no el último texto tipeado.
  </p>

  <h2>Accesibilidad</h2>
  <p>
    El foco permanece en el input mientras <code>aria-activedescendant</code>
    señala la opción activa. Flecha abajo y arriba recorren resultados, Enter
    selecciona y Escape cierra. <code>hint</code> y <code>error</code> se
    enlazan mediante <code>aria-describedby</code>; los cambios en la cantidad
    de resultados se anuncian con una región de estado.
  </p>
  <p>
    Recorrer con el teclado mueve el anillo de foco al ítem resaltado (foco
    virtual) y el control cede el suyo: hay un solo anillo en pantalla y viaja
    hacia la lista y de vuelta. Con el puntero no aparece anillo (un anillo
    siguiendo al cursor se lee como foco roto), sólo la capa de estado.
  </p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/combobox.css",
        probe: "sk-combobox",
        title: "Combobox",
      },
      { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
      { file: "components/button.css", probe: "sk-button", title: "Heredados de Button" },
    ]}
  />
</Base>
