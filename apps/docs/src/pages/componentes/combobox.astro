---
import Base from "../../layouts/Base.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { ComboboxBasicDemo } from "../../components/react-demos/combobox";
import "@skryensya/core/components/combobox.css";
import "@skryensya/core/components/field.css";
import "@skryensya/core/patterns/scrollbar.css";

/*
 * The full roster of countries, in Spanish, alphabetical. `value` is derived from the name so the
 * data stays a plain list: accents stripped, spaced/punctuated runs collapsed to single hyphens.
 * The combobox filters this whole set client-side, so "all countries" costs no more markup logic
 * than the four it used to ship — only more rows.
 */
const slug = (name: string) =>
  name
    .normalize("NFD")
    .replace(/\p{M}+/gu, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const countries = [
  "Afganistán", "Albania", "Alemania", "Andorra", "Angola", "Antigua y Barbuda",
  "Arabia Saudita", "Argelia", "Argentina", "Armenia", "Australia", "Austria",
  "Azerbaiyán", "Bahamas", "Bangladés", "Barbados", "Baréin", "Bélgica", "Belice",
  "Benín", "Bielorrusia", "Birmania", "Bolivia", "Bosnia y Herzegovina", "Botsuana",
  "Brasil", "Brunéi", "Bulgaria", "Burkina Faso", "Burundi", "Bután", "Cabo Verde",
  "Camboya", "Camerún", "Canadá", "Catar", "Chad", "Chile", "China", "Chipre",
  "Ciudad del Vaticano", "Colombia", "Comoras", "Corea del Norte", "Corea del Sur",
  "Costa de Marfil", "Costa Rica", "Croacia", "Cuba", "Dinamarca", "Dominica",
  "Ecuador", "Egipto", "El Salvador", "Emiratos Árabes Unidos", "Eritrea",
  "Eslovaquia", "Eslovenia", "España", "Estados Unidos", "Estonia", "Esuatini",
  "Etiopía", "Filipinas", "Finlandia", "Fiyi", "Francia", "Gabón", "Gambia",
  "Georgia", "Ghana", "Granada", "Grecia", "Guatemala", "Guyana", "Guinea",
  "Guinea-Bisáu", "Guinea Ecuatorial", "Haití", "Honduras", "Hungría", "India",
  "Indonesia", "Irak", "Irán", "Irlanda", "Islandia", "Islas Marshall",
  "Islas Salomón", "Israel", "Italia", "Jamaica", "Japón", "Jordania",
  "Kazajistán", "Kenia", "Kirguistán", "Kiribati", "Kuwait", "Laos", "Lesoto",
  "Letonia", "Líbano", "Liberia", "Libia", "Liechtenstein", "Lituania",
  "Luxemburgo", "Macedonia del Norte", "Madagascar", "Malasia", "Malaui",
  "Maldivas", "Malí", "Malta", "Marruecos", "Mauricio", "Mauritania", "México",
  "Micronesia", "Moldavia", "Mónaco", "Mongolia", "Montenegro", "Mozambique",
  "Namibia", "Nauru", "Nepal", "Nicaragua", "Níger", "Nigeria", "Noruega",
  "Nueva Zelanda", "Omán", "Países Bajos", "Pakistán", "Palaos", "Panamá",
  "Papúa Nueva Guinea", "Paraguay", "Perú", "Polonia", "Portugal", "Reino Unido",
  "República Centroafricana", "República Checa", "República del Congo",
  "República Democrática del Congo", "República Dominicana", "Ruanda", "Rumanía",
  "Rusia", "Samoa", "San Cristóbal y Nieves", "San Marino",
  "San Vicente y las Granadinas", "Santa Lucía", "Santo Tomé y Príncipe",
  "Senegal", "Serbia", "Seychelles", "Sierra Leona", "Singapur", "Siria",
  "Somalia", "Sri Lanka", "Sudáfrica", "Sudán", "Sudán del Sur", "Suecia",
  "Suiza", "Surinam", "Tailandia", "Tanzania", "Tayikistán", "Timor Oriental",
  "Togo", "Tonga", "Trinidad y Tobago", "Túnez", "Turkmenistán", "Turquía",
  "Tuvalu", "Ucrania", "Uganda", "Uruguay", "Uzbekistán", "Vanuatu", "Venezuela",
  "Vietnam", "Yemen", "Yibuti", "Zambia", "Zimbabue",
];

const countryItems = countries
  .map(
    (name) => `      <div
        class="sk-combobox__item sk-interactive"
        data-sk-combobox-item
        data-value="${slug(name)}"
        data-value-text="${name}"
      >
        <span
          class="sk-combobox__item-label"
          data-sk-combobox-item-text
        >
          ${name}
        </span>
        <span
          class="sk-combobox__item-indicator"
          data-sk-combobox-item-indicator
        >
          <span data-sk-icon="check"></span>
        </span>
      </div>`,
  )
  .join("\n");

const install = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/field.css";
@import "@skryensya/core/components/combobox.css";
/* La lista hace scroll: el riel lo pinta el pattern, marcado con sk-scrollbar. */
@import "@skryensya/core/patterns/scrollbar.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
const html = `<div class="sk-field sk-combobox" data-sk-combobox>
  <label
    class="sk-field__label sk-combobox__label"
    data-sk-combobox-label
  >
    País
  </label>
  <div class="sk-field__hint" data-sk-combobox-hint>
    Escribe para filtrar. Usa las flechas para recorrer.
  </div>
  <div class="sk-combobox__control sk-anchor" data-sk-combobox-control>
    <div class="sk-combobox__value" data-sk-combobox-value>
      <input
        class="sk-combobox__input"
        data-sk-combobox-input
        placeholder="Buscar país"
      />
    </div>
    <button
      class="sk-combobox__clear sk-button sk-interactive"
      data-sk-button
      data-sk-combobox-clear
      data-icon-only
      data-size="sm"
      data-variant="ghost"
      aria-label="Limpiar selección"
      type="button"
      hidden
    >
      <span data-sk-icon="close"></span>
    </button>
    <button
      class="sk-combobox__trigger sk-button sk-interactive"
      data-sk-button
      data-sk-combobox-trigger
      data-icon-only
      data-size="sm"
      data-variant="ghost"
      aria-label="Mostrar opciones"
      type="button"
    >
      <span data-sk-icon="chevron-down"></span>
    </button>
  </div>
  <div
    class="sk-combobox__status sk-visually-hidden"
    data-sk-combobox-status
    role="status"
    aria-atomic="true"
  ></div>
  <div
    class="sk-combobox__positioner sk-anchored"
    data-sk-combobox-positioner
  >
    <div
      class="sk-combobox__content sk-scrollbar"
      data-sk-combobox-content
    >
${countryItems}
      <div
        class="sk-combobox__empty"
        data-sk-combobox-empty
        hidden
      >
        Sin resultados
      </div>
    </div>
  </div>
</div>`;
const react = `import { Combobox } from "@skryensya/react/combobox";
import { Icon } from "@skryensya/react/icon";
import { countries } from "./countries";
// countries: { label: string; value: string }[] con la lista completa de países

function Example() {
  return (
    <Combobox
      label="País"
      hint="Escribe para filtrar. Usa las flechas para recorrer."
      placeholder="Buscar país"
      items={countries}
      clearIndicator={<Icon name="close" />}
      itemIndicator={<Icon name="check" />}
      triggerIndicator={<Icon name="chevron-down" />}
    />
  );
}`;
---

<Base
  title="Combobox"
  description="Sugerencias editables con estados claros, ayuda contextual y navegación completa por teclado."
>
  <h1>Combobox</h1>
  <p class="lede">Sugerencias editables con contexto, estados claros y navegación completa por teclado.</p>

  <h2>Instalación</h2>
  <ComponentPreview
    html={html}
    js={js}
    react={react}
    label="Combobox"
    viewport="menu"
  >
    <Fragment slot="react">
      <ComboboxBasicDemo client:load />
    </Fragment>
  </ComponentPreview>

  <h2>Contrato</h2>
  <p>
    Combobox filtra una colección autorada sin reemplazar sus opciones. Select
    conserva una lista cerrada e Input no muestra sugerencias.
  </p>
  <p>
    Lo escrito es trabajo del usuario: salir del campo sin elegir nada
    —desenfocar, clic afuera, Escape— cierra la lista pero <strong
      >no borra la búsqueda</strong
    >. Sólo elegir una opción reescribe el input (con la etiqueta elegida), y
    sólo el ✕ lo vacía. Al reabrir, el filtro vuelve a la lista completa: lo que
    se ve es la selección, no el último texto tipeado.
  </p>

  <h2>Accesibilidad</h2>
  <p>
    El foco permanece en el input mientras <code>aria-activedescendant</code>
    señala la opción activa. Flecha abajo y arriba recorren resultados, Enter
    selecciona y Escape cierra. <code>hint</code> y <code>error</code> se
    enlazan mediante <code>aria-describedby</code>; los cambios en la cantidad
    de resultados se anuncian con una región de estado.
  </p>
  <p>
    Recorrer con el teclado mueve el anillo de foco al ítem resaltado (foco
    virtual) y el control cede el suyo: hay un solo anillo en pantalla y viaja
    hacia la lista y de vuelta. Con el puntero no aparece anillo —un anillo
    siguiendo al cursor se lee como foco roto—, sólo la capa de estado.
  </p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/combobox.css",
        probe: "sk-combobox",
        title: "Combobox",
      },
      { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
      { file: "components/button.css", probe: "sk-button", title: "Heredados de Button" },
    ]}
  />
</Base>
