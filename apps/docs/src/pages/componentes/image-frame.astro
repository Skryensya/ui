---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import {
  ImageFrameAspectDemo,
  ImageFrameBasicDemo,
  ImageFrameFitDemo,
  ImageFramePositionDemo,
} from "../../components/react-demos/image-frame";

const install = `pnpm add @skryensya/core @skryensya/react`;

const styles = `@import "@skryensya/core/patterns/image-frame.css";
/* o patterns/layout.css, que ya lo incluye */`;

/* Offline demo asset: asymmetric so crop + object-position read clearly. */
const demoSrc = "/demos/image-frame.svg";

const basicHtml = `<figure
  class="sk-image-frame"
  data-aspect="16/9"
  data-fit="cover"
  data-position="center"
  data-radius="surface"
  data-border="subtle"
>
  <img
    class="sk-image-frame__media"
    src="${demoSrc}"
    alt="Paisaje de demostración"
  />
</figure>`;

const basicReact = `import { ImageFrame } from "@skryensya/react/image-frame";

<ImageFrame
  as="figure"
  aspect="16/9"
  fit="cover"
  position="center"
  radius="surface"
  border="subtle"
  src="${demoSrc}"
  alt="Paisaje de demostración"
/>;`;

const aspectHtml = `<div class="demo-grid">
  <figure class="demo-shot">
    <div class="sk-image-frame" data-aspect="1/1" data-fit="cover">
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>1/1</code></figcaption>
  </figure>
  <figure class="demo-shot">
    <div class="sk-image-frame" data-aspect="4/3" data-fit="cover">
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>4/3</code></figcaption>
  </figure>
  <figure class="demo-shot">
    <div class="sk-image-frame" data-aspect="16/9" data-fit="cover">
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>16/9</code></figcaption>
  </figure>
  <figure class="demo-shot">
    <div
      class="sk-image-frame"
      data-aspect="9/16"
      data-fit="cover"
    >
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>9/16</code></figcaption>
  </figure>
</div>`;

const fitHtml = `<div class="demo-grid demo-grid--fit">
  <figure class="demo-shot">
    <div
      class="sk-image-frame"
      data-aspect="1/1"
      data-fit="cover"
      data-border="subtle"
    >
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>cover</code></figcaption>
  </figure>
  <figure class="demo-shot">
    <div
      class="sk-image-frame"
      data-aspect="1/1"
      data-fit="contain"
      data-border="subtle"
    >
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>contain</code></figcaption>
  </figure>
  <figure class="demo-shot">
    <div
      class="sk-image-frame"
      data-aspect="1/1"
      data-fit="fill"
      data-border="subtle"
    >
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>fill</code></figcaption>
  </figure>
</div>`;

const positionHtml = `<div class="demo-grid">
  <figure class="demo-shot">
    <div
      class="sk-image-frame"
      data-aspect="1/1"
      data-fit="cover"
      data-position="top-left"
    >
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>top-left</code></figcaption>
  </figure>
  <figure class="demo-shot">
    <div
      class="sk-image-frame"
      data-aspect="1/1"
      data-fit="cover"
      data-position="center"
    >
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>center</code></figcaption>
  </figure>
  <figure class="demo-shot">
    <div
      class="sk-image-frame"
      data-aspect="1/1"
      data-fit="cover"
      data-position="bottom-right"
    >
      <img class="sk-image-frame__media" src="${demoSrc}" alt="" />
    </div>
    <figcaption><code>bottom-right</code></figcaption>
  </figure>
</div>`;

const positionReact = `import { ImageFrame } from "@skryensya/react/image-frame";

<ImageFrame
  aspect="1/1"
  fit="cover"
  position="top-left"
  src="/foto.jpg"
  alt=""
/>;`;
---

<Base
  title="ImageFrame"
  description="ImageFrame: marco que recorta y posiciona media con aspect-ratio, object-fit y object-position."
>
  <h1>ImageFrame</h1>
  <p class="lede">
    ImageFrame es el <strong>marco de media</strong>: una caja que fija un aspect ratio, recorta con
    radio/borde y decide cómo llena la imagen (<code>object-fit</code>) y desde dónde
    (<code>object-position</code>). No es un componente de imagen con CDN ni un Avatar: es el pattern
    que Card, Tile y galerías reutilizan en vez de copiar
    <code>aspect-ratio</code> a mano. Para tipo sobre la foto, compón con
    <a href="/gradientes">Gradientes</a> (<code>sk-media-gradient</code>).
  </p>

  <Showcase html={basicHtml} react={basicReact} label="ImageFrame">
    <Fragment slot="react">
      <ImageFrameBasicDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Aspect</h2>
  <p>
    <code>data-aspect</code> es la caja, no el archivo. Con <code>cover</code> (por defecto) la media
    rellena y se recorta; con <code>auto</code> el marco sigue la medida intrínseca del media.
  </p>
  <Showcase html={aspectHtml} label="Aspect">
    <Fragment slot="react">
      <ImageFrameAspectDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Fit</h2>
  <p>
    Misma caja <code>1/1</code>, distinto <code>data-fit</code>: <code>cover</code> recorta,
    <code>contain</code> letterboxa (se ve el fondo del marco), <code>fill</code> estira.
  </p>
  <Showcase html={fitHtml} label="Fit">
    <Fragment slot="react">
      <ImageFrameFitDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Position</h2>
  <p>
    Con <code>cover</code>, <code>data-position</code> elige el ancla del recorte. El demo concentra
    un disco arriba-izquierda y un bloque abajo-derecha para que el ancla se note.
  </p>
  <Showcase html={positionHtml} react={positionReact} label="Position">
    <Fragment slot="react">
      <ImageFramePositionDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" />

  <h2>React</h2>
  <p>
    <code>src</code> / <code>alt</code> pintan un <code>img</code> con la clase media. Para
    <code>picture</code> o <code>video</code>, pasa hijos con
    <code>className="sk-image-frame__media"</code> (o deja el <code>img</code>/<code>video</code>
    como hijo directo: el CSS también los alcanza).
  </p>

  <h2>Contrato</h2>
  <ul>
    <li>
      Raíz: <code>sk-image-frame</code>. Media: <code>sk-image-frame__media</code>, o
      <code>img</code>/<code>video</code>/<code>picture &gt; img</code> hijo directo.
    </li>
    <li>
      <code>data-aspect</code>: <code>auto</code>, <code>1/1</code>, <code>4/3</code>,
      <code>3/2</code>, <code>16/9</code>, <code>3/4</code>, <code>2/3</code>, <code>9/16</code>.
    </li>
    <li>
      <code>data-fit</code>: <code>cover</code> (default), <code>contain</code>, <code>fill</code>,
      <code>none</code>, <code>scale-down</code>.
    </li>
    <li>
      <code>data-position</code>: <code>center</code> (default), <code>top</code>,
      <code>bottom</code>, <code>left</code>, <code>right</code>, y las cuatro esquinas
      (<code>top-left</code>, …).
    </li>
    <li>
      <code>data-radius</code>: <code>none</code>, <code>top</code>, <code>control</code>,
      <code>surface</code>, <code>pill</code>
      (default), <code>pill</code>.
    </li>
    <li>
      <code>data-border</code>: <code>none</code> (default), <code>subtle</code>,
      <code>default</code>.
    </li>
    <li>
      Hooks: <code>--sk-image-frame-aspect</code>, <code>--sk-image-frame-fit</code>,
      <code>--sk-image-frame-position</code>, <code>--sk-image-frame-radius</code>,
      <code>--sk-image-frame-border-*</code>, <code>--sk-image-frame-bg</code>.
    </li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "patterns/image-frame.css",
        probe: "sk-image-frame",
      },
    ]}
  />
</Base>

<style is:global>
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-stack-md);
    align-items: start;
  }

  .demo-shot {
    margin: 0;
    display: grid;
    gap: var(--space-stack-xs);
  }

  .demo-grid--fit .demo-shot {
    max-inline-size: 12rem;
    margin-inline: auto;
  }

  .demo-shot figcaption {
    text-align: center;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-caption);
  }

  /* Tall ratio needs a narrower column so 9/16 doesn't dominate the stage. */
  .demo-shot:has([data-aspect="9/16"]) {
    max-inline-size: 7rem;
    margin-inline: auto;
  }
</style>
