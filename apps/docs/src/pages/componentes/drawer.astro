---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";

const import_ = `/* un drawer ES un Vaul */
@import "@skryensya/core/patterns/vaul.css";
@import "@skryensya/core/components/drawer.css";
@import "@skryensya/core/patterns/scroll-lock.css";`;

const html = `<button
  class="sk-button sk-interactive"
  data-sk-button
  data-sk-vaul-open="demo-drawer"
  type="button"
>
  Abrir navegación
</button>

<dialog
  class="sk-vaul sk-drawer demo-drawer"
  id="demo-drawer"
  data-sk-vaul
  data-edge="inline-start"
  aria-label="Navegación"
>
  <div
    class="sk-vaul__handle"
    data-part="handle"
    aria-hidden="true"
  ></div>

  <header class="demo-drawer__header">
    <span class="demo-drawer__brand">Estudio</span>
    <button
      class="sk-button sk-interactive"
      data-sk-button
      data-variant="ghost"
      data-icon-only
      data-sk-vaul-close
      type="button"
      aria-label="Cerrar"
    >
      <span data-sk-icon="close"></span>
    </button>
  </header>

  <nav class="sk-nav-list demo-drawer__nav" aria-label="Principal">
    <div class="sk-nav-list__group">
      <div class="sk-nav-list__group-label" id="demo-drawer-trabajo">
        Trabajo
      </div>
      <ul
        class="sk-nav-list__list"
        aria-labelledby="demo-drawer-trabajo"
      >
        <li class="sk-nav-list__item">
          <a
            class="sk-nav-list__link sk-interactive"
            href="#resumen"
            aria-current="page"
          >
            <span data-sk-icon="info"></span>
            <span class="sk-nav-list__label">Resumen</span>
          </a>
        </li>
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#agenda">
            <span data-sk-icon="calendar"></span>
            <span class="sk-nav-list__label">Agenda</span>
            <span class="sk-nav-list__trailing">3</span>
          </a>
        </li>
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#archivos">
            <span data-sk-icon="download"></span>
            <span class="sk-nav-list__label">Archivos</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sk-nav-list__group">
      <div class="sk-nav-list__group-label" id="demo-drawer-cuenta">
        Cuenta
      </div>
      <ul
        class="sk-nav-list__list"
        aria-labelledby="demo-drawer-cuenta"
      >
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#equipo">
            <span data-sk-icon="user"></span>
            <span class="sk-nav-list__label">Equipo</span>
          </a>
        </li>
        <li class="sk-nav-list__item">
          <a class="sk-nav-list__link sk-interactive" href="#ajustes">
            <span data-sk-icon="settings"></span>
            <span class="sk-nav-list__label">Ajustes</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <footer class="demo-drawer__footer">
    <span class="sk-avatar" data-size="sm" aria-hidden="true">
      <span class="sk-avatar__fallback">AK</span>
    </span>
    <span class="demo-drawer__user">
      <span class="demo-drawer__user-name">Ada Kovač</span>
      <span class="demo-drawer__user-meta">ada@estudio.cl</span>
    </span>
  </footer>
</dialog>`;

const composition = `/* El drawer no declara panel, borde, slide ni
   backdrop: los re-declara desde sus hooks. */
.sk-drawer {
  --sk-vaul-size: var(--sk-drawer-inline-size);
  --sk-vaul-bg: var(--sk-drawer-bg);
  /* toca tres bordes del viewport: un radio ahí se lee como
     un error */
  --sk-vaul-radius: 0;
}`;

const tuning = `.mi-drawer {
  --sk-drawer-inline-size: 24rem;
  --sk-drawer-bg: var(--color-bg-surface-raised);
}`;

const nativeHtml = `<button
  class="sk-button sk-interactive"
  data-native-drawer-open="native-drawer"
  type="button"
>
  Abrir drawer nativo
</button>

<dialog
  class="sk-vaul sk-drawer demo-drawer"
  id="native-drawer"
  data-edge="inline-start"
  aria-label="Drawer nativo de ejemplo"
>
  <div class="demo-drawer__body">
    <strong>Panel nativo</strong>
    <p>La plataforma posee modalidad, foco, Escape y restauración.</p>
    <form method="dialog">
      <button
        class="sk-button sk-interactive"
        data-variant="ghost"
        type="submit"
      >
        Cerrar
      </button>
    </form>
  </div>
</dialog>`;

const nativeJs = `const trigger = document.querySelector(
  '[data-native-drawer-open="native-drawer"]',
);
const drawer = document.getElementById("native-drawer");

trigger?.addEventListener("click", () => {
  if (drawer instanceof HTMLDialogElement) drawer.showModal();
});`;
---

<Base title="Drawer" description="Un Vaul en el borde inline, a lo alto de la pantalla. Envía hooks y nada de estructura.">
  <h1>Drawer</h1>
  <p class="lede">
    Un drawer <strong>es</strong> un <a href="/vaul">Vaul</a> en el borde inline, corriendo a lo alto
    de la pantalla. Esa frase es el componente entero: el borde, el slide, el backdrop, el drag y el top
    layer son del pattern, y este archivo sólo dice <em>qué Vaul es un drawer</em> y cómo se ve.
  </p>

  <ComponentPreview html={html} label="HTML" viewport="overlay" />

  <h2>Envía hooks y nada de estructura</h2>
  <p>
    Por la regla del sistema: cada línea de
    estructura que un drawer podría tener es estructura que una hoja inferior necesita idéntica, y esa
    estructura compartida <strong>es</strong> el pattern. Un drawer que reimplementara el panel sería un
    segundo Vaul con otro nombre.
  </p>
  <CodeBlock code={composition} label="components/drawer.css" lang="css" />
  <p>
    Los hooks del drawer <strong>son</strong> los del Vaul, re-declarados. Un consumidor afina
    <code>--sk-drawer-*</code> y no se entera nunca de que hay un Vaul abajo: el pattern queda como
    detalle de implementación en vez de una segunda superficie pública que mantener sincronizada.
  </p>
  <CodeBlock code={tuning} label="CSS" lang="css" />

  <h2>Cuándo es un drawer y cuándo no</h2>
  <table class="sk-table">
    <thead><tr><th>Necesitas</th><th>Usa</th></tr></thead>
    <tbody>
      <tr><td>Navegación o filtros al costado, a lo alto</td><td><code>sk-drawer</code></td></tr>
      <tr><td>Una hoja que sube desde abajo en móvil</td><td><a href="/componentes/dialog">Dialog</a> (opción Vaul)</td></tr>
      <tr><td>Una caja centrada</td><td><a href="/componentes/dialog">Dialog</a></td></tr>
      <tr><td>Un riel permanente que no tapa la página</td><td><a href="/componentes/sidebar">Sidebar</a></td></tr>
    </tbody>
  </table>
  <p>
    El sidebar y el drawer no compiten: un <a href="/componentes/sidebar">sidebar</a> es un shell que
    vive en el layout, y un drawer es modal y tapa la página. Este sitio usa los dos, el riel arriba de
    52rem, el drawer abajo, con <strong>una sola</strong> nav-list adentro de los dos.
  </p>

  <h2>Markup contract</h2>
  <p>
    El root lleva <code>sk-vaul sk-drawer</code> sobre un <code>&lt;dialog&gt;</code> nativo, Vaul
    lo exige, más su <code>data-edge</code>. El handle es opcional: sin él no hay drag, y el drawer
    sigue completo.
  </p>

  <h2>Drawer nativo</h2>
  <p class="lede">
    La misma superficie puede quedarse en la plataforma. Conserva
    <code>&lt;dialog class="sk-vaul sk-drawer"&gt;</code>, omite
    <code>data-sk-vaul</code> y ábrelo con <code>showModal()</code>: no carga enhancer, drag ni
    light-dismiss.
  </p>
  <p>
    <code>&lt;form method="dialog"&gt;</code> cierra sin un listener propio; Escape, foco, página
    inerte, backdrop y restauración pertenecen al navegador. Los estilos y la transición siguen
    siendo los mismos porque viven en Core, no en el enhancer.
  </p>
  <ComponentPreview html={nativeHtml} previewScript={nativeJs} label="Drawer nativo" viewport="overlay" />

  <h3>Abrir</h3>
  <CodeBlock code={nativeJs} label="JavaScript" />

  <h3>Contrato nativo</h3>
  <ul>
    <li>La raíz sigue siendo un <code>&lt;dialog&gt;</code> abierto con <code>showModal()</code>.</li>
    <li>Sin <code>data-sk-vaul</code>, el auto-loader no monta nada.</li>
    <li>Sin handle no se anuncia una interacción de drag que no existe.</li>
    <li>El enhancer sólo hace falta para drag-to-dismiss y light-dismiss.</li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={import_} label="CSS" />

  <StylingHooks
    groups={[
      { file: "components/drawer.css", probe: "sk-drawer", title: "Drawer" },
      { file: "patterns/vaul.css", probe: "sk-vaul", title: "Heredados de Vaul" },
    ]}
  />

</Base>

<style is:global>
  /* El drawer ES la columna: cabecera fija, navegación que scrollea, cuenta abajo. Es la misma
     anatomía que el riel de este sitio, que es el punto del componente. */
  .demo-drawer[open] {
    display: flex;
    flex-direction: column;
  }

  /* Inset `md`, no `lg`: un drawer es angosto por definición, y el padding que se lleva es ancho que
     los rótulos no tienen. Las bandas se separan con una línea, que cuesta 1px. */
  .demo-drawer__header {
    display: flex;
    gap: var(--space-inline-md);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-inset-sm) var(--space-inset-md);
    border-block-end: 1px solid var(--color-border-subtle);
  }

  .demo-drawer__brand {
    font-weight: var(--font-weight-heading);
  }

  .demo-drawer__nav {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-inset-sm);
  }

  .demo-drawer__footer {
    display: flex;
    gap: var(--space-inline-sm);
    align-items: center;
    padding: var(--space-inset-sm) var(--space-inset-md);
    border-block-start: 1px solid var(--color-border-subtle);
  }

  .demo-drawer__user {
    display: grid;
    gap: 2px;
    min-inline-size: 0;
  }

  .demo-drawer__user-name {
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-label);
  }

  .demo-drawer__user-meta {
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
  }

  /* El demo nativo de más abajo es deliberadamente mínimo: enseña que sin enhancer el drawer sigue
     completo, así que no le sobra contenido que distraiga de eso. */
  .demo-drawer__body {
    display: grid;
    gap: var(--space-stack-md);
    justify-items: start;
    padding: var(--space-inset-md);
  }

  .demo-drawer__body p {
    margin: 0;
  }
</style>

