---
import Base from "../../layouts/Base.astro";
import { iconMarkup } from "../../icons";
import { componentNavigation } from "../../lib/navigation";

const searchIcon = iconMarkup("search");
---

<Base
  title="Explorar componentes"
  description="Piezas del sistema agrupadas por la tarea que resuelven al construir una interfaz."
>
  <h1>Explorar componentes</h1>
  <p class="lede">
    Empieza por las rutas enhanced: resuelven la interacción que el navegador no coordina por sí solo.
    Las alternativas nativas quedan separadas al final para los casos donde el contrato de plataforma
    es suficiente.
  </p>

  <button
    class="ds-button ds-interactive docs-catalog-search"
    data-variant="ghost"
    type="button"
    aria-controls="docs-cmdk"
    aria-expanded="false"
    aria-keyshortcuts="Meta+K Control+K"
    data-docs-cmdk-open
  >
    <Fragment set:html={searchIcon} />
    <span class="docs-catalog-search__label">Buscar componentes</span>
    <kbd class="ds-kbd" data-cmdk-hint aria-hidden="true">⌘K</kbd>
  </button>

  {
    componentNavigation.map((group) => (
      <section class="docs-catalog-section" data-secondary={group.secondary ? "" : undefined} aria-labelledby={`catalog-${group.group}`}>
        <h2 id={`catalog-${group.group}`}>{group.group}</h2>
        <ul class="docs-catalog">
          {group.items.map((item) => (
            <li>
              <a class="docs-catalog__link ds-interactive" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
