---
import Base from "../../layouts/Base.astro";
import { getLocale, useTranslations } from "../../i18n";
import { iconMarkup } from "../../icons";
import { componentNavigation, componentStatus } from "../../lib/navigation";

const searchIcon = iconMarkup("search");
const items = componentNavigation.flatMap((group) => group.items);
const t = useTranslations(getLocale(Astro.url));
---

<Base
  title="Explorar componentes"
  description="Catálogo A–Z de piezas del sistema: componentes, patterns y primitivos de uso."
>
  <h1>Explorar componentes</h1>
  <p class="lede">
    Lista A–Z. Incluye piezas de producto, patterns (scrollbar, vaul, nav list) y el uso de
    <a href="/componentes/icon">Icon</a>. La iconografía —roles, sets, reglas— vive en
    <a href="/iconos">Fundamentos → Iconografía</a>.
  </p>

  <button
    class="sk-button sk-interactive docs-catalog-search"
    data-variant="ghost"
    type="button"
    aria-controls="docs-cmdk"
    aria-expanded="false"
    aria-keyshortcuts="Meta+K Control+K"
    data-sk-command-palette-open
  >
    <Fragment set:html={searchIcon} />
    <span class="docs-catalog-search__label">Buscar componentes</span>
    <kbd class="sk-kbd" data-sk-command-palette-hint aria-hidden="true">⌘K</kbd>
  </button>

  <section class="docs-catalog-section" aria-label="Componentes">
    <ul class="docs-catalog">
      {
        items.map((item) => (
          <li>
            <a class="docs-catalog__link sk-interactive" href={item.href}>
              {item.label}
              {componentStatus(item) === "wip" && (
                <span class="sk-badge" data-tone="warning">
                  {t("status.wip")}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
