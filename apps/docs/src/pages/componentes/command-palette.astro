---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/components/dialog.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/command-palette.css";
@import "@skryensya/core/patterns/scroll-lock.css";`;

const html = `<button
  class="sk-button sk-interactive"
  data-variant="secondary"
  type="button"
  aria-controls="demo-cmdk"
  aria-expanded="false"
  data-sk-command-palette-open
>
  <span data-sk-icon="search"></span>
  Abrir paleta
</button>

<dialog
  class="sk-dialog sk-command-palette"
  id="demo-cmdk"
  data-sk-command-palette
  data-sk-command-palette-index="demo-cmdk-index"
  aria-label="Buscar"
>
  <div class="sk-command-palette__search">
    <span data-sk-icon="search"></span>
    <input
      class="sk-command-palette__input"
      type="text"
      role="combobox"
      placeholder="Buscar…"
      autocomplete="off"
      spellcheck="false"
      aria-controls="demo-cmdk-list"
      aria-expanded="true"
      aria-autocomplete="list"
      data-sk-command-palette-input
    />
    <form method="dialog">
      <button
        class="sk-button sk-interactive sk-dialog__close sk-command-palette__close"
        data-sk-button
        data-variant="ghost"
        data-size="sm"
        data-icon-only
        type="submit"
        value="cancel"
        aria-label="Cerrar"
      >
        <span data-sk-icon="close"></span>
      </button>
    </form>
  </div>
  <ul
    class="sk-command-palette__list sk-scrollbar"
    id="demo-cmdk-list"
    role="listbox"
    aria-label="Resultados"
    data-sk-command-palette-list
  ></ul>
  <p
    class="sk-command-palette__empty"
    data-sk-command-palette-empty
    hidden
  >
    Sin resultados.
  </p>
  <footer class="sk-command-palette__footer">
    <span>
      <kbd class="sk-kbd">↑</kbd>
      <kbd class="sk-kbd">↓</kbd>
      navegar
    </span>
    <span><kbd class="sk-kbd">↵</kbd> abrir</span>
    <span><kbd class="sk-kbd">Esc</kbd> cerrar</span>
  </footer>
</dialog>
<script type="application/json" id="demo-cmdk-index">[{"label":"Button","href":"/componentes/button","section":"Componentes","group":"Controles"},{"label":"Dialog","href":"/componentes/dialog","section":"Componentes","group":"Overlays"},{"label":"Hotkey","href":"/hotkey","aliases":["atajo","shortcut"],"section":"Fundamentos","group":"Comportamiento"}]</script>`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
await initComponents();`;
---

<Base
  title="CommandPalette"
  description="CommandPalette: listbox buscable dentro de un Dialog nativo, con atajo opt-in y cierre por IconButton."
>
  <h1>CommandPalette</h1>
  <p class="lede">
    Una <strong>paleta de comandos</strong>: un campo que filtra un índice y un listbox con
    <code>aria-activedescendant</code>, alojados en un
    <a href="/componentes/dialog"><code>Dialog</code></a> nativo (<code>showModal</code>, Esc, foco).
    El atajo (<a href="/hotkey">Hotkey</a>) es opt-in por atributo; este sitio lo usa con
    <kbd class="sk-kbd" data-sk-command-palette-hint>⌘K</kbd>.
  </p>

  <Showcase html={html} js={js} label="CommandPalette" viewport="overlay" />

  <h2>Instalar</h2>
  <CodeBlock code={install} label="terminal" />
  <CodeBlock code={styles} label="CSS" />

  <h2>Contrato</h2>
  <ul>
    <li>
      Raíz: <code>&lt;dialog class="sk-dialog sk-command-palette" data-sk-command-palette&gt;</code>.
    </li>
    <li>
      Índice JSON vía <code>data-sk-command-palette-index</code> (id del
      <code>&lt;script type="application/json"&gt;</code>).
    </li>
    <li>
      Abrir: <code>data-sk-command-palette-open</code> + <code>aria-controls</code> al id del dialog
      (o el valor del atributo igual al id).
    </li>
    <li>
      Atajo opcional: <code>data-sk-command-palette-hotkey="mod+k"</code>. Sin él, solo el botón abre.
    </li>
    <li>
      Cerrar: <code>&lt;form method="dialog"&gt;</code> con IconButton
      (<code>sk-dialog__close sk-command-palette__close</code>), Esc, o clic en el backdrop.
    </li>
  </ul>

  <StylingHooks
    groups={[
      {
        file: "components/command-palette.css",
        probe: "sk-command-palette",
      },
    ]}
  />
</Base>
