---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/radio-group.css";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { radioGroupTree, tileRadioGroupTree } from "../../demos/radio-group";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));


const tileRadioGroupVanilla = `import { initComponents } from "@skryensya/vanilla/auto";

// La raíz se autora con data-sk-tile-radio-group (data-name, data-default-value),
// y cada opción con data-part="item" + un input[type=radio] con su value.
// initComponents la hidrata con la máquina @zag-js/radio-group (la misma que React).
await initComponents();

const root = document.querySelector("[data-sk-tile-radio-group]");
root.addEventListener("sk:valuechange", (event) => {
  console.log(event.detail.value);
});`;

---

<Base title="RadioGroup" description="RadioGroup: una opción exclusiva con inputs nativos y formulario real.">
  <h1>RadioGroup</h1>
  <p class="lede">Una elección exclusiva entre alternativas relacionadas. Cada opción es un radio nativo; el nombre compartido impone la exclusión.</p>

  <ComponentPreview tree={radioGroupTree(t)} label="RadioGroup" />

  <h2>Opciones de superficie: TileRadioGroup</h2>
  <p>
    Cuando cada alternativa necesita título, descripción y una superficie completa, usa
    <code>TileRadioGroup</code>. Cada item conserva un radio nativo; el grupo no impone disposición.
  </p>
  <ComponentPreview tree={tileRadioGroupTree(t)} label="TileRadioGroup" />
  <p>En este preview las opciones van en fila con <a href="/componentes/inline"><code>sk-inline</code></a> y cada Tile toma <code>flex: 1</code>. En una columna, omite <code>sk-inline</code>.</p>
  <p>El enhancer <code>tile-radio-group</code> (Svelte + <code>@zag-js/radio-group</code>, la misma máquina que React) hidrata la raíz <code>data-sk-tile-radio-group</code> con <code>initComponents()</code>: garantiza la exclusión mutua y sincroniza el estado de cada <code>[data-part="item"]</code> con su radio real.</p>
  <CodeBlock code={tileRadioGroupVanilla} label="JavaScript" />
  <p>Importa <code>@skryensya/core/components/radio-group.css</code> y llama <code>initComponents()</code> una vez.</p>


  <h2>React</h2>
  <p>El código está en la pestaña <strong>React</strong> del preview.</p>

  <h2>Contrato</h2>
  <ul>
    <li><code>name</code> es obligatorio y lo comparten todas las opciones.</li>
    <li><code>defaultValue</code> conserva el estado nativo y respeta reset de formularios.</li>
    <li><code>value</code> controla la opción seleccionada; <code>onValueChange</code> reporta cambios.</li>
    <li>El grupo necesita un nombre accesible: <code>aria-label</code>, <code>aria-labelledby</code> o un <code>fieldset</code> con <code>legend</code>.</li>
  </ul>
  <StylingHooks groups={[{ file: "components/radio-group.css", probe: "sk-radio-group" }]} />
</Base>
