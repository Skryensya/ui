---
import Base from "../../layouts/Base.astro";
import Showcase from "../../components/Showcase.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { FileUploadBasicDemo } from "../../components/react-demos/file-upload";
import "@skryensya/core/components/file-upload.css";

const install = `@import "@skryensya/core/components/file-upload.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
const html = `<div
  class="sk-file-upload"
  data-sk-file-upload
  data-max-files="3"
>
  <label class="sk-file-upload__label" data-sk-file-upload-label>
    Adjuntos
  </label>
  <div
    class="sk-file-upload__dropzone"
    data-sk-file-upload-dropzone
  >
    <span>Arrastra archivos aquí</span>
  </div>
  <input
    class="sk-file-upload__input"
    data-sk-file-upload-input
    name="attachments"
    type="file"
    multiple
  />
  <button
    class="sk-button sk-interactive"
    data-sk-file-upload-trigger
    type="button"
  >
    Elegir archivos
  </button>
</div>`;
const react = `import { FileUpload } from "@skryensya/react/file-upload";

function Example() {
  return (
    <FileUpload
      label="Adjuntos"
      maxFiles={3}
      maxFileSize={10_000_000}
      name="attachments"
    />
  );
}`;
---

<Base
  title="FileUpload"
  description="Selección y drag-and-drop con límites, rechazo y lista de archivos."
>
  <h1>FileUpload</h1>
  <p class="lede">Selección y drag-and-drop con límites, rechazo y lista de archivos.</p>

  <h2>Instalación</h2>
  <Showcase
    html={html}
    js={js}
    react={react}
    label="FileUpload"
    viewport="auto"
  >
    <Fragment slot="react">
      <FileUploadBasicDemo client:load />
    </Fragment>
  </Showcase>

  <h2>Contrato</h2>
  <p>Vanilla emite sk-file-change y nunca inventa una carga remota. React expone archivos aceptados y rechazados.</p>

  <h2>Accesibilidad</h2>
  <p>El input real permanece disponible para formularios y tecnología asistiva; la dropzone no lo sustituye.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/file-upload.css",
        probe: "sk-file-upload",
        title: "FileUpload",
      },
    ]}
  />
</Base>
