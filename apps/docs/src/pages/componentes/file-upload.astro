---
import Base from "../../layouts/Base.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";
import StylingHooks from "../../components/StylingHooks.astro";
import { fileUploadTree } from "../../demos/file-upload";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/file-upload.css";

const t = useTranslations(getLocale(Astro.url));
const install = `@import "@skryensya/core/components/file-upload.css";`;
---

<Base
  title="FileUpload"
  description="Selección y drag-and-drop con límites, rechazo y lista de archivos."
>
  <h1>FileUpload</h1>
  <p class="lede">Selección y drag-and-drop con límites, rechazo y lista de archivos.</p>

  <h2>Instalación</h2>
  <ComponentPreview tree={fileUploadTree(t)} label="FileUpload" viewport="auto" />

  <h2>Contrato</h2>
  <p>Vanilla emite sk-file-change y nunca inventa una carga remota. React expone archivos aceptados y rechazados.</p>

  <h2>Accesibilidad</h2>
  <p>El input real permanece disponible para formularios y tecnología asistiva; la dropzone no lo sustituye.</p>

  <h2>CSS</h2>
  <pre><code>{install}</code></pre>
  <StylingHooks
    groups={[
      {
        file: "components/file-upload.css",
        probe: "sk-file-upload",
        title: "FileUpload",
      },
    ]}
  />
</Base>
