---
import FoundationPage from "../components/FoundationPage.astro";
import CodeBlock from "../components/CodeBlock.astro";
import EasingCurve from "../components/EasingCurve.astro";
import MotionTrack from "../components/MotionTrack.astro";
import MotionTransport from "../components/MotionTransport.astro";
import Used from "../components/Used.astro";
import { byName, literalOf, tokens } from "../lib/tokens";

/* The duration scale, split by what the number MEASURES. A transition is a one-way trip and a
 * cycle is a lap; putting both in one race made the fastest lane and the longest lane mean
 * different things, which is the one thing a race is not allowed to do. Each half is ordered by
 * its own value, so the specimens finish top to bottom and the ranking needs no label. */
const durationsBy = (cycles: boolean) =>
  tokens
    .filter((t) => t.name.startsWith("--scale-duration-"))
    .map((t) => ({
      ...t,
      short: t.name.replace("--scale-duration-", ""),
      ms: Number.parseFloat(literalOf(t.value)),
    }))
    .filter((t) => t.short.startsWith("cycle") === cycles)
    .sort((a, b) => a.ms - b.ms);

const transitionDurations = durationsBy(false);
const cycleDurations = durationsBy(true);

/* What each curve is FOR. The values are read from the stylesheet; only the reason is written
 * here, and it is the one thing the CSS comment cannot put on screen. */
const easings = [
  ["--scale-easing-linear", "no acceleration, only for loops"],
  ["--scale-easing-standard", "changes within the screen"],
  ["--scale-easing-enter", "starts hard and settles"],
  ["--scale-easing-exit", "speed up until you go"],
  ["--scale-easing-emphasized", "a longer seat, for focus"],
  ["--scale-easing-spring", "overrides and returns, not for critical UI"],
  ["--scale-easing-glide", "continues the impulse of a gesture"],
];

/*
 * The intent tokens, read out of the corpus instead of listed by hand.
 *
 * A hand-written list is a second source of truth that silently goes stale: this page claimed
 * "the eight intentions" while semantic/_motion.scss shipped fifteen, so the table was documenting
 * a smaller system than the one installed. Every `--motion-<intent>-duration` IS an intent, and
 * that is the definition the table now uses.
 *
 * Each row shows the PRIMITIVE the intent composes, not the literal 0.2s / cubic-bezier(…): the
 * literal was already read off the specimens above, and repeating it fifteen times said nothing
 * about tier 2 while making the table too wide for its column. The name says what the composition
 * is; the used value underneath says what the browser resolved it to right now.
 */
const shortRef = (ref?: string) => ref?.replace(/^--(?:scale|motion)-(?:duration|easing|distance)-/, "");

const intents = tokens
  .filter(
    (t) =>
      t.tier === "semantic" &&
      /^--motion-[a-z-]+-duration$/.test(t.name) &&
      // The reduced-mode primitives are what the @media block swaps intents TO, not an intent.
      t.name !== "--motion-reduced-duration",
  )
  .map((t) => {
    const key = t.name.slice("--motion-".length, -"-duration".length);
    const distance = byName.get(`--motion-${key}-distance`);
    return {
      key,
      duration: shortRef(t.refs[0]),
      easing: shortRef(byName.get(`--motion-${key}-easing`)?.refs[0]),
      distance: distance && shortRef(distance.refs[0]),
      /* A loop, not a transition: its token measures a lap, so its specimen has to run like one. */
      loops: key === "loading",
    };
  });

const bad = `.sk-dialog {
  transition: opacity var(--scale-duration-fast);
}`;

const good = `.sk-dialog {
  transition: opacity var(--motion-enter-duration)
    var(--motion-enter-easing);
  translate: 0 var(--motion-enter-distance);
}`;

const reduced = `@media (prefers-reduced-motion: reduce) {
  /* spatial: no travel, a fade remains */
  --motion-enter-distance: 0px;
  /* essential: stays readable */
  --motion-expand-duration: 120ms;
  /* decorative: removed */
  --motion-emphasize-duration: 0ms;
  --motion-count-duration: 0ms;
}`;
---

<FoundationPage
  title="Motion"
  description="A motion language with intent tokens: components describe what a movement means, not how long it lasts."
>
  <p class="lede">
    Motion says why something moves: entering, leaving, revealing, responding, loading. Components
    consume intent tokens; the technical durations, curves and distances sit underneath and can change
    without touching a Contract.
  </p>

  <h2>What fails without intent</h2>
  <p>
    A raw duration does not say whether a change is essential, decorative or spatial. If a component
    reads <code>--scale-duration-fast</code>, reduced motion cannot decide what to keep and what to
    drop. The tier-skip rule blocks it: a tier 3 component does not consume tier 1 primitives.
  </p>
  <CodeBlock code={bad} label="CSS · invalid" />
  <CodeBlock code={good} label="CSS · valid" />

  <h2>How it works</h2>
  <p>
    Tier 1 measures time and curve. Tier 2 composes those values into intent tokens. A component only
    sees the semantic name, so a timing review restyles the whole system without migrating a single
    transition. Motion ships with <code>tokens.scss</code>: there is nothing to import.
  </p>
  <p class="howto">
    The samples use the real tokens. Pressing <em>Play</em> moves every row of a block together, so you
    can compare time, curve or intent without copying values by hand.
  </p>

  <figure class="specimens" data-motion-group data-motion-specimen>
    <figcaption class="specimens__head">
      <span class="specimens__title">Transition durations</span>
      <MotionTransport label="transition durations" />
    </figcaption>
    <div class="specimens__rows">
      {
        transitionDurations.map((t) => (
          <div class="race">
            <span class="mono race__name">{t.short}</span>
            <MotionTrack duration={`var(${t.name})`} easing="linear" />
            <span class="mono race__value"><Used token={t.name} /></span>
          </div>
        ))
      }
    </div>
    <p class="specimens__note">
      Every lane covers the same distance on a linear curve, so the only visible difference is duration.
      <code>instant</code> is 0 s: the "no transition" case of the scale, not a missing token.
    </p>
  </figure>

  <figure class="specimens" data-motion-group data-motion-continuous data-motion-specimen>
    <figcaption class="specimens__head">
      <span class="specimens__title">Cycle durations</span>
      <MotionTransport label="cycle durations" />
    </figcaption>
    <div class="specimens__rows">
      {
        cycleDurations.map((t) => (
          <div class="race">
            <span class="mono race__name">{t.short}</span>
            <MotionTrack duration={`var(${t.name})`} easing="linear" loop />
            <span class="mono race__value"><Used token={t.name} /></span>
          </div>
        ))
      }
    </div>
    <p class="specimens__note">
      A cycle times one lap of something continuous, like a spinner. It is never used to move one state
      into another.
    </p>
  </figure>

  <figure class="specimens" data-motion-group>
    <figcaption class="specimens__head">
      <span class="specimens__title">Curves</span>
      <MotionTransport label="the curves" />
    </figcaption>
    <div class="specimens__grid">
      {easings.map(([token, note]) => <EasingCurve token={token} note={note} />)}
    </div>
    <p class="specimens__note">
      All last 1 s to isolate the curve. The dotted diagonal is linear movement; <code>spring</code> can
      go past 100% and come back.
    </p>
  </figure>

  <h2>Intent tokens</h2>
  <p>
    Each intent combines one duration, one easing and, where it applies, a distance. The table shows the
    primitive it composes and the value the browser resolves right now.
  </p>

  <figure class="specimens" data-motion-group data-motion-specimen>
    <figcaption class="specimens__head">
      <span class="specimens__title">{intents.length} intents</span>
      <MotionTransport label="the intents" />
    </figcaption>
    <div class="sk-table-scroll">
      <table class="sk-table intents">
        <thead class="sk-table__head">
          <tr class="sk-table__row">
            <th class="sk-table__header">Intent</th>
            <th class="sk-table__header">Duration</th>
            <th class="sk-table__header">Easing</th>
            <th class="sk-table__header">Distance</th>
            <th class="sk-table__header intents__sample">Sample</th>
          </tr>
        </thead>
        <tbody class="sk-table__body">
          {
            intents.map((i) => (
              <tr class="sk-table__row">
                <td class="sk-table__cell mono intents__name">--motion-{i.key}-*</td>
                <td class="sk-table__cell mono">
                  <span class="intents__ref">{i.duration}</span>
                  <span class="intents__used"><Used token={`--motion-${i.key}-duration`} /></span>
                </td>
                <td class="sk-table__cell mono">
                  <span class="intents__ref">{i.easing}</span>
                </td>
                <td class="sk-table__cell mono">
                  {i.distance ? (
                    <>
                      <span class="intents__ref">{i.distance}</span>
                      <span class="intents__used"><Used token={`--motion-${i.key}-distance`} /></span>
                    </>
                  ) : (
                    <span class="intents__none">n/a</span>
                  )}
                </td>
                <td class="sk-table__cell">
                  <MotionTrack
                    duration={`var(--motion-${i.key}-duration)`}
                    easing={`var(--motion-${i.key}-easing)`}
                    loop={i.loops}
                  />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="specimens__note">
      The samples read the same tokens a component does, so under reduced motion they stop matching the
      durations above and show the reduced ones.
    </p>
  </figure>

  <h2>Direction and role</h2>
  <ul>
    <li>Entering decelerates and travels farther: the element arrives and settles.</li>
    <li>Leaving accelerates and travels less: the decision already happened, so it must not add latency.</li>
    <li>Reveal and navigate use distance to express hierarchy, not decoration.</li>
    <li>State-change and expand stay readable because they explain a change of state.</li>
    <li>Emphasize and count are decorative and can disappear under reduced motion.</li>
  </ul>

  <h2>Reduced motion</h2>
  <p>
    Reduced motion does not switch everything off. It redeclares the same intent tokens by role: it
    removes spatial travel, keeps essential changes and cuts decorative movement. Because components
    already consume those tokens, none of them changes.
  </p>
  <CodeBlock code={reduced} label="semantic.scss" />

  <div class="sk-table-scroll">
    <table class="sk-table roles">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Role</th>
          <th class="sk-table__header">Reduction</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row">
          <td class="sk-table__cell">Helpful: enter, exit, reveal, navigate</td>
          <td class="sk-table__cell">Distance to 0; a short fade remains.</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell">Essential: state-change, expand, collapse</td>
          <td class="sk-table__cell">Short but readable duration.</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell">Decorative: emphasize, count</td>
          <td class="sk-table__cell">Duration to 0.</td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell">Continuous: loading</td>
          <td class="sk-table__cell">Softer cycle or a non-spatial variant.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Limits and next</h2>
  <ul>
    <li>Spring exists as a primitive but is not for critical UI: overshoot reads as imprecision.</li>
    <li>A loop does not communicate progress toward a final state, so loading needs a non-spatial alternative.</li>
    <li><a href="/state-layer">State layer</a> uses these tokens for interaction feedback.</li>
    <li><a href="/tiers">Tiers</a> explains why a component never jumps to primitive values.</li>
  </ul>
</FoundationPage>

<style>
  /* ── specimens: the tokens, played ──────────────────────────────────────────
   * A specimen is a token you can watch instead of read. The chrome around it stays flat on the
   * page background: the cards and rails bring their own surfaces, and a box around a box needs
   * a third radius nobody can keep concentric. */
  .specimens {
    display: grid;
    gap: var(--space-stack-sm);
    margin: var(--space-stack-md) 0 var(--space-section);
    overflow-x: clip;
  }

  .specimens__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-sm);
    align-items: center;
    justify-content: space-between;
    padding-block-end: var(--space-inset-xs);
    border-block-end: 1px solid var(--color-border-subtle);
  }

  .specimens__title {
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-label);
    color: var(--color-text-secondary);
  }

  .specimens__note {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
    line-height: var(--font-line-height-caption);
    text-wrap: pretty;
  }

  /* The reading instructions for every specimen on the page, said once. Marked as an aside by the
   * rule rather than by a box: it's addressed to the reader, not to the system. */
  .howto {
    border-inline-start: 2px solid var(--color-border-default);
    padding-inline-start: var(--space-inset-md);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .specimens__rows {
    display: grid;
    gap: var(--space-stack-xs);
  }

  .specimens__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-inline-sm);
  }

  /* Name, track, value. The value column is fixed so the rails all start and end on the same two
   * lines: a race is only readable if the lanes are. */
  .race {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr) 4.5rem;
    gap: var(--space-inline-sm);
    align-items: center;
  }

  .race__name {
    color: var(--color-text-secondary);
  }

  .race__value {
    text-align: end;
    /* The values are read down the column, so the digits have to line up. */
    font-variant-numeric: tabular-nums;
  }

  /*
   * The intents table carries no scrollport of its own.
   *
   * A table inside `.sk-table-scroll` owns a second scroll axis nested in the page's, and this one
   * had earned it by holding a `cubic-bezier(0.2, 0, 0, 1)` in every row: four unbreakable strings
   * wide, so the box overflowed and scrolled sideways at narrow widths. Naming the primitive
   * instead of quoting it removed the reason, and every cell left can wrap, so the table simply
   * fits and the page keeps a single scroll direction.
   */
  .intents {
    inline-size: 100%;
  }

  .intents :is(th, td) {
    /* Token names are one long unbreakable word; let them break rather than push the table wide. */
    overflow-wrap: anywhere;
  }

  .intents__sample {
    inline-size: 22%;
  }

  .intents__name {
    color: var(--color-text-primary);
  }

  .intents__ref {
    display: block;
  }

  /* The live value sits under the name it resolves from, quieter: the composition is the claim,
   * the number is the evidence. */
  .intents__used {
    display: block;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .intents__none {
    color: var(--color-text-tertiary);
  }

  .roles {
    inline-size: 100%;
  }

  /*
   * Narrow: the table has to FIT, because there is no scrollport under it any more.
   *
   * Two givens, in the order they cost the least. A rail shorter than a thumb can't time
   * anything, so the sample column is the first thing that can go. Below that the four columns
   * left are all load-bearing, and what's still spendable is the gutter between them, so the
   * consumer skin tightens the cell padding through the table's own styling hook rather than
   * dropping a column the reader came for.
   */
  @media (max-width: 34rem) {
    .intents :is(th, td):last-child {
      display: none;
    }
  }

  @media (max-width: 28rem) {
    .intents {
      --sk-table-cell-padding-x: var(--space-inset-xs);
      --sk-table-font-size: var(--font-size-caption);
    }
  }

  @media (max-width: 30rem) {
    .race {
      grid-template-columns: minmax(0, 1fr) 4.5rem;
    }

    .race__name {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { initMotionSpecimens } from "../scripts/motion-specimens";

  initMotionSpecimens();
</script>
