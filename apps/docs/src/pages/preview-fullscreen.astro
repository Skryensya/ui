---
/*
 * The render side of ComponentPreview's "Pantalla completa" menu action: a bare page, no Base
 * layout (no nav/sidebar/footer), that reconstructs ONE preview from a SHORT query string
 * (`?p=<docs page path>&id=<preview id>` — see `openComponentPreviewFullscreen` in
 * `@skryensya/vanilla/component-preview`).
 *
 * Nothing is server-rendered from those params: this site is `output: "static"` (no server to run
 * per-request), so the client script below `fetch()`es the docs page ITSELF — a real file, already
 * built, at the SAME url a reader's browser would load — and plucks the matching card back out of
 * that fresh markup by its stable id. That is what keeps the link short regardless of how large a
 * demo is: the URL carries a pointer, not the rendered card, so it stays readable and small the
 * same way for every preview on the site, and it works for anyone it is shared with, cold, exactly
 * as it worked for whoever clicked "Pantalla completa" first.
 *
 * The reconstructed card is ISOLATED in its own `srcdoc` iframe, not injected into THIS document —
 * the same realm-isolation the Vanilla stage already relies on (`buildPreviewFrameDocument`, see
 * ComponentPreview.astro's own header comment), for the same reasons: its own module graph, its own
 * globals, nothing it does can reach back into this shell page. This shell stays down to a loader
 * and one iframe, so there is very little to load here beyond the demo's own assets, and the
 * fetched page's dev-tooling scripts (Vite's HMR client, the dev toolbar, the prefetch/router
 * runtime) are filtered out before the iframe ever sees them — this page never navigates and has no
 * toolbar, so running them would be pure cost with nothing to show for it.
 */
import "@skryensya/core/components/loader.css";
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Pantalla completa</title>
    {/*
     * Same FOUC-prevention shape as Base.astro's own inline script (one localStorage key, "sk",
     * one JSON blob keyed by preference slot) — duplicated rather than imported, for the same
     * reason Base.astro's copy is inline: nothing can be awaited before paint. Only styles this
     * SHELL's own loader (the iframe gets its own copy of these same values baked into its `<html>`
     * tag directly, computed once in the script below — no point running the same localStorage read
     * twice just to end up in two different documents).
     */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var stored = {};
        try {
          stored = JSON.parse(localStorage.getItem("sk") || "{}");
        } catch (_error) {
          stored = {};
        }
        var scheme = stored.scheme;
        if (scheme === "light" || scheme === "dark") {
          d.setAttribute("data-scheme", scheme);
          d.style.colorScheme = scheme;
        } else {
          d.style.colorScheme = "light dark";
        }
        if (stored.contrast === "high") d.setAttribute("data-contrast", "high");
      })();
    </script>
    <style is:global>
      /*
       * `scrollbar-gutter: auto` overrides the site's own `html { scrollbar-gutter: stable }`
       * (patterns/scroll-lock.css): that reservation is for pages that open scroll-locked dialogs,
       * and this shell has nothing that scrolls at all.
       */
      html {
        block-size: 100%;
        overflow: hidden;
        scrollbar-gutter: auto;
      }
      body {
        block-size: 100%;
        margin: 0;
        overflow: hidden;
        background: var(--color-bg-canvas, var(--color-bg-surface, #fff));
      }
      /*
       * Astro's dev toolbar (dev-only; `astro build` never emits this element, so this rule is
       * inert in production) is a fixed-position overlay that sits on top of EVERY page's content —
       * including, on this one, the code drawer's own toggle tab pinned to the same bottom edge.
       * This page is meant to be one demo filling the whole screen with nothing else competing for
       * clicks, so the toolbar loses that fight here rather than intercepting the drawer's pointer
       * events.
       */
      astro-dev-toolbar {
        display: none !important;
      }
      .sk-fullscreen-preview__loader {
        display: grid;
        place-items: center;
        block-size: 100vh;
      }
      #sk-fullscreen-preview-frame {
        display: block;
        inline-size: 100%;
        block-size: 100vh;
        border: 0;
      }
    </style>
  </head>
  <body>
    <div id="sk-fullscreen-preview-loader" class="sk-fullscreen-preview__loader">
      <span class="sk-loader" data-size="lg" role="status" aria-label="Cargando…"></span>
    </div>
    <iframe id="sk-fullscreen-preview-frame" title="Pantalla completa" hidden></iframe>
    <script>
      /*
       * Only the couple of strings this page authors itself (the code drawer's tab, the "back to
       * docs" menu item) — everything else on the card is markup lifted straight from the fetched
       * page, already in whichever language that page was built in.
       */
      const STRINGS: Record<"es" | "en", { code: string; viewInDocs: string; error: string; missing: string }> = {
        es: {
          code: "Código",
          viewInDocs: "Ver en la documentación",
          error: "No se pudo cargar el preview.",
          missing: "Este enlace no trae ningún preview.",
        },
        en: {
          code: "Code",
          viewInDocs: "View in docs",
          error: "Couldn't load the preview.",
          missing: "This link carries no preview.",
        },
      };

      const localeOf = (pathname: string): "es" | "en" => (pathname.startsWith("/en/") ? "en" : "es");

      /** A same-origin, root-relative path only: blocks a shared link from making this page fetch (or link to) another origin. */
      function isSafeSitePath(value: string | null): value is string {
        return typeof value === "string" && value.startsWith("/") && !value.startsWith("//");
      }

      /**
       * Dev-only tooling this fullscreen iframe has no use for: Vite's HMR client (nothing here
       * ever hot-reloads), the dev toolbar (an overlay this page has no room or reason to show), and
       * Astro's client-router/prefetch runtime (this iframe never navigates internally). Everything
       * else found on the fetched page — the real component CSS, the Vanilla/Svelte enhancers,
       * `@astrojs/react`'s island runtime — is kept: a demo the codebase itself built is a much safer
       * default to trust than a hand-picked allowlist that would silently break the first component
       * whose needs this list didn't anticipate.
       */
      const IRRELEVANT_SCRIPT_PATTERNS = [/\/@vite\/client/, /dev-toolbar/, /astro:scripts\/page/];

      function resolve(base: string, value: string): string {
        return new URL(value, base).href;
      }

      /*
       * Built by concatenation rather than typed as one closing-tag literal: this file's own
       * surrounding script block is plain HTML from the tokenizer's point of view, and it ends a
       * script element at the first matching close sequence it finds in the raw source TEXT —
       * comments and JS string quoting included, since it never gets far enough to parse any of
       * that. Splitting the sequence keeps every closing tag the srcdoc string below builds out of
       * the raw source text that would otherwise end this very script early.
       */
      const SCRIPT_CLOSE = "</" + "script>";

      async function render(): Promise<void> {
        const loader = document.getElementById("sk-fullscreen-preview-loader")!;
        const frame = document.getElementById("sk-fullscreen-preview-frame") as HTMLIFrameElement;

        const showError = (message: string) => {
          loader.remove();
          document.body.append(Object.assign(document.createElement("p"), { textContent: message }));
        };

        const params = new URLSearchParams(location.search);
        const pagePath = params.get("p");
        const previewId = params.get("id");
        if (!isSafeSitePath(pagePath) || !previewId) {
          showError(STRINGS.es.missing);
          return;
        }

        const strings = STRINGS[localeOf(pagePath)];
        document.documentElement.lang = localeOf(pagePath);

        let pageHtml: string;
        try {
          const response = await fetch(pagePath);
          if (!response.ok) throw new Error(String(response.status));
          pageHtml = await response.text();
        } catch {
          showError(strings.error);
          return;
        }

        const parsed = new DOMParser().parseFromString(pageHtml, "text/html");
        const card = parsed.getElementById(previewId);
        if (!card || !card.classList.contains("sk-component-preview")) {
          showError(strings.error);
          return;
        }

        document.title = card.querySelector(".sk-component-preview__title")?.textContent?.trim() ?? "Preview";

        // No resizer (the stage IS the viewport here, nothing to drag toward) and no re-opening
        // fullscreen from inside fullscreen; no inline height a prior drag/auto-fit left behind.
        card.querySelector("[data-sk-component-preview-resizer]")?.remove();
        card.querySelector("[data-sk-component-preview-fullscreen]")?.remove();
        card.removeAttribute("style");

        // The source panels, pulled out from under the stage and into one bottom drawer the reader
        // opens on purpose — closed by default, so the live specimen gets the whole screen at first.
        const panels = [...card.querySelectorAll<HTMLElement>(".sk-component-preview__binding")];
        if (panels.length) {
          const drawer = parsed.createElement("div");
          drawer.className = "sk-fullscreen-preview__code";
          drawer.dataset.open = "false";
          const toggle = parsed.createElement("button");
          toggle.type = "button";
          toggle.className = "sk-fullscreen-preview__code-toggle";
          toggle.setAttribute("aria-expanded", "false");
          const toggleLabel = parsed.createElement("span");
          toggleLabel.textContent = strings.code;
          const chevron = parsed.createElement("span");
          chevron.className = "sk-fullscreen-preview__code-chevron";
          chevron.setAttribute("aria-hidden", "true");
          toggle.append(toggleLabel, chevron);
          const body = parsed.createElement("div");
          body.className = "sk-fullscreen-preview__code-body";
          for (const panel of panels) body.append(panel);
          drawer.append(toggle, body);
          card.append(drawer);
        }

        // "Ver en la documentación": absent on the docs page's own menu (see ComponentPreview.astro),
        // added ONLY here — the one context that has actually left that page behind.
        const menuContent = card.querySelector("[data-sk-menu-content]");
        if (menuContent) {
          const link = parsed.createElement("a");
          link.className = "sk-menu__item sk-interactive";
          link.setAttribute("data-sk-menu-item", "");
          link.dataset.value = "view-in-docs";
          link.href = `${pagePath}#${previewId}`;
          const label = parsed.createElement("span");
          label.className = "sk-menu__item-label";
          label.textContent = strings.viewInDocs;
          link.append(label);
          menuContent.append(link);
        }

        /*
         * Stylesheets: BOTH forms the fetched page might use — a production build's real
         * `<link rel="stylesheet">`, and a dev server's CSS-as-a-module `<script type="module"
         * src="*.css">` (Vite serves either request the same way, so both resolve to plain CSS text
         * over the wire regardless of which tag shape the page used to reach it). Read raw attribute
         * values, resolved by hand: a `DOMParser` document's base URI is `about:blank`, so its own
         * `.href`/`.src` getters cannot be trusted to resolve root-relative paths against this site's
         * origin.
         */
        const linkHrefs = [...parsed.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')]
          .map((link) => link.getAttribute("href"))
          .filter((href): href is string => Boolean(href));

        const scriptSrcs = [...parsed.querySelectorAll<HTMLScriptElement>('script[type="module"]')]
          .map((script) => script.getAttribute("src"))
          .filter((src): src is string => Boolean(src));

        // Deduped by resolved URL: a page with several previews of the same component (Button's
        // page shows seven) repeats the same stylesheet/script tag once per instance, and loading
        // it that many times over would only add redundant requests without changing anything it
        // renders.
        const cssHrefs = new Set<string>();
        const jsSrcs = new Set<string>();
        for (const href of linkHrefs) cssHrefs.add(resolve(location.origin, href));
        for (const src of scriptSrcs) {
          if (IRRELEVANT_SCRIPT_PATTERNS.some((pattern) => pattern.test(src))) continue;
          const resolved = resolve(location.origin, src);
          if (/\.(css|scss)$/.test(src)) cssHrefs.add(resolved);
          else jsSrcs.add(resolved);
        }

        const styleTags = [...cssHrefs].map((href) => `<link rel="stylesheet" href="${href}">`).join("\n");
        const scriptTags = [...jsSrcs]
          .map((src) => `<script type="module" src="${src}">${SCRIPT_CLOSE}`)
          .join("\n");

        const stored = (() => {
          try {
            return JSON.parse(localStorage.getItem("sk") || "{}");
          } catch {
            return {};
          }
        })();
        const scheme = stored.scheme === "light" || stored.scheme === "dark" ? stored.scheme : undefined;
        const htmlAttrs = [
          scheme ? `data-scheme="${scheme}"` : "",
          stored.contrast === "high" ? 'data-contrast="high"' : "",
          `style="color-scheme: ${scheme ?? "light dark"}"`,
        ]
          .filter(Boolean)
          .join(" ");

        const srcdoc = `<!doctype html>
<html ${htmlAttrs}>
<head>
<meta charset="utf-8">
${styleTags}
<style>
  body {
    margin: 0;
    overflow: hidden;
  }
  body, .sk-component-preview, .sk-component-preview * {
    border-radius: 0 !important;
  }
  .sk-component-preview {
    display: grid;
    grid-template-rows: auto 1fr;
    inline-size: 100%;
    block-size: 100vh;
    margin: 0;
    border-width: 0;
  }
  .sk-component-preview__stage, .sk-component-preview__loading {
    block-size: 100%;
    min-block-size: 0;
  }
  .sk-fullscreen-preview__code {
    --sk-fs-code-tab: 2.75rem;
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    block-size: min(70vh, 34rem);
    background: var(--color-bg-surface, #fff);
    border-block-start: 1px solid var(--color-border-subtle, #ccc);
    box-shadow: 0 -0.5rem 1.5rem rgba(0, 0, 0, 0.18);
    transform: translateY(calc(100% - var(--sk-fs-code-tab)));
    transition: transform var(--motion-state-change-duration, 220ms) var(--motion-state-change-easing, ease);
  }
  .sk-fullscreen-preview__code[data-open="true"] {
    transform: translateY(0);
  }
  .sk-fullscreen-preview__code-toggle {
    display: flex;
    flex: 0 0 var(--sk-fs-code-tab);
    align-items: center;
    inline-size: 100%;
    block-size: var(--sk-fs-code-tab);
    gap: var(--space-inline-sm, 0.5rem);
    padding-inline: var(--space-inset-md, 0.75rem);
    border: 0;
    background: var(--color-bg-surface-sunken, #f2f2f2);
    color: inherit;
    font: inherit;
    font-family: var(--font-family-code, monospace);
    font-size: var(--font-size-caption, 0.8125rem);
    cursor: pointer;
  }
  .sk-fullscreen-preview__code-chevron {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    margin-inline-start: auto;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--motion-state-change-duration, 150ms) var(--motion-state-change-easing, ease);
  }
  .sk-fullscreen-preview__code[data-open="true"] .sk-fullscreen-preview__code-chevron {
    transform: rotate(135deg);
  }
  .sk-fullscreen-preview__code-body {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow: auto;
    border-block-start: 1px solid var(--color-border-subtle, #ccc);
  }
</style>
</head>
<body>
${card.outerHTML}
${scriptTags}
<script>
  document.querySelectorAll(".sk-fullscreen-preview__code-toggle").forEach(function (toggle) {
    toggle.addEventListener("click", function () {
      var drawer = toggle.closest(".sk-fullscreen-preview__code");
      var open = drawer.getAttribute("data-open") === "true";
      drawer.setAttribute("data-open", String(!open));
      toggle.setAttribute("aria-expanded", String(!open));
    });
  });
${SCRIPT_CLOSE}
</body>
</html>`;

        frame.addEventListener("load", () => {
          loader.remove();
          frame.hidden = false;
        });
        frame.srcdoc = srcdoc;
      }

      void render();
    </script>
  </body>
</html>
