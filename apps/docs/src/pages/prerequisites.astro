---
import Base from "../layouts/Base.astro";

type Ref = {
  label: string;
  href: string;
  note: string;
};

type Concept = {
  id: string;
  title: string;
  why: string;
  refs: readonly Ref[];
  here?: string;
};

const concepts: readonly Concept[] = [
  {
    id: "custom-properties",
    title: "Custom properties (variables CSS)",
    why: "They are the runtime of the tokens: each system value is a custom property that is read in the browser.",
    refs: [
      {
        label: "MDN, Using CSS custom properties",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_cascading_variables/Using_CSS_custom_properties",
        note: "Declaration, var(), inheritance, and fallbacks.",
      },
      {
        label: "MDN, var()",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/var",
        note: "Reference and cascade syntax.",
      },
    ],
    here: "Tiers, styling hooks and the live reference.",
  },
  {
    id: "cascade-layers",
    title: "Cascade layers",
    why: "The seam between tiers does not depend on @import order; it lives in @layer.",
    refs: [
      {
        label: "MDN, @layer",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@layer",
        note: "Precedence between layers and CSS without layer.",
      },
      {
        label: "MDN, Cascade, specificity, and inheritance",
        href: "https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Styling_basics/Cascade_layers",
        note: "How layers fit into the waterfall.",
      },
    ],
    here: "primitives → semantic → components → overrides.",
  },
  {
    id: "light-dark",
    title: "light-dark()",
    why: "The light/dark mode is a color axis with two slots; there is no third argument for high contrast.",
    refs: [
      {
        label: "MDN, light-dark()",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/light-dark",
        note: "Native function and color-scheme.",
      },
    ],
    here: "Dimensions and semantic color tokens.",
  },
  {
    id: "oklch",
    title: "OKLCH y color-mix()",
    why: "Color primitives are written in oklch(); Blends and states use the perceptual space of the CSS Color Module.",
    refs: [
      {
        label: "MDN, oklch()",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/color_value/oklch",
        note: "Luminosidad, chroma y hue.",
      },
      {
        label: "MDN, color-mix()",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/color_mix",
        note: "Mezcla en oklab/oklch y otros espacios.",
      },
      {
        label: "W3C, CSS Color Module Level 4",
        href: "https://www.w3.org/TR/css-color-4/",
        note: "Spec of the color model in CSS.",
      },
    ],
    here: "Explicit ramps, branding and contrast.",
  },
  {
    id: "media-queries",
    title: "User preferences (media queries)",
    why: "Contrast, motion and transparency react to the operating system as well as site controls. inverted-colors is left out: the inversion occurs after the render and is only implemented by WebKit, unfortunately there is no token to redefine.",
    refs: [
      {
        label: "MDN, prefers-contrast",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@media/prefers-contrast",
        note: "High contrast preferred by OS.",
      },
      {
        label: "MDN, prefers-reduced-motion",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@media/prefers-reduced-motion",
        note: "Reducing movement is not “setting everything to zero.”",
      },
      {
        label: "MDN, prefers-reduced-transparency",
        href: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@media/prefers-reduced-transparency",
        note: "Experimental: an opaque surface should remain the fallback.",
      },
    ],
    here: "Dimensions, motion by intention and transparencies.",
  },
  {
    id: "dialog",
    title: "Dialog",
    why: "Modality, ESC, focus and inert page are from the platform; the system does not reimplement a dialog in a div.",
    refs: [
      {
        label: "MDN, <dialog>",
        href: "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/dialog",
        note: "Elemento, showModal() y ::backdrop.",
      },
      {
        label: "HTML Living Standard, dialog",
        href: "https://html.spec.whatwg.org/multipage/interactive-elements.html#the-dialog-element",
        note: "Comportamiento normativo.",
      },
    ],
    here: "Dialog (and the Dialog Vaul option).",
  },
  {
    id: "tables",
    title: "Tablas HTML y caption",
    why: "Data tables retain native semantics; the caption names the table programmatically.",
    refs: [
      {
        label: "MDN, <caption>",
        href: "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/caption",
        note: "First child of table; accessible name.",
      },
      {
        label: "web.dev, Tables",
        href: "https://web.dev/learn/html/tables",
        note: "Captions, headers, and accessibility.",
      },
      {
        label: "W3C WAI, Captions & summaries",
        href: "https://www.w3.org/WAI/tutorials/tables/caption-summary/",
        note: "When caption vs summary.",
      },
    ],
    here: "Component Table.",
  },
  {
    id: "wcag",
    title: "Contraste WCAG",
    why: "The validator measures color pairs; the density touch floor also comes out of WCAG.",
    refs: [
      {
        label: "WCAG 2.2, Contrast (Minimum)",
        href: "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
        note: "1.4.3 text.",
      },
      {
        label: "WCAG 2.2, Non-text Contrast",
        href: "https://www.w3.org/WAI/WCAG22/Understanding/non-text-contrast.html",
        note: "1.4.11 UI and graphics.",
      },
      {
        label: "WCAG 2.2, Target Size (Minimum)",
        href: "https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html",
        note: "2.5.8 target size.",
      },
    ],
    here: "Validator, density, high contrast.",
  },
  {
    id: "design-tokens",
    title: "Design tokens (concepto)",
    why: "The system talks about primitives, semantics and hooks: it is the idea of ​​layered tokens, applied in pure CSS.",
    refs: [
      {
        label: "W3C Design Tokens Community Group",
        href: "https://www.w3.org/community/design-tokens/",
        note: "Vocabulary and format in standardization.",
      },
      {
        label: "Design Tokens Format Module (borrador)",
        href: "https://design-tokens.github.io/community-group/format/",
        note: "How tokens are described interchangeably.",
      },
    ],
    here: "Tiers and styling hooks (our cut is CSS, not JSON).",
  },
  {
    id: "bem",
    title: "BEM",
    why: "The parts of a component with fixed anatomy are named in BEM and are permanent even if the machine underneath changes.",
    refs: [
      {
        label: "getbem.com",
        href: "https://getbem.com/",
        note: "Block, Element, Modifier.",
      },
      {
        label: "BEM, Naming",
        href: "https://en.bem.info/methodology/naming-convention/",
        note: "Naming convention.",
      },
    ],
    here: "Markup contract y parts (sk-tabs__list, …).",
  },
  {
    id: "progressive-enhancement",
    title: "Progressive enhancement",
    why: "Vanilla hydrates authored HTML; Without JS, what the platform already solves still works.",
    refs: [
      {
        label: "MDN, Progressive enhancement",
        href: "https://developer.mozilla.org/en-US/docs/Glossary/Progressive_Enhancement",
        note: "Definition and approach.",
      },
      {
        label: "GOV.UK, Progressive enhancement",
        href: "https://www.gov.uk/service-manual/technology/using-progressive-enhancement",
        note: "Practice on real products.",
      },
    ],
    here: "Capa vanilla e initComponents().",
  },
  {
    id: "sass",
    title: "Sass (for source tokens only)",
    why: "Token entrypoints use Sass where CSS has no macro; the consumer still imports CSS/custom properties.",
    refs: [
      {
        label: "Sass, @use",
        href: "https://sass-lang.com/documentation/at-rules/use/",
        note: "Modules and public API.",
      },
      {
        label: "Sass documentation",
        href: "https://sass-lang.com/documentation/",
        note: "Language reference.",
      },
    ],
    here: "Ramps, high contrast and the entrypoint tokens.scss.",
  },
];
---

<Base
  title="Prerrequisitos"
  description="Platform concepts and standards that this design system considers known, with external references."
  documentLayout="grid"
>
  <h1>Prerequisites</h1>
  <p class="lede">
    This page does not explain the system: it points to external material that should be mastered first. Each concept lists <strong>why</strong> appears here and links to the source (MDN, W3C, specs).“How we apply it” is on the system pages; <em>because</em> of each slice lives in <code>docs/decisions/</code> of the repository.
  </p>

  {
    concepts.map((concept) => (
      <section class="docs-prereq" aria-labelledby={`prereq-${concept.id}`}>
        <h2 id={`prereq-${concept.id}`}>{concept.title}</h2>
        <p>{concept.why}</p>
        <ul class="docs-prereq__refs">
          {concept.refs.map((ref) => (
            <li>
              <a href={ref.href} rel="noopener noreferrer" target="_blank">
                {ref.label}
              </a>
              <span class="docs-prereq__note">, {ref.note}</span>
            </li>
          ))}
        </ul>
        {concept.here && (
          <p class="docs-prereq__here">
            On this site: <em>{concept.here}</em>
          </p>
        )}
      </section>
    ))
  }

  <h2>After that</h2>
  <p>
    With those platform parts, follow <a href="/en/installation">installation</a>, <a href="/en/first-component">your first component</a> and the basics: <a href="/en/tiers">tiers</a>, <a href="/en/dimensions">dimensions</a>, <a href="/en/styling-hooks">styling hooks</a>.
  </p>
</Base>

<style>
  .docs-prereq + .docs-prereq {
    margin-block-start: var(--space-stack-xl);
  }

  .docs-prereq__refs {
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  .docs-prereq__refs li + li {
    margin-block-start: var(--space-stack-xs);
  }

  .docs-prereq__note {
    color: var(--color-text-secondary);
  }

  .docs-prereq__here {
    margin-block-start: var(--space-stack-sm);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-sm);
  }
</style>
