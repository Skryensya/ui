---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import ComponentPreview from "../components/ComponentPreview.astro";
import { sidebarResizableTree } from "../demos/sidebar";
import { getLocale, useTranslations } from "../i18n";

import "@skryensya/core/components/tree-view.css";

const t = useTranslations(getLocale(Astro.url));

const import_ = `@import "@skryensya/core/patterns/splitter.css";`;

/*
 * Hardcoded, not pulled from lib/tokens.ts's corpus: `--sk-splitter-*` is declared here in
 * patterns/splitter.css AND redeclared as an override inside components/sidebar.css (its resize
 * handle's own hook). The corpus dedupes by name, first file wins, and `components/` sorts before
 * `patterns/`: so every one of these four would attribute to sidebar.css instead, and Used.astro's
 * probe would read them off a bare `.sk-sidebar`, not `.sk-splitter`. Wrong file, wrong value.
 */
const hooks = [
  ["--sk-splitter-hit", "var(--space-inset-sm)", "Ancho de la zona de agarre; el hairline vive adentro, más angosto."],
  ["--sk-splitter-line", "2px", "Grosor del hairline visible."],
  ["--sk-splitter-color", "var(--color-border-strong)", "Color del hairline en hover."],
  ["--sk-splitter-active-color", "var(--color-border-accent)", "Color del hairline en foco o mientras se arrastra."],
] as const;

const handleHtml = `<!-- Sidebar: pinza UN valor contra un límite fijo -->
<div
  class="sk-sidebar__resize-handle sk-splitter"
  role="separator"
  aria-orientation="vertical"
  aria-label="Redimensionar panel"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="38"
  tabindex="0"
></div>`;

const columnHtml = `<!-- Table / Treegrid: redistribuye entre un PAR de columnas vecinas -->
<th>
  Nombre
  <div
    class="sk-table__column-resizer sk-splitter"
    role="separator"
    aria-orientation="vertical"
    aria-label="Redimensionar columna Nombre"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="52"
    tabindex="0"
  ></div>
</th>`;

const keyboard = [
  ["←", "Un paso (16px por defecto) hacia el borde de inicio."],
  ["→", "Un paso hacia el borde de fin."],
  ["Shift + ←/→", "Paso grueso (64px por defecto): la misma tecla, cuatro veces más lejos."],
  ["Home", "Salta al mínimo de su recorrido."],
  ["End", "Salta al máximo de su recorrido."],
  ["Enter", "Resetea al valor por defecto. Por convención, doble clic hace lo mismo."],
];
---

<Base
  title="Splitter"
  documentLayout="grid"
  description="El separador de arrastre compartido: role=separator, un modelo de valor por consumidor, la misma franja visual en Sidebar, Table y Treegrid."
>
  <h1>Splitter</h1>
  <p class="lede">
    El patrón <strong>Window Splitter</strong> de WAI-ARIA: una franja delgada, arrastrable con
    puntero o teclado, que redimensiona lo que tiene al lado. <code>Sidebar</code> lo usa para su
    ancho de panel; <code>Table</code> y <code>Treegrid</code> lo usan entre cada par de columnas.
    Los tres comparten un solo primitivo: <code>@skryensya/core/splitter.ts</code> para el
    comportamiento, <code>.sk-splitter</code> para la franja visual: en vez de reimplementar
    arrastre y teclado cada vez.
  </p>

  <h2>Un primitivo, dos modelos de valor</h2>
  <p>
    Ambos son "un splitter", pero mueven cantidades distintas. El primitivo se queda ignorante de
    cuál: solo devuelve un <code>delta</code> (o una intención <code>home</code>/<code>end</code>/
    <code>reset</code>) y deja que quien lo consume decida qué significa "moverlo".
  </p>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Consumidor</th>
          <th class="sk-table__header">Qué mueve</th>
          <th class="sk-table__header">Aritmética</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row">
          <td class="sk-table__cell"><strong>Sidebar</strong></td>
          <td class="sk-table__cell">Un valor único contra un límite fijo</td>
          <td class="sk-table__cell">
            <code>clamp()</code> en CSS: no hay "otro panel" con el que conservar un ancho total.
          </td>
        </tr>
        <tr class="sk-table__row">
          <td class="sk-table__cell"><strong>Table / Treegrid</strong></td>
          <td class="sk-table__cell">Un par de columnas vecinas</td>
          <td class="sk-table__cell">
            <code>resolveColumnResize</code>: la suma del par se mantiene fija, así que ninguna
            otra columna se mueve.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Marca el separador</h2>
  <p>
    <code>.sk-splitter</code> solo dibuja la franja: tamaño, posición, cursor, color en
    hover/focus/drag. No sabe qué redimensiona. El bloque contenedor lo da el consumidor
    (Sidebar la flota contra el borde del panel; Treegrid pone una dentro de cada <code>th</code>),
    y el binding del consumidor escribe <code>data-dragging</code> mientras dura el gesto, el
    único estado que este archivo lee.
  </p>
  <CodeBlock code={handleHtml} label="HTML · Sidebar" note="valor único, clamp en CSS" />
  <CodeBlock code={columnHtml} label="HTML · Table / Treegrid" note="par de columnas vecinas" />

  <h2>En vivo</h2>
  <p>
    El mismo demo de <a href="/componentes/sidebar">Sidebar</a>: arrastrá el borde del panel con
    el puntero, o enfocalo y usá las flechas.
  </p>
  <ComponentPreview
    tree={sidebarResizableTree(t)}
    label={t("sidebarPage.resizableLabel")}
    flush
  />

  <h2>Teclado</h2>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Tecla</th>
          <th class="sk-table__header">Acción</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        {
          keyboard.map(([key, action]) => (
            <tr class="sk-table__row">
              <td class="sk-table__cell mono">{key}</td>
              <td class="sk-table__cell">{action}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Accesibilidad</h2>
  <ul>
    <li>
      <code>role="separator"</code> + <code>aria-orientation</code> lo identifican como el patrón
      Window Splitter, no como un <code>slider</code> ni un <code>scrollbar</code>.
    </li>
    <li>
      <code>aria-valuemin</code>/<code>aria-valuemax</code>/<code>aria-valuenow</code> reportan la
      posición como porcentaje de su propio recorrido (<code>splitterValuePercent</code>), nunca un
      píxel crudo: un lector de pantalla no aprende nada de una cifra sin el rango que la enmarca.
    </li>
    <li>
      <code>aria-label</code> es obligatorio, no opcional: el separador lo inserta el binding, nunca
      lo autora el consumidor, así que nada más lo nombra para un lector de pantalla. El gate de
      accesibilidad del contrato (<code>resizeLabel</code> en Table/Treegrid) lo exige.
    </li>
    <li>
      El anillo de foco es <code>inset</code>: un handle al ras del borde de su contenedor tendría
      el outline dibujado afuera, recortado por el <code>overflow: hidden</code> de ese contenedor
      (el caso de Sidebar). Inset funciona sin que el patrón necesite saber si el consumidor recorta.
    </li>
    <li>
      En <code>forced-colors</code>, la franja se dibuja con <code>CanvasText</code>: el state layer
      y el acento desaparecen ahí, así que el borde necesita existir como borde real.
    </li>
  </ul>

  <h2>Instalar</h2>
  <CodeBlock code={import_} label="CSS" />

  <h2>Styling hooks</h2>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row">
          <th class="sk-table__header">Hook</th>
          <th class="sk-table__header">Valor por defecto</th>
          <th class="sk-table__header">Qué controla</th>
        </tr>
      </thead>
      <tbody class="sk-table__body">
        {
          hooks.map(([name, value, note]) => (
            <tr class="sk-table__row">
              <td class="sk-table__cell mono">{name}</td>
              <td class="sk-table__cell mono">{value}</td>
              <td class="sk-table__cell">{note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    Sidebar re-declara estos cuatro contra su propio <code>--sk-sidebar-resize-*</code> (ver
    <a href="/componentes/sidebar">Sidebar</a>), la misma forma en que cualquier host re-declara un
    hook de pattern sin tocar su markup.
  </p>

  <h2>Dónde vive</h2>
  <ul>
    <li><a href="/componentes/sidebar">Sidebar</a>: <code>SidebarResizeHandle</code>, valor único.</li>
    <li><a href="/componentes/table">Table</a>: <code>resizableColumns</code>/<code>resizeLabel</code>, opt-in.</li>
    <li><a href="/componentes/treegrid">Treegrid</a>: mismo par <code>resizableColumns</code>/<code>resizeLabel</code>, más <code>columnWeights</code> para el reparto inicial.</li>
  </ul>
</Base>
