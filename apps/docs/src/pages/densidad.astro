---
import "@skryensya/core/components/slider.css";
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import type { UsageTree } from "@skryensya/core/usage-tree";
import ComponentPreview from "../components/ComponentPreview.astro";

/* The site remains an honest consumer: input/field needs its authored paint rules. */

const componentMarkup = `<section
  class="sk-box sk-stack"
  data-sk-density-scope
  style="--sk-density-factor: 0.72"
  data-surface="surface"
  data-border="subtle"
  data-padding="lg"
  data-gap="sm"
>
  <header>
    <strong>Resumen del pedido</strong>
  </header>

  <div class="sk-form-field">
    <label class="sk-form-field__label" for="delivery-email">Email</label>
    <input class="sk-input" id="delivery-email" type="email" />
  </div>

  <button
    class="sk-button sk-interactive"
    data-sk-button
    data-tone="accent"
    type="button"
  >
    Guardar cambios
  </button>
</section>`;

const absoluteDensity = `<section
  data-sk-density-scope
  style="--sk-density: 0.72"
>
  <!-- contenido normal del componente -->
</section>`;

const densityLabScript = `document.querySelectorAll("[data-density-lab]").forEach((lab) => {
  const slider = lab.querySelector("[data-density-slider]");
  const target = lab.querySelector("[data-density-target]");
  const factorOutput = lab.querySelector("[data-density-factor-output]");
  const effectiveOutput = lab.querySelector("[data-density-effective-output]");
  const paddingOutput = lab.querySelector("[data-density-padding-output]");
  const buttonOutput = lab.querySelector("[data-density-button-output]");
  const button = target?.querySelector(".sk-button");

  if (
    !(slider instanceof HTMLElement)
    || !(target instanceof HTMLElement)
    || !(factorOutput instanceof HTMLElement)
    || !(effectiveOutput instanceof HTMLElement)
    || !(paddingOutput instanceof HTMLElement)
    || !(buttonOutput instanceof HTMLElement)
    || !(button instanceof HTMLButtonElement)
  ) return;

  const render = () => {
    const thumb = slider.querySelector('[role="slider"]');
    const value = Number(thumb?.getAttribute("aria-valuenow") ?? slider.getAttribute("data-value"));
    const factor = value / 100;

    target.style.setProperty("--sk-density-factor", String(factor));
    thumb?.setAttribute("aria-valuetext", \`\${factor.toFixed(2)} veces la densidad del sistema\`);
    factorOutput.textContent = \`\${factor.toFixed(2)}×\`;

    const density = Number.parseFloat(getComputedStyle(target).getPropertyValue("--sk-density"));
    effectiveOutput.textContent = \`\${density.toFixed(2)}×\`;
    paddingOutput.textContent = getComputedStyle(target).paddingInlineStart;
    buttonOutput.textContent = \`\${Math.round(button.getBoundingClientRect().height)}px\`;
  };

  slider.addEventListener("sk-value-change", render);
  render();
});`;

const densityPreviewTree: UsageTree = {
  contract: "layout",
  signature: "Stack",
  options: { gap: "lg" },
  attrs: { "data-density-lab": "", style: "inline-size: 100%" },
  children: [
    {
      contract: "layout",
      signature: "Stack",
      options: { gap: "xs" },
      children: [
        {
          contract: "layout",
          signature: "Inline",
          options: { gap: "sm", inlineAlign: "baseline" },
          children: ["Factor local", { contract: "typography", signature: "Code", attrs: { "data-density-factor-output": "" }, children: "1.00×" }],
        },
        { contract: "slider", signature: "Slider", options: { value: 72, min: 50, max: 120, step: 1 }, attrs: { id: "density-factor-control", "aria-label": "Factor local", "data-density-slider": "", "aria-valuetext": "0.72 veces la densidad del sistema" } },
      ],
    },
    {
      // Raw `data-sk-density-scope` + `--sk-density-factor`, hand-authored on the attrs the same
      // way `CopyButton.astro` and the presets gallery already do it: the scope is a plain
      // attribute contract, not something that ever needed its own signature to exist.
      contract: "box",
      signature: "Box",
      options: { surface: "surface", border: "subtle", padding: "lg" },
      attrs: {
        class: "sk-stack",
        "data-density-target": "",
        "data-gap": "sm",
        "data-sk-density-scope": "",
        style: "--sk-density-factor: 0.72",
      },
      children: [
        "Resumen del pedido",
        {
          contract: "form-field",
          signature: "FormField",
          slots: {
            label: "Email",
            children: { contract: "input", signature: "Input", options: { type: "email" }, attrs: { id: "delivery-email" } },
          },
        },
        { contract: "button", signature: "Button.action", options: { tone: "accent" }, children: "Guardar cambios" },
        {
          contract: "layout",
          signature: "Inline",
          options: { gap: "sm", inlineAlign: "baseline" },
          children: [
            { contract: "button", signature: "Button.action", options: { variant: "ghost" }, children: "Cancelar" },
            { contract: "typography", signature: "Code", attrs: { "data-density-effective-output": "" }, children: "0.72×" },
            { contract: "typography", signature: "Code", attrs: { "data-density-padding-output": "" }, children: "0px" },
            { contract: "typography", signature: "Code", attrs: { "data-density-button-output": "" }, children: "44px" },
          ],
        },
      ],
    },
  ],
};
---

<Base
  title="Densidad global y local"
  documentLayout="grid"
  description="La densidad global ajusta la aplicación; un scope local recalcula un componente sin compactar sus vecinos."
>
  <h1>Densidad global y local</h1>
  <p class="lede">
    La densidad es un multiplicador global sobre espacio y tamaños de control. Un scope local permite
    compactar o espaciar un componente aislado sin cambiar la densidad de la aplicación ni marcar cada
    descendiente.
  </p>

  <h2>Scope global</h2>
  <p>
    El valor de aplicación vive en <code>--sk-density</code>, normalmente en <code>html</code>. Los
    tokens semánticos de espacio y control lo leen en runtime; los componentes no reciben una prop de
    densidad.
  </p>
  <CodeBlock code={`html { --sk-density: 0.8; }`} label="CSS" />

  <h2>Scope local</h2>
  <p>
    Para una excepción, se declara <code>data-sk-density-scope</code> en la raíz del componente. El
    mismo nodo lleva <code>--sk-density-factor</code> si debe multiplicar la densidad global, o
    <code>--sk-density</code> si necesita un valor absoluto.
  </p>
  <CodeBlock code={componentMarkup} label="HTML del componente" />

  <h2>Factor relativo y valor absoluto</h2>
  <p>
    El factor relativo conserva la intención del usuario: un componente con factor <code>0.72</code>
    sigue siendo 72% de la densidad elegida para la aplicación. El valor absoluto ignora esa densidad y
    se reserva para superficies que deben medir igual en cualquier contexto.
  </p>
  <CodeBlock code={absoluteDensity} label="HTML con valor absoluto" />

  <h2>Prueba un componente aislado</h2>
  <p>
    El control queda fuera del scope. Al moverlo, cambian padding, gaps y tamaños semánticos dentro del
    resumen; el resto de la página no se mueve.
  </p>
  <ComponentPreview tree={densityPreviewTree} previewScript={densityLabScript} label="Scope local en acción" note="scope y valor viven inline en el mismo nodo" />

  <h2>Qué cambia, y qué no</h2>
  <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head">
        <tr class="sk-table__row"><th class="sk-table__header">Dentro del scope</th><th class="sk-table__header">Comportamiento</th></tr>
      </thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row"><td class="sk-table__cell"><code>--space-*</code></td><td class="sk-table__cell">Padding, gaps e insets se recalculan con la densidad efectiva.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell"><code>--size-control-*</code></td><td class="sk-table__cell">Se recalculan, con el piso de tamaño mínimo incorporado.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Tipografía, iconos y radio</td><td class="sk-table__cell">Permanecen invariantes: densidad acerca contenido, no cambia la escala visual.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Focus ring y área táctil</td><td class="sk-table__cell">Permanecen protegidos. Un Button default no baja de <code>44px</code> de pintura; <code>data-size="sm"</code> puede pintar a 32px y mantener el hit en <code>44px</code>.</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell">Wrappers y <code>--space-section</code></td><td class="sk-table__cell">No se compactan: la geometría de página no pertenece al componente.</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Scopes anidados</h2>
  <p>
    Cada scope calcula su factor contra la densidad capturada del sistema, no contra el scope padre. Un
    componente a <code>0.72</code> dentro de otro a <code>0.72</code> sigue resolviendo a
    <code>0.72 × sistema</code>, no a <code>0.5184 × sistema</code>.
  </p>

  <h2>Límites</h2>
  <p>
    La densidad no cambia tipo, radio, foco ni área táctil. Viene de
    <a href="/dimensiones">Dimensiones</a>, donde se define el eje global. Sigue en
    <a href="/elevacion">Elevación</a>, que muestra fallbacks visuales, y en
    <a href="/referencia">Referencia</a>, para buscar los tokens resueltos.
  </p>
</Base>

