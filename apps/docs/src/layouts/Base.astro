---
/*
 * Every import below is a BARE SPECIFIER, resolved through the package's exports map, the
 * exact path this site tells consumers to take (ADR-19). If the map breaks, the build breaks;
 * the docs can't drift from the contract without failing.
 */
import "@skryensya/core/tokens.scss"; // trae el state layer en base, no es un import aparte
import "@skryensya/core/modes/hc.scss";
import "@skryensya/core/dimensions/radius.scss";
/* `data-press-scale="off"` opts a subtree out of the `:active` squeeze (Button, Checkbox, Switch,
 * Radio, Segmented) without touching `prefers-reduced-motion`. */
import "@skryensya/core/dimensions/press-scale.scss";
import "@skryensya/core/components/badge.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/copy-button.css";
import "@skryensya/core/components/theme-toggle.css";
import "@skryensya/core/components/kbd.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/callout.css";
import "@skryensya/core/components/avatar.css";
import "@skryensya/core/components/loader.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/components/pagination.css";
import "@skryensya/core/components/input.css";
/* La paleta se compone sobre `.sk-dialog` (decisión 11), y su hoja lo dice en la primera línea: es
 * dueña de la fila de búsqueda, la lista y el pie, no del marco modal. Sin esta hoja el ⌘K salía con
 * el borde negro y las esquinas rectas del navegador. Va antes por eso: es la base, no un extra. */
import "@skryensya/core/components/dialog.css";
/*
 * El cajón móvil, y las dos hojas que lo hacen existir. Sin ellas el <dialog> del rail chico salía
 * exactamente como lo pinta el navegador: una caja de 300px centrada en la pantalla, con borde negro
 * de 3px y márgenes automáticos. No es un cajón mal estilado, es un dialog crudo.
 *
 * Es el mismo agujero que ya tuvieron `sidebar.css` (el rail transparente) y `dialog.css` (el ⌘K con
 * borde negro): las tres se sacaron de acá en el mismo commit de "component CSS scoping", y el cajón
 * fue el que nadie volvió a buscar. La regla que las tres confirman: una hoja opt-in se importa donde
 * vive el markup que la usa, y este markup vive en el layout, así que va acá.
 *
 * El patrón antes que el componente: `drawer.css` no trae estructura, sólo re-declara los hooks de
 * Vaul (decisión 8), así que sin `vaul.css` no hay panel que ajustar.
 */
import "@skryensya/core/patterns/vaul.css";
/*
 * The command palette opts into Dialog Vaul (`data-sk-dialog-vaul` on `CommandPalette.astro`'s own
 * `<dialog>`): centred on desktop, a block-end sheet with a drag handle below `desktop`, the same
 * pattern the mobile drawer's own edge behaviour comes from. Same hole as `vaul.css` above: the
 * attribute alone does nothing without this sheet, and `⌘K` would silently keep the centred desktop
 * box on a phone instead.
 */
import "@skryensya/core/patterns/dialog-vaul.css";
import "@skryensya/core/components/drawer.css";
import "@skryensya/core/components/command-palette.css";
import "@skryensya/core/components/tabs.css";
/* Anclaje: la colocación compartida por tooltip, popover, popup, menu, select, combobox y date picker
 * (decisión 25). Va antes que ellos porque son sus consumidores. */
import "@skryensya/core/patterns/anchored.css";
/* El menú de idioma del header (`LanguageMenu.astro`) es el único Menu del chrome, y esta hoja es
 * opt-in: sin ella el panel no se esconde en reposo (`display: none` vive acá, no en el navegador)
 * y aparecería desplegado bajo el header. Misma regla que dialog/drawer/sidebar arriba: una hoja
 * opt-in se importa donde vive el markup que la usa, y este markup vive en el layout. */
import "@skryensya/core/components/menu.css";
import "@skryensya/core/components/tooltip.css";
import "@skryensya/core/components/switch.css";
import "@skryensya/core/components/table.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/toc.css"; // el rail "En esta página": Toc.astro monta [data-sk-toc]
/* El shell del rail izquierdo. Faltaba, y el shell de docs había reescrito a mano sus reglas
 * (fondo, borde, separador, footer) leyendo hooks `--sk-sidebar-*` que sin esta hoja no los declara
 * nadie: todos resolvían a nada, así que el rail salía transparente y sin padding. */
import "@skryensya/core/components/sidebar.css";
/* El enlace de salto, primero en el documento y escondido hasta que recibe el foco. Va acá y no en
 * una página: es chrome del layout, como el rail y el cajón. */
import "@skryensya/core/components/skip-link.css";
/* Su contraparte al final de la lectura, misma razón: chrome del layout, no de una página. Aparece
 * recién después de bajar cierto scroll y vuelve al mismo destino enfocable que el skip link de
 * arriba (`#docs-content`), así el foco que devuelve es el mismo que el salto ofrece. */
import "@skryensya/core/components/back-to-top.css";
/* icon.css NO se importa aquí: viaja en tokens.scss, como el state layer. Un icono no es un extra al
 * que un componente opta (decisión 15). */
import "@skryensya/core/patterns/nav-list.css"; // opt-in: una app puede no tener navegación (decisión 17)
import "@skryensya/core/patterns/scrollbar.css";
import "@skryensya/core/patterns/scroll-lock.css";
import "@skryensya/core/patterns/media-gradient.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/patterns/footer.css"; // el `sk-footer` de <SiteFooter>, en cada página con rail
import "@skryensya/core/patterns/table-pager.css";
import "@skryensya/core/patterns/icon-toggle.css";
/* The mobile preference sheet (`#docs-prefs-sheet`, below) renders every setting as a Tile Button —
 * markup that lives in the layout, not in a page. Same opt-in rule as Menu above: without this
 * sheet, on any page that doesn't happen to import `tile.css` for its OWN reasons (a component page
 * demoing Tile itself), the sheet's `sk-tile*` classes hit no rules at all and fall back to bare
 * span/button UA defaults — confirmed live on `/efectos`, which has no reason to pull Tile in. */
import "@skryensya/core/components/tile.css";
/* Effects (ADR-20), opt-in decorative motion: the component page masthead below is the collapse
 * effect's own consumer (`ComponentPageShell.astro`'s `sk-fx-collapse-header` classes). */
import "@skryensya/core/effects/collapse-header.css";

/* kbd is in the global chrome (the ⌘K search badge, the palette footer), so its consumer skin loads
 * here rather than per-page, the same reason the button skin above does. */
/* table skin: TokenTable, demos and playground all share one consumer CSS. */
/* pagination appears in /personalizar and the component page, one consumer skin. */
/* switch: CodeBlock Condensed/Full density control, plus /personalizar and the component page. */
import "../styles/site.css";
import "../styles/shell.scss";

/*
 * The "Focus order" badge rule, rendered into the head below; see the comment at its `<style>` for
 * why this is imported rather than re-typed.
 *
 * A RELATIVE PATH into the package, not `@skryensya/devtools/focus-order`. Reaching the module
 * directly skips the exports map, which is the same move `devtools`' own `panel.ts` already makes to
 * read `core`'s CSS files, and it keeps this import off the package's public surface: nothing here
 * is asking devtools to publish a second entry point, only to read one file. `focus-order.ts` imports
 * nothing itself, so this pulls in a string and no graph.
 */
import { FOCUS_ORDER_CSS } from "../../../../packages/devtools/src/focus-order";
import LanguageMenu from "../components/LanguageMenu.astro";
import PrefTooltip from "../components/PrefTooltip.astro";
import CommandPalette from "../components/CommandPalette.astro";
import ContrastToggle from "../components/ContrastToggle.astro";
import SidebarNav from "../components/SidebarNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DrawerNav from "../components/DrawerNav.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Toc from "../components/Toc.astro";
import { indexDocument, indexHeroTabPanel } from "../lib/document-index";
import { vanillaMountSections } from "../lib/vanilla-mount-sections";
import VanillaMount from "../components/VanillaMount.astro";
import { vanillaMounts } from "../lib/vanilla-mounts";
import { iconMarkup, siteIconSet } from "../icons";
import { getGlobalNavigation, getNavigation, type NavigationItem, type NavigationSection } from "../lib/navigation";
import type { DrawerSection } from "../components/DrawerNav.astro";
import { templateSections } from "../lib/templates-nav";
import { palettePresets } from "../lib/palette-presets";
import { reportIssueUrl } from "../lib/report-issue";
import {
  availableLocales,
  canonicalPath,
  defaultLocale,
  getLocale,
  locales,
  localizePath,
  useTranslations,
} from "../i18n";
import { skipLinkParts } from "@skryensya/core/skip-link";
import { backToTopParts } from "@skryensya/core/back-to-top";
import { STORAGE_KEY } from "@skryensya/core/storage";
import {
  colorModePreference,
  componentPreviewBindingPreference,
  componentPreviewScreenPreference,
  contrastPreference,
  languagePreference,
  palettePreference,
} from "../lib/preferences";

/*
 * What the pre-paint script is allowed to know: the storage key and the slot names, taken from the
 * declarations rather than re-typed as literals. That inline script cannot import (it runs before
 * modules), so this is how it stays tied to the single source instead of being a second one.
 */
const PREPAINT = {
  key: STORAGE_KEY,
  scheme: colorModePreference.slot,
  contrast: contrastPreference.slot,
  binding: componentPreviewBindingPreference.slot,
  screen: componentPreviewScreenPreference.slot,
  palette: palettePreference.slot,
};

/*
 * DEV ONLY. `@skryensya/devtools`'s "Components mounted" readout reads this global; see the
 * `initComponents()` call in `docs-page-lifecycle.ts` for where it is written, and that script's
 * comment for why a global rather than a DOM attribute.
 */
declare global {
  interface Window {
    __skDevtoolsComponentCount?: number;
  }
}

interface Props {
  title: string;
  description?: string;
  /** Full-width tool layout: drop the docs rail, toc, page-nav and footer, render the slot alone. */
  fullBleed?: boolean;
  /** Content geometry inside the docs shell. Grid keeps the shell rails but exposes named content spans. */
  documentLayout?: "column" | "grid";
  /**
   * The page authors its own `<VanillaMount>` inside `<slot />` (inside a tab panel, say) instead
   * of getting one appended after it for free. Nothing in the shell may sit outside whatever
   * structure the page chose; a page with tabs cannot have content the tabs don't own.
   */
  hideVanillaMount?: boolean;
  /**
   * `fullBleed` pages have no rail, so by default the drawer trigger stays visible at every width
   * (there is no other way to reach the index once the rail is gone, e.g. /personalizar). A
   * `fullBleed` page that DOES want the ordinary responsive trigger instead — hidden on desktop,
   * shown on mobile, same as every railed page — opts out explicitly (the marketing home, which has
   * nothing to reach the drawer for on desktop but still wants it on mobile like any other page).
   */
  alwaysShowNavTrigger?: boolean;
}

const {
  title,
  description,
  fullBleed = false,
  documentLayout = "column",
  hideVanillaMount = false,
  alwaysShowNavTrigger = fullBleed,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

/*
 * `path` is what the reader's URL says; `canonical` is the same page named in Spanish, the site's
 * locale-independent identity for a document. Anything keyed by page (the mount catalogue, the
 * alternate-language links) looks up `canonical`; anything compared against a rendered href
 * compares `path`, because the rail is already rendered in this locale.
 */
const locale = getLocale(Astro.url);
const canonical = canonicalPath(path);
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);
const vanillaMount = vanillaMounts[canonical as keyof typeof vanillaMounts];
/* Every translation of this page that actually EXISTS: advertising one that 404s is worse than
 * advertising none, so the list comes from the page directory rather than from the locale list. */
const alternates = availableLocales(canonical).map((code) => ({
  code,
  href: localizePath(canonical, code),
}));

/*
 * WHAT THE LANGUAGE PRE-PAINT SCRIPT IS ALLOWED TO KNOW, same shape and same reason as `PREPAINT`
 * below: an inline script that runs before any module, so every value it needs is handed in here
 * from a real declaration rather than re-typed.
 *
 *   - `hrefs` is only the translations that ACTUALLY EXIST for this page (from `alternates`), so the
 *     script can never redirect a reader onto a 404.
 *   - `current` / `def` let it tell "an explicit `/en/` URL" (respect it) from "an unprefixed page"
 *     (the only place browser-language auto-detection runs).
 *   - `slot` is `languagePreference`'s, so a stored explicit choice overrides the browser guess.
 */
const LANG_REDIRECT = {
  key: STORAGE_KEY,
  slot: languagePreference.slot,
  current: locale,
  def: defaultLocale,
  locales,
  hrefs: Object.fromEntries(alternates.map((alternate) => [alternate.code, alternate.href])),
};



/*
 * The navigation lives in lib/navigation.ts, shared with the catalog so the same task grouping
 * cannot drift between exploration and navigation.
 */
const navigation = getNavigation(locale) satisfies readonly NavigationSection[];
const globalNavigation = getGlobalNavigation(locale);
/* By stable id, never by visible title: the titles are translated now and would stop matching. */
const componentSection = navigation.find((section) => section.id === "components");
const foundationsSection = navigation.find((section) => section.id === "foundations");

/*
 * The mobile drawer's full-index nav (DrawerNav.astro): `navigation` for the three documentation
 * sections, plus a synthetic section each for Templates and Presets so they are ORDINARY rows in the
 * one tree, not a rail poured in above it. Matched on the CANONICAL (Spanish) path so `/` vs `/en`
 * and `/templates` vs its localised twin resolve the same in every locale.
 *
 *   - Templates: a phone hides its in-page section rail (`fullBleed`, `display: none` below
 *     desktop), so its jump links come in here as a collapsible section, each an `#id` on the
 *     templates page. `data-sk-vaul-close` (DrawerNav, for any `#` href) shuts the drawer so the
 *     scroll lands on a visible stage.
 *   - Presets: its own Toc renders in normal flow on a phone, so this is just the top-level link.
 *   - Both are dev-only; a production build renders the label as a disabled `<button>` (no `href`),
 *     matching the header's own treatment.
 */
const isDev = import.meta.env.DEV;
const globalHref = (canon: string): string | undefined =>
  globalNavigation.find((entry) => canonicalPath(entry.href) === canon)?.href;
const globalLabel = (canon: string): string | undefined =>
  globalNavigation.find((entry) => canonicalPath(entry.href) === canon)?.label;

const drawerHome =
  globalNavigation.find((item) => canonicalPath(item.href) === "/") ??
  ({ href: href("/"), label: t("nav.home") } satisfies { href: string; label: string });

/** A synthetic drawer section for a dev-only gallery page (Templates / Presets). */
const gallerySection = (canon: "/templates" | "/presets", items: readonly NavigationItem[]): DrawerSection[] => {
  const label = globalLabel(canon);
  if (!label) return [];
  return [
    {
      id: canon.slice(1),
      section: label,
      href: isDev ? globalHref(canon) : undefined,
      disabled: !isDev,
      blurb: "",
      groups: [{ group: "", items: isDev ? items : [] }],
    },
  ];
};

const templatesHref = globalHref("/templates") ?? "/templates";
const drawerSections: readonly DrawerSection[] = [
  ...navigation,
  ...gallerySection(
    "/templates",
    templateSections(t).map((section) => ({
      href: `${templatesHref}#${section.id}`,
      label: section.navLabel,
    })),
  ),
  ...gallerySection("/presets", []),
];

/*
 * One rail follows the reader through the whole library. Catalog and reference subpages inherit
 * the section that explains their context.
 */
/* Matched on `canonical`, so one rule covers `/componentes/...` and `/en/components/...` alike. */
const currentSection =
  canonical === "/componentes" || canonical.startsWith("/componentes/")
    ? componentSection ?? navigation[0]
    : canonical === "/fundamentos" || canonical.startsWith("/referencia/")
      ? foundationsSection ?? navigation[0]
      : navigation.find((section) => section.groups.some((group) => group.items.some((item) => item.href === path))) ?? navigation[0];
const sectionNavigation = [currentSection] satisfies readonly NavigationSection[];
const isGlobalItemCurrent = (href: string): boolean => {
  const itemCanonical = canonicalPath(href);
  if (itemCanonical === "/componentes") return canonical === "/componentes" || canonical.startsWith("/componentes/");
  if (itemCanonical === "/fundamentos") return currentSection.id === "foundations";
  return canonical === itemCanonical;
};

/*
 * THE DOCUMENT, RENDERED HERE, so its own index can be read before the page is sent.
 *
 * `Astro.slots.render("default")` is the page's body as HTML, which is what lets `indexDocument`
 * answer at build the question the browser used to answer on every load: which headings are this
 * page's sections. The string is then written back out with `set:html`, so `<main>` holds exactly
 * what `<slot />` would have put there, plus an `id` on any section heading that lacked one.
 *
 * The full-bleed layout has no toc and no page furniture, so it keeps the plain `<slot />`: nothing
 * would read the index, and rendering the slot twice is the one way to get this wrong.
 */
const scanned = fullBleed ? null : indexDocument(await Astro.slots.render("default"));
/*
 * Component pages put their outline inside the hero-tab panels, so a top-level heading scan sees
 * nothing. The default tab is `usage` and is known at build: index THAT panel the same way the
 * old browser fill did (`:scope > h3, h4`), and the rail arrives in the HTML already filled.
 * `?tab=` to another panel is the one case that still rebuilds in the browser, after this HTML.
 */
const heroTabs = scanned?.html.includes("docs-component-hero-tabs") ?? false;
const heroIndex = heroTabs && scanned ? indexHeroTabPanel(scanned.html, "usage") : null;
const documentIndex = heroIndex && scanned
  ? { ...scanned, html: heroIndex.html, headings: heroIndex.headings }
  : scanned;

/*
 * The section a reader lands on IS the first one, so the rail says so in the HTML rather than
 * lighting up a frame later when the spy's first IntersectionObserver callback arrives. A URL with a
 * hash is the exception, and the only part of this the page cannot know while it is being built:
 * a fragment never reaches the server. `toc-hash-seed.ts` is the three lines that clear the seed.
 */
const tocItems = [
  ...(documentIndex?.headings ?? []),
  /* The installation block this layout appends after the document, which is therefore not in the
   * document's own HTML; it declares its own sections (`../lib/vanilla-mount-sections.ts`). */
  ...(documentIndex && !hideVanillaMount && vanillaMount
    ? vanillaMountSections(t, vanillaMount.name)
    : []),
].map((heading, index) => ({
  href: `#${heading.id}`,
  label: heading.label,
  level: heading.level,
  current: index === 0,
}));

/* Prev/next stays within the current task area rather than crossing from a component into an ADR. */
const navItems = currentSection.groups.flatMap((group) => group.items);
const currentNavIndex = navItems.findIndex((item) => item.href === path);
const previousNavItem = currentNavIndex > 0 ? navItems[currentNavIndex - 1] : undefined;
const nextNavItem = currentNavIndex >= 0 ? navItems[currentNavIndex + 1] : undefined;

/*
 * `<main>` is `display: contents` for a grid-layout page (site.css): its direct children become
 * grid items of `.docs-document-pair` itself, sharing rows with the Toc rail beside them. This is
 * every one of those children, in the same order Base.astro renders them below: the document's own
 * top-level elements, the optional vanilla-mount block, the optional prev/next nav, and the footer
 * (always). The rail spans exactly this many rows (`--docs-main-row-count`, site.css) so it sits
 * beside all of main's content without over- or under-shooting it.
 */
const mainRowCount =
  (documentIndex?.topLevelCount ?? 0) +
  (documentIndex && !hideVanillaMount && vanillaMount ? 1 : 0) +
  (currentNavIndex >= 0 ? 1 : 0) +
  1;


const searchIndexSrc = locale === "en" ? "/en/search-index.json" : "/search-index.json";

const searchIcon = iconMarkup("search");
const closeIcon = iconMarkup("close");
const menuIcon = iconMarkup("menu");
const settingsIcon = iconMarkup("settings");
const previousIcon = iconMarkup("arrow-left");
const nextIcon = iconMarkup("arrow-right");
const reportIssueIcon = iconMarkup("external-link", { size: "sm" });
const backToTopIcon = iconMarkup("chevron-up", { size: "sm" });

/*
 * The footer's "Report an issue" link, pre-filled with the page the reader is actually standing on:
 * `Astro.url.href` rather than `canonical`, so a `?tab=install` deep link or an `/en/` translation
 * shows up in the issue exactly as the reader saw it, not normalised away.
 */
const issueUrl = reportIssueUrl(title, t("footer.reportIssue.body", { url: Astro.url.href }));

/*
 * Curated accent presets. The data itself lives in lib/palette-presets so the /presets showcase
 * gallery can render the identical set read-only, instead of hand-keeping two copies in sync.
 */
const PALETTE_PRESETS = palettePresets(locale);
---

<!doctype html>
<html lang={locale} class="sk-scrollbar" data-scheme="system" data-icon-set={siteIconSet} data-radius="md" style="--sk-density: 1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      LANGUAGE, RESOLVED BEFORE ANYTHING PAINTS.

      The site is static and language IS the URL (`i18n/index.ts`). This is the one bit of runtime
      negotiation layered on top, and it is deliberately narrow:

        - A stored explicit choice (`languagePreference`, set from `LanguageMenu`) ALWAYS wins, both
          directions. A reader who picked Español once is sent back to Español even from an `/en/`
          link, because "remember my choice" is what they asked for.
        - With NO stored choice, the browser's own language list decides, but ONLY on an unprefixed
          (default-locale) page. An explicit `/en/` URL (a shared link, a bookmark) is left exactly
          where it points; auto-detection never touches it.
        - A redirect only ever fires toward a translation that EXISTS (`LANG_REDIRECT.hrefs` is built
          from `alternates`), so an untranslated page never becomes a 404.

      `location.replace`, not `assign`: the pre-redirect URL was never a page the reader chose to be
      on, so it does not belong in history. Same `is:inline` + `define:vars` shape as the pre-paint
      block below, and it runs first so a wrong-language document is abandoned before its subresources
      are fetched.
    */}
    <script is:inline define:vars={{ LANG_REDIRECT }}>
      (function () {
        var R = LANG_REDIRECT;
        var stored;
        try {
          var s = JSON.parse(localStorage.getItem(R.key) || "{}");
          if (s && typeof s === "object") stored = s[R.slot];
        } catch (e) {}

        var known = R.locales.indexOf(stored) !== -1;
        var target;
        if (known) {
          /* Explicit choice: honoured everywhere, even over an `/en/` URL. */
          target = stored;
        } else if (R.current === R.def) {
          /* No choice yet, and this is an unprefixed page: let the browser decide. */
          var navs =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || ""];
          for (var i = 0; i < navs.length && !target; i++) {
            var primary = String(navs[i]).toLowerCase().split("-")[0];
            if (R.locales.indexOf(primary) !== -1) target = primary;
          }
          if (!target) target = R.def;
        } else {
          /* No choice, explicit `/en/` URL: respect it. */
          return;
        }

        if (target === R.current) return;
        var dest = R.hrefs[target];
        if (dest) location.replace(dest);
      })();
    </script>

    <title>{title} · skryensya/ui</title>
    {description && <meta name="description" content={description} />}
    {/* Each translation of this page announces the others, so a crawler treats them as one document
        in two languages rather than as duplicates competing with each other. */}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
    ))}

    {/*
      Docs has a fixed visual contract: Phosphor icons, medium density and medium rounding. The reader
      preferences are scheme, contrast, the color palette and the two ComponentPreview ones, so apply
      those saved values before first paint, the palette especially, or the page would flash the default
      blue and then re-tint.

      THE ONE PLACE THAT TOUCHES localStorage DIRECTLY, and it has to: this runs before any module
      loads, so it cannot import the storage primitive: importing is the entire thing it exists to
      happen before. What it does NOT do is re-type the key and the slot names: `PREPAINT` carries
      them in from the real declarations, so renaming a slot cannot leave this script reading a slot
      nobody writes any more. The value guards stay duplicated here, because a parser is a function
      and functions do not survive serialisation; that is the known and only cost of the exception.
    */}
    <script type="application/json" id="docs-palette-presets" set:html={JSON.stringify(PALETTE_PRESETS)}></script>
    <script is:inline define:vars={{ PREPAINT, siteIconSet }}>
      (function () {
        var d = document.documentElement;
        /* "Scripting is on", declared before first paint. Its only consumer is the pre-hydration
         * tab rule in site.css: that rule hides panels the reader has not chosen yet, which is only
         * safe if something is coming to give them back. Without JS the flag never lands, the rule
         * never matches, and every panel stays readable, which is the correct no-JS docs page. */
        d.setAttribute("data-js", "");
        /*
         * A `?tab=` deep link, resolved BEFORE FIRST PAINT.
         *
         * site.css closes every hero panel but the first with no script involved, which is the right
         * answer for a plain visit and the wrong one for a link naming any other tab. The element
         * itself is unreachable from here (this runs in <head>, the body is not parsed yet), so what
         * lands is a RULE rather than an attribute: the one thing that can name a value CSS cannot
         * compare on its own. `scripts/hero-tabs-url.ts` still fixes up the DOM afterwards; this is
         * only what stops the first panel being painted for a frame first.
         *
         * The value is pattern-checked before it reaches a stylesheet: it comes from the URL, and
         * anything else could close the rule and append declarations of its own.
         */
        var tab = new URLSearchParams(location.search).get("tab");
        if (tab && /^[a-zA-Z0-9_-]{1,32}$/.test(tab)) {
          d.setAttribute("data-sk-hero-tab", tab);
          var tabStyle = document.createElement("style");
          tabStyle.textContent =
            '[data-js] .sk-tabs:has(> .docs-component-hero-tabs):not([data-scope])' +
            ' > [data-sk-tabs-content]:not([data-value="' + tab + '"]){display:none}';
          d.querySelector("head").appendChild(tabStyle);
        }
        var s = {};
        try {
          s = JSON.parse(localStorage.getItem(PREPAINT.key) || "{}");
        } catch (e) {}
        var stored = function (slot) {
          return s && typeof s === "object" ? s[slot] : undefined;
        };
        var schemeValue = stored(PREPAINT.scheme);
        var scheme = schemeValue === "light" || schemeValue === "dark" ? schemeValue : "system";
        d.setAttribute("data-scheme", scheme);
        d.style.colorScheme = scheme === "system" ? "light dark" : scheme;
        if (stored(PREPAINT.contrast) === "high") d.setAttribute("data-contrast", "high");
        else d.removeAttribute("data-contrast");
        d.style.setProperty("--sk-density", "1");
        d.setAttribute("data-radius", "md");
        d.setAttribute("data-icon-set", siteIconSet);
        /* Shared Vanilla | React preference for every ComponentPreview on the site. */
        d.setAttribute(
          "data-sk-component-preview-pref",
          stored(PREPAINT.binding) === "react" ? "react" : "vanilla",
        );
        /* Shared screen preset, same shape. `free` is the ABSENCE of the attribute, so an unknown
         * or missing value removes it rather than writing a third state nothing styles. */
        var screen = stored(PREPAINT.screen);
        if (screen === "xl" || screen === "tablet" || screen === "mobile") {
          d.setAttribute("data-sk-component-preview-screen-pref", screen);
        } else {
          d.removeAttribute("data-sk-component-preview-screen-pref");
        }
        /* Each non-default preset carries complete semantic accent declarations. Unknown or absent ids
         * fall back to the default stylesheet, so clearing storage is a no-op. */
        var palettes = [];
        try {
          palettes = JSON.parse(document.getElementById("docs-palette-presets").textContent || "[]");
        } catch (e) {}
        var preset = null;
        var paletteId = stored(PREPAINT.palette);
        for (var i = 0; i < palettes.length; i++) {
          if (palettes[i].id === paletteId) { preset = palettes[i]; break; }
        }
        if (preset && palettes[0] && preset.id !== palettes[0].id) {
          var properties = Object.keys(preset.tokens);
          for (var j = 0; j < properties.length; j++) {
            d.style.setProperty(properties[j], preset.tokens[properties[j]]);
          }
        }
      })();
    </script>

    {/*
      * DEV ONLY, and it has to sit here in `<head>`, not with `@skryensya/devtools`'s own late,
      * dynamically-imported mount script: a `srcdoc` `<iframe>` starts loading, and running ITS
      * OWN `component-preview-frame.ts`, which clones this document's `<head>` stylesheets exactly
      * ONCE, at ITS OWN boot. The moment the element is parsed, which for one already in the
      * initial HTML can happen before ANY deferred module script this page ships gets a turn to run
      * at all. `<head>`, parsed and executed before `<body>`'s iframes even exist yet, is the only
      * place early enough to reliably win that race. The RULE stays inert until the "Hit areas"
      * checkbox sets the attribute it is scoped behind, so being here unconditionally costs
      * nothing. This is the CSS text alone, not the toggle: `overlay.ts`'s own
      * `ensureHitAreaStyleTag()` is a no-op once it finds this same `id` already here, so the panel
      * mounting later does not duplicate it, it just confirms it.
      *
      * `data-sk-menu-debug-intent` (the safety-triangle flag, just below `<body>`) does NOT need
      * this same early-head treatment: that one is mirrored into each iframe by ATTRIBUTE alone -
      * `syncRootState()` re-runs on every later attribute change too, not just once at boot. And
      * it is the attribute a menu's own one-time mount reads, never a stylesheet rule. This flag
      * has the opposite shape: the ATTRIBUTE already mirrors live and forgives being set late; it
      * is the STYLESHEET clone that only ever gets one chance.
      */}
    {import.meta.env.DEV && (
      <script is:inline>
        (function () {
          if (document.getElementById("sk-devtools-hit-area-style")) return;
          var style = document.createElement("style");
          style.id = "sk-devtools-hit-area-style";
          var tint = "rgba(236, 72, 153, 0.28)";
          style.textContent =
            'html[data-sk-devtools-hit-areas] .sk-interactive { background-image: linear-gradient(' + tint + ', ' + tint + '); }' +
            'html[data-sk-devtools-hit-areas] .sk-interactive::after { background: ' + tint + '; }';
          document.head.appendChild(style);
        })();
      </script>
    )}

    {/*
      * DEV ONLY, safety-triangle side effect: `getIntentReadout()` (core/src/menu-intent-readout.ts)
      * `prepend()`s a real "Pointer routing: …" element onto whatever root it is handed, UNCONDITIONALLY
      *. There is no option to get the triangle's paint without it. The dedicated example hands it ONE
      * menu's own root, so the readout lands right beside that one trigger, which is the whole point of
      * it. Flagging `<html>` instead, so every menu on the page paints, not just one demo. Hands it
      * `<html>` itself, and the readout ends up prepended there: a real block of text rendered above
      * `<body>`, permanently, the moment any menu mounts. Hiding it is scoped to exactly that shape -
      * a readout that is a DIRECT CHILD of a flagged `<html>`, so a page's own dedicated example
      * (flagged on a real `.sk-menu`, several levels down) keeps its readout exactly as intended.
      */}
    {import.meta.env.DEV && (
      <script is:inline>
        (function () {
          if (document.getElementById("sk-devtools-safety-triangle-style")) return;
          var style = document.createElement("style");
          style.id = "sk-devtools-safety-triangle-style";
          style.textContent = "html[data-sk-menu-debug-intent] > .sk-menu__intent-readout { display: none; }";
          document.head.appendChild(style);
        })();
      </script>
    )}

    {/*
      * DEV ONLY, same early-`<head>` reasoning as the hit-area block above: `@skryensya/devtools`'s
      * "Slow motion" toggle retunes the `--scale-duration-*` primitives (`motion.ts`'s own header
      * comment explains why those, not a per-element override), and every preview `srcdoc` iframe
      * needs this RULE cloned into it exactly once, at its own boot, same as the hit-area tint.
      * `ensureSlowMoStyleTag()` no-ops once it finds this `id` already here.
      */}
    {import.meta.env.DEV && (
      <script is:inline>
        (function () {
          if (document.getElementById("sk-devtools-slow-mo-style")) return;
          var style = document.createElement("style");
          style.id = "sk-devtools-slow-mo-style";
          var factor = 6;
          style.textContent =
            "html[data-sk-devtools-slow-mo] {" +
            "--scale-duration-fast: calc(120ms * " + factor + ");" +
            "--scale-duration-moderate: calc(200ms * " + factor + ");" +
            "--scale-duration-slow: calc(320ms * " + factor + ");" +
            "--scale-duration-deliberate: calc(1600ms * " + factor + ");" +
            "--scale-duration-cycle-fast: calc(640ms * " + factor + ");" +
            "--scale-duration-cycle: calc(960ms * " + factor + ");" +
            "--scale-duration-cycle-slow: calc(1440ms * " + factor + ");" +
            "}";
          document.head.appendChild(style);
        })();
      </script>
    )}

    {/*
      * DEV ONLY, early-`<head>` clone target for `@skryensya/devtools`'s "Focus order" toggle: a
      * number badge per focusable element, in document order, via CSS counters scoped behind the
      * attribute. It has to be in the head THIS early because a component-preview `srcdoc` iframe
      * clones the parent's stylesheets exactly once at its own boot, and some boot lazily, long after
      * the panel itself has mounted.
      *
      * The rule is IMPORTED, not re-typed. This used to be a hand-written copy of `focus-order.ts`'s
      * own string with a comment admitting it ("kept in sync by hand with FOCUSABLE_SELECTORS") -
      * two copies of one selector list is a fork that drifts the first time either side moves, and
      * this one already had: the badge moved off `::before` (it was destroying the state layer, see
      * that file's header) and this copy would have kept painting the old, broken rule into every
      * preview frame. `focus-order.ts` imports nothing itself, so pulling it in costs a string and
      * tree-shakes away in the production build, where this whole branch is dead code.
      *
      * A real `<style>` rather than a script that builds one: it needs no execution to take effect,
      * so it is live at first paint, and `ensureFocusOrderStyleTag()` finds it by this same id and
      * no-ops when the panel eventually mounts.
      */}
    {import.meta.env.DEV && (
      <style id="sk-devtools-focus-order-style" set:html={FOCUS_ORDER_CSS} />
    )}
  </head>

  <body>
    {/*
      THE FIRST THINGS IN THE DOCUMENT, and the only elements here whose job is to be invisible.

      Every page of this site opens with the same chrome: the drawer trigger, the brand, four global
      links, the ⌘K trigger, the scheme and contrast controls. Reading with a keyboard, that is nine
      stops before anything this page is actually about, on every page, forever. WCAG 2.4.1 calls
      that a block to bypass; these links are the bypass, and they are the platform's own (an in-page
      href), so they work before any script on this page has run.

      TWO OF THEM, AND THE ORDER IS THE DECISION. Content comes first because it is what almost
      everyone arriving here wants: they followed a link to READ something, and the index is how you
      get somewhere else. A reader who does want the index is one more Tab away; a reader who wants
      the page would otherwise be several. Offering only the index would answer the rarer question
      first and make the common one cost more than it did before.

      The NAVIGATION one is conditional twice over, because a skip link pointing at something that is
      not on the page is worse than none: it is a promise the reader hears and cannot follow.
      `fullBleed` pages (/personalizar) have no index column at all, and below `desktop` the rail is
      `display: none` (shell.scss drops the link there to match). In both cases nothing is lost: the
      drawer trigger is the first control in the header at those widths, so the index is already one
      Tab away.
    */}
    <a class={`${skipLinkParts.root} sk-interactive docs-skip-link`} href="#docs-content">
      {t("nav.skipToContent")}
    </a>
    {!fullBleed && (
      <a
        class={`${skipLinkParts.root} sk-interactive docs-skip-link docs-skip-link--nav`}
        href="#docs-nav"
      >
        {t("nav.skipToNav")}
      </a>
    )}
    <div class="docs-canvas">
    <header class="dimensions">
      <div class="dimensions__content sk-wrapper" data-size="lg">
        <button
          class={`sk-button sk-interactive dimensions__menu-trigger${alwaysShowNavTrigger ? " dimensions__menu-trigger--always" : ""}`}
          data-variant="ghost"
          data-icon-only
          type="button"
          aria-controls="docs-drawer"
          aria-expanded="false"
          aria-label={t("nav.openMenu")}
          data-sk-vaul-open="docs-drawer"
        >
          <Fragment set:html={menuIcon} />
        </button>
        {/* The bar's own identity on mobile: once the global nav (which lists "Home" as a peer
            destination, not a logo) moves into the drawer, nothing in the header names the site any
            more. Hidden on desktop, where the nav already says it; see the mobile media query. */}
        <a class="dimensions__brand sk-interactive" href={href("/")}>
          skryensya/ui
        </a>
        <nav class="dimensions__global sk-nav-list" data-orientation="horizontal" aria-label={t("nav.global")}>
          <div class="sk-nav-list__group">
            <ul class="sk-nav-list__list" role="list">
              {
                globalNavigation.map((item) => {
                  const isDevOnly = item.href === "/templates" || item.href === "/presets";
                  const isDev = import.meta.env.DEV;
                  const isDisabled = isDevOnly && !isDev;

                  return (
                    <li class="sk-nav-list__item">
                      {isDisabled ? (
                        <button
                          class="sk-nav-list__link sk-interactive"
                          type="button"
                          disabled
                          title={t("nav.comingSoon")}
                          aria-label={t("nav.comingSoon")}
                        >
                          <span class="sk-nav-list__label">{item.label}</span>
                        </button>
                      ) : (
                        <a
                          class="sk-nav-list__link sk-interactive"
                          href={item.href}
                          aria-current={isGlobalItemCurrent(item.href) ? "page" : undefined}
                        >
                          <span class="sk-nav-list__label">{item.label}</span>
                        </a>
                      )}
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </nav>



        {/*
          The command-palette trigger is the shortest path to any documentation destination. The
          trailing controls keep only reader preferences: scheme and contrast.

          A real `<input>`, not a `<button>` (decision: search-trigger.ts's own header comment has
          the full reasoning): a button's `:active` squeeze and its `--elevation-raised` at-rest
          shadow are BOTH real button semantics this control never wanted, they came along for
          free only because `.sk-button` was the fastest way to get the field's own look. `readonly`
          keeps it from accepting typed input (the real query box is the palette's own, opened on
          top of this one) while staying a genuine focusable, clickable text field: Tab reaches it,
          a screen reader announces it as a text box, and `search-trigger.ts` opens the palette on
          focus (keyboard) as well as on click (pointer), so neither path is second-class.
        */}
        <div class="dimensions__search-trigger" data-sk-search-trigger>
          <Fragment set:html={searchIcon} />
          <input
            class="dimensions__search-input"
            type="text"
            readonly
            inputmode="none"
            autocomplete="off"
            placeholder={t("search.label")}
            aria-label={t("search.label")}
            aria-controls="docs-cmdk"
            aria-expanded="false"
            aria-keyshortcuts="Meta+K Control+K"
            data-sk-command-palette-open
            data-sk-search-trigger-input
          />
          <kbd class="sk-kbd" data-sk-command-palette-hint aria-hidden="true">⌘K</kbd>
        </div>

        {/*
          Mobile's own trigger, a real `<button>` rather than the desktop field collapsed to an icon.
          The field-with-placeholder shape above only earns its `<input>` cost (the readonly dance,
          `search-trigger.ts`'s Enter/Space remap, the wrapper/input click hand-off) because it grows
          to SHOW a placeholder and a ⌘K hint at desktop widths; mobile hides both and shrinks it to a
          bare icon anyway, so it was paying an input's real-world mobile quirks (the OS's own
          heuristics around a focusable text field, even readonly, occasionally flashing the virtual
          keyboard or an autofill affordance before `inputmode="none"` is honoured) for a shape a
          plain button already gives for free. `data-sk-command-palette-open` + `aria-controls` is
          the whole contract `command-palette.ts` looks for; it never assumed an input specifically.
        */}
        <button
          class="sk-button sk-interactive dimensions__search-trigger-mobile"
          data-variant="ghost"
          data-icon-only
          type="button"
          aria-label={t("search.label")}
          aria-controls="docs-cmdk"
          data-sk-command-palette-open
        >
          <Fragment set:html={searchIcon} />
        </button>

        {/*
          Mobile-only: the reader preferences. On desktop the `.dimensions__prefs` cluster below is
          visible in the header and this button is `display: none`; below `desktop` the cluster hides
          and this opens the same four controls as a block-end sheet (`#docs-prefs-sheet`). They used
          to ride at the foot of the nav drawer, where a reader hunting for "dark mode" had to open
          the index and scroll past the whole site tree to reach an unlabelled icon row.
          `data-sk-dialog-vaul-open` is the trigger attribute `connectVaul` reads for a Dialog Vaul
          root (`vaul.ts`), the same shape as the drawer's own `data-sk-vaul-open`.
        */}
        <button
          class="sk-button sk-interactive dimensions__prefs-trigger"
          data-variant="ghost"
          data-icon-only
          type="button"
          aria-label={t("prefs.title")}
          aria-controls="docs-prefs-sheet"
          data-sk-dialog-vaul-open="docs-prefs-sheet"
        >
          <Fragment set:html={settingsIcon} />
        </button>

        {/*
          The reader-preference icon controls (palette + reach + mode + contrast) are one cluster: a
          tighter gap than the header's own, so the icon-to-icon whitespace optically matches the search
          field's edge to the first icon, the icons carry ~one glyph of internal padding on each side,
          which the bordered field does not, so an equal flex gap would read as looser between the two
          icons.
        */}
        {/*
          Every control here is icon-only, so each is wrapped in `PrefTooltip`: a desktop hover/focus
          hint naming what it is, which is what replaced the `title` these carried. The mobile copies
          in `#docs-prefs-sheet` already sit next to a visible row label, so they get none.
        */}
        <div class="dimensions__prefs">
          {/*
            Color palette: ONE button that cycles the curated presets (PALETTE_PRESETS), the same shape
            as the mode and contrast toggles beside it rather than a rail of swatches. Its dot shows the
            current accent; a click advances to the next preset and applies its complete semantic accent
            bundle. The button ships neutral so there is no wrong-color flash before the script runs.
          */}
          <PrefTooltip label={t("prefs.palette")}>
            <button
              class="sk-button sk-interactive dimensions__palette-toggle"
              data-variant="ghost"
              data-icon-only
              type="button"
              aria-label={t("prefs.palette")}
              data-docs-palette-toggle
              data-label-template={t("prefs.paletteNamed")}
            >
              <span class="dimensions__palette-dot" aria-hidden="true"></span>
            </button>
          </PrefTooltip>

          {/* One-click mode cycle: system → claro → oscuro. */}
          <PrefTooltip label={t("prefs.theme")}>
            <ThemeToggle />
          </PrefTooltip>

          <PrefTooltip label={t("prefs.contrast")}>
            <ContrastToggle />
          </PrefTooltip>

          <PrefTooltip label={t("prefs.language")}>
            <LanguageMenu />
          </PrefTooltip>
        </div>

      </div>
    </header>

    {/*
      Command Palette is a DS component on Dialog (ADR-19). The site chrome owns THE instance that
      answers ⌘K (data-sk-command-palette-hotkey) and searches the whole documentation: openers via
      data-sk-command-palette-open + aria-controls, and the nav JSON index. initComponents() mounts
      the enhancer with the rest of the vanilla surface.
    */}
    <CommandPalette
      id="docs-cmdk"
      indexSrc={searchIndexSrc}
      label={t("search.dialog")}
      placeholder={t("search.placeholder")}
      hotkey="mod+k"
      lazy
    />
    {/*
      A page that owns a search box of its own puts its palette here rather than in `<slot />`: the
      catalogue's is scoped to the components. It belongs to the chrome, beside the site palette, and
      out of the document: `indexDocument()` counts the default slot's top-level elements to size
      the toc rail's row span, and a closed dialog is not a row.
    */}
    <slot name="palette" />

    {/*
      READER PREFERENCES. The SAME composition as the Command Palette's mobile form (ADR-19): a
      native `.sk-dialog` that opts into Dialog Vaul (`data-sk-dialog-vaul`), so it is a block-end
      sheet below `desktop` and would be a centred dialog above it — except the only trigger
      (`.dimensions__prefs-trigger`) is mobile-only, so in practice it is always the sheet. Sharing
      the composition is what gives it the palette's own corner radius (`--sk-dialog-radius`),
      elevation, backdrop and drag handle for free, instead of a second sheet skin to keep in step.

      `connectVaul` auto-mounts on `[data-sk-dialog-vaul]` (registry.ts), wiring the handle drag,
      Escape and backdrop dismiss; the header close is a `<form method="dialog">`, the platform's,
      exactly as the palette's own close button.

      On desktop the same four controls are the header's `.dimensions__prefs` cluster and this is
      never opened. Each control is that identical icon-only component; what the sheet adds is the
      row LABEL, the "what does this icon do" a bare globe / ring / monitor / dot could not answer.
    */}
    <dialog
      class="sk-dialog docs-prefs-sheet"
      id="docs-prefs-sheet"
      data-sk-dialog-vaul
      data-edge="block-end"
      aria-labelledby="docs-prefs-sheet-title"
    >
      <div data-part="handle" aria-hidden="true"></div>
      <header class="sk-dialog__header">
        <h2 class="sk-dialog__title docs-prefs-sheet__title" id="docs-prefs-sheet-title" data-flush>{t("prefs.title")}</h2>
        <form method="dialog">
          <button
            class="sk-button sk-interactive sk-dialog__close"
            data-variant="ghost"
            data-icon-only
            type="submit"
            value="cancel"
            aria-label={t("action.close")}
          >
            <Fragment set:html={closeIcon} />
          </button>
        </form>
      </header>
      {/*
        Every preference is a full-width Tile Button (`.docs-prefs-tile`): the whole card changes
        the setting on tap — the toggles cycle in place, language goes to the next translation —
        with the visible title on the leading edge and the control's own affordance on the trailing
        one. Theme first: "dark mode" is the reason most readers open this. Language last: it is the
        one that navigates rather than toggling in place.
      */}
      <div class="sk-dialog__body docs-prefs-sheet__body">
        <ThemeToggle tile label={t("prefs.theme")} description={t("prefs.themeHint")} />
        <ContrastToggle tile label={t("prefs.contrast")} description={t("prefs.contrastHint")} />
        <button
          class="sk-interactive sk-tile sk-tile--interactive docs-prefs-tile dimensions__palette-toggle"
          data-padding="md"
          data-scope="tile"
          data-part="root"
          type="button"
          aria-label={t("prefs.palette")}
          data-docs-palette-toggle
          data-label-template={t("prefs.paletteNamed")}
        >
          <span class="sk-tile__content" data-part="content">
            <span class="sk-tile__title">{t("prefs.palette")}</span>
            <span class="sk-tile__description">{t("prefs.paletteHint")}</span>
          </span>
          <span class="dimensions__palette-dot" aria-hidden="true"></span>
        </button>
        <LanguageMenu tile label={t("prefs.language")} description={t("prefs.languageHint")} />
      </div>
    </dialog>

    {/*
      The same nav as the rail, in a drawer, for viewports with no room for a rail. It is a native
      <dialog> opened with showModal(), so the focus trap, ESC, the inert page and focus restoration
      are the platform's (decision 11). The trigger is a disclosure button for a dialog-backed
      navigation drawer: no role="menu", no menuitem links, no arrow-key menu widget.
    */}
    {/*
      No `sk-vaul__handle`: on an `inline-start` nav drawer the grip is an `ew-resize` strip laid over
      the leading links (patterns/vaul.css), and the panel already closes three cleaner ways — the X in
      the header, Escape, and a tap on the backdrop. `connectVaul` treats a missing handle as "no
      drag" and still wires all three, so dropping the element just removes the affordance, not the
      dismiss. `data-draggable="false"` says the same thing explicitly for anyone reading the markup.
    */}
    <dialog class="sk-vaul sk-drawer docs-drawer" id="docs-drawer" data-sk-vaul data-edge="inline-start" data-draggable="false" aria-labelledby="docs-drawer-title">
        {/*
          Header: the panel's name and the close control, nothing else. Reader preferences (mode,
          contrast, palette, language) are NOT here and no longer at the panel's foot either: they
          are their own `#docs-prefs-sheet` bottom sheet, opened from a dedicated header button, so
          the index is pure navigation and "dark mode" is one tap from any page instead of a scroll
          past the whole site tree.
        */}
        <div class="docs-drawer__header">
          <h2 class="docs-drawer__title" id="docs-drawer-title">{t("nav.drawer")}</h2>
          <button class="sk-button sk-interactive" data-variant="ghost" type="button" aria-label={t("nav.closeDrawer")} data-sk-vaul-close>
            <Fragment set:html={closeIcon} />
          </button>
        </div>
        {/*
          The WHOLE site index, nested: one collapsible disclosure per section (DrawerNav.astro), the
          current one open. It replaces the old pair of flat lists (global links, then just the
          current section's rail), which forced a reader deep in one section to leave via a link that
          did not say where the other sections' pages were.
        */}
        <div class="docs-drawer__content sk-scrollbar sk-scrollbar--reveal">
          <DrawerNav sections={drawerSections} home={drawerHome} path={path} />
        </div>
      </dialog>
    {/*
      On open, bring the current page's entry into view AND put focus on it: its section is the one
      expanded, but a long open list (Componentes) can still leave the entry below the fold, and
      `showModal()`'s own focus lands on the close button at the top, so a screen-reader user starts
      Tabbing from a different place than the sighted view is scrolled to. Focusing the current link
      makes the two agree and puts the reader one keystroke from browsing. The `<dialog>`'s own
      `toggle` event fires for `showModal()` too (Vaul's `sk:openchange` only announces CLOSE); double
      rAF so the just-shown list has been laid out first.
    */}
    <script is:inline>
      (function () {
        var drawer = document.getElementById("docs-drawer");
        if (!drawer) return;
        drawer.addEventListener("toggle", function (event) {
          if (event.newState !== "open") return;
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              var current = drawer.querySelector('.docs-drawer-nav [aria-current="page"]');
