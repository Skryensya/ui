      {/*
        The hero-tabs ToC's fill, `is:inline` and RIGHT HERE on purpose. The deferred/module version
        this replaced sat near the end of `<body>` (after the footer, the search dialog, every other
        script) and a `type="module"` script never runs until the WHOLE document has parsed, wherever
        it sits in the DOM — so it was never really waiting on `@skryensya/vanilla` (splitting that
        import out only bought ~15ms), it was waiting on the parser to finish everything AFTER the
        toc too. `is:inline` runs the instant the parser reaches it, and the panels this reads are
        already above it in source, so it can fill the list before the parser has even reached the
        footer, let alone before the deferred scripts' turn.

        `data-sk-hero-tab` (set in `<head>`, before body) rather than the tabs root's own `data-value`:
        this needs the READER'S requested tab, and `hero-tabs-url.ts` (which corrects `data-value`
        from `?tab=`) is itself deferred, later than this. Reading the same pre-paint answer that
        already told the stylesheet which panel to show keeps this in sync without waiting on it.

        A hand-written copy of `buildHeroTabsToc`/`panelForHeroTab` (`../scripts/hero-tabs-toc-seed.ts`),
        because `is:inline` cannot `import`; the same duplication `document-index.ts` already accepts
        for this page's slugger, and for the same reason. `hero-tabs-toc.ts` still owns every tab
        switch AFTER this one, via the real module.
      */}
      <script is:inline>
        (function () {
          var heroTabs = document.querySelector(".docs-component-hero-tabs");
          var tocRoot = document.querySelector("[data-sk-toc]");
          if (!heroTabs || !tocRoot) return;
          var tabsRoot = heroTabs.closest("[data-sk-tabs]");
          if (!tabsRoot) return;

          var value = document.documentElement.getAttribute("data-sk-hero-tab") || tabsRoot.getAttribute("data-value");
          if (!value) return;
          var panel = tabsRoot.querySelector(':scope > [data-sk-tabs-content][data-value="' + value + '"]');
          if (!panel) return;
          var list = tocRoot.querySelector("ul");
          if (!list) return;

          var headings = panel.querySelectorAll(":scope > h3, :scope > h4");
          if (headings.length < 1) {
            tocRoot.setAttribute("data-empty", "");
            tocRoot.setAttribute("data-ready", "");
            return;
          }

          var frag = document.createDocumentFragment();
          for (var i = 0; i < headings.length; i++) {
            var heading = headings[i];
            if (!heading.id) {
              var base =
                (heading.textContent || "")
                  .toLowerCase()
                  .normalize("NFD")
                  .replace(/[̀-ͯ]/g, "")
                  .replace(/[^a-z0-9]+/g, "-")
                  .replace(/(^-|-$)/g, "") || "seccion";
              var id = base;
              var n = 2;
              while (document.getElementById(id)) id = base + "-" + n++;
              heading.id = id;
            }
            var item = document.createElement("li");
            item.className = "sk-toc__item";
            item.setAttribute("data-level", heading.tagName === "H3" ? "h2" : "h3");
            var link = document.createElement("a");
            link.className = "sk-toc__link sk-interactive";
            link.href = "#" + heading.id;
            link.textContent = heading.textContent;
            item.appendChild(link);
            frag.appendChild(item);
          }
          list.replaceChildren(frag);

          if (!window.location.hash) {
            var first = list.querySelector("a");
            if (first) first.setAttribute("aria-current", "true");
          }

          tocRoot.setAttribute("data-ready", "");
        })();
      </script>
    </div>

    </Fragment>
    )}
