      common) rounding it to the NEAREST integer CSS px rounds down about half the time — e.g. a
      real 57.7px bar becomes a `top` offset of 58px for everything sticky below it, which is 0.3px
      ABOVE the bar's actual bottom edge. At 1x that sliver blends into the anti-aliasing and is
      invisible; at 3x it is a full, crisp device pixel of whatever is behind the bar (the canvas,
      or scrolled content) showing through as a hairline strip. `ceil` always resolves at or past
      the true edge, so every consumer tucks a sliver UNDER the bar (hidden by its higher z-index)
      instead of leaving a gap below it. Confirmed against `.docs-component-hero`'s own collapsed
      band, the case this was reported against.
    */}
    <script is:inline>
      (function () {
        var nav = document.querySelector(".dimensions");
        if (!nav) return;
        var tabs = document.querySelector(".docs-component-hero-tabs");
        var root = document.documentElement;
        var sync = function () {
          root.style.setProperty("--docs-navbar-h", Math.ceil(nav.getBoundingClientRect().height) + "px");
          if (tabs) {
            root.style.setProperty("--docs-hero-tabs-h", Math.ceil(tabs.getBoundingClientRect().height) + "px");
          }
        };
        sync();
        if (window.ResizeObserver) {
          var observer = new ResizeObserver(sync);
          observer.observe(nav);
          if (tabs) observer.observe(tabs);
        } else {
          window.addEventListener("resize", sync);
        }
      })();
    </script>

    {/*
      SMOOTH SCROLL, ONLY FOR AN ANCHOR CLICK.

      `scroll-behavior: smooth` on `html` used to do this, but that rule can't tell an anchor click
      apart from any other programmatic scroll on the page: Tab landing on an off-screen control,
      `:focus()` calls, `scrollIntoView()` elsewhere all travel too, which reads as the site holding
      the scrollbar rather than a page reacting to a click. So there is no CSS rule and no attribute;
      `html` stays at the default `auto`, and every scroll the reader didn't click for. Including
      the initial load of a deep link. Lands the same way the platform always lands it, instantly.

      This listens for clicks on same-page anchors only (`href="#id"` resolving to an element in this
      document) and animates just that one scroll by calling `scrollIntoView` directly.
    */}
    <script is:inline>
      document.addEventListener("click", function (event) {
        var link = event.target.closest && event.target.closest('a[href^="#"]');
        if (!link) return;
        var hash = link.getAttribute("href");
        if (!hash || hash.length < 2) return;
        var target = document.getElementById(hash.slice(1));
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.pushState(null, "", hash);
      });
    </script>

    {/*
      ALL THAT IS LEFT OF THE HEADING SCAN, which used to be seventy lines here and now happens
      while the page is built (`../lib/document-index.ts`, called from this file's frontmatter):
      the rail arrives filled, with its ids already on the headings.

      This is the one part of it a static page cannot answer, because a URL fragment never reaches
      the server: the build seeds the FIRST section as current, which is right for a reader who
      landed at the top and wrong for one who followed a link INTO a section. `is:inline`, so the
      seed is gone before first paint rather than corrected on screen a frame later.
    */}
    <script is:inline>
      if (window.location.hash) {
        var seeded = document.querySelector('[data-sk-toc] [aria-current="true"]');
        if (seeded) seeded.removeAttribute("aria-current");
      }
    </script>

    {/*
      Which hero tab is open, in the address bar, so it can be linked to (`../scripts/hero-tabs-url.ts`).
      Writes the tab from `?tab=` onto the root's `data-value`, which `Tabs.svelte` reads at hydration
      to pick its default. The ToC's own fill no longer waits on this one (see the `is:inline` script
      right after `<Toc>` above, which reads the same `data-sk-hero-tab` this was itself resolved
      from, set in `<head>` before either of these runs).
    */}
    <script>
      import { initHeroTabsUrl } from "../scripts/hero-tabs-url";
      initHeroTabsUrl();
    </script>

    {/*
      The hero tabs ToC's reactive half (`../scripts/hero-tabs-toc.ts`): rebuilding the list and its
      scroll-spy on every tab switch. The initial fill already happened, `is:inline`, right after
      `<Toc>`; this only has to be ready by the reader's first click, which is never before first
      paint, so a module script (needs `@skryensya/vanilla`'s enhancer runtime) is fine here.
    */}
    <script>
      import { initHeroTabsToc } from "../scripts/hero-tabs-toc";
      initHeroTabsToc();
    </script>

    <script>
      import { initUsedValues } from "../scripts/used-values";
      initUsedValues();
    </script>


    <script>
      import { getPreference, setPreference, subscribePreference } from "@skryensya/vanilla/storage";
      import { contrastPreference } from "../lib/preferences";

      const contrastToggles = document.querySelectorAll<HTMLButtonElement>(
        "[data-docs-contrast-toggle]:not([data-contrast-toggle-scoped])",
      );

      if (contrastToggles.length > 0) {
        const root = document.documentElement;
        let high = root.getAttribute("data-contrast") === "high";

        const paint = () => {
          // The HC tokens key on `[data-contrast="high"]` (modes/hc.scss), so the VALUE has to be
          // "high", `toggleAttribute` would set `data-contrast=""`, which matches neither that opt-in
          // nor the `:root:not([data-contrast])` media-query fallback, so contrast silently stayed off
          // until a reload ran the FOUC script's setAttribute. Mirror that script exactly here.
          if (high) root.setAttribute("data-contrast", "high");
          else root.removeAttribute("data-contrast");
          contrastToggles.forEach((contrastToggle) => {
            const text =
              (high
                ? contrastToggle.dataset.labelHigh
                : contrastToggle.dataset.labelNormal) ?? "";
            contrastToggle.setAttribute("aria-pressed", String(high));
            contrastToggle.setAttribute("aria-label", text);
          });
        };

        paint();
        contrastToggles.forEach((contrastToggle) => {
          contrastToggle.addEventListener("click", () => {
            high = !high;
            paint();
            setPreference(contrastPreference, high ? "high" : "normal");
            document.dispatchEvent(new CustomEvent("sk:dimensions-changed"));
          });
        });

        // Mirror a contrast change made in another tab: `subscribePreference` fires once immediately
        // with the current value (a no-op here, since `high` above already matches storage) and again
        // on every later `storage` event from another tab.
        const applyIfChanged = (value: string) => {
          const next = value === "high";
          if (next === high) return;
          high = next;
          paint();
          document.dispatchEvent(new CustomEvent("sk:dimensions-changed"));
        };
        subscribePreference(contrastPreference, applyIfChanged);

        // `storage` events are deferred by the browser for a backgrounded tab (Chrome and Safari
        // both do this), so re-read the moment this tab becomes visible again rather than trusting
        // the event alone; see the matching comment in scripts/theme-toggle.ts.
        const resync = () => applyIfChanged(getPreference(contrastPreference));
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") resync();
        });
        window.addEventListener("pageshow", resync);
      }
    </script>

    <script>
      /* The color-palette toggle cycles the curated presets. Each preset contains complete accent
       * and neutral ramp declarations; a click writes those explicit tier-1 values onto :root and
       * persists the id. The FOUC guard replays them before paint on the next load. The first preset
       * is the default and removes every inline ramp override. */
      import { getPreference, setPreference } from "@skryensya/vanilla/storage";
      import { palettePreference } from "../lib/preferences";
      type PalettePreset = {
        id: string;
        name: string;
        accent: string;
        tokens: Record<string, string>;
      };

      const paletteToggles = document.querySelectorAll("[data-docs-palette-toggle]");
      const presetsEl = document.getElementById("docs-palette-presets");
      if (paletteToggles.length > 0 && presetsEl) {
        const root = document.documentElement;
        let presets: PalettePreset[] = [];
        try {
          presets = JSON.parse(presetsEl.textContent || "[]");
        } catch {}

        let index = Math.max(0, presets.findIndex((p) => p.id === getPreference(palettePreference)));

        const apply = (persist: boolean) => {
          const preset = presets[index];
          if (!preset) return;
          const properties = Object.keys(presets[0].tokens);
          for (const property of properties) {
            if (index === 0) root.style.removeProperty(property);
            else root.style.setProperty(property, preset.tokens[property]);
          }
          paletteToggles.forEach((paletteToggle) => {
            const dot = paletteToggle.querySelector<HTMLElement>(".dimensions__palette-dot");
            /* the dot shows the current color; the label names it so the icon-only button stays legible */
            if (dot) dot.style.setProperty("--swatch", preset.accent);
            /* Template rendered at build (`Paleta: {name}` / `Palette: {name}`): a module script has
             * no access to `t()`, so the locale arrives on the element. */
            const template = paletteToggle.getAttribute("data-label-template") || "{name}";
            const text = template.replace("{name}", preset.name);
            paletteToggle.setAttribute("aria-label", text);
          });
          if (persist) setPreference(palettePreference, preset.id);
        };

        apply(false); // sync every dot + label to the saved preset the FOUC guard already applied
        paletteToggles.forEach((paletteToggle) => {
          paletteToggle.addEventListener("click", () => {
            index = (index + 1) % presets.length;
            apply(true);
          });
        });
      }
    </script>

    <script>
      /* The mobile nav is a dialog-backed navigation drawer, not an ARIA menu. Vaul owns opening,
       * closing, light-dismiss, drag-to-dismiss and trigger disclosure state. This site-only hook only
       * removes the drawer when the desktop rail returns, otherwise focus would stay trapped in a
       * duplicate copy of the navigation now visible in the page. */
      const drawer = document.getElementById("docs-drawer");
      if (drawer instanceof HTMLDialogElement) {
        const wide = window.matchMedia("(min-width: 52rem)");
        wide.addEventListener("change", (event) => {
          if (event.matches && drawer.open) drawer.close();
        });
      }
    </script>



    {/*
      * DEV ONLY, and it has to run BEFORE `initComponents()` below, not after: `Menu.svelte` reads
      * `data-sk-menu-debug-intent` off an ancestor ONCE, at each menu's own Svelte setup. A plain
      * `const`, never re-checked later, so setting the attribute after a menu has already mounted
      * cannot retroactively turn its safety-triangle visualization on. `@skryensya/devtools`'s own
      * panel mounts much later (after every other script on this page) for the SAME reason it is
      * fine everywhere else: the panel is just UI. This one flag is not just UI, so it gets its own
      * earlier, synchronous, `is:inline` script instead of waiting on the panel's dynamic import -
      * excluded from production the same way the panel below is, at the template level this time
      * rather than a runtime branch, since `import.meta.env.DEV` is not valid syntax inside a
      * non-module `is:inline` script body.
      *
      * `<html>`, not a specific menu root: every `Menu.svelte` instance's `root.closest(...)` finds
      * it as the nearest flagged ancestor regardless of nesting, so the safety triangle paints for
      * every menu on the page. The one thing actually asked for. `getIntentReadout()` still
      * `prepend()`s its "Pointer routing: …" badge onto whatever root it is handed, unconditionally
      * (there is no "just the paint" option in the published mechanism), so flagging `<html>` also
      * means a readout lands as a direct child of `<html>`. A block of text above `<body>` itself.
      * That gets hidden by a separate small stylesheet further down, scoped tightly enough that a
      * page's own dedicated example (flagged on a real `.sk-menu`, not `<html>`) keeps its readout.
      */}
    {import.meta.env.DEV && (
      <script is:inline>
        try {
          if (localStorage.getItem("sk-devtools-safety-triangle") === "1") {
            document.documentElement.setAttribute("data-sk-menu-debug-intent", "");
          }
        } catch (e) {
          /* private mode, quota exceeded. The flag just does not apply this load */
        }
      </script>
    )}


    <script>
      import { initDocsPageLifecycle } from "../scripts/docs-page-lifecycle";
      initDocsPageLifecycle();
    </script>

    {/*
      * DEV ONLY. `import.meta.env.DEV` is statically known at build time, so Rollup's production
      * build dead-code-eliminates this whole branch. The dynamic import is never emitted, never
      * requested, and `@skryensya/devtools` never reaches a reader of the built site. Dynamic
      * `import()` rather than a static one for the same reason: a static import of a DEV-only
      * module still has to resolve to SOMETHING for the production graph to type-check against,
      * where a dynamic one inside a branch that provably never runs is simply gone.
      */}
    <script>
      if (import.meta.env.DEV) {
        const { mountDebugPanel } = await import("@skryensya/devtools");
        mountDebugPanel();
      }
    </script>
  </body>
</html>

<style>
  /* The full-bleed tool layout (/personalizar) owns its own <main>: no page gutter, so its sidebar
     butts straight against the navbar. Scoped HERE because this component authors <main class="sk-main">;
     a page's own scoped style can't reach a layout-owned element. */
  /* At LEAST the viewport under the navbar, and free to grow past it: the preview card sizes to its
     content instead of framing a scrollport, so the DOCUMENT is what scrolls. Nothing here may clip
     or scroll, or the tool's sticky sidebar would have no scrollport to stick against. */
  main.sk-main {
    padding: 0;
    min-width: 0;
    min-block-size: calc(100dvh - var(--docs-navbar-h, var(--docs-header-block-size)));
  }

  /* The used-value probes measure length hooks by assigning them to `width` and reading it back
     (used-values.ts). A probe that carries its component's own `min-inline-size` (number-field,
     time-field, date-picker) would clamp every width read up to that floor, so a 1px border-width
     resolved as 160px. The probes never lay out, so drop the inline-size constraints. */
  [data-probe-for] {
    min-inline-size: 0;
    max-inline-size: none;
  }
</style>
