      <script is:inline>
        (function () {
          var heroTabs = document.querySelector(".docs-component-hero-tabs");
          var tocRoot = document.querySelector("[data-sk-toc]");
          if (!heroTabs || !tocRoot) return;
          var tabsRoot = heroTabs.closest("[data-sk-tabs]");
          if (!tabsRoot) return;

