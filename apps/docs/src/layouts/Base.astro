---
/*
 * Every import below is a BARE SPECIFIER, resolved through the package's exports map, the
 * exact path this site tells consumers to take (ADR-19). If the map breaks, the build breaks;
 * the docs can't drift from the contract without failing.
 */
import "@skryensya/core/tokens.scss"; // trae el state layer en base, no es un import aparte
import "@skryensya/core/modes/hc.scss";
import "@skryensya/core/dimensions/radius.scss";
import "@skryensya/core/components/badge.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/copy-button.css";
import "@skryensya/core/components/theme-toggle.css";
import "@skryensya/core/components/kbd.css";
import "@skryensya/core/components/field.css";
import "@skryensya/core/components/alert.css";
import "@skryensya/core/components/avatar.css";
import "@skryensya/core/components/loader.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/components/pagination.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/command-palette.css";
import "@skryensya/core/components/tabs.css";
/* Anclaje: la colocación compartida por tooltip, popover, popup, menu, select, combobox, date picker
 * y flyout (decisión 25). Va antes que ellos porque son sus consumidores. */
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/tooltip.css";
import "@skryensya/core/components/switch.css";
import "@skryensya/core/components/table.css";
import "@skryensya/core/components/typography.css";
/* icon.css NO se importa aquí: viaja en tokens.scss, como el state layer. Un icono no es un extra al
 * que un componente opta (decisión 15). */
import "@skryensya/core/patterns/nav-list.css"; // opt-in: una app puede no tener navegación (decisión 17)
import "@skryensya/core/patterns/scrollbar.css";
import "@skryensya/core/patterns/scroll-lock.css";
import "@skryensya/core/patterns/media-gradient.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/patterns/table-pager.css";

/* kbd is in the global chrome (the ⌘K search badge, the palette footer), so its consumer skin loads
 * here rather than per-page, the same reason the button skin above does. */
/* table skin: TokenTable, demos and playground all share one consumer CSS. */
/* pagination appears in /personalizar and the component page, one consumer skin. */
/* switch: CodeBlock Condensed/Full density control, plus /personalizar and the component page. */
import "../styles/site.css";
import "../styles/shell.scss";

import LanguageToggle from "../components/LanguageToggle.astro";
import SidebarNav from "../components/SidebarNav.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Toc from "../components/Toc.astro";
import VanillaMount from "../components/VanillaMount.astro";
import { vanillaMounts } from "../lib/vanilla-mounts";
import { allSets, contrastHigh, contrastNormal, iconDataMarkup, iconMarkup, siteIconSet } from "../icons";
import { getGlobalNavigation, getNavigation, type NavigationSection } from "../lib/navigation";
import { availableLocales, canonicalPath, getLocale, localizePath, useTranslations } from "../i18n";
import { createRamp } from "../lib/ramps";
import { STORAGE_KEY } from "@skryensya/core/storage";
import {
  colorModePreference,
  componentPreviewBindingPreference,
  componentPreviewScreenPreference,
  contrastPreference,
  palettePreference,
} from "../lib/preferences";

/*
 * What the pre-paint script is allowed to know: the storage key and the slot names, taken from the
 * declarations rather than re-typed as literals. That inline script cannot import (it runs before
 * modules), so this is how it stays tied to the single source instead of being a second one.
 */
const PREPAINT = {
  key: STORAGE_KEY,
  scheme: colorModePreference.slot,
  contrast: contrastPreference.slot,
  binding: componentPreviewBindingPreference.slot,
  screen: componentPreviewScreenPreference.slot,
  palette: palettePreference.slot,
};

interface Props {
  title: string;
  description?: string;
  /** Full-width tool layout: drop the docs rail, toc, page-nav and footer, render the slot alone. */
  fullBleed?: boolean;
}

const { title, description, fullBleed = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

/*
 * `path` is what the reader's URL says; `canonical` is the same page named in Spanish, the site's
 * locale-independent identity for a document. Anything keyed by page — the mount catalogue, the
 * alternate-language links — looks up `canonical`; anything compared against a rendered href
 * compares `path`, because the rail is already rendered in this locale.
 */
const locale = getLocale(Astro.url);
const canonical = canonicalPath(path);
const t = useTranslations(locale);
const vanillaMount = vanillaMounts[canonical as keyof typeof vanillaMounts];
/* Every translation of this page that actually EXISTS: advertising one that 404s is worse than
 * advertising none, so the list comes from the page directory rather than from the locale list. */
const alternates = availableLocales(canonical).map((code) => ({
  code,
  href: localizePath(canonical, code),
}));


/*
 * The geometry of all three sets, serialized into the page for the pre-paint pass below.
 *
 * This site is unusual on purpose: it lets you SWAP icon sets at runtime, which no consuming app
 * does, an app picks its set at build and its icons are correct on first paint with zero JS. That
 * affordance is what put the geometry behind a deferred module, and a deferred module is why the
 * page painted Lucide and then swapped to your set while you watched.
 *
 * These bytes were already being shipped, as a module chunk. Inlining moves them rather than adding
 * them: the cost is losing a cross-page cache entry, and the return is that the icons are never
 * wrong on screen. Derived from `allSets`, so the set list has exactly one source of truth.
 */
const iconGeometry = Object.fromEntries(allSets.map((set) => [set.id, set.set]));

/*
 * The navigation lives in lib/navigation.ts, shared with the catalog so the same task grouping
 * cannot drift between exploration and navigation.
 */
const navigation = getNavigation(locale) satisfies readonly NavigationSection[];
const globalNavigation = getGlobalNavigation(locale);
/* By stable id, never by visible title: the titles are translated now and would stop matching. */
const componentSection = navigation.find((section) => section.id === "components");
const systemSection = navigation.find((section) => section.id === "system");

/*
 * One rail follows the reader through the whole library. Catalog and reference subpages inherit
 * the section that explains their context.
 */
/* Matched on `canonical`, so one rule covers `/componentes/...` and `/en/components/...` alike. */
const currentSection =
  canonical === "/componentes" || canonical.startsWith("/componentes/")
    ? componentSection ?? navigation[0]
    : canonical.startsWith("/referencia/")
      ? systemSection ?? navigation[0]
      : navigation.find((section) => section.groups.some((group) => group.items.some((item) => item.href === path))) ?? navigation[0];

/* Prev/next stays within the current task area rather than crossing from a component into an ADR. */
const navItems = currentSection.groups.flatMap((group) => group.items);
const currentNavIndex = navItems.findIndex((item) => item.href === path);
const previousNavItem = currentNavIndex > 0 ? navItems[currentNavIndex - 1] : undefined;
const nextNavItem = currentNavIndex >= 0 ? navItems[currentNavIndex + 1] : undefined;

/*
 * Search sees the complete library. The catalog is a view, not a rail category, but remains a
 * deliberate result for people who want to browse rather than arrive with a component name.
 */
const searchIndex = [
  ...navigation.flatMap((section) =>
    section.groups.flatMap((group) =>
      group.items
        .filter((item) => !item.todo)
        .map((item) => ({
          label: item.label,
          aliases: item.aliases ?? [],
          href: item.href,
          section: section.section,
          group: group.group,
        })),
    ),
  ),
  {
    label: t("search.exploreComponents"),
    aliases: ["all", "catalog", "catálogo", "todos"],
    href: localizePath("/componentes", locale),
    section: t("section.components"),
    group: t("group.explore"),
  },
  {
    label: t("search.layoutGuide"),
    aliases: ["overview", "primitivas", "resumen"],
    href: localizePath("/componentes/primitivas", locale),
    section: t("section.components"),
    group: t("group.layout"),
  },
  {
    label: t("nav.customize"),
    aliases: ["personalizar", "marca", "brand", "playground"],
    href: localizePath("/personalizar", locale),
    section: t("group.global"),
    group: t("nav.customize"),
  },
];

const searchIcon = iconMarkup("search");
const closeIcon = iconMarkup("close");
const menuIcon = iconMarkup("menu");
const previousIcon = iconMarkup("arrow-left");
const nextIcon = iconMarkup("arrow-right");
/* Out-of-set glyphs for the contrast toggle: two states that cross-fade in place. */
const contrastNormalIcon = iconDataMarkup("contrast-normal", contrastNormal, { attrs: { "data-contrast-icon": "normal" } });
const contrastHighIcon = iconDataMarkup("contrast-high", contrastHigh, { attrs: { "data-contrast-icon": "high" } });

/*
 * A FEW curated palette presets, not the whole customiser. Each preset carries the complete accent
 * and neutral ramp declarations generated at build time. The nav control writes that explicit
 * tier-1 contract onto :root; Core does not derive colors from a hidden input.
 * `id` persists in localStorage; "azul" is the system default and the fallback everywhere.
 */
const palettePreset = (id: string, name: string, accent: string, neutral: string) => ({
  id,
  name,
  accent,
  ramps: { ...createRamp("accent", accent), ...createRamp("neutral", neutral) },
});
const paletteNames = locale === "en"
  ? { azul: "Blue", violeta: "Violet", teal: "Teal", rosa: "Pink", naranja: "Orange" }
  : { azul: "Azul", violeta: "Violeta", teal: "Turquesa", rosa: "Rosa", naranja: "Naranja" };
const PALETTE_PRESETS = [
  palettePreset("azul", paletteNames.azul, "oklch(50.4% 0.169 259.6)", "oklch(58.8% 0.018 260)"),
  palettePreset("violeta", paletteNames.violeta, "oklch(51% 0.185 300)", "oklch(58.8% 0.018 260)"),
  palettePreset("teal", paletteNames.teal, "oklch(50% 0.115 210)", "oklch(58% 0.08 248)"),
  palettePreset("rosa", paletteNames.rosa, "oklch(56% 0.185 354)", "oklch(58.8% 0.018 260)"),
  palettePreset("naranja", paletteNames.naranja, "oklch(52% 0.15 50)", "oklch(59% 0.08 80)"),
];
---

<!doctype html>
<html lang={locale} class="sk-scrollbar" data-scheme="system" data-icon-set={siteIconSet} data-radius="md" style="--sk-density: 1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · skryensya/ui</title>
    {description && <meta name="description" content={description} />}
    {/* Each translation of this page announces the others, so a crawler treats them as one document
        in two languages rather than as duplicates competing with each other. */}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
    ))}

    {/*
      Docs has a fixed visual contract: Phosphor icons, medium density and medium rounding. The reader
      preferences are scheme, contrast, the color palette and the two ComponentPreview ones, so apply
      those saved values before first paint, the palette especially, or the page would flash the
      default blue and then re-tint.

      THE ONE PLACE THAT TOUCHES localStorage DIRECTLY, and it has to: this runs before any module
      loads, so it cannot import the storage primitive — importing is the entire thing it exists to
      happen before. What it does NOT do is re-type the key and the slot names: `PREPAINT` carries
      them in from the real declarations, so renaming a slot cannot leave this script reading a slot
      nobody writes any more. The value guards stay duplicated here, because a parser is a function
      and functions do not survive serialisation; that is the known and only cost of the exception.
    */}
    <script is:inline define:vars={{ PALETTE_PRESETS, PREPAINT, siteIconSet }}>
      (function () {
        var d = document.documentElement;
        var s = {};
        try {
          s = JSON.parse(localStorage.getItem(PREPAINT.key) || "{}");
        } catch (e) {}
        var stored = function (slot) {
          return s && typeof s === "object" ? s[slot] : undefined;
        };
        var schemeValue = stored(PREPAINT.scheme);
        var scheme = schemeValue === "light" || schemeValue === "dark" ? schemeValue : "system";
        d.setAttribute("data-scheme", scheme);
        d.style.colorScheme = scheme === "system" ? "light dark" : scheme;
        if (stored(PREPAINT.contrast) === "high") d.setAttribute("data-contrast", "high");
        else d.removeAttribute("data-contrast");
        d.style.setProperty("--sk-density", "1");
        d.setAttribute("data-radius", "md");
        d.setAttribute("data-icon-set", siteIconSet);
        /* Shared Vanilla | React preference for every ComponentPreview on the site. */
        d.setAttribute(
          "data-sk-component-preview-pref",
          stored(PREPAINT.binding) === "react" ? "react" : "vanilla",
        );
        /* Shared screen preset, same shape. `free` is the ABSENCE of the attribute, so an unknown
         * or missing value removes it rather than writing a third state nothing styles. */
        var screen = stored(PREPAINT.screen);
        if (screen === "tablet" || screen === "mobile") {
          d.setAttribute("data-sk-component-preview-screen-pref", screen);
        } else {
          d.removeAttribute("data-sk-component-preview-screen-pref");
        }
        /* Each non-default preset carries complete accent and neutral ramp declarations. Unknown
         * or absent ids fall back to the default stylesheet, so clearing storage is a no-op. */
        var preset = null;
        var paletteId = stored(PREPAINT.palette);
        for (var i = 0; i < PALETTE_PRESETS.length; i++) {
          if (PALETTE_PRESETS[i].id === paletteId) { preset = PALETTE_PRESETS[i]; break; }
        }
        if (preset && preset.id !== PALETTE_PRESETS[0].id) {
          var properties = Object.keys(preset.ramps);
          for (var j = 0; j < properties.length; j++) {
            d.style.setProperty(properties[j], preset.ramps[properties[j]]);
          }
        }
      })();
    </script>
  </head>

  <body>
    <div class="docs-canvas">
    <header class="dimensions">
      <div class="dimensions__content sk-wrapper" data-size="lg">
        <button
          class={`sk-button sk-interactive dimensions__menu-trigger${fullBleed ? " dimensions__menu-trigger--always" : ""}`}
          data-variant="ghost"
          type="button"
          aria-controls="docs-drawer"
          aria-expanded="false"
          aria-label={t("nav.openMenu")}
          data-docs-drawer-open
        >
          <Fragment set:html={menuIcon} />
        </button>
        <a class="dimensions__brand" href={localizePath("/", locale)}>skryensya/ui</a>
        <nav class="dimensions__global" aria-label={t("nav.global")}>
          {
            globalNavigation.map((item) => (
              <a
                class="dimensions__global-link sk-interactive"
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>



        {/*
          The command-palette trigger is the shortest path to any documentation destination. The
          trailing controls keep only reader preferences: scheme and contrast.
        */}
        <button
          class="sk-button sk-interactive dimensions__search-trigger"
          data-variant="ghost"
          type="button"
          aria-controls="docs-cmdk"
          aria-expanded="false"
          aria-keyshortcuts="Meta+K Control+K"
          data-sk-command-palette-open
        >
          <Fragment set:html={searchIcon} />
          <span class="dimensions__search-label">{t("search.label")}</span>
          <kbd class="sk-kbd" data-sk-command-palette-hint aria-hidden="true">⌘K</kbd>
        </button>

        {/*
          The reader-preference icon controls (palette + mode + contrast) are one cluster: a tighter gap
          than the header's own, so the icon-to-icon whitespace optically matches the search field's edge
          to the first icon, the icons carry ~one glyph of internal padding on each side, which the
          bordered field does not, so an equal flex gap would read as looser between the two icons.
        */}
        <div class="dimensions__prefs">
          {/*
            Color palette: ONE button that cycles the curated presets (PALETTE_PRESETS), the same shape
            as the mode and contrast toggles beside it rather than a rail of swatches. Its dot shows the
            current accent; a click advances to the next preset and applies its complete root ramps. The
            button ships neutral so there is no wrong-color flash before the script runs.
          */}
          <button
            class="sk-button sk-interactive dimensions__palette-toggle"
            data-variant="ghost"
            data-icon-only
            type="button"
            aria-label={t("prefs.palette")}
            title={t("prefs.palette")}
            data-docs-palette-toggle
            data-label-template={t("prefs.paletteNamed")}
          >
            <span class="dimensions__palette-dot" aria-hidden="true"></span>
          </button>

          {/* One-click mode cycle: system → claro → oscuro. */}
          <ThemeToggle />

          <button
            class="sk-button sk-interactive dimensions__contrast-toggle"
            data-variant="ghost"
            data-icon-only
            type="button"
            aria-pressed="false"
            aria-label={t("prefs.contrastNormal")}
            title={t("prefs.contrastNormal")}
            data-docs-contrast-toggle
            data-label-normal={t("prefs.contrastNormal")}
            data-label-high={t("prefs.contrastHigh")}
          >
            <Fragment set:html={contrastNormalIcon} />
            <Fragment set:html={contrastHighIcon} />
          </button>

          <LanguageToggle />
        </div>

      </div>
    </header>

    {/*
      Command Palette is a DS component on Dialog (ADR-11). The site chrome owns one instance: ⌘K via
      data-sk-command-palette-hotkey, openers via data-sk-command-palette-open + aria-controls, and the
      nav JSON index. initComponents() mounts the enhancer with the rest of the vanilla surface.
    */}
    <dialog
      class="sk-dialog sk-command-palette"
      id="docs-cmdk"
      data-sk-command-palette
      data-sk-command-palette-index="docs-cmdk-index"
      data-sk-command-palette-hotkey="mod+k"
      aria-label={t("search.dialog")}
    >
      <div class="sk-command-palette__search">
        <Fragment set:html={searchIcon} />
        <input
          class="sk-command-palette__input"
          id="docs-cmdk-input"
          type="text"
          role="combobox"
          placeholder={t("search.placeholder")}
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          aria-controls="docs-cmdk-list"
          aria-expanded="true"
          aria-autocomplete="list"
          data-sk-command-palette-input
        />
        <form method="dialog">
          <button
            class="sk-button sk-interactive sk-dialog__close sk-command-palette__close"
            data-sk-button
            data-variant="ghost"
            data-size="sm"
            data-icon-only
            type="submit"
            value="cancel"
            aria-label={t("action.close")}
          >
            <Fragment set:html={closeIcon} />
          </button>
        </form>
      </div>
      <ul
        class="sk-command-palette__list sk-scrollbar"
        id="docs-cmdk-list"
        role="listbox"
        aria-label={t("search.results")}
        data-sk-command-palette-list
      ></ul>
      <p class="sk-command-palette__empty" data-sk-command-palette-empty hidden>{t("search.empty")}</p>
      <footer class="sk-command-palette__footer">
        <span><kbd class="sk-kbd">↑</kbd><kbd class="sk-kbd">↓</kbd> {t("search.hintNavigate")}</span>
        <span><kbd class="sk-kbd">↵</kbd> {t("search.hintOpen")}</span>
        <span><kbd class="sk-kbd">Esc</kbd> {t("search.hintClose")}</span>
      </footer>
    </dialog>
    <script type="application/json" id="docs-cmdk-index" set:html={JSON.stringify(searchIndex)}></script>
    {/* The cycle order for the palette toggle, read by its module script (which has no define:vars). */}
    <script type="application/json" id="docs-palette-presets" set:html={JSON.stringify(PALETTE_PRESETS)}></script>

    {/*
      The same nav as the rail, in a drawer, for viewports with no room for a rail. It is a native
      <dialog> opened with showModal(), so the focus trap, ESC, the inert page and focus restoration
      are the platform's (decision 11), none of it is shipped as JS.
    */}
    <dialog class="sk-vaul sk-drawer docs-drawer" id="docs-drawer" data-edge="inline-start" aria-label={t("nav.drawer")}>
      <div class="sk-vaul__handle" data-part="handle" aria-hidden="true"></div>
      <div class="docs-drawer__header">
        <span class="docs-drawer__title">{t("nav.drawer")}</span>
        <button class="sk-button sk-interactive" data-variant="ghost" type="button" aria-label={t("nav.closeDrawer")} data-docs-drawer-close>
          <Fragment set:html={closeIcon} />
        </button>
      </div>
      <nav class="docs-drawer__global" aria-label={t("nav.global")}>
        {
          globalNavigation.map((item) => (
            <a
              class="docs-drawer__global-link sk-interactive"
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="docs-drawer__content sk-scrollbar sk-scrollbar--reveal">
        <SidebarNav nav={navigation} path={path} idPrefix="docs-drawer-nav" />
      </div>
    </dialog>

    {fullBleed ? (
      <main class="sk-main">
        <slot />
      </main>
    ) : (
    <Fragment>
    <div class="shell sk-wrapper" data-size="lg">
      <aside class="sk-sidebar docs-sidebar">
        <div class="sk-sidebar__content sk-scrollbar sk-scrollbar--reveal">
          <SidebarNav nav={navigation} path={path} idPrefix="docs-nav" />
        </div>

        <hr class="sk-sidebar__separator" />
        <div class="sk-sidebar__footer">skryensya/ui</div>
      </aside>

      <main class="sk-wrapper" data-size="md">
        <slot />
        {vanillaMount && <VanillaMount {...vanillaMount} />}
        {
          currentNavIndex >= 0 && (
            <nav class="docs-page-nav" aria-label={t("nav.between")}>
              {previousNavItem && (
                <a class="sk-button sk-interactive docs-page-nav__link" data-variant="ghost" href={previousNavItem.href} rel="prev">
                  <Fragment set:html={previousIcon} />
                  <span>{previousNavItem.label}</span>
                </a>
              )}
              {nextNavItem && (
                <a class="sk-button sk-interactive docs-page-nav__link docs-page-nav__link--next" data-variant="ghost" href={nextNavItem.href} rel="next">
                  <span>{nextNavItem.label}</span>
                  <Fragment set:html={nextIcon} />
                </a>
              )}
            </nav>
          )
        }
        {/*
          The footer names a package inside a sentence, so the string is split on `{core}` rather
          than concatenated: word order around it differs by language, and only the translator of a
          given locale knows where the code element lands.
        */}
        <footer class="docs-footer" set:html={t("footer.body", { core: "<code>@skryensya/core</code>" })} />
      </main>

      <Toc />
    </div>

    </Fragment>
    )}
    </div>{/* .docs-canvas */}

    {/*
      Probes: real elements carrying the component classes, so tier-3 styling hooks have somewhere to
      exist (ADR-1, they are element-scoped, never on :root), plus a plain one for everything
      inherited from :root. Measurement apparatus: hidden from layout and from assistive tech.

      `position: fixed`, not `absolute`: an absolute box with no inset resolves to its STATIC position, 
      the end of the flow, so its ~118px height extended the document's scrollHeight past the body and
      left an unexplained gap below the page. Fixed is pinned to the viewport and never contributes to
      scroll height, whatever the probes measure to. Consumers only read getComputedStyle custom
      properties off these (scripts/used-values.ts), never their box, so the positioning is free to change.
    */}
    <div aria-hidden="true" style="position:fixed; top:0; left:0; visibility:hidden; pointer-events:none;">
      <div data-probe-for=""></div>
      <span class="sk-badge" data-probe-for="sk-badge"></span>
      <kbd class="sk-kbd" data-probe-for="sk-kbd"></kbd>
      <button class="sk-button sk-interactive" data-sk-button data-probe-for="sk-button"></button>
      <div class="sk-field" data-probe-for="sk-field"></div>
      <input class="sk-input" data-probe-for="sk-input" />
      <label class="sk-checkbox" data-probe-for="sk-checkbox"></label>
      <div class="sk-radio-group" data-probe-for="sk-radio-group"></div>
      <label class="sk-switch" data-probe-for="sk-switch"></label>
      <span class="sk-interactive" data-probe-for="sk-interactive"></span>
      <div class="sk-tabs" data-probe-for="sk-tabs"></div>
      <div class="sk-nav-list" data-probe-for="sk-nav-list"></div>
      <div class="sk-scrollbar" data-probe-for="sk-scrollbar"></div>
      <aside class="sk-sidebar" data-probe-for="sk-sidebar"></aside>
      <div class="sk-vaul" data-probe-for="sk-vaul"></div>
      <div class="sk-drawer" data-probe-for="sk-drawer"></div>
      <div class="sk-dialog" data-probe-for="sk-dialog"></div>
      <details class="sk-details" data-probe-for="sk-details"></details>
      <header class="sk-navbar" data-probe-for="sk-navbar"></header>
      <nav class="sk-pagination" data-probe-for="sk-pagination"></nav>
      <select class="sk-select-native" data-probe-for="sk-select-native"></select>
      <div class="sk-select" data-probe-for="sk-select"></div>
      <dialog class="sk-dialog" data-sk-dialog-vaul data-probe-for="data-sk-dialog-vaul"></dialog>
      <table class="sk-table" data-probe-for="sk-table"></table>
      {/* One probe per component whose page documents styling hooks; used-values.ts resolves each
          hook against the element that scopes it. A component with a hooks table and no probe here
          renders its "used value" column as ", sin elemento donde existir". */}
      <nav class="sk-breadcrumb" data-probe-for="sk-breadcrumb"></nav>
      <div class="sk-carousel" data-probe-for="sk-carousel"></div>
      <div class="sk-combobox" data-probe-for="sk-combobox"></div>
      <div class="sk-command-palette" data-probe-for="sk-command-palette"></div>
      <button class="sk-copy-button" data-probe-for="sk-copy-button"></button>
      <div class="sk-date-picker" data-probe-for="sk-date-picker"></div>
      <div class="sk-empty-state" data-probe-for="sk-empty-state"></div>
      <div class="sk-file-upload" data-probe-for="sk-file-upload"></div>
      <div class="sk-flyout" data-probe-for="sk-flyout"></div>
      <div class="sk-image-frame" data-probe-for="sk-image-frame"></div>
      <ul class="sk-list" data-probe-for="sk-list"></ul>
      <div class="sk-loader" data-probe-for="sk-loader"></div>
      <div class="sk-menu" data-probe-for="sk-menu"></div>
      <div class="sk-number-field" data-probe-for="sk-number-field"></div>
      <div class="sk-placeholder" data-probe-for="sk-placeholder"></div>
      <div class="sk-popover" data-probe-for="sk-popover"></div>
      <ol class="sk-process-list" data-probe-for="sk-process-list"></ol>
      <div class="sk-segmented" data-probe-for="sk-segmented"></div>
      <div class="sk-split-button" data-probe-for="sk-split-button"></div>
      <div class="sk-time-field" data-probe-for="sk-time-field"></div>
      <div class="sk-toolbar" data-probe-for="sk-toolbar"></div>
      <div class="sk-tree-view" data-probe-for="sk-tree-view"></div>
    </div>

    {/*
      BEFORE THE FIRST PAINT, and that is the whole point of the two scripts below.

      Both used to be deferred modules. They were correct and they were late: a module is deferred by
      definition, so the reader saw the page WITHOUT them and then watched them arrive, the toc
      column appearing and reflowing the prose, the icons painting Lucide and swapping to your set.
      "Run it sooner" is not a knob you can turn on a module; it is a different script. These are
      `is:inline`, so they are parser-blocking and run here, after the markup they touch and before
      anything is painted. Nothing pops, because there is no frame where the wrong thing was on screen.

      They are the same trick as the FOUC guard in <head>, moved down to where the DOM exists.
    */}
    <script is:inline define:vars={{ iconGeometry, siteIconSet }}>
      (function () {
        /* The set owns geometry intent, fill, stroke, viewBox, and the binding owns the box and
         * accessibility. So everything the set did not write is stripped, and the managed few stay. */
        var managed = { class: 1, "data-icon": 1, "data-size": 1, "aria-hidden": 1, focusable: 1 };

        // Docs always paints `siteIconSet`, the same set `iconMarkup` serialises at build, so this
        // pass is a no-op on the chrome instead of a visible re-draw. Only the playground calls the
        // scoped form to preview a set inside its own stage; the chrome never adopts that preview.
        function applyIconSet(requested, root) {
          var setId = iconGeometry[requested] ? requested : siteIconSet;
          var set = iconGeometry[setId];
          (root || document.documentElement).setAttribute("data-icon-set", setId);

          var svgs = (root || document).querySelectorAll("svg[data-icon]");
          for (var i = 0; i < svgs.length; i++) {
            var svg = svgs[i];
            var icon = set[svg.getAttribute("data-icon")];
            if (!icon) continue;

            for (var j = svg.attributes.length - 1; j >= 0; j--) {
              var name = svg.attributes[j].name;
              if (!managed[name]) svg.removeAttribute(name);
            }
            svg.setAttribute("viewBox", icon.viewBox);
            for (var key in icon.attrs || {}) svg.setAttribute(key, icon.attrs[key]);
            svg.replaceChildren();
            svg.insertAdjacentHTML("afterbegin", icon.body);
          }
        }

        // Scoped swap for the playground: same geometry, one preview subtree, no global state.
        window.__dsApplyIconSetWithin = function (root, setId) { applyIconSet(setId, root); };
        applyIconSet(siteIconSet);
      })();
    </script>

    {/*
      The navbar's REAL height → `--docs-navbar-h`. The sticky sidebar and toc read it to sit flush
      under the navbar and fill exactly the viewport below it. It replaces the token estimate
      `--docs-header-block-size`, which is a pixel shy of the rendered box and drifts further if density
      or wrapping change the bar. `is:inline` so it runs before first paint (no 1px settle), and a
      ResizeObserver keeps it current when the bar reflows. CSS falls back to the estimate until it runs.
    */}
    <script is:inline>
      (function () {
        var nav = document.querySelector(".dimensions");
        if (!nav) return;
        var root = document.documentElement;
        var sync = function () {
          root.style.setProperty("--docs-navbar-h", Math.round(nav.getBoundingClientRect().height) + "px");
        };
        sync();
        if (window.ResizeObserver) new ResizeObserver(sync).observe(nav);
        else window.addEventListener("resize", sync);
      })();
    </script>

    {/*
      The sidebar's internal scroll SURVIVES navigation. This is a multi-page site, every link is a
      full reload, so the rail's `overflow-y: auto` column would otherwise snap back to the top on each
      page, losing the reader's place in a long index. Persist its scrollTop in sessionStorage (per tab,
      one shared position because the rail is the same on every page) and restore it here, `is:inline`
      after the markup so the element exists and the restore lands before first paint, no visible jump
      from top to saved. Saved on scroll and on pagehide, the latter covering the click that navigates.
    */}
    <script is:inline>
      (function () {
        var KEY = "docs-sidebar-scroll";
        var rail = document.querySelector(".docs-sidebar .sk-sidebar__content");
        if (!rail) return;
        var saved = sessionStorage.getItem(KEY);
        if (saved) rail.scrollTop = parseInt(saved, 10) || 0;
        var save = function () {
          sessionStorage.setItem(KEY, String(rail.scrollTop));
        };
        rail.addEventListener("scroll", save, { passive: true });
        window.addEventListener("pagehide", save);
      })();
    </script>

    <script is:inline>
      (function () {
        var toc = document.querySelector("[data-docs-toc]");
        var main = document.querySelector("main");
        var list = toc && toc.querySelector("ul");
        if (!toc || !main || !list) return;

        /* Only the page's own sections. A demo's heading lives nested inside a preview and is
         * content being demonstrated, not a section, `:scope >` excludes it with no blocklist. */
        var headings = main.querySelectorAll(":scope > h2, :scope > h3");
        /* A single section is still worth indexing. Zero: mark ready anyway so the reserved
         * column does not stay in the pre-fill skeleton state forever. */
        if (headings.length < 1) {
          toc.setAttribute("data-empty", "");
          toc.setAttribute("data-ready", "");
          return;
        }

        for (var i = 0; i < headings.length; i++) {
          var heading = headings[i];
          if (!heading.id) {
            /* Accent-stripping: the headings are Spanish, so "Navegación" must not slug to
             * "navegaci-n". */
            var base =
              (heading.textContent || "")
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-z0-9]+/g, "-")
                .replace(/(^-|-$)/g, "") || "seccion";
            var id = base;
            var n = 2;
            while (document.getElementById(id)) id = base + "-" + n++;
            heading.id = id;
          }

          var item = document.createElement("li");
          item.className = "docs-toc__item";
          item.setAttribute("data-level", heading.tagName.toLowerCase());

          var link = document.createElement("a");
          link.className = "docs-toc__link sk-interactive";
          link.href = "#" + heading.id;
          link.textContent = heading.textContent;

          item.appendChild(link);
          list.appendChild(item);
        }

        /* The spy runs on IntersectionObserver, which cannot report before layout exists, so the
         * rail would paint with nothing marked and light up the first section a frame later. Landing
         * at the top means the first section IS the current one, so say so now and let the spy take
         * over. Skipped when the URL carries a hash: the browser is about to scroll somewhere else,
         * and guessing "first" there would be a wrong answer that has to be corrected on screen. */
        if (!window.location.hash) {
          var first = list.querySelector("a");
          if (first) first.setAttribute("aria-current", "true");
        }

        toc.setAttribute("data-ready", "");
      })();
    </script>


    <script>
      import { initUsedValues } from "../scripts/used-values";
      initUsedValues();
    </script>

    {/* Shape and spy share the same controller used inside ComponentPreview. */}
    <script>
      import { initTocDisclosure, initTocSpy } from "../scripts/toc";
      initTocDisclosure();
      initTocSpy();
    </script>

    <script>
      import { setPreference } from "@skryensya/vanilla/storage";
      import { contrastPreference } from "../lib/preferences";

      const contrastToggle = document.querySelector<HTMLButtonElement>("[data-docs-contrast-toggle]");

      if (contrastToggle) {
        const root = document.documentElement;
        let high = root.getAttribute("data-contrast") === "high";

        const paint = () => {
          // The HC tokens key on `[data-contrast="high"]` (modes/hc.scss), so the VALUE has to be
          // "high", `toggleAttribute` would set `data-contrast=""`, which matches neither that opt-in
          // nor the `:root:not([data-contrast])` media-query fallback, so contrast silently stayed off
          // until a reload ran the FOUC script's setAttribute. Mirror that script exactly here.
          if (high) root.setAttribute("data-contrast", "high");
          else root.removeAttribute("data-contrast");
          // Icon-only button: the state lives in aria-pressed (drives the active fill in CSS) and the
          // tooltip, not in visible text.
          //
          // Both labels are rendered onto the element at build, because this is a module script: it
          // cannot see `t()`, and a template literal here would hard-code Spanish into every locale.
          const text =
            (high
              ? contrastToggle.dataset.labelHigh
              : contrastToggle.dataset.labelNormal) ?? "";
          contrastToggle.setAttribute("aria-pressed", String(high));
          contrastToggle.setAttribute("aria-label", text);
          contrastToggle.setAttribute("title", text);
        };

        paint();
        contrastToggle.addEventListener("click", () => {
          high = !high;
          paint();
          setPreference(contrastPreference, high ? "high" : "normal");
          document.dispatchEvent(new CustomEvent("sk:dimensions-changed"));
        });
      }
    </script>

    <script>
      /* The color-palette toggle cycles the curated presets. Each preset contains complete accent
       * and neutral ramp declarations; a click writes those explicit tier-1 values onto :root and
       * persists the id. The FOUC guard replays them before paint on the next load. The first preset
       * is the default and removes every inline ramp override. */
      import { getPreference, setPreference } from "@skryensya/vanilla/storage";
      import { palettePreference } from "../lib/preferences";

      const paletteToggle = document.querySelector("[data-docs-palette-toggle]");
      const presetsEl = document.getElementById("docs-palette-presets");
      if (paletteToggle && presetsEl) {
        const root = document.documentElement;
        const dot = paletteToggle.querySelector<HTMLElement>(".dimensions__palette-dot");
        let presets = [];
        try {
          presets = JSON.parse(presetsEl.textContent || "[]");
        } catch {}

        let index = Math.max(0, presets.findIndex((p) => p.id === getPreference(palettePreference)));

        const apply = (persist) => {
          const preset = presets[index];
          if (!preset) return;
          const properties = Object.keys(presets[0].ramps);
          for (const property of properties) {
            if (index === 0) root.style.removeProperty(property);
            else root.style.setProperty(property, preset.ramps[property]);
          }
          /* the dot shows the current color; the label names it so the icon-only button stays legible */
          if (dot) dot.style.setProperty("--swatch", preset.accent);
          /* Template rendered at build (`Paleta: {name}` / `Palette: {name}`): a module script has
           * no access to `t()`, so the locale arrives on the element. */
          const template = paletteToggle.getAttribute("data-label-template") || "{name}";
          const text = template.replace("{name}", preset.name);
          paletteToggle.setAttribute("aria-label", text);
          paletteToggle.setAttribute("title", text);
          if (persist) setPreference(palettePreference, preset.id);
        };

        apply(false); // sync the dot + label to the saved preset the FOUC guard already applied
        paletteToggle.addEventListener("click", () => {
          index = (index + 1) % presets.length;
          apply(true);
        });
      }
    </script>

    <script>
      /* The drawer. Everything that makes it a dialog, focus trap, ESC, inert page, focus back on
       * the trigger, belongs to showModal(); this only decides WHEN, and gets out of the way. */
      import { connectVaul } from "@skryensya/vanilla/vaul";

      const drawer = document.getElementById("docs-drawer");
      /* The one behaviour the platform does not have: pull the panel back to its edge to dismiss. */
      if (drawer instanceof HTMLDialogElement) connectVaul(drawer);

      const drawerTrigger = document.querySelector<HTMLButtonElement>("[data-docs-drawer-open]");

      if (drawer instanceof HTMLDialogElement && drawerTrigger) {
        const sync = () => drawerTrigger.setAttribute("aria-expanded", String(drawer.open));

        drawerTrigger.addEventListener("click", () => {
          drawer.showModal();
          sync();
        });
        drawer.addEventListener("close", sync);

        drawer.querySelector("[data-docs-drawer-close]")?.addEventListener("click", () => drawer.close());

        /* The backdrop is the dialog's own box, so a click landing outside the panel's rectangle is a
         * click on the backdrop, the usual "tap outside to dismiss" without a second overlay element. */
        drawer.addEventListener("click", (event) => {
          if (event.target !== drawer) return;
          const box = drawer.getBoundingClientRect();
          const outside =
            event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom;
          if (outside) drawer.close();
        });

        /* Grow past the breakpoint and the rail is back: a modal pinned over a layout that no longer
         * needs it would trap focus in a duplicate of what is already on screen. */
        const wide = window.matchMedia("(min-width: 52rem)");
        wide.addEventListener("change", (event) => {
          if (event.matches && drawer.open) drawer.close();
        });
      }
    </script>


    <script>
      /* Icons hydrate the same way a consumer's would: authored `<span data-sk-icon="role">`
       * placeholders swapped for the bound set's <svg>. mountIcons is NOT part of initComponents on
       * purpose, a set is always explicit (ADR-15), so the chrome proves that path by taking it.
       * Runs BEFORE initComponents so machine enhancers patch over already-hydrated markup.
       *
       * The set is `siteIcons`, the SAME one the guard above already painted. A different set here
       * would win — this runs after the guard — and the placeholders would land in one set while
       * everything serialised at build stayed in the other. */
      import { mountIcons } from "@skryensya/vanilla/icon";
      import { initComponents } from "@skryensya/vanilla/auto";
      import { siteIcons } from "../icons";
      mountIcons(document, siteIcons);
      await initComponents();
    </script>

    <script>
      /* Mode remains the sole scheme control in the docs chrome. */
      import { initThemeTogglePersistence } from "../scripts/theme-toggle";
      import { initDocsBinding } from "../scripts/docs-binding";
      initThemeTogglePersistence();
      initDocsBinding();
    </script>
  </body>
</html>

<style>
  /* The full-bleed tool layout (/personalizar) owns its own <main>: no page gutter, so its sidebar
     butts straight against the navbar. Scoped HERE because this component authors <main class="sk-main">;
     a page's own scoped style can't reach a layout-owned element. */
  /* At LEAST the viewport under the navbar, and free to grow past it: the preview card sizes to its
     content instead of framing a scrollport, so the DOCUMENT is what scrolls. Nothing here may clip
     or scroll, or the tool's sticky sidebar would have no scrollport to stick against. */
  main.sk-main {
    padding: 0;
    min-width: 0;
    min-block-size: calc(100dvh - var(--docs-navbar-h, var(--docs-header-block-size)));
  }

  /* The used-value probes measure length hooks by assigning them to `width` and reading it back
     (used-values.ts). A probe that carries its component's own `min-inline-size` (number-field,
     time-field, date-picker) would clamp every width read up to that floor, so a 1px border-width
     resolved as 160px. The probes never lay out, so drop the inline-size constraints. */
  [data-probe-for] {
    min-inline-size: 0;
    max-inline-size: none;
  }
</style>
