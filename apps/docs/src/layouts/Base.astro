    {/* Both `<main>`s below carry the skip link's destination: the same id, because a page has one
        main region and only one of these two ever renders. `tabindex="-1"` is what makes an element
        a focus target without adding a tab stop; see the rail's own copy of this comment. */}
    {fullBleed ? (
      <main class="sk-main" id="docs-content" tabindex="-1">
        <slot />
      </main>
    ) : (
    <Fragment>
    {/*
      The resizable docs rail persists through localStorage. The vanilla enhancer restores that width
      when it mounts, but waiting for the module means the first paint uses the default 14rem rail and
      the document shifts sideways a moment later. Seed the same CSS hook from the same storage slot
      before the shell is parsed; the enhancer still owns validation, clamping, ARIA and future writes.
    */}
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem("sk");
          if (!raw) return;
          var store = JSON.parse(raw);
          if (!store || typeof store !== "object" || Array.isArray(store)) return;
          var width = store["sidebar-width:docs-rail"];
          if (typeof width !== "number" || !isFinite(width) || width < 0 || width > 10000) return;
          document.documentElement.style.setProperty("--docs-sidebar-resize-inline-size", Math.round(width) + "px");
