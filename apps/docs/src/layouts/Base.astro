---
/*
 * Every import below is a BARE SPECIFIER, resolved through the package's exports map, the
 * exact path this site tells consumers to take (ADR-19). If the map breaks, the build breaks;
 * the docs can't drift from the contract without failing.
 */
import "@skryensya/core/tokens.scss"; // trae el state layer en base, no es un import aparte
import "@skryensya/core/modes/hc.scss";
import "@skryensya/core/dimensions/radius.scss";
/* El alcance del acento (`data-accent`): la dimensión que decide CUÁNTAS cosas visten la marca. El
 * sitio la trae porque el control del header la mueve en vivo, y porque una dimensión que la
 * documentación explica y la hoja de estilos nunca declara es una promesa vacía. */
import "@skryensya/core/dimensions/accent.scss";
import "@skryensya/core/components/badge.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/copy-button.css";
import "@skryensya/core/components/theme-toggle.css";
import "@skryensya/core/components/kbd.css";
import "@skryensya/core/components/field.css";
import "@skryensya/core/components/callout.css";
import "@skryensya/core/components/avatar.css";
import "@skryensya/core/components/loader.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/components/pagination.css";
import "@skryensya/core/components/input.css";
/* La paleta se compone sobre `.sk-dialog` (decisión 11), y su hoja lo dice en la primera línea: es
 * dueña de la fila de búsqueda, la lista y el pie, no del marco modal. Sin esta hoja el ⌘K salía con
 * el borde negro y las esquinas rectas del navegador. Va antes por eso: es la base, no un extra. */
import "@skryensya/core/components/dialog.css";
/*
 * El cajón móvil, y las dos hojas que lo hacen existir. Sin ellas el <dialog> del rail chico salía
 * exactamente como lo pinta el navegador: una caja de 300px centrada en la pantalla, con borde negro
 * de 3px y márgenes automáticos. No es un cajón mal estilado, es un dialog crudo.
 *
 * Es el mismo agujero que ya tuvieron `sidebar.css` (el rail transparente) y `dialog.css` (el ⌘K con
 * borde negro): las tres se sacaron de acá en el mismo commit de "component CSS scoping", y el cajón
 * fue el que nadie volvió a buscar. La regla que las tres confirman: una hoja opt-in se importa donde
 * vive el markup que la usa, y este markup vive en el layout, así que va acá.
 *
 * El patrón antes que el componente: `drawer.css` no trae estructura, sólo re-declara los hooks de
 * Vaul (decisión 8), así que sin `vaul.css` no hay panel que ajustar.
 */
import "@skryensya/core/patterns/vaul.css";
import "@skryensya/core/components/drawer.css";
import "@skryensya/core/components/command-palette.css";
import "@skryensya/core/components/tabs.css";
/* Anclaje: la colocación compartida por tooltip, popover, popup, menu, select, combobox, date picker
 * y flyout (decisión 25). Va antes que ellos porque son sus consumidores. */
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/tooltip.css";
import "@skryensya/core/components/switch.css";
import "@skryensya/core/components/table.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/toc.css"; // el rail "En esta página": Toc.astro monta [data-sk-toc]
/* El shell del rail izquierdo. Faltaba, y el shell de docs había reescrito a mano sus reglas
 * (fondo, borde, separador, footer) leyendo hooks `--sk-sidebar-*` que sin esta hoja no los declara
 * nadie: todos resolvían a nada, así que el rail salía transparente y sin padding. */
import "@skryensya/core/components/sidebar.css";
/* El enlace de salto, primero en el documento y escondido hasta que recibe el foco. Va acá y no en
 * una página: es chrome del layout, como el rail y el cajón. */
import "@skryensya/core/components/skip-link.css";
/* icon.css NO se importa aquí: viaja en tokens.scss, como el state layer. Un icono no es un extra al
 * que un componente opta (decisión 15). */
import "@skryensya/core/patterns/nav-list.css"; // opt-in: una app puede no tener navegación (decisión 17)
import "@skryensya/core/patterns/scrollbar.css";
import "@skryensya/core/patterns/scroll-lock.css";
import "@skryensya/core/patterns/media-gradient.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/patterns/table-pager.css";

/* kbd is in the global chrome (the ⌘K search badge, the palette footer), so its consumer skin loads
 * here rather than per-page, the same reason the button skin above does. */
/* table skin: TokenTable, demos and playground all share one consumer CSS. */
/* pagination appears in /personalizar and the component page, one consumer skin. */
/* switch: CodeBlock Condensed/Full density control, plus /personalizar and the component page. */
import "../styles/site.css";
import "../styles/shell.scss";

import LanguageToggle from "../components/LanguageToggle.astro";
import AccentReachToggle from "../components/AccentReachToggle.astro";
import SidebarNav from "../components/SidebarNav.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Toc from "../components/Toc.astro";
import { indexDocument } from "../lib/document-index";
import { vanillaMountSections } from "../lib/vanilla-mount-sections";
import VanillaMount from "../components/VanillaMount.astro";
import { vanillaMounts } from "../lib/vanilla-mounts";
import { allSets, contrastHigh, contrastNormal, iconDataMarkup, iconMarkup, siteIconSet } from "../icons";
import { getGlobalNavigation, getNavigation, type NavigationSection } from "../lib/navigation";
import { availableLocales, canonicalPath, getLocale, localizePath, useTranslations } from "../i18n";
import { createRamp } from "../lib/ramps";
import { skipLinkParts } from "@skryensya/core/skip-link";
import { STORAGE_KEY } from "@skryensya/core/storage";
import {
  accentReachPreference,
  colorModePreference,
  componentPreviewBindingPreference,
  componentPreviewScreenPreference,
  contrastPreference,
  palettePreference,
} from "../lib/preferences";

/*
 * What the pre-paint script is allowed to know: the storage key and the slot names, taken from the
 * declarations rather than re-typed as literals. That inline script cannot import (it runs before
 * modules), so this is how it stays tied to the single source instead of being a second one.
 */
const PREPAINT = {
  key: STORAGE_KEY,
  scheme: colorModePreference.slot,
  contrast: contrastPreference.slot,
  binding: componentPreviewBindingPreference.slot,
  screen: componentPreviewScreenPreference.slot,
  palette: palettePreference.slot,
  accent: accentReachPreference.slot,
};

interface Props {
  title: string;
  description?: string;
  /** Full-width tool layout: drop the docs rail, toc, page-nav and footer, render the slot alone. */
  fullBleed?: boolean;
  /** Content geometry inside the docs shell. Grid keeps the shell rails but exposes named content spans. */
  documentLayout?: "column" | "grid";
  /**
   * The page authors its own `<VanillaMount>` inside `<slot />` (inside a tab panel, say) instead
   * of getting one appended after it for free. Nothing in the shell may sit outside whatever
   * structure the page chose; a page with tabs cannot have content the tabs don't own.
   */
  hideVanillaMount?: boolean;
}

const { title, description, fullBleed = false, documentLayout = "column", hideVanillaMount = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

/*
 * `path` is what the reader's URL says; `canonical` is the same page named in Spanish, the site's
 * locale-independent identity for a document. Anything keyed by page (the mount catalogue, the
 * alternate-language links) looks up `canonical`; anything compared against a rendered href
 * compares `path`, because the rail is already rendered in this locale.
 */
const locale = getLocale(Astro.url);
const canonical = canonicalPath(path);
const t = useTranslations(locale);
const vanillaMount = vanillaMounts[canonical as keyof typeof vanillaMounts];
/* Every translation of this page that actually EXISTS: advertising one that 404s is worse than
 * advertising none, so the list comes from the page directory rather than from the locale list. */
const alternates = availableLocales(canonical).map((code) => ({
  code,
  href: localizePath(canonical, code),
}));


/*
 * The geometry of all three sets, serialized into the page for the pre-paint pass below.
 *
 * This site is unusual on purpose: it lets you SWAP icon sets at runtime, which no consuming app
 * does, an app picks its set at build and its icons are correct on first paint with zero JS. That
 * affordance is what put the geometry behind a deferred module, and a deferred module is why the
 * page painted Lucide and then swapped to your set while you watched.
 *
 * These bytes were already being shipped, as a module chunk. Inlining moves them rather than adding
 * them: the cost is losing a cross-page cache entry, and the return is that the icons are never
 * wrong on screen. Derived from `allSets`, so the set list has exactly one source of truth.
 */
const iconGeometry = Object.fromEntries(allSets.map((set) => [set.id, set.set]));

/*
 * The navigation lives in lib/navigation.ts, shared with the catalog so the same task grouping
 * cannot drift between exploration and navigation.
 */
const navigation = getNavigation(locale) satisfies readonly NavigationSection[];
const globalNavigation = getGlobalNavigation(locale);
/* By stable id, never by visible title: the titles are translated now and would stop matching. */
const componentSection = navigation.find((section) => section.id === "components");
const systemSection = navigation.find((section) => section.id === "system");

/*
 * One rail follows the reader through the whole library. Catalog and reference subpages inherit
 * the section that explains their context.
 */
/* Matched on `canonical`, so one rule covers `/componentes/...` and `/en/components/...` alike. */
const currentSection =
  canonical === "/componentes" || canonical.startsWith("/componentes/")
    ? componentSection ?? navigation[0]
    : canonical.startsWith("/referencia/")
      ? systemSection ?? navigation[0]
      : navigation.find((section) => section.groups.some((group) => group.items.some((item) => item.href === path))) ?? navigation[0];

/*
 * THE DOCUMENT, RENDERED HERE, so its own index can be read before the page is sent.
 *
 * `Astro.slots.render("default")` is the page's body as HTML, which is what lets `indexDocument`
 * answer at build the question the browser used to answer on every load: which headings are this
 * page's sections. The string is then written back out with `set:html`, so `<main>` holds exactly
 * what `<slot />` would have put there, plus an `id` on any section heading that lacked one.
 *
 * The full-bleed layout has no toc and no page furniture, so it keeps the plain `<slot />`: nothing
 * would read the index, and rendering the slot twice is the one way to get this wrong.
 */
const documentIndex = fullBleed ? null : indexDocument(await Astro.slots.render("default"));

/*
 * ONE PAGE STILL BUILDS ITS INDEX IN THE BROWSER, and it is the pilot with the hero tab strip
 * (`/componentes/accordion`). Its sections live inside tab panels, one index per tab, and which tab
 * is open is a fact about a reader, not about the document: `../scripts/hero-tabs-toc.ts` owns that
 * one. Detected the same way the old inline script detected it, by the strip's own class, only now
 * in the rendered string rather than through `document.querySelector`.
 */
const tocPending = documentIndex?.html.includes("docs-component-hero-tabs") ?? false;

/*
 * The section a reader lands on IS the first one, so the rail says so in the HTML rather than
 * lighting up a frame later when the spy's first IntersectionObserver callback arrives. A URL with a
 * hash is the exception, and the only part of this the page cannot know while it is being built:
 * a fragment never reaches the server. `toc-hash-seed.ts` is the three lines that clear the seed.
 */
const tocItems = [
  ...(documentIndex?.headings ?? []),
  /* The installation block this layout appends after the document, which is therefore not in the
   * document's own HTML; it declares its own sections (`../lib/vanilla-mount-sections.ts`). */
  ...(documentIndex && !hideVanillaMount && vanillaMount
    ? vanillaMountSections(t, vanillaMount.name)
    : []),
].map((heading, index) => ({
  href: `#${heading.id}`,
  label: heading.label,
  level: heading.level,
  current: index === 0,
}));

/* Prev/next stays within the current task area rather than crossing from a component into an ADR. */
const navItems = currentSection.groups.flatMap((group) => group.items);
const currentNavIndex = navItems.findIndex((item) => item.href === path);
const previousNavItem = currentNavIndex > 0 ? navItems[currentNavIndex - 1] : undefined;
const nextNavItem = currentNavIndex >= 0 ? navItems[currentNavIndex + 1] : undefined;

/*
 * Search sees the complete library. The catalog is a view, not a rail category, but remains a
 * deliberate result for people who want to browse rather than arrive with a component name.
 */
const searchIndex = [
  ...navigation.flatMap((section) =>
    section.groups.flatMap((group) =>
      group.items
        .filter((item) => !item.todo)
        .map((item) => ({
          label: item.label,
          aliases: item.aliases ?? [],
          href: item.href,
          section: section.section,
          group: group.group,
        })),
    ),
  ),
  {
    label: t("search.exploreComponents"),
    aliases: ["all", "catalog", "catálogo", "todos"],
    href: localizePath("/componentes", locale),
    section: t("section.components"),
    group: t("group.explore"),
  },
  {
    label: t("search.layoutGuide"),
    aliases: ["overview", "primitivas", "resumen"],
    href: localizePath("/componentes/primitivas", locale),
    section: t("section.components"),
    group: t("group.layout"),
  },
  {
    label: t("nav.customize"),
    aliases: ["personalizar", "marca", "brand", "playground"],
    href: localizePath("/personalizar", locale),
    section: t("group.global"),
    group: t("nav.customize"),
  },
];

const searchIcon = iconMarkup("search");
const closeIcon = iconMarkup("close");
const menuIcon = iconMarkup("menu");
const previousIcon = iconMarkup("arrow-left");
const nextIcon = iconMarkup("arrow-right");
/* Out-of-set glyphs for the contrast toggle: two states that cross-fade in place. */
const contrastNormalIcon = iconDataMarkup("contrast-normal", contrastNormal, { attrs: { "data-contrast-icon": "normal" } });
const contrastHighIcon = iconDataMarkup("contrast-high", contrastHigh, { attrs: { "data-contrast-icon": "high" } });

/*
 * A FEW curated palette presets, not the whole customiser. Each preset carries the complete accent
 * and neutral ramp declarations generated at build time. The nav control writes that explicit
 * tier-1 contract onto :root; Core does not derive colors from a hidden input.
 * `id` persists in localStorage; "azul" is the system default and the fallback everywhere.
 */
const palettePreset = (id: string, name: string, accent: string, neutral: string) => ({
  id,
  name,
  accent,
  ramps: { ...createRamp("accent", accent), ...createRamp("neutral", neutral) },
});
const paletteNames = locale === "en"
  ? { azul: "Blue", violeta: "Violet", teal: "Teal", rosa: "Pink", naranja: "Orange" }
  : { azul: "Azul", violeta: "Violeta", teal: "Turquesa", rosa: "Rosa", naranja: "Naranja" };
const PALETTE_PRESETS = [
  palettePreset("azul", paletteNames.azul, "oklch(50.4% 0.169 259.6)", "oklch(58.8% 0.018 260)"),
  palettePreset("violeta", paletteNames.violeta, "oklch(51% 0.185 300)", "oklch(58.8% 0.018 260)"),
  palettePreset("teal", paletteNames.teal, "oklch(50% 0.115 210)", "oklch(58% 0.08 248)"),
  palettePreset("rosa", paletteNames.rosa, "oklch(56% 0.185 354)", "oklch(58.8% 0.018 260)"),
  palettePreset("naranja", paletteNames.naranja, "oklch(52% 0.15 50)", "oklch(59% 0.08 80)"),
];
---

<!doctype html>
<html lang={locale} class="sk-scrollbar" data-scheme="system" data-icon-set={siteIconSet} data-radius="md" data-accent="3" style="--sk-density: 1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · skryensya/ui</title>
    {description && <meta name="description" content={description} />}
    {/* Each translation of this page announces the others, so a crawler treats them as one document
        in two languages rather than as duplicates competing with each other. */}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.code} href={alternate.href} />
    ))}

    {/*
      Docs has a fixed visual contract: Phosphor icons, medium density and medium rounding. The reader
      preferences are scheme, contrast, the color palette, the accent reach and the two ComponentPreview
      ones, so apply those saved values before first paint, the palette especially, or the page would
      flash the default blue and then re-tint.

      THE ONE PLACE THAT TOUCHES localStorage DIRECTLY, and it has to: this runs before any module
      loads, so it cannot import the storage primitive: importing is the entire thing it exists to
      happen before. What it does NOT do is re-type the key and the slot names: `PREPAINT` carries
      them in from the real declarations, so renaming a slot cannot leave this script reading a slot
      nobody writes any more. The value guards stay duplicated here, because a parser is a function
      and functions do not survive serialisation; that is the known and only cost of the exception.
    */}
    <script is:inline define:vars={{ PALETTE_PRESETS, PREPAINT, siteIconSet }}>
      (function () {
        var d = document.documentElement;
        /* "Scripting is on", declared before first paint. Its only consumer is the pre-hydration
         * tab rule in site.css: that rule hides panels the reader has not chosen yet, which is only
         * safe if something is coming to give them back. Without JS the flag never lands, the rule
         * never matches, and every panel stays readable, which is the correct no-JS docs page. */
        d.setAttribute("data-js", "");
        /*
         * A `?tab=` deep link, resolved BEFORE FIRST PAINT.
         *
         * site.css closes every hero panel but the first with no script involved, which is the right
         * answer for a plain visit and the wrong one for a link naming any other tab. The element
         * itself is unreachable from here (this runs in <head>, the body is not parsed yet), so what
         * lands is a RULE rather than an attribute: the one thing that can name a value CSS cannot
         * compare on its own. `scripts/hero-tabs-url.ts` still fixes up the DOM afterwards; this is
         * only what stops the first panel being painted for a frame first.
         *
         * The value is pattern-checked before it reaches a stylesheet: it comes from the URL, and
         * anything else could close the rule and append declarations of its own.
         */
        var tab = new URLSearchParams(location.search).get("tab");
        if (tab && /^[a-zA-Z0-9_-]{1,32}$/.test(tab)) {
          d.setAttribute("data-sk-hero-tab", tab);
          var tabStyle = document.createElement("style");
          tabStyle.textContent =
            '[data-js] .sk-tabs:has(> .docs-component-hero-tabs):not([data-scope])' +
            ' > [data-sk-tabs-content]:not([data-value="' + tab + '"]){display:none}';
          d.querySelector("head").appendChild(tabStyle);
        }
        var s = {};
        try {
          s = JSON.parse(localStorage.getItem(PREPAINT.key) || "{}");
        } catch (e) {}
        var stored = function (slot) {
          return s && typeof s === "object" ? s[slot] : undefined;
        };
        var schemeValue = stored(PREPAINT.scheme);
        var scheme = schemeValue === "light" || schemeValue === "dark" ? schemeValue : "system";
        d.setAttribute("data-scheme", scheme);
        d.style.colorScheme = scheme === "system" ? "light dark" : scheme;
        if (stored(PREPAINT.contrast) === "high") d.setAttribute("data-contrast", "high");
        else d.removeAttribute("data-contrast");
        /* Accent reach. Always an explicit level, never the absence of the attribute: level 3 is what
         * the baseline stylesheet already is, but `[data-accent="3"]` is also what lets a reader who
         * dialled down come back up, and the control reads the attribute to know where it stands. */
        var accentValue = stored(PREPAINT.accent);
        d.setAttribute(
          "data-accent",
          accentValue === "1" || accentValue === "2" ? accentValue : "3",
        );
        d.style.setProperty("--sk-density", "1");
        d.setAttribute("data-radius", "md");
        d.setAttribute("data-icon-set", siteIconSet);
        /* Shared Vanilla | React preference for every ComponentPreview on the site. */
        d.setAttribute(
          "data-sk-component-preview-pref",
          stored(PREPAINT.binding) === "react" ? "react" : "vanilla",
        );
        /* Shared screen preset, same shape. `free` is the ABSENCE of the attribute, so an unknown
         * or missing value removes it rather than writing a third state nothing styles. */
        var screen = stored(PREPAINT.screen);
        if (screen === "tablet" || screen === "mobile") {
          d.setAttribute("data-sk-component-preview-screen-pref", screen);
        } else {
          d.removeAttribute("data-sk-component-preview-screen-pref");
        }
        /* Each non-default preset carries complete accent and neutral ramp declarations. Unknown
         * or absent ids fall back to the default stylesheet, so clearing storage is a no-op. */
        var preset = null;
        var paletteId = stored(PREPAINT.palette);
        for (var i = 0; i < PALETTE_PRESETS.length; i++) {
          if (PALETTE_PRESETS[i].id === paletteId) { preset = PALETTE_PRESETS[i]; break; }
        }
        if (preset && preset.id !== PALETTE_PRESETS[0].id) {
          var properties = Object.keys(preset.ramps);
          for (var j = 0; j < properties.length; j++) {
            d.style.setProperty(properties[j], preset.ramps[properties[j]]);
          }
        }
      })();
    </script>
  </head>

  <body>
    {/*
      THE FIRST THINGS IN THE DOCUMENT, and the only elements here whose job is to be invisible.

      Every page of this site opens with the same chrome: the drawer trigger, the brand, four global
      links, the ⌘K trigger, the scheme and contrast controls. Reading with a keyboard, that is nine
      stops before anything this page is actually about, on every page, forever. WCAG 2.4.1 calls
      that a block to bypass; these links are the bypass, and they are the platform's own (an in-page
      href), so they work before any script on this page has run.

      TWO OF THEM, AND THE ORDER IS THE DECISION. Content comes first because it is what almost
      everyone arriving here wants: they followed a link to READ something, and the index is how you
      get somewhere else. A reader who does want the index is one more Tab away; a reader who wants
      the page would otherwise be several. Offering only the index would answer the rarer question
      first and make the common one cost more than it did before.

      The NAVIGATION one is conditional twice over, because a skip link pointing at something that is
      not on the page is worse than none: it is a promise the reader hears and cannot follow.
      `fullBleed` pages (/personalizar) have no index column at all, and below `desktop` the rail is
      `display: none` (shell.scss drops the link there to match). In both cases nothing is lost: the
      drawer trigger is the first control in the header at those widths, so the index is already one
      Tab away.
    */}
    <a class={`${skipLinkParts.root} sk-interactive docs-skip-link`} href="#docs-content">
      {t("nav.skipToContent")}
    </a>
    {!fullBleed && (
      <a
        class={`${skipLinkParts.root} sk-interactive docs-skip-link docs-skip-link--nav`}
        href="#docs-nav"
      >
        {t("nav.skipToNav")}
      </a>
    )}
    <div class="docs-canvas">
    <header class="dimensions">
      <div class="dimensions__content sk-wrapper" data-size="lg">
        <button
          class={`sk-button sk-interactive dimensions__menu-trigger${fullBleed ? " dimensions__menu-trigger--always" : ""}`}
          data-variant="ghost"
          type="button"
          aria-controls="docs-drawer"
          aria-expanded="false"
          aria-label={t("nav.openMenu")}
          data-docs-drawer-open
        >
          <Fragment set:html={menuIcon} />
        </button>
        <a class="dimensions__brand" href={localizePath("/", locale)}>skryensya/ui</a>
        <nav class="dimensions__global" aria-label={t("nav.global")}>
          {
            globalNavigation.map((item) => (
              <a
                class="dimensions__global-link sk-interactive"
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>



        {/*
          The command-palette trigger is the shortest path to any documentation destination. The
          trailing controls keep only reader preferences: scheme and contrast.
        */}
        <button
          class="sk-button sk-interactive dimensions__search-trigger"
          data-variant="ghost"
          type="button"
          aria-controls="docs-cmdk"
          aria-expanded="false"
          aria-keyshortcuts="Meta+K Control+K"
          data-sk-command-palette-open
        >
          <Fragment set:html={searchIcon} />
          <span class="dimensions__search-label">{t("search.label")}</span>
          <kbd class="sk-kbd" data-sk-command-palette-hint aria-hidden="true">⌘K</kbd>
        </button>

        {/*
          The reader-preference icon controls (palette + reach + mode + contrast) are one cluster: a
          tighter gap than the header's own, so the icon-to-icon whitespace optically matches the search
          field's edge to the first icon, the icons carry ~one glyph of internal padding on each side,
          which the bordered field does not, so an equal flex gap would read as looser between the two
          icons.
        */}
        <div class="dimensions__prefs">
          {/*
            Color palette: ONE button that cycles the curated presets (PALETTE_PRESETS), the same shape
            as the mode and contrast toggles beside it rather than a rail of swatches. Its dot shows the
            current accent; a click advances to the next preset and applies its complete root ramps. The
            button ships neutral so there is no wrong-color flash before the script runs.
          */}
