---
/*
 * A demo and its source, as one titled card, with one live stage per binding.
 *
 * The Vanilla demo renders in an inline `srcdoc` iframe: no route or external document, but its own
 * DOM, viewport and top layer. The frame runtime copies the page styles, mounts authored `data-sk-*`
 * roots inside that realm and keeps the parent theme dimensions in sync.
 *
 * The React demo, when the caller provides a `react` slot, renders as a real `@astrojs/react`
 * island (`client:load`) sitting next to the iframe in the parent document: an actual
 * `@skryensya/react` component, not a source string. The `react` prop stays the source shown
 * below it; a page may supply either alone.
 *
 * Binding tabs (header): Vanilla | React as a Segmented control, toggling which stage is visible.
 * Preference is shared across every preview on the page (`data-sk-component-preview-pref` on
 * `<html>`, persisted in docs).
 * Source tabs (below the stage, under Vanilla only): HTML plus optional CSS and JS. They sit
 * under Vanilla, never beside React.
 */
import CodeBlock from "./CodeBlock.astro";
import { emitMarkup, emitReact } from "@skryensya/ai-compiler/emit";
import type { UsageTree } from "@skryensya/ai-compiler/usage-tree";
import { TreeDemo } from "./react-demos/tree";
import { iconMarkup } from "../icons";
import "@skryensya/core/components/component-preview.css";
import "@skryensya/core/components/loader.css";
import "@skryensya/core/components/tabs.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/tooltip.css";
import "@skryensya/core/components/menu.css";
import { buildPreviewFrameDocument } from "../lib/preview-frame";
import { getLocale, useTranslations } from "../i18n";

type CodeLanguage = "bash" | "css" | "html" | "ts" | "tsx";

interface Props {
  /*
   * A USAGE TREE, and the preferred way to write a demo.
   *
   * One authoring, both stages: the markup, the TSX and the live React island are all EMITTED from
   * it, so a page cannot show a snippet that differs from what it renders, which is the whole
   * failure mode hand-written examples have. The same tree shape the MCP validates and the gates
   * measure; when a tree is given, `html` and `react` are ignored rather than merged, because two
   * sources of truth is exactly what this replaces.
   */
  tree?: UsageTree;
  /** The authored markup. Renders inside the srcdoc frame and is the HTML/Vanilla source. */
  html?: string;
  /**
   * App JavaScript beyond `data-sk-*` enhancers (composition, paging, etc.).
   * Shown as a JS tab under Vanilla, next to HTML, never as a peer of React.
   */
  js?: string;
  /** App CSS shown beside HTML under Vanilla. The live frame inherits it from the page stylesheet. */
  css?: string;
  /** The React source. Shown under the React binding's stage. Pair with the `react` slot for a live demo. */
  react?: string;
  /** Explicit Vanilla/HTML source when the live markup isn't what you want to teach. */
  code?: string;
  /**
   * Complete Vanilla/HTML source. With `code` as the condensed view, CodeBlock toggles
   * Condensed | Full. Copy always uses this string.
   */
  codeFull?: string;
  /** App-only JavaScript executed inside the frame after Vanilla enhancers mount; never displayed. */
  previewScript?: string;
  label?: string;
  note?: string;
  lang?: CodeLanguage;
  /**
   * Reserve stage height when the demo paints outside flow (menus, dialogs, drawers, toasts).
   * - `menu`: open listboxes / popovers (~18rem)
   * - `overlay`: dialogs, drawers, toasts (~24rem)
   */
  viewport?: "auto" | "menu" | "overlay";
  /** Give the stage no padding: some components ARE a layout and must reach the edges. */
  flush?: boolean;
  /**
   * Allow scrolling inside the stage. Default is off: the iframe grows to the content height so the
   * demo is fully visible without an inner scrollbar.
   */
  scroll?: boolean;
  /**
   * Cap the specimen's width on the STAGE only, as a CSS length (`measure="34rem"`).
   *
   * For components that only read correctly at a realistic column: a settings List across the full
   * stage looks like nothing anyone ships. The cap never reaches the snippet, because that width is
   * the consumer's layout, not the component's. This is what lets such a demo be a single `tree`
   * instead of a wrapper `<div>` in the slot plus a separate `code` string.
   */
  measure?: string;
  /**
   * Offer the screen presets (Libre | Tablet | Móvil) in the header.
   *
   * ON by default, on every preview: "does this hold up on a phone" is a question a reader can ask
   * of any component, not only of the ones whose layout is obviously the subject: a button's label
   * can wrap, a table can overflow, a dialog can outgrow the viewport. Leaving it to the author of
   * each page to remember would mean the answer is available on the demos someone already thought
   * about, which are exactly the ones that were already fine.
   *
   * Pass `screens={false}` where the presets would mislead rather than inform.
   */
  screens?: boolean;
  /**
   * Named span on the page's `.sk-layout-grid` (`packages/core/css/patterns/layout.css`). Each tab
   * panel is its own layout grid, so a preview sits at `content` measure by default and only reaches
   * for `breakout` (or narrower) when the demo itself needs the room — a settings List does, a Badge
   * does not. Omit to inherit the panel's default.
   */
  width?: "narrow" | "content" | "breakout" | "full-width";
}

const {
  tree,
  html,
  js,
  css,
  react,
  code,
  codeFull,
  previewScript,
  label = "HTML",
  note,
  lang = "html",
  flush = false,
  viewport = "auto",
  scroll = false,
  measure,
  screens = true,
  width,
} = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/*
 * Both sources from the one tree. Emitted at BUILD time: the compiler is data in, strings out, so
 * there is nothing to ship to the reader: the page carries the same bytes it would have carried if
 * someone had typed them, minus the chance that they typed something else.
 */
const treeHtml = tree ? emitMarkup(tree) : undefined;
const treeReact = tree ? emitReact(tree) : undefined;

const vanillaCode = code ?? treeHtml ?? html;
/*
 * The `react` slot carries the LIVE demo (an actual `@skryensya/react` component, `client:load`);
 * the `react` string prop stays the source shown under it. Either alone still counts as "there is a
 * React binding": a page can render a live demo before it has bothered to also show its source.
 */
const reactSlotHtml = Astro.slots.has("react") ? await Astro.slots.render("react") : undefined;
const hasReact = Boolean(tree) || Boolean(treeReact ?? react) || Boolean(reactSlotHtml);
const hasBindingTabs = Boolean(vanillaCode && hasReact);
const hasSourceTabs = Boolean(vanillaCode && (js || css));
const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : undefined;
const previewHtml = treeHtml ?? slotHtml ?? html ?? "";
const playgroundVanilla = `<!doctype html>
<html lang="${locale}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>${label}</title>
    <link rel="stylesheet" href="./skryensya.css" />
${css ? `    <style>\n${css}\n    </style>\n` : ""}  </head>
  <body>
${previewHtml}

    <script type="module">
      import { initComponents, mountIcons, phosphorIcons } from "./skryensya-vanilla.js";

      await initComponents();
      mountIcons(document, phosphorIcons);
${js ? `\n${js}\n` : ""}    </script>
  </body>
</html>`;
const playgroundPayload = encodeURIComponent(JSON.stringify({ label, vanilla: playgroundVanilla }));
const encodedPreviewScript = previewScript ? encodeURIComponent(previewScript) : "";
/** Unique id so the FOUC inline script can target this preview (Astro may dedupe identical scripts). */
const previewId = `sk-cp-${Math.random().toString(36).slice(2, 10)}`;
const frameDocument = buildPreviewFrameDocument({
  body: previewHtml,
  css,
  flush,
  scroll,
  measure,
  encodedScript: encodedPreviewScript,
});

/*
 * The header's glyphs, serialised at BUILD time instead of authored as `data-sk-icon` placeholders.
 * A placeholder is an empty box until `mountIcons` runs on the host document, and this chrome sits
 * above the fold on every component page: the controls appeared blank, then popped. `iconMarkup`
 * writes the same `<svg data-icon="…">` the runtime would, so the icon-set switch still finds and
 * swaps them: the site keeps the swap, and loses the wait.
 */
const moreIcon = iconMarkup("more");
/*
 * Screen presets. The name is a stable ROLE, not a device drawing, which is why the accessible
 * name spells out the actual viewport: `screen-tablet` tells you the class of screen, `768 × 1024`
 * tells you what you are about to see. Rendered as a single cycling toggle (like ThemeToggle), so
 * the hint IS the accessible name for whichever preset is current.
 *
 * `tooltipLabel` is a SEPARATE, visible hint on top of that: the literal device word (Desktop /
 * Tablet / Mobile), always in English regardless of page locale. It names the glyph for a sighted
 * reader who is not going to open a screen reader to learn what an icon-only button does; the
 * accessible name above already carries the full sentence for anyone who does.
 */
const screenOptions = [
  {
    value: "free",
    icon: iconMarkup("screen-desktop", { size: "sm" }),
    label: t("preview.screenFree"),
    hint: t("preview.screenFreeHint"),
    tooltipLabel: "Desktop",
  },
  {
    value: "tablet",
    icon: iconMarkup("screen-tablet", { size: "sm" }),
    label: t("preview.screenTablet"),
    hint: t("preview.screenTabletHint"),
    tooltipLabel: "Tablet",
  },
  {
    value: "mobile",
    icon: iconMarkup("screen-mobile", { size: "sm" }),
    label: t("preview.screenMobile"),
    hint: t("preview.screenMobileHint"),
    tooltipLabel: "Mobile",
  },
] as const;
const screenToggleLabels = Object.fromEntries(
  screenOptions.map((option) => [
    option.value,
    t("preview.screenToggleLabel", { name: label, hint: option.hint }),
  ]),
) as Record<(typeof screenOptions)[number]["value"], string>;
---

<div class="sk-component-preview" data-sk-component-preview data-width={width} id={previewId}>
  <header class="sk-component-preview__header">
    <span class="sk-component-preview__title">{label}</span>
    {note && <span class="sk-component-preview__note">{note}</span>}
    {/*
      * THREE separate, self-contained controls in a row — not one boxed toolbar holding all of
      * them. The binding toggle and the screen presets are each a real `Segmented` (see
      * /componentes/segmented): a boxed radiogroup with its own border and sliding indicator, so
      * each already reads as its own control. Wrapping them (plus the overflow menu) in a bordered
      * `sk-toolbar` on top of that made the whole cluster read as a single composite with three
      * unrelated questions crammed inside it. Plain inline-flex with a gap keeps each control's own
      * chrome as the only chrome it has.
      */}
    <div class="sk-component-preview__actions">
      {/*
        * FIRST: which binding you are reading is the choice a reader reaches for before anything
        * else here. `data-sk-component-preview-binding-tabs` and `data-sk-segmented` both live on
        * the same element: one node is the component-preview's own mount hook AND the Segmented the
        * site's global enhancer already knows how to run (indicator, aria-checked, keyboard). The
        * opt-in ComponentPreview enhancer only listens for the `sk-value-change` Segmented dispatches
        * on itself; it never re-paints the widget's own state.
        */}
      {
        hasBindingTabs && (
          <div
            class="sk-segmented"
            data-sk-segmented
            data-sk-component-preview-binding-tabs
            data-value="vanilla"
            role="radiogroup"
            aria-label={t("preview.bindingGroup", { name: label })}
          >
            <span class="sk-segmented__indicator" aria-hidden="true" />
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-sk-component-preview-binding-option
              data-value="vanilla"
              type="button"
              role="radio"
            >
              Vanilla
            </button>
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-sk-component-preview-binding-option
              data-value="react"
              type="button"
              role="radio"
            >
              React
            </button>
          </div>
        )
      }
      {/*
        * Each option's accessible name carries the full hint text for its preset
        * (`screenToggleLabels`), so a page with several previews still names its own component, not
        * a shared generic string; Segmented's own `label` slot only ever needed text, and an
        * icon-only radio still needs a name from somewhere.
        */}
      {
        screens && (
          <div
            class="sk-segmented"
            data-sk-segmented
            data-sk-component-preview-screen-tabs
            data-value="free"
            role="radiogroup"
            aria-label={t("preview.screenGroup", { name: label })}
          >
            <span class="sk-segmented__indicator" aria-hidden="true" />
            {/*
              * Each option is ALSO a Tooltip root (`data-sk-anchor`), wrapping the option button
              * (the trigger) and a positioner/content pair, so the literal device word shows up on
              * hover/focus next to the sentence-length `aria-label` above. The wrapper stays
              * `display: contents` (component-preview.css) so it never becomes a box of its own:
              * the button is what `.sk-segmented`'s indicator math measures, and the positioner is
              * `position: fixed` (patterns/anchored.css), so neither counts as a flex item — the
              * track's layout is exactly what it would be without the tooltip.
              */}
            {screenOptions.map((option) => (
              <span class="sk-tooltip" data-sk-anchor>
                <button
                  class="sk-segmented__option sk-interactive sk-anchor"
                  data-sk-segmented-option
                  data-sk-component-preview-screen-option
                  data-value={option.value}
                  data-icon-only
                  data-sk-anchor-trigger
                  type="button"
                  role="radio"
                  aria-label={screenToggleLabels[option.value]}
                >
                  <Fragment set:html={option.icon} />
                </button>
                <div class="sk-tooltip__positioner sk-anchored" data-sk-anchor-positioner>
                  <div class="sk-tooltip__content" data-sk-anchor-content role="tooltip">
                    {option.tooltipLabel}
                  </div>
                </div>
              </span>
            ))}
          </div>
        )
      }
      {/*
        * LAST, in an overflow menu: neither action here changes what the reader is looking at (one
        * hands off to another page, the other re-runs the same demo), so neither earns a permanent
        * seat next to the controls that do. Menu is the published contract for "actions behind a
        * trigger" (see /componentes/menu); the Playground link stays a real `<a>` (it navigates,
        * so it keeps middle-click/open-in-new-tab). `target="_blank"` opens it in a new tab by
        * default too: this preview is what the reader was looking at, and it should still be there
        * when the Playground tab closes. `rel="noopener"` only severs `window.opener`, not session
        * storage — the handoff below still clones into the new tab. Reload stays the plain command
        * it always was.
        */}
      <div class="sk-menu" data-sk-menu data-density="compact">
        <button
          class="sk-menu__trigger sk-button sk-interactive sk-anchor"
          data-sk-menu-trigger
          data-variant="neutral"
          data-size="sm"
          data-icon-only
          type="button"
          aria-label={t("preview.moreActions", { name: label })}
        >
          <Fragment set:html={moreIcon} />
        </button>
        <div class="sk-menu__positioner sk-anchored" data-sk-menu-positioner data-density="compact">
          <div class="sk-menu__content" data-sk-menu-content>
            <a
              class="sk-menu__item sk-interactive"
              data-sk-menu-item
              data-value="playground"
              data-sk-component-preview-playground
              href="/playground"
              target="_blank"
              rel="noopener"
            >
              <span class="sk-menu__item-label">{t("preview.openInPlayground")}</span>
            </a>
            <div
              class="sk-menu__item sk-interactive"
              data-sk-menu-item
              data-value="reload"
              data-sk-component-preview-reload
            >
              <span class="sk-menu__item-label">{t("preview.reloadAction")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  {/*
   * Inline srcdoc: an isolated document without a second page or URL.
   * No `scrolling` attribute: the legacy `no` wins over content CSS in Blink, and a stage the
   * reader shrank has to scroll. The frame runtime owns html/body overflow instead.
   */}
  <iframe
    class="sk-component-preview__stage"
    data-sk-component-preview-binding="vanilla"
    data-sk-component-preview-flush={flush ? "" : undefined}
    data-sk-component-preview-viewport={viewport === "auto" ? undefined : viewport}
    data-sk-component-preview-scroll={scroll ? "" : undefined}
    aria-busy="true"
    srcdoc={frameDocument}
    title={`Preview renderizado: ${label}`}
    loading="lazy"
    allow="clipboard-write"
  />
  {
    /*
     * The React binding's own stage. This element is only the SLOT HOST (`display: contents`): the
     * stage itself is a second srcdoc iframe rendered by the island, because the demo the page
     * authored is wrapped in `framed()` (see `react-demos/framed.tsx`). React keeps its reconciler
     * in this document and portals the painted DOM into that frame, so the React binding gets the
     * same isolation, theme sync, auto-fit and screen presets as the Vanilla one: the two bindings
     * are the same component seen twice, so they get the same box.
     */
    (tree || reactSlotHtml) && (
      <div
        class="sk-component-preview__react-stage"
        data-sk-component-preview-binding="react"
        hidden={hasBindingTabs ? true : undefined}
      >
        {tree ? (
          <TreeDemo
            tree={tree}
            measure={measure}
            frameOptions={{ flush, scroll, viewport, script: previewScript }}
            client:load
          />
        ) : (
          <Fragment set:html={reactSlotHtml} />
        )}
      </div>
    )
  }
  {/* Drag the stage's bottom edge for more or less height; doble clic vuelve al alto del contenido. */}
  <div
    class="sk-component-preview__resizer"
    data-sk-component-preview-resizer
    role="separator"
    aria-orientation="horizontal"
    aria-label={`Ajustar el alto del preview: ${label}`}
    title="Arrastra para ajustar el alto · doble clic para restablecer"
    tabindex="0"
  />
  <div class="sk-component-preview__loading">
    <span
      class="sk-loader"
      data-size="lg"
      role="status"
      aria-label={`Cargando preview: ${label}`}
    />
  </div>

  {
    vanillaCode && (
      <div class="sk-component-preview__binding" data-sk-component-preview-binding="vanilla">
        {
          hasSourceTabs ? (
            <div
              class="sk-tabs sk-component-preview__source-tabs"
              data-sk-tabs
              data-sk-component-preview-source-tabs
              data-sk-density-scope
              data-value="html"
              style="--sk-density-factor: 0.72"
            >
              <div class="sk-tabs__list" data-sk-tabs-list aria-label="Fuente vanilla">
                <button
                  class="sk-tabs__trigger sk-interactive"
                  data-sk-tabs-trigger
                  data-value="html"
                  type="button"
                >
                  HTML
                </button>
                {
                  css && (
                    <button
                      class="sk-tabs__trigger sk-interactive"
                      data-sk-tabs-trigger
                      data-value="css"
                      type="button"
                    >
                      CSS
                    </button>
                  )
                }
                {
                  js && (
                    <button
                      class="sk-tabs__trigger sk-interactive"
                      data-sk-tabs-trigger
                      data-value="js"
                      type="button"
                    >
                      JS
                    </button>
                  )
                }
              </div>
              <div
                class="sk-tabs__content sk-component-preview__code"
                data-sk-tabs-content
                data-value="html"
                data-sk-component-preview-source="html"
              >
                <CodeBlock code={vanillaCode} full={codeFull} lang={lang} />
              </div>
              {
                css && (
                  <div
                    class="sk-tabs__content sk-component-preview__code"
                    data-sk-tabs-content
                    data-value="css"
                    data-sk-component-preview-source="css"
                  >
                    <CodeBlock code={css} lang="css" />
                  </div>
                )
              }
              {
                js && (
                  <div
                    class="sk-tabs__content sk-component-preview__code"
                    data-sk-tabs-content
                    data-value="js"
                    data-sk-component-preview-source="js"
                  >
                    <CodeBlock code={js} lang="ts" />
                  </div>
                )
              }
            </div>
          ) : (
            <div class="sk-component-preview__code" data-sk-component-preview-source="html">
              <CodeBlock code={vanillaCode} full={codeFull} lang={lang} />
            </div>
          )
        }
      </div>
    )
  }

  {
    (treeReact ?? react) && (
      <div
        class="sk-component-preview__binding"
        data-sk-component-preview-binding="react"
        hidden={hasBindingTabs ? true : undefined}
      >
        <div class="sk-component-preview__code">
          <CodeBlock code={(treeReact ?? react)!} lang="tsx" />
        </div>
      </div>
    )
  }
</div>
{
  /*
   * Sync tabs, panels and the screen preset to the document prefs before deferred enhancers mount.
   * Head FOUC already wrote both attributes on <html>; this keeps the binding buttons from
   * flipping pressed state Vanilla → React on load, and stops a persisted preset from painting
   * full-width first and snapping to phone size once the enhancer arrives.
   */
  (hasBindingTabs || screens || playgroundPayload) && (
    <script is:inline define:vars={{ previewId, hasBindingTabs, screens, playgroundPayload }}>
      (function () {
        var d = document.documentElement;
        var root = document.getElementById(previewId);
        if (!root) return;

        var playgroundLink = root.querySelector("[data-sk-component-preview-playground]");
        if (playgroundLink) {
          playgroundLink.addEventListener("click", function () {
            sessionStorage.setItem("skryensya-playground-handoff", playgroundPayload);
          });
        }
        if (hasBindingTabs) {
          var pref = d.getAttribute("data-sk-component-preview-pref") || "vanilla";
          var tabs = root.querySelector("[data-sk-component-preview-binding-tabs]");
          if (tabs) {
            tabs.setAttribute("data-value", pref);
            tabs.querySelectorAll("[data-sk-component-preview-binding-option]").forEach(function (option) {
              option.setAttribute("aria-checked", option.getAttribute("data-value") === pref ? "true" : "false");
            });
          }
          root.querySelectorAll("[data-sk-component-preview-binding]").forEach(function (panel) {
            var name = panel.getAttribute("data-sk-component-preview-binding");
            if (name === "vanilla" || name === "react") panel.hidden = name !== pref;
          });
        }

        if (screens) {
          var screen = d.getAttribute("data-sk-component-preview-screen-pref");
          if (screen !== "tablet" && screen !== "mobile") screen = "free";
          var screenTabs = root.querySelector("[data-sk-component-preview-screen-tabs]");
          if (screenTabs) {
            screenTabs.setAttribute("data-value", screen);
            screenTabs.querySelectorAll("[data-sk-component-preview-screen-option]").forEach(function (option) {
              option.setAttribute("aria-checked", option.getAttribute("data-value") === screen ? "true" : "false");
            });
          }
          // Both bindings are iframe stages, and the preset is one control above both of them.
          // `free` is the absence of the attribute, so nothing is written for it.
          if (screen !== "free") {
            root.querySelectorAll(".sk-component-preview__stage").forEach(function (stage) {
              stage.setAttribute("data-sk-component-preview-screen", screen);
            });
          }
        }
      })();
    </script>
  )
}

<script>
  import { mountComponentPreview } from "@skryensya/vanilla/component-preview";
  import frameRuntimeUrl from "../scripts/component-preview-frame.ts?worker&url";

  if (!document.head.querySelector("[data-sk-component-preview-runtime-preload]")) {
    const preload = document.createElement("link");
    preload.rel = "modulepreload";
    preload.href = frameRuntimeUrl;
    preload.fetchPriority = "high";
    preload.setAttribute("data-sk-component-preview-runtime-preload", "");
    document.head.append(preload);
  }

  mountComponentPreview();
</script>
