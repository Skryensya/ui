---
/*
 * A demo and its source, as one titled card, with one live stage per binding.
 *
 * The Vanilla demo renders in an inline `srcdoc` iframe: no route or external document, but its own
 * DOM, viewport and top layer. The frame runtime copies the page styles, mounts authored `data-sk-*`
 * roots inside that realm and keeps the parent theme dimensions in sync.
 *
 * The React demo, when the caller provides a `react` slot, renders as a real `@astrojs/react`
 * island (`client:visible`) sitting next to the iframe in the parent document: an actual
 * `@skryensya/react` component, not a source string. The `react` prop stays the source shown
 * below it; a page may supply either alone.
 *
 * Binding tabs (header): Vanilla | React as a Segmented control, toggling which stage is visible.
 * Preference is shared across every preview on the page (`data-sk-component-preview-pref` on
 * `<html>`, persisted in docs).
 * Source tabs (below the stage, under Vanilla only): HTML plus optional CSS and TS. They sit
 * under Vanilla, never beside React. The TS is authored in `demos/scripts/*.ts` and type-stripped
 * on its way into the frame: shown as written, run as JavaScript.
 */
import CodeBlock from "./CodeBlock.astro";
import { codePreviewAttrs, codePreviewParts } from "@skryensya/core/code-preview";
import { emitMarkup, emitReactSource } from "@skryensya/ai-compiler/emit";
import type { UsageTree } from "@skryensya/ai-compiler/usage-tree";
import { TreeDemo } from "./react-demos/tree";
import { iconMarkup } from "../icons";
import "@skryensya/core/components/component-preview.css";
import "@skryensya/core/components/loader.css";
import "@skryensya/core/components/tabs.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/tooltip.css";
import "@skryensya/core/components/menu.css";
import "@skryensya/core/patterns/vaul.css";
import "@skryensya/core/components/drawer.css";
import "@skryensya/core/patterns/scrollbar.css";
import { buildPreviewFrameDocument } from "../lib/preview-frame";
import { exampleComponentName } from "../lib/example-component-name";
import { compileDemoScript } from "../lib/demo-script";
import { getLocale, useTranslations } from "../i18n";
import { previewHeight } from "../lib/preview-heights";
import { slugify } from "../lib/document-index";

type CodeLanguage = "bash" | "css" | "html" | "ts" | "tsx";

interface Props {
  /*
   * A USAGE TREE, and the preferred way to write a demo.
   *
   * One authoring, both stages: the markup, the TSX and the live React island are all EMITTED from
   * it, so a page cannot show a snippet that differs from what it renders, which is the whole
   * failure mode hand-written examples have. The same tree shape the MCP validates and the gates
   * measure; when a tree is given, `html` and `react` are ignored rather than merged, because two
   * sources of truth is exactly what this replaces.
   */
  tree?: UsageTree;
  /** The authored markup. Renders inside the srcdoc frame and is the HTML/Vanilla source. */
  html?: string;
  /**
   * App JavaScript beyond `data-sk-*` enhancers (composition, paging, etc.).
   * Shown as a JS tab under Vanilla, next to HTML, never as a peer of React.
   */
  js?: string;
  /** App CSS shown beside HTML under Vanilla. The live frame inherits it from the page stylesheet. */
  css?: string;
  /** The React source. Shown under the React binding's stage. Pair with the `react` slot for a live demo. */
  react?: string;
  /** Explicit Vanilla/HTML source when the live markup isn't what you want to teach. */
  code?: string;
  /**
   * Complete Vanilla/HTML source. With `code` as the condensed view, CodeBlock toggles
   * Condensed | Full. Copy always uses this string.
   */
  codeFull?: string;
  /** App-only JavaScript executed inside the frame after Vanilla enhancers mount; never displayed. */
  previewScript?: string;
  label?: string;
  note?: string;
  lang?: CodeLanguage;
  /**
   * Reserve stage height when the demo paints outside flow (menus, dialogs, drawers, toasts).
   * - `menu`: open listboxes / popovers (~18rem)
   * - `overlay`: dialogs, drawers, toasts (~24rem)
   * - `menu-deep`: a menu that opens three or more levels at once (~30rem)
   */
  viewport?: "auto" | "menu" | "overlay" | "menu-deep";
  /**
   * Floor the stage at a CSS length, for a specimen that is simply short on its own (a navbar strip,
   * say) and reads cramped at its natural content height. Unlike `viewport`'s presets, this reserves
   * no room for anything painting outside flow. It just keeps the stage from hugging the content.
   */
  minHeight?: string;
  /** Give the stage no padding: some components ARE a layout and must reach the edges. */
  flush?: boolean;
  /**
   * Allow scrolling inside the stage. Default is off: the iframe grows to the content height so the
   * demo is fully visible without an inner scrollbar.
   */
  scroll?: boolean;
  /**
   * Cap the specimen's width on the STAGE only, as a CSS length (`measure="34rem"`).
   *
   * For components that only read correctly at a realistic column: a settings List across the full
   * stage looks like nothing anyone ships. The cap never reaches the snippet, because that width is
   * the consumer's layout, not the component's. This is what lets such a demo be a single `tree`
   * instead of a wrapper `<div>` in the slot plus a separate `code` string.
   */
  measure?: string;
  /**
   * Offer the screen presets (Libre | Tablet | Móvil) in the header.
   *
   * ON by default, on every preview: "does this hold up on a phone" is a question a reader can ask
   * of any component, not only of the ones whose layout is obviously the subject: a button's label
   * can wrap, a table can overflow, a dialog can outgrow the viewport. Leaving it to the author of
   * each page to remember would mean the answer is available on the demos someone already thought
   * about, which are exactly the ones that were already fine.
   *
   * Pass `screens={false}` where the presets would mislead rather than inform.
   */
  screens?: boolean;
  /**
   * Offer the zoomed-out desktop preset (1440 px, fitted to the docs column).
   *
   * OFF by default. Desktop / Tablet / Mobile are a question any component can answer; this one
   * only earns its keep on layouts that actually change past the docs column. Navbar, Layout Grid,
   * and the same class of wide chrome. Fullscreen never shows it: that page already IS the
   * viewport this preset pretends to be.
   */
  zoomedDesktop?: boolean;
  /**
   * Give this preview's OWN screen preset, decoupled from the page's shared one.
   *
   * The shared preset (see `screens` above) answers "how does this hold up on a phone" for the
   * PAGE, and every preview follows it on purpose. A pattern whose whole point only reads at phone
   * width (Vaul: [decision 9](/decisions/0009-the-vaul-is-a-pattern-and-drag-is-the-only-part-that-costs-js))
   * still needs to open on `mobile`, but doing that through the shared preset would make THIS demo's
   * opinion the first-time seed for every other preview on the site, the moment a reader lands here
   * before any other component page. `"local"` opts this preview's toggle out of `documentScreen`
   * entirely: its own `Segmented` still switches Libre/Tablet/Móvil like any other, it just never
   * reads or writes the persisted/shared preference to do it.
   */
  screenScope?: "local";
  /** This preview's own starting preset when `screenScope="local"`. Ignored otherwise. */
  defaultScreen?: "free" | "tablet" | "mobile";
  /**
   * Skip the source panels under the stage. Marketing surfaces (the landing page) want the live
   * specimen without the teaching HTML/TSX that every component page pairs with it.
   */
  hideSource?: boolean;
  /**
   * Named span on the page's `.sk-layout-grid` (`packages/core/css/patterns/layout.css`). Each tab
   * panel is its own layout grid, so a preview sits at `content` measure by default and only reaches
   * for `breakout` (or narrower) when the demo itself needs the room. A settings List does, a Badge
   * does not. Omit to inherit the panel's default.
   */
  width?: "narrow" | "content" | "breakout" | "full-width";
}

const {
  tree,
  html,
  js,
  css,
  react,
  code,
  codeFull,
  previewScript,
  label = "HTML",
  note,
  lang = "html",
  flush = false,
  viewport = "auto",
  minHeight,
  scroll = false,
  measure,
  screens = true,
  zoomedDesktop = false,
  screenScope,
  defaultScreen = "mobile",
  hideSource = false,
  width,
} = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/*
 * Both sources from the one tree. Emitted at BUILD time: the compiler is data in, strings out, so
 * there is nothing to ship to the reader: the page carries the same bytes it would have carried if
 * someone had typed them, minus the chance that they typed something else.
 */
const treeHtml = tree ? emitMarkup(tree, { fillDefaults: false }) : undefined;
/*
 * THE STAGE GETS THE DEFAULTS FILLED IN; THE SNIPPET DOES NOT. Same tree, two jobs.
 *
 * `fillDefaults: false` is what keeps the source panel honest: it shows what an author WRITES, not
 * every attribute the contract would have serialized. That is right for a snippet and wrong for a
 * render, because the React stage beside it is not authored-only  -  a React component writes its
 * own prop defaults into the DOM unconditionally. Measured on `/components/hero`: `Hero` defaults
 * to `padding="xl"` and `surface="surface"` in React, while a bare `.sk-hero` is transparent with
 * no padding in CSS, so the video-demo card rendered a padded surface on one stage and an unpadded
 * one on the other, from one tree.
 *
 * Splitting them makes the two STAGES the same render and leaves both SNIPPETS at what a person
 * types, which is the symmetry the card actually claims. It does not paper over the underlying
 * inconsistency (a contract whose declared default is not what its bare class does) - that is a
 * decision for the CSS or the contract to settle, and it is worth settling.
 */
const treeStageHtml = tree ? emitMarkup(tree) : undefined;
/*
 * React arrives as up to TWO files: the component, and the module its collections were moved to.
 * `data` is what the second tab shows. A `<Menu>` whose items were serialized into the tag buried
 * the composition the page is about under a wall of entries, so the entries live where a real
 * project would have put them and the component file is left saying only how it is composed.
 *
 * The component is named after the PAGE, not after the tree's root: the Placeholder demos are
 * composed inside a Box, and `BoxExample` on the Placeholder page names the wrapper instead of the
 * subject. The route's last segment is the subject, and it is the same word in both locales.
 */
const reactSource = tree
  ? emitReactSource(tree, { component: exampleComponentName(Astro.url) })
  : undefined;
const treeReact = reactSource?.component;
const reactData = reactSource?.data;
/*
 * The tree itself, pretty-printed: a "View contract" entry in the "…" overflow menu opens it in a
 * Drawer (`Vaul.drawer`, patterns/vaul.css), never a third tab or binding among the Vanilla/React
 * source panels below. It has no live stage (a usage tree renders nothing) and no per-binding home
 * (both were emitted from it equally), so it sits with the card's other secondary actions
 * (Reload, Fullscreen) instead of competing for space with either source panel. Copyable as-is into
 * `validate_ui` (see the MCP server instructions): the same shape, not a description of it.
 */
const treeJson = tree ? JSON.stringify(tree, null, 2) : undefined;

const vanillaCode = code ?? treeHtml ?? html;
/*
 * The `react` slot carries the LIVE demo (an actual `@skryensya/react` component, `client:visible`);
 * the `react` string prop stays the source shown under it. Either alone still counts as "there is a
 * React binding": a page can render a live demo before it has bothered to also show its source.
 */
const reactSlotHtml = Astro.slots.has("react") ? await Astro.slots.render("react") : undefined;
const hasReact = Boolean(tree) || Boolean(treeReact ?? react) || Boolean(reactSlotHtml);
const hasBindingTabs = Boolean(vanillaCode && hasReact);
const hasSourceTabs = Boolean(vanillaCode && (js || css));
const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : undefined;
const previewHtml = treeStageHtml ?? slotHtml ?? html ?? "";
/*
 * WHERE THIS DEMO'S MARKUP CAME FROM, as one word, in the same precedence `previewHtml` resolves.
 *
 * In the DOM because it cannot be derived from it: the emitted markup looks the same either way, so
 * "is this preview emitted from a usage tree or is it bespoke markup" was only answerable by opening
 * the page source and working out which prop had been passed. `@skryensya/devtools`' Preview metrics
 * check reads this attribute; nothing else in the app depends on it, and it costs one word per card.
 */
const previewSource = treeHtml ? "tree" : slotHtml ? "slot" : html ? "html" : "react";
/*
 * Authored in TypeScript (`demos/scripts/*.ts`, type-checked with the rest of the app) and run as
 * JavaScript, because the live preview frame is a browser with no compiler in front of it. The
 * `js`/`previewScript` props are the SOURCE; every execution path strips it first, and the tab below
 * shows what was written.
 */
const compiledPreviewScript = previewScript ? compileDemoScript(previewScript) : undefined;
const encodedPreviewScript = compiledPreviewScript
  ? encodeURIComponent(compiledPreviewScript)
  : "";
/**
 * A STABLE id, not a random one: the FOUC inline script needs any unique target, and
 * "Ver en la documentación" hashes back to it. `/f/{page}/{n}` finds the card by counting
 * `[data-sk-component-preview]` in DOM order at click time (`openComponentPreviewFullscreen`), not
 * by this id and not by any number rendered into the card.
 *
 * `Astro.locals` resets once per page render (unlike a module-level counter, which would keep
 * counting across every OTHER page built in the same process): slugging `label` and deduping
 * against the other previews already rendered on THIS page is enough to keep every id on the page
 * unique, without depending on build order or on labels being unique to begin with.
 */
const locals = Astro.locals as {
  componentPreviewIds?: Set<string>;
};
const previewId = ((): string => {
  const used = locals.componentPreviewIds ?? new Set<string>();
  locals.componentPreviewIds = used;
  const base = slugify(label);
  let candidate = base;
  let suffix = 2;
  while (used.has(candidate)) {
    candidate = `${base}-${suffix}`;
    suffix += 1;
  }
  used.add(candidate);
  return candidate;
})();
const hasVanillaStage = previewHtml.length > 0;
const frameDocument = hasVanillaStage
  ? buildPreviewFrameDocument({
      body: previewHtml,
      css,
      flush,
      scroll,
      measure,
      encodedScript: encodedPreviewScript,
    })
  : undefined;

/*
 * The header's glyphs, serialised at BUILD time instead of authored as `data-sk-icon` placeholders.
 * A placeholder is an empty box until `mountIcons` runs on the host document, and this chrome sits
 * above the fold on every component page: the controls appeared blank, then popped. `iconMarkup`
 * writes the same `<svg data-icon="…">` the runtime would, so the icon-set switch still finds and
 * swaps them: the site keeps the swap, and loses the wait.
 */
const moreIcon = iconMarkup("more");
const reloadIcon = iconMarkup("refresh", { size: "sm" });
/*
 * The shared source-toggle's own chevron, same glyph and size `CodeBlock`'s per-panel disclosure
 * draws (`chevron-down`, sm): one control standing in for however many independent panels a
 * source-tabs group holds, so it borrows the same visual vocabulary a reader already knows from
 * every OTHER collapsible code block on the site.
 */
const sourceToggleIcon = iconMarkup("chevron-down", { size: "sm" });
/*
 * `external-link`, a STABLE role, where this used to draw `screen-fullscreen` as geometry of its own.
 * The glyph was describing the wrong action: "Ver en pantalla completa" does not put this page into
 * fullscreen, it calls `window.open(…, "_blank")` (`openComponentPreviewFullscreen`) and launches the
 * demo alone in a new tab. Corner brackets say "expand in place"; a launch arrow says "this leaves
 * here", which is what actually happens. Being a stable role also puts it back in reach of the site's
 * icon-set switch, which skipped the bespoke one (`iconDataMarkup`'s own doc: `applyIconSet` ignores
 * unknown `data-icon` keys), so this control was the one glyph in the header that never changed set.
 */
const launchIcon = iconMarkup("external-link", { size: "sm" });
const contractIcon = iconMarkup("file", { size: "sm" });
/*
 * Screen presets. The name is a stable ROLE, not a device drawing, which is why the accessible
 * name spells out the actual viewport: `screen-tablet` tells you the class of screen, `768 × 1024`
 * tells you what you are about to see. Rendered as a single cycling toggle (like ThemeToggle), so
 * the hint IS the accessible name for whichever preset is current.
 *
 * `tooltipLabel` is a SEPARATE, visible hint on top of that: the English name of the preset
 * (Desktop zoomed out / Desktop / Tablet / Mobile), regardless of page locale. It names the glyph
 * for a sighted reader who is not going to open a screen reader to learn what an icon-only button
 * does; the accessible name above already carries the full sentence for anyone who does.
 */
const screenOptions = [
  ...(zoomedDesktop
    ? [
        {
          value: "xl" as const,
          icon: iconMarkup("zoom-out", { size: "sm" }),
          label: t("preview.screenXl"),
          hint: t("preview.screenXlHint"),
          tooltipLabel: "Desktop zoomed out",
        },
      ]
    : []),
  {
    value: "free" as const,
    icon: iconMarkup("screen-desktop", { size: "sm" }),
    label: t("preview.screenFree"),
    hint: t("preview.screenFreeHint"),
    tooltipLabel: "Desktop",
  },
  {
    value: "tablet" as const,
    icon: iconMarkup("screen-tablet", { size: "sm" }),
    label: t("preview.screenTablet"),
    hint: t("preview.screenTabletHint"),
    tooltipLabel: "Tablet",
  },
  {
    value: "mobile" as const,
    icon: iconMarkup("screen-mobile", { size: "sm" }),
    label: t("preview.screenMobile"),
    hint: t("preview.screenMobileHint"),
    tooltipLabel: "Mobile",
  },
];
const screenToggleLabels = Object.fromEntries(
  screenOptions.map((option) => [
    option.value,
    t("preview.screenToggleLabel", { name: label, hint: option.hint }),
  ]),
) as Record<(typeof screenOptions)[number]["value"], string>;

/*
 * THE STAGE'S HEIGHT, RESERVED BEFORE THE FRAME CAN REPORT IT.
 *
 * An iframe has no content height, so `fitFrame` measures the document inside and writes the number
 * back AFTER first paint. Until then the stage stands at one global 12rem floor, and every preview
 * that is not 12rem tall then snaps: -104px on this page's own stacked-avatar group, measured. The
 * settled number is observable but not computable, so it is measured once into
 * `artifacts/preview-heights.json` and reserved here, which makes the loading box and the settled
 * box the same box.
 *
 * A SECOND CUSTOM PROPERTY, not the `minHeight` one it sits beside, because the two mean different
 * things and only one of them survives the frame reporting. `minHeight` is an authored FLOOR for a
 * specimen that reads cramped at its natural height, and it is meant to keep applying afterwards
 * (see the `[data-sk-component-preview-min-height]` rules in component-preview.css). This is a
 * placeholder that exists only until the real height arrives, and it must get out of the way then,
 * or a measurement that is a few pixels generous would leave dead space under every demo forever.
 * Folding both into one property would force one of those two behaviours onto the other.
 */
const reservedHeight = previewHeight(Astro.url.pathname, previewId);
const stageStyle =
  [
    minHeight ? `--sk-component-preview-stage-min-block-size: ${minHeight}` : null,
    reservedHeight === null ? null : `--sk-component-preview-stage-reserved-block-size: ${reservedHeight}px`,
  ]
    .filter(Boolean)
    .join("; ") || undefined;
---

<div
  class="sk-component-preview"
  data-sk-component-preview
  data-width={width}
  data-sk-component-preview-screen-local={screenScope === "local" ? "" : undefined}
  data-sk-preview-source={previewSource}
  id={previewId}
  style={stageStyle}
>
  <header class="sk-component-preview__header">
    {
      /*
       * THE LABEL ALONE. The card used to open with its 1-based position on the page, which was only
       * ever an implementation detail leaking into the chrome: nothing reads it (see the `previewN`
       * note that used to sit above. Both the fullscreen opener and `/f/{page}/{n}` count DOM order
       * at click time, never a rendered number), and a reader gets nothing from "this is the third
       * demo" that the demo's own name does not already tell them better.
       *
       * It also poisoned the fullscreen page's title: `/f/…` sets `document.title` from this
       * element's `textContent` (`pages/f/[...path].astro`), so the tab read "1Texto" rather than
       * "Texto". Dropping the span fixes the header and that title in one move, because they were
       * always the same string.
       */
    }
    <span class="sk-component-preview__title">{label}</span>
    {note && <span class="sk-component-preview__note">{note}</span>}
    {/*
      * THREE separate, self-contained controls in a row: not one boxed toolbar holding all of
      * them. The binding toggle and the screen presets are each a real `Segmented` (see
      * /componentes/segmented): a boxed radiogroup with its own border and sliding indicator, so
      * each already reads as its own control. Wrapping them (plus the overflow menu) in a bordered
      * `sk-toolbar` on top of that made the whole cluster read as a single composite with three
      * unrelated questions crammed inside it. Plain inline-flex with a gap keeps each control's own
      * chrome as the only chrome it has.
      */}
    <div class="sk-component-preview__actions">
      {/*
        * FIRST: which binding you are reading is the choice a reader reaches for before anything
        * else here. `data-sk-component-preview-binding-tabs` and `data-sk-segmented` both live on
        * the same element: one node is the component-preview's own mount hook AND the Segmented the
        * site's global enhancer already knows how to run (indicator, aria-checked, keyboard). The
        * opt-in ComponentPreview enhancer only listens for the `sk-value-change` Segmented dispatches
        * on itself; it never re-paints the widget's own state.
        */}
      {
        hasBindingTabs && (
          <div
            class="sk-segmented"
            data-sk-segmented
            data-sk-component-preview-binding-tabs
            data-value="vanilla"
            role="radiogroup"
            aria-label={t("preview.bindingGroup", { name: label })}
          >
            <span class="sk-segmented__indicator" aria-hidden="true" />
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-sk-component-preview-binding-option
              data-value="vanilla"
              type="button"
              role="radio"
            >
              Vanilla
            </button>
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-sk-component-preview-binding-option
              data-value="react"
              type="button"
              role="radio"
            >
              React
            </button>
          </div>
        )
      }
      {/*
        * Each option's accessible name carries the full hint text for its preset
        * (`screenToggleLabels`), so a page with several previews still names its own component, not
        * a shared generic string; Segmented's own `label` slot only ever needed text, and an
        * icon-only radio still needs a name from somewhere.
        */}
      {
        screens && (
          <div
            class="sk-segmented"
            data-sk-segmented
            data-sk-component-preview-screen-tabs
            data-value={screenScope === "local" ? defaultScreen : "free"}
            role="radiogroup"
            aria-label={t("preview.screenGroup", { name: label })}
          >
            <span class="sk-segmented__indicator" aria-hidden="true" />
            {/*
              * Each option is ALSO a Tooltip root (`data-sk-anchor`), wrapping the option button
              * (the trigger) and a positioner/content pair, so the literal device word shows up on
              * hover/focus next to the sentence-length `aria-label` above. The wrapper stays
              * `display: contents` (component-preview.css) so it never becomes a box of its own:
              * the button is what `.sk-segmented`'s indicator math measures, and the positioner is
              * `position: fixed` (patterns/anchored.css), so neither counts as a flex item. The
              * track's layout is exactly what it would be without the tooltip.
              */}
            {screenOptions.map((option) => (
              <span class="sk-tooltip" data-sk-anchor>
                <button
                  class="sk-segmented__option sk-interactive sk-anchor"
                  data-sk-segmented-option
                  data-sk-component-preview-screen-option
                  data-value={option.value}
                  data-icon-only
                  data-sk-anchor-trigger
                  type="button"
                  role="radio"
                  aria-label={screenToggleLabels[option.value]}
                >
                  <Fragment set:html={option.icon} />
                </button>
                <div class="sk-tooltip__positioner sk-anchored" data-sk-anchor-positioner>
                  <div class="sk-tooltip__content" data-sk-anchor-content role="tooltip">
                    {option.tooltipLabel}
                  </div>
                </div>
              </span>
            ))}
          </div>
        )
      }
      <div class="sk-menu" data-sk-menu data-density="compact">
        <button
          class="sk-menu__trigger sk-button sk-interactive sk-anchor"
          data-sk-menu-trigger
          data-variant="solid"
          data-size="sm"
          data-icon-only
          type="button"
          aria-label={t("preview.moreActions", { name: label })}
        >
          <Fragment set:html={moreIcon} />
        </button>
        <div class="sk-menu__positioner sk-anchored" data-sk-menu-positioner data-density="compact">
          <div class="sk-menu__content" data-sk-menu-content>
            {/*
              * THE GLYPH TRAILS THE LABEL, in the item's own second grid column
              * (`.sk-menu__item` is `grid-template-columns: minmax(0, 1fr) auto`, menu.css), rather
              * than sitting inside the label ahead of the text. Leading icons made the two rows read
              * as a palette of tools; trailing ones let both labels start on the same left edge and
              * put the glyph where a menu conventionally answers "and where does this take me".
              *
              * NOT `menuParts.itemIndicator`, which is the cell this would otherwise belong in: that
              * part is the CHECK, `visibility: hidden` unless `[data-state="checked"]` or unless the
              * item is a `<button>` submenu trigger (menu.css). These items are `<div>` commands, so
              * borrowing it would render an invisible icon. A plain chrome span in the same cell is
              * the honest way to sit there without claiming a state this item does not have.
              */}
            <div
              class="sk-menu__item sk-interactive"
              data-sk-menu-item
              data-value="reload"
              data-sk-component-preview-reload
            >
              <span class="sk-menu__item-label">{t("preview.reloadAction")}</span>
              <span class="sk-component-preview__menu-icon"><Fragment set:html={reloadIcon} /></span>
            </div>
            <div
              class="sk-menu__item sk-interactive"
              data-sk-menu-item
              data-value="fullscreen"
              data-sk-component-preview-fullscreen
            >
              <span class="sk-menu__item-label">{t("preview.fullscreenAction")}</span>
              <span class="sk-component-preview__menu-icon"><Fragment set:html={launchIcon} /></span>
            </div>
            {
              /*
               * `data-sk-vaul-open` is Vaul's OWN trigger attribute (`packages/vanilla/src/
               * components/vaul.ts`, `mountVaul`), not a ComponentPreview one: `initComponents()`
               * already runs it site-wide (see the docs' own mobile nav drawer, `Base.astro`), so
               * this item needs no click handler of its own, unlike Reload/Fullscreen above.
               */
              treeJson && (
                <div
                  class="sk-menu__item sk-interactive"
                  data-sk-menu-item
                  data-value="contract"
                  data-sk-vaul-open={`${previewId}-contract`}
                >
                  <span class="sk-menu__item-label">{t("preview.viewContract")}</span>
                  <span class="sk-component-preview__menu-icon">
                    <Fragment set:html={contractIcon} />
                  </span>
                </div>
              )
            }
            {/*
              * No "Ver en la documentación" item here: on the docs page itself, a link back to the
              * docs page would just point at the page a reader is already reading. It is added
              * client-side ONLY by `/f/{page}/{n}` (`apps/docs/src/pages/f/[...path].astro`),
              * which is the one context that has left the docs page behind and actually needs a way
              * back to it.
              */
            }
          </div>
        </div>
      </div>
    </div>
  </header>

  {
    hasVanillaStage && (
      /*
       * `data-sk-component-preview-doc` holds the document, `srcdoc` starts EMPTY: `loading="lazy"`
       * does nothing for `srcdoc` content (it is already inline HTML, so the parser starts fetching
       * whatever it references - the frame runtime, its module graph - the moment it is parsed,
       * on every preview on the page, at once, regardless of scroll position; that WAS this
       * attribute's job here, and it never worked). `connectStageLifecycle`
       * (`@skryensya/vanilla/component-preview`) promotes it to `srcdoc` the same way it already
       * restores a released one: through the shared `IntersectionObserver`, once the stage is near
       * view. `/f/{page}/{n}` (the fullscreen route) reads the `-doc` attribute straight off this
       * page's own static HTML, never a live DOM, so a preview nobody has scrolled to yet still
       * opens correctly there.
       */
      <iframe
        class="sk-component-preview__stage"
        data-sk-component-preview-binding="vanilla"
        data-sk-component-preview-flush={flush ? "" : undefined}
        data-sk-component-preview-viewport={viewport === "auto" ? undefined : viewport}
        data-sk-component-preview-min-height={minHeight ? "" : undefined}
        data-sk-component-preview-scroll={scroll ? "" : undefined}
        aria-busy="true"
        data-sk-component-preview-doc={frameDocument}
        title={`Preview renderizado: ${label}`}
        allow="clipboard-write"
      />
    )
  }
  {
    /*
     * The React binding's own stage. This element is only the SLOT HOST (`display: contents`): the
     * stage itself is a second srcdoc iframe rendered by the island, because the demo the page
     * authored is wrapped in `framed()` (see `react-demos/framed.tsx`). React keeps its reconciler
     * in this document and portals the painted DOM into that frame, so the React binding gets the
     * same isolation, theme sync, auto-fit and screen presets as the Vanilla one: the two bindings
     * are the same component seen twice, so they get the same box.
     */
    (tree || reactSlotHtml) && (
      <div
        class="sk-component-preview__react-stage"
        data-sk-component-preview-binding="react"
        hidden={hasBindingTabs ? true : undefined}
      >
        {tree ? (
          <TreeDemo
            tree={tree}
            measure={measure}
            frameOptions={{
              flush,
              scroll,
              viewport,
              minHeight,
              css,
              /*
               * COMPILED, not the authored source. This used to pass `previewScript` straight
               * through, and the React stage was the only path that ran a demo's TypeScript at a
               * browser: `framed` runs inside the island, where there is no compiler to reach for,
               * so it encodes whatever it is handed. Any demo whose script declared a type threw
               * `SyntaxError` out of `runAuthoredScript`, took the frame's whole init down with it,
               * and left that preview's screen presets dead - the control is in this document and
               * paints fine, but the stage it points at never finished booting.
               *
               * It went unseen because it needs BOTH a React binding and an app-level script, and
               * comment-thread is the first preview to have both. The Vanilla stage was always
               * right (`encodedScript` above); this makes the two agree.
               */
              script: compiledPreviewScript,
            }}
            client:visible
          />
        ) : (
          <Fragment set:html={reactSlotHtml} />
        )}
      </div>
    )
  }
  {/* Drag the stage's bottom edge for more or less height; doble clic vuelve al alto del contenido. */}
  <div
    class="sk-component-preview__resizer"
    data-sk-component-preview-resizer
    role="separator"
    aria-orientation="horizontal"
    aria-label={`Ajustar el alto del preview: ${label}`}
    title="Arrastra para ajustar el alto · doble clic para restablecer"
    tabindex="0"
  />
  <div class="sk-component-preview__loading">
    <span
      class="sk-loader"
      data-size="lg"
      role="status"
      aria-label={`Cargando preview: ${label}`}
    />
  </div>


  {
    vanillaCode && !hideSource && (
      <div class="sk-component-preview__binding" data-sk-component-preview-binding="vanilla">
        {
          hasSourceTabs ? (
            <div
              class="sk-tabs sk-component-preview__source-tabs"
              data-sk-tabs
              data-sk-component-preview-source-tabs
              data-size="sm"
              data-value="html"
            >
              {/*
                * ONE toggle for HTML/CSS/TS together, not three: each panel's own disclosure is
                * hidden (component-preview.css), and this button forwards its click to whichever
                * of them are collapsible in one pass (`connectSourceToggle`,
                * `@skryensya/vanilla/component-preview`), so switching files never resets what a
                * reader already chose to see. CSS hides it entirely when none of the three even
                * has anything to collapse.
                *
                * PLAIN `@skryensya/core/code-preview` markup  -  `codePreviewParts.more`/`toggle`/
                * `toggleIcon`, `codePreviewAttrs.toggle`/`toggleLabel`/`expandedLabel`  -  not a
                * parallel vocabulary of ComponentPreview's own: that duplication was exactly what
                * made this control LOOK like a different one from a single file's own toggle.
                * `connectSourceToggle` finds it purely by DIRECT-CHILD position (see that
                * function's own comment), so no marker attribute is needed here at all.
                */
              }
              <div class={codePreviewParts.more} {...{ [codePreviewAttrs.more]: "" }}>
                <button
                  class={`sk-button sk-interactive ${codePreviewParts.toggle}`}
                  data-variant="ghost"
                  data-size="sm"
                  type="button"
                  aria-expanded="false"
                  {...{ [codePreviewAttrs.toggle]: "" }}
                  {...{ [codePreviewAttrs.expandedLabel]: t("preview.hideCode") }}
                >
                  <span {...{ [codePreviewAttrs.toggleLabel]: "" }}>{t("preview.viewCode")}</span>
                  <span class={codePreviewParts.toggleIcon} aria-hidden="true">
                    <Fragment set:html={sourceToggleIcon} />
                  </span>
                </button>
              </div>
              <div class="sk-tabs__list" data-sk-tabs-list aria-label="Fuente vanilla">
                <button
                  class="sk-tabs__trigger sk-interactive"
                  data-sk-tabs-trigger
                  data-value="html"
                  type="button"
                >
                  HTML
                </button>
                {
                  css && (
                    <button
                      class="sk-tabs__trigger sk-interactive"
                      data-sk-tabs-trigger
                      data-value="css"
                      type="button"
                    >
                      CSS
                    </button>
                  )
                }
                {
                  js && (
                    <button
                      class="sk-tabs__trigger sk-interactive"
                      data-sk-tabs-trigger
                      data-value="js"
                      type="button"
                    >
                      TS
                    </button>
                  )
                }
              </div>
              <div
                class="sk-tabs__content sk-component-preview__code"
                data-sk-tabs-content
                data-value="html"
                data-sk-component-preview-source="html"
              >
                <CodeBlock
                  code={vanillaCode}
                  full={codeFull}
                  lang={lang}
                  expandLabel={t("preview.viewCode")}
                  collapseLabel={t("preview.hideCode")}
                  forceCollapsible
                />
              </div>
              {
                css && (
                  <div
                    class="sk-tabs__content sk-component-preview__code"
                    data-sk-tabs-content
                    data-value="css"
                    data-sk-component-preview-source="css"
                  >
                    <CodeBlock
                      code={css}
                      lang="css"
                      expandLabel={t("preview.viewCode")}
                      collapseLabel={t("preview.hideCode")}
                      forceCollapsible
                    />
                  </div>
                )
              }
              {
                js && (
                  <div
                    class="sk-tabs__content sk-component-preview__code"
                    data-sk-tabs-content
                    data-value="js"
                    data-sk-component-preview-source="js"
                  >
                    <CodeBlock
                      code={js}
                      lang="ts"
                      expandLabel={t("preview.viewCode")}
                      collapseLabel={t("preview.hideCode")}
                      forceCollapsible
                    />
                  </div>
                )
              }
            </div>
          ) : (
            <div class="sk-component-preview__code" data-sk-component-preview-source="html">
              <CodeBlock
                code={vanillaCode}
                full={codeFull}
                lang={lang}
                expandLabel={t("preview.viewCode")}
                collapseLabel={t("preview.hideCode")}
                forceCollapsible
              />
            </div>
          )
        }
      </div>
    )
  }

  {
    (treeReact ?? react) && !hideSource && (
      <div
        class="sk-component-preview__binding"
        data-sk-component-preview-binding="react"
        hidden={hasBindingTabs ? true : undefined}
      >
        {
          reactData ? (
            <div
              class="sk-tabs sk-component-preview__source-tabs"
              data-sk-tabs
              data-sk-component-preview-source-tabs
              data-size="sm"
              data-value="component"
            >
              <div class={codePreviewParts.more} {...{ [codePreviewAttrs.more]: "" }}>
                <button
                  class={`sk-button sk-interactive ${codePreviewParts.toggle}`}
                  data-variant="ghost"
                  data-size="sm"
                  type="button"
                  aria-expanded="false"
                  {...{ [codePreviewAttrs.toggle]: "" }}
                  {...{ [codePreviewAttrs.expandedLabel]: t("preview.hideCode") }}
                >
                  <span {...{ [codePreviewAttrs.toggleLabel]: "" }}>{t("preview.viewCode")}</span>
                  <span class={codePreviewParts.toggleIcon} aria-hidden="true">
                    <Fragment set:html={sourceToggleIcon} />
                  </span>
                </button>
              </div>
              <div class="sk-tabs__list" data-sk-tabs-list aria-label={t("preview.reactSource")}>
                <button
                  class="sk-tabs__trigger sk-interactive"
                  data-sk-tabs-trigger
                  data-value="component"
                  type="button"
                >
                  {t("preview.sourceComponent")}
                </button>
                {/* Labelled with the file name, because that is what the import in the tab beside it says. */}
                <button
                  class="sk-tabs__trigger sk-interactive"
                  data-sk-tabs-trigger
                  data-value="data"
                  type="button"
                >
                  {reactData.file}
                </button>
              </div>
              <div
                class="sk-tabs__content sk-component-preview__code"
                data-sk-tabs-content
                data-value="component"
                data-sk-component-preview-source="react"
              >
                <CodeBlock
                  code={treeReact!}
                  lang="tsx"
                  expandLabel={t("preview.viewCode")}
                  collapseLabel={t("preview.hideCode")}
                  forceCollapsible
                />
              </div>
              <div
                class="sk-tabs__content sk-component-preview__code"
                data-sk-tabs-content
                data-value="data"
                data-sk-component-preview-source="react-data"
              >
                <CodeBlock
                  code={reactData.source}
                  lang="ts"
                  expandLabel={t("preview.viewCode")}
                  collapseLabel={t("preview.hideCode")}
                  forceCollapsible
                />
              </div>
            </div>
          ) : (
            <div class="sk-component-preview__code" data-sk-component-preview-source="react">
              <CodeBlock
                code={(treeReact ?? react)!}
                lang="tsx"
                expandLabel={t("preview.viewCode")}
                collapseLabel={t("preview.hideCode")}
                forceCollapsible
              />
            </div>
          )
        }
      </div>
    )
  }

  {
    /*
     * `Vaul.drawer` (packages/core/src/vaul.ts): a native `<dialog>` again, so `showModal()`,
     * Escape and focus trapping are still the platform's, but anchored to an edge instead of
     * centred, with `mountVaul`'s drag-to-dismiss and light-dismiss on top. `data-sk-vaul` is what
     * that SITE-WIDE enhancer (already running via `initComponents()`, see `Base.astro`'s own
     * mobile nav drawer) scans for; this root needs no enhancer of its own. `sk-drawer` supplies
     * only tokens (`components/drawer.css`'s own header: "ships hooks and no structure"), so the
     * header/title/body below are this card's own classes, the same split `docs-drawer` uses in
     * `site.css`.
     */
    treeJson && !hideSource && (
      <dialog
        class="sk-vaul sk-drawer sk-component-preview__contract-drawer"
        id={`${previewId}-contract`}
        data-sk-vaul
        data-edge="inline-end"
        aria-label={t("preview.usageTree")}
      >
        <div class="sk-vaul__handle" data-part="handle" aria-hidden="true" />
        <div class="sk-component-preview__contract-header">
          <span class="sk-component-preview__contract-title">{t("preview.usageTree")}</span>
          <button
            class="sk-button sk-interactive"
            data-variant="ghost"
            data-size="sm"
            data-icon-only
            type="button"
            aria-label={t("action.close")}
            data-sk-vaul-close
          >
            <Fragment set:html={iconMarkup("close", { size: "sm" })} />
          </button>
        </div>
        <div class="sk-component-preview__contract-body sk-scrollbar">
          {/* `open`: the drawer IS the disclosure, so the code inside never gets a second one  -  no
            Expand control, no collapsed window ceiling, always the whole tree. */}
          <CodeBlock code={treeJson} lang="json" open />
        </div>
      </dialog>
    )
  }
</div>
{
  /*
   * Sync tabs, panels and the screen preset to the document prefs before deferred enhancers mount.
   * Head FOUC already wrote both attributes on <html>; this keeps the binding buttons from
   * flipping pressed state Vanilla → React on load, and stops a persisted preset from painting
   * full-width first and snapping to phone size once the enhancer arrives.
   */
  (hasBindingTabs || screens) && (
    <script
      is:inline
      define:vars={{ previewId, hasBindingTabs, screens, zoomedDesktop, screenScope, defaultScreen }}
    >
      (function () {
        var d = document.documentElement;
        var root = document.getElementById(previewId);
        if (!root) return;

        if (hasBindingTabs) {
          var pref = d.getAttribute("data-sk-component-preview-pref") || "vanilla";
          var tabs = root.querySelector("[data-sk-component-preview-binding-tabs]");
          if (tabs) {
            tabs.setAttribute("data-value", pref);
            tabs.querySelectorAll("[data-sk-component-preview-binding-option]").forEach(function (option) {
              option.setAttribute("aria-checked", option.getAttribute("data-value") === pref ? "true" : "false");
            });
          }
          root.querySelectorAll("[data-sk-component-preview-binding]").forEach(function (panel) {
            var name = panel.getAttribute("data-sk-component-preview-binding");
            if (name === "vanilla" || name === "react") panel.hidden = name !== pref;
          });
        }

        if (screens) {
          var screen;
          if (screenScope === "local") {
            // Never reads the shared/persisted preset: this preview's opinion of its own starting
            // point (see the `screenScope` doc on ComponentPreview.astro), not the page's.
            screen = defaultScreen || "mobile";
          } else {
            screen = d.getAttribute("data-sk-component-preview-screen-pref");
            if (screen === "xl" && !zoomedDesktop) screen = "free";
            if (screen !== "xl" && screen !== "tablet" && screen !== "mobile") screen = "free";
          }
          var screenTabs = root.querySelector("[data-sk-component-preview-screen-tabs]");
          if (screenTabs) {
            screenTabs.setAttribute("data-value", screen);
            screenTabs.querySelectorAll("[data-sk-component-preview-screen-option]").forEach(function (option) {
              option.setAttribute("aria-checked", option.getAttribute("data-value") === screen ? "true" : "false");
            });
          }
          // Both bindings are iframe stages, and the preset is one control above both of them.
          // `free` is the absence of the attribute, so nothing is written for it.
          if (screen !== "free") {
            root.querySelectorAll(".sk-component-preview__stage").forEach(function (stage) {
              stage.setAttribute("data-sk-component-preview-screen", screen);
            });
          }
          // XL's 1440px viewport only fits the docs column zoomed out (packages/vanilla's
          // `syncXlZoom`, run later by the deferred enhancer). Mirrored here so the stage never
          // paints full-width-unzoomed before that enhancer mounts.
          if (screen === "xl") {
            var target =
              parseFloat(getComputedStyle(root).getPropertyValue("--sk-component-preview-screen-xl")) ||
              1440;
            var zoom = Math.min(1, root.clientWidth / target);
            root.style.setProperty("--sk-component-preview-xl-zoom", String(zoom));
          }
        }
      })();
    </script>
  )
}

<script>
  import { mountComponentPreview } from "@skryensya/vanilla/component-preview";
  import frameRuntimeUrl from "../scripts/component-preview-frame.ts?worker&url";

  if (!document.head.querySelector("[data-sk-component-preview-runtime-preload]")) {
    const preload = document.createElement("link");
    preload.rel = "modulepreload";
    preload.href = frameRuntimeUrl;
    preload.fetchPriority = "low";
    preload.setAttribute("data-sk-component-preview-runtime-preload", "");
    document.head.append(preload);
  }

  mountComponentPreview();
</script>
