---
/*
 * The index of the site, as markup. Rendered TWICE, once in the sticky rail, once inside the mobile
 * drawer, so it lives here rather than being copied: two copies of a nav are two navs that disagree
 * the first time someone adds a page.
 *
 * The nav-list is a guest wherever it is put (decision 17): it knows nothing about the rail or the
 * drawer hosting it.
 */

import { getLocale, useTranslations } from "../i18n";

type NavigationItem = {
  href: string;
  label: string;
  aliases?: readonly string[];
  todo?: boolean;
  status?: "wip" | "stable";
  /** Separate axis from `status`: see the ariaReviewed dot below. */
  ariaReviewed?: boolean;
};

type NavigationGroup = {
  group: string;
  secondary?: boolean;
  items: readonly NavigationItem[];
};

type NavigationSection = {
  id?: string;
  section: string;
  href?: string;
  blurb: string;
  groups: readonly NavigationGroup[];
};

interface Props {
  nav: readonly NavigationSection[];
  path: string;
  /* Ids must stay unique across BOTH renders, the drawer's copy would otherwise collide with the
   * rail's, and every group label would point at the wrong list. */
  idPrefix: string;
}

const { nav, path, idPrefix } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/** `item.status`, defaulted: an entry with no status is "wip" until deliberately marked "stable". */
const status = (item: NavigationItem) => item.status ?? "wip";

/*
 * The rail and the catalog page (`/componentes`) read the SAME task-grouped source
 * (`componentNavigation` in `lib/navigation.ts`) on purpose: one inventory, so a new component
 * cannot land in the catalog without also landing in the rail. But they answer different
 * questions: the catalog helps someone who does not know the name yet pick by what they need to
 * DO ("capturar datos", "orientar"); the rail is for someone who already knows the name and wants
 * it fast, where six unlabeled task headers just add scanning cost. So only the rail flattens the
 * groups back into one alphabetical list, a presentation choice made here, not a second data
 * source to keep in sync.
 */
const groupsForSection = (section: NavigationSection): readonly NavigationGroup[] =>
  section.id === "components"
    ? [
        {
          group: "",
          items: section.groups
            .flatMap((group) => group.items)
            .slice()
            .sort((a, b) => a.label.localeCompare(b.label, locale)),
        },
      ]
    : section.groups;
---

{
  nav.map((section, sectionIndex) => (
    <section class="docs-nav-section" aria-label={section.section}>
      <header class="docs-nav-section__header">
        {
          section.href ? (
            <a class="docs-nav-section__title" href={section.href}>{section.section}</a>
          ) : (
            <h2 class="docs-nav-section__title" data-flush>{section.section}</h2>
          )
        }
        <p class="docs-nav-section__blurb">{section.blurb}</p>
      </header>
      <nav class="sk-nav-list" aria-label={section.section}>
        {groupsForSection(section).map((group, groupIndex) => (
          <div class="sk-nav-list__group" data-secondary={group.secondary ? "" : undefined}>
            {
              group.group ? (
                <div class="sk-nav-list__group-label" id={`${idPrefix}-${sectionIndex}-${groupIndex}`}>
                  {group.group}
                </div>
              ) : null
            }
            <ul
              class="sk-nav-list__list"
              aria-labelledby={group.group ? `${idPrefix}-${sectionIndex}-${groupIndex}` : undefined}
            >
              {group.items.map((item) => (
                <li
                  class="sk-nav-list__item sk-badge-holder"
                  data-todo={item.todo ? "" : undefined}
                >
                  <a
                    class="sk-nav-list__link sk-interactive"
                    href={item.href}
                    aria-current={path === item.href ? "page" : undefined}
                    aria-disabled={item.todo ? "true" : undefined}
                    title={item.todo ? t("nav.notWritten") : undefined}
                  >
                    <span class="sk-nav-list__label">{item.label}</span>
                  </a>
                  {
                    /* A sibling of the link, not content inside it: `sk-badge-holder` (Badge's own
                     * corner-riding contract) needs the dot as its DIRECT child to place it, and the
                     * link's `overflow: hidden` would clip a corner-riding dot were it nested inside.
                     *
                     * `ariaReviewed` is a different axis from `status` (contract maturity, see
                     * `componentStatus`): a "wip" contract can still be ARIA-reviewed, so a reviewed
                     * entry gets the success tone INSTEAD of the warning one rather than losing its
                     * dot outright — the sidebar keeps saying something about it either way. */
                    section.id === "components" &&
                      (item.ariaReviewed ? (
                        <span
                          class="sk-badge"
                          data-dot
                          data-tone="success"
                          aria-label={t("status.ariaReviewed")}
                          title={t("status.ariaReviewed")}
                        />
                      ) : (
                        status(item) === "wip" && (
                          <span
                            class="sk-badge"
                            data-dot
                            data-tone="warning"
                            aria-label={t("status.wip")}
                            title={t("status.wip")}
                          />
                        )
                      ))
                  }
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </section>
  ))
}
