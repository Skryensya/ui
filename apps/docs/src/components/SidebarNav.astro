---
/*
 * The index of the site, as markup. Rendered TWICE, once in the sticky rail, once inside the mobile
 * drawer, so it lives here rather than being copied: two copies of a nav are two navs that disagree
 * the first time someone adds a page.
 *
 * The nav-list is a guest wherever it is put (decision 17): it knows nothing about the rail or the
 * drawer hosting it.
 */

import NavGroupItems from "./NavGroupItems.astro";
import type { NavigationSection } from "../lib/navigation";

interface Props {
  nav: readonly NavigationSection[];
  path: string;
  /* Ids must stay unique across BOTH renders, the drawer's copy would otherwise collide with the
   * rail's, and every group label would point at the wrong list. */
  idPrefix: string;
}

const { nav, path, idPrefix } = Astro.props;

/*
 * A GROUP THAT OPENS AND CLOSES is the data's decision (`collapsible` in `lib/navigation.ts`), never the
 * renderer's: this file does not know which sections are long. The component catalog sets it, so a hundred
 * entries arrive as twelve categories; the foundations, a short reading path, do not.
 *
 * Open on arrival: the category that holds the current page, and nothing else. What a reader opened or
 * closed by hand is applied on top by the script in `Base.astro`, before first paint, and the current
 * category always wins over a stored "closed". The closed list is `hidden` in the markup, so the page is
 * right before any script runs.
 */
const holdsCurrentPage = (items: readonly { href: string }[]): boolean => items.some((item) => item.href === path);
---

{
  nav.map((section, sectionIndex) => (
    <section class="docs-nav-section" aria-label={section.section}>
      {!section.headless && <header class="docs-nav-section__header">
        {
          section.href ? (
            <a class="docs-nav-section__title" href={section.href}>{section.section}</a>
          ) : (
            <h2 class="docs-nav-section__title" data-flush>{section.section}</h2>
          )
        }
        <p class="docs-nav-section__blurb">{section.blurb}</p>
      </header>}
      <nav class="sk-nav-list" aria-label={section.section}>
        {section.groups.map((group, groupIndex) => {
          const labelId = `${idPrefix}-${sectionIndex}-${groupIndex}`;

          if (group.collapsible) {
            const open = holdsCurrentPage(group.items);
            return (
              <div class="sk-nav-list__group" data-collapsible data-default-open={open ? undefined : "false"}>
                <button
                  class="sk-nav-list__group-label sk-interactive"
                  type="button"
                  id={labelId}
                  data-sk-nav-list-group-trigger
                  data-nav-group-trigger={group.id}
                  data-nav-group-active={open ? "true" : "false"}
                  aria-expanded={open ? "true" : "false"}
                  aria-controls={`${labelId}-list`}
                >
                  {group.group}
                </button>
                <ul class="sk-nav-list__list" id={`${labelId}-list`} data-sk-nav-list-group-list hidden={!open}>
                  <NavGroupItems items={group.items} path={path} />
                </ul>
              </div>
            );
          }

          return (
            <div class="sk-nav-list__group" data-secondary={group.secondary ? "" : undefined}>
              {group.group ? <div class="sk-nav-list__group-label" id={labelId}>{group.group}</div> : null}
              <ul class="sk-nav-list__list" aria-labelledby={group.group ? labelId : undefined}>
                <NavGroupItems items={group.items} path={path} />
              </ul>
            </div>
          );
        })}
      </nav>
    </section>
  ))
}
