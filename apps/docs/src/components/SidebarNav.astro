---
/*
 * The index of the site, as markup. Rendered TWICE, once in the sticky rail, once inside the mobile
 * drawer, so it lives here rather than being copied: two copies of a nav are two navs that disagree
 * the first time someone adds a page.
 *
 * The nav-list is a guest wherever it is put (decision 17): it knows nothing about the rail or the
 * drawer hosting it.
 */

import { emitMarkup } from "@skryensya/ai-compiler/emit";
import NavGroupItems from "./NavGroupItems.astro";
import type { NavigationSection } from "../lib/navigation";
import { getLocale, useTranslations } from "../i18n";

interface Props {
  nav: readonly NavigationSection[];
  path: string;
  /* Ids must stay unique across BOTH renders, the drawer's copy would otherwise collide with the
   * rail's, and every group label would point at the wrong list. */
  idPrefix: string;
}

const { nav, path, idPrefix } = Astro.props;
const t = useTranslations(getLocale(Astro.url));

/*
 * "Expand all" / "Collapse all" for a section whose groups fold: the kit's icon-only Button beside the section's title. It
 * carries both icons and shows the one for what a press will do; the script below swaps them and the accessible name.
 */
const toggleAll = emitMarkup(
  {
    contract: "button",
    signature: "Button.action",
    options: { variant: "ghost", size: "xs", iconOnly: true },
    attrs: {
      "aria-label": t("nav.expandAll"),
      "data-docs-nav-toggle-all": "",
      "data-expand-label": t("nav.expandAll"),
      "data-collapse-label": t("nav.collapseAll"),
    },
    children: [
      { contract: "icon", signature: "Icon", options: { name: "expand-all", size: "sm" }, attrs: { "data-docs-nav-toggle-icon": "expand" } },
      { contract: "icon", signature: "Icon", options: { name: "collapse-all", size: "sm" }, attrs: { "data-docs-nav-toggle-icon": "collapse", hidden: "" } },
    ],
  },
  { fillDefaults: false },
);

/*
 * A GROUP THAT OPENS AND CLOSES is the data's decision (`collapsible` in `lib/navigation.ts`), never the
 * renderer's: this file does not know which sections are long. The component catalog sets it, so a hundred
 * entries arrive as twelve categories; the foundations, a short reading path, do not.
 *
 * Open on arrival: the category that holds the current page, and nothing else; on a page no category holds
 * (the `/components` index), the first one, so the rail never arrives fully shut. What a reader opened or
 * closed by hand is applied on top by the script in `Base.astro`, before first paint, and the current
 * category always wins over a stored "closed". The closed list is `hidden` in the markup, so the page is
 * right before any script runs.
 */
const holdsCurrentPage = (items: readonly { href: string }[]): boolean => items.some((item) => item.href === path);
const opensFirst = (groups: readonly { items: readonly { href: string }[] }[], index: number): boolean =>
  index === 0 && !groups.some((group) => holdsCurrentPage(group.items));
---

{
  nav.map((section, sectionIndex) => (
    <section class="docs-nav-section" aria-label={section.section}>
      {/* `caption` undefined: the section's title and blurb. A caption: that line alone. An EMPTY caption: nothing
          (a rail whose groups speak for themselves, like the Templates page's). */}
      {(() => {
        const folds = section.groups.some((group) => group.collapsible);
        const control = folds ? <Fragment set:html={toggleAll} /> : null;
        if (section.caption)
          return (
            <header class="docs-nav-section__header">
              <div class="docs-nav-section__title-row">
                <h2 class="docs-nav-section__title" data-flush>{section.caption}</h2>
                {control}
              </div>
            </header>
          );
        if (section.caption === undefined)
          return (
            <header class="docs-nav-section__header">
              <div class="docs-nav-section__title-row">
                {section.href ? (
                  <a class="docs-nav-section__title" href={section.href}>{section.section}</a>
                ) : (
                  <h2 class="docs-nav-section__title" data-flush>{section.section}</h2>
                )}
                {control}
              </div>
              <p class="docs-nav-section__blurb">{section.blurb}</p>
            </header>
          );
        return folds ? <header class="docs-nav-section__header"><div class="docs-nav-section__title-row">{control}</div></header> : null;
      })()}
      <nav class="sk-nav-list" aria-label={section.section} data-storage-key="docs-nav-groups">
        {section.groups.map((group, groupIndex) => {
          const labelId = `${idPrefix}-${sectionIndex}-${groupIndex}`;

          if (group.collapsible) {
            const open = group.defaultOpen ?? (holdsCurrentPage(group.items) || opensFirst(section.groups, groupIndex));
            return (
              <div class="sk-nav-list__group" data-collapsible data-group-id={group.id} data-default-open={open ? undefined : "false"}>
                <button
                  class="sk-nav-list__group-label sk-interactive"
                  type="button"
                  id={labelId}
                  data-sk-nav-list-group-trigger
                  aria-expanded={open ? "true" : "false"}
                  aria-controls={`${labelId}-list`}
                >
                  {group.group}
                </button>
                <ul class="sk-nav-list__list" id={`${labelId}-list`} data-sk-nav-list-group-list hidden={!open}>
                  <NavGroupItems items={group.items} path={path} />
                </ul>
              </div>
            );
          }

          return (
            <div class="sk-nav-list__group" data-secondary={group.secondary ? "" : undefined}>
              {group.group ? <div class="sk-nav-list__group-label" id={labelId}>{group.group}</div> : null}
              <ul class="sk-nav-list__list" aria-labelledby={group.group ? labelId : undefined}>
                <NavGroupItems items={group.items} path={path} />
              </ul>
            </div>
          );
        })}
      </nav>
    </section>
  ))
}

<script>
  import { setNavListGroups } from "@skryensya/core/nav-list";

  /* Each section's toggle opens every group when any is closed, and closes them all when none is, saying which it will do. */
  const sync = (button: HTMLElement) => {
    const nav = button.closest(".docs-nav-section")?.querySelector(".sk-nav-list");
    const triggers = [...(nav?.querySelectorAll("[data-sk-nav-list-group-trigger]") ?? [])];
    const allOpen = triggers.length > 0 && triggers.every((trigger) => trigger.getAttribute("aria-expanded") === "true");
    button.setAttribute("aria-label", (allOpen ? button.dataset.collapseLabel : button.dataset.expandLabel) ?? "");
    for (const icon of button.querySelectorAll<SVGElement | HTMLElement>("[data-docs-nav-toggle-icon]")) {
      icon.toggleAttribute("hidden", icon.dataset.docsNavToggleIcon !== (allOpen ? "collapse" : "expand"));
    }
    button.dataset.open = String(allOpen);
  };

  const wire = () => {
    for (const button of document.querySelectorAll<HTMLElement>("[data-docs-nav-toggle-all]")) {
      if (button.dataset.wired) continue;
      button.dataset.wired = "";
      button.addEventListener("click", () => {
        const nav = button.closest(".docs-nav-section")?.querySelector(".sk-nav-list");
        if (!nav) return;
        setNavListGroups(nav, button.dataset.open !== "true");
        sync(button);
      });
      sync(button);
      /* A group the reader opens or closes by hand, or the stored state the enhancer restores. */
      new MutationObserver(() => sync(button)).observe(button.closest(".docs-nav-section")!, { attributes: true, attributeFilter: ["aria-expanded"], subtree: true });
    }
  };

  wire();
</script>
