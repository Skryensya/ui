---
/*
 * What changed in one component, by version, newest first.
 *
 * The entries come from `contracts/changelog/<id>.yaml` through the same compiled artifact the
 * reference tab reads, and they are there because a gate refuses to build a contract whose shape
 * moved without one (see `packages/ai-compiler/src/changelog.ts`). That is the difference between
 * this and a CHANGELOG.md: the file cannot quietly stop being written.
 *
 * VERSIONS, NOT DATES, and the compiler is what makes that possible without stamping anything by
 * hand: entries are written with a date, `contracts/changelog/releases.yaml` says which day each
 * version shipped, and the two together decide the grouping. A reader of a changelog is asking
 * whether they already have the thing they are reading about, and a date cannot answer that.
 *
 * NOTHING IS PUBLISHED YET, so today every entry lands in one group named `0.1.0-dev`: the version
 * this work is heading for, marked as not having got there. The day the first release is cut, one
 * line in the ledger splits it, and this file does not change.
 *
 * THE MARKUP IS THE `changelog` CONTRACT'S, authored rather than emitted from a usage tree, for the
 * reason `CodeBlock` records about Shiki: an entry's text is HTML that a compiler already validated
 * and that has to land as real markup, and a tree has no channel for that, only for text or for
 * composed signatures. The classes and attributes below are the contract's own, so this page and a
 * tree that used it draw the same thing.
 */
import "@skryensya/core/components/changelog.css";
import { badgeParts } from "@skryensya/core/badge";
import { changeKindTones, changelogParts } from "@skryensya/core/changelog";
import { changelogFor, entryText } from "../lib/contract-reference";
import { getLocale, useTranslations, type UIKey } from "../i18n";

interface Props {
  id: string;
  heading?: string;
}

const { id, heading } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const releases = changelogFor(id);

/*
 * `timeZone: "UTC"` because a release date is a plain `YYYY-MM-DD`, which `Date` parses as midnight
 * UTC. Formatted in a zone behind that, every release renders as the day before it says.
 */
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" });
---

<h2>{heading ?? t("changelog.title")}</h2>

{
  releases.length === 0 ? (
    <p>{t("changelog.empty")}</p>
  ) : (
    <ol class={changelogParts.root} reversed>
      {releases.map((release) => (
        <li class={changelogParts.release} data-unreleased={release.date === null ? "" : undefined}>
          <span class={changelogParts.marker} aria-hidden="true" />
          <span class={changelogParts.version}>{release.version}</span>
          {/* Both halves of the date: the machine one for a parser, the readable one for a reader.
              A version with no date has not shipped, and renders no `<time>` at all rather than a
              `<time>` with nothing in it. */}
          {release.date !== null && (
            <time class={changelogParts.date} datetime={release.date}>
              {dateFormat.format(new Date(release.date))}
            </time>
          )}
          <ol class={changelogParts.entries}>
            {release.entries.map((entry) => {
              const text = entryText(entry, locale);
              return (
                <li class={changelogParts.entry} data-kind={entry.kind}>
                  {/* `sk-badge` alongside the part class, and the tone READ FROM CORE rather than
                      decided here: the kind is the fact and the tone is a rendering of it. This page
                      draws the contract's markup by hand, so the one thing it must not do is
                      re-derive what the contract derives. An `entry.kind === "breaking"` written
                      here is a copy of the mapping that would go stale the day a kind changes
                      colour, silently, on a page that still renders. */}
                  <span
                    class={`${changelogParts.kind} ${badgeParts.root}`}
                    data-tone={changeKindTones[entry.kind]}
                  >
                    {t(`changelog.kind.${entry.kind}` as UIKey)}
                  </span>
                  {/* The target rides with the badge: both say what the change is about before a
                      reader has read anything, so the headline gets a clean line of its own. */}
                  {entry.target && <code class={changelogParts.target}>{entry.target}</code>}
                  <span class={changelogParts.title}>{text.title}</span>
                  {/* `set:html` on the body alone: a title is plain text by contract, and only the
                      body is markup a compiler already validated. */}
                  <div class={changelogParts.text} set:html={text.body} />
                </li>
              );
            })}
          </ol>
        </li>
      ))}
    </ol>
  )
}
