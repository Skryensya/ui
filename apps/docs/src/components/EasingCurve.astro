---
/*
 * One easing primitive, drawn.
 *
 * The PATH needs the literal cubic-bezier, because SVG geometry can't read a CSS easing, so it
 * comes from the parsed corpus at build time (the same corpus the validator judges). Everything
 * that MOVES is driven by `var(--scale-easing-*)` itself. So the drawing and the motion can
 * never disagree about the value, and retuning the primitive retunes both.
 *
 * The plot is progress (vertical) against time (horizontal) over a unit square. Time is linear
 * by definition, so the playhead sweeps at a constant rate while the progress line is eased:
 * they cross exactly at the dot, and the curve is the trace of that crossing.
 */
import MotionTrack from "./MotionTrack.astro";
import { byName, literalOf } from "../lib/tokens";

interface Props {
  token: string;
  /** What the curve is FOR, one line. */
  note: string;
}

const { token, note } = Astro.props;
const t = byName.get(token);

// Same contract as <Used>: a token the parser has never seen is a typo in the docs, and a
// silently blank card would read as "the system doesn't ship this curve", a different claim.
if (!t) throw new Error(`EasingCurve: ${token} no existe en el CSS del sistema`);

const literal = literalOf(t.value);
const parsed = literal.match(/^cubic-bezier\(([^)]+)\)$/);
// `linear` is a curve too, it just happens to be the diagonal; plotting it as one keeps the
// whole set on the same axes instead of special-casing it out of the comparison.
const [x1, y1, x2, y2] = parsed
  ? parsed[1].split(",").map((n) => Number(n.trim()))
  : [0, 0, 1, 1];

if (!parsed && literal !== "linear") {
  throw new Error(`EasingCurve: ${token} = "${literal}" no es una curva que se pueda dibujar`);
}

/** Unit space → plot space: 0…1 across, and progress up, since SVG's y grows downward. */
const at = (x: number, y: number) => `${(x * 100).toFixed(2)} ${(100 - y * 100).toFixed(2)}`;
const path = `M ${at(0, 0)} C ${at(x1, y1)} ${at(x2, y2)} ${at(1, 1)}`;

const name = token.replace("--scale-easing-", "");
---

<button
  class="docs-easing sk-interactive"
  type="button"
  data-motion-specimen
  style={`--docs-easing-curve:var(${token})`}
  aria-label={`Reproducir ${name}: ${note}`}
>
  <span class="docs-easing__head">
    <span class="docs-easing__name">{name}</span>
    <span class="docs-easing__note">{note}</span>
  </span>

  {/* Headroom above the square is deliberate and shared by every card: it's where an
      overshooting curve goes, and it only reads as overshoot if the ceiling is common. */}
  <svg class="docs-easing__plot" viewBox="-8 -20 116 128" aria-hidden="true">
    <rect class="docs-easing__box" x="0" y="0" width="100" height="100" rx="2"></rect>
    <line class="docs-easing__ref" x1="0" y1="100" x2="100" y2="0"></line>
    <g class="docs-easing__progress"><line x1="-8" y1="100" x2="108" y2="100"></line></g>
    <g class="docs-easing__time"><line x1="0" y1="-20" x2="0" y2="108"></line></g>
    <path class="docs-easing__curve" d={path}></path>
    <g class="docs-easing__cursor-x">
      <g class="docs-easing__cursor-y">
        <circle class="docs-easing__dot" cx="0" cy="100" r="3.5"></circle>
      </g>
    </g>
  </svg>

  <MotionTrack duration="var(--docs-easing-duration)" easing={`var(${token})`} />

  <span class="mono docs-easing__value">{literal}</span>
</button>

<style>
  .docs-easing {
    /* One duration for every card: with time held still, the curve is the only variable left. */
    --docs-easing-duration: 1s;

    display: grid;
    gap: var(--space-stack-xs);
    align-content: start;
    margin: 0;
    padding: var(--space-inset-md);
    /* Outer radius = inner radius + padding, so the plot's corners stay concentric. */
    border: 1px solid var(--color-border-subtle);
    border-radius: calc(var(--radius-surface) + var(--space-inset-md));
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  /* The system's ring, declared here because the card is a control this page authors rather than
   * a component that ships with one. */
  .docs-easing:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .docs-easing__head {
    display: grid;
    gap: 2px;
  }

  .docs-easing__name {
    font-family: var(--font-family-code);
    font-size: var(--font-size-body-sm);
    line-height: var(--font-line-height-body-sm);
  }

  /* Two lines reserved on every card, whether or not the note fills them: the plots are meant to
   * be compared across a row, and a one-line note would lift its square out of line with the
   * others. `lh` is the note's own line box, so it survives a density or type-scale change. */
  .docs-easing__note {
    min-block-size: 2lh;
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
    line-height: var(--font-line-height-caption);
    text-wrap: pretty;
  }

  .docs-easing__plot {
    inline-size: 100%;
    block-size: auto;
    /* The strokes are chrome, not geometry: keep them 1 device px at any card width. */
    overflow: visible;
  }

  .docs-easing__box {
    fill: var(--color-bg-surface-sunken);
    stroke: var(--color-border-subtle);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .docs-easing__ref {
    stroke: var(--color-border-default);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }

  .docs-easing__curve {
    fill: none;
    stroke: var(--color-text-accent);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* The two readings that make the dot: a playhead sweeping time, a rule carrying progress. They
   * are scaffolding for the run, not part of the drawing, so at rest they aren't there at all;
   * otherwise every card ends with two dotted lines pinned to the corner it finished in. */
  .docs-easing__progress,
  .docs-easing__time {
    opacity: 0;
  }

  .docs-easing__progress line,
  .docs-easing__time line {
    stroke: var(--color-border-strong);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }

  .docs-easing__dot {
    fill: var(--color-action-primary);
    stroke: var(--color-bg-surface);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .docs-easing__value {
    min-block-size: 2lh;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  /* Time is linear and progress is eased. Composing them as two nested translates is what makes
   * the dot trace the real curve instead of an approximation sampled at build time. */
  [data-motion-playing] .docs-easing__cursor-x {
    animation: docs-easing-time var(--docs-easing-duration) linear both;
  }

  [data-motion-playing] .docs-easing__cursor-y {
    animation: docs-easing-progress var(--docs-easing-duration) var(--docs-easing-curve) both;
  }

  [data-motion-playing] .docs-easing__time {
    animation:
      docs-easing-time var(--docs-easing-duration) linear both,
      docs-easing-guide var(--docs-easing-duration) linear both;
  }

  [data-motion-playing] .docs-easing__progress {
    animation:
      docs-easing-progress var(--docs-easing-duration) var(--docs-easing-curve) both,
      docs-easing-guide var(--docs-easing-duration) linear both;
  }

  /* The scaffolding fades in with the run and leaves before it lands, so the last thing the eye
   * keeps is the curve and the dot on it. */
  @keyframes docs-easing-guide {
    0% {
      opacity: 0;
    }
    12%,
    82% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes docs-easing-time {
    from {
      translate: 0;
    }
    to {
      translate: 100px;
    }
  }

  @keyframes docs-easing-progress {
    from {
      translate: 0;
    }
    to {
      translate: 0 -100px;
    }
  }
</style>
