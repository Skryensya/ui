---
/*
 * Header chrome: name the docs version you are reading.
 *
 * Until a real cut mounts an archive under `/v<version>/` on the CDN (VERSIONED_DOCS_PLAN §3.3),
 * there is only one version: `working` from `releases.yaml`, served on bare URLs. This control is a
 * LABEL, not a switcher — a menu of one destination would pretend choice where none exists.
 *
 * Desktop: caption + bordered chip before search. Mobile: the same chip inside the prefs sheet.
 * When archives exist again, this is the place to grow back into a Menu of mounted cuts.
 */
import { getLocale, useTranslations } from "../i18n";
import { currentVersion } from "../lib/contract-reference";

interface Props {
  /** Render inside the mobile preference sheet instead of the desktop header. */
  tile?: boolean;
  /** Visible title inside the tile. Only read when `tile`. */
  label?: string;
  /** Secondary line under the title. Only read when `tile`. */
  description?: string;
}

const { tile = false, label, description } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const versionLabel = `v${currentVersion()}`;
const listId = "docs-prefs-version-label";
---

{
  tile ? (
    <div class="docs-prefs-versions" aria-labelledby={listId}>
      <div class="docs-prefs-versions__label" id={listId}>{label ?? t("version.control")}</div>
      {description && <p class="docs-prefs-versions__hint">{description}</p>}
      <p class="docs-prefs-versions__value">{versionLabel}</p>
    </div>
  ) : (
    <div class="dimensions__version-menu" aria-label={t("version.named", { name: versionLabel })}>
      <span class="dimensions__version-menu__caption">{t("version.control")}</span>
      <span class="dimensions__version-menu__chip">{versionLabel}</span>
    </div>
  )
}
