---
/*
 * Header chrome: switch docs version, staying on the SAME document.
 *
 * Built on the same shape as `LanguageMenu.astro`, deliberately: version and locale are two
 * independent axes over one document id (`canonicalPath`), so the two controls answer the same
 * question about different dimensions and should not be two different kinds of widget. Every row is
 * a real `<a href>` through Menu's own item `href`, the current row is a `radio` carrying
 * `data-checked`, and nothing here is client state: the URL is what says which version you read.
 *
 * WHICH ROWS EXIST is derived, never declared (ADR-0022): `lib/docs-versions.ts` reads the page
 * directory, so a version appears here because an archive of this page exists, not because someone
 * remembered to add it to a list.
 *
 * A ROW THIS DOCUMENT DOES NOT HAVE IS DISABLED, not hidden. An archive is normally a whole site, so
 * this only happens while the tree holds a partial one, but the reader is better served by "version
 * 1 does not have this page" than by a control that silently changes shape from page to page.
 */
import {
  canonicalPath,
  getLocale,
  localizePath,
  useTranslations,
  versionOf,
} from "../i18n";
import { frozenHasTranslation, frozenVersions } from "../lib/docs-versions";
import { iconMarkup } from "../icons";

interface Props {
  /**
   * Render the mobile form: the WHOLE list of versions inside the preference sheet, one row each.
   *
   * Not a Tile Button that cycles to the next version, which is what the other rows of that sheet
   * do and what this used to do. Cycling is right for a dimension with two or three states a reader
   * flips between (theme, contrast) and wrong for a version: the list grows with every cut, the
   * reader is CHOOSING one they already have in mind, and a control that only moves forward makes
   * them tap through the archive to reach it. A list says what exists and lets them pick.
   */
  tile?: boolean;
  /** Visible title inside the tile. Only read when `tile`. */
  label?: string;
  /** Secondary line under the title. Only read when `tile`. */
  description?: string;
}

const { tile = false, label, description } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const canonical = canonicalPath(Astro.url.pathname);
const current = versionOf(Astro.url);

/** Latest first, then every frozen cut, newest first: the reading order of a version list. */
const rows = [
  {
    value: null as string | null,
    label: t("version.latest"),
    href: localizePath(canonical, locale, null),
    available: true,
  },
  ...frozenVersions.map((version) => ({
    value: version as string | null,
    label: t("version.numbered", { number: version }),
    href: localizePath(canonical, locale, version),
    available: frozenHasTranslation(version, canonical, locale),
  })),
];

const currentLabel = rows.find((row) => row.value === current)?.label ?? t("version.latest");

const versionIcon = iconMarkup("clock");
const listId = "docs-prefs-version-label";
---

{
  tile && frozenVersions.length > 0 && (
    <nav class="sk-nav-list docs-prefs-versions" aria-labelledby={listId}>
      <div class="sk-nav-list__group">
        <div class="sk-nav-list__group-label" id={listId}>{label ?? t("version.control")}</div>
        {description && <p class="docs-prefs-versions__hint">{description}</p>}
        <ul class="sk-nav-list__list" aria-labelledby={listId}>
          {rows.map((row) => (
            <li class="sk-nav-list__item" data-todo={row.available ? undefined : ""}>
              <a
                class="sk-nav-list__link sk-interactive"
                href={row.available ? row.href : undefined}
                aria-current={row.value === current ? "page" : undefined}
                aria-disabled={row.available ? undefined : "true"}
              >
                <span class="sk-nav-list__label">{row.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

{
  !tile && frozenVersions.length > 0 && (
    <div class="sk-menu dimensions__language-menu" data-sk-menu aria-label={t("version.control")}>
      <button
        class="sk-menu__trigger sk-button sk-interactive sk-anchor"
        data-sk-menu-trigger
        data-variant="ghost"
        data-icon-only
        type="button"
        aria-label={t("version.named", { name: currentLabel })}
      >
        <Fragment set:html={versionIcon} />
      </button>
      <div class="sk-menu__positioner sk-anchored" data-sk-menu-positioner>
        <div class="sk-menu__content" data-sk-menu-content>
          {rows.map((row) => (
            <a
              class="sk-menu__item sk-interactive"
              data-sk-menu-item
              data-value={row.value ?? "latest"}
              data-type="radio"
              data-checked={row.value === current ? "" : undefined}
              data-disabled={row.available ? undefined : ""}
              aria-disabled={row.available ? undefined : "true"}
              href={row.available ? row.href : undefined}
            >
              <span class="sk-menu__item-label">{row.label}</span>
              <span class="sk-menu__item-indicator" aria-hidden="true">
                <span data-sk-icon="check" data-sk-icon-size="md" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  )
}
