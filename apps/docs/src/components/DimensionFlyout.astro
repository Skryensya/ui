---
/*
 * Site authoring for the Flyout markup contract, same role as DimensionSelect, but the panel
 * opens beside the trigger (inline-end). Used by /personalizar sidebar rows.
 */
interface Props {
  id: string;
  label: string;
  options: { value: string; label: string }[];
  /** Preselect this value (its label shows in the trigger, and the enhancer reads it as the default). */
  value?: string;
  /** Extra data-attribute so a page script can find this menu (e.g. which token it drives). */
  prop?: string;
  /** Shown when the current value matches no option (e.g. an externally-set custom value). */
  placeholder?: string;
  /** One line under the control: what the choice reaches. FormField's hint, tied by aria-describedby. */
  hint?: string;
  /** Marks the row for a page script that tracks which ones carry an override. */
  row?: string;
}

const { id, label, options, value, prop, placeholder, hint, row } = Astro.props;
import { iconMarkup } from "../icons";

const chevronRight = iconMarkup("chevron-right");
const chevronLeft = iconMarkup("chevron-left");
const check = iconMarkup("check");

const current = options.find((o) => o.value === value) ?? options[0];
const hintId = hint ? `${id}-hint` : undefined;
---

<div class="sk-form-field" data-row={row}>
  <div
    class="sk-flyout"
    data-sk-flyout
    id={id}
    data-value={value}
    data-prop={prop}
    data-placeholder={placeholder}
  >
    <label class="sk-flyout__label" data-sk-flyout-label>{label}</label>

    <button
      class="sk-flyout__trigger sk-interactive"
      data-sk-flyout-trigger
      type="button"
      aria-describedby={hintId}
    >
      <span class="sk-flyout__value" data-sk-flyout-value>{current?.label ?? placeholder}</span>
      <span class="sk-flyout__indicator" data-sk-flyout-indicator aria-hidden="true">
        <span data-state="closed"><Fragment set:html={chevronRight} /></span>
        <span data-state="open"><Fragment set:html={chevronLeft} /></span>
      </span>
    </button>

    <ul class="sk-flyout__panel" data-sk-flyout-panel>
      {
        options.map((option) => (
          <li class="sk-flyout__item sk-interactive" data-sk-flyout-item data-value={option.value}>
            <span class="sk-flyout__item-text" data-sk-flyout-item-text>
              {option.label}
            </span>
            <span class="sk-flyout__item-indicator" data-sk-flyout-item-indicator aria-hidden="true">
              <Fragment set:html={check} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  {hint && <span class="sk-form-field__hint" id={hintId}>{hint}</span>}
</div>
