---
/*
 * PASSWORDINPUT OR OTPINPUT, on both pages. Both ask a person for a secret and both hide it, so they
 * get confused, and the difference is not how they look but what the secret IS: one the person chose
 * and remembers (or their manager keeps), one that was just sent to them and is gone in minutes. The
 * block states that once and draws it: the same moment ("enter your secret") in each, a toggle, a
 * table of what changes and one rule to decide by. Each page tells it from its own side.
 */
import "@skryensya/core/components/password-input.css";
import "@skryensya/core/components/otp-input.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/patterns/icon-toggle.css";
import UsagePreview from "./UsagePreview.astro";
import ComparisonTable from "./ComparisonTable.astro";
import { passwordInputCompareTree } from "../demos/password-input";
import { otpInputSmsTree } from "../demos/otp-input";
import { getLocale, useTranslations } from "../i18n";

interface Props {
  from?: "password-input" | "otp-input";
}
const { from = "password-input" } = Astro.props;
const t = useTranslations(getLocale(Astro.url));

const here = from;
const other = from === "password-input" ? "otp-input" : "password-input";
const names = { "password-input": "PasswordInput", "otp-input": "OtpInput" } as const;
const sides = { "password-input": "password", "otp-input": "otp" } as const;
const trees = { "password-input": passwordInputCompareTree(t), "otp-input": otpInputSmsTree(t) } as const;
const rows = ["what", "length", "typing", "autofill", "reveal", "reader"] as const;
const ruleKey = from === "password-input" ? "pwVs.passwordPage.rule" : "pwVs.otpPage.rule";
const titleKey = from === "password-input" ? "pwVs.passwordPage.title" : "pwVs.otpPage.title";
---

<section class="password-vs-otp">
  <h3>{t(titleKey as Parameters<typeof t>[0])}</h3>
  <p set:html={t(ruleKey as Parameters<typeof t>[0])} />

  <UsagePreview
    tree={trees[here]}
    variants={[here, other].map((side) => ({
      value: side,
      label: names[side],
      tree: trees[side],
      explain: t(`pwVs.${sides[side]}.body` as Parameters<typeof t>[0]),
    }))}
    variantsLabel={t("pwVs.toggle")}
    description={t("pwVs.intro")}
    stageMinBlockSize="11rem"
  />

  <ComparisonTable
    aspectLabel={t("pwVs.col.aspect")}
    columns={[here, other].map((side) => names[side])}
    rows={rows.map((row) => ({
      label: t(`pwVs.row.${row}` as Parameters<typeof t>[0]),
      cells: [here, other].map((side) => t(`pwVs.row.${row}.${sides[side]}` as Parameters<typeof t>[0])),
    }))}
  />
</section>

