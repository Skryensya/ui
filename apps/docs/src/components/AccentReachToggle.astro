---
/*
 * The compact, site-wide Accent reach control. Header chrome has room for one precise action, not
 * a three-way picker: a click cycles all → links → action, while its live name states the choice.
 * The full set stays visible in the /acento specimen, where comparison is the job.
 */
import { accentReach, iconDataMarkup } from "../icons";
import { getLocale, useTranslations } from "../i18n";

const t = useTranslations(getLocale(Astro.url));
const labels = {
  1: t("prefs.accent1"),
  2: t("prefs.accent2"),
  3: t("prefs.accent3"),
};
const icon = iconDataMarkup("accent-reach", accentReach, {
  className: "dimensions__accent-icon",
});
---

<button
  class="sk-button sk-interactive dimensions__accent-toggle"
  data-variant="ghost"
  data-icon-only
  type="button"
  aria-label={labels[3]}
  title={labels[3]}
  data-docs-accent-toggle
  data-label-1={labels[1]}
  data-label-2={labels[2]}
  data-label-3={labels[3]}
>
  <Fragment set:html={icon} />
</button>
