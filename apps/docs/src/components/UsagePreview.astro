---
/*
 * ONE USAGE PREVIEW, WITH OR WITHOUT A CONTROL. A component page uses the same card whether it is
 * showing one fixed composition or varying one option live: title/description above, live React stage
 * in the card, optional Storybook link, optional caption or per-value explanation below.
 *
 * The docs' one preview: one tree, React-only stage (no Vanilla binding, no screen presets, no source
 * panels: Storybook has those, linked from the card).
 *
 * TWO STAGES, chosen by what the example needs. By default the tree renders in the page itself,
 * which is what a property card wants: it sits in the page and reacts at once. An example that
 * paints outside its flow (a menu, a dialog, a drawer), runs a script of its own, or must reach the
 * card's edges renders instead in the isolated frame (`react-demos/framed.tsx`): its own document,
 * top layer and viewport, so an open dialog covers the stage and not the reader's page.
 *
 * When `optionName` is present, the control's values are never authored here: `signatureOptions`
 * reads them off the option's own `ContractOption` (packages/core/src/contract.ts), the declaration
 * `discover_ui`/`validate_ui` and both bindings already agree on. An `optionName` the signature does
 * not declare, or one that is neither an enum nor a boolean, fails LOUD at build time rather than
 * rendering an empty control.
 */
import { getContract, getSignature } from "@skryensya/core/registry";
import { signatureOptions, type ContractOption } from "@skryensya/core/contract";
import type { UsageTree } from "@skryensya/core/usage-tree";
import { ExampleStage } from "./react-demos/example-stage";
import { TreeDemo } from "./react-demos/tree";
import { compileDemoScript } from "../lib/demo-script";
import "../styles/component-preview.css";
import { PropertyPlayground } from "./react-demos/property-playground";
import { nodeAt, type TreePath } from "./react-demos/usage-tree-path";
import { iconMarkup } from "../icons";
import { storybookDocsUrl, storybookReactUrl, storybookVanillaUrl } from "../lib/navigation";
import { resolveStorybookStory } from "../lib/storybook-stories";
import { getLocale, useTranslations } from "../i18n";
import "@skryensya/core/components/segmented.css";
import "./preview-card.css";

interface Props {
  tree?: UsageTree;
  /** The one option this preview varies: an enum, or a boolean (played as its two values). Omit for a fixed example. */
  optionName?: string;
  /**
   * Switch between whole trees instead of one option, for a docs-only axis the contract has no enum for
   * (a megamenu's column count). It is the same `PropertyPlayground` as an option card: the control
   * picks which tree is drawn, with its sentence under the example. `tree` is then omitted.
   */
  variants?: { value: string; label: string; tree: UsageTree; explain?: string }[];
  /** The variant shown first. Absent, the first one. */
  initialVariant?: string;
  /** A button at the top of the stage that plays the root's `present` on and off (Presence): the control picks the motion. */
  toggleLabel?: string;
  /** The control's accessible name when `variants` is set. */
  variantsLabel?: string;
  /** Where `optionName` lives when it is not on the root: a path of keys and indices (`usage-tree-path.ts`). */
  target?: TreePath;
  /** The preview's heading. Omit it when the page already titled this example. */
  title?: string;
  /** What the preview shows, above the card. Trusted HTML from the page's messages. */
  description?: string;
  /** One sentence under a fixed example, inside the card. Trusted HTML. */
  caption?: string;
  /** What each value is for, under the controlled example for the one chosen. Trusted HTML; optional per value. */
  explain?: Record<string, string>;
  /** A segment's label per value. Absent, the value itself, capitalized ("neutral" -> "Neutral"). */
  labels?: Record<string, string>;
  /** Reserve vertical room for examples whose live values have different heights, avoiding CLS. */
  stageMinBlockSize?: string;
  /** Remount the specimen when the value changes. Disable for continuous animations like Marquee. */
  remountOnChange?: boolean;
  /**
   * Extra CSS for this example only, the prop `ComponentPreview` also takes. The stage is on the page
   * itself, not in a frame, so the rules are nested under this card (native CSS nesting) and cannot
   * reach anything outside it.
   */
  css?: string;
  /** The generated story this tree became (`lib/navigation.ts`). Omit either and no code link renders. */
  storybookTitle?: string;
  storybookStory?: string;
  /** What the example is, for assistive technology, when no visible `title` names it. */
  label?: string;
  /** Cap the specimen's width on the stage only, as a CSS length (`measure="34rem"`). */
  measure?: string;
  /** Named span on the page's `.sk-layout-grid`, for an example that needs more room than the text. */
  width?: "narrow" | "content" | "breakout" | "full-width";
  /** With `variants` and `screen="xl"`: draw each variant in an isolated frame at that screen's width, shrunk to the card, with a line that says so. */
  /** Render in the isolated frame even when nothing else below asks for it. */
  isolate?: boolean;
  /** Reserve room for what paints out of flow: an open listbox (`menu`), a dialog or drawer (`overlay`). Isolates. */
  viewport?: "auto" | "menu" | "overlay" | "menu-deep";
  /** A fixed screen: the example sees a phone (`mobile`) or a tablet, for a pattern that only reads at that width. Isolates. */
  screen?: "xl" | "tablet" | "mobile";
  /** No stage padding: the example reaches the card's edges. Isolates. */
  flush?: boolean;
  /** Let the stage scroll instead of growing to its content. Isolates. */
  scroll?: boolean;
  /** App-only TypeScript run in the frame once the example mounts (`demos/scripts/*.ts`). Isolates. */
  script?: string;
  /**
   * No card around the example: for an anatomy diagram, which is already a complete surface
   * (`Annotated` owns its canvas, legend, border and corners). Isolates.
   */
  bare?: boolean;
}

const {
  tree: givenTree,
  optionName,
  variants,
  initialVariant,
  variantsLabel,
  toggleLabel,
  target = [],
  title,
  description,
  caption,
  explain,
  labels,
  stageMinBlockSize,
  remountOnChange,
  css,
  storybookTitle,
  storybookStory,
  label,
  measure,
  width,
  isolate = false,
  viewport = "auto",
  flush = false,
  scroll = false,
  script,
  bare = false,
  screen,
} = Astro.props;
const authoredTree = (givenTree ?? variants?.[0]?.tree)!;
/*
 * AN ANATOMY DIAGRAM IS LOOKED AT, NOT EXPLORED: no zoom bar, no gestures, no tab stop on the canvas,
 * the drawing fitted and centred. That is `Annotated`'s own `fitOnly`, set here once for every bare
 * anatomy rather than in each of the trees that draw one.
 */
const anatomy = bare && authoredTree.contract === "annotation" && authoredTree.signature === "Annotated";
const tree = anatomy ? { ...authoredTree, options: { ...authoredTree.options, fitOnly: true } } : authoredTree;
/* A fixed screen is the card's own authoring decision, so the root says which (the enhancer keeps it
   instead of falling back to "free"). `xl` is drawn at 840px, just past the 52rem desktop query. */
const screenRoot = screen
  ? {
      "data-sk-component-preview-screen-local": screen,
      style: screen === "xl" ? `--sk-component-preview-screen-xl: ${variants ? 1200 : 840}px;` : undefined,
    }
  : {};
const framedStage = !optionName && !variants && (isolate || bare || flush || scroll || Boolean(script) || Boolean(screen) || viewport !== "auto");
const t = useTranslations(getLocale(Astro.url));

let values: readonly string[] = [];
let defaultValue = "";
let segmentLabels: Record<string, string> = {};
let isBoolean = false;
let onValue: string | undefined;
let explainByValue: Record<string, string> | undefined = explain;
/* The option list for the node a path names. A collection ENTRY (`items: [{ options, slots }]`) is
   data, not a tree: it has no contract of its own, so its options are the ones its owner's slot
   declares for every entry (`ContractSlot.item.options`). */
const optionsAt = (path: TreePath): { owner: string; options: readonly (readonly [string, ContractOption])[] } => {
  const node = nodeAt(tree, path);
  if (!node) throw new Error(`UsagePreview: the target path ${JSON.stringify(path)} leaves the tree.`);
  const entry = !node.contract && typeof path.at(-1) === "number" && typeof path.at(-2) === "string";
  const owner = entry ? nodeAt(tree, path.slice(0, -2)) : node;
  if (!owner) throw new Error(`UsagePreview: the target path ${JSON.stringify(path)} leaves the tree.`);
  const contract = getContract(owner.contract);
  if (!contract) throw new Error(`UsagePreview: no contract "${owner.contract}".`);
  const signature = getSignature(contract, owner.signature);
  if (!signature) throw new Error(`UsagePreview: no signature "${owner.signature}" on "${owner.contract}".`);
  if (!entry) return { owner: owner.signature, options: signatureOptions(contract, signature) };
  const slotName = path.at(-2) as string;
  const item = signature.slots?.[slotName]?.item;
  if (!item) throw new Error(`UsagePreview: "${owner.signature}" has no collection "${slotName}".`);
  return { owner: `${owner.signature} ${slotName}`, options: Object.entries(item.options) };
};

if (optionName) {
  const node = nodeAt(tree, target)!;
  const { owner, options } = optionsAt(target);
  const found = options.find(([name]) => name === optionName);
  if (!found) throw new Error(`UsagePreview: "${owner}" declares no option "${optionName}".`);
  const [, option] = found;
  isBoolean = option.type === "boolean";
  /* A string option can borrow another contract's enum (`valuesFrom`: Menu's `triggerVariant` is
     Button's `variant`), so its values and default are read from there, never retyped here. */
  const borrowed = option.valuesFrom ? getContract(option.valuesFrom.contract)?.options?.[option.valuesFrom.option] : undefined;
  const enumOption = option.type === "enum" ? option : borrowed?.type === "enum" ? borrowed : undefined;
  if (!isBoolean && !enumOption?.values) {
    throw new Error(`UsagePreview: "${optionName}" is a "${option.type}" option, neither an enum nor a boolean.`);
  }
  /* An enum with ONE value is a switch: the option is either absent or that value (`density`'s only
     value is `compact`). It plays as off/on, and the one value is what "on" writes into the tree. */
  const switchValue = !isBoolean && enumOption!.values!.length === 1 ? enumOption!.values![0] : undefined;
  values = isBoolean || switchValue ? ["false", "true"] : enumOption!.values!;
  defaultValue = switchValue
    ? String(node.options?.[optionName] === switchValue)
    : String(node.options?.[optionName] ?? option.default ?? enumOption?.default ?? values[0]);
  onValue = switchValue;
  segmentLabels = Object.fromEntries(values.map((value) => [value, labels?.[value] ?? value.charAt(0).toUpperCase() + value.slice(1)]));
}

if (variants) {
  values = variants.map(({ value }) => value);
  defaultValue = initialVariant ?? values[0]!;
  segmentLabels = Object.fromEntries(variants.map(({ value, label: optionLabel }) => [value, optionLabel]));
  explainByValue = Object.fromEntries(variants.filter(({ explain }) => explain).map(({ value, explain }) => [value, explain!]));
}

const codeStory = storybookTitle && storybookStory ? resolveStorybookStory(storybookTitle, storybookStory) : null;
if (storybookTitle && storybookStory && !codeStory) {
  throw new Error(`UsagePreview: no published Storybook story for "${storybookTitle}" / "${storybookStory}".`);
}
const reactCodeHref = codeStory ? storybookDocsUrl(storybookReactUrl, codeStory.title, codeStory.story) : null;
const vanillaCodeHref = codeStory ? storybookDocsUrl(storybookVanillaUrl, codeStory.title, codeStory.story) : null;
const codeHref = reactCodeHref;
const hasCodeMenu = Boolean((optionName || variants) && (reactCodeHref || vanillaCodeHref));
const codeIcon = iconMarkup("code", { size: "sm" });
const id = title ? `usage-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}` : undefined;
/* A scope per card, stable across builds: the same tree and css always get the same attribute. */
/* The frame's settings, when the example renders in one. Its script is COMPILED here: the frame runs
   JavaScript, and a demo script is authored in TypeScript. */
const frameOptions = framedStage
  ? { flush: flush || anatomy, scroll, viewport, minHeight: stageMinBlockSize, css, screen, script: script ? compileDemoScript(script) : undefined }
  : undefined;
const scope = css ? `u${[...(css + JSON.stringify(tree))].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7).toString(36)}` : undefined;
---

<section
  class:list={["sk-preview-section", (optionName || variants) && "sk-usage-preview--controlled", framedStage && viewport === "overlay" && "sk-preview-section--overlay-stage"]}
  data-width={width}
  {...(id ? { "aria-labelledby": id } : label ? { "aria-label": label } : {})}
>
  {title && <h3 id={id}>{title}</h3>}
  {description && <p class="sk-preview-section__description" set:html={description} />}
  {scope && !framedStage && <style is:inline set:html={`[data-usage-scope="${scope}"] { ${css} }`} />}
  {
    framedStage && bare ? (
      <div class="sk-component-preview" data-sk-component-preview data-sk-component-preview-chrome="false" data-sk-component-preview-surface="none" {...screenRoot}>
        <TreeDemo client:visible tree={tree} measure={measure} frameOptions={frameOptions} />
      </div>
    ) : (
      <div
        class="sk-preview-card"
        data-usage-scope={framedStage ? undefined : scope}
        style={stageMinBlockSize ? `--sk-preview-card-stage-min-block-size: ${stageMinBlockSize};` : undefined}
      >
        {
          hasCodeMenu ? (
            <details class="sk-preview-card__code-menu">
              <summary class="sk-preview-card__code-link sk-interactive" aria-label={`${t("preview.viewCode")} (${title ?? label ?? optionName})`}>
                <Fragment set:html={codeIcon} />
              </summary>
              <div class="sk-preview-card__code-menu-panel">
                {vanillaCodeHref && (
                  <a href={vanillaCodeHref} rel="noreferrer" target="_blank">
                    {t("preview.storybookVanillaAction")}
                  </a>
                )}
                {reactCodeHref && (
                  <a href={reactCodeHref} rel="noreferrer" target="_blank">
                    {t("preview.storybookReactAction")}
                  </a>
                )}
              </div>
            </details>
          ) : codeHref ? (
            <a class="sk-preview-card__code-link" href={codeHref} rel="noreferrer" target="_blank" aria-label={`${t("preview.viewCode")} (${title ?? label ?? optionName})`}>
              <Fragment set:html={codeIcon} />
            </a>
          ) : null
        }
        {
          optionName || variants ? (
            <div
              class:list={[variants && screen === "xl" && "sk-component-preview"]}
              {...(variants && screen === "xl"
                ? { "data-sk-component-preview": "", "data-sk-component-preview-chrome": "false", "data-sk-component-preview-surface": "none", ...screenRoot }
                : {})}
            >
            <PropertyPlayground
              client:visible
              tree={tree}
              optionName={optionName}
              toggleLabel={toggleLabel}
              trees={variants && Object.fromEntries(variants.map(({ value, tree: variantTree }) => [value, variantTree]))}
              target={target}
              values={values}
              boolean={isBoolean}
              onValue={onValue}
              defaultValue={defaultValue}
              labels={segmentLabels}
              controlLabel={variantsLabel ?? title ?? optionName ?? label ?? ""}
              explain={explainByValue}
              remountOnChange={remountOnChange}
              frame={variants && screen === "xl"
                ? { screen: "xl", width: 1200, flush, css, note: t("preview.scaledNote") }
                : isolate || viewport !== "auto"
                  ? { flush, css, viewport, minHeight: stageMinBlockSize }
                  : undefined}
              isolatedFrame={screen !== "xl" && (isolate || viewport !== "auto" || Boolean(script)) ? { flush, scroll, viewport, minHeight: stageMinBlockSize, css, screen, script: script ? compileDemoScript(script) : undefined } : undefined}
            />
            </div>
          ) : framedStage ? (
            <>
              <div class="sk-component-preview" data-sk-component-preview data-sk-component-preview-chrome="false" data-sk-component-preview-surface="none" {...screenRoot}>
                <TreeDemo client:visible tree={tree} measure={measure} frameOptions={frameOptions} />
              </div>
              {caption && <p class="sk-preview-card__caption" set:html={caption} />}
            </>
          ) : (
            <>
              <ExampleStage client:visible tree={tree} measure={measure} />
              {caption && <p class="sk-preview-card__caption" set:html={caption} />}
            </>
          )
        }
      </div>
    )
  }
</section>

<style>
  /* The card itself is `preview-card.css`; only the optional control and crossfading sentence are
     this component's own. */
  .sk-usage-preview--controlled :global(.sk-property-playground) {
    display: grid;
    gap: var(--space-stack-lg);
  }

  /* Where the control will be, before React draws it: the `lg` track's own height. */
  .sk-usage-preview--controlled :global(.sk-property-playground__control-slot) {
    block-size: var(--size-control-lg);
  }

  /* The control sits at the start, not stretched across the card; the example is what is centred. */
  .sk-usage-preview--controlled :global(.sk-property-playground__control) {
    justify-self: start;
    max-inline-size: 100%;
    overflow-x: auto;
  }

  /*
   * THE SENTENCE UNDER THE EXAMPLE crossfades when the value changes, and does nothing else: no
   * travel, no blur, which read as the text jumping. All of them share one grid cell (see
   * property-playground.tsx), so the cell keeps the height of the longest and the card never
   * jumps; the one leaving and the one arriving fade over the same time on the same curve, so they
   * cross evenly with no dip in the middle. Half again the system's enter duration: slower than a
   * control's state change, since this is a sentence to read, and it shortens with the token under
   * `prefers-reduced-motion`.
   */
  .sk-usage-preview--controlled :global(.sk-property-playground__explain) {
    --sk-property-preview-fade: calc(var(--motion-enter-duration) * 1.5);

    display: grid;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .sk-usage-preview--controlled :global(.sk-property-playground__explain > p) {
    grid-area: 1 / 1;
    margin: 0;
    text-wrap: balance;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--sk-property-preview-fade) var(--motion-state-change-easing),
      visibility 0s linear var(--sk-property-preview-fade);
  }

  .sk-usage-preview--controlled :global(.sk-property-playground__explain > p[data-active]) {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--sk-property-preview-fade) var(--motion-state-change-easing),
      visibility 0s;
  }
</style>
