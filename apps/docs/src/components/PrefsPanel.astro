---
/*
 * Desktop reader preferences: the design system's Popover, dropped from the header's Preferences button.
 *
 * Nothing here is drawn by the site: the panel is a bare Popover laid out with Stack and Separator,
 * the mode a Segmented, the contrast a Switch, the language a second Segmented, and the swatches are
 * the palette Popover's (`.dimensions__palette-option`). They are thin fronts for the toggles the site already runs
 * (`Base.astro` scripts): the mode and contrast controls press the hidden header-cluster toggles
 * until the state matches, and the swatches carry `data-docs-palette-set`, which the palette script
 * already listens for. Phones keep `#docs-prefs-sheet`.
 */
import { emitMarkup } from "@skryensya/ai-compiler/emit";
import type { UsageTree } from "@skryensya/core/usage-tree";
import { availableLocales, canonicalPath, getLocale, localeNames, localizePath, useTranslations } from "../i18n";
import { iconMarkup } from "../icons";

interface Props {
  presets: { id: string; name: string; accent: string }[];
}

const { presets } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const current = getLocale(Astro.url);
const canonical = canonicalPath(Astro.url.pathname);
const locales = availableLocales(canonical);
const hrefs = Object.fromEntries(locales.map((locale) => [locale, localizePath(canonical, locale)]));
/* The messages read "Mode: dark"; the group already says what it is, so keep the word after the colon. */
const word = (text: string) => {
  const tail = text.split(":").pop()!.trim();
  return tail.charAt(0).toUpperCase() + tail.slice(1);
};
const modes = [
  { value: "system", label: word(t("prefs.modeSystem")) },
  { value: "light", label: word(t("prefs.modeLight")) },
  { value: "dark", label: word(t("prefs.modeDark")) },
];

const [before = "", mid = "", after = ""] = emitMarkup(
  {
    contract: "popover",
    signature: "Popover.bare",
    options: {
      panelId: "docs-prefs-pop",
      bare: true,
      triggerLabel: t("prefs.title"),
      triggerVariant: "ghost",
      triggerSize: "sm",
      triggerIconOnly: true,
      placement: "block-end",
    },
    slots: { trigger: "@@", children: "@@" },
  } as UsageTree,
  { fillDefaults: false },
).split("@@");

/* Words a screen reader needs and the eye does not: the icon or the code already says it on screen. */
const hidden = (text: string) => ({
  contract: "typography",
  signature: "Text",
  options: { textElement: "span" },
  attrs: { class: "sk-visually-hidden" },
  children: text,
});

const modeControl = emitMarkup(
  {
    contract: "segmented",
    signature: "Segmented",
    options: { value: "system", label: t("prefs.theme"), size: "sm", fill: true, iconLabel: "tooltip" },
    attrs: { id: "docs-prefs-mode" },
    slots: { items: modes.map((mode) => ({ options: { value: mode.value }, slots: { label: [{ contract: "icon", signature: "Icon", options: { name: `mode-${mode.value}`, size: "sm" } }, hidden(mode.label)] } })) },
  } as UsageTree,
  { fillDefaults: false },
);

const contrastControl = emitMarkup(
  { contract: "switch", signature: "Switch", attrs: { id: "docs-prefs-contrast" }, children: t("prefs.contrast") } as UsageTree,
  { fillDefaults: false },
);

/* Row names and the palette's current name: the kit's Text, so nothing here needs a stylesheet. */
const rowLabel = (text: string) =>
  emitMarkup({ contract: "typography", signature: "Text", options: { size: "sm", textElement: "span" }, children: text } as UsageTree, { fillDefaults: false });
const paletteName = emitMarkup(
  {
    contract: "typography",
    signature: "Text",
    options: { size: "caption", tone: "secondary", textElement: "span" },
    /* Filled by Base.astro's palette script. */
    attrs: { "data-docs-palette-name": "" },
    children: "",
  } as UsageTree,
  { fillDefaults: false },
);

/* Between topics, so not decorative; the Stack around it already spaces it. */
const separator = emitMarkup({ contract: "separator", signature: "Separator", options: { tone: "subtle", spacing: "none" } } as UsageTree, {
  fillDefaults: false,
});

const languageControl = emitMarkup(
  {
    contract: "segmented",
    signature: "Segmented",
    options: { value: current, label: t("prefs.language"), size: "sm", fill: true },
    attrs: { id: "docs-prefs-language" },
    slots: { items: locales.map((locale) => ({ options: { value: locale }, slots: { label: [locale.toUpperCase(), hidden(localeNames[locale])] } })) },
  } as UsageTree,
  { fillDefaults: false },
);
---

<Fragment set:html={before} /><Fragment set:html={iconMarkup("settings")} /><Fragment set:html={mid} />
<div class="sk-stack" data-gap="sm">
  <section class="sk-stack" data-gap="sm">
    <div class="sk-stack" data-gap="xs">
      <Fragment set:html={rowLabel(t("prefs.theme"))} />
      <Fragment set:html={modeControl} />
    </div>
  </section>

  <Fragment set:html={separator} />

  <section class="sk-stack" data-gap="xs">
    <div class="sk-inline" data-justify="between" data-align="baseline" data-wrap="false">
      <Fragment set:html={rowLabel(t("prefs.palette"))} />
      <Fragment set:html={paletteName} />
    </div>
    <div class="dimensions__palette-options" role="group" aria-label={t("prefs.palette")}>
      {
        presets.map((preset) => (
          <button
            type="button"
            class="dimensions__palette-option"
            data-docs-palette-set={preset.id}
            style={`--swatch: ${preset.accent}`}
            title={preset.name}
            aria-label={preset.name}
            aria-pressed="false"
          />
        ))
      }
    </div>
  </section>

  {
    locales.length > 1 && (
      <Fragment>
        <Fragment set:html={separator} />
        <section class="sk-stack" data-gap="xs" data-hrefs={JSON.stringify(hrefs)} id="docs-prefs-language-row">
          <Fragment set:html={rowLabel(t("prefs.language"))} />
          <Fragment set:html={languageControl} />
        </section>
      </Fragment>
    )
  }

  <Fragment set:html={separator} />
  <section class="sk-stack" data-gap="xs">
    <Fragment set:html={contrastControl} />
  </section>
</div>
<Fragment set:html={after} />
