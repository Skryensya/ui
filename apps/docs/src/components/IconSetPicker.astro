---
/*
 * The reader's icon set: the kit's Select over the sets the site has written (`lib/icon-set-options`).
 * `data-docs-icon-set-select` is the hook Base.astro's icon-set script wires; this only draws it, in the
 * popover's row shape or as a tile for the phone sheet, beside the other preferences.
 */
import { emitMarkup } from "@skryensya/ai-compiler/emit";
import type { UsageTree } from "@skryensya/core/usage-tree";
import type { IconSet } from "@skryensya/core/icon";
import { iconMarkup } from "../icons";
import { defaultIconSet, siteIconSets } from "../lib/icon-set-options";

interface Props {
  label: string;
  description?: string;
  tile?: boolean;
}

const { label, description, tile = false } = Astro.props;
/* Six glyphs of each set under its name, drawn at build from the set's own geometry: choosing a style
   blind is guessing. `data-icon-set-fixed` keeps the repaint from redrawing them in the CURRENT set, and
   `data-preview-set` lets the duotone tint (site.css) find its own set's second layer. */
const sets = import.meta.glob<{ icons: IconSet }>("../icon-sets/*.ts", { eager: true });
const PREVIEW_ROLES = ["home", "search", "settings", "user", "calendar", "folder"] as const;
const preview = (setId: string) =>
  `<span class="docs-icon-preview" data-icon-set-fixed data-preview-set="${setId}">${PREVIEW_ROLES.map((role) => iconMarkup(role, { size: "md", set: sets[`../icon-sets/${setId}.ts`]!.icons })).join("")}</span>`;

const id = tile ? "docs-icon-set-sheet" : "docs-icon-set-panel";

const select = emitMarkup(
  {
    contract: "select",
    signature: "Select",
    options: { value: defaultIconSet },
    attrs: { id, "data-docs-icon-set-select": "" },
    slots: { label, items: siteIconSets.map((set) => ({ options: { value: set.id }, slots: { label: `${set.label}@@${set.id}@@` } })) },
  } as UsageTree,
  { fillDefaults: false },
).replace(/@@([\w-]+)@@/g, (_, setId: string) => preview(setId));
const hint = description
  ? emitMarkup({ contract: "typography", signature: "Text", options: { size: "caption", tone: "secondary", textElement: "span" }, children: description } as UsageTree, { fillDefaults: false })
  : "";
---

{
  tile ? (
    <div class="sk-tile docs-prefs-tile sk-stack" data-padding="md" data-gap="xs">
      <Fragment set:html={select} />
      <Fragment set:html={hint} />
    </div>
  ) : (
    <Fragment set:html={select} />
  )
}
