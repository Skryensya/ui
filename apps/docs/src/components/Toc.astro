---
/*
 * "En esta página", rendered from the same TOC contract used in every consumer — and now with
 * NOTHING added on top of it. This used to hand-write three things the contract could not express:
 * `data-sk-toc-rail` (a magic string that was never in `tocAttrs`), `open` on the `<details>`, and
 * the disclosure markup around the list. The component ships the always-open index itself now, so
 * the docs shell is an ordinary consumer again: the only thing left here is `sk-scrollbar` and the
 * build-time state flags below, none of which change the component's shape.
 *
 * The list is compiled with the page from `document-index.ts`. Hero-tab pages index the default
 * (`usage`) panel the same way; only a `?tab=` deep link still fills from the browser.
 */
import { tocParts } from "@skryensya/core/toc";
import type { StableIconName } from "@skryensya/core/icon";
import { iconMarkup } from "../icons";
import { getLocale, useTranslations } from "../i18n";

type TocItem = {
  href: string;
  label: string;
  level?: "h2" | "h3";
  current?: boolean;
  icon?: StableIconName;
};

interface Props {
  items?: readonly TocItem[];
  title?: string;
  /**
   * A script will fill this list, so hold the reserved column in its skeleton state instead of
   * declaring an empty document. The hero-tabs pilot is the only page that asks for it: its index
   * is per tab, which is a fact about a reader and not about the document.
   */
  pending?: boolean;
  /**
   * Place this Toc as `sk-layout-grid`'s own published rail column (`data-width="rail"`,
   * `packages/core/css/patterns/layout.css`) — a separate opt-in from `data-sk-toc-rail` above,
   * which controls the component's OWN sticky/width CSS regardless of what grid it sits in. A
   * caller only needs this when the Toc is actually a direct child of a `sk-layout-grid`.
   */
  rail?: boolean;
}

const t = useTranslations(getLocale(Astro.url));
const { items = [], title = t("toc.title"), pending = false, rail = false } = Astro.props;
---

<aside
  class={`${tocParts.root} sk-scrollbar`}
  data-sk-toc
  data-width={rail ? "rail" : undefined}
  data-ready={pending ? undefined : ""}
  data-empty={!pending && items.length === 0 ? "" : undefined}
>
  <nav class={tocParts.nav} aria-label={title}>
    <h2 class={tocParts.title} data-flush>{title}</h2>
    <ul class={tocParts.list} role="list">
      {
        items.map((item) => (
          <li
            class={tocParts.item}
            data-level={item.level ?? "h2"}
          >
            <a
              aria-current={item.current ? "location" : undefined}
              class={`${tocParts.link} sk-interactive`}
              href={item.href}
            >
              {item.icon && (
                <span class={tocParts.icon}>
                  <Fragment set:html={iconMarkup(item.icon, { size: "sm" })} />
                </span>
              )}
              <span class={tocParts.label}>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
