---
import { Code } from "astro:components";
import { codePreviewAttrs, codePreviewParts } from "@skryensya/core/code-preview";
import "@skryensya/core/components/code-preview.css";
import CopyButton from "./CopyButton.astro";
import { iconMarkup } from "../icons";
import { getLocale, useTranslations } from "../i18n";
import { syntaxThemes } from "../lib/syntax-theme";

export type CodeLanguage = "bash" | "css" | "html" | "json" | "svelte" | "ts" | "tsx" | "yaml";

interface Props {
  /** Visible source. When `full` is set, this is the condensed view. */
  code: string;
  /**
   * Complete source for the Full toggle. Copy always uses this when present. The hidden Full panel
   * ships as escaped text instead of a second Shiki tree; syntax highlighting is paid once.
   */
  full?: string;
  label?: string;
  note?: string;
  lang?: CodeLanguage;
  /**
   * Show the whole thing, however long it is, with no Expand control.
   *
   * Disclosure is right when the code is an EXAMPLE beside prose, where a hundred lines would bury
   * the paragraph after it. It is wrong when the code IS the page: a reference whose one job is to
   * show a contract should not open showing a sixth of it behind a button.
   */
  open?: boolean;
  /**
   * Override the disclosure's visible text (default: "Expandir"/"Contraer" or the English
   * equivalent). A consumer whose collapsed state shows NOTHING (`ComponentPreview`'s own embedded
   * source, see that component's own override in `component-preview.css`) needs the control itself
   * to say what is behind it  -  plain "Expand" reads as a size toggle when there is no peek of code
   * to already answer that. The generic wording elsewhere still has a visible line or two doing
   * that job, so it is left alone.
   */
  expandLabel?: string;
  collapseLabel?: string;
  /**
   * Collapse regardless of line count, even a two-line snippet: for a consumer where EVERY
   * instance must behave the same way whether the source is 3 lines or 300 (`ComponentPreview`'s
   * own embedded panels), the length-based threshold below is exactly the inconsistency that
   * reads as two different controls on the same page  -  one snippet gets a disclosure, its
   * neighbour just shows in full, for a difference the reader never asked about.
   */
  forceCollapsible?: boolean;
}

const {
  code,
  full,
  label,
  note,
  lang,
  open = false,
  expandLabel,
  collapseLabel,
  forceCollapsible = false,
} = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const condensed = code.trim();
const complete = full?.trim();
const hasDensity = Boolean(complete);
const condensedId = `code-${crypto.randomUUID()}`;
const fullId = `code-${crypto.randomUUID()}`;
const fullSourceId = `code-source-${crypto.randomUUID()}`;
const copyTargetId = complete ? fullSourceId : condensedId;
const condensedLines = condensed ? condensed.split(/\r\n|\r|\n/).length : 0;
const fullLines = complete ? complete.split(/\r\n|\r|\n/).length : 0;
const previewLineCount = 15;
const lineThreshold = 20;
/* Condensed can still be long (shell + a few rows). Disclose it the same way as Full. */
/* `open` short-circuits BOTH, not just the flag below: they are what the collapsed-window CSS keys
   on, and leaving either set would size a scroll region for a block that no longer has a toggle. */
const condensedCollapsible = !open && hasDensity && (forceCollapsible || condensedLines > lineThreshold);
const fullCollapsible =
  !open && (forceCollapsible || (complete ? fullLines > lineThreshold : condensedLines > lineThreshold));
const isCollapsible = condensedCollapsible || fullCollapsible;
const collapsibleLineCount = hasDensity
  ? condensedCollapsible
    ? condensedLines
    : fullLines
  : condensedLines;
const collapsibleTargetId = hasDensity && condensedCollapsible ? condensedId : complete ? fullId : condensedId;

/* The same anatomy `codePreviewContract` (`CodePreview.density`) declares, written by hand because
 * Shiki's highlighted output has to land as real markup: a usage tree has no channel for that, only
 * for text or composed signatures (see `contracts/NOT-PUBLISHED.md`, the `command-palette` entry, for
 * the general shape of that limit). The classes and data-attributes below are the contract's own. */
const rootAttrs: Record<string, string | undefined> = {
  [codePreviewAttrs.root]: "",
  [codePreviewAttrs.density]: hasDensity ? "condensed" : undefined,
  [codePreviewAttrs.collapsible]: isCollapsible ? "" : undefined,
  [codePreviewAttrs.condensedCollapsible]: condensedCollapsible ? "" : undefined,
  [codePreviewAttrs.expanded]: isCollapsible ? "false" : undefined,
  [codePreviewAttrs.lines]: isCollapsible ? String(complete ? fullLines : condensedLines) : undefined,
  [codePreviewAttrs.condensedLines]: condensedCollapsible ? String(condensedLines) : undefined,
  [codePreviewAttrs.previewLines]: isCollapsible ? String(previewLineCount) : undefined,
  [codePreviewAttrs.hidesWhenCollapsed]: forceCollapsible ? "" : undefined,
};

/*
 * `forceCollapsible` drops the count/target-bearing attrs below: those exist to say WHICH block
 * expands and to WHAT SIZE, and both questions stop making sense the moment this same button also
 * has to stand in for however many sibling files a `ComponentPreview` tabs group holds (see that
 * component's own `connectSourceToggle`)  -  a single count would be honest for one file and simply
 * wrong for the other two. Keeping the SAME reduced attribute set on every instance, one file or
 * three, is what makes the control read as one thing rather than two that happen to look alike.
 */
const toggleAttrs: Record<string, string> = {
  [codePreviewAttrs.toggle]: "",
  [codePreviewAttrs.expandedLabel]: collapseLabel ?? t("code.collapse"),
  ...(forceCollapsible
    ? {}
    : {
        [codePreviewAttrs.expandedAriaLabel]: t("code.collapseTo", { count: String(previewLineCount) }),
        /* Deliberately un-interpolated: `{count}` stays in the string so the enhancer can fill it
           when the density switch swaps which panel, and so which line count. Is on screen. */
        [codePreviewAttrs.linesLabel]: t("code.lines"),
      }),
};

/*
 * WHICH PANEL BECOMES A SCROLL REGION, mirroring the three selectors in code-preview.css: Condensed
 * gets the collapsed window only under `[condensed-collapsible]`, and the single no-density panel
 * gets it under `[collapsible]`.
 *
 * It matters here because a region that scrolls has to be reachable by keyboard. The same reasoning
 * `TableScroll` records in core/src/table.ts, and a focusable region has to be named.
 * `role="group"`, not `region`: `pre` maps to `generic`, which drops `aria-label` on the floor, so
 * SOME role is needed to hold the name; `region` would hold it too, but it is a landmark, and a docs
 * page with ten code blocks does not want ten more entries in a screen reader's landmark rotor.
 */
const condensedScrolls = hasDensity ? condensedCollapsible : isCollapsible;
const fullScrolls = isCollapsible;
const regionName = label ? t("code.region", { label }) : t("code.regionPlain");
/*
 * `inert` starts present whenever this panel both scrolls AND hides completely while collapsed
 * (`forceCollapsible`): the block always opens collapsed (`expanded` is SSR'd `"false"`), so a
 * reader tabbing through the page must not land on a region that is, at that exact moment, zero
 * height and invisible. `connectCodePreview` flips it off the instant the panel actually expands,
 * and back on when it collapses again  -  see that enhancer's own comment for why one attribute
 * covers both the accessibility tree and Tab reachability in one move, rather than juggling
 * `tabindex`/`role`/`aria-label` separately. A real peek-window panel (`forceCollapsible` false)
 * never gets it: it stays genuinely visible and scrollable at rest, exactly as before.
 */
const scrollRegionAttrs = (scrolls: boolean) => ({
  tabindex: scrolls ? 0 : -1,
  role: scrolls ? ("group" as const) : undefined,
  "aria-label": scrolls ? regionName : undefined,
  inert: scrolls && forceCollapsible ? true : undefined,
});

/* The shared CodePreview CSS consumes Shiki's conventional `light`/`dark` variable names.
   `light-dark()` then follows the page color mode without a brand or docs-only selector.
   The palette itself is `syntax-theme.ts`'s, derived from the same token ramps the site uses so
   code samples stay part of the system rather than falling back to a stock Shiki theme. */
const themes = syntaxThemes;

/* Labels describe the consumer-facing artifact, so they are the most stable language signal. Neither
   "JavaScript" nor "TypeScript" contains "JS" as a substring, so both are matched explicitly; the
   content fallback keeps existing call sites highlighted while new examples can be explicit. */
const language =
  lang ??
  (label === "terminal"
    ? "bash"
    : label?.includes("CSS") || label?.endsWith(".css") || label?.endsWith(".scss") || condensed.startsWith("@import")
      ? "css"
      : label?.includes("React") || label === "API declarativa"
        ? "tsx"
        : label?.includes("JavaScript") || label?.includes("TypeScript") || label?.includes("JS") || label === "Progressive enhancement" || condensed.startsWith("import ") || condensed.startsWith("const ")
          ? "ts"
          : "html");
const toggleIcon = iconMarkup("chevron-down", { size: "sm" });
---

<div class={codePreviewParts.root} {...rootAttrs}>
  {
    (label || note || hasDensity) && (
      <div class={codePreviewParts.label}>
        <span class={codePreviewParts.meta}>
          {label && <span>{label}</span>}
          {note && <span>{note}</span>}
        </span>
        {
          hasDensity && (
            <div class={codePreviewParts.density}>
              <span class={codePreviewParts.densityEdge} data-density="condensed">
                {t("code.condensed")}
              </span>
              <label class="sk-switch">
                <input
                  class="sk-switch__input"
                  type="checkbox"
                  role="switch"
                  {...{ [codePreviewAttrs.densityInput]: "" }}
                  aria-label={t("code.showFull")}
                />
                <span class="sk-switch__control" aria-hidden="true">
                  <span class="sk-switch__thumb"></span>
                </span>
              </label>
              <span class={codePreviewParts.densityEdge} data-density="full">
                {t("code.full")}
              </span>
            </div>
          )
        }
      </div>
    )
  }
  <div class={codePreviewParts.preview}>
    <div class={codePreviewParts.viewport} id={condensedId} {...{ [codePreviewAttrs.densityPanel]: "condensed" }}>
      <Code code={condensed} lang={language} themes={themes} defaultColor={false} {...scrollRegionAttrs(condensedScrolls)} />
    </div>
    {
      complete && (
        <>
          <div
            class={codePreviewParts.viewport}
            id={fullId}
            data-sk-code-preview-source-template={fullSourceId}
            {...{ [codePreviewAttrs.densityPanel]: "full" }}
            {...scrollRegionAttrs(fullScrolls)}
          />
          <template id={fullSourceId}>{complete}</template>
        </>
      )
    }
    {/* Copy always reads the full source when one exists. */}
    <CopyButton target={copyTargetId} />
  </div>
  {
    isCollapsible && (
      <div
        class={codePreviewParts.more}
        {...{ [codePreviewAttrs.more]: "" }}
        hidden={hasDensity && !condensedCollapsible ? true : undefined}
      >
        <button
          class={`sk-button sk-interactive ${codePreviewParts.toggle}`}
          data-variant="ghost"
          data-size="sm"
          type="button"
          aria-controls={forceCollapsible ? undefined : collapsibleTargetId}
          aria-expanded="false"
          aria-label={forceCollapsible ? undefined : t("code.expandTo", { count: String(collapsibleLineCount) })}
          {...toggleAttrs}
        >
          <span {...{ [codePreviewAttrs.toggleLabel]: "" }}>{expandLabel ?? t("code.expand")}</span>
          {
            !forceCollapsible && (
              <span class={codePreviewParts.toggleCount} aria-hidden="true">
                {t("code.lines", { count: String(collapsibleLineCount) })}
              </span>
            )
          }
          <span class={codePreviewParts.toggleIcon} aria-hidden="true">
            <Fragment set:html={toggleIcon} />
          </span>
        </button>
      </div>
    )
  }
</div>

<script>
  import { mountCodePreview } from "@skryensya/vanilla/code-preview";

  mountCodePreview();
</script>
