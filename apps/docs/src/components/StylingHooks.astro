---
import { probeProp, tokens } from "../lib/tokens";
import { getLocale, useTranslations } from "../i18n";

type HookGroup = {
  /** CSS file path as emitted by @skryensya/core. */
  file: string;
  /** The real element that scopes each hook at runtime. */
  probe: string;
  /** Needed only when one documentation page owns several component surfaces. */
  title?: string;
};

interface Props {
  groups: readonly HookGroup[];
  heading?: string;
}

const { groups, heading = "Styling hooks" } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const resolvedGroups = groups.map((group) => ({
  ...group,
  hooks: tokens.filter((token) => token.file === group.file).map((token) => ({ ...token, prop: probeProp(token.value) })),
}));
---

<h2>{heading}</h2>
<p>
  {t("hooks.intro")}
</p>

{
  resolvedGroups.map((group) => (
    <>
      {resolvedGroups.length > 1 && <h3>{group.title ?? group.probe}</h3>}
      <div class="sk-table-scroll">
        <table class="sk-table">
          <thead>
            <tr>
              <th>Hook</th>
              <th>
                {t("hooks.authored")} <span class="count">· build</span>
              </th>
              <th>
                {t("hooks.used")} <span class="count">· runtime</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              group.hooks.map((hook) => (
                <tr>
                  <td class="mono">{hook.name}</td>
                  <td class="mono">{hook.value}</td>
                  <td class="mono" data-token={hook.name} data-prop={hook.prop} data-probe={group.probe}>
                    …
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </>
  ))
}
