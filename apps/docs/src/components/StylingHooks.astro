---
import { probeProp, slugId, tokens } from "../lib/tokens";
import { getLocale, useTranslations } from "../i18n";
import CopyCells from "./CopyCells.astro";

export type HookGroup = {
  /** CSS file path as emitted by @skryensya/core. */
  file: string;
  /** The real element that scopes each hook at runtime. */
  probe: string;
  /** Needed only when one documentation page owns several component surfaces. */
  title?: string;
};

interface Props {
  groups: readonly HookGroup[];
  heading?: string;
}

const { groups, heading = "Styling hooks" } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const resolvedGroups = groups.map((group) => ({
  ...group,
  hooks: tokens.filter((token) => token.file === group.file).map((token) => ({ ...token, prop: probeProp(token.value) })),
}));
---

<CopyCells />

<h2>{heading}</h2>
<p>
  {t("hooks.intro")}
</p>

{
  resolvedGroups.map((group) => (
    <>
      {resolvedGroups.length > 1 && <h3>{group.title ?? group.probe}</h3>}
      <div class="sk-table-scroll">
        <table class="sk-table">
          <thead class="sk-table__head">
            <tr class="sk-table__row">
              <th class="sk-table__header" scope="col">Hook</th>
              <th class="sk-table__header" scope="col">
                {t("hooks.definition")} <span class="count">build</span>
              </th>
              <th class="sk-table__header" scope="col">
                {t("hooks.resolvedValue")} <span class="count">runtime</span>
              </th>
            </tr>
          </thead>
          <tbody class="sk-table__body">
            {
              group.hooks.map((hook) => {
                const nameId = slugId("hook-name", group.file, hook.name);
                const defId = slugId("hook-def", group.file, hook.name);
                const valId = slugId("hook-val", group.file, hook.name);
                return (
                  <tr class="sk-table__row">
                    <td class="sk-table__cell mono sk-table__cell--copy">
                      <span id={nameId}>{hook.name}</span>
                    </td>
                    <td class="sk-table__cell mono sk-table__cell--copy">
                      <span id={defId} data-authored>{hook.value}</span>
                    </td>
                    <td class="sk-table__cell mono sk-table__cell--copy">
                      <span id={valId} data-token={hook.name} data-prop={hook.prop} data-probe={group.probe}>
                        …
                      </span>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </>
  ))
}
