---
/*
 * Header chrome: toggles high contrast. Preference lives in localStorage["sk"] under `contrast`
 * (FOUC + persistence listener). Faces and the morph are the Icon Toggle pattern.
 *
 * Global chrome uses `data-docs-contrast-toggle` and `:root[data-contrast]` (site.css). Lab
 * previews pass `scoped` so only a local root (the example stage) gets `data-contrast`.
 *
 * `tile`: the same control expanded into a full-width Tile Button for the mobile preference sheet
 * (`#docs-prefs-sheet`). Same enhancer hook (`data-docs-contrast-toggle`, `.dimensions__contrast-toggle`)
 * and the same direct-child `[data-face]` spans the morph CSS keys off; it swaps the `.sk-button`
 * icon-only skin for `sk-tile` + a visible `.sk-tile__title`, laid out by `.docs-prefs-tile` (site.css).
 *
 * The trailing edge's safe-area backing (`.docs-prefs-tile-chip`) is a real, empty SIBLING span,
 * not a `::before` on the button: confirmed live in actual Safari (not just Playwright's WebKit,
 * which did not reproduce it), a generated box placed into a CSS Grid cell by `grid-column`/
 * `grid-row` there does not reliably land in the same cell as a real sibling — it painted offset
 * from the icon it was supposed to sit behind. A real element sidesteps that outright, and being a
 * SIBLING rather than a wrapper keeps `[data-face]` a direct child of `.sk-icon-toggle`, which the
 * morph CSS requires.
 */
import { contrastHigh, contrastNormal, iconDataMarkup } from "../icons";
import { getLocale, useTranslations } from "../i18n";

interface Props {
  size?: "sm" | "md" | "lg";
  /** Do not write `:root`. The host toggles `data-contrast` on a local preview root. */
  scoped?: boolean;
  /** Render as a full-width Tile Button (mobile preference sheet) instead of an icon-only button. */
  tile?: boolean;
  /** Visible title shown inside the tile. Only read when `tile`. */
  label?: string;
  /** Secondary line under the title. Only read when `tile`. */
  description?: string;
}

const { size, scoped = false, tile = false, label, description } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const contrastNormalIcon = iconDataMarkup("contrast-normal", contrastNormal, {
  attrs: { "data-face": "normal", "data-contrast-icon": "normal" },
});
const contrastHighIcon = iconDataMarkup("contrast-high", contrastHigh, {
  attrs: { "data-face": "high", "data-contrast-icon": "high" },
});
---

<button
  class:list={[
    "sk-interactive sk-icon-toggle dimensions__contrast-toggle",
    tile ? "sk-tile sk-tile--interactive docs-prefs-tile" : "sk-button",
  ]}
  data-variant={tile ? undefined : "ghost"}
  data-icon-only={tile ? undefined : ""}
  data-size={tile ? undefined : size}
  data-padding={tile ? "md" : undefined}
  data-scope={tile ? "tile" : undefined}
  data-part={tile ? "root" : undefined}
  type="button"
  aria-pressed="false"
  aria-label={t("prefs.contrastNormal")}
  data-docs-contrast-toggle={scoped ? undefined : ""}
  data-contrast-toggle-scoped={scoped ? "" : undefined}
  data-label-normal={t("prefs.contrastNormal")}
  data-label-high={t("prefs.contrastHigh")}
>
  {
    tile && label && (
      <span class="sk-tile__content" data-part="content">
        <span class="sk-tile__title">{label}</span>
        {description && <span class="sk-tile__description">{description}</span>}
      </span>
    )
  }
  {tile && <span class="docs-prefs-tile-chip" aria-hidden="true"></span>}
  <Fragment set:html={contrastNormalIcon} />
  <Fragment set:html={contrastHighIcon} />
</button>
