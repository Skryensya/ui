---
/*
 * A source browser for the files a component owns, generalized off `AccordionSourceViewer`
 * (Accordion still uses this, through `ComponentPageShell`). The tree markup is built at build time
 * by `lib/source-tree.ts` from the `files` prop's paths, rather than pasted per component: see that
 * file for why the shape it emits is safe to generate rather than hand-author.
 */
import "@skryensya/core/components/tree-view.css";
import "@skryensya/core/patterns/icon.css";
import "@skryensya/core/components/sidebar.css";
import { buildSourceTree } from "../lib/source-tree";
import CodeBlock, { type CodeLanguage } from "./CodeBlock.astro";
import { getLocale, useTranslations } from "../i18n";

export interface SourceFile {
  /** Repo-relative path, e.g. `"packages/core/src/dialog.ts"`. Doubles as the tree's `data-value`. */
  id: string;
  source: string;
  language: CodeLanguage;
}

interface Props {
  /** The contract id: scopes the DOM ids and the resize handle's storage key. */
  id: string;
  /** Display name, for the labels that read "{name} files" / "Referencia de {name}". */
  title: string;
  files: readonly SourceFile[];
  /** Defaults to the first file. */
  initialFileId?: string;
}

const { id, title, files, initialFileId } = Astro.props;
const t = useTranslations(getLocale(Astro.url));

const initialFile = initialFileId ?? files[0]?.id;
const { treeHtml, expandedValue } = buildSourceTree(files.map((file) => file.id));
const treeLabelId = `${id}-source-tree-label`;
---

<div class="docs-source-viewer" data-source-viewer>
  {/*
    The rail is the Sidebar component: it already is a header, a scrolling middle and an edge that
    can be dragged, which is exactly what this was reimplementing by hand (its own padding, its own
    border, its own `max-block-size` and scrollbar on the tree).

    No trigger, and that is legal: the enhancer accepts a sidebar whose only control is the resize
    handle. Collapsing this one to a rail of icons would leave a file browser with no filenames.

    `data-storage-key` remembers the width per reader, which is worth more here than in the nav rail:
    the widths that matter depend on how long the reader lets the paths get, and this tab is one they
    come back to.
  */}
  <aside class="sk-sidebar docs-source-viewer__sidebar" data-sk-sidebar data-storage-key={`${id}-source`} aria-labelledby={treeLabelId}>
    <div class="sk-sidebar__header">
      <p class="docs-source-viewer__sidebar-title" id={treeLabelId}>
        {t("sourceViewer.treeLabel", { name: title })}
      </p>
    </div>
    <div class="sk-sidebar__content sk-scrollbar sk-scrollbar--reveal">
      <div
        class="sk-tree-view"
        data-sk-tree-view
        aria-label={t("sourceViewer.treeAriaLabel", { name: title })}
        data-selection-mode="single"
        data-expanded-value={expandedValue}
        data-selected-value={initialFile}
        id={`${id}-source-tree`}
        set:html={treeHtml}
      />
    </div>
    <div
      class="sk-sidebar__resize-handle"
      data-sk-sidebar-resize
      role="separator"
      aria-orientation="vertical"
      aria-label={t("sourceViewer.resize")}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      tabindex="0"
    ></div>
  </aside>

  <div class="docs-source-viewer__code">
    <p class="sk-visually-hidden" role="status" aria-atomic="true" data-source-viewer-status>
      {initialFile}
    </p>
    {
      files.map((file) => (
        <div class="docs-source-viewer__source" data-source-file={file.id} hidden={file.id !== initialFile}>
          <CodeBlock code={file.source} label={file.id} lang={file.language} open />
        </div>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-source-viewer]").forEach((viewer) => {
    const status = viewer.querySelector<HTMLElement>("[data-source-viewer-status]");
    const panes = [...viewer.querySelectorAll<HTMLElement>("[data-source-file]")];

    viewer.addEventListener("sk-selection-change", (event) => {
      const detail = (event as CustomEvent<{ selectedValue?: string[] }>).detail;
      const selectedFile = detail?.selectedValue?.[0];
      const selectedPane = panes.find((pane) => pane.dataset.sourceFile === selectedFile);
      if (!selectedPane) return;

      for (const pane of panes) pane.hidden = pane !== selectedPane;
      if (status) status.textContent = selectedFile;
    });
  });
</script>

<style>
  .docs-source-viewer {
    display: grid;
    /*
     * `auto` FOR THE RAIL, NEVER A NUMBER. The Sidebar measures itself, and while it is being
     * dragged it measures itself several times a second: a track written as a length would hold its
     * old width and the panel would slide out over the code beside it. With `auto` the track is the
     * rail, and the resize is free without this sheet knowing it happened.
     *
     * The width the rail STARTS at is one decision for the whole site, `--docs-rail-inline-size`
     * (site.css), handed to the component's own hook below. It was `minmax(23rem, 0.55fr)`, a third
     * again as wide as the navigation beside it, sized so no filename would ever truncate: the panel
     * measured against the longest path in the repository. A name that does not fit now ellipses,
     * and a reader who wants to read it drags the edge.
     */
    grid-template-columns: auto minmax(0, 1fr);
    min-inline-size: 0;
    min-block-size: 34rem;
    margin-block: var(--space-stack-md);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-surface);
    background: var(--color-bg-surface);
    overflow: clip;
  }

  /* ONLY THE DELTA. The padding, the border, the background and the scrolling middle are the
     component's; what is left here is the starting width and the fact that a file tree is read in
     the code face. */
  .docs-source-viewer__sidebar {
    --sk-sidebar-expanded-inline-size: var(--docs-rail-inline-size);

    /*
     * The same ceiling the code face has, and it has to be said here or the rail sets the height of
     * the whole viewer. A Sidebar is `block-size: 100%` of whatever row it lands in, and this row is
     * `auto`: with nothing to cap it, the row grows to the full height of the tree (all files
     * expanded) and the code beside it is stretched to match. The cap used to sit on the tree
     * itself, which is why nobody noticed the row was being sized by the rail.
     *
     * Capping the RAIL rather than the row: the scrolling middle then fills what is left of it and
     * scrolls, instead of stopping short with dead space under it.
     */
    max-block-size: min(42rem, 68vh);
  }

  .docs-source-viewer__sidebar .sk-sidebar__content {
    font-family: var(--font-family-code);
  }

  .docs-source-viewer__sidebar-title {
    margin: 0;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /*
   * Nothing here for the tree, and that is the change worth naming.
   *
   * It used to carry its own `max-block-size`, its own `overflow`, its own `overscroll-behavior`
   * and its own scrollbar colours, plus a `white-space: nowrap` on the labels. Every one of those
   * is now somebody's: the scrolling middle is `sk-sidebar__content`, the thin revealing scrollbar
   * is the `sk-scrollbar` pattern on it, and the ellipsis is the TreeView's. What was left was the
   * code face, which is the only thing about this rail that is actually local to it.
   */

  .docs-source-viewer__code,
  .docs-source-viewer__source {
    min-inline-size: 0;
  }

  .docs-source-viewer__source {
    min-block-size: 100%;
  }

  .docs-source-viewer__source :global(.sk-code-preview) {
    min-block-size: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .docs-source-viewer__source :global(.sk-code-preview__preview > .sk-code-preview__viewport) {
    max-block-size: min(42rem, 68vh);
    overflow-y: auto;
    overscroll-behavior-block: contain;
  }

  .docs-source-viewer__source :global(.sk-code-preview__meta) {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  :global(html:not([data-js])) .docs-source-viewer__source[hidden] {
    display: block;
  }

  @media (max-width: 48rem) {
    .docs-source-viewer {
      grid-template-columns: minmax(0, 1fr);
      min-block-size: 0;
    }

    /*
     * Stacked, so the rail is the full width of the viewer and there is no horizontal travel left
     * to drag: the handle is hidden rather than left as a strip that does nothing. The width comes
     * from the hook both `inline-size` and `max-inline-size` read, so overriding it once is enough,
     * and the edge moves from the inline end to the block end through the border hook instead of
     * being redrawn by hand.
     */
    .docs-source-viewer__sidebar {
      --sk-sidebar-inline-size: 100%;
      --sk-sidebar-border-width: 0;

      border-block-end: 1px solid var(--color-border-subtle);
    }

    .docs-source-viewer__sidebar .sk-sidebar__resize-handle {
      display: none;
    }

    .docs-source-viewer__sidebar .sk-sidebar__content {
      max-block-size: 15rem;
    }

    .docs-source-viewer__source {
      min-block-size: 26rem;
    }

    .docs-source-viewer__source :global(.sk-code-preview__preview > .sk-code-preview__viewport) {
      max-block-size: 32rem;
    }
  }

  @media (forced-colors: active) {
    .docs-source-viewer,
    .docs-source-viewer__sidebar {
      border-color: CanvasText;
    }
  }
</style>
