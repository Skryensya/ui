---
import "@skryensya/core/components/pagination.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { paginationAnatomyTree, paginationTree } from "../../demos/pagination";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;

const rangeExample = `import { paginationRange } from "@skryensya/core/pagination";

paginationRange(5, 20);
// → [1, "ellipsis", 4, 5, 6, "ellipsis", 20]`;
---

<ComponentPageShell
  title="Pagination"
  description={t("paginationPage.description")}
  contractId="pagination"
  styleGroups={[{ file: "components/pagination.css", probe: "sk-pagination" }]}
  tests={[
    {
      file: "packages/react/src/components/pagination.test.tsx",
      tests: [
        {
          name: "marks the current page and disables prev/next at the bounds",
          description: t("paginationPage.test1"),
        },
        {
          name: "collapses far pages behind an ellipsis and reports clicks clamped to range",
          description: t("paginationPage.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("paginationPage.lede")} />

    <p set:html={t("paginationPage.anatomyBody")} />
    <ComponentPreview
      tree={paginationAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("paginationPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={paginationTree(t)} label="Pagination" />
    <p set:html={t("paginationPage.body")} />

    <h3>{t("paginationPage.rangeTitle")}</h3>
    <p set:html={t("paginationPage.rangeBody")} />
    <CodeBlock code={rangeExample} lang="ts" label="@skryensya/core/pagination" />

    <p set:html={t("component.reactNote")} />
    <p set:html={t("paginationPage.reactBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
