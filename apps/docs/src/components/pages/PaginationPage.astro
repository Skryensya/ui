---
import "@skryensya/core/components/pagination.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  paginationAnatomyTree,
  paginationAppearanceTree,
  paginationPositionCase,
  paginationResultsTree,
  paginationSiblingsCase,
  paginationDoBelowTree,
  paginationDontAboveTree,
  paginationDontFewTree,
  paginationTree,
} from "../../demos/pagination";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const appearanceExplain = Object.fromEntries(
  (["plain", "tactile", "brutalist", "frosted"] as const).map((value) => [value, t(`paginationPage.appearance.${value}` as Parameters<typeof t>[0])]),
);
const siblingsVariants = ([0, 1, 2] as const).map((value) => ({
  value: String(value),
  label: t(`paginationPage.siblings.${value}` as Parameters<typeof t>[0]),
  tree: paginationSiblingsCase(t, value),
  explain: t(`paginationPage.siblingsExplain.${value}` as Parameters<typeof t>[0]),
}));
const positionVariants = ([1, 6, 12] as const).map((value) => ({
  value: String(value),
  label: t(`paginationPage.position.${value}` as Parameters<typeof t>[0]),
  tree: paginationPositionCase(t, value),
  explain: t(`paginationPage.positionExplain.${value}` as Parameters<typeof t>[0]),
}));
const install = `pnpm add @skryensya/core @skryensya/react`;

const rangeExample = `import { paginationRange } from "@skryensya/core/pagination";

paginationRange(5, 20);
// → [1, "ellipsis", 4, 5, 6, "ellipsis", 20]`;
---

<ComponentPageShell
  title="Pagination"
  description={t("paginationPage.description")}
  contractId="pagination"
  appearanceTargetSelector=".sk-pagination"
  testFiles={["packages/react/src/components/pagination.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("paginationPage.lede")} />

    <UsagePreview
      tree={paginationAppearanceTree(t)}
      optionName="appearance"
      title={t("paginationPage.appearanceTitle")}
      description={t("paginationPage.appearanceBody")}
      explain={appearanceExplain}
      stageMinBlockSize="8rem"
    />
    <UsagePreview
      variants={siblingsVariants}
      initialVariant="1"
      variantsLabel={t("paginationPage.siblingsLabel")}
      title={t("paginationPage.siblingsTitle")}
      description={t("paginationPage.siblingsBody")}
      stageMinBlockSize="8rem"
    />
    <UsagePreview
      variants={positionVariants}
      initialVariant="6"
      variantsLabel={t("paginationPage.positionLabel")}
      title={t("paginationPage.positionTitle")}
      description={t("paginationPage.positionBody")}
      stageMinBlockSize="8rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={paginationTree(t)} title={t("paginationPage.twelveTitle")} description={t("paginationPage.twelveBody")} />
    <UsagePreview tree={paginationResultsTree(t)} title={t("paginationPage.resultsTitle")} description={t("paginationPage.resultsBody")} />
    <h4>{t("paginationPage.rangeTitle")}</h4>
    <p set:html={t("paginationPage.rangeBody")} />
    <CodeBlock code={rangeExample} lang="ts" label="@skryensya/core/pagination" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "paginationPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("paginationPage.anatomyBody")} />
    <UsagePreview
      tree={paginationAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("paginationPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("paginationPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "paginationPage.when")} avoid={tList(t, "paginationPage.whenNot")} />
    <DoDont
      title={t("paginationPage.dd.few.title")}
      stacked
      do={{ tree: paginationTree(t), caption: t("paginationPage.dd.few.do") }}
      dont={{ tree: paginationDontFewTree(t), caption: t("paginationPage.dd.few.dont") }}
    />
    <DoDont
      title={t("paginationPage.dd.below.title")}
      stacked
      do={{ tree: paginationDoBelowTree(t), caption: t("paginationPage.dd.below.do") }}
      dont={{ tree: paginationDontAboveTree(t), caption: t("paginationPage.dd.below.dont") }}
    />
    <DoDont
      title={t("paginationPage.dd.total.title")}
      stacked
      do={{ tree: paginationResultsTree(t), caption: t("paginationPage.dd.total.do") }}
      dont={{ tree: paginationDoBelowTree(t), caption: t("paginationPage.dd.total.dont") }}
    />
    <ContentRules items={tList(t, "paginationPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes
      intro={t("paginationPage.a11yIntro")}
      does={tList(t, "paginationPage.a11yDoes")}
      yours={tList(t, "paginationPage.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("paginationPage.key.tab") },
        { keys: ["Enter"], action: t("paginationPage.key.enter") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
