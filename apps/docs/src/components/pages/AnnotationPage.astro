---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  annotationAnatomyTree,
  annotationDoAllCopiesTree,
  annotationDoBracketTree,
  annotationDoNearestSideTree,
  annotationDontFirstOnlyTree,
  annotationDontOneSideTree,
  annotationDontRingAreaTree,
  annotationMatchTree,
  annotationOneTree,
  annotationSelfAnatomyCss,
  annotationSelfAnatomyTree,
} from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
/* The sheet itself, not only its source: the Style hooks table resolves each hook against a real
   element, and a page that never loads this stylesheet shows every value blank. */
import "@skryensya/core/components/annotation.css";
/* The specimens' own stylesheets, for the same reason one level down: an Accordion measured without
   `tile.css` is a stack of unstyled blocks, and every leader on this page would point at the wrong
   box. Here the CSS is not decoration, it is the input. */
import "@skryensya/core/components/accordion.css";
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/stat.css";
import "@skryensya/core/components/breadcrumb.css";
import "@skryensya/core/components/button.css";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/annotation.css";`;

/* Same Storybook handoff Badge and Accordion use (`lib/navigation.ts` files Annotation under Content). */
const storybookTitle = "Components/Content/Annotation";

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`annotation.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Annotation"
  description={t("annotation.description")}
  contractId="annotation"
  testFiles={["packages/core/src/annotation.test.ts", "packages/vanilla/src/components/annotation.test.ts", "packages/react/src/components/annotation.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("annotation.lede")} />

    {/* All three live on an entry, not on the frame: `target` walks into the `items` slot. */}
    <UsagePreview
      tree={annotationOneTree(t)}
      optionName="side"
      target={["items", 0]}
      title={t("annotation.prop.side.title")}
      description={t("annotation.prop.side.body")}
      explain={explain("side", ["inline-start", "inline-end", "block-start", "block-end"])}
      storybookTitle={storybookTitle}
      storybookStory="One"
    />

    <UsagePreview
      tree={annotationOneTree(t)}
      optionName="mark"
      target={["items", 0]}
      title={t("annotation.prop.mark.title")}
      description={t("annotation.prop.mark.body")}
      explain={explain("mark", ["ring", "bracket"])}
      storybookTitle={storybookTitle}
      storybookStory="One"
    />

    <UsagePreview
      tree={annotationMatchTree(t)}
      optionName="match"
      target={["items", 0]}
      title={t("annotation.prop.match.title")}
      description={t("annotation.prop.match.body")}
      explain={explain("match", ["first", "all"])}
      storybookTitle={storybookTitle}
      storybookStory="Match"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <p set:html={t("annotation.showcaseBody")} />

    <UsagePreview
      tree={annotationAnatomyTree(t)}
      title={t("annotation.anatomyTitle")}
      description={t("annotation.anatomyBody")}
      storybookTitle={storybookTitle}
      storybookStory="Anatomy"
    />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("annotation.selfAnatomyBody")} />
    <UsagePreview
      tree={annotationSelfAnatomyTree(t)}
      css={annotationSelfAnatomyCss}
      label={t("annotation.selfAnatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("annotation.guidelinesLede")} />
    <WhenToUse use={tList(t, "annotation.when")} avoid={tList(t, "annotation.whenNot")} />

    <DoDont
      canvas
      title={t("annotation.dd.mark.title")}
      do={{ tree: annotationDoBracketTree(t), caption: t("annotation.dd.mark.do") }}
      dont={{ tree: annotationDontRingAreaTree(t), caption: t("annotation.dd.mark.dont") }}
    />
    <DoDont
      canvas
      title={t("annotation.dd.side.title")}
      do={{ tree: annotationDoNearestSideTree(t), caption: t("annotation.dd.side.do") }}
      dont={{ tree: annotationDontOneSideTree(t), caption: t("annotation.dd.side.dont") }}
    />
    <DoDont
      canvas
      title={t("annotation.dd.match.title")}
      do={{ tree: annotationDoAllCopiesTree(t), caption: t("annotation.dd.match.do") }}
      dont={{ tree: annotationDontFirstOnlyTree(t), caption: t("annotation.dd.match.dont") }}
    />

    <ContentRules items={tList(t, "annotation.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("annotation.a11yIntro")}
      does={tList(t, "annotation.a11yDoes")}
      yours={tList(t, "annotation.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("annotation.a11yKeyTab") },
        { keys: ["+", "-"], action: t("annotation.a11yKeyZoom") },
        { keys: ["0"], action: t("annotation.a11yKeyFit") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
