---
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import "@skryensya/core/components/annotation.css";
import {
  clipboardAnatomyCss,
  clipboardAnatomyTree,
  clipboardButtonTree,
  clipboardDontBlindTree,
  clipboardFieldTree,
  clipboardSizesTree,
  clipboardTargetTree,
} from "../../demos/clipboard";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/clipboard.css";

const t = useTranslations(getLocale(Astro.url));

const react = `import { Clipboard, CopyButton } from "@skryensya/react/clipboard";
import "@skryensya/core/components/clipboard.css";

<CopyButton target="install" label="Copy the install command" />

<Clipboard
  fieldLabel="Share link"
  label="Copy link"
  value={shareUrl}
  onStatusChange={(status) => status === "error" && reportCopyFailure()}
/>`;

const vanilla = `document.addEventListener("sk:clipboardstatuschange", (event) => {
  if (event.detail.status === "error") reportCopyFailure();
});`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`clipboard.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Clipboard"
  description={t("clipboard.description")}
  badge={t("clipboard.betaBadge")}
  contractId="clipboard"
  appearanceTargetSelector=".sk-clipboard__trigger"
  testFiles={["packages/react/src/components/clipboard.test.tsx", "packages/vanilla/src/components/clipboard.svelte.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("clipboard.lede")} />

    <UsagePreview
      tree={clipboardButtonTree(t)}
      optionName="size"
      title={t("clipboard.prop.size.title")}
      description={t("clipboard.prop.size.body")}
      explain={explain("size", ["xs", "sm", "md"])}
      stageMinBlockSize="6rem"
      labels={{ xs: "xs", sm: "sm", md: "md" }}
    />

    <UsagePreview
      tree={clipboardButtonTree(t)}
      optionName="variant"
      title={t("clipboard.prop.variant.title")}
      description={t("clipboard.prop.variant.body")}
      explain={explain("variant", ["soft", "ghost"])}
      stageMinBlockSize="6rem"
    />

    <UsagePreview
      tree={clipboardFieldTree(t)}
      optionName="appearance"
      title={t("clipboard.prop.appearance.title")}
      description={t("clipboard.prop.appearance.body")}
      explain={explain("appearance", ["plain", "tactile", "brutalist", "frosted"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("clipboard.showcaseTitle")}</h3>
    <p set:html={t("clipboard.showcaseBody")} />

    <h3>{t("clipboard.targetTitle")}</h3>
    <p set:html={t("clipboard.targetBody")} />
    <UsagePreview tree={clipboardTargetTree(t)} />

    <h3>{t("clipboard.fieldTitle")}</h3>
    <p set:html={t("clipboard.fieldBody")} />
    <UsagePreview tree={clipboardFieldTree(t)} />

    <h3>{t("clipboard.sizesTitle")}</h3>
    <p set:html={t("clipboard.sizesBody")} />
    <UsagePreview tree={clipboardSizesTree(t)} />

    <h3>{t("clipboard.feedbackTitle")}</h3>
    <ul>
      <li set:html={t("clipboard.feedbackItem1")} />
      <li set:html={t("clipboard.feedbackItem2")} />
      <li set:html={t("clipboard.feedbackItem3")} />
      <li set:html={t("clipboard.feedbackItem4")} />
    </ul>

    <h3>{t("clipboard.eventsTitle")}</h3>
    <p set:html={t("clipboard.eventsBody")} />
    <CodeBlock code={react} label="React" lang="tsx" />
    <CodeBlock code={vanilla} label="JavaScript" lang="ts" />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("clipboard.anatomyBody")} />
    <ComponentPreview
      tree={clipboardAnatomyTree(t)}
      css={clipboardAnatomyCss}
      label={t("clipboard.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("clipboard.guidelinesLede")} />
    <h3>{t("clipboard.whenTitle")}</h3>
    <ul>
      <li set:html={t("clipboard.whenItem1")} />
      <li set:html={t("clipboard.whenItem2")} />
      <li set:html={t("clipboard.whenItem3")} />
    </ul>
    <DoDont
      title={t("clipboard.dd.see.title")}
      do={{ tree: clipboardFieldTree(t), caption: t("clipboard.dd.see.do") }}
      dont={{ tree: clipboardDontBlindTree(t), caption: t("clipboard.dd.see.dont") }}
    />
  </Fragment>
</ComponentPageShell>
