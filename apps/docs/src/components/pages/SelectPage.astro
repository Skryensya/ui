---
import "@skryensya/core/components/select.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  selectAnatomyCss,
  selectAnatomyHtml,
  selectDoTwoTree,
  selectDontTwoTree,
  selectNativeTree,
  selectSingleTree,
  selectTree,
} from "../../demos/select";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/select.css";`;

const nativeInstall = `pnpm add @skryensya/core`;

const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// ${t("selectPage.iconsComment").split("\n").join("\n// ")}
mountIcons(document, lucideIcons);

await initComponents();`;

const listen = `document
  .getElementById("plan")
  .addEventListener("sk:selectvaluechange", (event) => {
    console.log(event.detail.value); // ["pro"]
  });`;

const forms = `<div
  class="sk-select"
  data-sk-select
  id="plan"
>
  <!-- ${t("selectPage.formsComment")} -->
  <select data-sk-select-hidden name="plan">
    <option value="starter">Starter</option>
    <option value="pro">Pro</option>
  </select>
  …
</div>`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`selectPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Select"
  description={t("selectPage.description")}
  contractId="select"
  appearanceTargetSelector=".sk-select"
  styleGroups={[
    { file: "components/select.css", probe: "sk-select" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
    { file: "components/select.css", probe: "sk-select-native" },
  ]}
  testFiles={["packages/react/src/components/select.test.tsx", "packages/vanilla/src/components/select.test.ts"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("selectPage.lede")} />

    <UsagePreview
      tree={selectSingleTree(t)}
      optionName="variant"
      title={t("selectPage.prop.variant.title")}
      description={t("selectPage.prop.variant.body")}
      explain={explain("variant", ["outline", "ghost"])}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={selectSingleTree(t)}
      optionName="appearance"
      title={t("selectPage.prop.appearance.title")}
      description={t("selectPage.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist", "frosted"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("selectPage.showcaseTitle")}</h3>
    <p set:html={t("selectPage.showcaseBody")} />
    <p set:html={t("selectPage.nativeLinkBody")} />
    <ComponentPreview tree={selectTree(t)} label={t("selectPage.enhancedLabel")} viewport="menu" />
    <p set:html={t("selectPage.densityBody")} />

    <h3>{t("selectPage.htmlTitle")}</h3>
    <p set:html={t("selectPage.htmlBody")} />

    <h3>{t("selectPage.formsTitle")}</h3>
    <CodeBlock code={forms} label="HTML" />

    <h3>{t("selectPage.enhancedContractTitle")}</h3>
    <ul>
      <li set:html={t("selectPage.enhancedContractItem1")} />
      <li set:html={t("selectPage.enhancedContractItem2")} />
      <li set:html={t("selectPage.enhancedContractItem3")} />
      <li set:html={t("selectPage.enhancedContractItem4")} />
    </ul>

    <h3>{t("selectPage.nativeTitle")}</h3>
    <p class="lede" set:html={t("selectPage.nativeLede")} />
    <p set:html={t("selectPage.nativeBody")} />
    <ComponentPreview tree={selectNativeTree(t)} label={t("selectPage.nativeLabel")} viewport="menu" />

    <h4>{t("selectPage.progressiveTitle")}</h4>
    <p set:html={t("selectPage.progressiveBody")} />

    <h4>{t("selectPage.nativeContractTitle")}</h4>
    <ul>
      <li set:html={t("selectPage.nativeContractItem1")} />
      <li set:html={t("selectPage.nativeContractItem2")} />
      <li set:html={t("selectPage.nativeContractItem3")} />
      <li set:html={t("selectPage.nativeContractItem4")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("selectPage.anatomyBody")} />
    <ComponentPreview
      html={selectAnatomyHtml(t)}
      css={selectAnatomyCss}
      label={t("selectPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("selectPage.guidelinesLede")} />
    <DoDont
      title={t("selectPage.dd.two.title")}
      do={{ tree: selectDoTwoTree(t), caption: t("selectPage.dd.two.do") }}
      dont={{ tree: selectDontTwoTree(t), caption: t("selectPage.dd.two.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />

    <h3>{t("selectPage.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />

    <h3>{t("selectPage.listenTitle")}</h3>
    <CodeBlock code={listen} label="JavaScript" />

    <h3>{t("selectPage.nativeInstallTitle")}</h3>
    <CodeBlock code={nativeInstall} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>
</ComponentPageShell>
