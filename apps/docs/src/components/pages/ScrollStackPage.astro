---
import "@skryensya/core/components/scroll-stack.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The demo holds real copy, drawn with the kit's own pieces. */
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/scrollbar.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import ComparisonTable from "../ComparisonTable.astro";
import DoDont from "../DoDont.astro";
import UsagePreview from "../UsagePreview.astro";
import { scrollStackParts } from "@skryensya/core/scroll-stack";
import { scrollStackDoFitTree, scrollStackDoOffsetTree, scrollStackDontOffsetTree, scrollStackDoOpaqueTree, scrollStackDontFitTree, scrollStackDontOpaqueTree, scrollStackAnatomyCss, scrollStackAnatomyTree, scrollStackCardsTree, scrollStackFiveTree, scrollStackOffsetTree, scrollStackProductTree, scrollStackTree } from "../../demos/scroll-stack";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const examples = [
  { key: "cover", story: "Default", tree: scrollStackTree },
  { key: "product", story: "Product", tree: scrollStackProductTree },
  { key: "cards", story: "Cards", tree: scrollStackCardsTree },
  { key: "five", story: "Five", tree: scrollStackFiveTree },
  { key: "offset", story: "Offset", tree: scrollStackOffsetTree },
] as const;

const [, doesColumn] = t("scrollStackPage.hooksColumns").split("|");
const hooks = [
  ["recede-scale", "0.9", "recedeScale"],
  ["recede-dim", "0.45", "recedeDim"],
  ["recede-radius", "var(--radius-surface)", "recedeRadius"],
  ["recede-shift", "2rem", "recedeShift"],
  ["recede-blur", "0px", "recedeBlur"],
  ["recede-opacity", "1", "recedeOpacity"],
  ["zoom", "1.1", "zoom"],
  ["front-bg", "var(--color-bg-surface)", "frontBg"],
  ["front-radius", "calc(var(--radius-surface) * 2)", "frontRadius"],
  ["front-docked-radius", "0px", "frontDockedRadius"],
  ["front-shadow", "an upward shadow", "frontShadow"],
  ["offset", "0px", "offset"],
  ["reveal-shift", "var(--space-inset-lg)", "revealShift"],
  ["reveal-opacity", "0", "revealOpacity"],
  ["reveal-blur", "0px", "revealBlur"],
  ["content-padding", "0px", "contentPadding"],
  ["content-gap", "0px", "contentGap"],
] as const;
const hookNotes = Object.fromEntries(
  hooks.map(([name, , key]) => [`--sk-scroll-stack-${name}`, t(`scrollStackPage.hook.${key}` as Parameters<typeof t>[0])]),
);

const partOrder = ["root", "back", "front", "runway", "content"] as const;
const partRows = partOrder.map((part) => ({
  label: scrollStackParts[part],
  labelHtml: `<code>${scrollStackParts[part]}</code>`,
  cells: [t(`scrollStackPage.part.${part}` as Parameters<typeof t>[0])],
}));

const install = `pnpm add @skryensya/core
# and, for React,
pnpm add @skryensya/react`;
const styles = `@import "@skryensya/core/components/scroll-stack.css";`;
const html = `<div class="sk-scroll-stack">
  <div class="sk-scroll-stack__back">
    <section><h2>The cover</h2></section>
  </div>
  <div class="sk-scroll-stack__front">
    <span class="sk-scroll-stack__runway" aria-hidden="true"></span>
    <div class="sk-scroll-stack__content">
      <section><h2>What comes next</h2></section>
    </div>
  </div>
</div>`;
const react = `import { ScrollStack } from "@skryensya/react/scroll-stack";

<ScrollStack
  back={<section><h2>The cover</h2></section>}
  front={<section><h2>What comes next</h2></section>}
/>`;
const box = `/* In a scroll box of your own: a size container, so the component measures it and not the window. */
.my-scroller {
  block-size: 28rem;
  overflow: auto;
  container-type: size;
}`;
const tune = `.sk-scroll-stack {
  --sk-scroll-stack-recede-scale: 0.84; /* recede even more */
  --sk-scroll-stack-recede-blur: 8px;   /* going soft as it goes */
  --sk-scroll-stack-zoom: 1.03;         /* and settle from less */
  --sk-scroll-stack-offset: 4rem;       /* below a fixed header */
}`;
---

<ComponentPageShell
  title="Scroll Stack"
  description={t("scrollStackPage.description")}
  contractId="scroll-stack"
  badge="Beta"
  hookNotes={hookNotes}
  hookNotesLabel={doesColumn}
  testFiles={["packages/react/src/components/scroll-stack.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("scrollStackPage.lede")} />

    <h3>{t("scrollStackPage.examplesTitle")}</h3>
    <p set:html={t("scrollStackPage.examplesBody")} />
    {
      examples.map(({ key, story, tree }) => (
        <UsagePreview
          tree={tree(t)}
          title={t(`scrollStackPage.variant.${key}` as Parameters<typeof t>[0])}
          description={t(`scrollStackPage.variant.${key}.explain` as Parameters<typeof t>[0])}
          storybookTitle="Components/Layout/Scroll Stack"
          storybookStory={story}
          stageMinBlockSize="27rem"
        />
      ))
    }

    <h3>{t("scrollStackPage.howTitle")}</h3>
    <ul>
      <li set:html={t("scrollStackPage.how.back")} />
      <li set:html={t("scrollStackPage.how.front")} />
      <li set:html={t("scrollStackPage.how.reveal")} />
      <li set:html={t("scrollStackPage.how.fallback")} />
    </ul>

    <h3>{t("scrollStackPage.boxTitle")}</h3>
    <p set:html={t("scrollStackPage.boxBody")} />
    <CodeBlock code={box} label="CSS" lang="css" />

    <h3>{t("scrollStackPage.contractTitle")}</h3>
    <ul>
      {tList(t, "scrollStackPage.contract").map((item) => <li set:html={item} />)}
    </ul>

  </Fragment>

  <Fragment slot="anatomy">
    <p set:html={t("scrollStackPage.anatomyBody")} />
    <UsagePreview tree={scrollStackAnatomyTree(t)} css={scrollStackAnatomyCss} label={t("scrollStackPage.anatomyPreviewLabel")} bare />
    <h3>{t("scrollStackPage.anatomyTitle")}</h3>
    <div class="ss-parts">
      <ComparisonTable aspectLabel={t("scrollStackPage.partsAspect")} columns={[t("scrollStackPage.partsColumns")]} rows={partRows} />
    </div>
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("scrollStackPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "scrollStackPage.when")} avoid={tList(t, "scrollStackPage.whenNot")} />
    <DoDont
      title={t("scrollStackPage.dd.opaque.title")}
      do={{ tree: scrollStackDoOpaqueTree(t), caption: t("scrollStackPage.dd.opaque.do") }}
      dont={{ tree: scrollStackDontOpaqueTree(t), caption: t("scrollStackPage.dd.opaque.dont") }}
    />
    <DoDont
      title={t("scrollStackPage.dd.fit.title")}
      do={{ tree: scrollStackDoFitTree(t), caption: t("scrollStackPage.dd.fit.do") }}
      dont={{ tree: scrollStackDontFitTree(t), caption: t("scrollStackPage.dd.fit.dont") }}
    />
    <DoDont
      title={t("scrollStackPage.dd.offset.title")}
      do={{ tree: scrollStackDoOffsetTree(t), caption: t("scrollStackPage.dd.offset.do") }}
      dont={{ tree: scrollStackDontOffsetTree(t), caption: t("scrollStackPage.dd.offset.dont") }}
    />
    <ContentRules items={tList(t, "scrollStackPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <p set:html={t("scrollStackPage.installBody")} />
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="style">
    <h3>{t("scrollStackPage.hooksTitle")}</h3>
    <p set:html={t("scrollStackPage.hooksBody")} />
    <CodeBlock code={tune} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("scrollStackPage.a11yIntro")} does={tList(t, "scrollStackPage.a11yDoes")} yours={tList(t, "scrollStackPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>

<style is:global>
  /* A class name is one token: breaking it at the hyphen makes two lines of what is a single word. */
  .ss-parts th code {
    white-space: nowrap;
  }
</style>
