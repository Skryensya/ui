---
/* The composition demo nests the avatar in a Box; layout/typography are already global (Base.astro). */
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/components/avatar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  avatarAnatomyTree,
  avatarGroupAnatomyTree,
  avatarImageTree,
  avatarSingleTree,
  avatarColorsTree,
  avatarGroupTree,
  avatarProfileTree,
  avatarCompactRowTree,
  avatarDontOversizedRowTree,
  avatarColorIdentityTree,
  avatarDontStatusColorTree,
  avatarDontAloneTree,
  avatarDontLongRowTree,
} from "../../demos/avatar";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`avatar.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const storybookTitle = "Components/Avatar";

/*
 * `max` is React's own shorthand, not a contract option, so it cannot be shown as a usage tree: the
 * contract publishes the overflow as a SLOT, which is what lets the vanilla layer write the same
 * group with no JavaScript. This block is the one place the React-only affordance is spelled out.
 */
const groupMax = `import { Avatar, AvatarGroup } from "@skryensya/react/avatar";

<AvatarGroup label="${t("demo.avatar.groupLabel")}" max={3}>
  <Avatar name="Ada Lovelace" />
  <Avatar name="Alan Turing" />
  <Avatar name="Grace Hopper" />
  <Avatar name="Edsger Dijkstra" />
</AvatarGroup>;`;

---

<ComponentPageShell
  hookPlayground={{ tree: avatarSingleTree(), fit: true }}
  title="Avatar"
  description={t("avatar.description")}
  contractId="avatar"
  appearanceTargetSelector=".sk-avatar"
  testFiles={["packages/react/src/components/avatar.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu
      label={t("prefs.appearance")}
      values={["plain", "brutalist"]}
      unavailable={{ tactile: t("avatar.tactileUnavailable"), frosted: t("avatar.frostedUnavailable") }}
    />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("avatar.lede")} />

    <UsagePreview
      tree={avatarSingleTree()}
      optionName="size"
      title={t("avatar.prop.size.title")}
      description={t("avatar.prop.size.body")}
      explain={explain("size", ["sm", "md", "lg", "xl"])}
      stageMinBlockSize="8rem"
      storybookTitle={storybookTitle}
      storybookStory="Single" />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview
      tree={avatarImageTree(t)}
      title={t("avatar.imagesTitle")}
      description={t("avatar.imagesBody")}
      storybookTitle={storybookTitle}
      storybookStory="Image" />
    <UsagePreview
      tree={avatarGroupTree(t)}
      title={t("avatar.groupTitle")}
      description={t("avatar.groupBody")}
      storybookTitle={storybookTitle}
      storybookStory="Group" />
    <p set:html={t("avatar.groupMaxBody")} />
    <CodeBlock code={groupMax} label="React" lang="tsx" note={t("avatar.groupMaxNote")} />
    <UsagePreview
      tree={avatarProfileTree(t)}
      title={t("avatar.profileTitle")}
      description={t("avatar.profileBody")}
      storybookTitle={storybookTitle}
      storybookStory="Profile" />
    <UsagePreview
      tree={avatarColorsTree(t)}
      title={t("avatar.colorsTitle")}
      description={t("avatar.colorsBody")}
      storybookTitle={storybookTitle}
      storybookStory="Colors" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "avatar.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("avatar.anatomyBody")} />
    <UsagePreview
      tree={avatarAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("avatar.anatomyPreviewLabel")}
      bare
    />
    <p set:html={t("avatar.groupAnatomyBody")} />
    <UsagePreview
      tree={avatarGroupAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("avatar.groupAnatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("avatar.guidelinesLede")} />
    <WhenToUse use={tList(t, "avatar.when")} avoid={tList(t, "avatar.whenNot")} />
    <DoDont
      title={t("avatar.dd.identity.title")}
      do={{ tree: avatarProfileTree(t), caption: t("avatar.dd.identity.do") }}
      dont={{ tree: avatarDontAloneTree(), caption: t("avatar.dd.identity.dont") }}
    />
    <DoDont
      title={t("avatar.dd.group.title")}
      do={{ tree: avatarGroupTree(t), caption: t("avatar.dd.group.do") }}
      dont={{ tree: avatarDontLongRowTree(t), caption: t("avatar.dd.group.dont") }}
    />
    <DoDont
      title={t("avatar.dd.size.title")}
      do={{ tree: avatarCompactRowTree(), caption: t("avatar.dd.size.do") }}
      dont={{ tree: avatarDontOversizedRowTree(), caption: t("avatar.dd.size.dont") }}
    />
    <DoDont
      title={t("avatar.dd.color.title")}
      do={{ tree: avatarColorIdentityTree(t), caption: t("avatar.dd.color.do") }}
      dont={{ tree: avatarDontStatusColorTree(t), caption: t("avatar.dd.color.dont") }}
    />
    <ContentRules items={tList(t, "avatar.content")} />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes intro={t("avatar.a11yIntro")} does={tList(t, "avatar.a11yDoes")} yours={tList(t, "avatar.a11yYours")} />
  </Fragment>
</ComponentPageShell>
