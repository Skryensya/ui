---
import "@skryensya/core/components/meter.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  meterAnatomyTree,
  meterDoToneTree,
  meterDontTaskTree,
  meterDontToneTree,
  meterSingleTree,
  meterTree,
} from "../../demos/meter";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`meterPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Meter"
  description={t("meterPage.description")}
  contractId="meter"
  styleGroups={[{ file: "components/meter.css", probe: "sk-meter" }]}
  testFiles={["packages/react/src/components/meter.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("meterPage.lede")} />

    <UsagePreview
      tree={meterSingleTree(t)}
      optionName="tone"
      title={t("meterPage.prop.tone.title")}
      description={t("meterPage.prop.tone.body")}
      explain={explain("tone", ["accent", "success", "warning", "danger"])}
      stageMinBlockSize="7rem"
    />

    <h3>{t("meterPage.showcaseTitle")}</h3>
    <p set:html={t("meterPage.showcaseBody")} />
    <UsagePreview tree={meterTree(t)} />
    <p set:html={t("meterPage.body")} />
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("meterPage.anatomyBody")} />
    <ComponentPreview
      tree={meterAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("meterPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("meterPage.guidelinesLede")} />
    <DoDont
      title={t("meterPage.dd.tone.title")}
      do={{ tree: meterDoToneTree(t), caption: t("meterPage.dd.tone.do") }}
      dont={{ tree: meterDontToneTree(t), caption: t("meterPage.dd.tone.dont") }}
    />
    <DoDont
      title={t("meterPage.dd.measure.title")}
      do={{ tree: meterSingleTree(t), caption: t("meterPage.dd.measure.do") }}
      dont={{ tree: meterDontTaskTree(t), caption: t("meterPage.dd.measure.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("meterPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
