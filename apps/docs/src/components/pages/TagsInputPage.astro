---
import "@skryensya/core/components/tags-input.css";
/* The chip IS a Tag, so its sheet is part of this component's paint, not a demo's extra. */
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/button.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The last demo puts the field inside a FormField, and a frame only copies what this page loaded. */
import "@skryensya/core/components/form-field.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  tagsInputAnatomyTree,
  tagsInputDoShortTree,
  tagsInputDontLongTree,
  tagsInputEmptyTree,
  tagsInputFieldTree,
  tagsInputMaxTree,
  tagsInputReadOnlyTree,
  tagsInputTree,
} from "../../demos/tags-input";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/tags-input.css";
/* The chip is a Tag, and its remove control is a Button. */
@import "@skryensya/core/components/tag.css";
@import "@skryensya/core/components/button.css";`;
---

<ComponentPageShell
  title="TagsInput"
  description={t("tagsInputPage.description")}
  contractId="tags-input"
  appearanceTargetSelector=".sk-tags-input"
  testFiles={[
    "packages/react/src/components/tags-input.test.tsx",
    "packages/vanilla/src/components/tags-input.test.ts",
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("tagsInputPage.lede")} />

    <h3>{t("tagsInputPage.showcaseTitle")}</h3>
    <p set:html={t("tagsInputPage.showcaseBody")} />
    <UsagePreview tree={tagsInputTree(t)} />

    <h3>{t("tagsInputPage.composesTitle")}</h3>
    <p set:html={t("tagsInputPage.composesBody")} />

    <h3>{t("tagsInputPage.markupTitle")}</h3>
    <p set:html={t("tagsInputPage.markupBody")} />

    <h3>{t("tagsInputPage.emptyTitle")}</h3>
    <p set:html={t("tagsInputPage.emptyBody")} />
    <UsagePreview tree={tagsInputEmptyTree(t)} />

    <h3>{t("tagsInputPage.maxTitle")}</h3>
    <p set:html={t("tagsInputPage.maxBody")} />
    <UsagePreview tree={tagsInputMaxTree(t)} />

    <h3>{t("tagsInputPage.readOnlyTitle")}</h3>
    <p set:html={t("tagsInputPage.readOnlyBody")} />
    <UsagePreview tree={tagsInputReadOnlyTree(t)} />

    <h3>{t("tagsInputPage.fieldTitle")}</h3>
    <p set:html={t("tagsInputPage.fieldBody")} />
    <UsagePreview tree={tagsInputFieldTree(t)} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("tagsInputPage.contractItem1")} />
      <li set:html={t("tagsInputPage.contractItem2")} />
      <li set:html={t("tagsInputPage.contractItem3")} />
      <li set:html={t("tagsInputPage.contractItem4")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("tagsInputPage.anatomyBody")} />
    <ComponentPreview
      tree={tagsInputAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("tagsInputPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tagsInputPage.guidelinesLede")} />
    <h3>{t("tagsInputPage.whenTitle")}</h3>
    <ul>
      <li set:html={t("tagsInputPage.whenItem1")} />
      <li set:html={t("tagsInputPage.whenItem2")} />
      <li set:html={t("tagsInputPage.whenItem3")} />
      <li set:html={t("tagsInputPage.whenItem4")} />
    </ul>
    <DoDont
      title={t("tagsInputPage.dd.short.title")}
      do={{ tree: tagsInputDoShortTree(t), caption: t("tagsInputPage.dd.short.do") }}
      dont={{ tree: tagsInputDontLongTree(t), caption: t("tagsInputPage.dd.short.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>
