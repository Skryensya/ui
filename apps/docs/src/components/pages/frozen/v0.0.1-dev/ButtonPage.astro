---
/*
 * THE BUTTON PAGE, AS VERSION 0.0.1-dev SHIPPED IT.
 *
 * A frozen docs version is normally a whole built site, produced by the cut and mounted under
 * `/v<version>/` (ADR-0022). This file is the prototype of that: one page, hand-placed, so the routing,
 * the switcher and the chrome can be seen working before the cut script exists.
 *
 * WHY THE TEXT IS INLINE AND NOT `t("button.…")`. That is the whole point of a frozen page. Reading
 * from the live message tree would mean this archive silently rewrites itself every time someone
 * edits the current Button page, which is exactly the failure versioned docs exist to prevent. A
 * snapshot's words are baked into the snapshot; the only thing it still reads from the app is the
 * chrome around it.
 *
 * WHY THERE ARE NO INTERACTIVE PREVIEWS. A `ComponentPreview` renders the workspace as it is TODAY.
 * Under a frozen URL that is not a convenience, it is a lie: the prose would describe this version
 * while the demo underneath it runs the next one's code. The archive shows its code samples, says so
 * in a line the reader can see, and sends anyone who wants a live control to the latest version.
 *
 * WHERE THE CODE COMES FROM, and this is the part that matters: `button.emitted.json`, which is the
 * OUTPUT of the emitter at the cut, not a tree emitted while this page renders. A tree is input; the
 * compiler and the contract it reads both move forward, so emitting here would print today's markup
 * under this version's prose. `freeze-archive-code.mts` is what produced the file, and the trees it
 * read are in `button.trees.ts` beside it, kept so a regeneration is reviewable rather than retyped.
 */
import FrozenPage from "../../../FrozenPage.astro";
import CodeBlock from "../../../CodeBlock.astro";
import { getLocale, useTranslations } from "../../../../i18n";
import emitted from "./button.emitted.json";

/** The day this cut was taken. In a real archive it is the tag's date, read by the cut script. */
const FROZEN_AT = "2026-06-30";
const VERSION = "0.0.1-dev";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { snippets } = emitted;


/* The page's own words, as they read at the cut. Both locales, because one archive holds both. */
const copy = {
  es: {
    description: "El control que ejecuta una acción. Cuatro variantes, tres tamaños y un solo contrato.",
    lede: "Button es el único control que ejecuta una acción inmediata. Si navega, es un enlace; si cambia un valor, es un Switch o un Checkbox.",
    variantsTitle: "Variantes",
    variantsBody:
      "Cuatro: <code>solid</code> para la acción principal de la vista, <code>outline</code> para las que la acompañan, <code>ghost</code> para las que viven dentro de otra superficie y <code>link</code> para las que se leen como texto.",
    sizesTitle: "Tamaños",
    sizesBody:
      "Tres tamaños: <code>sm</code>, <code>md</code> y <code>lg</code>. El área de toque nunca baja del mínimo aunque la caja visible sea más chica.",
    linkTitle: "Como enlace",
    linkBody: "Cuando la acción navega, el elemento correcto es un <code>&lt;a&gt;</code> con la apariencia de Button.",
    installTitle: "Instalación",
  },
  en: {
    description: "The control that performs an action. Four variants, three sizes, one contract.",
    lede: "Button is the only control that performs an immediate action. If it navigates it is a link; if it changes a value it is a Switch or a Checkbox.",
    variantsTitle: "Variants",
    variantsBody:
      "Four: <code>solid</code> for the view's primary action, <code>outline</code> for the ones beside it, <code>ghost</code> for the ones living inside another surface, and <code>link</code> for the ones that read as text.",
    sizesTitle: "Sizes",
    sizesBody:
      "Three sizes: <code>sm</code>, <code>md</code> and <code>lg</code>. The hit area never drops below the minimum even when the painted box is smaller.",
    linkTitle: "As a link",
    linkBody: "When the action navigates, the right element is an <code>&lt;a&gt;</code> wearing Button's appearance.",
    installTitle: "Installation",
  },
}[locale];

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

---

<FrozenPage
  title="Button"
  description={copy.description}
  version={VERSION}
  frozenAt={FROZEN_AT}
  demosOmitted
>
  <p class="lede">{copy.lede}</p>

  <h2>{copy.variantsTitle}</h2>
  <p set:html={copy.variantsBody} />
  <CodeBlock code={snippets.variants.html} label="HTML" lang="html" />
  <CodeBlock code={snippets.variants.react} label="React" lang="tsx" />

  <h2>{copy.sizesTitle}</h2>
  <p set:html={copy.sizesBody} />
  <CodeBlock code={snippets.sizes.html} label="HTML" lang="html" />
  <CodeBlock code={snippets.sizes.react} label="React" lang="tsx" />

  <h2>{copy.linkTitle}</h2>
  <p set:html={copy.linkBody} />
  <CodeBlock code={snippets.link.html} label="HTML" lang="html" />
  <CodeBlock code={snippets.link.react} label="React" lang="tsx" />

  <h2>{copy.installTitle}</h2>
  <CodeBlock code={install} label="terminal" />
</FrozenPage>
