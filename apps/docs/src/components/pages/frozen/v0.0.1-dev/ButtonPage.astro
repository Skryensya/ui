---
/*
 * BUTTON, AS VERSION 0.0.1-dev HAS IT.
 *
 * Every word and every snippet on this page comes from `button.frozen.json`, which
 * `freeze-archive-code.mts` captured from the LIVING page: the message tree for the prose, the
 * emitter for the code. Nothing here is typed by hand, and that is the point. An archive written by
 * hand is a second account of the docs that drifts from the first one; an archive CAPTURED is the
 * same account, stopped.
 *
 * WHY THE CODE HAD TO BE CAPTURED AND NOT RE-EMITTED. A usage tree is input, not source: the
 * emitter and the contract it reads both move forward with the repository, so emitting a tree while
 * this page renders would print today's markup under this version's heading, which is exactly what
 * the version axis exists to prevent (ADR-0022). The strings below were emitted once, on the day the
 * capture says.
 *
 * WHY THERE ARE NO LIVE STAGES. A `ComponentPreview` mounts the workspace as it is today. Under a
 * frozen URL that is not a convenience, it is a claim the archive cannot back. A real cut, which
 * builds the whole site at a tag, gets the rendered stage for free; until then the archive shows the
 * code it generated and says so in a line the reader can see.
 */
import FrozenPage from "../../../FrozenPage.astro";
import CodeBlock from "../../../CodeBlock.astro";
import { getLocale } from "../../../../i18n";
import frozen from "./button.frozen.json";

const locale = getLocale(Astro.url);
const copy = frozen.copy[locale];
const snippets = frozen.snippets[locale];

/** A captured string, by its message key. The keys are the living page's own. */
const say = (key: string): string => copy[`button.${key}` as keyof typeof copy] ?? "";

/**
 * The page's sections, in the order the living page teaches them. Each names its heading, its
 * prose, and the tree whose captured code it shows. This is the one thing the capture does NOT
 * carry, because structure is markup rather than data: a real cut freezes the rendered HTML and
 * does not need it at all.
 */
const sections = [
  { title: "variantsTitle", body: ["variantsBody", "toneCountBody", "translucentBody"], tree: "buttonMatrixTree" },
  { title: "pressedTitle", body: ["pressedBody"], tree: "buttonPressedTree" },
  { title: "destructiveTitle", body: ["destructiveBody"], tree: "buttonDestructivePairTree" },
  { title: "sizesTitle", body: [], tree: "buttonSizesTree" },
  { title: "iconTitle", body: ["iconBody"], tree: "buttonIconTree" },
  { title: "iconOnlyTitle", body: [], tree: "buttonIconOnlyTree" },
  { title: "linkTitle", body: ["linkBody"], tree: "buttonAsLinkTree" },
  { title: "tileTitle", body: ["tileBody"], tree: "tileButtonTree" },
] as const;
---

<FrozenPage
  title="Button"
  description={say("description")}
  version={frozen.version}
  frozenAt={frozen.capturedAt}
  demosOmitted
>
  <p class="lede" set:html={say("lede")} />
  <p set:html={say("anatomyBody")} />

  {
    sections.map((section) => (
      <Fragment>
        <h2>{say(section.title)}</h2>
        {section.body.map((key) => (
          <p set:html={say(key)} />
        ))}
        <CodeBlock code={snippets[section.tree].html} label="HTML" lang="html" />
        <CodeBlock code={snippets[section.tree].react} label="React" lang="tsx" />
      </Fragment>
    ))
  }
</FrozenPage>
