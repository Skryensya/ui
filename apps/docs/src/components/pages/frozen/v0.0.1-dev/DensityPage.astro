---
/*
 * DENSIDAD, AS VERSION 0.0.1-dev SHIPPED IT.
 *
 * The second foundations page in this archive, and it is here for a reason beyond coverage: it is
 * what the archived Fundamentos index links to, so the two of them together show a frozen version
 * behaving like a SITE (one archived page linking to another archived page) rather than like a
 * single stranded document.
 */
import FrozenPage from "../../../FrozenPage.astro";
import CodeBlock from "../../../CodeBlock.astro";
import { getLocale } from "../../../../i18n";

const FROZEN_AT = "2026-06-30";
const VERSION = "0.0.1-dev";

const locale = getLocale(Astro.url);

const copy = {
  es: {
    title: "Densidad",
    description: "Un ámbito que reproyecta los tokens de espacio y control en el límite que elijas.",
    lede: "La densidad local no es una variante de componente: es un ámbito que recalcula los tokens de espacio y de control en el límite de tu componente, sin tocar a sus vecinos ni la densidad que eligió la aplicación.",
    contractTitle: "El contrato vive en un solo nodo",
    contractBody:
      "<code>data-sk-density-scope</code> enciende la reproyección local; <code>--sk-density-factor</code>, escrito en <code>style</code>, decide el valor. No agrega clases, ni selectores, ni un prop por componente.",
    floorTitle: "El piso va por dentro",
    floorBody:
      "El factor multiplica, pero el area de toque nunca baja del mínimo accesible: el piso está dentro del cálculo, no en una regla aparte que alguien pueda olvidar.",
  },
  en: {
    title: "Density",
    description: "A scope that reprojects the space and control tokens at whatever boundary you pick.",
    lede: "Local density is not a component variant: it is a scope that recalculates the space and control tokens at your component's boundary, without touching its neighbours or the density the application chose.",
    contractTitle: "The contract lives on a single node",
    contractBody:
      "<code>data-sk-density-scope</code> turns local reprojection on; <code>--sk-density-factor</code>, written in <code>style</code>, sets the value. It adds no classes, no selectors and no prop per component.",
    floorTitle: "The floor is inside the multiplier",
    floorBody:
      "The factor multiplies, but the hit area never drops below the accessible minimum: the floor lives inside the calculation, not in a separate rule someone can forget.",
  },
}[locale];

const scope = `<section data-sk-density-scope style="--sk-density-factor: 0.85">
  <!-- everything in here reads the tighter scale -->
</section>`;
---

<FrozenPage
  title={copy.title}
  description={copy.description}
  version={VERSION}
  frozenAt={FROZEN_AT}
  demosOmitted
>
  <p class="lede">{copy.lede}</p>

  <h2>{copy.contractTitle}</h2>
  <p set:html={copy.contractBody} />
  <CodeBlock code={scope} label="HTML" lang="html" />

  <h2>{copy.floorTitle}</h2>
  <p set:html={copy.floorBody} />
</FrozenPage>
