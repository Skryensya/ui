---
import "@skryensya/core/components/toolbar.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/tooltip.css";
import "@skryensya/core/components/button.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  nestedToolbarTree,
  toolbarAnatomyTree,
  toolbarDoSingleTree,
  toolbarDontFlatTree,
  toolbarDontSingleTree,
  toolbarTree,
} from "../../demos/toolbar";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/components/toolbar.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`toolbarPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Toolbar"
  description={t("toolbarPage.description")}
  contractId="toolbar"
  appearanceTargetSelector=".sk-toolbar"
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("toolbarPage.lede")} />

    <UsagePreview
      tree={toolbarTree(t)}
      optionName="orientation"
      title={t("toolbarPage.prop.orientation.title")}
      description={t("toolbarPage.prop.orientation.body")}
      explain={explain("orientation", ["horizontal", "vertical"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={toolbarTree(t)} title={t("toolbarPage.basicTitle")} description={t("toolbarPage.basicBody")} />
    <UsagePreview tree={nestedToolbarTree(t)} title={t("toolbarPage.compositeTitle")} description={t("toolbarPage.compositeBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "toolbarPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("toolbarPage.anatomyBody")} />
    <UsagePreview
      tree={toolbarAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("toolbarPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("toolbarPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "toolbarPage.when")} avoid={tList(t, "toolbarPage.whenNot")} />
    <DoDont
      title={t("toolbarPage.dd.group.title")}
      do={{ tree: toolbarTree(t), caption: t("toolbarPage.dd.group.do") }}
      dont={{ tree: toolbarDontFlatTree(t), caption: t("toolbarPage.dd.group.dont") }}
    />
    <DoDont
      title={t("toolbarPage.dd.single.title")}
      do={{ tree: toolbarDoSingleTree(t), caption: t("toolbarPage.dd.single.do") }}
      dont={{ tree: toolbarDontSingleTree(t), caption: t("toolbarPage.dd.single.dont") }}
    />
    <ContentRules items={tList(t, "toolbarPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("toolbarPage.a11yIntro")}
      does={tList(t, "toolbarPage.a11yDoes")}
      yours={tList(t, "toolbarPage.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("toolbarPage.key.tab") },
        { keys: ["←", "→"], action: t("toolbarPage.key.arrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("toolbarPage.key.homeEnd") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
