---
import "@skryensya/core/patterns/state-layer.css";
import "@skryensya/core/patterns/icon-toggle.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/password-input.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  passwordInputAnatomyTree,
  passwordInputDoHintTree,
  passwordInputDontNoHintTree,
  passwordInputDontRepeatTree,
  passwordInputSignInTree,
  passwordInputSignUpTree,
  passwordInputSingleTree,
  passwordInputStatesTree,
} from "../../demos/password-input";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const styles = `@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/patterns/icon-toggle.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/password-input.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`passwordInput.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="PasswordInput"
  description={t("passwordInput.description")}
  badge={t("passwordInput.betaBadge")}
  contractId="password-input"
  appearanceTargetSelector=".sk-password-input"
  testFiles={["packages/react/src/components/password-input.test.tsx", "packages/vanilla/src/components/password-input.svelte.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("passwordInput.lede")} />

    <UsagePreview
      tree={passwordInputSingleTree(t)}
      optionName="appearance"
      title={t("passwordInput.prop.appearance.title")}
      description={t("passwordInput.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist", "frosted"])}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={passwordInputSingleTree(t)}
      optionName="disabled"
      title={t("passwordInput.prop.disabled.title")}
      description={t("passwordInput.prop.disabled.body")}
      explain={explain("disabled", ["false", "true"])}
      stageMinBlockSize="8rem"
      labels={{ false: t("passwordInput.prop.disabled.falseLabel"), true: t("passwordInput.prop.disabled.trueLabel") }}
    />

    <h3>{t("passwordInput.showcaseTitle")}</h3>
    <p set:html={t("passwordInput.showcaseBody")} />

    <h3>{t("passwordInput.signInTitle")}</h3>
    <p set:html={t("passwordInput.signInBody")} />
    <UsagePreview tree={passwordInputSignInTree(t)} />

    <h3>{t("passwordInput.signUpTitle")}</h3>
    <p set:html={t("passwordInput.signUpBody")} />
    <UsagePreview tree={passwordInputSignUpTree(t)} />

    <h3>{t("passwordInput.statesTitle")}</h3>
    <p set:html={t("passwordInput.statesBody")} />
    <UsagePreview tree={passwordInputStatesTree(t)} />

    <h3>{t("passwordInput.managersTitle")}</h3>
    <p set:html={t("passwordInput.managersBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("passwordInput.anatomyBody")} />
    <ComponentPreview
      tree={passwordInputAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("passwordInput.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("passwordInput.guidelinesLede")} />
    <h3>{t("passwordInput.whenTitle")}</h3>
    <ul>
      <li set:html={t("passwordInput.whenItem1")} />
      <li set:html={t("passwordInput.whenItem2")} />
      <li set:html={t("passwordInput.whenItem3")} />
    </ul>
    <DoDont
      title={t("passwordInput.dd.rule.title")}
      do={{ tree: passwordInputDoHintTree(t), caption: t("passwordInput.dd.rule.do") }}
      dont={{ tree: passwordInputDontNoHintTree(t), caption: t("passwordInput.dd.rule.dont") }}
    />
    <DoDont
      title={t("passwordInput.dd.repeat.title")}
      do={{ tree: passwordInputDoHintTree(t), caption: t("passwordInput.dd.repeat.do") }}
      dont={{ tree: passwordInputDontRepeatTree(t), caption: t("passwordInput.dd.repeat.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("passwordInput.a11yBody")} />
  </Fragment>
</ComponentPageShell>
