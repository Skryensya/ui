---
import "@skryensya/core/patterns/state-layer.css";
import "@skryensya/core/patterns/icon-toggle.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/password-input.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import PasswordVsOtp from "../PasswordVsOtp.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  passwordInputAnatomyTree,
  passwordInputDoHintTree,
  passwordInputDoPasswordTree,
  passwordInputDontNoHintTree,
  passwordInputDontOtpTree,
  passwordInputDontPlainTree,
  passwordInputDontRepeatTree,
  passwordInputStateCase,
  passwordInputSignInTree,
  passwordInputSignUpTree,
} from "../../demos/password-input";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
/* The states that read at rest on a field with no typed value. */
const states = ["default", "invalid", "disabled"] as const;
const styles = `@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/patterns/icon-toggle.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/password-input.css";`;
---

<ComponentPageShell
  title="PasswordInput"
  description={t("passwordInput.description")}
  contractId="password-input"
  appearanceTargetSelector=".sk-password-input"
  testFiles={["packages/react/src/components/password-input.test.tsx", "packages/vanilla/src/components/password-input.svelte.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("passwordInput.lede")} />

    <UsagePreview
      tree={passwordInputStateCase(t, "default")}
      variants={states.map((state) => ({
        value: state,
        label: t(`component.state.${state}` as Parameters<typeof t>[0]),
        tree: passwordInputStateCase(t, state),
        explain: t(`passwordInput.state.${state}` as Parameters<typeof t>[0]),
      }))}
      variantsLabel={t("passwordInput.state.label")}
      title={t("passwordInput.state.title")}
      description={t("passwordInput.state.body")}
      stageMinBlockSize="10rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={passwordInputSignInTree(t)} title={t("passwordInput.signInTitle")} description={t("passwordInput.signInBody")} />
    <UsagePreview tree={passwordInputSignUpTree(t)} title={t("passwordInput.signUpTitle")} description={t("passwordInput.signUpBody")} />

    <PasswordVsOtp from="password-input" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "passwordInput.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("passwordInput.anatomyBody")} />
    <UsagePreview
      tree={passwordInputAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("passwordInput.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("passwordInput.guidelinesLede")} />
    <WhenToUse use={tList(t, "passwordInput.when")} avoid={tList(t, "passwordInput.whenNot")} />
    <DoDont
      title={t("passwordInput.dd.rule.title")}
      do={{ tree: passwordInputDoHintTree(t), caption: t("passwordInput.dd.rule.do") }}
      dont={{ tree: passwordInputDontNoHintTree(t), caption: t("passwordInput.dd.rule.dont") }}
    />
    <DoDont
      title={t("passwordInput.dd.repeat.title")}
      do={{ tree: passwordInputDoHintTree(t), caption: t("passwordInput.dd.repeat.do") }}
      dont={{ tree: passwordInputDontRepeatTree(t), caption: t("passwordInput.dd.repeat.dont") }}
    />
    <DoDont
      title={t("passwordInput.dd.otp.title")}
      do={{ tree: passwordInputDoPasswordTree(t), caption: t("passwordInput.dd.otp.do") }}
      dont={{ tree: passwordInputDontOtpTree(t), caption: t("passwordInput.dd.otp.dont") }}
      canvas
      compact
    />
    <DoDont
      title={t("passwordInput.dd.toggle.title")}
      do={{ tree: passwordInputDoPasswordTree(t), caption: t("passwordInput.dd.toggle.do") }}
      dont={{ tree: passwordInputDontPlainTree(t), caption: t("passwordInput.dd.toggle.dont") }}
    />
    <ContentRules items={tList(t, "passwordInput.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("passwordInput.a11yIntro")}
      does={tList(t, "passwordInput.a11yDoes")}
      yours={tList(t, "passwordInput.a11yYours")}
      keys={[{ keys: ["Enter", t("component.key.space")], action: t("passwordInput.key.toggle") }]}
    />
  </Fragment>
</ComponentPageShell>
