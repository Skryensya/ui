---
import "@skryensya/core/components/otp-input.css";
import "@skryensya/core/patterns/layout.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import PasswordVsOtp from "../PasswordVsOtp.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  otpInputAlphanumericTree,
  otpInputAnatomyTree,
  otpInputCountCase,
  otpInputDoGroupHtml,
  otpInputDoLongTree,
  otpInputDoMaskHtml,
  otpInputDontGroupHtml,
  otpInputDontLongTree,
  otpInputDontMaskHtml,
  otpInputDontNoHintTree,
  otpInputDontPasswordTree,
  otpInputPinTree,
  otpInputSingleTree,
  otpInputSmsTree,
  otpInputStateCase,
} from "../../demos/otp-input";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
/* The lengths a code comes in, and the states the field can be in: both are choices of the author or
   conditions of the field, told apart by what a person sees at rest. */
const counts = [4, 6, 8] as const;
const states = ["default", "readOnly", "invalid", "disabled"] as const;
const styles = `@import "@skryensya/core/components/otp-input.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`otpInput.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="OtpInput"
  description={t("otpInput.description")}
  contractId="otp-input"
  testFiles={["packages/react/src/components/otp-input.test.tsx", "packages/vanilla/src/components/otp-input.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("otpInput.lede")} />

    <UsagePreview
      tree={otpInputSingleTree(t)}
      optionName="mask"
      title={t("otpInput.prop.mask.title")}
      description={t("otpInput.prop.mask.body")}
      explain={explain("mask", ["false", "true"])}
      stageMinBlockSize="8rem"
      labels={{ false: t("otpInput.prop.mask.falseLabel"), true: t("otpInput.prop.mask.trueLabel") }}
    />

    <UsagePreview
      tree={otpInputSingleTree(t)}
      optionName="groupSize"
      title={t("otpInput.prop.groupSize.title")}
      description={t("otpInput.prop.groupSize.body")}
      explain={explain("groupSize", ["2", "3", "4"])}
      labels={{ "2": "2", "3": "3", "4": "4" }}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={otpInputCountCase(t, 6)}
      variants={counts.map((count) => ({
        value: String(count),
        label: String(count),
        tree: otpInputCountCase(t, count),
        explain: t(`otpInput.prop.count.${count}` as Parameters<typeof t>[0]),
      }))}
      initialVariant="6"
      variantsLabel={t("otpInput.prop.count.label")}
      title={t("otpInput.prop.count.title")}
      description={t("otpInput.prop.count.body")}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={otpInputStateCase(t, "default")}
      variants={states.map((state) => ({
        value: state,
        label: t(`component.state.${state}` as Parameters<typeof t>[0]),
        tree: otpInputStateCase(t, state),
        explain: t(`otpInput.state.${state}` as Parameters<typeof t>[0]),
      }))}
      variantsLabel={t("otpInput.state.label")}
      title={t("otpInput.state.title")}
      description={t("otpInput.state.body")}
      stageMinBlockSize="9rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={otpInputSmsTree(t)} title={t("otpInput.smsTitle")} description={t("otpInput.smsBody")} />
    <UsagePreview tree={otpInputAlphanumericTree(t)} title={t("otpInput.alphanumericTitle")} description={t("otpInput.alphanumericBody")} />
    <UsagePreview tree={otpInputPinTree(t)} title={t("otpInput.pinTitle")} description={t("otpInput.pinBody")} />

    <PasswordVsOtp from="otp-input" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "otpInput.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("otpInput.anatomyBody")} />
    <UsagePreview
      tree={otpInputAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("otpInput.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("otpInput.guidelinesLede")} />
    <WhenToUse use={tList(t, "otpInput.when")} avoid={tList(t, "otpInput.whenNot")} />
    <DoDont
      title={t("otpInput.dd.hint.title")}
      do={{ tree: otpInputSmsTree(t), caption: t("otpInput.dd.hint.do") }}
      dont={{ tree: otpInputDontNoHintTree(t), caption: t("otpInput.dd.hint.dont") }}
    />
    <DoDont
      title={t("otpInput.dd.password.title")}
      do={{ tree: otpInputSmsTree(t), caption: t("otpInput.dd.password.do") }}
      dont={{ tree: otpInputDontPasswordTree(t), caption: t("otpInput.dd.password.dont") }}
    />
    <DoDont
      title={t("otpInput.dd.mask.title")}
      do={{ html: otpInputDoMaskHtml(t), caption: t("otpInput.dd.mask.do") }}
      dont={{ html: otpInputDontMaskHtml(t), caption: t("otpInput.dd.mask.dont") }}
    />
    <DoDont
      title={t("otpInput.dd.group.title")}
      do={{ html: otpInputDoGroupHtml(t), caption: t("otpInput.dd.group.do") }}
      dont={{ html: otpInputDontGroupHtml(t), caption: t("otpInput.dd.group.dont") }}
    />
    <DoDont
      canvas
      title={t("otpInput.dd.long.title")}
      do={{ tree: otpInputDoLongTree(t), caption: t("otpInput.dd.long.do") }}
      dont={{ tree: otpInputDontLongTree(t), caption: t("otpInput.dd.long.dont") }}
    />
    <ContentRules items={tList(t, "otpInput.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("otpInput.a11yIntro")}
      does={tList(t, "otpInput.a11yDoes")}
      yours={tList(t, "otpInput.a11yYours")}
      keys={[
        { keys: ["←", "→"], action: t("otpInput.key.arrows") },
        { keys: ["Backspace"], action: t("otpInput.key.backspace") },
        { keys: ["Ctrl+V", "⌘+V"], action: t("otpInput.key.paste") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
