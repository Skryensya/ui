---
import "@skryensya/core/components/otp-input.css";
import "@skryensya/core/patterns/layout.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  otpInputAlphanumericTree,
  otpInputAnatomyTree,
  otpInputDoLongTree,
  otpInputDontLongTree,
  otpInputDontNoHintTree,
  otpInputPinTree,
  otpInputSingleTree,
  otpInputSmsTree,
  otpInputStatesTree,
} from "../../demos/otp-input";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const styles = `@import "@skryensya/core/components/otp-input.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`otpInput.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="OtpInput"
  description={t("otpInput.description")}
  badge={t("otpInput.betaBadge")}
  contractId="otp-input"
  testFiles={["packages/react/src/components/otp-input.test.tsx", "packages/vanilla/src/components/otp-input.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("otpInput.lede")} />

    <UsagePreview
      tree={otpInputSingleTree(t)}
      optionName="mask"
      title={t("otpInput.prop.mask.title")}
      description={t("otpInput.prop.mask.body")}
      explain={explain("mask", ["false", "true"])}
      stageMinBlockSize="8rem"
      labels={{ false: t("otpInput.prop.mask.falseLabel"), true: t("otpInput.prop.mask.trueLabel") }}
    />

    <h3>{t("otpInput.showcaseTitle")}</h3>
    <p set:html={t("otpInput.showcaseBody")} />

    <h3>{t("otpInput.smsTitle")}</h3>
    <p set:html={t("otpInput.smsBody")} />
    <UsagePreview tree={otpInputSmsTree(t)} />

    <h3>{t("otpInput.alphanumericTitle")}</h3>
    <p set:html={t("otpInput.alphanumericBody")} />
    <UsagePreview tree={otpInputAlphanumericTree(t)} />

    <h3>{t("otpInput.pinTitle")}</h3>
    <p set:html={t("otpInput.pinBody")} />
    <UsagePreview tree={otpInputPinTree(t)} />

    <h3>{t("otpInput.statesTitle")}</h3>
    <p set:html={t("otpInput.statesBody")} />
    <UsagePreview tree={otpInputStatesTree(t)} />

    <h3>{t("otpInput.eventsTitle")}</h3>
    <p set:html={t("otpInput.eventsBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("otpInput.anatomyBody")} />
    <ComponentPreview
      tree={otpInputAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("otpInput.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("otpInput.guidelinesLede")} />
    <h3>{t("otpInput.whenTitle")}</h3>
    <ul>
      <li set:html={t("otpInput.whenItem1")} />
      <li set:html={t("otpInput.whenItem2")} />
      <li set:html={t("otpInput.whenItem3")} />
    </ul>
    <DoDont
      title={t("otpInput.dd.hint.title")}
      do={{ tree: otpInputSmsTree(t), caption: t("otpInput.dd.hint.do") }}
      dont={{ tree: otpInputDontNoHintTree(t), caption: t("otpInput.dd.hint.dont") }}
    />
    <DoDont
      canvas
      title={t("otpInput.dd.long.title")}
      do={{ tree: otpInputDoLongTree(t), caption: t("otpInput.dd.long.do") }}
      dont={{ tree: otpInputDontLongTree(t), caption: t("otpInput.dd.long.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("otpInput.a11yBody")} />
  </Fragment>
</ComponentPageShell>
