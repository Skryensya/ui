---
import "@skryensya/core/components/segmented.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { segmentedAnatomyTree, segmentedTree } from "../../demos/segmented";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;
const js = `import { initComponents } from "@skryensya/vanilla/auto";

await initComponents();`;
---

<ComponentPageShell
  title="SegmentedControl"
  description={t("segmentedPage.description")}
  contractId="segmented"
  styleGroups={[{ file: "components/segmented.css", probe: "sk-segmented" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/segmented.test.ts",
      tests: [
        { name: "patches the authored parts into one roving radiogroup", description: t("segmentedPage.test1") },
        {
          name: "selects on click and arrow navigation, skipping disabled options",
          description: t("segmentedPage.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("segmentedPage.lede")} />

    <p set:html={t("segmentedPage.anatomyBody")} />
    <ComponentPreview
      tree={segmentedAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("segmentedPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={segmentedTree(t)} label="Segmented" />
    <p set:html={t("segmentedPage.body")} />
    <p set:html={t("component.reactNote")} />
    <p set:html={t("segmentedPage.reactBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />

    <h3>{t("segmentedPage.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />
  </Fragment>
</ComponentPageShell>
