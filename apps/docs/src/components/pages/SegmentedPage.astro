---
import "@skryensya/core/components/segmented.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { segmentedAnatomyTree, segmentedTree, segmentedDontManyTree } from "../../demos/segmented";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;
const js = `import { initComponents } from "@skryensya/vanilla/auto";

await initComponents();`;
import { segmentedShapeDoTree, segmentedShapeDontTree } from "../../demos/dodont-labels";
---

<ComponentPageShell
  title="SegmentedControl"
  description={t("segmentedPage.description")}
  contractId="segmented"
  appearanceTargetSelector=".sk-segmented"
  testFiles={["packages/vanilla/src/components/segmented.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("segmentedPage.lede")} />

    <UsagePreview
      tree={segmentedTree(t)}
      optionName="size"
      title={t("segmentedPage.prop.size.title")}
      description={t("segmentedPage.prop.size.body")}
      explain={{ sm: t("segmentedPage.prop.size.sm"), md: t("segmentedPage.prop.size.md"), lg: t("segmentedPage.prop.size.lg") }}
      labels={{ sm: "sm", md: "md", lg: "lg" }}
      stageMinBlockSize="7rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={segmentedTree(t)} title={t("segmentedPage.viewsTitle")} description={t("segmentedPage.viewsBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "segmentedPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("segmentedPage.anatomyBody")} />
    <UsagePreview
      tree={segmentedAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("segmentedPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("segmentedPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "segmentedPage.when")} avoid={tList(t, "segmentedPage.whenNot")} />
    <DoDont
      title={t("segmentedPage.dd.few.title")}
      do={{ tree: segmentedTree(t), caption: t("segmentedPage.dd.few.do") }}
      dont={{ tree: segmentedDontManyTree(t), caption: t("segmentedPage.dd.few.dont") }}
    />
    <DoDont
      title={t("segmentedPage.dd.shape.title")}
      do={{ tree: segmentedShapeDoTree(t), caption: t("segmentedPage.dd.shape.do") }}
      dont={{ tree: segmentedShapeDontTree(t), caption: t("segmentedPage.dd.shape.dont") }}
    />
    <ContentRules items={tList(t, "segmentedPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />

    <h3>{t("segmentedPage.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes
      intro={t("segmentedPage.a11yIntro")}
      does={tList(t, "segmentedPage.a11yDoes")}
      yours={tList(t, "segmentedPage.a11yYours")}
      keys={[
        { keys: ["←", "→"], action: t("segmentedPage.key.arrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("segmentedPage.key.homeEnd") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
