---
import "@skryensya/core/components/segmented.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import { segmentedAnatomyTree, segmentedTree, segmentedDontManyTree } from "../../demos/segmented";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;
const js = `import { initComponents } from "@skryensya/vanilla/auto";

await initComponents();`;
---

<ComponentPageShell
  title="SegmentedControl"
  description={t("segmentedPage.description")}
  contractId="segmented"
  appearanceTargetSelector=".sk-segmented"
  testFiles={["packages/vanilla/src/components/segmented.test.ts"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("segmentedPage.lede")} />

    <UsagePreview
      tree={segmentedTree(t)}
      optionName="size"
      title={t("segmentedPage.prop.size.title")}
      description={t("segmentedPage.prop.size.body")}
      explain={{ sm: t("segmentedPage.prop.size.sm"), md: t("segmentedPage.prop.size.md"), lg: t("segmentedPage.prop.size.lg") }}
      labels={{ sm: "sm", md: "md", lg: "lg" }}
      stageMinBlockSize="7rem"
    />

    <UsagePreview
      tree={segmentedTree(t)}
      optionName="appearance"
      title={t("segmentedPage.prop.appearance.title")}
      description={t("segmentedPage.prop.appearance.body")}
      explain={{
        plain: t("segmentedPage.prop.appearance.plain"),
        tactile: t("segmentedPage.prop.appearance.tactile"),
        brutalist: t("segmentedPage.prop.appearance.brutalist"),
        frosted: t("segmentedPage.prop.appearance.frosted"),
      }}
      stageMinBlockSize="7rem"
    />

    <h3>{t("segmentedPage.showcaseTitle")}</h3>
    <p set:html={t("segmentedPage.showcaseBody")} />
    <ComponentPreview tree={segmentedTree(t)} label="Segmented" />
    <p set:html={t("segmentedPage.body")} />
    <p set:html={t("component.reactNote")} />
    <p set:html={t("segmentedPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("segmentedPage.anatomyBody")} />
    <ComponentPreview
      tree={segmentedAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("segmentedPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("segmentedPage.guidelinesLede")} />
    <DoDont
      title={t("segmentedPage.dd.few.title")}
      do={{ tree: segmentedTree(t), caption: t("segmentedPage.dd.few.do") }}
      dont={{ tree: segmentedDontManyTree(t), caption: t("segmentedPage.dd.few.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />

    <h3>{t("segmentedPage.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />
  </Fragment>
</ComponentPageShell>
