---
import "@skryensya/core/components/quote.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The testimonial sits on a Box, and a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/patterns/box.css";
/* The person's picture is an Avatar. */
import "@skryensya/core/components/avatar.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  quoteDoAvatarTree,
  quoteDoInTextTree,
  quoteDoNamedTree,
  quoteDoPullTree,
  quoteDontPullInTextTree,
  quoteDontVagueTree,
  quoteDontInitialsTree,
  quoteAvatarTree,
  quotePullAvatarTree,
  quoteTextTree,
  quoteAnatomyTree,
  quoteBareTree,
  quoteDoNoticeTree,
  quoteDontLongPullTree,
  quoteDontNoticeTree,
  quotePullTree,
  quoteTestimonialTree,
  quoteTree,
} from "../../demos/quote";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/quote.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`quotePage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Quote"
  description={t("quotePage.description")}
  contractId="quote"
  testFiles={["packages/react/src/components/quote.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("quotePage.lede")} />

    <UsagePreview
      tree={quoteTree(t)}
      optionName="variant"
      title={t("quotePage.prop.variant.title")}
      description={t("quotePage.prop.variant.body")}
      explain={explain("variant", ["block", "pull"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={quoteTextTree(t)} title={t("quotePage.citedTitle")} description={t("quotePage.citedBody")} />
    <UsagePreview tree={quoteAvatarTree(t)} title={t("quotePage.portraitTitle")} description={t("quotePage.portraitBody")} />
    <UsagePreview tree={quoteBareTree(t)} title={t("quotePage.bareTitle")} description={t("quotePage.bareBody")} />
    <UsagePreview tree={quotePullTree(t)} title={t("quotePage.pullTitle")} description={t("quotePage.pullBody")} />
    <UsagePreview tree={quotePullAvatarTree(t)} title={t("quotePage.pullPortraitTitle")} description={t("quotePage.pullPortraitBody")} />
    <UsagePreview tree={quoteTestimonialTree(t)} title={t("quotePage.testimonialTitle")} description={t("quotePage.testimonialBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "quotePage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("quotePage.anatomyBody")} />
    <UsagePreview tree={quoteAnatomyTree(t)} css={annotationDemoCss} label={t("quotePage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("quotePage.guidelinesLede")} />
    <WhenToUse use={tList(t, "quotePage.when")} avoid={tList(t, "quotePage.whenNot")} />
    <DoDont
      canvas
      title={t("quotePage.dd.place.title")}
      do={{ tree: quoteDoInTextTree(t), caption: t("quotePage.dd.place.do") }}
      dont={{ tree: quoteDontPullInTextTree(t), caption: t("quotePage.dd.place.dont") }}
    />
    <DoDont
      canvas
      title={t("quotePage.dd.pull.title")}
      do={{ tree: quoteDoPullTree(t), caption: t("quotePage.dd.pull.do") }}
      dont={{ tree: quoteDontLongPullTree(t), caption: t("quotePage.dd.pull.dont") }}
    />
    <DoDont
      canvas
      title={t("quotePage.dd.who.title")}
      do={{ tree: quoteDoNamedTree(t), caption: t("quotePage.dd.who.do") }}
      dont={{ tree: quoteDontVagueTree(t), caption: t("quotePage.dd.who.dont") }}
    />
    <DoDont
      canvas
      title={t("quotePage.dd.notice.title")}
      do={{ tree: quoteDoNoticeTree(t), caption: t("quotePage.dd.notice.do") }}
      dont={{ tree: quoteDontNoticeTree(t), caption: t("quotePage.dd.notice.dont") }}
    />
    <DoDont
      canvas
      title={t("quotePage.dd.image.title")}
      do={{ tree: quoteDoAvatarTree(t), caption: t("quotePage.dd.image.do") }}
      dont={{ tree: quoteDontInitialsTree(t), caption: t("quotePage.dd.image.dont") }}
    />
    <ContentRules items={tList(t, "quotePage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes intro={t("quotePage.a11yIntro")} does={tList(t, "quotePage.a11yDoes")} yours={tList(t, "quotePage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
