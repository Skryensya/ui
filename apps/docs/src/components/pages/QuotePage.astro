---
import "@skryensya/core/components/quote.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The testimonial sits on a Box, and a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/patterns/box.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  quoteAnatomyTree,
  quoteBareTree,
  quoteDoNoticeTree,
  quoteDontLongPullTree,
  quoteDontNoticeTree,
  quotePullTree,
  quoteTestimonialTree,
  quoteTree,
} from "../../demos/quote";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/quote.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`quotePage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Quote"
  description={t("quotePage.description")}
  contractId="quote"
  testFiles={["packages/react/src/components/quote.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("quotePage.lede")} />

    <UsagePreview
      tree={quoteTree(t)}
      optionName="variant"
      title={t("quotePage.prop.variant.title")}
      description={t("quotePage.prop.variant.body")}
      explain={explain("variant", ["block", "pull"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("quotePage.showcaseTitle")}</h3>
    <p set:html={t("quotePage.showcaseBody")} />
    <UsagePreview tree={quoteTree(t)} />

    <h3>{t("quotePage.citeTitle")}</h3>
    <p set:html={t("quotePage.citeBody")} />

    <h3>{t("quotePage.bareTitle")}</h3>
    <p set:html={t("quotePage.bareBody")} />
    <UsagePreview tree={quoteBareTree(t)} />

    <h3>{t("quotePage.pullTitle")}</h3>
    <p set:html={t("quotePage.pullBody")} />
    <UsagePreview tree={quotePullTree(t)} />

    <h3>{t("quotePage.testimonialTitle")}</h3>
    <p set:html={t("quotePage.testimonialBody")} />
    <UsagePreview tree={quoteTestimonialTree(t)} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("quotePage.contractItem1")} />
      <li set:html={t("quotePage.contractItem2")} />
      <li set:html={t("quotePage.contractItem3")} />
      <li set:html={t("quotePage.contractItem4")} />
      <li set:html={t("quotePage.contractItem5")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("quotePage.anatomyBody")} />
    <ComponentPreview
      tree={quoteAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("quotePage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("quotePage.guidelinesLede")} />
    <h3>{t("quotePage.whenTitle")}</h3>
    <ul>
      <li set:html={t("quotePage.whenItem1")} />
      <li set:html={t("quotePage.whenItem2")} />
      <li set:html={t("quotePage.whenItem3")} />
      <li set:html={t("quotePage.whenItem4")} />
    </ul>
    <DoDont
      canvas
      title={t("quotePage.dd.pull.title")}
      do={{ tree: quotePullTree(t), caption: t("quotePage.dd.pull.do") }}
      dont={{ tree: quoteDontLongPullTree(t), caption: t("quotePage.dd.pull.dont") }}
    />
    <DoDont
      title={t("quotePage.dd.notice.title")}
      do={{ tree: quoteDoNoticeTree(t), caption: t("quotePage.dd.notice.do") }}
      dont={{ tree: quoteDontNoticeTree(t), caption: t("quotePage.dd.notice.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>
