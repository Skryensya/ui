---
import "@skryensya/core/components/stat.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  statAnatomyTree,
  statAnimatedTree,
  statCardsTree,
  statDoContextTree,
  statDontContextTree,
  statDontWallTree,
  statSingleTree,
} from "../../demos/stat";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const install = `pnpm add @skryensya/core @skryensya/react`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`statPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Stat"
  description={t("statPage.description")}
  contractId="stat"
  testFiles={["packages/react/src/components/stat.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("statPage.lede")} />

    <UsagePreview
      tree={statSingleTree(t)}
      optionName="trend"
      title={t("statPage.prop.trend.title")}
      description={t("statPage.prop.trend.body")}
      explain={explain("trend", ["up", "down", "neutral"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("statPage.showcaseTitle")}</h3>
    <p set:html={t("statPage.showcaseBody")} />
    <h3>{t("statPage.cardTitle")}</h3>
    <p set:html={t("statPage.cardBody")} />
    <UsagePreview tree={statCardsTree(t, locale)} />

    <h3 id="animar">{t("statPage.animateTitle")}</h3>
    <p set:html={t("statPage.animateBody")} />
    <ComponentPreview tree={statAnimatedTree(t, locale)} label={t("statPage.animateLabel")} note={t("statPage.animateNote")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("statPage.anatomyBody")} />
    <ComponentPreview
      tree={statAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("statPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("statPage.guidelinesLede")} />
    <DoDont
      title={t("statPage.dd.context.title")}
      do={{ tree: statDoContextTree(t), caption: t("statPage.dd.context.do") }}
      dont={{ tree: statDontContextTree(t), caption: t("statPage.dd.context.dont") }}
    />
    <DoDont
      canvas
      title={t("statPage.dd.table.title")}
      do={{ tree: statCardsTree(t, locale), caption: t("statPage.dd.table.do") }}
      dont={{ tree: statDontWallTree(t), caption: t("statPage.dd.table.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
