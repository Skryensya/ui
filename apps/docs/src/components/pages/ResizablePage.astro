---
import "@skryensya/core/components/resizable.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The demos hold real copy, and a frame only copies styles THIS page loaded. */
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/separator.css";
import "@skryensya/core/patterns/layout.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import DoDont from "../DoDont.astro";
import { ResizableCollapse } from "../react-demos/resizable-collapse";
import {
  resizableAnatomyTree,
  resizableCollapsibleTree,
  resizableDoBoundsTree,
  resizableDoCountTree,
  resizableDontBoundsTree,
  resizableDontCountTree,
  resizableHorizontalTree,
  resizableSpecimenTree,
  resizableThreeTree,
  resizableVerticalTree,
} from "../../demos/resizable";
import { annotationDemoCss } from "../../demos/annotation";
import { emitReactSource } from "@skryensya/ai-compiler/emit";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla
# or
pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/resizable.css";`;
const vanilla = `import "@skryensya/vanilla/auto";`;
const react = emitReactSource(resizableHorizontalTree(t), { component: "ResizableExample" }).component;

const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`resizablePage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Resizable"
  description={t("resizablePage.description")}
  contractId="resizable"
  testFiles={["packages/react/src/components/resizable.test.tsx", "packages/vanilla/src/components/resizable.test.ts", "packages/core/src/resizable.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("resizablePage.lede")} />

    <UsagePreview
      tree={resizableSpecimenTree(t)}
      optionName="direction"
      title={t("resizablePage.prop.direction.title")}
      description={t("resizablePage.prop.direction.body")}
      explain={explain("direction", ["horizontal", "vertical"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={resizableHorizontalTree(t)} title={t("resizablePage.horizontalTitle")} description={t("resizablePage.horizontalBody")} />
    <UsagePreview tree={resizableVerticalTree(t)} title={t("resizablePage.verticalTitle")} description={t("resizablePage.verticalBody")} />
    <UsagePreview tree={resizableThreeTree(t)} title={t("resizablePage.threeTitle")} description={t("resizablePage.threeBody")} />

    <h3>{t("resizablePage.collapseTitle")}</h3>
    <p set:html={t("resizablePage.collapseBody")} />
    <UsagePreview tree={resizableCollapsibleTree(t)} title={t("resizablePage.collapseTitle")} description={t("resizablePage.collapseBody")} />
    <h4>{t("resizablePage.collapseDemoTitle")}</h4>
    <p set:html={t("resizablePage.collapseDemoBody")} />
    <div class="rz-stage">
      <ResizableCollapse
        client:visible
        copy={{
          collapse: t("resizablePage.collapseButtons.collapse"),
          expand: t("resizablePage.collapseButtons.expand"),
          reset: t("resizablePage.collapseButtons.reset"),
          nav: t("demo.resizable.files"),
          main: t("demo.resizable.editor"),
          handle: t("demo.resizable.handleFiles"),
          file1: t("demo.resizable.file1"),
          file2: t("demo.resizable.file2"),
          file3: t("demo.resizable.file3"),
          state: { open: t("resizablePage.collapseState.open"), closed: t("resizablePage.collapseState.closed") },
        }}
      />
    </div>

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "resizablePage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("resizablePage.anatomyBody")} />
    <UsagePreview tree={resizableAnatomyTree(t)} css={annotationDemoCss} label={t("resizablePage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("resizablePage.guidelinesLede")} />
    <WhenToUse use={tList(t, "resizablePage.when")} avoid={tList(t, "resizablePage.whenNot")} />
    <DoDont
      title={t("resizablePage.dd.bounds.title")}
      do={{ tree: resizableDoBoundsTree(t), caption: t("resizablePage.dd.bounds.do") }}
      dont={{ tree: resizableDontBoundsTree(t), caption: t("resizablePage.dd.bounds.dont") }}
    />
    <DoDont
      title={t("resizablePage.dd.count.title")}
      do={{ tree: resizableDoCountTree(t), caption: t("resizablePage.dd.count.do") }}
      dont={{ tree: resizableDontCountTree(t), caption: t("resizablePage.dd.count.dont") }}
    />
    <ContentRules items={tList(t, "resizablePage.content")} />
  </Fragment>

  <Fragment slot="install">
    <p set:html={t("resizablePage.installBody")} />
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
    <CodeBlock code={vanilla} label="Vanilla" lang="ts" />
    <CodeBlock code={react} label="React" lang="tsx" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("resizablePage.a11yIntro")}
      does={tList(t, "resizablePage.a11yDoes")}
      yours={tList(t, "resizablePage.a11yYours")}
      keys={[
        { keys: ["←", "→", "↑", "↓"], action: t("resizablePage.key.arrows") },
        { keys: ["Home", "End"], action: t("resizablePage.key.ends") },
        { keys: ["Enter"], action: t("resizablePage.key.reset") },
        { keys: ["Ctrl", "Enter"], action: t("resizablePage.key.collapse") },
      ]}
    />
  </Fragment>
</ComponentPageShell>

<style is:global>
  /* The collapse demo is a React island: its own markup, outside this page's scope. */
  .rz-stage {
    padding: var(--space-inset-lg);
    margin-block: var(--space-stack-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-surface);
    background: var(--color-bg-surface);
  }

  .rz-collapse {
    display: grid;
    gap: var(--space-stack-md);
  }

  .rz-collapse__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-inline-sm);
  }

  .rz-collapse__state {
    margin-inline-start: auto;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-sm);
    font-variant-numeric: tabular-nums;
  }

  .rz-collapse__files {
    margin: var(--space-stack-xs) 0 0;
    padding-inline-start: var(--space-inset-lg);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-sm);
  }
</style>
