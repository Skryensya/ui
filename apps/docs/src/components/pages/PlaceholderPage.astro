---
/* The CSS block below documents this import; the page never actually made it. Without the base
   `.sk-placeholder` rule nothing sets `block-size`, so every text-shaped line measured 0px and the
   skeleton painted only its media block: the one thing this page exists to show. */
import "@skryensya/core/components/placeholder.css";
import "../../examples/placeholder.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { placeholderDontSlabTree } from "../../demos/placeholder";
import {
  placeholderAnatomyTree,
  placeholderMatchTree,
  placeholderParagraphTree,
  placeholderVocabularyTree,
  publicationPlaceholderTree,
  publicationSwapScript,
  publicationSwapTree,
} from "../../demos/placeholder";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
const swapScript = publicationSwapScript;
const styles = `@import "@skryensya/core/components/placeholder.css";
@import "@skryensya/core/patterns/layout.css";
@import "@skryensya/core/components/badge.css";
@import "@skryensya/core/components/avatar.css";
@import "@skryensya/core/components/typography.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`placeholderPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Placeholder"
  description={t("placeholderPage.description")}
  contractId="placeholder"
  testFiles={["packages/react/src/components/placeholder.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("placeholderPage.lede")} />

    <UsagePreview
      tree={placeholderParagraphTree()}
      optionName="shimmer"
      title={t("placeholderPage.prop.shimmer.title")}
      description={t("placeholderPage.prop.shimmer.body")}
      explain={explain("shimmer", ["false", "true"])}
      stageMinBlockSize="8rem"
      labels={{ false: t("placeholderPage.prop.shimmer.falseLabel"), true: t("placeholderPage.prop.shimmer.trueLabel") }}
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={publicationPlaceholderTree(t)} title={t("placeholderPage.layoutTitle")} description={t("placeholderPage.layoutBody")} />
    <h3>{t("placeholderPage.swapTitle")}</h3>
    <p set:html={t("placeholderPage.swapBody")} />
    <UsagePreview tree={publicationSwapTree(t)} script={swapScript} label={t("placeholderPage.swapLabel")} />
    <UsagePreview tree={placeholderVocabularyTree()} title={t("placeholderPage.shapesTitle")} description={t("placeholderPage.shapesBody")} />
    <UsagePreview tree={placeholderMatchTree(t)} title={t("placeholderPage.matchTitle")} description={t("placeholderPage.matchBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "placeholderPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("placeholderPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("placeholderPage.anatomyBody")} />
    <UsagePreview
      tree={placeholderAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("placeholderPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("placeholderPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "placeholderPage.when")} avoid={tList(t, "placeholderPage.whenNot")} />
    <DoDont
      canvas
      title={t("placeholderPage.dd.shape.title")}
      do={{ tree: publicationPlaceholderTree(t), caption: t("placeholderPage.dd.shape.do") }}
      dont={{ tree: placeholderDontSlabTree, caption: t("placeholderPage.dd.shape.dont") }}
    />
    <ContentRules items={tList(t, "placeholderPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("placeholderPage.a11yIntro")} does={tList(t, "placeholderPage.a11yDoes")} yours={tList(t, "placeholderPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
