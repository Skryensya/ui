---
/* Appearances: the preview menu switches between them, so each one's sheet loads with the page (each base, then its appearances). */
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/tile.tactile.css";
import "@skryensya/core/components/tile.brutalist.css";
import "@skryensya/core/components/tile.frosted.css";
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/checkbox.tactile.css";
import "@skryensya/core/components/checkbox.brutalist.css";
import "@skryensya/core/components/checkbox.frosted.css";
import "@skryensya/core/components/switch.css";
import "@skryensya/core/components/switch.tactile.css";
import "@skryensya/core/components/switch.brutalist.css";
import "@skryensya/core/components/switch.frosted.css";
import { withPy } from "../../demos/tile";
import "@skryensya/core/components/table.css";
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/button.css";
/* The appearance comparison paints a TileCheckbox, whose indicator is checkbox.css's. */
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/switch.css";
/* "Tile or Box?" paints the Box half of the comparison. */
import "@skryensya/core/patterns/box.css";
import DoDont from "../DoDont.astro";
import { tileAppearanceTree, tileLinkGridTree, tilePaddingTree, tileVersusBoxTree } from "../../demos/tile";
import { tileDoTree, tileDontTree } from "../../demos/dodont-pairs";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import UsagePreview from "../UsagePreview.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { getLocale, localizePath, tList, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);
---

<ComponentPageShell
  hookPlayground={{ tree: tileLinkGridTree(t) }}
  title="TileLink"
  description={t("tileLinkPage.description")}
  contractId="tile"
  importNames={["TileLink", "TileContent", "TileChevron"]}
  appearanceTargetSelector=".sk-tile--interactive"
  testFiles={["packages/react/src/components/tile.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("tileLinkPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={withPy(tileLinkGridTree(t))} title={t("tilePage.linkTitle")} description={t("tilePage.linkBody")} storybookTitle="Components/Tile" storybookStory="LinkGrid" />
    <UsagePreview tree={withPy(tileVersusBoxTree(t))} title={t("tilePage.versusTitle")} description={t("tilePage.versusBody")} storybookTitle="Components/Tile" storybookStory="VersusBox" />
    <UsagePreview tree={withPy(tilePaddingTree(t))} title={t("tilePage.paddingTitle")} description={t("tilePage.paddingBody")} storybookTitle="Components/Tile" storybookStory="Padding" />

    <h3>{t("tilePage.appearanceTitle")}</h3>
    <p set:html={t("tilePage.appearanceBody")} />
    {/* A comparison of appearances: the page-wide appearance switch must not repaint it. */}
    <div data-docs-appearance-fixed>
      <UsagePreview tree={tileAppearanceTree(t)} storybookTitle="Components/Tile" storybookStory="Appearance" />
    </div>

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "tileLinkPage.contract").map((item) => <li set:html={item} />)}
    </ul>
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tileLinkPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "tileLinkPage.when")} avoid={tList(t, "tileLinkPage.whenNot")} />
    <h3>{t("tilePage.chooseTitle")}</h3>
    <p set:html={t("tilePage.chooseBody")} />
    <div class="sk-table-scroll">
      <table class="sk-table">
        <thead class="sk-table__head">
          <tr class="sk-table__row"><th class="sk-table__header">{t("tilePage.headNeed")}</th><th class="sk-table__header">{t("tilePage.headComponent")}</th><th class="sk-table__header">{t("tilePage.headNative")}</th></tr>
        </thead>
        <tbody class="sk-table__body">
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row1Need")}</td><td class="sk-table__cell"><a href={href("/components/box")}>Box</a></td><td set:html={t("tilePage.row1Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row2Need")}</td><td class="sk-table__cell"><a href={href("/components/link")}>Link</a></td><td set:html={t("tilePage.row2Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row3Need")}</td><td class="sk-table__cell"><a href={href("/components/button")}>Button</a></td><td set:html={t("tilePage.row3Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row4Need")}</td><td class="sk-table__cell"><a href={href("/components/checkbox")}>Checkbox</a></td><td set:html={t("tilePage.row4Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row5Need")}</td><td class="sk-table__cell"><a href={href("/components/switch")}>Switch</a></td><td set:html={t("tilePage.row5Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row6Need")}</td><td class="sk-table__cell"><a href={href("/components/radio-group")}>RadioGroup</a></td><td set:html={t("tilePage.row6Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row7Need")}</td><td class="sk-table__cell"><a href={href("/components/accordion")}>Accordion</a></td><td set:html={t("tilePage.row7Native")} class="sk-table__cell" /></tr>
        </tbody>
      </table>
    </div>
    <DoDont
      title={t("tilePage.dd.copy.title")}
      do={{ tree: tileDoTree(t), caption: t("tilePage.dd.copy.do") }}
      dont={{ tree: tileDontTree(t), caption: t("tilePage.dd.copy.dont") }}
    />
    <ContentRules items={tList(t, "tileLinkPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("tileLinkPage.a11yIntro")} does={tList(t, "tileLinkPage.a11yDoes")} yours={tList(t, "tileLinkPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
