---
/* The anatomy diagram is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import { layoutAnatomyFillCss, layoutGridAnatomyTree } from "../../demos/layout-anatomy";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { layoutGridWidthTree, layoutGridRailStartTree, layoutGridRailsBothTree, layoutGridTocTree, type LayoutGridWidth } from "../../demos/layout";
import { getLocale, tList, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const isEs = locale === "es";
const widths = ["narrow", "content", "breakout", "full-width"] as const satisfies readonly LayoutGridWidth[];
const widthVariants = widths.map((value) => ({
  value,
  label: t(`layoutGridPage.width.${value}` as Parameters<typeof t>[0]),
  explain: t(`layoutGridPage.width.explain.${value}` as Parameters<typeof t>[0]),
  tree: layoutGridWidthTree(t, value),
}));
const railVariants = [
  { value: "end", tree: layoutGridTocTree(t) },
  { value: "start", tree: layoutGridRailStartTree(t) },
  { value: "both", tree: layoutGridRailsBothTree(t) },
].map((entry) => ({
  ...entry,
  label: t(`layoutGridPage.rail.${entry.value}` as Parameters<typeof t>[0]),
  explain: t(`layoutGridPage.rail.explain.${entry.value}` as Parameters<typeof t>[0]),
}));
const install = `pnpm add @skryensya/core @skryensya/react`;

const configurationCss = `.sk-layout-grid {
  --sk-layout-gutter: var(--space-inset-lg);
  --sk-layout-narrow: var(--size-wrapper-sm);
  --sk-layout-content: var(--size-wrapper-md);
  --sk-layout-breakout: var(--size-wrapper-lg);
  --sk-layout-rail-inline-size: 14rem;
  --sk-layout-rail-gap: var(--space-inline-lg);
}`;

const text = {
  contentTrack: "content",
  breakoutTrack: "breakout",
  proseInContent: isEs ? "texto" : "text",
  proseInBreakout: isEs ? "texto ancho" : "wide text",
  figureInBreakout: isEs ? "figura" : "figure",
  figureInContent: isEs ? "figura chica" : "small figure",
  bandFull: "full-width",
  bandManual: "100vw",
  aligned: isEs ? "alineado" : "aligned",
  drift: isEs ? "corrido" : "shifted",
};

const diagram = (body: string) => `<div class="layout-grid-dd"><svg class="layout-grid-dd__svg" viewBox="0 0 420 230" role="img" aria-hidden="true">
  <rect x="1" y="1" width="418" height="228" rx="18" class="layout-grid-dd__page" />
  <rect x="65" y="24" width="290" height="182" rx="12" class="layout-grid-dd__breakout" />
  <rect x="125" y="24" width="170" height="182" rx="10" class="layout-grid-dd__content" />
  <text x="210" y="46" text-anchor="middle" class="layout-grid-dd__label">${text.contentTrack}</text>
  <text x="210" y="220" text-anchor="middle" class="layout-grid-dd__label">${text.breakoutTrack}</text>
  ${body}
</svg></div>`;

const proseDo = diagram(`
  <rect x="145" y="72" width="130" height="72" rx="10" class="layout-grid-dd__card layout-grid-dd__good" />
  <text x="210" y="94" text-anchor="middle" class="layout-grid-dd__strong">${text.proseInContent}</text>
  <rect x="163" y="110" width="94" height="7" rx="4" class="layout-grid-dd__line" />
  <rect x="163" y="126" width="84" height="7" rx="4" class="layout-grid-dd__line" />
`);

const proseDont = diagram(`
  <rect x="80" y="72" width="260" height="72" rx="10" class="layout-grid-dd__card layout-grid-dd__bad" />
  <text x="210" y="94" text-anchor="middle" class="layout-grid-dd__strong">${text.proseInBreakout}</text>
  <rect x="105" y="110" width="210" height="7" rx="4" class="layout-grid-dd__line" />
  <rect x="105" y="126" width="190" height="7" rx="4" class="layout-grid-dd__line" />
`);

const figureDo = diagram(`
  <rect x="82" y="78" width="256" height="88" rx="10" class="layout-grid-dd__card layout-grid-dd__good" />
  <text x="210" y="101" text-anchor="middle" class="layout-grid-dd__strong">${text.figureInBreakout}</text>
  <rect x="108" y="136" width="28" height="18" rx="4" class="layout-grid-dd__bar" />
  <rect x="148" y="120" width="28" height="34" rx="4" class="layout-grid-dd__bar" />
  <rect x="188" y="130" width="28" height="24" rx="4" class="layout-grid-dd__bar" />
  <rect x="228" y="112" width="28" height="42" rx="4" class="layout-grid-dd__bar" />
  <rect x="268" y="126" width="28" height="28" rx="4" class="layout-grid-dd__bar" />
`);

const figureDont = diagram(`
  <rect x="145" y="78" width="130" height="88" rx="10" class="layout-grid-dd__card layout-grid-dd__bad" />
  <text x="210" y="101" text-anchor="middle" class="layout-grid-dd__strong">${text.figureInContent}</text>
  <rect x="158" y="136" width="14" height="18" rx="3" class="layout-grid-dd__bar" />
  <rect x="181" y="120" width="14" height="34" rx="3" class="layout-grid-dd__bar" />
  <rect x="204" y="130" width="14" height="24" rx="3" class="layout-grid-dd__bar" />
  <rect x="227" y="112" width="14" height="42" rx="3" class="layout-grid-dd__bar" />
  <rect x="250" y="126" width="14" height="28" rx="3" class="layout-grid-dd__bar" />
`);

const bandDo = diagram(`
  <rect x="0" y="82" width="420" height="70" class="layout-grid-dd__band layout-grid-dd__good-fill" />
  <rect x="145" y="99" width="130" height="36" rx="8" class="layout-grid-dd__card" />
  <text x="210" y="104" text-anchor="middle" class="layout-grid-dd__strong">${text.bandFull}</text>
  <text x="210" y="126" text-anchor="middle" class="layout-grid-dd__strong">${text.aligned}</text>
`);

const bandDont = diagram(`
  <rect x="-28" y="82" width="420" height="70" class="layout-grid-dd__band layout-grid-dd__bad-fill" />
  <rect x="86" y="99" width="130" height="36" rx="8" class="layout-grid-dd__card layout-grid-dd__bad" />
  <text x="151" y="104" text-anchor="middle" class="layout-grid-dd__strong">${text.bandManual}</text>
  <text x="151" y="126" text-anchor="middle" class="layout-grid-dd__strong">${text.drift}</text>
`);

const previewCss = `.sk-layout-grid {
  row-gap: var(--space-stack-lg);
  /* \`flush\` (below) drops the stage's own padding on every axis, which the full-width box needs to
     actually reach the edge, but the block axis still wants SOME breathing room, or the first and
     last card touch the stage's top/bottom edge flush. Block-only, so the inline edges stay bare. */
  padding-block: var(--space-inset-lg);
}

/* The rail demos below, singled out by the one structural thing that tells them apart from the
   levels demo above (a rail child): main and rail read as one region split in two, not two
   unrelated cards, so they sit closer together than the four independent width levels do -
   tighter than any named \`space-stack-*\` step goes, a hairline rather than a real gap. */
.sk-layout-grid:has(> [data-width="rail"]),
.sk-layout-grid:has(> [data-width="rail-start"]) {
  row-gap: 2px;
}

/*
 * The tab-panel stage never reaches 72rem (see the comment above the rail previews), so the
 * rail demos stay on the FLUID template, and \`fit-content\` on a grid with \`1fr\` tracks does
 * not shrink in Chromium. A measure cap is the same job Wrapper does for a page column.
 *
 * ONLY below \`wide\`: fullscreen opens this same CSS inside a viewport that DOES pass 72rem,
 * and the cap would keep the rails stacked there too, which is the whole reason someone
 * opens pantalla completa on these demos.
 */
@media (max-width: 71.99rem) {
  .sk-layout-grid:has(> [data-width="rail"]),
  .sk-layout-grid:has(> [data-width="rail-start"]) {
    max-inline-size: 30rem;
    margin-inline: auto;
  }
}

.sk-box {
  display: grid;
  align-items: center;
  min-block-size: 6rem;
}

/*
 * One primitive palette hue per width, not the semantic surface tokens \`data-surface\` already
 * painted: \`raised\`/\`surface\` read as near-identical flat white next to the page canvas in light
 * mode (measured. The stack demo above hit the same near-invisible pairing). A palette tint makes
 * each card legible on its own AND doubles as a second cue for which width is which, matched to the
 * light/dark tier-1 primitives directly rather than through a semantic layer this demo doesn't need.
 */
.sk-box[data-width="narrow"] {
  background: light-dark(var(--palette-blue-50), var(--palette-blue-950));
}

.sk-box:not([data-width]) {
  background: light-dark(var(--palette-violet-50), var(--palette-violet-950));
}

.sk-box[data-width="breakout"] {
  background: light-dark(var(--palette-teal-50), var(--palette-teal-950));
}

.sk-box[data-width="full-width"] {
  padding-block: var(--space-inset-xl);
  min-block-size: 8rem;
  background: light-dark(var(--palette-orange-50), var(--palette-orange-950));
}

/* Same palette device, for the rail demo below: the supporting column gets its own hue so its
   card boundary reads as clearly as the four content measures above do. */
.sk-box[data-width="rail"] {
  background: light-dark(var(--palette-rose-50), var(--palette-rose-950));
}

.sk-box[data-width="rail-start"] {
  background: light-dark(var(--palette-lime-50), var(--palette-lime-950));
}`;
---

<ComponentPageShell
  title="Layout Grid"
  description={t("layoutGridPage.description")}
  contractId="layout"
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        {
          name: "renders LayoutGrid while leaving width on its semantic children",
          description: t("layoutGridPage.test1"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("layoutGridPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview
      tree={widthVariants[2]!.tree}
      variants={widthVariants}
      initialVariant="breakout"
      variantsLabel={t("layoutGridPage.pageTitle")}
      title={t("layoutGridPage.pageTitle")}
      description={t("layoutGridPage.pageBody")}
      css={previewCss}
      flush
      screen="xl"
    />
    <UsagePreview
      tree={railVariants[0]!.tree}
      variants={railVariants}
      variantsLabel={t("layoutGridPage.railTitle")}
      title={t("layoutGridPage.railTitle")}
      description={t("layoutGridPage.railBody")}
      css={previewCss}
      flush
      screen="xl"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "layoutGridPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("layoutGridPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("layoutGridPage.anatomyBody")} />
    <UsagePreview
      tree={layoutGridAnatomyTree(t)}
      css={layoutAnatomyFillCss}
      label={t("layoutGridPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("layoutGridPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "layoutGridPage.when")} avoid={tList(t, "layoutGridPage.whenNot")} />
    <DoDont
      title={t("layoutGridPage.dd.prose.title")}
      do={{ html: proseDo, caption: t("layoutGridPage.dd.prose.do") }}
      dont={{ html: proseDont, caption: t("layoutGridPage.dd.prose.dont") }}
    />
    <DoDont
      title={t("layoutGridPage.dd.figure.title")}
      do={{ html: figureDo, caption: t("layoutGridPage.dd.figure.do") }}
      dont={{ html: figureDont, caption: t("layoutGridPage.dd.figure.dont") }}
    />
    <DoDont
      title={t("layoutGridPage.dd.band.title")}
      do={{ html: bandDo, caption: t("layoutGridPage.dd.band.do") }}
      dont={{ html: bandDont, caption: t("layoutGridPage.dd.band.dont") }}
    />
    <ContentRules items={tList(t, "layoutGridPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("layoutGridPage.a11yIntro")} does={tList(t, "layoutGridPage.a11yDoes")} yours={tList(t, "layoutGridPage.a11yYours")} />
  </Fragment>

  <Fragment slot="style">
    <h2>{t("layoutGridPage.configTitle")}</h2>
    <p set:html={t("layoutGridPage.configBody1")} />
    <CodeBlock code={configurationCss} label="app.css" />
    <p set:html={t("layoutGridPage.configBody2")} />
  </Fragment>
</ComponentPageShell>

<style>
  :global(.sk-do-dont__frame:has(.layout-grid-dd)) {
    padding: 0;
  }

  :global(.layout-grid-dd) {
    display: grid;
    place-items: stretch;
    min-block-size: 100%;
    padding: 0;
    border-radius: var(--radius-surface);
    background: var(--color-bg-canvas);
  }

  :global(.layout-grid-dd__svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 13.5rem;
  }

  :global(.layout-grid-dd__page) {
    fill: var(--color-bg-canvas);
  }

  :global(.layout-grid-dd__breakout) {
    fill: color-mix(in oklab, var(--color-action-accent) 8%, transparent);
    stroke: color-mix(in oklab, var(--color-action-accent) 52%, transparent);
    stroke-dasharray: 7 5;
    stroke-width: 2;
  }

  :global(.layout-grid-dd__content) {
    fill: color-mix(in oklab, var(--color-bg-surface) 84%, var(--color-action-accent) 16%);
    stroke: var(--color-border-subtle);
    stroke-width: 2;
  }

  :global(.layout-grid-dd__card) {
    fill: var(--color-bg-surface);
    stroke: var(--color-border-subtle);
    stroke-width: 2;
  }

  :global(.layout-grid-dd__good) {
    stroke: var(--color-text-success);
    stroke-width: 3;
  }

  :global(.layout-grid-dd__bad) {
    stroke: var(--color-text-danger);
    stroke-width: 3;
  }

  :global(.layout-grid-dd__good-fill) {
    fill: color-mix(in oklab, var(--color-text-success) 22%, var(--color-bg-surface));
  }

  :global(.layout-grid-dd__bad-fill) {
    fill: color-mix(in oklab, var(--color-text-danger) 20%, var(--color-bg-surface));
  }

  :global(.layout-grid-dd__line) {
    fill: color-mix(in oklab, var(--color-text-secondary) 28%, transparent);
  }

  :global(.layout-grid-dd__bar) {
    fill: color-mix(in oklab, var(--color-action-accent) 58%, var(--color-bg-surface));
  }

  :global(.layout-grid-dd__label),
  :global(.layout-grid-dd__strong) {
    fill: var(--color-text-secondary);
    font-family: var(--font-family-sans);
    font-size: 13px;
    font-weight: var(--font-weight-emphasis);
    white-space: nowrap;
  }

  :global(.layout-grid-dd__strong) {
    fill: var(--color-text-primary);
  }
</style>
