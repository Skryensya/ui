---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { layoutGridTree, layoutGridRailStartTree, layoutGridRailsBothTree, layoutGridTocTree } from "../../demos/layout";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/layout.yaml?raw";
import coreSource from "@core/src/layout.ts?raw";
import cssSource from "@core/css/patterns/layout.css?raw";
import reactSource from "@react/src/components/layout.tsx?raw";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;

const configurationCss = `.sk-layout-grid {
  --sk-layout-gutter: var(--space-inset-lg);
  --sk-layout-narrow: var(--size-wrapper-sm);
  --sk-layout-content: var(--size-wrapper-md);
  --sk-layout-breakout: var(--size-wrapper-lg);
  --sk-layout-rail-inline-size: 14rem;
  --sk-layout-rail-gap: var(--space-inline-lg);
}`;

const previewCss = `.sk-layout-grid {
  row-gap: var(--space-stack-lg);
  /* \`flush\` (below) drops the stage's own padding on every axis, which the full-width box needs to
     actually reach the edge, but the block axis still wants SOME breathing room, or the first and
     last card touch the stage's top/bottom edge flush. Block-only, so the inline edges stay bare. */
  padding-block: var(--space-inset-lg);
}

/* The rail demos below, singled out by the one structural thing that tells them apart from the
   levels demo above (a rail child): main and rail read as one region split in two, not two
   unrelated cards, so they sit closer together than the four independent width levels do -
   tighter than any named \`space-stack-*\` step goes, a hairline rather than a real gap. */
.sk-layout-grid:has(> [data-width="rail"]),
.sk-layout-grid:has(> [data-width="rail-start"]) {
  row-gap: 2px;
}

/*
 * The tab-panel stage never reaches 72rem (see the comment above the rail previews), so the
 * rail demos stay on the FLUID template, and \`fit-content\` on a grid with \`1fr\` tracks does
 * not shrink in Chromium. A measure cap is the same job Wrapper does for a page column.
 *
 * ONLY below \`wide\`: fullscreen opens this same CSS inside a viewport that DOES pass 72rem,
 * and the cap would keep the rails stacked there too, which is the whole reason someone
 * opens pantalla completa on these demos.
 */
@media (max-width: 71.99rem) {
  .sk-layout-grid:has(> [data-width="rail"]),
  .sk-layout-grid:has(> [data-width="rail-start"]) {
    max-inline-size: 30rem;
    margin-inline: auto;
  }
}

.sk-box {
  display: grid;
  align-items: center;
  min-block-size: 6rem;
}

/*
 * One primitive palette hue per width, not the semantic surface tokens \`data-surface\` already
 * painted: \`raised\`/\`surface\` read as near-identical flat white next to the page canvas in light
 * mode (measured. The stack demo above hit the same near-invisible pairing). A palette tint makes
 * each card legible on its own AND doubles as a second cue for which width is which, matched to the
 * light/dark tier-1 primitives directly rather than through a semantic layer this demo doesn't need.
 */
.sk-box[data-width="narrow"] {
  background: light-dark(var(--palette-blue-50), var(--palette-blue-950));
}

.sk-box:not([data-width]) {
  background: light-dark(var(--palette-violet-50), var(--palette-violet-950));
}

.sk-box[data-width="breakout"] {
  background: light-dark(var(--palette-teal-50), var(--palette-teal-950));
}

.sk-box[data-width="full-width"] {
  padding-block: var(--space-inset-xl);
  min-block-size: 8rem;
  background: light-dark(var(--palette-orange-50), var(--palette-orange-950));
}

/* Same palette device, for the rail demo below: the supporting column gets its own hue so its
   card boundary reads as clearly as the four content measures above do. */
.sk-box[data-width="rail"] {
  background: light-dark(var(--palette-rose-50), var(--palette-rose-950));
}

.sk-box[data-width="rail-start"] {
  background: light-dark(var(--palette-lime-50), var(--palette-lime-950));
}`;

const sourceFiles = [
  { id: "contracts/semantic/layout.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/layout.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/patterns/layout.css", source: cssSource, language: "css" },
  { id: "packages/react/src/components/layout.tsx", source: reactSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="Layout Grid"
  description={t("layoutGridPage.description")}
  contractId="layout"
  sourceFiles={sourceFiles}
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        {
          name: "renders LayoutGrid while leaving width on its semantic children",
          description: t("layoutGridPage.test1"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("layoutGridPage.lede")} />
    <ComponentPreview tree={layoutGridTree(t)} css={previewCss} label="Layout Grid" flush zoomedDesktop />

    <h3>{t("layoutGridPage.levelsTitle")}</h3>
    <p set:html={t("layoutGridPage.levelsBody")} />
    <ul>
      <li><code>narrow</code>: {t("layoutGridPage.levelNarrow")}</li>
      <li><code>content</code>: {t("layoutGridPage.levelContent")}</li>
      <li><code>breakout</code>: {t("layoutGridPage.levelBreakout")}</li>
      <li><code>full-width</code>: {t("layoutGridPage.levelFullWidth")}</li>
    </ul>

    <h3>{t("layoutGridPage.fullWidthTitle")}</h3>
    <p set:html={t("layoutGridPage.fullWidthBody")} />

    <h3>{t("layoutGridPage.railTitle")}</h3>
    <p set:html={t("layoutGridPage.railBody")} />
    {/*
      No \`width\` prop: the tab panel itself is capped below 72rem, so the rail's wide form cannot
      appear at the stage's free width. \`zoomedDesktop\` is what pretends a 1440 px viewport inside
      the column; fullscreen and \`/debug/layout-grid-rail\` are the same layout at a real window.
    */}
    <h4>{t("layoutGridPage.railEndTitle")}</h4>
    <ComponentPreview tree={layoutGridTocTree(t)} css={previewCss} label="Layout Grid + Rail" flush zoomedDesktop />
    <h4>{t("layoutGridPage.railStartTitle")}</h4>
    <ComponentPreview tree={layoutGridRailStartTree(t)} css={previewCss} label="Layout Grid + Rail start" flush zoomedDesktop />
    <h4>{t("layoutGridPage.railBothTitle")}</h4>
    <ComponentPreview tree={layoutGridRailsBothTree(t)} css={previewCss} label="Layout Grid + both rails" flush zoomedDesktop />

    <h3>{t("layoutGridPage.htmlTitle")}</h3>
    <p set:html={t("layoutGridPage.htmlBody")} />
    <p set:html={t("layoutGridPage.reactBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="style">
    <h2>{t("layoutGridPage.configTitle")}</h2>
    <p set:html={t("layoutGridPage.configBody1")} />
    <CodeBlock code={configurationCss} label="app.css" />
    <p set:html={t("layoutGridPage.configBody2")} />
  </Fragment>
</ComponentPageShell>
