---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/radio-group.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { radioGroupTree, tileRadioGroupTree } from "../../demos/radio-group";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/radio-group.yaml?raw";
import cssSource from "@core/css/components/radio-group.css?raw";
import reactSource from "@react/src/components/selection.tsx?raw";
import vanillaMountSource from "@vanilla/src/components/tile-radio-group.ts?raw";
import vanillaTestSource from "@vanilla/src/components/tile-radio-group.svelte.test.ts?raw";

const t = useTranslations(getLocale(Astro.url));

const tileRadioGroupVanilla = `import { initComponents } from "@skryensya/vanilla/auto";

// La raíz se autora con data-sk-tile-radio-group (data-name, data-default-value),
// y cada opción con data-part="item" + un input[type=radio] con su value.
// initComponents la hidrata con la máquina @zag-js/radio-group (la misma que React).
await initComponents();

const root = document.querySelector("[data-sk-tile-radio-group]");
root.addEventListener("sk:valuechange", (event) => {
  console.log(event.detail.value);
});`;

const sourceFiles = [
  { id: "contracts/semantic/radio-group.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/css/components/radio-group.css", source: cssSource, language: "css" },
  { id: "packages/react/src/components/selection.tsx", source: reactSource, language: "tsx" },
  { id: "packages/vanilla/src/components/tile-radio-group.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/vanilla/src/components/tile-radio-group.svelte.test.ts", source: vanillaTestSource, language: "ts" },
] as const;
---

<ComponentPageShell
  title="RadioGroup"
  description={t("radioGroupPage.description")}
  contractId="radio-group"
  sourceFiles={sourceFiles}
  styleGroups={[{ file: "components/radio-group.css", probe: "sk-radio-group" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/tile-radio-group.svelte.test.ts",
      tests: [
        {
          name: "is a radiogroup, honours the default, and keeps values mutually exclusive + emits",
          description: t("radioGroupPage.test1"),
        },
        { name: "marks the selected item's data-state", description: t("radioGroupPage.test2") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("radioGroupPage.lede")} />
    <ComponentPreview tree={radioGroupTree(t)} label="RadioGroup" />

    <h3>{t("radioGroupPage.tileTitle")}</h3>
    <p set:html={t("radioGroupPage.tileBody1")} />
    <ComponentPreview tree={tileRadioGroupTree(t)} label="TileRadioGroup" />
    <p set:html={t("radioGroupPage.tileBody2")} />
    <p set:html={t("radioGroupPage.tileBody3")} />
    <CodeBlock code={tileRadioGroupVanilla} label="JavaScript" />
    <p set:html={t("radioGroupPage.tileBody4")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("radioGroupPage.contractItem1")} />
      <li set:html={t("radioGroupPage.contractItem2")} />
      <li set:html={t("radioGroupPage.contractItem3")} />
      <li set:html={t("radioGroupPage.contractItem4")} />
    </ul>
  </Fragment>
</ComponentPageShell>
