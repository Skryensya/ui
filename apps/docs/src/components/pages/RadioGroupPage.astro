---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/radio-group.css";
/* The Likert composition below is a radio group in a Box with Text under it. */
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/wrapper.css";
/* The matrix below is a Table of single radios. */
import "@skryensya/core/components/table.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* Centres the numbers of the two Likert compositions below. */
import "../../examples/likert.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { radioGroupDontLongTree, radioGroupDontManyTree, radioGroupSpreadTarget, radioGroupSpreadTree, radioGroupDisabledTree, radioGroupOptionStateTree } from "../../demos/radio-group";
import { radioGroupAnatomyTree, radioGroupLikertTree, radioGroupMatrixTree, radioGroupTree, tileRadioGroupAnatomyTree, tileRadioGroupTree } from "../../demos/radio-group";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`radioGroupPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const tileRadioGroupVanilla = `import { initComponents } from "@skryensya/vanilla/auto";

// The root is authored with data-sk-tile-radio-group (data-name, data-default-value),
// and each option with data-part="item" + an input[type=radio] with its value.
// initComponents hydrates it with the @zag-js/radio-group machine (the same one React uses).
await initComponents();

const root = document.querySelector("[data-sk-tile-radio-group]");
root.addEventListener("sk:tilevaluechange", (event) => {
  console.log(event.detail.value);
});`;
---

<ComponentPageShell
  title="RadioGroup"
  description={t("radioGroupPage.description")}
  contractId="radio-group"
  appearanceTargetSelector=".sk-radio"
  styleGroups={[{ file: "components/radio-group.css", probe: "sk-radio-group" }]}
  testFiles={["packages/vanilla/src/components/tile-radio-group.svelte.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("radioGroupPage.lede")} />

    <UsagePreview
      tree={radioGroupTree(t)}
      optionName="orientation"
      title={t("radioGroupPage.prop.orientation.title")}
      description={t("radioGroupPage.prop.orientation.body")}
      explain={explain("orientation", ["vertical", "horizontal"])}
      stageMinBlockSize="11rem"
    />

    <UsagePreview
      tree={radioGroupSpreadTree(t)}
      target={radioGroupSpreadTarget}
      optionName="spread"
      title={t("radioGroupPage.prop.spread.title")}
      description={t("radioGroupPage.prop.spread.body")}
      explain={explain("spread", ["false", "true"])}
      labels={{ false: t("radioGroupPage.prop.spread.falseLabel"), true: t("radioGroupPage.prop.spread.trueLabel") }}
      stageMinBlockSize="9rem"
    />

    <UsagePreview
      tree={radioGroupDisabledTree(t)}
      optionName="disabled"
      title={t("radioGroupPage.prop.disabled.title")}
      description={t("radioGroupPage.prop.disabled.body")}
      explain={explain("disabled", ["false", "true"])}
      labels={{ false: t("radioGroupPage.prop.disabled.falseLabel"), true: t("radioGroupPage.prop.disabled.trueLabel") }}
      stageMinBlockSize="11rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={radioGroupTree(t)} title={t("radioGroupPage.basicTitle")} description={t("radioGroupPage.basicBody")} />
    <UsagePreview tree={radioGroupLikertTree(t)} title={t("radioGroupPage.likertTitle")} description={t("radioGroupPage.likertBody")} caption={t("radioGroupPage.likertLabel")} />
    <UsagePreview tree={radioGroupMatrixTree(t)} title={t("radioGroupPage.matrixTitle")} description={t("radioGroupPage.matrixTable")} caption={t("radioGroupPage.matrixLabel")} />
    <UsagePreview tree={radioGroupOptionStateTree(t)} title={t("radioGroupPage.statesTitle")} description={t("radioGroupPage.statesBody")} />
    <UsagePreview tree={tileRadioGroupTree(t)} title={t("radioGroupPage.tileTitle")} description={t("radioGroupPage.tileBody1")} />
    <p set:html={t("radioGroupPage.tileBody2")} />
    <CodeBlock code={tileRadioGroupVanilla} label="JavaScript" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "radioGroupPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("radioGroupPage.anatomyBody")} />
    <UsagePreview
      tree={radioGroupAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("radioGroupPage.anatomyPreviewLabel")}
      bare
    />
    <h4>{t("radioGroupPage.tileAnatomyTitle")}</h4>
    <p set:html={t("radioGroupPage.tileAnatomyBody")} />
    <UsagePreview
      tree={tileRadioGroupAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("radioGroupPage.tileAnatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("radioGroupPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "radioGroupPage.when")} avoid={tList(t, "radioGroupPage.whenNot")} />
    <DoDont
      canvas
      title={t("radioGroupPage.dd.exclusive.title")}
      do={{ tree: radioGroupTree(t), caption: t("radioGroupPage.dd.exclusive.do") }}
      dont={{ tree: radioGroupDontManyTree(t), caption: t("radioGroupPage.dd.exclusive.dont") }}
    />
    <DoDont
      canvas
      title={t("radioGroupPage.dd.surface.title")}
      do={{ tree: tileRadioGroupTree(t), caption: t("radioGroupPage.dd.surface.do") }}
      dont={{ tree: radioGroupTree(t), caption: t("radioGroupPage.dd.surface.dont") }}
    />
    <DoDont
      canvas
      title={t("radioGroupPage.dd.labels.title")}
      do={{ tree: radioGroupTree(t), caption: t("radioGroupPage.dd.labels.do") }}
      dont={{ tree: radioGroupDontLongTree(t), caption: t("radioGroupPage.dd.labels.dont") }}
    />
    <ContentRules items={tList(t, "radioGroupPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("radioGroupPage.a11yIntro")}
      does={tList(t, "radioGroupPage.a11yDoes")}
      yours={tList(t, "radioGroupPage.a11yYours")}
      keys={[
        { keys: ["Tab"], action: t("radioGroupPage.key.tab") },
        { keys: ["↑", "↓", "←", "→"], action: t("radioGroupPage.key.arrows") },
        { keys: [t("component.key.space")], action: t("radioGroupPage.key.space") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
