---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { tocIconsTree, tocNestedTree, tocPlainTree } from "../../demos/toc";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/toc.yaml?raw";
import coreSource from "@core/src/toc.ts?raw";
import cssSource from "@core/css/components/toc.css?raw";
import vanillaMountSource from "@vanilla/src/components/toc.ts?raw";
import reactSource from "@react/src/components/toc.tsx?raw";

const t = useTranslations(getLocale(Astro.url));

/* The real Toc.astro renders the site's own rail; it cannot use the tree below because its items
 * are read from THIS page's own headings while the page is built, which is what the CLS section
 * further down is about. */
const linkWithIcon = `<a class="sk-toc__link sk-interactive" href="#installation">
  <span class="sk-toc__icon">
    <span data-sk-icon="settings"></span>
  </span>
  <span class="sk-toc__label">Instalación</span>
</a>`;

const markup = `<aside class="sk-toc" data-sk-toc>
  <nav class="sk-toc__nav" aria-label="En esta página">
    <h2 class="sk-toc__title">En esta página</h2>
    <ul class="sk-toc__list" role="list"></ul>
  </nav>
</aside>`;

const mount = `import { initComponents } from "@skryensya/vanilla/auto";

// Encuentra [data-sk-toc] y conecta el scroll-spy que mueve aria-current.
await initComponents();`;

const builder = `---
import { indexDocument } from "../lib/document-index";

// El cuerpo de la página, ya renderizado a HTML: de ahí salen sus propias secciones.
const { html, headings } = indexDocument(await Astro.slots.render("default"));
const items = headings.map((h) => ({ href: \`#\${h.id}\`, label: h.label, level: h.level }));
---

<main>
  <Fragment set:html={html} />
</main>
<Toc items={items} />`;

const sourceFiles = [
  { id: "contracts/semantic/toc.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/toc.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/toc.css", source: cssSource, language: "css" },
  { id: "packages/vanilla/src/components/toc.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/react/src/components/toc.tsx", source: reactSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="Toc"
  description={t("tocPage.description")}
  contractId="toc"
  sourceFiles={sourceFiles}
  styleGroups={[{ file: "components/toc.css", probe: "sk-toc" }]}
  tests={[
    {
      file: "packages/react/src/components/toc.test.tsx",
      tests: [
        { name: "names the nav after the caption and levels each item", description: t("tocPage.test1") },
        {
          name: "seeds aria-current from the composition before the spy reports",
          description: t("tocPage.test2"),
        },
        { name: "moves aria-current as headings enter the band", description: t("tocPage.test3") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tocPage.lede")} />

    {
      /*
       * `minHeight` HERE IS ABOUT CLS, not about a cramped specimen. A stage reserves
       * `--sk-component-preview-stage-min-block-size` (12rem) while its frame loads and then drops
       * that floor to 0 the moment the frame reports ready, letting the measured content height take
       * over (`component-preview.css`). Measured on this page: these three settle at 152px, 178px and
       * 178px, so every one of them COLLAPSES out of the 192px reserve once it is ready — the first
       * by a full 40px — and everything below it jumps up. Declaring a floor is what
       * `component-preview.css` already keys `[data-sk-component-preview-min-height]` on to keep the
       * reserve after ready, the same way `viewport="menu"`/`"overlay"` keep theirs. `12rem` matches
       * the loading reserve exactly, so the stage is the same height from first paint onward and
       * there is no shift at all; the slack left under a short index also stops it sitting glued to
       * the frame's bottom edge.
       */
    }
    <h3 id="anatomia">{t("tocPage.anatomyTitle")}</h3>
    <p set:html={t("tocPage.anatomyBody")} />
    <ComponentPreview tree={tocPlainTree(t)} label={t("tocPage.anatomyLabel")} flush minHeight="12rem" />

    <h3 id="niveles">{t("tocPage.levelsTitle")}</h3>
    <p set:html={t("tocPage.levelsBody")} />
    <ComponentPreview tree={tocNestedTree(t)} label={t("tocPage.levelsLabel")} flush minHeight="12rem" />

    <h3 id="iconos">{t("tocPage.iconsTitle")}</h3>
    <p set:html={t("tocPage.iconsBody")} />
    <ComponentPreview tree={tocIconsTree(t)} label={t("tocPage.iconsLabel")} flush minHeight="12rem" />
    <CodeBlock code={linkWithIcon} label={t("tocPage.iconsCodeLabel")} />

    <h3 id="una-sola-forma">{t("tocPage.railTitle")}</h3>
    <p set:html={t("tocPage.railBody1")} />
    <p set:html={t("tocPage.railBody2")} />

    <h3 id="espacio">{t("tocPage.spaceTitle")}</h3>
    <p set:html={t("tocPage.spaceBody")} />
    <CodeBlock code={markup} label="HTML" />

    <h4 id="cls">{t("tocPage.clsTitle")}</h4>
    <p set:html={t("tocPage.clsBody")} />
    <CodeBlock code={builder} label={t("tocPage.clsCodeLabel")} lang="html" />
    <p set:html={t("tocPage.clsBody2")} />
    <p set:html={t("tocPage.clsBody3")} />
    <CodeBlock code={mount} label="JavaScript" lang="ts" />

    <h3 id="contrato">{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("tocPage.contractItem1")} />
      <li set:html={t("tocPage.contractItem2")} />
      <li set:html={t("tocPage.contractItem3")} />
      <li set:html={t("tocPage.contractItem4")} />
      <li set:html={t("tocPage.contractItem5")} />
    </ul>
  </Fragment>
</ComponentPageShell>
