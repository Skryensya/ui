---
import "@skryensya/core/components/toc.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import { dd2 } from "../../demos/dodont-labels";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  tocAnatomyTree,
  tocDontLongTree,
  tocIconsTree,
  tocNestedTree,
  tocPlainTree,
} from "../../demos/toc";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

/* The real Toc.astro renders the site's own rail; it cannot use the tree below because its items
 * are read from THIS page's own headings while the page is built, which is what the CLS section
 * further down is about. */
const linkWithIcon = `<a class="sk-toc__link sk-interactive" href="#installation">
  <span class="sk-toc__icon">
    <span data-sk-icon="settings"></span>
  </span>
  <span class="sk-toc__label">Instalación</span>
</a>`;

const mount = `import { initComponents } from "@skryensya/vanilla/auto";

// Finds [data-sk-toc] and wires up the scroll-spy that moves aria-current.
await initComponents();`;

const builder = `---
import { indexDocument } from "../lib/document-index";

// The page's body, already rendered to HTML: its own sections come from there.
const { html, headings } = indexDocument(await Astro.slots.render("default"));
const items = headings.map((h) => ({ href: \`#\${h.id}\`, label: h.label, level: h.level }));
---

<main>
  <Fragment set:html={html} />
</main>
<Toc items={items} />`;
---

<ComponentPageShell
  title="Toc"
  description={t("tocPage.description")}
  contractId="toc"
  testFiles={["packages/react/src/components/toc.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tocPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    {/* `stageMinBlockSize` holds the stage at its loading reserve, so the short indexes do not
        collapse out of it once ready and shift everything below. */}
    <UsagePreview tree={tocPlainTree(t)} title={t("tocPage.plainTitle")} description={t("tocPage.plainBody")} flush stageMinBlockSize="12rem" />
    <UsagePreview tree={tocNestedTree(t)} title={t("tocPage.levelsTitle")} description={t("tocPage.levelsBody")} flush stageMinBlockSize="12rem" />
    <UsagePreview tree={tocIconsTree(t)} title={t("tocPage.iconsTitle")} description={t("tocPage.iconsBody")} flush stageMinBlockSize="12rem" />
    <CodeBlock code={linkWithIcon} label={t("tocPage.iconsCodeLabel")} />
    <h4>{t("tocPage.spyTitle")}</h4>
    <p set:html={t("tocPage.spyBody")} />
    <CodeBlock code={mount} label="JavaScript" lang="ts" />

    <h3 id="contrato">{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "tocPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <CodeBlock code={builder} label="Astro" lang="html" />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("tocPage.anatomyBody")} />
    <UsagePreview tree={tocAnatomyTree(t)} css={annotationDemoCss} label={t("tocPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tocPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "tocPage.when")} avoid={tList(t, "tocPage.whenNot")} />
    <DoDont
      title={t("tocPage.dd.short.title")}
      do={{ tree: tocPlainTree(t), caption: t("tocPage.dd.short.do") }}
      dont={{ tree: tocDontLongTree(t), caption: t("tocPage.dd.short.dont") }}
    />
    <DoDont
      title={t("dd2.toc.title")}
      do={{ tree: dd2.toc.do(t), caption: t("dd2.toc.do") }}
      dont={{ tree: dd2.toc.dont(t), caption: t("dd2.toc.dont") }}
    />
    <ContentRules items={tList(t, "tocPage.content")} />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes intro={t("tocPage.a11yIntro")} does={tList(t, "tocPage.a11yDoes")} yours={tList(t, "tocPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
