---
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/table.css";
import "@skryensya/core/components/pagination.css";
import "@skryensya/core/patterns/table-pager.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  tablePagerAnatomyTree,
  tablePagerDontDetachedTree,
  tablePagerMinimalTree,
  tablePagerTree,
} from "../../demos/table-pager";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const styles = `@import "@skryensya/core/components/table.css";
@import "@skryensya/core/components/pagination.css";
@import "@skryensya/core/patterns/table-pager.css";`;
---

<ComponentPageShell
  title="TablePager"
  description={t("tablePager.description")}
  contractId="table-pager"
  testFiles={["packages/react/src/components/pagination.test.tsx", "packages/vanilla/src/components/table-pager.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tablePager.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={tablePagerTree(t)} title={t("tablePager.fullTitle")} description={t("tablePager.fullBody")} />
    <UsagePreview tree={tablePagerMinimalTree(t)} title={t("tablePager.minimalTitle")} description={t("tablePager.minimalBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "tablePager.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("tablePager.anatomyBody")} />
    <UsagePreview
      tree={tablePagerAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("tablePager.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tablePager.guidelinesLede")} />
    <WhenToUse use={tList(t, "tablePager.when")} avoid={tList(t, "tablePager.whenNot")} />
    <DoDont
      canvas
      title={t("tablePager.dd.attached.title")}
      do={{ tree: tablePagerMinimalTree(t), caption: t("tablePager.dd.attached.do") }}
      dont={{ tree: tablePagerDontDetachedTree(t), caption: t("tablePager.dd.attached.dont") }}
    />
    <ContentRules items={tList(t, "tablePager.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("tablePager.a11yIntro")}
      does={tList(t, "tablePager.a11yDoes")}
      yours={tList(t, "tablePager.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("tablePager.key.tab") },
        { keys: ["Enter"], action: t("tablePager.key.enter") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
