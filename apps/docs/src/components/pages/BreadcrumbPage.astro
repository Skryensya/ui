---
import "@skryensya/core/components/breadcrumb.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  breadcrumbCollapseTree,
  breadcrumbIconTree,
  breadcrumbLongTree,
  breadcrumbMultiTree,
  breadcrumbTwoTree,
} from "../../demos/breadcrumb";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/breadcrumb.yaml?raw";
import coreSource from "@core/src/breadcrumb.ts?raw";
import cssSource from "@core/css/components/breadcrumb.css?raw";
import reactSource from "@react/src/components/breadcrumb.tsx?raw";
import reactTestSource from "@react/src/components/breadcrumb.test.tsx?raw";
import vanillaMountSource from "@vanilla/src/components/breadcrumb.ts?raw";
import vanillaTestSource from "@vanilla/src/components/breadcrumb.test.ts?raw";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/breadcrumb.css";`;

const sourceFiles = [
  { id: "contracts/semantic/breadcrumb.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/breadcrumb.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/breadcrumb.css", source: cssSource, language: "css" },
  { id: "packages/vanilla/src/components/breadcrumb.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/vanilla/src/components/breadcrumb.test.ts", source: vanillaTestSource, language: "ts" },
  { id: "packages/react/src/components/breadcrumb.tsx", source: reactSource, language: "tsx" },
  { id: "packages/react/src/components/breadcrumb.test.tsx", source: reactTestSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="Breadcrumb"
  description={t("breadcrumb.description")}
  badge={t("breadcrumb.betaBadge")}
  contractId="breadcrumb"
  sourceFiles={sourceFiles}
  styleGroups={[{ file: "components/breadcrumb.css", probe: "sk-breadcrumb", title: "Breadcrumb" }]}
  tests={[
    {
      file: "packages/react/src/components/breadcrumb.test.tsx",
      tests: [
        {
          name: "renders a plain, uncollapsed trail when it is short enough that nothing is worth collapsing",
          description: t("breadcrumb.test1"),
        },
        {
          name: "opens a real Menu of the hidden ancestors when the trail overflows its container",
          description: t("breadcrumb.test2"),
        },
        { name: "leaves a trail that fits on one line uncollapsed", description: t("breadcrumb.test3") },
        {
          name: "re-measures on every resize, even shrinking from an already-expanded state",
          description: t("breadcrumb.test4"),
        },
      ],
    },
    {
      file: "packages/vanilla/src/components/breadcrumb.test.ts",
      tests: [
        {
          name: "does nothing to a trail short enough that nothing is worth collapsing",
          description: t("breadcrumb.test5"),
        },
        { name: "leaves a trail that fits on one line untouched", description: t("breadcrumb.test6") },
        {
          name: "opens a real Menu of the hidden ancestors when the trail does not fit",
          description: t("breadcrumb.test7"),
        },
        {
          name: "re-derives the collapse on every resize, expanding first so it never gets stuck",
          description: t("breadcrumb.test8"),
        },
        { name: "restores every crumb to visible on unmount", description: t("breadcrumb.test9") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("breadcrumb.description")} />

    <h3>{t("breadcrumb.examplesTitle")}</h3>

    <h4>{t("breadcrumb.twoTitle")}</h4>
    <p set:html={t("breadcrumb.twoBody")} />
    <ComponentPreview tree={breadcrumbTwoTree(t)} label={t("breadcrumb.twoLabel")} viewport="auto" />

    <h4>{t("breadcrumb.multiTitle")}</h4>
    <p set:html={t("breadcrumb.multiBody")} />
    <ComponentPreview
      tree={breadcrumbMultiTree(t, {
        projects: "/proyectos",
        kit: "/proyectos/kit-digital",
      })}
      label={t("breadcrumb.multiLabel")}
      viewport="auto"
    />

    <h4>{t("breadcrumb.iconTitle")}</h4>
    <p set:html={t("breadcrumb.iconBody")} />
    <ComponentPreview tree={breadcrumbIconTree(t, "/proyectos")} label={t("breadcrumb.iconLabel")} viewport="auto" />

    <h4>{t("breadcrumb.longTitle")}</h4>
    <p set:html={t("breadcrumb.longBody")} />
    <ul>
      <li set:html={t("breadcrumb.longItem1")} />
      <li set:html={t("breadcrumb.longItem2")} />
    </ul>
    <ComponentPreview tree={breadcrumbLongTree(t, "/proyectos")} label={t("breadcrumb.longLabel")} viewport="auto" />

    <h4>{t("breadcrumb.collapseTitle")}</h4>
    <p set:html={t("breadcrumb.collapseBody")} />
    <ComponentPreview
      tree={breadcrumbCollapseTree(t, {
        documents: "/documentos",
        projects: "/documentos/proyectos",
        designSystem: "/documentos/sistema-de-diseno",
        components: "/documentos/sistema-de-diseno/componentes",
      })}
      label={t("breadcrumb.collapseLabel")}
      viewport="auto"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("breadcrumb.contractBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("breadcrumb.a11yBody")} />
  </Fragment>
</ComponentPageShell>
