---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/switch.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { switchDoCheckboxTree, switchDontSaveTree } from "../../demos/switch";
import "@skryensya/core/components/checkbox.css";
import { switchAnatomyTree, switchTree, tileSwitchTree } from "../../demos/switch";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const t = useTranslations(getLocale(Astro.url));

const tileSwitchVanilla = `import { initComponents } from "@skryensya/vanilla/auto";

// Each label is authored with data-sk-tile-switch (data-name, data-value,
// data-default-checked) plus its input role="switch" and its indicator.
// initComponents hydrates them with the @zag-js/checkbox machine.
await initComponents();

for (const root of document.querySelectorAll(
  "[data-sk-tile-switch]",
)) {
  root.addEventListener("sk:tilecheckedchange", (event) => {
    console.log(root.dataset.value, event.detail.checked);
  });
}`;
---

<ComponentPageShell
  title="Switch"
  description={t("switchPage.description")}
  contractId="switch"
  appearanceTargetSelector=".sk-switch"
  styleGroups={[{ file: "components/switch.css", probe: "sk-switch" }]}
  testFiles={["packages/vanilla/src/components/tile-switch.svelte.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("switchPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={switchTree(t)} title={t("switchPage.basicTitle")} description={t("switchPage.basicBody")} />
    <UsagePreview tree={tileSwitchTree(t)} title={t("switchPage.tileTitle")} description={t("switchPage.tileBody1")} />
    <p set:html={t("switchPage.tileBody2")} />
    <CodeBlock code={tileSwitchVanilla} label="JavaScript" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "switchPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />
    <UsagePreview
      tree={variantsTree(switchTree(t), [{ label: t("component.state.default"), options: {} }, { label: t("component.state.checked"), options: { defaultChecked: true } }, { label: t("component.state.disabled"), options: { disabled: true } }])}
      title={t("component.statesTitle")}
      description={t("component.statesBody")}
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("switchPage.anatomyBody")} />
    <UsagePreview
      tree={switchAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("switchPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("switchPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "switchPage.when")} avoid={tList(t, "switchPage.whenNot")} />
    <DoDont
      title={t("switchPage.dd.immediate.title")}
      do={{ tree: switchDoCheckboxTree(t), caption: t("switchPage.dd.immediate.do") }}
      dont={{ tree: switchDontSaveTree(t), caption: t("switchPage.dd.immediate.dont") }}
    />
    <DoDont
      canvas
      title={t("switchPage.dd.surface.title")}
      do={{ tree: tileSwitchTree(t), caption: t("switchPage.dd.surface.do") }}
      dont={{ tree: switchTree(t), caption: t("switchPage.dd.surface.dont") }}
    />
    <ContentRules items={tList(t, "switchPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("switchPage.a11yIntro")}
      does={tList(t, "switchPage.a11yDoes")}
      yours={tList(t, "switchPage.a11yYours")}
      keys={[{ keys: [t("component.key.space")], action: t("switchPage.key.toggle") }]}
    />
  </Fragment>
</ComponentPageShell>
