---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/switch.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { switchAnatomyTree, switchTree, tileSwitchTree } from "../../demos/switch";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const tileSwitchVanilla = `import { initComponents } from "@skryensya/vanilla/auto";

// Each label is authored with data-sk-tile-switch (data-name, data-value,
// data-default-checked) plus its input role="switch" and its indicator.
// initComponents hydrates them with the @zag-js/checkbox machine.
await initComponents();

for (const root of document.querySelectorAll(
  "[data-sk-tile-switch]",
)) {
  root.addEventListener("sk:checkedchange", (event) => {
    console.log(root.dataset.value, event.detail.checked);
  });
}`;
---

<ComponentPageShell
  title="Switch"
  description={t("switchPage.description")}
  contractId="switch"
  styleGroups={[{ file: "components/switch.css", probe: "sk-switch" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/tile-switch.svelte.test.ts",
      tests: [
        {
          name: "toggles checked state and root data-state on click, emitting sk:checkedchange",
          description: t("switchPage.test1"),
        },
        { name: "is form-associated and honours its default-checked", description: t("switchPage.test2") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("switchPage.lede")} />

    <p set:html={t("switchPage.anatomyBody")} />
    <ComponentPreview
      tree={switchAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("switchPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={switchTree(t)} label="Switch" />
    <p set:html={t("switchPage.body")} />

    <h3>{t("switchPage.tileTitle")}</h3>
    <p set:html={t("switchPage.tileBody1")} />
    <ComponentPreview tree={tileSwitchTree(t)} label="TileSwitch" />
    <p set:html={t("switchPage.tileBody2")} />
    <CodeBlock code={tileSwitchVanilla} label="JavaScript" />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("switchPage.contractItem1")} />
      <li set:html={t("switchPage.contractItem2")} />
      <li set:html={t("switchPage.contractItem3")} />
      <li set:html={t("switchPage.contractItem4")} />
      <li set:html={t("switchPage.contractItem5")} />
    </ul>
  </Fragment>
</ComponentPageShell>
