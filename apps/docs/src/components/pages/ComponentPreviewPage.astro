---
/*
 * The prose below is fully translated through `t()`, like every other migrated page. The example
 * CODE (HTML/JS/TS constants, including the aria-labels and comments baked into the illustrative
 * `anatomy`/`anatomyFull` markup) stays a single literal shared by both locales rather than being
 * routed through `t()` line by line: it is demonstrative source a reader copies and reads, the same
 * "code, not prose" call `AccordionPage` already made for its install snippets, just applied to a
 * page whose entire subject IS example code.
 */
import "@skryensya/core/components/tile.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { buildPreviewFrameDocument } from "../../lib/preview-frame";
import { SaveActionDemo, ScreensGridDemo } from "../../components/react-demos/component-preview";
import { componentPreviewBareTree } from "../../demos/component-preview";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/component-preview.yaml?raw";
import coreSource from "@core/src/component-preview.ts?raw";
import cssSource from "@core/css/components/component-preview.css?raw";
import vanillaMountSource from "@vanilla/src/components/component-preview.ts?raw";
import vanillaTestSource from "@vanilla/src/components/component-preview.test.ts?raw";
import reactSource from "@react/src/components/component-preview.tsx?raw";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add shiki @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/segmented.css";
@import "@skryensya/core/components/copy-button.css";
@import "@skryensya/core/components/code-preview.css";
@import "@skryensya/core/components/component-preview.css";`;

const demoHtml = `<button class="sk-button sk-interactive" data-sk-button type="button">
  Guardar cambios
</button>`;

const demoJs = `const button = document.querySelector("[data-sk-button]");
button?.addEventListener("click", saveChanges);`;

/* Multicol, because its lanes are keyed to the system's OWN named breakpoints: one lane below
   compact (36rem), two at compact, three at desktop (52rem). Each preset therefore lands in a
   different band (mobile 1, tablet 2, libre 3), which is the claim the prose makes, shown instead
   of asserted. The media queries resolve against the FRAME's viewport, which is the preset width;
   that is what the iframe buys over a container query on a plain div. */
const screensHtml = `<div class="sk-grid" data-multicol data-columns="3">
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Facturación</span>
      <span class="sk-tile__description">Planes, pagos y recibos.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Equipo</span>
      <span class="sk-tile__description">Personas, roles y permisos.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Dominios</span>
      <span class="sk-tile__description">DNS y certificados.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Registros</span>
      <span class="sk-tile__description">Actividad y auditoría.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Integraciones</span>
      <span class="sk-tile__description">Webhooks y llaves de API.</span>
    </span>
  </a>
  <a class="sk-tile sk-tile--interactive sk-interactive" href="#">
    <span class="sk-tile__content">
      <span class="sk-tile__title">Notificaciones</span>
      <span class="sk-tile__description">Correo y alertas.</span>
    </span>
  </a>
</div>`;

const screensReact = `import { Grid } from "@skryensya/react/grid";
import { TileLink } from "@skryensya/react/tile-link";

// Grid aún no tiene prop \`multicol\`; el atributo pasa derecho por las props.
<Grid columns={3} data-multicol>
  <TileLink href="/facturacion">
    <span className="sk-tile__content">
      <span className="sk-tile__title">Facturación</span>
      <span className="sk-tile__description">Planes, pagos y recibos.</span>
    </span>
  </TileLink>
  {/* … */}
</Grid>;`;

const demoReact = `import { Button } from "@skryensya/react/button";

export function SaveAction() {
  return <Button onClick={saveChanges}>Guardar cambios</Button>;
}`;

const anatomy = `<div class="sk-component-preview" data-sk-component-preview>
  <header class="sk-component-preview__header">
    <span class="sk-component-preview__title">Button</span>
    <div class="sk-component-preview__actions">
      <button
        class="sk-button sk-interactive sk-component-preview__reload"
        data-sk-component-preview-reload
        data-variant="ghost"
        data-size="sm"
        data-icon-only
        type="button"
        aria-label="Recargar preview: Button"
        title="Recargar"
      >
        <span data-sk-icon="refresh"></span>
      </button>
    </div>
  </header>

  <!-- El srcdoc es estático: no existe una segunda ruta. Lo arma la pestaña JS. -->
  <iframe
    class="sk-component-preview__stage"
    title="Preview renderizado: Button"
    allow="clipboard-write"
    aria-busy="true"
  ></iframe>

  <!-- Arrastra el borde inferior del stage para darle más o menos alto. -->
  <div
    class="sk-component-preview__resizer"
    data-sk-component-preview-resizer
    role="separator"
    aria-orientation="horizontal"
    aria-label="Ajustar el alto del preview: Button"
    tabindex="0"
  ></div>

  <!-- Se oculta solo cuando el frame avisa que ya pintó. -->
  <div class="sk-component-preview__loading">
    <span class="sk-loader" data-size="lg" role="status" aria-label="Cargando preview: Button"></span>
  </div>
</div>`;

const anatomyFull = `<div class="sk-component-preview" data-sk-component-preview>
  <header class="sk-component-preview__header">
    <span class="sk-component-preview__title">Button</span>
    <span class="sk-component-preview__note">primario</span>
    <div class="sk-component-preview__actions">
      <button
        class="sk-button sk-interactive sk-component-preview__reload"
        data-sk-component-preview-reload
        data-variant="ghost"
        data-size="sm"
        data-icon-only
        type="button"
        aria-label="Recargar preview: Button"
      >
        <span data-sk-icon="refresh"></span>
      </button>

      <!-- Los tabs de binding son un SegmentedControl normal. -->
      <div
        class="sk-segmented sk-component-preview__binding-tabs"
        data-sk-segmented
        data-sk-component-preview-binding-tabs
        data-value="vanilla"
        role="radiogroup"
        aria-label="Binding"
      >
        <span class="sk-segmented__indicator" aria-hidden="true"></span>
        <button class="sk-segmented__option sk-interactive" data-sk-segmented-option data-value="vanilla" type="button" role="radio">
          Vanilla
        </button>
        <button class="sk-segmented__option sk-interactive" data-sk-segmented-option data-value="react" type="button" role="radio">
          React
        </button>
      </div>
    </div>
  </header>

  <!-- Mismo stage que el ejemplo mínimo: el srcdoc lo arma la pestaña JS. -->
  <iframe
    class="sk-component-preview__stage"
    title="Preview renderizado: Button"
    allow="clipboard-write"
    aria-busy="true"
  ></iframe>

  <div
    class="sk-component-preview__resizer"
    data-sk-component-preview-resizer
    role="separator"
    aria-orientation="horizontal"
    aria-label="Ajustar el alto del preview: Button"
    tabindex="0"
  ></div>

  <div class="sk-component-preview__loading">
    <span class="sk-loader" data-size="lg" role="status" aria-label="Cargando preview: Button"></span>
  </div>

  <!-- Un panel por binding. CodePreview es dueño de cada superficie de código. -->
  <section class="sk-component-preview__binding" data-sk-component-preview-binding="vanilla">
    <div class="sk-component-preview__code" data-sk-component-preview-source="html">
      <div class="sk-code-preview" data-sk-code-preview>
        <!-- HTML resaltado por Shiki + CopyButton -->
      </div>
    </div>
  </section>

  <section class="sk-component-preview__binding" data-sk-component-preview-binding="react" hidden>
    <div class="sk-component-preview__code">
      <div class="sk-code-preview" data-sk-code-preview>
        <!-- TSX resaltado por Shiki + CopyButton -->
      </div>
    </div>
  </section>
</div>`;

/*
 * La otra mitad del ejemplo: sin el documento del stage y sin el montaje, el HTML de arriba es un
 * marco vacío. Es el mismo código que corre esta página, no una versión de folleto.
 */
const anatomyJs = `import { mountComponentPreview } from "@skryensya/vanilla/component-preview";
import { mountCodePreview } from "@skryensya/vanilla/code-preview";
// El entry point del frame (el de "runtime dentro del srcdoc", más abajo) como URL.
import frameRuntimeUrl from "./component-preview-frame.ts?worker&url";

/* El stage es un documento aparte: su <head> carga el runtime, que clona los estilos del padre,
   sincroniza modo/contraste/radio/densidad, monta Vanilla adentro y ajusta el alto del iframe. */
const frameDocument = \`<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <base target="_top">
    <script type="module" src="\${frameRuntimeUrl}"><\\/script>
  </head>
  <body class="sk-component-preview__frame-body">
    ${demoHtml.replace(/\n/g, "\n    ")}
  </body>
</html>\`;

const stage = document.querySelector(".sk-component-preview__stage");
stage.srcdoc = frameDocument;

// Las superficies de documentación son opt-in: tabs, recarga y resizer del preview…
mountComponentPreview();
// …y copiar, densidad y disclosure de cada bloque de código, si el preview trae paneles.
mountCodePreview();`;

/*
 * El stage de los dos ejemplos de abajo es un ComponentPreview: el mismo documento srcdoc que usa
 * ComponentPreview, montado un nivel más adentro. El runtime del frame monta las superficies de
 * documentación, así el preview anidado tiene sus propios tabs, recarga, resizer y disclosure.
 */
const nestedFrame = buildPreviewFrameDocument({ body: demoHtml });

const mount = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountCodePreview } from "@skryensya/vanilla/code-preview";
import { mountComponentPreview } from "@skryensya/vanilla/component-preview";

// Button, SegmentedControl y CopyButton se descubren por selector.
await initComponents();

// Las superficies de documentación son opt-in.
mountCodePreview();
mountComponentPreview();`;

const frameMount = `// Entry point cargado por el srcdoc; se ejecuta en el realm del iframe.
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";

mountIcons(document, lucideIcons);
await initComponents(document);`;

const sourceFiles = [
  { id: "contracts/semantic/component-preview.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/component-preview.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/component-preview.css", source: cssSource, language: "css" },
  { id: "packages/vanilla/src/components/component-preview.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/vanilla/src/components/component-preview.test.ts", source: vanillaTestSource, language: "ts" },
  { id: "packages/react/src/components/component-preview.tsx", source: reactSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="ComponentPreview"
  description={t("componentPreview.description")}
  contractId="component-preview"
  styleGroups={[{ file: "components/component-preview.css", probe: "sk-component-preview" }]}
  sourceFiles={sourceFiles}
  tests={[
    {
      file: "packages/vanilla/src/components/component-preview.test.ts",
      tests: [
        {
          name: "switches binding and nested Vanilla source panels idempotently",
          description: t("componentPreview.test1"),
        },
        { name: "shares Vanilla | React across every preview on the page", description: t("componentPreview.test2") },
        {
          name: "cycles free → tablet → mobile → free on click, marking the stage and clearing it for free",
          description: t("componentPreview.test3"),
        },
        { name: "reloads the srcdoc stage from the authored document", description: t("componentPreview.test4") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("componentPreview.lede")} />

    <ComponentPreview html={demoHtml} js={demoJs} react={demoReact} label="Button">
      <Fragment slot="react">
        <SaveActionDemo client:load />
      </Fragment>
    </ComponentPreview>

    <h3>{t("componentPreview.responsibilitiesTitle")}</h3>
    <ul>
      <li set:html={t("componentPreview.respItem1")} />
      <li set:html={t("componentPreview.respItem2")} />
      <li set:html={t("componentPreview.respItem3")} />
    </ul>
    <p set:html={t("componentPreview.crossBody")} />

    <h3>{t("componentPreview.minimalTitle")}</h3>
    <p set:html={t("componentPreview.minimalBody")} />
    <ComponentPreview label="ComponentPreview" note={t("componentPreview.minimalNote")} code={anatomy} js={anatomyJs} lang="html">
      {/*
       * El stage acomoda sus hijos como flex items, así que un specimen se encoge a su contenido.
       * Éste es una superficie: ocupa todo el ancho disponible, dentro del inset del stage.
       */}
      <div class="sk-component-preview" data-sk-component-preview style="inline-size: 100%">
        <header class="sk-component-preview__header">
          <span class="sk-component-preview__title">Button</span>
          <div class="sk-component-preview__actions">
            <button
              class="sk-button sk-interactive sk-component-preview__reload"
              data-sk-component-preview-reload
              data-variant="ghost"
              data-size="sm"
              data-icon-only
              type="button"
              aria-label="Recargar preview: Button"
              title="Recargar"
            >
              <span data-sk-icon="refresh"></span>
            </button>
          </div>
        </header>

        <iframe
          class="sk-component-preview__stage"
          srcdoc={nestedFrame}
          title="Preview renderizado: Button"
          allow="clipboard-write"
          aria-busy="true"></iframe>

        <div
          class="sk-component-preview__resizer"
          data-sk-component-preview-resizer
          role="separator"
          aria-orientation="horizontal"
          aria-label="Ajustar el alto del preview: Button"
          title="Arrastra para ajustar el alto · doble clic para restablecer"
          tabindex="0"
        >
        </div>

        <div class="sk-component-preview__loading">
          <span
            class="sk-loader"
            data-size="lg"
            role="status"
            aria-label="Cargando preview: Button"></span>
        </div>
      </div>
    </ComponentPreview>
    <p set:html={t("componentPreview.flushBody")} />
    <p set:html={t("componentPreview.resizerBody")} />

    <h3>{t("componentPreview.screenTitle")}</h3>
    <p set:html={t("componentPreview.screenBody1")} />
    <p set:html={t("componentPreview.screenBody2")} />
    <p set:html={t("componentPreview.screenBody3")} />
    <ComponentPreview label="Grid multicol" note={t("componentPreview.screenNote")} html={screensHtml} react={screensReact}>
      <Fragment slot="react">
        <ScreensGridDemo client:load />
      </Fragment>
    </ComponentPreview>
    <p set:html={t("componentPreview.screenBody4")} />
    <p set:html={t("componentPreview.screenBody5")} />
    <p set:html={t("componentPreview.screenBody6")} />
    <p set:html={t("componentPreview.screenBody7")} />
    <p set:html={t("componentPreview.screenBody8")} />

    <h3>{t("componentPreview.fullTitle")}</h3>
    <p set:html={t("componentPreview.fullBody")} />
    <ComponentPreview label="ComponentPreview" note={t("componentPreview.fullNote")} code={anatomyFull} js={anatomyJs} lang="html">
      <div class="sk-component-preview" data-sk-component-preview style="inline-size: 100%">
        <header class="sk-component-preview__header">
          <span class="sk-component-preview__title">Button</span>
          <span class="sk-component-preview__note">primario</span>
          <div class="sk-component-preview__actions">
            <button
              class="sk-button sk-interactive sk-component-preview__reload"
              data-sk-component-preview-reload
              data-variant="ghost"
              data-size="sm"
              data-icon-only
              type="button"
              aria-label="Recargar preview: Button"
              title="Recargar"
            >
              <span data-sk-icon="refresh"></span>
            </button>
            <div
              class="sk-segmented sk-component-preview__binding-tabs"
              data-sk-segmented
              data-sk-component-preview-binding-tabs
              data-value="vanilla"
              role="radiogroup"
              aria-label="Binding"
            >
              <span class="sk-segmented__indicator" aria-hidden="true"></span>
              <button
                class="sk-segmented__option sk-interactive"
                data-sk-segmented-option
                data-value="vanilla"
                type="button"
                role="radio"
              >
                Vanilla
              </button>
              <button
                class="sk-segmented__option sk-interactive"
                data-sk-segmented-option
                data-value="react"
                type="button"
                role="radio"
              >
                React
              </button>
            </div>
          </div>
        </header>

        <iframe
          class="sk-component-preview__stage"
          srcdoc={nestedFrame}
          title="Preview renderizado: Button"
          allow="clipboard-write"
          aria-busy="true"></iframe>

        <div
          class="sk-component-preview__resizer"
          data-sk-component-preview-resizer
          role="separator"
          aria-orientation="horizontal"
          aria-label="Ajustar el alto del preview: Button"
          title="Arrastra para ajustar el alto · doble clic para restablecer"
          tabindex="0"
        >
        </div>

        <div class="sk-component-preview__loading">
          <span
            class="sk-loader"
            data-size="lg"
            role="status"
            aria-label="Cargando preview: Button"></span>
        </div>

        <div class="sk-component-preview__binding" data-sk-component-preview-binding="vanilla">
          <div class="sk-component-preview__code" data-sk-component-preview-source="html">
            <CodeBlock code={demoHtml} lang="html" />
          </div>
        </div>

        <div class="sk-component-preview__binding" data-sk-component-preview-binding="react" hidden>
          <div class="sk-component-preview__code">
            <CodeBlock code={demoReact} lang="tsx" />
          </div>
        </div>
      </div>
    </ComponentPreview>

    <h3 id="bare">{t("componentPreview.bareTitle")}</h3>
    <p set:html={t("componentPreview.bareBody1")} />
    <p set:html={t("componentPreview.bareBody2")} />
    <ComponentPreview tree={componentPreviewBareTree(t)} label="ComponentPreview.bare" />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />

    <h3>{t("componentPreview.mountTitle")}</h3>
    <p set:html={t("componentPreview.mountBody")} />
    <CodeBlock code={mount} label="TypeScript" lang="ts" />
    <CodeBlock code={frameMount} label={t("componentPreview.frameMountLabel")} lang="ts" />
  </Fragment>
</ComponentPageShell>
