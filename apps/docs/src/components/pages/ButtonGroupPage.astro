---
import "@skryensya/core/components/button-group.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/components/menu.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/popover.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  buttonGroupAnatomyCss,
  buttonGroupAnatomyTree,
  buttonGroupBySize,
  buttonGroupInputTree,
  buttonGroupNestedTree,
  buttonGroupPopoverTree,
  buttonGroupRtlTree,
  buttonGroupSelectTree,
  buttonGroupSeparatorBy,
  buttonGroupSplitTree,
  buttonGroupTextTree,
  buttonGroupTree,
  buttonGroupVerticalBySize,
} from "../../demos/button-group";

import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
import {
  buttonGroupSplitDoTree,
  buttonGroupSplitDontTree,
  buttonGroupSingleDoTree,
  buttonGroupSingleDontTree,
  buttonGroupVerbsDoTree,
  buttonGroupVerbsDontTree,
  buttonGroupSizeDoTree,
  buttonGroupSizeDontTree,
  buttonGroupLookDoTree,
  buttonGroupLookDontTree,
  buttonGroupFieldDoTree,
  buttonGroupFieldDontTree,
  buttonGroupUnrelatedDoTree,
  buttonGroupUnrelatedDontTree,
  buttonGroupOptionDoTree,
  buttonGroupOptionDontTree,
  buttonGroupFuseDoTree,
  buttonGroupFuseDontTree,
} from "../../demos/dodont-pairs";

const story = "Components/ButtonGroup";
const explain = (group: string, value: string) => t(`buttonGroupPage.prop.${group}.${value}` as Parameters<typeof t>[0]);
/* The frame script pins the body to its content with an inline !important, so the stage's height cannot be asked of it:
   the group sits at the top of the frame's viewport, centred across, and what the menu floor adds below is the room its menu opens into. */
const centeredCss = `
  .sk-button-group {
    position: fixed;
    inset: var(--space-inset-md) 0 auto;
    margin-inline: auto;
    inline-size: max-content;
  }
`;
---

<ComponentPageShell
  hookPlayground={{ tree: buttonGroupTree(t), fit: true }}
  title="ButtonGroup"
  description={t("buttonGroupPage.description")}
  contractId="button-group"
  appearanceTargetSelector=".sk-button-group :is(.sk-button, .sk-input, .sk-select, .sk-popover)"
  styleGroups={[
    { file: "components/button-group.css", probe: "sk-button-group", title: "ButtonGroup" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
  ]}
  testFiles={["packages/react/src/components/button-group.test.tsx"]}
  extraSheets={[
    "@skryensya/core/patterns/anchored.css",
    "@skryensya/core/components/menu.css",
    "@skryensya/core/components/button.css",
    "@skryensya/core/components/input.css",
    "@skryensya/core/components/select.css",
    "@skryensya/core/components/popover.css",
    "@skryensya/core/patterns/layout.css",
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("buttonGroupPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <h4>{t("buttonGroupPage.basicTitle")}</h4>
    <UsagePreview tree={buttonGroupTree(t)} description={t("buttonGroupPage.basicBody")} label={t("buttonGroupPage.basicTitle")} storybookTitle={story} storybookStory="Default" />

    <h4>{t("buttonGroupPage.splitTitle")}</h4>
    <UsagePreview
      variants={[
        { value: "solid", label: "solid", explain: explain("split", "solid"), tree: buttonGroupSplitTree({ variant: "solid", tone: "accent" })(t) },
        { value: "soft", label: "soft", explain: explain("split", "soft"), tree: buttonGroupSplitTree({ variant: "soft" })(t) },
        { value: "ghost", label: "ghost", explain: explain("split", "ghost"), tree: buttonGroupSplitTree({ variant: "ghost" })(t) },
        { value: "danger", label: "danger", explain: explain("split", "danger"), tree: buttonGroupSplitTree({ variant: "solid", tone: "danger" })(t) },
      ]}
      initialVariant="solid"
      variantsLabel={t("buttonGroupPage.splitTitle")}
      viewport="menu"
      stageMinBlockSize="18rem"
      css={`${centeredCss} .sk-button-group { inset-block-start: 3.5rem; }`}
      description={t("buttonGroupPage.splitBody")}
      label={t("buttonGroupPage.splitTitle")}
      storybookTitle={story}
      storybookStory="SplitAccent"
    />

    <h4>{t("buttonGroupPage.verticalTitle")}</h4>
    <UsagePreview
      variants={(["xs", "sm", "md", "lg"] as const).map((size) => ({ value: size, label: size, explain: explain("vertical", size), tree: buttonGroupVerticalBySize(size)(t) }))}
      initialVariant="sm"
      variantsLabel={t("buttonGroupPage.verticalTitle")}
      stageMinBlockSize="7rem"
      description={t("buttonGroupPage.verticalBody")}
      label={t("buttonGroupPage.verticalTitle")}
      storybookTitle={story}
      storybookStory="Vertical"
    />

    <h4>{t("buttonGroupPage.sizeTitle")}</h4>
    <UsagePreview
      variants={(["sm", "md", "lg"] as const).map((size) => ({ value: size, label: size, explain: explain("size", size), tree: buttonGroupBySize(size)(t) }))}
      initialVariant="md"
      variantsLabel={t("buttonGroupPage.sizeTitle")}
      description={t("buttonGroupPage.sizeBody")}
      label={t("buttonGroupPage.sizeTitle")}
      storybookTitle={story}
      storybookStory="Size"
    />

    <h4>{t("buttonGroupPage.nestedTitle")}</h4>
    <UsagePreview tree={buttonGroupNestedTree(t)} description={t("buttonGroupPage.nestedBody")} label={t("buttonGroupPage.nestedTitle")} storybookTitle={story} storybookStory="Nested" />

    <h4>{t("buttonGroupPage.separatorTitle")}</h4>
    <UsagePreview
      variants={(["inset", "full", "none"] as const).map((value) => ({ value, label: t(`buttonGroupPage.separator.${value}` as never), explain: explain("separator", value), tree: buttonGroupSeparatorBy(value)(t) }))}
      initialVariant="inset"
      variantsLabel={t("buttonGroupPage.separatorTitle")}
      description={t("buttonGroupPage.separatorBody")}
      label={t("buttonGroupPage.separatorTitle")}
      storybookTitle={story}
      storybookStory="Separator"
    />

    <h4>{t("buttonGroupPage.inputTitle")}</h4>
    <UsagePreview tree={buttonGroupInputTree(t)} description={t("buttonGroupPage.inputBody")} label={t("buttonGroupPage.inputTitle")} omitAppearances={["tactile"]} storybookTitle={story} storybookStory="Input" />

    <h4>{t("buttonGroupPage.textTitle")}</h4>
    <UsagePreview tree={buttonGroupTextTree(t)} description={t("buttonGroupPage.textBody")} label={t("buttonGroupPage.textTitle")} storybookTitle={story} storybookStory="Text" />

    <h4>{t("buttonGroupPage.selectTitle")}</h4>
    <UsagePreview
      tree={buttonGroupSelectTree(t)}
      description={t("buttonGroupPage.selectBody")}
      label={t("buttonGroupPage.selectTitle")}
      viewport="menu"
      omitAppearances={["tactile"]}
      css={`
        ${centeredCss}
        .sk-button-group {
          inset-block: 0 5rem;
          margin-block: auto;
        }
        .sk-button-group > .sk-select {
          inline-size: 7rem;
          flex-shrink: 0;
        }
      `}
      storybookTitle={story}
      storybookStory="Select"
    />

    <h4>{t("buttonGroupPage.popoverTitle")}</h4>
    <UsagePreview tree={buttonGroupPopoverTree(t)} description={t("buttonGroupPage.popoverBody")} label={t("buttonGroupPage.popoverTitle")} viewport="menu" stageMinBlockSize="20rem" css={`.sk-component-preview__frame-body { padding-block-end: 11rem; } .sk-popover__close { margin-block-start: var(--space-stack-md); }`} storybookTitle={story} storybookStory="Popover" />

    <h4>{t("buttonGroupPage.rtlTitle")}</h4>
    <UsagePreview tree={buttonGroupRtlTree(t)} frostSatin="blue" description={t("buttonGroupPage.rtlBody")} label={t("buttonGroupPage.rtlTitle")} storybookTitle={story} storybookStory="Rtl" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "buttonGroupPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("buttonGroupPage.anatomyBody")} />
    <UsagePreview tree={buttonGroupAnatomyTree(t)} css={buttonGroupAnatomyCss} label={t("buttonGroupPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("buttonGroupPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "buttonGroupPage.when")} avoid={tList(t, "buttonGroupPage.whenNot")} />
    <DoDont
      title={t("buttonGroupPage.dd.label.title")}
      do={{ tree: buttonGroupSplitDoTree(t), caption: t("buttonGroupPage.dd.label.do") }}
      dont={{ tree: buttonGroupSplitDontTree(t), caption: t("buttonGroupPage.dd.label.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.single.title")}
      do={{ tree: buttonGroupSingleDoTree(t), caption: t("buttonGroupPage.dd.single.do") }}
      dont={{ tree: buttonGroupSingleDontTree(t), caption: t("buttonGroupPage.dd.single.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.verbs.title")}
      do={{ tree: buttonGroupVerbsDoTree(t), caption: t("buttonGroupPage.dd.verbs.do") }}
      dont={{ tree: buttonGroupVerbsDontTree(t), caption: t("buttonGroupPage.dd.verbs.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.size.title")}
      do={{ tree: buttonGroupSizeDoTree(t), caption: t("buttonGroupPage.dd.size.do") }}
      dont={{ tree: buttonGroupSizeDontTree(t), caption: t("buttonGroupPage.dd.size.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.look.title")}
      do={{ tree: buttonGroupLookDoTree(t), caption: t("buttonGroupPage.dd.look.do") }}
      dont={{ tree: buttonGroupLookDontTree(t), caption: t("buttonGroupPage.dd.look.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.field.title")}
      do={{ tree: buttonGroupFieldDoTree(t), caption: t("buttonGroupPage.dd.field.do") }}
      dont={{ tree: buttonGroupFieldDontTree(t), caption: t("buttonGroupPage.dd.field.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.unrelated.title")}
      do={{ tree: buttonGroupUnrelatedDoTree(t), caption: t("buttonGroupPage.dd.unrelated.do") }}
      dont={{ tree: buttonGroupUnrelatedDontTree(t), caption: t("buttonGroupPage.dd.unrelated.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.option.title")}
      do={{ tree: buttonGroupOptionDoTree(t), caption: t("buttonGroupPage.dd.option.do") }}
      dont={{ tree: buttonGroupOptionDontTree(t), caption: t("buttonGroupPage.dd.option.dont") }}
    />
    <DoDont
      title={t("buttonGroupPage.dd.fuse.title")}
      do={{ tree: buttonGroupFuseDoTree(t), caption: t("buttonGroupPage.dd.fuse.do") }}
      dont={{ tree: buttonGroupFuseDontTree(t), caption: t("buttonGroupPage.dd.fuse.dont") }}
    />
    <ContentRules items={tList(t, "buttonGroupPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("buttonGroupPage.a11yIntro")}
      does={tList(t, "buttonGroupPage.a11yDoes")}
      yours={tList(t, "buttonGroupPage.a11yYours")}
      keys={[
        { keys: ["Tab"], action: t("buttonGroupPage.key.tab") },
        { keys: ["Enter", t("component.key.space")], action: t("buttonGroupPage.key.run") },
        { keys: ["↑", "↓"], action: t("buttonGroupPage.key.arrows") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
