---
import "@skryensya/core/components/editor.css";
import "@skryensya/core/components/toolbar.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/popover.css";
import "@skryensya/core/patterns/anchored.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { editorAnatomyTree, editorCompactTree, editorDontSingleLineTree, editorTree } from "../../demos/editor";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const storybookTitle = "Components/Forms/Editor";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`editorPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const install = `pnpm add @skryensya/core @skryensya/editor @skryensya/react
# or, on the Vanilla side:
pnpm add @skryensya/core @skryensya/editor @skryensya/vanilla`;

const styles = `@import "@skryensya/core/components/editor.css";
@import "@skryensya/core/components/toolbar.css";
@import "@skryensya/core/components/input.css";
@import "@skryensya/core/components/popover.css";
@import "@skryensya/core/patterns/anchored.css";`;

const js = `import { mountEditor } from "@skryensya/vanilla/editor";

mountEditor();`;
import { dd2 } from "../../demos/dodont-labels";
---

<ComponentPageShell
  title="Editor"
  description={t("editorPage.description")}
  contractId="editor"
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("editorPage.lede")} />

    <UsagePreview
      tree={editorCompactTree(t)}
      optionName="toolbarCompact"
      title={t("editorPage.prop.toolbarCompact.title")}
      description={t("editorPage.prop.toolbarCompact.body")}
      explain={explain("toolbarCompact", ["false", "true"])}
      storybookTitle={storybookTitle}
      storybookStory="Compact"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={editorTree(t)} title={t("editorPage.defaultTitle")} description={t("editorPage.defaultBody")} storybookTitle={storybookTitle} storybookStory="Default" />
    <UsagePreview tree={editorCompactTree(t)} title={t("editorPage.compactTitle")} description={t("editorPage.compactBody")} storybookTitle={storybookTitle} storybookStory="Compact" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "editorPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("editorPage.anatomyBody")} />
    <UsagePreview
      tree={editorAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("editorPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("editorPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "editorPage.when")} avoid={tList(t, "editorPage.whenNot")} />
    <DoDont
      canvas
      title={t("editorPage.dd.format.title")}
      do={{ tree: editorTree(t), caption: t("editorPage.dd.format.do") }}
      dont={{ tree: editorDontSingleLineTree(t), caption: t("editorPage.dd.format.dont") }}
    />
    <DoDont
      title={t("dd2.editor.title")}
      do={{ tree: dd2.editor.do(t), caption: t("dd2.editor.do") }}
      dont={{ tree: dd2.editor.dont(t), caption: t("dd2.editor.dont") }}
    />
    <ContentRules items={tList(t, "editorPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("editorPage.a11yIntro")}
      does={tList(t, "editorPage.a11yDoes")}
      yours={tList(t, "editorPage.a11yYours")}
      keys={[
        { keys: ["Ctrl+B", "⌘+B"], action: t("editorPage.a11yKeyBold") },
        { keys: ["Ctrl+I", "⌘+I"], action: t("editorPage.a11yKeyItalic") },
        { keys: ["Ctrl+Z", "⌘+Z"], action: t("editorPage.a11yKeyUndo") },
        { keys: ["Tab"], action: t("editorPage.a11yKeyTab") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
