---
import "@skryensya/core/components/editor.css";
import "@skryensya/core/components/toolbar.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/popover.css";
import "@skryensya/core/patterns/anchored.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { editorAnatomyTree, editorCompactTree, editorTree } from "../../demos/editor";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/editor @skryensya/react
# or, on the Vanilla side:
pnpm add @skryensya/core @skryensya/editor @skryensya/vanilla`;

const styles = `@import "@skryensya/core/components/editor.css";
@import "@skryensya/core/components/toolbar.css";
@import "@skryensya/core/components/input.css";
@import "@skryensya/core/components/popover.css";
@import "@skryensya/core/patterns/anchored.css";`;

const js = `import { mountEditor } from "@skryensya/vanilla/editor";

mountEditor();`;
---

<ComponentPageShell
  title="Editor"
  description={t("editorPage.description")}
  badge={t("editorPage.betaBadge")}
  contractId="editor"
  styleGroups={[{ file: "components/editor.css", probe: "sk-editor", title: "Editor" }]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("editorPage.lede")} />

    <p set:html={t("editorPage.anatomyBody")} />
    <ComponentPreview
      tree={editorAnatomyTree(t)}
      css={annotationDemoCss}
      js={js}
      label={t("editorPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={editorTree(t)} js={js} label="Editor" viewport="auto" />

    <h3>{t("editorPage.formatsTitle")}</h3>
    <p set:html={t("editorPage.formatsBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("editorPage.contractItem1")} />
      <li set:html={t("editorPage.contractItem2")} />
      <li set:html={t("editorPage.contractItem3")} />
      <li set:html={t("editorPage.contractItem4")} />
    </ul>

    <h3>{t("editorPage.compactTitle")}</h3>
    <p set:html={t("editorPage.compactBody")} />
    <ComponentPreview tree={editorCompactTree(t)} js={js} label={t("editorPage.compactLabel")} viewport="auto" />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("editorPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
