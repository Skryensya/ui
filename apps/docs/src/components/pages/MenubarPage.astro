---
import "@skryensya/core/components/menubar.css";
import "@skryensya/core/components/menu.css";
import "@skryensya/core/patterns/state-layer.css";
/* Structure diagram: the Annotated specimen is drawn by Annotation's own sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import DoDont from "../DoDont.astro";
import {
  menubarAnatomyCss,
  menubarAnatomyHtml,
  menubarDontSingleTree,
  menubarNavTree,
  menubarSubmenuTree,
  menubarTree,
} from "../../demos/menubar";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `@import "@skryensya/core/components/menubar.css";
@import "@skryensya/core/patterns/state-layer.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
---

<ComponentPageShell
  title="Menubar"
  description={t("menubarPage.description")}
  contractId="menubar"
  styleGroups={[
    { file: "components/menubar.css", probe: "sk-menubar", title: "Menubar" },
    { file: "patterns/state-layer.css", probe: "sk-interactive", title: "Heredados de State layer" },
  ]}
  testFiles={["packages/core/src/menubar.test.ts", "packages/react/src/components/menubar.test.tsx", "packages/vanilla/src/components/menubar.svelte.test.ts"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("menubarPage.lede")} />

    <h3>{t("menubarPage.showcaseTitle")}</h3>
    <p set:html={t("menubarPage.showcaseBody")} />
    <ComponentPreview tree={menubarTree(t)} js={js} label={t("menubarPage.label")} viewport="menu" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("menubarPage.contractBody")} />

    <h3>{t("menubarPage.submenuTitle")}</h3>
    <p set:html={t("menubarPage.submenuBody")} />
    <ComponentPreview
      tree={menubarSubmenuTree(t)}
      js={js}
      label={t("menubarPage.submenuTitle")}
      viewport="menu-deep"
    />

    <h3>{t("menubarPage.navSkinTitle")}</h3>
    <p set:html={t("menubarPage.navSkinBody")} />
    <ComponentPreview
      tree={menubarNavTree(t)}
      js={js}
      label={t("menubarPage.navSkinTitle")}
      viewport="menu"
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("menubarPage.anatomyBody")} />
    <ComponentPreview
      html={menubarAnatomyHtml(t)}
      css={menubarAnatomyCss}
      label={t("menubarPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("menubarPage.guidelinesLede")} />
    <DoDont
      title={t("menubarPage.dd.single.title")}
      do={{ tree: menubarTree(t), caption: t("menubarPage.dd.single.do") }}
      dont={{ tree: menubarDontSingleTree(t), caption: t("menubarPage.dd.single.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("menubarPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
