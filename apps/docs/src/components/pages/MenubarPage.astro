---
import "@skryensya/core/components/menubar.css";
import "@skryensya/core/components/menu.css";
import "@skryensya/core/patterns/state-layer.css";
/* Structure diagram: the Annotated specimen is drawn by Annotation's own sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import MenubarVsAppBar from "../MenubarVsAppBar.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  menubarCommandTree,
  menubarDoCommandsHtml,
  menubarDoShortLabelsHtml,
  menubarDontDestinationsHtml,
  menubarDontLongLabelsHtml,
  menubarEditorTree,
  menubarRowsTree,
  menubarDontSingleTree,
  menubarSubmenuTree,
  menubarTree,
} from "../../demos/menubar";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `@import "@skryensya/core/components/menubar.css";
@import "@skryensya/core/patterns/state-layer.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
---

<ComponentPageShell
  title="Menubar"
  description={t("menubarPage.description")}
  contractId="menubar"
  styleGroups={[
    { file: "components/menubar.css", probe: "sk-menubar", title: "Menubar" },
    { file: "patterns/state-layer.css", probe: "sk-interactive", title: "Heredados de State layer" },
  ]}
  testFiles={["packages/core/src/menubar.test.ts", "packages/react/src/components/menubar.test.tsx", "packages/vanilla/src/components/menubar.svelte.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("menubarPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    {/* The contract has no enum to vary (`label` is free text), so the one toggle is structural: what an
        entry is. Each value is a whole bar, and a switch back is instant. */}
    <UsagePreview
      tree={menubarTree(t)}
      variants={[
        { value: "dropdown", label: t("menubarPage.entry.dropdown"), tree: menubarTree(t), explain: t("menubarPage.entry.dropdown.body") },
        { value: "submenu", label: t("menubarPage.entry.submenu"), tree: menubarSubmenuTree(t), explain: t("menubarPage.entry.submenu.body") },
        { value: "command", label: t("menubarPage.entry.command"), tree: menubarCommandTree(t), explain: t("menubarPage.entry.command.body") },
      ]}
      variantsLabel={t("menubarPage.entry.label")}
      title={t("menubarPage.entry.title")}
      description={t("menubarPage.entry.intro")}
      stageMinBlockSize="26rem"
    />

    <h3>{t("menubarPage.rows.title")}</h3>
    <p set:html={t("menubarPage.rows.intro")} />
    <UsagePreview tree={menubarRowsTree(t)} label={t("menubarPage.rows.title")} viewport="menu-deep" />
    <ul>
      {[1, 2, 3, 4, 5, 6].map((n) => <li set:html={t(`menubarPage.rows.legend${n}` as Parameters<typeof t>[0])} />)}
    </ul>

    <h3>{t("menubarPage.editor.title")}</h3>
    <p set:html={t("menubarPage.editor.body")} />
    <UsagePreview tree={menubarEditorTree(t)} label={t("menubarPage.editor.title")} viewport="menu-deep" />

    <MenubarVsAppBar />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "menubarPage.contract").map((item) => <li set:html={item} />)}
    </ul>

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("menubarPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "menubarPage.when")} avoid={tList(t, "menubarPage.whenNot")} />
    <DoDont
      title={t("menubarPage.dd.single.title")}
      canvas
      compact
      do={{ tree: menubarTree(t), caption: t("menubarPage.dd.single.do") }}
      dont={{ tree: menubarDontSingleTree(t), caption: t("menubarPage.dd.single.dont") }}
    />
    <DoDont
      title={t("menubarPage.dd.labels.title")}
      do={{ html: menubarDoShortLabelsHtml(t), caption: t("menubarPage.dd.labels.do") }}
      dont={{ html: menubarDontLongLabelsHtml(t), caption: t("menubarPage.dd.labels.dont") }}
    />
    <DoDont
      title={t("menubarPage.dd.commands.title")}
      do={{ html: menubarDoCommandsHtml(t), caption: t("menubarPage.dd.commands.do") }}
      dont={{ html: menubarDontDestinationsHtml(t), caption: t("menubarPage.dd.commands.dont") }}
    />
    <ContentRules items={tList(t, "menubarPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("menubarPage.a11yIntro")}
      does={tList(t, "menubarPage.a11yDoes")}
      yours={tList(t, "menubarPage.a11yYours")}
      keys={[
        { keys: ["←", "→"], action: t("menubarPage.key.arrowsH") },
        { keys: ["Enter", t("component.key.space"), "↓"], action: t("menubarPage.key.open") },
        { keys: ["↑", "↓"], action: t("menubarPage.key.arrowsV") },
        { keys: ["Esc"], action: t("menubarPage.key.escape") },
        { keys: ["Tab"], action: t("menubarPage.key.tab") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
