---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  flyoutTree,
  flyoutRailTree,
  flyoutExclusiveTree,
  flyoutDisabledItemTree,
  flyoutDisabledTree,
  flyoutLongTree,
  flyoutPlaceholderTree,
} from "../../demos/flyout";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/flyout.yaml?raw";
import coreSource from "@core/src/flyout.ts?raw";
import cssSource from "@core/css/components/flyout.css?raw";
import vanillaMountSource from "@vanilla/src/components/flyout.ts?raw";
import vanillaTestSource from "@vanilla/src/components/flyout.test.ts?raw";
import reactSource from "@react/src/components/flyout.tsx?raw";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const styles = `@import "@skryensya/core/components/flyout.css";`;

const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);

await initComponents();`;

const listen = `document
  .getElementById("plan")
  .addEventListener("sk-value-change", (event) => {
    console.log(event.detail.value); // ["pro"]
  });`;

const remount = `import { mountFlyout } from "@skryensya/vanilla/flyout";
import { destroyMount } from "@skryensya/vanilla/runtime";

function remountFlyout(root, value) {
  destroyMount(root);
  if (value) root.setAttribute("data-value", value);
  else root.removeAttribute("data-value");
  mountFlyout(root);
}`;

const anatomy = `.sk-flyout[data-sk-flyout][data-value]
  .sk-flyout__label
  .sk-flyout__trigger[data-sk-flyout-trigger]
    .sk-flyout__value[data-sk-flyout-value]
    .sk-flyout__indicator
  .sk-flyout__panel[data-sk-flyout-panel]
    .sk-flyout__item[data-sk-flyout-item][data-value]
      .sk-flyout__item-text
      .sk-flyout__item-indicator`;

const sourceFiles = [
  { id: "contracts/semantic/flyout.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/flyout.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/flyout.css", source: cssSource, language: "css" },
  { id: "packages/vanilla/src/components/flyout.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/vanilla/src/components/flyout.test.ts", source: vanillaTestSource, language: "ts" },
  { id: "packages/react/src/components/flyout.tsx", source: reactSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="Flyout"
  description={t("flyout.description")}
  contractId="flyout"
  sourceFiles={sourceFiles}
  styleGroups={[{ file: "components/flyout.css", probe: "sk-flyout" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/flyout.test.ts",
      tests: [
        { name: "opens on click and keeps ARIA + value text in sync", description: t("flyout.test1") },
        { name: "closes on Escape", description: t("flyout.test2") },
        { name: "keeps only one flyout open at a time", description: t("flyout.test3") },
        {
          name: "flips the panel to inline-start when the end side overflows the viewport",
          description: t("flyout.test4"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("flyout.lede1")} />
    <p set:html={t("flyout.lede2")} />
    <ComponentPreview tree={flyoutTree} label="Flyout" viewport="menu" />

    <h3>{t("flyout.whenTitle")}</h3>
    <ul>
      <li set:html={t("flyout.whenItem1")} />
      <li set:html={t("flyout.whenItem2")} />
    </ul>

    <h3>{t("flyout.behaviorTitle")}</h3>
    <ul>
      <li set:html={t("flyout.behaviorItem1")} />
      <li set:html={t("flyout.behaviorItem2")} />
      <li set:html={t("flyout.behaviorItem3")} />
      <li set:html={t("flyout.behaviorItem4")} />
      <li set:html={t("flyout.behaviorItem5")} />
      <li set:html={t("flyout.behaviorItem6")} />
    </ul>

    <h3>{t("flyout.anatomyTitle")}</h3>
    <CodeBlock code={anatomy} label="parts" />
    <p set:html={t("flyout.anatomyBody")} />

    <h3>{t("flyout.railTitle")}</h3>
    <p set:html={t("flyout.railBody")} />
    <ComponentPreview tree={flyoutRailTree(t)} label={t("flyout.railLabel")} viewport="menu" measure="13.5rem" />

    <h3>{t("flyout.exclusiveTitle")}</h3>
    <p set:html={t("flyout.exclusiveBody")} />
    <ComponentPreview tree={flyoutExclusiveTree(t)} label={t("flyout.exclusiveLabel")} viewport="menu" measure="13.5rem" />

    <h3>{t("flyout.disabledItemTitle")}</h3>
    <p set:html={t("flyout.disabledItemBody")} />
    <ComponentPreview tree={flyoutDisabledItemTree(t)} label={t("flyout.disabledItemLabel")} viewport="menu" />

    <h3>{t("flyout.disabledTitle")}</h3>
    <p set:html={t("flyout.disabledBody")} />
    <ComponentPreview tree={flyoutDisabledTree} label={t("flyout.disabledLabel")} viewport="menu" />

    <h3>{t("flyout.longTitle")}</h3>
    <p set:html={t("flyout.longBody")} />
    <ComponentPreview tree={flyoutLongTree(t)} label={t("flyout.longLabel")} viewport="menu" />

    <h3>{t("flyout.placeholderTitle")}</h3>
    <p set:html={t("flyout.placeholderBody")} />
    <ComponentPreview tree={flyoutPlaceholderTree(t)} label={t("flyout.placeholderLabel")} viewport="menu" />

    <h3>{t("flyout.remountTitle")}</h3>
    <p set:html={t("flyout.remountBody")} />
    <CodeBlock code={remount} label="JavaScript" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("flyout.contractItem1")} />
      <li set:html={t("flyout.contractItem2")} />
      <li set:html={t("flyout.contractItem3")} />
      <li set:html={t("flyout.contractItem4")} />
      <li set:html={t("flyout.contractItem5")} />
      <li set:html={t("flyout.contractItem6")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />

    <h3>{t("flyout.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />

    <h3>{t("flyout.listenTitle")}</h3>
    <CodeBlock code={listen} label="JavaScript" />
  </Fragment>
</ComponentPageShell>
