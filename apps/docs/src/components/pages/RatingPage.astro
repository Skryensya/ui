---
import "@skryensya/core/components/rating.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  ratingAnatomyTree,
  ratingDisplayTree,
  ratingDontInputAverageTree,
  ratingDontNoCountTree,
  ratingFractionsTree,
  ratingInputTree,
  ratingSizesTree,
} from "../../demos/rating";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;

const symbolSwap = `/* The symbol is a mask, so a heart is one declaration. */
.reviews {
  --sk-rating-symbol: url("data:image/svg+xml,%3Csvg …heart… %3E");
}`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`ratingPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Rating"
  description={t("ratingPage.description")}
  contractId="rating"
  styleGroups={[{ file: "components/rating.css", probe: "sk-rating" }]}
  testFiles={[
    "packages/core/src/rating.test.ts",
    "packages/react/src/components/rating.test.tsx",
    "packages/vanilla/src/components/rating.test.ts",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("ratingPage.lede")} />

    <UsagePreview
      tree={ratingDisplayTree(t)}
      optionName="symbolSize"
      title={t("ratingPage.prop.symbolSize.title")}
      description={t("ratingPage.prop.symbolSize.body")}
      explain={explain("symbolSize", ["sm", "md", "lg"])}
      stageMinBlockSize="7rem"
      labels={{ sm: "sm", md: "md", lg: "lg" }}
    />

    <h3>{t("ratingPage.showcaseTitle")}</h3>
    <p set:html={t("ratingPage.showcaseBody")} />
    <UsagePreview tree={ratingDisplayTree(t)} />

    <h3>{t("ratingPage.inputTitle")}</h3>
    <p set:html={t("ratingPage.inputBody")} />
    <UsagePreview tree={ratingInputTree(t)} />

    <h3>{t("ratingPage.fractionTitle")}</h3>
    <p set:html={t("ratingPage.fractionBody")} />
    <UsagePreview tree={ratingFractionsTree(t)} />
    <p set:html={t("ratingPage.asymmetryBody")} />
    <h3>{t("ratingPage.symbolTitle")}</h3>
    <p set:html={t("ratingPage.symbolBody")} />
    <CodeBlock code={symbolSwap} label="CSS" />

    <h3>{t("ratingPage.sizeTitle")}</h3>
    <p set:html={t("ratingPage.sizeBody")} />
    <UsagePreview tree={ratingSizesTree(t)} />

    <p set:html={t("component.reactNote")} />

    <UsagePreview
      tree={variantsTree(ratingInputTree(t), [{ label: t("component.state.default"), options: {} }, { label: t("component.state.readOnly"), options: { readOnly: true } }, { label: t("component.state.disabled"), options: { disabled: true } }])}
      title={t("component.statesTitle")}
      description={t("component.statesBody")}
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("ratingPage.anatomyBody")} />
    <ComponentPreview
      tree={ratingAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("ratingPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("ratingPage.guidelinesLede")} />
    <DoDont
      title={t("ratingPage.dd.count.title")}
      do={{ tree: ratingDisplayTree(t), caption: t("ratingPage.dd.count.do") }}
      dont={{ tree: ratingDontNoCountTree(t), caption: t("ratingPage.dd.count.dont") }}
    />
    <DoDont
      title={t("ratingPage.dd.display.title")}
      do={{ tree: ratingDisplayTree(t), caption: t("ratingPage.dd.display.do") }}
      dont={{ tree: ratingDontInputAverageTree(t), caption: t("ratingPage.dd.display.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("ratingPage.a11yBody")} />
    <p set:html={t("ratingPage.a11yLabelBody")} />
  </Fragment>
</ComponentPageShell>
