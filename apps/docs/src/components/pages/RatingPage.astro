---
import "@skryensya/core/components/rating.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/layout.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  ratingAnatomyTree,
  ratingFiveStepsTree,
  ratingHeartsCss,
  ratingHeartsTree,
  ratingPlaygroundTree,
  ratingProductTree,
  ratingReviewTree,
  ratingTenStepsTree,
  ratingThreeStepsTree,
  ratingDisplayTree,
  ratingDontInputAverageTree,
  ratingDontNoCountTree,
  ratingFractionsTree,
  ratingInputTree,
} from "../../demos/rating";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;

const maxVariants = [
  { value: "3", tree: ratingThreeStepsTree },
  { value: "5", tree: ratingFiveStepsTree },
  { value: "10", tree: ratingTenStepsTree },
].map(({ value, tree }) => ({
  value,
  label: t(`ratingPage.max.${value}` as Parameters<typeof t>[0]),
  tree: tree(t),
  explain: t(`ratingPage.maxExplain.${value}` as Parameters<typeof t>[0]),
}));

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`ratingPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Rating"
  description={t("ratingPage.description")}
  contractId="rating"
  styleGroups={[{ file: "components/rating.css", probe: "sk-rating" }]}
  testFiles={[
    "packages/core/src/rating.test.ts",
    "packages/react/src/components/rating.test.tsx",
    "packages/vanilla/src/components/rating.test.ts",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("ratingPage.lede")} />

    <UsagePreview
      tree={ratingDisplayTree(t)}
      optionName="symbolSize"
      title={t("ratingPage.prop.symbolSize.title")}
      description={t("ratingPage.prop.symbolSize.body")}
      explain={explain("symbolSize", ["sm", "md", "lg"])}
      stageMinBlockSize="7rem"
      labels={{ sm: "sm", md: "md", lg: "lg" }}
    />

    <UsagePreview
      tree={ratingPlaygroundTree(t)}
      optionName="readOnly"
      title={t("ratingPage.readOnlyTitle")}
      description={t("ratingPage.readOnlyBody")}
      labels={{ false: t("ratingPage.readOnly.false"), true: t("ratingPage.readOnly.true") }}
      explain={{ false: t("ratingPage.readOnlyExplain.false"), true: t("ratingPage.readOnlyExplain.true") }}
      stageMinBlockSize="7rem"
    />
    <UsagePreview
      variants={maxVariants}
      initialVariant="5"
      variantsLabel={t("ratingPage.maxLabel")}
      title={t("ratingPage.maxTitle")}
      description={t("ratingPage.maxBody")}
      stageMinBlockSize="7rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={ratingProductTree(t)} title={t("ratingPage.productTitle")} description={t("ratingPage.productBody")} />
    <UsagePreview tree={ratingReviewTree(t)} title={t("ratingPage.reviewTitle")} description={t("ratingPage.reviewBody")} />
    <UsagePreview tree={ratingDisplayTree(t)} title={t("ratingPage.displayTitle")} description={t("ratingPage.displayBody")} />
    <UsagePreview tree={ratingInputTree(t)} title={t("ratingPage.inputTitle")} description={t("ratingPage.inputBody")} />
    <UsagePreview tree={ratingFractionsTree(t)} title={t("ratingPage.fractionTitle")} description={t("ratingPage.fractionBody")} />
    <UsagePreview tree={ratingHeartsTree(t)} css={ratingHeartsCss} title={t("ratingPage.symbolTitle")} description={t("ratingPage.symbolBody")} />
    <UsagePreview
      tree={variantsTree(ratingInputTree(t), [{ label: t("component.state.default"), options: {} }, { label: t("component.state.readOnly"), options: { readOnly: true } }, { label: t("component.state.disabled"), options: { disabled: true } }])}
      title={t("component.statesTitle")}
      description={t("component.statesBody")}
    />


    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "ratingPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("ratingPage.anatomyBody")} />
    <UsagePreview
      tree={ratingAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("ratingPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("ratingPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "ratingPage.when")} avoid={tList(t, "ratingPage.whenNot")} />
    <DoDont
      title={t("ratingPage.dd.count.title")}
      do={{ tree: ratingDisplayTree(t), caption: t("ratingPage.dd.count.do") }}
      dont={{ tree: ratingDontNoCountTree(t), caption: t("ratingPage.dd.count.dont") }}
    />
    <DoDont
      title={t("ratingPage.dd.display.title")}
      do={{ tree: ratingDisplayTree(t), caption: t("ratingPage.dd.display.do") }}
      dont={{ tree: ratingDontInputAverageTree(t), caption: t("ratingPage.dd.display.dont") }}
    />
    <ContentRules items={tList(t, "ratingPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("ratingPage.a11yIntro")}
      does={tList(t, "ratingPage.a11yDoes")}
      yours={tList(t, "ratingPage.a11yYours")}
      keys={[{ keys: ["↑", "↓", "←", "→"], action: t("ratingPage.key.arrows") }]}
    />
  </Fragment>
</ComponentPageShell>
