---
/*
 * THE Lightbox page. The demos are usage trees, so each renders in both bindings from one source; the
 * programmatic API belongs in Storybook/examples, not as long code blocks in this component page.
 *
 * A preview only gets the CSS this page imports (and whatever its slotted children need): the
 * lightbox sheet brings button + loader, the thumbnails need ImageFrame's pattern, and the keyboard
 * table below is an `sk-table`.
 */
import "@skryensya/core/components/lightbox.css";
import "@skryensya/core/patterns/image-frame.css";
import "@skryensya/core/components/table.css";
import CodeBlock from "../CodeBlock.astro";
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { LightboxCardDemo } from "../react-demos/lightbox";
import "@skryensya/core/components/annotation.css";
/* Do/Don't specimens use the same small surface as other comparisons. */
import "@skryensya/core/patterns/box.css";
import {
  lightboxCaptionTree,
  lightboxDemoCss,
  lightboxDoCaptionDdTree,
  lightboxDoCardDdTree,
  lightboxDoGalleryDdTree,
  lightboxDontImageOnlyDdTree,
  lightboxDontNoCaptionDdTree,
  lightboxDontStaticDdTree,
  lightboxGalleryTree,
  lightboxLoopTree,
  lightboxSingleTree,
  lightboxTinyTree,
} from "../../demos/lightbox";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const cardDemoImages = [
  {
    src: "/demos/lightbox/fjord.jpg",
    thumbnailSrc: "/demos/lightbox/fjord-thumb.jpg",
    alt: t("lightbox.demo.dawnAlt"),
    title: t("lightbox.demo.dawnTitle"),
    description: t("lightbox.demo.dawnDescription"),
    credit: "Alexey Topolyanskiy · Unsplash",
    width: 1800,
    height: 1200,
  },
  {
    src: "/demos/lightbox/coast.jpg",
    thumbnailSrc: "/demos/lightbox/coast-thumb.jpg",
    alt: t("lightbox.demo.panoramaAlt"),
    title: t("lightbox.demo.panoramaTitle"),
    description: t("lightbox.demo.panoramaDescription"),
    credit: "Paul Jarvis · Unsplash",
    width: 1800,
    height: 1200,
  },
];

const install = `pnpm add @skryensya/core @skryensya/react
# or, for authored HTML
pnpm add @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/components/lightbox.css";
@import "@skryensya/core/patterns/scroll-lock.css";
@import "@skryensya/core/patterns/visually-hidden.css";`;

---

<ComponentPageShell
  title="Lightbox"
  description={t("lightbox.description")}
  contractId="lightbox"
  testFiles={[
    "packages/core/src/lightbox.test.ts",
    "packages/vanilla/src/components/lightbox.test.ts",
    "packages/react/src/components/lightbox.test.tsx",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("lightbox.lede")} />

    <h3>{t("component.examplesTitle")}</h3>

    <h3>{t("lightbox.galleryTitle")}</h3>
    <p set:html={t("lightbox.galleryBody")} />
    <UsagePreview
      tree={lightboxGalleryTree(t)}
      css={lightboxDemoCss}
      label={t("lightbox.demo.galleryLabel")}
      stageMinBlockSize="24rem"
      storybookTitle="Components/Overlays/Lightbox"
      storybookStory="Gallery"
    />

    <h3>{t("lightbox.cardTitle")}</h3>
    <p set:html={t("lightbox.cardBody")} />
    <LightboxCardDemo
      client:visible
      action={t("lightbox.cardAction")}
      body={t("lightbox.cardCopy")}
      closeLabel={t("lightbox.closeLabel")}
      counterLabel={t("lightbox.counterLabel")}
      errorLabel={t("lightbox.errorLabel")}
      images={cardDemoImages}
      label={t("lightbox.demo.label")}
      nextLabel={t("lightbox.nextLabel")}
      previousLabel={t("lightbox.previousLabel")}
      resetZoomLabel={t("lightbox.resetZoomLabel")}
      title={t("lightbox.cardDemoTitle")}
      zoomInLabel={t("lightbox.zoomInLabel")}
      zoomOutLabel={t("lightbox.zoomOutLabel")}
    />

    <h3>{t("lightbox.singleTitle")}</h3>
    <p set:html={t("lightbox.singleBody")} />
    <UsagePreview
      tree={lightboxSingleTree(t)}
      css={lightboxDemoCss}
      label={t("lightbox.singleTitle")}
      stageMinBlockSize="24rem"
      storybookTitle="Components/Overlays/Lightbox"
      storybookStory="Single"
    />

    <h3>{t("lightbox.captionTitle")}</h3>
    <p set:html={t("lightbox.captionBody")} />
    <UsagePreview
      tree={lightboxCaptionTree(t)}
      css={lightboxDemoCss}
      label={t("lightbox.captionTitle")}
      stageMinBlockSize="24rem"
      storybookTitle="Components/Overlays/Lightbox"
      storybookStory="Caption"
    />

    <h3>{t("lightbox.tinyTitle")}</h3>
    <p set:html={t("lightbox.tinyBody")} />
    <UsagePreview
      tree={lightboxTinyTree(t)}
      css={lightboxDemoCss}
      label={t("lightbox.tinyTitle")}
      stageMinBlockSize="24rem"
      storybookTitle="Components/Overlays/Lightbox"
      storybookStory="Tiny"
    />

    <h3>{t("lightbox.loopTitle")}</h3>
    <p set:html={t("lightbox.loopBody")} />
    <UsagePreview
      tree={lightboxLoopTree(t)}
      css={lightboxDemoCss}
      label={t("lightbox.loopTitle")}
      stageMinBlockSize="24rem"
      storybookTitle="Components/Overlays/Lightbox"
      storybookStory="Loop"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "lightbox.contract").map((item) => <li set:html={item} />)}
    </ul>

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("lightbox.guidelinesLede")} />
    <WhenToUse use={tList(t, "lightbox.when")} avoid={tList(t, "lightbox.whenNot")} />
    <DoDont
      title={t("lightbox.dd.card.title")}
      do={{ tree: lightboxDoCardDdTree(t), caption: t("lightbox.dd.card.do") }}
      dont={{ tree: lightboxDontImageOnlyDdTree(t), caption: t("lightbox.dd.card.dont") }}
    />
    <DoDont
      title={t("lightbox.dd.gallery.title")}
      do={{ tree: lightboxDoGalleryDdTree(t), caption: t("lightbox.dd.gallery.do") }}
      dont={{ tree: lightboxDontStaticDdTree(t), caption: t("lightbox.dd.gallery.dont") }}
    />
    <DoDont
      title={t("lightbox.dd.caption.title")}
      do={{ tree: lightboxDoCaptionDdTree(t), caption: t("lightbox.dd.caption.do") }}
      dont={{ tree: lightboxDontNoCaptionDdTree(t), caption: t("lightbox.dd.caption.dont") }}
    />
    <ContentRules items={tList(t, "lightbox.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("lightbox.a11yIntro")}
      does={tList(t, "lightbox.a11yDoes")}
      yours={tList(t, "lightbox.a11yYours")}
      keys={[
        { keys: ["Esc"], action: t("lightbox.key.escape") },
        { keys: ["Tab", "Shift+Tab"], action: t("lightbox.key.tab") },
        { keys: ["←", "→"], action: t("lightbox.key.arrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("lightbox.key.homeEnd") },
        { keys: ["+", "-"], action: t("lightbox.key.zoom") },
        { keys: ["0"], action: t("lightbox.key.reset") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
