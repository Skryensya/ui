---
/* Without this the preview frame copies zero `.sk-list*` rules (a preview frame only ever inherits
   the stylesheets ITS OWN page loaded), so every demo below fell back to a bare, bulleted `<ul>`. */
import "@skryensya/core/components/list.css";
/* Trailing Badge in the anatomy specimen (and step 4 / full demos) needs its own sheet. */
import "@skryensya/core/components/badge.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  listAnatomyTree,
  listDontParagraphsTree,
  listFullTree,
  listLeadingTree,
  listLinksTree,
  listPlainTree,
  listTitledTree,
  listTrailingTree,
} from "../../demos/list";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
/* Both link demos point at real docs routes, and a docs route differs per locale. */
const LINK_HREFS = ["/prerequisites", "/first-component", "/presets", "/reference", "/tiers"];
const TEAM_HREFS = ["/equipo/john-doe", "/equipo/jane-doe", "/equipo/richard-roe", "/equipo/mary-major"];

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const styles = `@import "@skryensya/core/components/list.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`listPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="List"
  description={t("listPage.description")}
  contractId="list"
  testFiles={["packages/react/src/components/list.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("listPage.lede")} />

    <UsagePreview
      tree={listPlainTree(t)}
      optionName="dividers"
      title={t("listPage.prop.dividers.title")}
      description={t("listPage.prop.dividers.body")}
      explain={explain("dividers", ["false", "true"])}
      stageMinBlockSize="14rem"
      labels={{ false: t("listPage.prop.dividers.falseLabel"), true: t("listPage.prop.dividers.trueLabel") }}
    />

    <h3>{t("listPage.showcaseTitle")}</h3>
    <p set:html={t("listPage.showcaseBody")} />
    <h3>{t("listPage.stepsTitle")}</h3>
    <p set:html={t("listPage.stepsBody")} />

    <h4>{t("listPage.step1Title")}</h4>
    <p set:html={t("listPage.step1Body")} />
    <ComponentPreview tree={listPlainTree(t)} label={t("listPage.step1Title")} note={t("listPage.step1Note")} />

    <h4>{t("listPage.step2Title")}</h4>
    <p set:html={t("listPage.step2Body")} />
    <ComponentPreview tree={listTitledTree(t)} label={t("listPage.step2Title")} note={t("listPage.step2Note")} measure="34rem" />

    <h4>{t("listPage.step3Title")}</h4>
    <p set:html={t("listPage.step3Body")} />
    <ComponentPreview tree={listLeadingTree(t)} label={t("listPage.step3Title")} note={t("listPage.step3Note")} measure="34rem" />

    <h4>{t("listPage.step4Title")}</h4>
    <p set:html={t("listPage.step4Body")} />
    <ComponentPreview tree={listTrailingTree(t)} label={t("listPage.step4Title")} note={t("listPage.step4Note")} measure="34rem" />

    <h4>{t("listPage.step5Title")}</h4>
    <p set:html={t("listPage.step5Body")} />
    <ComponentPreview tree={listLinksTree(t, LINK_HREFS)} label={t("listPage.step5Title")} note={t("listPage.step5Note")} measure="34rem" />

    <h4>{t("listPage.step6Title")}</h4>
    <p set:html={t("listPage.step6Body")} />
    <ComponentPreview tree={listFullTree(t, TEAM_HREFS)} label={t("listPage.step6Title")} note={t("listPage.step6Note")} measure="34rem" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("listPage.contractItem1")} />
      <li set:html={t("listPage.contractItem2")} />
      <li set:html={t("listPage.contractItem3")} />
      <li set:html={t("listPage.contractItem4")} />
      <li set:html={t("listPage.contractItem5")} />
      <li set:html={t("listPage.contractItem6")} />
      <li set:html={t("listPage.contractItem7")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("listPage.anatomyBody")} />
    <ComponentPreview
      tree={listAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("listPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("listPage.guidelinesLede")} />
    <DoDont
      title={t("listPage.dd.short.title")}
      do={{ tree: listPlainTree(t), caption: t("listPage.dd.short.do") }}
      dont={{ tree: listDontParagraphsTree(t), caption: t("listPage.dd.short.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>

<style is:global>
  /* A list is sized by its host: with no width, the stage is flex and each `<ul>` shrinks to the width
     of its longest row, so the six examples came out at different widths and step 1 ended up at 77px.
     The demo lends it the width a real column would have; the code shows the markup without that width,
     which belongs to the consumer.
     `is:global`: the authored HTML lives inside the srcdoc and does not carry Astro's scope attribute. */
  .sk-list-demo {
    inline-size: min(100%, 34rem);
  }
</style>
