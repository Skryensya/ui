---
/* Without this the preview frame copies zero `.sk-list*` rules (a preview frame only ever inherits
   the stylesheets ITS OWN page loaded), so every demo below fell back to a bare, bulleted `<ul>`. */
import "@skryensya/core/components/list.css";
/* Trailing Badge in the anatomy specimen (and step 4 / full demos) needs its own sheet. */
import "@skryensya/core/components/badge.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  listAnatomyTree,
  listDoComparableTrailingTree,
  listDoSameShapeTree,
  listDontBuriedValuesTree,
  listDontMixedShapeTree,
  listDontParagraphsTree,
  listFullTree,
  listLeadingTree,
  listLinksTree,
  listPlainTree,
  listTitledTree,
  listTrailingTree,
} from "../../demos/list";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

/* The reading measure the old previews set with `measure`: a list row wider than this reads as a table. */
const listMeasureCss = `.sk-list { max-inline-size: 34rem; margin-inline: auto; }`;
const t = useTranslations(getLocale(Astro.url));
const measured = <T extends { attrs?: Record<string, unknown> }>(tree: T): T => ({
  ...tree,
  attrs: { ...tree.attrs, style: `${typeof tree.attrs?.style === "string" ? `${tree.attrs.style} ` : ""}inline-size: min(100%, 34rem);` },
});
/* Both link demos point at real docs routes, and a docs route differs per locale. */
const LINK_HREFS = ["/prerequisites", "/first-component", "/presets", "/reference", "/tiers"];
const TEAM_HREFS = ["/equipo/john-doe", "/equipo/jane-doe", "/equipo/richard-roe", "/equipo/mary-major"];

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const styles = `@import "@skryensya/core/components/list.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`listPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="List"
  description={t("listPage.description")}
  contractId="list"
  testFiles={["packages/react/src/components/list.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("listPage.lede")} />

    <UsagePreview
      tree={listPlainTree(t)}
      optionName="dividers"
      title={t("listPage.prop.dividers.title")}
      description={t("listPage.prop.dividers.body")}
      explain={explain("dividers", ["false", "true"])}
      stageMinBlockSize="14rem"
      labels={{ false: t("listPage.prop.dividers.falseLabel"), true: t("listPage.prop.dividers.trueLabel") }}
    />

    <h3>{t("component.examplesTitle")}</h3>
    <p set:html={t("listPage.stepsBody")} />
    <UsagePreview tree={listPlainTree(t)} css={listMeasureCss} title={t("listPage.step1Title")} description={t("listPage.step1Body")} />
    <UsagePreview tree={listTitledTree(t)} css={listMeasureCss} title={t("listPage.step2Title")} description={t("listPage.step2Body")} />
    <UsagePreview tree={listLeadingTree(t)} css={listMeasureCss} title={t("listPage.step3Title")} description={t("listPage.step3Body")} />
    <UsagePreview tree={listTrailingTree(t)} css={listMeasureCss} title={t("listPage.step4Title")} description={t("listPage.step4Body")} />
    <UsagePreview tree={listLinksTree(t, LINK_HREFS)} css={listMeasureCss} title={t("listPage.step5Title")} description={t("listPage.step5Body")} />
    <UsagePreview tree={listFullTree(t, TEAM_HREFS)} css={listMeasureCss} title={t("listPage.step6Title")} description={t("listPage.step6Body")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "listPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("listPage.anatomyBody")} />
    <UsagePreview tree={listAnatomyTree(t)} css={annotationDemoCss} label={t("listPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("listPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "listPage.when")} avoid={tList(t, "listPage.whenNot")} />
    <DoDont
      title={t("listPage.dd.short.title")}
      do={{ tree: measured(listTitledTree(t)), caption: t("listPage.dd.short.do") }}
      dont={{ tree: measured(listDontParagraphsTree(t)), caption: t("listPage.dd.short.dont") }}
    />
    <DoDont
      title={t("listPage.dd.shape.title")}
      do={{ tree: measured(listDoSameShapeTree(t)), caption: t("listPage.dd.shape.do") }}
      dont={{ tree: measured(listDontMixedShapeTree(t)), caption: t("listPage.dd.shape.dont") }}
    />
    <DoDont
      title={t("listPage.dd.trailing.title")}
      do={{ tree: measured(listDoComparableTrailingTree(t)), caption: t("listPage.dd.trailing.do") }}
      dont={{ tree: measured(listDontBuriedValuesTree(t)), caption: t("listPage.dd.trailing.dont") }}
    />
    <ContentRules items={tList(t, "listPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes
      intro={t("listPage.a11yIntro")}
      does={tList(t, "listPage.a11yDoes")}
      yours={tList(t, "listPage.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("listPage.a11yKeyTab") },
        { keys: ["Enter"], action: t("listPage.a11yKeyEnter") },
      ]}
    />
  </Fragment>
</ComponentPageShell>

<style is:global>
  /* A list is sized by its host: with no width, the stage is flex and each `<ul>` shrinks to the width
     of its longest row, so the six examples came out at different widths and step 1 ended up at 77px.
     The demo lends it the width a real column would have; the code shows the markup without that width,
     which belongs to the consumer.
     `is:global`: the authored HTML lives inside the srcdoc and does not carry Astro's scope attribute. */
  .sk-list-demo {
    inline-size: min(100%, 34rem);
  }
</style>
