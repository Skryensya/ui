---
import "@skryensya/core/components/app-bar.css";
import "@skryensya/core/components/menu.css";
import "@skryensya/core/patterns/state-layer.css";
/* Structure diagram: the Annotated specimen is drawn by Annotation's own sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  appBarDoDropdownHtml,
  appBarDontDropdownHtml,
  appBarDoAppMenuTree,
  appBarDoShortStatusTree,
  appBarDoShortTitlesTree,
  appBarDontLongStatusTree,
  appBarDontLongTitlesTree,
  appBarDontNoAppMenuTree,
  appBarMinimalTree,
  appBarTree,
} from "../../demos/app-bar";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `@import "@skryensya/core/components/app-bar.css";
@import "@skryensya/core/patterns/state-layer.css";`;
const storybookTitle = "Components/Actions/AppBar";

const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`appBarPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="AppBar"
  description={t("appBarPage.description")}
  contractId="app-bar"
  styleGroups={[
    { file: "components/app-bar.css", probe: "sk-app-bar", title: "AppBar" },
    { file: "patterns/state-layer.css", probe: "sk-interactive", title: "Heredados de State layer" },
  ]}
  testFiles={["packages/core/src/app-bar.test.ts", "packages/react/src/components/app-bar.test.tsx", "packages/vanilla/src/components/app-bar.svelte.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("appBarPage.lede")} />

    <UsagePreview
      tree={appBarMinimalTree(t)}
      optionName="strong"
      target={["children", 0]}
      title={t("appBarPage.prop.strong.title")}
      description={t("appBarPage.prop.strong.body")}
      explain={explain("strong", ["false", "true"])}
      storybookTitle={storybookTitle}
      storybookStory="Minimal"
    />

    <h3>{t("component.examplesTitle")}</h3>

    <UsagePreview
      tree={appBarTree(t)}
      title={t("appBarPage.fullTitle")}
      description={t("appBarPage.fullBody")}
      stageMinBlockSize="16rem"
      storybookTitle={storybookTitle}
      storybookStory="Default"
    />

    <UsagePreview
      tree={appBarMinimalTree(t)}
      title={t("appBarPage.minimalTitle")}
      description={t("appBarPage.minimalBody")}
      stageMinBlockSize="12rem"
      storybookTitle={storybookTitle}
      storybookStory="Minimal"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "appBarPage.contract").map((item) => <li set:html={item} />)}
    </ul>

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("appBarPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "appBarPage.when")} avoid={tList(t, "appBarPage.whenNot")} />

    <DoDont
      canvas
      title={t("appBarPage.dd.status.title")}
      do={{ tree: appBarDoShortStatusTree(t), caption: t("appBarPage.dd.status.do") }}
      dont={{ tree: appBarDontLongStatusTree(t), caption: t("appBarPage.dd.status.dont") }}
    />
    <DoDont
      canvas
      title={t("appBarPage.dd.appMenu.title")}
      do={{ tree: appBarDoAppMenuTree(t), caption: t("appBarPage.dd.appMenu.do") }}
      dont={{ tree: appBarDontNoAppMenuTree(t), caption: t("appBarPage.dd.appMenu.dont") }}
    />
    <DoDont
      canvas
      title={t("appBarPage.dd.titles.title")}
      do={{ tree: appBarDoShortTitlesTree(t), caption: t("appBarPage.dd.titles.do") }}
      dont={{ tree: appBarDontLongTitlesTree(t), caption: t("appBarPage.dd.titles.dont") }}
    />
    <DoDont
      title={t("appBarPage.dd.dropdown.title")}
      do={{ html: appBarDoDropdownHtml(t), caption: t("appBarPage.dd.dropdown.do") }}
      dont={{ html: appBarDontDropdownHtml(t), caption: t("appBarPage.dd.dropdown.dont") }}
    />

    <ContentRules items={tList(t, "appBarPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("appBarPage.a11yIntro")}
      does={tList(t, "appBarPage.a11yDoes")}
      yours={tList(t, "appBarPage.a11yYours")}
      keysNote={t("appBarPage.a11yKeysNote")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("appBarPage.a11yKeyTab") },
        { keys: ["←", "→"], action: t("appBarPage.a11yKeyArrows") },
        { keys: ["Enter", t("component.key.space"), "↓"], action: t("appBarPage.a11yKeyOpen") },
        { keys: ["Esc"], action: t("appBarPage.a11yKeyEsc") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
