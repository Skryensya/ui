---
/*
 * THE Dialog page: one component, both locales, on `ComponentPageShell`. The shape
 * `AccordionPage` piloted. The two route files that remain (`pages/componentes/dialog.astro`,
 * `pages/en/components/dialog.astro`) are shells for the same reason Accordion's are: the URLs
 * differ per locale, the content does not.
 *
 * The old per-locale copies had drifted (the English one hardcoded its own prose instead of going
 * through `t()`, and was missing the hero, the tabs, and the Referencia/Style hooks/Cambios
 * panels), which is exactly the failure mode `t()` + one shell exists to close off.
 */
import "@skryensya/core/components/dialog.css";
import "@skryensya/core/patterns/dialog-vaul.css";
import "@skryensya/core/components/list.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import CodeBlock from "../CodeBlock.astro";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import UsagePreview from "../UsagePreview.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import DoDont from "../DoDont.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  dialogAnatomyCss,
  dialogAnatomyTree,
  dialogConfirmScript,
  dialogConfirmTree,
  dialogClearConfirmTree,
  dialogUnsavedChangesTree,
  dialogInviteTree,
  dialogRevokeAccessTree,
  dialogVagueTree,
  dialogLongTaskTree,
  dialogNoticeTree,
  dialogVaulScript,
  dialogVaulTree,
} from "../../demos/dialog";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const confirmJs = `const dialog = document.getElementById("confirm-borrar");
const trigger = document.querySelector(
  '[data-dialog-open="confirm-borrar"]',
);

trigger?.addEventListener("click", () => {
  if (dialog instanceof HTMLDialogElement) dialog.showModal();
});

// ${t("dialog.confirmJsComment")}
dialog?.addEventListener("close", () => {
  console.log(dialog.returnValue); // "cancel" | "confirm"
});`;

const install = `pnpm add @skryensya/core`;
const styles = `@import "@skryensya/core/components/dialog.css";
@import "@skryensya/core/patterns/scroll-lock.css";`;

const vaulInstall = `pnpm add @skryensya/core @skryensya/vanilla`;
const vaulStyles = `@import "@skryensya/core/components/dialog.css";
@import "@skryensya/core/patterns/dialog-vaul.css";
@import "@skryensya/core/patterns/scroll-lock.css";`;
const vaulJs = `import { initComponents } from "@skryensya/vanilla/auto";

await initComponents();`;
---

<ComponentPageShell
  title="Dialog"
  description={t("dialog.description")}
  contractId="dialog"
  appearanceTargetSelector=".sk-dialog"
  styleGroups={[
    { file: "components/dialog.css", probe: "sk-dialog", title: "Dialog" },
    { file: "patterns/dialog-vaul.css", probe: "data-sk-dialog-vaul", title: "Dialog Vaul" },
  ]}
  testFiles={["packages/react/src/components/dialog.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("dialog.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    {/* ComponentPreviews, not UsagePreviews: each opens a modal, and a frame of its own keeps the
        dialog from taking over this page. */}
    <h3>{t("dialog.confirmTitle")}</h3>
    <p set:html={t("dialog.confirmAnatomy")} />
    <UsagePreview tree={dialogConfirmTree(t)} script={dialogConfirmScript} label="Confirm" viewport="overlay" />
    <h3>{t("dialog.vaulTitle")}</h3>
    <p set:html={t("dialog.vaulIntro")} />
    <UsagePreview tree={dialogVaulTree(t)} script={dialogVaulScript} label="Dialog Vaul" viewport="overlay" />

    <h3>{t("dialog.openingTitle")}</h3>
    <CodeBlock code={confirmJs} label="JavaScript" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "dialog.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("dialog.anatomyBody")} />
    <UsagePreview tree={dialogAnatomyTree(t)} css={dialogAnatomyCss} label={t("dialog.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("dialog.guidelinesLede")} />
    <WhenToUse use={tList(t, "dialog.when")} avoid={tList(t, "dialog.whenNot")} />
    <ContentRules items={tList(t, "dialog.content")} />
    <DoDont
      title={t("dialog.dd.clear.title")}
      do={{ tree: dialogClearConfirmTree(t), caption: t("dialog.dd.clear.do") }}
      dont={{ tree: dialogVagueTree(t), caption: t("dialog.dd.clear.dont") }}
    />
    <DoDont
      title={t("dialog.dd.focus.title")}
      do={{ tree: dialogUnsavedChangesTree(t), caption: t("dialog.dd.focus.do") }}
      dont={{ tree: dialogUnsavedChangesTree(t, false), caption: t("dialog.dd.focus.dont") }}
    />
    <DoDont
      title={t("dialog.dd.scope.title")}
      do={{ tree: dialogInviteTree(t), caption: t("dialog.dd.scope.do") }}
      dont={{ tree: dialogLongTaskTree(t), caption: t("dialog.dd.scope.dont") }}
    />
    <DoDont
      title={t("dialog.dd.interruption.title")}
      do={{ tree: dialogRevokeAccessTree(t), caption: t("dialog.dd.interruption.do") }}
      dont={{ tree: dialogNoticeTree(t), caption: t("dialog.dd.interruption.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />

    <h3>{t("dialog.vaulInstallTitle")}</h3>
    <CodeBlock code={vaulInstall} label="terminal" />
    <CodeBlock code={vaulStyles} label="CSS" lang="css" />
    <CodeBlock code={vaulJs} label="JavaScript" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("dialog.a11yIntro")}
      does={tList(t, "dialog.a11yDoes")}
      yours={tList(t, "dialog.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("dialog.a11yKeyTab") },
        { keys: ["Esc"], action: t("dialog.a11yKeyEsc") },
      ]}
    />
  </Fragment>

  <Fragment slot="style">
    <h3>{t("dialog.borderTitle")}</h3>
    <p set:html={t("dialog.borderBody")} />
  </Fragment>
</ComponentPageShell>
