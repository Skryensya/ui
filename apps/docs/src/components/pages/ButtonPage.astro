---
import "@skryensya/core/components/tile.css";
/* Structure diagram: the Annotated specimen below is drawn by Annotation's own sheet, and a preview
   frame only ever copies the styles ITS page loaded, so it has to land here too. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  buttonAnatomyTree,
  buttonAppearanceTree,
  buttonAsLinkTree,
  buttonBrutalistMatrixTree,
  buttonBrutalistRadiusTree,
  buttonBrutalistShapesTree,
  buttonBrutalistStatesCss,
  buttonBrutalistStatesTree,
  buttonFrostedBackdropsTree,
  buttonFrostedMatrixTree,
  buttonFrostedRadiusTree,
  buttonFrostedShapesTree,
  buttonFrostedStatesTree,
  buttonDefaultTree,
  buttonDestructivePairTree,
  buttonIconOnlyTree,
  buttonIconTree,
  buttonVariantTree,
  tileButtonTree,
  buttonDoCostTree,
  buttonDoHardDeleteTree,
  buttonDontHardDeleteTree,
  buttonDoOnePrimaryTree,
  buttonDoPrimaryLastTree,
  buttonDontAmbiguousIconTree,
  buttonDontOkTree,
  buttonDontPrimaryFirstTree,
  buttonDontTwoPrimaryTree,
} from "../../demos/button";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`button.prop.${option}.${value}` as Parameters<typeof t>[0])]));
/* The link demo points at a real docs page, and that page's path differs per locale, which is
   what this resolves: a Spanish reader clicking the demo used to land on the English page. */
const LINK_HREF = "https://example.com/news";
const storybookTitle = "Components/Actions/Button";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// ${t("button.iconsComment").split("\n").join("\n// ")}
mountIcons(document, lucideIcons);

await initComponents();`;

const tileButtonVanilla = `import { createTileButton } from "@skryensya/vanilla/tile-button";

const button = createTileButton();
button.textContent = "Run deployment";
button.addEventListener("click", runDeployment);`;
---

<ComponentPageShell
  title="Button"
  description={t("button.description")}
  contractId="button"
  appearanceTargetSelector="[data-sk-button], .sk-tile--interactive[data-appearance]"
  testFiles={["packages/react/src/components/button.test.tsx", "packages/vanilla/src/components/button.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("button.lede")} />

    <UsagePreview
      tree={buttonDefaultTree(t)}
      optionName="variant"
      title={t("button.prop.variant.title")}
      description={t("button.prop.variant.body")}
      explain={explain("variant", ["solid", "soft", "ghost"])}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={buttonDefaultTree(t)}
      optionName="tone"
      title={t("button.prop.tone.title")}
      description={t("button.prop.tone.body")}
      explain={explain("tone", ["neutral", "accent", "danger"])}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={buttonDefaultTree(t)}
      optionName="size"
      title={t("button.prop.size.title")}
      description={t("button.prop.size.body")}
      explain={explain("size", ["xs", "sm", "md", "lg"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview
      tree={buttonDefaultTree(t)}
      title={t("button.defaultTitle")}
      description={t("button.defaultBody")}
      storybookTitle={storybookTitle}
      storybookStory="Default"
    />
    <UsagePreview
      tree={buttonIconTree(t)}
      title={t("button.iconTitle")}
      description={t("button.iconBody")}
      storybookTitle={storybookTitle}
      storybookStory="Icon"
    />
    <UsagePreview
      tree={buttonIconOnlyTree(t)}
      title={t("button.iconOnlyTitle")}
      description={t("button.iconOnlyBody")}
      storybookTitle={storybookTitle}
      storybookStory="IconOnly"
    />
    <UsagePreview
      tree={buttonVariantTree(t)}
      title={t("button.variantsTitle")}
      description={t("button.variantsBody")}
      storybookTitle={storybookTitle}
      storybookStory="Variant"
    />
    <UsagePreview
      tree={buttonDestructivePairTree(t)}
      title={t("button.destructiveTitle")}
      description={t("button.destructiveBody")}
      storybookTitle={storybookTitle}
      storybookStory="DestructivePair"
    />
    <UsagePreview
      tree={buttonAsLinkTree(t, LINK_HREF)}
      title={t("button.linkTitle")}
      description={t("button.linkBody")}
      storybookTitle={storybookTitle}
      storybookStory="AsLink"
    />
    <UsagePreview tree={tileButtonTree(t)} title={t("button.tileTitle")} description={t("button.tileBody")} />
    <CodeBlock code={tileButtonVanilla} label="JavaScript" />

    {/* Comparisons of appearances: the page-wide appearance switch must not repaint them. */}
    <div data-docs-appearance-fixed>
    <UsagePreview
      tree={buttonAppearanceTree(t)}
      title={t("button.appearanceTitle")}
      description={t("button.appearanceBody")}
    />
    <UsagePreview
      tree={buttonBrutalistMatrixTree(t)}
      title={t("button.brutalistMatrixTitle")}
      description={t("button.brutalistMatrixBody")}
    />
    <UsagePreview
      tree={buttonBrutalistRadiusTree(t)}
      title={t("button.brutalistRadiusTitle")}
      description={t("button.brutalistRadiusBody")}
    />
    <UsagePreview
      tree={buttonBrutalistStatesTree(t)}
      title={t("button.brutalistStatesTitle")}
      description={t("button.brutalistStatesBody")}
      css={buttonBrutalistStatesCss}
    />
    <UsagePreview
      tree={buttonBrutalistShapesTree(t, LINK_HREF)}
      title={t("button.brutalistShapesTitle")}
      description={t("button.brutalistShapesBody")}
    />
    <UsagePreview
      tree={buttonFrostedBackdropsTree(t)}
      title={t("button.frostedTitle")}
      description={t("button.frostedBody")}
    />
    <UsagePreview
      tree={buttonFrostedMatrixTree(t)}
      title={t("button.frostedMatrixTitle")}
      description={t("button.frostedMatrixBody")}
    />
    <UsagePreview
      tree={buttonFrostedRadiusTree(t)}
      title={t("button.frostedDetailsTitle")}
      description={t("button.frostedDetailsBody")}
    />
    <UsagePreview tree={buttonFrostedStatesTree(t)} />
    <UsagePreview tree={buttonFrostedShapesTree(t, LINK_HREF)} />
    </div>

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "button.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("button.anatomyBody")} />
    <UsagePreview tree={buttonAnatomyTree(t)} css={annotationDemoCss} label={t("button.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("button.guidelinesLede")} />
    <WhenToUse use={tList(t, "button.when")} avoid={tList(t, "button.whenNot")} />
    <DoDont
      title={t("button.dd.primary.title")}
      do={{ tree: buttonDoOnePrimaryTree(t), caption: t("button.dd.primary.do") }}
      dont={{ tree: buttonDontTwoPrimaryTree(t), caption: t("button.dd.primary.dont") }}
    />
    <DoDont
      title={t("button.dd.cost.title")}
      do={{ tree: buttonDoCostTree(t), caption: t("button.dd.cost.do") }}
      dont={{ tree: buttonDontOkTree(t), caption: t("button.dd.cost.dont") }}
    />
    <DoDont
      title={t("button.dd.hardDelete.title")}
      do={{ tree: buttonDoHardDeleteTree(t), caption: t("button.dd.hardDelete.do") }}
      dont={{ tree: buttonDontHardDeleteTree(t), caption: t("button.dd.hardDelete.dont") }}
    />
    <DoDont
      title={t("button.dd.icon.title")}
      do={{ tree: buttonIconTree(t), caption: t("button.dd.icon.do") }}
      dont={{ tree: buttonDontAmbiguousIconTree(t), caption: t("button.dd.icon.dont") }}
    />
    <DoDont
      title={t("button.dd.order.title")}
      do={{ tree: buttonDoPrimaryLastTree(t), caption: t("button.dd.order.do") }}
      dont={{ tree: buttonDontPrimaryFirstTree(t), caption: t("button.dd.order.dont") }}
    />
    <ContentRules items={tList(t, "button.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />

    <h3>{t("button.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("button.a11yIntro")}
      does={tList(t, "button.a11yDoes")}
      yours={tList(t, "button.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("button.a11yKeyTab") },
        { keys: ["Enter"], action: t("button.a11yKeyEnter") },
        { keys: [t("component.key.space")], action: t("button.a11yKeySpace") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
