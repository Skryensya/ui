---
import "@skryensya/core/components/tile.css";
/* Structure diagram: the Annotated specimen below is drawn by Annotation's own sheet, and a preview
   frame only ever copies the styles ITS page loaded, so it has to land here too. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  buttonAnatomyTree,
  buttonAppearanceTree,
  buttonAsLinkTree,
  buttonBrutalistMatrixTree,
  buttonBrutalistRadiusTree,
  buttonBrutalistShapesTree,
  buttonBrutalistStatesCss,
  buttonBrutalistStatesTree,
  buttonFrostedBackdropsTree,
  buttonFrostedMatrixTree,
  buttonFrostedRadiusTree,
  buttonFrostedShapesTree,
  buttonFrostedStatesTree,
  buttonDefaultTree,
  buttonDestructivePairTree,
  buttonIconOnlyTree,
  buttonIconTree,
  buttonSizesTree,
  buttonVariantTree,
  tileButtonTree,
} from "../../demos/button";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
/* The link demo points at a real docs page, and that page's path differs per locale, which is
   what this resolves: a Spanish reader clicking the demo used to land on the English page. */
const LINK_HREF = "https://example.com/news";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// ${t("button.iconsComment").split("\n").join("\n// ")}
mountIcons(document, lucideIcons);

await initComponents();`;

const tileButtonVanilla = `import { createTileButton } from "@skryensya/vanilla/tile-button";

const button = createTileButton();
button.textContent = "Run deployment";
button.addEventListener("click", runDeployment);`;
---

<ComponentPageShell
  title="Button"
  description={t("button.description")}
  contractId="button"
  appearanceTargetSelector="[data-sk-button], .sk-tile--interactive[data-appearance]"
  testFiles={["packages/react/src/components/button.test.tsx", "packages/vanilla/src/components/button.test.ts"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="anatomy">
    <p set:html={t("button.anatomyBody")} />
    <ComponentPreview
      tree={buttonAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("button.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("button.lede")} />
    <h3>{t("button.defaultTitle")}</h3>
    <p set:html={t("button.defaultBody")} />
    <ComponentPreview tree={buttonDefaultTree(t)} label={t("button.defaultLabel")} />

    <h3>{t("button.sizesTitle")}</h3>
    <ComponentPreview tree={buttonSizesTree(t)} label={t("button.sizesLabel")} />
    <h3>{t("button.iconTitle")}</h3>
    <p set:html={t("button.iconBody")} />
    <ComponentPreview tree={buttonIconTree(t)} label={t("button.iconLabel")} />

    <h3>{t("button.iconOnlyTitle")}</h3>
    <ComponentPreview tree={buttonIconOnlyTree(t)} label={t("button.iconOnlyLabel")} />

    <h3>{t("button.variantsTitle")}</h3>
    <p set:html={t("button.variantsBody")} />
    <ComponentPreview tree={buttonVariantTree(t)} label={t("button.variantsLabel")} />

    <h3>{t("button.destructiveTitle")}</h3>
    <p set:html={t("button.destructiveBody")} />
    <ComponentPreview tree={buttonDestructivePairTree(t)} label={t("button.destructiveLabel")} />

    <h3>{t("button.linkTitle")}</h3>
    <p set:html={t("button.linkBody")} />
    <ComponentPreview tree={buttonAsLinkTree(t, LINK_HREF)} label={t("button.linkLabel")} />

    <h3>{t("button.appearanceTitle")}</h3>
    <p set:html={t("button.appearanceBody")} />
    {/* Comparisons of appearances: the page-wide appearance switch must not repaint them. */}
    <div data-docs-appearance-fixed>
      <ComponentPreview tree={buttonAppearanceTree(t)} label={t("button.appearanceLabel")} />

      <h4>{t("button.brutalistMatrixTitle")}</h4>
      <p set:html={t("button.brutalistMatrixBody")} />
      <ComponentPreview tree={buttonBrutalistMatrixTree(t)} label={t("button.brutalistMatrixLabel")} />

      <h4>{t("button.brutalistRadiusTitle")}</h4>
      <p set:html={t("button.brutalistRadiusBody")} />
      <ComponentPreview tree={buttonBrutalistRadiusTree(t)} label={t("button.brutalistRadiusLabel")} />

      <h4>{t("button.brutalistStatesTitle")}</h4>
      <p set:html={t("button.brutalistStatesBody")} />
      <ComponentPreview tree={buttonBrutalistStatesTree(t)} css={buttonBrutalistStatesCss} label={t("button.brutalistStatesLabel")} />

      <h4>{t("button.brutalistShapesTitle")}</h4>
      <p set:html={t("button.brutalistShapesBody")} />
      <ComponentPreview tree={buttonBrutalistShapesTree(t, LINK_HREF)} label={t("button.brutalistShapesLabel")} />

      <h4>{t("button.frostedTitle")}</h4>
      <p set:html={t("button.frostedBody")} />
      <ComponentPreview tree={buttonFrostedBackdropsTree(t)} label={t("button.frostedBackdropsLabel")} />

      <h4>{t("button.frostedMatrixTitle")}</h4>
      <p set:html={t("button.frostedMatrixBody")} />
      <ComponentPreview tree={buttonFrostedMatrixTree(t)} label={t("button.frostedMatrixLabel")} />

      <h4>{t("button.frostedDetailsTitle")}</h4>
      <p set:html={t("button.frostedDetailsBody")} />
      <ComponentPreview tree={buttonFrostedRadiusTree(t)} label={t("button.frostedRadiusLabel")} />
      <ComponentPreview tree={buttonFrostedStatesTree(t)} label={t("button.frostedStatesLabel")} />
      <ComponentPreview tree={buttonFrostedShapesTree(t, LINK_HREF)} label={t("button.frostedShapesLabel")} />
    </div>

    <h3>{t("button.tileTitle")}</h3>
    <p set:html={t("button.tileBody")} />
    <ComponentPreview tree={tileButtonTree(t)} label={t("button.tileLabel")} />
    <CodeBlock code={tileButtonVanilla} label="JavaScript" />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />

    <h3>{t("button.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />
  </Fragment>
</ComponentPageShell>
