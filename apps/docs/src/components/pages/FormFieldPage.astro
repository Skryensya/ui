---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { formFieldAroundSelectTree, formFieldTree } from "../../demos/form-field";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/form-field.yaml?raw";
import coreSource from "@core/src/form-field.ts?raw";
import cssSource from "@core/css/components/form-field.css?raw";
import reactSource from "@react/src/components/form-field.tsx?raw";
import reactTestSource from "@react/src/components/form-field.test.tsx?raw";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));

const css = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/form-field.css";`;

const sourceFiles = [
  { id: "contracts/semantic/form-field.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/form-field.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/form-field.css", source: cssSource, language: "css" },
  { id: "packages/react/src/components/form-field.tsx", source: reactSource, language: "tsx" },
  { id: "packages/react/src/components/form-field.test.tsx", source: reactTestSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title={t("formFieldPage.title")}
  description={t("formFieldPage.description")}
  contractId="form-field"
  sourceFiles={sourceFiles}
  styleGroups={[{ file: "components/form-field.css", probe: "sk-form-field", title: "FormField" }]}
  tests={[
    {
      file: "packages/react/src/components/form-field.test.tsx",
      tests: [
        { name: "wires the label, hint and error to the control it wraps", description: t("formFieldPage.test1") },
        { name: "treats the error message as what makes the field invalid", description: t("formFieldPage.test2") },
        { name: "passes required and disabled down to the native control", description: t("formFieldPage.test3") },
        { name: "wires a textarea exactly as it wires an input", description: t("formFieldPage.test4") },
        { name: "passes axe on a field with a hint and an error", description: t("formFieldPage.test5") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("formFieldPage.lede")} />
    <ComponentPreview tree={formFieldTree(t)} label="FormField" />

    <h3>{t("formFieldPage.wiringTitle")}</h3>
    <p set:html={t("formFieldPage.wiringBody")} />

    <h3>{t("formFieldPage.independentTitle")}</h3>
    <p set:html={t("formFieldPage.independentBody")} />
    <ComponentPreview tree={formFieldAroundSelectTree(t)} label="FormField + Select" />

    <h3>{t("formFieldPage.errorTitle")}</h3>
    <p set:html={t("formFieldPage.errorBody")} />

    <h3>{t("formFieldPage.avoidTitle")}</h3>
    <p set:html={t("formFieldPage.avoidBody")} />

    <p set:html={t("formFieldPage.reactBody")} />
    <p set:html={t("component.reactNote")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("formFieldPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
