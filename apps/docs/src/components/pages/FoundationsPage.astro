---
import "@skryensya/core/components/badge.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/layout.css";
import Base from "../../layouts/Base.astro";
import IndexHero from "../IndexHero.astro";
import { getLocale, useTranslations } from "../../i18n";
import { iconMarkup } from "../../icons";
import { foundationGroups } from "../../lib/foundation-catalog";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const groups = foundationGroups(locale);
const arrow = iconMarkup("chevron-right", { size: "sm" });
---

<Base title={t("foundationsPage.title")} description={t("foundationsPage.description")} documentLayout="grid">
  <IndexHero title={t("foundationsPage.title")} description={t("foundationsPage.lede")}>
  <div class="foundations-index">

    <div class="foundations-index__groups sk-stack" data-gap="xl">
      {groups.map((group) => (
        <section aria-labelledby={group.headingId} data-foundation-group={group.id}>
          <header class="foundations-index__group-header sk-stack" data-gap="xs">
            <h2 class="sk-heading" data-size="h3" data-flush id={group.headingId}>{group.group}</h2>
            {group.blurb && <p class="sk-text" data-size="sm" data-tone="secondary">{group.blurb}</p>}
          </header>

          <ul class="sk-list" role="list">
            {group.items.map((item) => (
              <li class="sk-list__item" data-foundation-entry>
                <a href={item.href} class="sk-list__action sk-interactive">
                  <span class="sk-list__content">
                    <span class="sk-list__title">{item.label}</span>
                    <span class="sk-list__description">{item.description}</span>
                  </span>
                  <span class="sk-list__trailing">
                    {item.trailing && <span class="sk-badge" data-size="sm" data-tone="warning">{item.trailing}</span>}
                    <Fragment set:html={arrow} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
  </IndexHero>
</Base>

<style>
  .foundations-index__group-header {
    margin-block-end: var(--space-stack-sm);
  }

  .sk-list {
    --sk-list-title-font-size: var(--font-size-body);
    --sk-list-description-font-size: var(--font-size-body-sm);
    --sk-list-row-padding-y: var(--space-inset-md);
  }
</style>
