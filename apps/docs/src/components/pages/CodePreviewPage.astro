---
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/switch.css";
import "@skryensya/core/components/code-preview.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { codePreviewAnatomyCss, codePreviewAnatomyTree, codePreviewDontLabelTree, codePreviewTree } from "../../demos/code-preview";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const storybookTitle = "Components/Content/CodePreview";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`codePreview.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const install = `pnpm add shiki @skryensya/core @skryensya/vanilla`;

const styles = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/copy-button.css";
@import "@skryensya/core/components/switch.css";
@import "@skryensya/core/components/code-preview.css";`;

const highlight = `import { codeToHtml } from "shiki";

// ${t("codePreview.highlightComment")}
const highlighted = await codeToHtml(source, {
  lang: "ts",
  themes: {
    light: "github-light",
    dark: "github-dark",
  },
});`;

const mount = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountCodePreview } from "@skryensya/vanilla/code-preview";

// ${t("codePreview.mountComment1")}
await initComponents();

// ${t("codePreview.mountComment2")}
mountCodePreview();`;

const example = `const registrations = [
  { selector: "[data-sk-button]", load: () => import("./button.js") },
  { selector: "[data-sk-select]", load: () => import("./select.js") },
];`;
import { codePreviewInlineDoTree, codePreviewInlineDontTree } from "../../demos/dodont-more";
---

<ComponentPageShell
  title="CodePreview"
  description={t("codePreview.description")}
  contractId="code-preview"
  appearanceTargetSelector=".sk-code-preview"
  testFiles={["packages/vanilla/src/components/code-preview.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("codePreview.lede")} />

    <UsagePreview
      tree={codePreviewTree(t)}
      optionName="collapsible"
      title={t("codePreview.prop.collapsible.title")}
      description={t("codePreview.prop.collapsible.body")}
      explain={explain("collapsible", ["false", "true"])}
      storybookTitle={storybookTitle}
      storybookStory="Default"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={codePreviewTree(t)} title={t("codePreview.exampleTitle")} description={t("codePreview.exampleBody")} storybookTitle={storybookTitle} storybookStory="Default" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "codePreview.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("codePreview.highlightTitle")}</h3>
    <CodeBlock code={highlight} label="TypeScript" lang="ts" />

    <h3>{t("codePreview.mountTitle")}</h3>
    <p set:html={t("codePreview.mountBody")} />
    <CodeBlock code={mount} label="TypeScript" lang="ts" />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("codePreview.anatomyBody")} />
    <UsagePreview
      tree={codePreviewAnatomyTree(t)}
      css={codePreviewAnatomyCss}
      label={t("codePreview.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("codePreview.guidelinesLede")} />
    <WhenToUse use={tList(t, "codePreview.when")} avoid={tList(t, "codePreview.whenNot")} />
    <DoDont
      title={t("codePreview.dd.label.title")}
      do={{ tree: codePreviewTree(t), caption: t("codePreview.dd.label.do") }}
      dont={{ tree: codePreviewDontLabelTree(t), caption: t("codePreview.dd.label.dont") }}
    />
    <DoDont
      title={t("dd3.codePreview.title")}
      do={{ tree: codePreviewInlineDoTree(t), caption: t("dd3.codePreview.do") }}
      dont={{ tree: codePreviewInlineDontTree(t), caption: t("dd3.codePreview.dont") }}
    />
    <ContentRules items={tList(t, "codePreview.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("codePreview.a11yIntro")}
      does={tList(t, "codePreview.a11yDoes")}
      yours={tList(t, "codePreview.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("codePreview.a11yKeyTab") },
        { keys: ["Enter", t("component.key.space")], action: t("codePreview.a11yKeyEnter") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
