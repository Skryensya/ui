---
/* The anatomy diagram is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import { layoutAnatomyFillCss, wrapperAnatomyTree } from "../../demos/layout-anatomy";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  wrapperDoBoxTree,
  wrapperDontPaintTree,
  wrapperTree,
} from "../../demos/wrapper";
import { getLocale, tList, useTranslations } from "../../i18n";
/* The sheet itself, not only its source: the Style hooks table resolves each hook
   against a real element, and a page that never loads `patterns/wrapper.css` would show every
   value blank. */
import "@skryensya/core/patterns/wrapper.css";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
---

<ComponentPageShell
  title="Wrapper"
  description={t("wrapperPage.description")}
  contractId="wrapper"
  styleGroups={[{ file: "patterns/wrapper.css", probe: "sk-wrapper" }]}
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        { name: "renders Wrapper as a page column on the size scale", description: t("wrapperPage.test1") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("wrapperPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={wrapperTree(t)} title={t("wrapperPage.ceilingTitle")} description={t("wrapperPage.ceilingBody")} flush />

    <h3>{t("wrapperPage.tableTitle")}</h3>
    <div class="sk-table-scroll">
    <table class="sk-table">
      <thead class="sk-table__head"><tr class="sk-table__row"><th class="sk-table__header">{t("wrapperPage.tableHeadSize")}</th><th class="sk-table__header">{t("wrapperPage.tableHeadCeiling")}</th></tr></thead>
      <tbody class="sk-table__body">
        <tr class="sk-table__row"><td class="sk-table__cell"><code>sm</code></td><td class="sk-table__cell">{t("wrapperPage.tableRow1")}</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell"><code>md</code></td><td class="sk-table__cell">{t("wrapperPage.tableRow2")}</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell"><code>lg</code></td><td class="sk-table__cell">{t("wrapperPage.tableRow3")}</td></tr>
        <tr class="sk-table__row"><td class="sk-table__cell"><code>full</code></td><td class="sk-table__cell">{t("wrapperPage.tableRow4")}</td></tr>
      </tbody>
    </table>
    </div>

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "wrapperPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("wrapperPage.anatomyBody")} />
    <UsagePreview
      tree={wrapperAnatomyTree(t)}
      css={layoutAnatomyFillCss}
      label={t("wrapperPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("wrapperPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "wrapperPage.when")} avoid={tList(t, "wrapperPage.whenNot")} />
    <DoDont
      canvas
      title={t("wrapperPage.dd.surface.title")}
      do={{ tree: wrapperDoBoxTree(t), caption: t("wrapperPage.dd.surface.do") }}
      dont={{ tree: wrapperDontPaintTree(t), caption: t("wrapperPage.dd.surface.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes intro={t("wrapperPage.a11yIntro")} does={tList(t, "wrapperPage.a11yDoes")} yours={tList(t, "wrapperPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
