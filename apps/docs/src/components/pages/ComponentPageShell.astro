---
/*
 * Component page frame: masthead, tabs and generated panels over one `<h1>`. The masthead is the
 * only content inside `.docs-component-head`; the tab strip and every page panel are siblings under
 * `.docs-component-shell`, so the "head" class does not own the whole document. Pulled out of
 * `AccordionPage.astro`, which piloted the shape, so a second component page does not have to
 * re-copy the hero, tablist and `hasChanges` wiring to get it (see
 * `apps/docs/src/scripts/hero-tabs-toc.ts` for the ToC half of this contract: it skips each panel's
 * own first heading and starts the rail one level down).
 *
 * Referencia and Cambios are wired automatically from `contractId`: a page cannot describe an
 * option the compiled contract does not also carry, because both are the one artifact
 * `contract-reference.ts` reads (see `ContractReference`, `ContractChangelog`). `usage`, `install`
 * and `a11y` stay named slots because their content is prose only a person can write.
 *
 * Install, Style hooks and Accesibilidad are OPTIONAL, the same reasoning `hasChanges` already
 * used for Cambios: most of the smaller primitives (Box, Badge…) have nothing to install beyond
 * the package, no styling hooks published yet, or no accessibility note beyond what their contract
 * already states, and a tab that always opens on "nothing yet" trains a reader to stop clicking it.
 *
 * `contractId` is ALSO optional, for the handful of pages that survey several components at once
 * (Primitivas) or that document a composition pattern with no contract of its own (Card): there is
 * no single compiled artifact for "Box + Wrapper + ImageFrame + Stack + Inline + Grid" to read a
 * Referencia tab from, so that tab (and Cambios, which reads the same manifest) simply does not
 * render. The contract-level prose these pages already carried stays exactly where every other
 * page keeps ITS un-compiled contract notes: inside the Uso slot, under `component.contractNotesTitle`.
 */
import Base from "../../layouts/Base.astro";
import ContractChangelog from "../ContractChangelog.astro";
import ContractReference from "../ContractReference.astro";
import StylingHooks, { type HookGroup } from "../StylingHooks.astro";
import { getContract } from "@skryensya/core/registry";
import TestCoverage, { type TestGroup } from "../TestCoverage.astro";
import { changelogFor } from "../../lib/contract-reference";
import { findComponentIconMarkup } from "../../lib/component-icons";
import { getLocale, useTranslations } from "../../i18n";
import CodeBlock from "../CodeBlock.astro";
import { vanillaMountFor } from "../../lib/vanilla-mounts";

interface Props {
  title: string;
  description: string;
  /** The contract id, as `packages/core` declares it and the manifest keys it. Omit for a page that
   *  surveys several contracts at once or documents a pattern with none of its own: Referencia and
   *  Cambios drop out rather than reading a contract that does not describe the page. */
  contractId?: string;
  styleGroups?: readonly HookGroup[];
  /** One-line-per-test summaries, grouped by test file. Omit while a component has none curated yet. */
  tests?: readonly TestGroup[];
  /**
   * Test files whose rows are DERIVED rather than quoted. The newer of the two shapes: a page names
   * paths and every `it()` the file declares becomes a row, so a reworded title can never turn into a
   * silent "not run" clock. Either prop lights the tab; a page uses one or the other.
   */
  testFiles?: readonly string[];
  hideVanillaMount?: boolean;
  /** Short status word next to the title ("Beta"). Omit for every page whose contract has settled;
   *  this is a per-page callout, not the catalog's own maturity axis (see `navigation.ts`'s
   *  `status`), so adding it here never lights up any other page. */
  badge?: string;
}

const {
  title,
  description,
  contractId,
  styleGroups = [],
  tests = [],
  testFiles,
  hideVanillaMount = true,
  badge,
} = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const hasContract = Boolean(contractId);
const hasChanges = contractId ? changelogFor(contractId).length > 0 : false;
const hasInstall = Astro.slots.has("install");

/*
 * The styling-hooks table is DERIVED from the contract when a page does not say otherwise.
 *
 * A `HookGroup` is a stylesheet and the class that scopes it at runtime, and a contract already
 * declares both: `css` names the sheet, `parts.root` names the class. 49 pages were passing the
 * same two strings back by hand, which is one more copy of "which sheet is this component's" to
 * keep in step, and `lib/tokens.ts` kept a third in its `PROBES` map.
 *
 * A page still wins when it passes `styleGroups` itself, and 18 do: a page that documents several
 * component surfaces at once needs one group per surface, and Meter deliberately probes
 * `sk-meter` rather than its contract's `sk-meter-group` root.
 */
const derivedStyleGroups: readonly HookGroup[] = (() => {
  if (styleGroups.length > 0 || !contractId) return styleGroups;
  const contract = getContract(contractId);
  const probe = contract?.parts.root;
  if (!contract || !probe) return styleGroups;
  return [{ file: contract.css.replace(/^@skryensya\/core\//, ""), probe }];
})();

/*
 * INSTALLATION IS ONE PANEL WITH TWO HALVES, and the reader picks which one they are reading.
 *
 * The `install` slot is the REACT half. That is not a new convention, it is the one the site already
 * had: ~98 component pages open their install slot with `pnpm add @skryensya/core @skryensya/react`
 * and a stylesheet import, and three of them then stacked the Vanilla story underneath, so a React
 * reader scrolled past mount seams they will never call and a Vanilla reader read an npm line for a
 * package they are not installing. Naming the halves lets the page show one.
 *
 * THE SWITCH IS THE PREVIEWS' SWITCH. It writes the same document-level preference every
 * ComponentPreview's binding tabs write (`data-sk-component-preview-pref` on `<html>`, seeded before
 * first paint by `Base.astro` and persisted by `scripts/docs-binding.ts`), so flipping a demo to
 * React changes what this tab says, and flipping this tab changes every demo. One question, asked
 * once per reader rather than once per tab.
 */
const hasVanillaInstall = Astro.slots.has("installVanilla");

/*
 * THE VANILLA HALF IS GENERATED WHEN A PAGE DOES NOT WRITE ONE, from the two facts the shell
 * already holds: the sheets this component needs (`derivedStyleGroups`, itself derived from the
 * contract) and whether the route owns an enhancer (`vanillaMountFor`). Eighteen do; the rest are
 * native controls and CSS-only modules whose Vanilla story really is "install core, import the
 * sheet, write the markup", and spelling that out by hand on eighty pages is how eighty pages come
 * to disagree about it.
 *
 * A page that needs to say more passes `installVanilla` and this is skipped entirely.
 */
const vanillaMount = vanillaMountFor(Astro.url.pathname);
const vanillaInstallCommand = "pnpm add @skryensya/core";
const vanillaStyleImports = derivedStyleGroups
  .map((group) => `@import "@skryensya/core/${group.file}";`)
  .join("\n");
const vanillaMountSnippet = vanillaMount
  ? `import { ${vanillaMount.mount} } from "${vanillaMount.entrypoint}";\n\n${vanillaMount.mount}();`
  : null;

/* Nothing to switch between when the page has no React half to begin with. */
const canToggleInstall = hasInstall && (hasVanillaInstall || vanillaStyleImports.length > 0 || vanillaMountSnippet);

const hasStyle = derivedStyleGroups.length > 0 || Astro.slots.has("style");
const hasAnatomy = Astro.slots.has("anatomy");
const hasA11y = Astro.slots.has("a11y");
const hasTests = tests.length > 0 || (testFiles?.length ?? 0) > 0;

/*
 * THE SAME GLYPH THE READER CLICKED TO GET HERE. The sidebar row, the drawer row and the catalogue
 * card already carry it; repeating it in the masthead is what closes that trail, so arriving on the
 * page confirms the row rather than starting over at a bare title.
 *
 * Nullable on purpose, via `findComponentIconMarkup` rather than the throwing `componentIconMarkup`:
 * a handful of pages under this shell are not one component (Primitivas surveys six, Card documents
 * a composition), and those have no glyph to be right about. The catalogue is where a missing entry
 * is a build error; here it is simply a title with no mark.
 */
const markMarkup = findComponentIconMarkup(Astro.url.pathname, { className: "docs-component-hero__mark" });
---

<Base title={title} description={description} documentLayout="grid" hideVanillaMount={hideVanillaMount}>
  {/*
   * ONE GRID ITEM AROUND HERO AND TABS, and it exists for exactly one reason: `position: sticky`.
   *
   * `<main>` is a `.sk-layout-grid`, and `layout.css` gives every direct child its own implicit row
   * (`.sk-layout-grid > * { grid-column: content-start / content-end }`). A sticky grid item is
   * confined to its own grid AREA, so a sticky hero sitting directly under `<main>` would have a
   * one-row containing block and scroll away exactly like a static one. The property would be a
   * no-op.
   *
   * This shell gives the hero the tall containing block. `docs-component-head` is deliberately only
   * the masthead markup now; it no longer owns the tab system or every page panel. It is
   * `display: contents` in CSS so the sticky hero is constrained by this shell, not by that short
   * masthead wrapper.
   *
   * Nothing else moves. The panels stay inside `.sk-tabs`, and the scripts that wire this shell
   * reach the tabs through `closest("[data-sk-tabs]")` and `:scope >` from that root
   * (`hero-tabs-toc.ts:16`, `hero-tabs-url.ts:30`).
   */}
  <div class="docs-component-shell">
    <div class="docs-component-head">
      {/*
       * THE TALL HALF OF THE BAND, and the reason it is a box of its own rather than padding on the
       * header: the header's LAYOUT height has to stay constant while the band appears to shrink.
       *
       * Shrinking the header for real was measured and is wrong. The tab strip below it rises at the
       * scroll's rate PLUS whatever height the header gives back, so it reaches its own pinned top
       * roughly twice as fast as the band closes and spends the difference hidden underneath it. At
       * 1400px the strip was pinned at 100px with the band's edge still at 173. The only collapse
       * range that avoids it is 24px, which is too short to read as anything but a snap.
       *
       * So the height that goes away is here, in a box that simply scrolls off, and the header keeps
       * one constant height: the small bar. It is EXACTLY as tall as the scroll distance the collapse
       * takes, which is what keeps the two halves in step.
       *
       * Empty and presentational. It has no text to hide from a screen reader, and it finishes the
       * same accent-tinted band the header paints.
       */}
      <div class="docs-component-hero__spacer sk-fx-collapse-header__spacer"></div>

      {/*
       * The component's mark, in the band's top corner. A SIBLING of the hero, not a child of it:
       * `.docs-component-head` is `display: contents`, so this lands directly inside
       * `.docs-component-shell`, which is the box whose top edge is the band's top (the hero itself
       * is only ever the collapsed bar). Decorative, and out of the flow, so it can never be what
       * sets the band's height; see `.docs-component-hero__mark`.
       */}
      {markMarkup && <Fragment set:html={markMarkup} />}

      {/*
       * THE HERO'S OWN BACKING PLATE, a real sibling rather than a pseudo-element INSIDE the hero:
       * nothing can paint behind an element's own `background` within its own stacking context, not
       * even a `z-index: -1` child (that only outranks the hero's other CHILDREN, the title and the
       * badge, never the hero's own fill). The hero's bottom corners are rounded, so its own background
       * clips to the curve and the small triangle the curve does not cover shows whatever paints
       * BEHIND the hero in the surrounding page instead, real scrolling content once the hero is
       * pinned (see this element's own CSS for how that was confirmed live). A same-rect, square,
       * canvas-coloured sibling sitting just under the hero in stacking gives that triangle something
       * constant and correct to reveal, so the corner stays visibly rounded instead of reading as a
       * plain square once notch and card are painted the same colour (also tried, also live: matching
       * the hero's own blue erased the curve rather than fixing it, since a same-colour notch and
       * card are pixel-identical). Empty and `aria-hidden`: it carries no content of its own to hide
       * from a screen reader, it is paint.
       */}
      <div aria-hidden="true" class="docs-component-hero__backing"></div>

      <header class="docs-component-hero sk-fx-collapse-header">
        {/*
         * PLAIN MARKUP, not the Breadcrumb contract: that was tried (a real `nav`/`ol`/`li` trail that
         * flipped into an inline "Componentes / Accordion" row once collapsed) and undone. The morph
         * itself read as the wrong kind of attention on scroll. `--sk-fx-collapse-progress` (the
         * `collapse-header` effect, ADR-20) still drives the eyebrow, just toward CLOSED now rather
         * than toward a second layout: see its rule in site.css.
         */}
        <p class="docs-component-hero__eyebrow">{t("section.components")}</p>
        <div class="docs-component-hero__title-row">
          <h1>{title}</h1>
          {badge && (
            <span class="sk-badge docs-component-hero__badge" data-tone="warning">{badge}</span>
          )}

        </div>

          {/*
            * THE PAGE'S ONE BINDING SWITCH, and the masthead is where it belongs because the
            * question is about the page. Every preview used to carry its own copy, so a page with a
            * dozen demos asked the reader the same thing a dozen times and the Installation tab
            * asked it a thirteenth; and because the preference was shared all along, answering any
            * one of them moved all the others, which is a control that looks per-demo and is not.
            *
            * ALWAYS RENDERED, not gated on the page having React demos. The preference is global
            * (`data-sk-component-preview-pref` on `<html>`, persisted): it decides what the
            * Installation tab says here and what every preview shows on the next page too, so a page
            * whose own demos happen to be Vanilla-only is still a place a reader may want to set it.
            *
            * A SIBLING OF THE TITLE ROW, NOT AN ITEM IN IT, and positioned against the header
            * itself (site.css). The collapse interpolates the title's TYPE rather than transforming
            * the band, so a switch laid out beside the heading rode its shrinking line box: measured
            * across the collapse it drifted 25px down and 8px across while the reader scrolled. The
            * header's own box is a constant 66px at every scroll position, so anchoring to that
            * holds the switch still.
            *
            * `data-sk-segmented` and the docs hook on one node, the doubling the previews used: the
            * site's global enhancer runs the widget and `scripts/page-binding.ts` only listens for
            * the `sk:segmentedvaluechange` it dispatches.
            */}
          <div
            class="sk-segmented docs-component-hero__binding"
            data-sk-segmented
            data-sk-page-binding-tabs
            data-value="vanilla"
            role="radiogroup"
            aria-label={t("install.bindingGroup")}
          >
            <span class="sk-segmented__indicator" aria-hidden="true" />
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-value="vanilla"
              type="button"
              role="radio"
            >
              Vanilla
            </button>
            <button
              class="sk-segmented__option sk-interactive"
              data-sk-segmented-option
              data-value="react"
              type="button"
              role="radio"
            >
              React
            </button>
          </div>

        {/* Head FOUC already wrote the preference on `<html>`; this only keeps the pill from flipping
            Vanilla -> React once the Segmented enhancer arrives. */}
        <script is:inline>
          (function () {
            var pref = document.documentElement.getAttribute("data-sk-component-preview-pref") || "vanilla";
            var tabs = document.querySelector("[data-sk-page-binding-tabs]");
            if (!tabs) return;
            tabs.setAttribute("data-value", pref);
            tabs.querySelectorAll("[data-sk-segmented-option]").forEach(function (option) {
              option.setAttribute("aria-checked", option.getAttribute("data-value") === pref ? "true" : "false");
            });
          })();
        </script>
      </header>
    </div>
    <div class="sk-tabs" data-orientation="horizontal" data-activation-mode="automatic" data-value="usage" data-sk-tabs>
      <div class="sk-tabs__list docs-component-hero-tabs" data-sk-tabs-list aria-label={t("component.tabsAriaLabel", { name: title })}>
        <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="usage" type="button">{t("component.tabUsage")}</button>
        {
          hasContract && (
            <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="contract" type="button">
              {t("contract.tab")}
            </button>
          )
        }
        {
          hasStyle && (
            <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="style" type="button">
              {t("component.tabStyle")}
            </button>
          )
        }
        {
          hasA11y && (
            <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="a11y" type="button">
              {t("component.tabA11y")}
            </button>
          )
        }
        {
          hasTests && (
            <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="tests" type="button">
              {t("component.tabTests")}
            </button>
          )
        }
        {
          hasChanges && (
            <button class="sk-tabs__trigger sk-interactive" data-sk-tabs-trigger data-value="changes" type="button">
              {t("changelog.tab")}
            </button>
          )
        }
      </div>

      <div class="sk-tabs__content sk-layout-grid" data-sk-tabs-content data-value="usage">
        {/* Visually hidden: the tab strip right above already says "Uso"/"Usage" out loud. Exists so
            the document outline has a real h2 to hang the slot's h3s off of. */}
        <h2 class="sk-visually-hidden">{t("component.tabUsage")}</h2>
        <slot name="usage" />

        {/*
          * INSTALLATION CLOSES THE USAGE PANEL rather than owning a tab of its own.
          *
          * The two were always read in one order: what the component is and what it looks like, then
          * how to put it in your project. A tab made that a second navigation the reader had to know
          * about, and it split a page that is already short for most primitives (Box, Badge) into two
          * panels where the second was four lines of `pnpm add`. The heading is a real one, so the
          * panel's own rail picks it up and the section is still linkable.
          */}
        {
          hasInstall && (
            <>
            {/*
              * `h3`, not `h2`, and the rail is the reason: `buildHeroTabsToc` collects
              * `:scope > h3, :scope > h4`, so an `h2` here would be a section a reader cannot
              * navigate to  -  which is a real loss now that this stopped being a tab. h3 is also the
              * level the panel's own sections use ("Label", "Dot"), and Installation is their peer.
              * The install content's own headings live inside `.docs-install__half`, so they are not
              * direct children and stay out of the rail exactly as they did when this was a tab.
              */}
            <h3>{t("component.tabInstall")}</h3>

            {/*
              * Both halves are always in the document; `site.css` shows the one the preference names,
              * so switching costs no request and the hidden half stays findable by in-page search.
              *
              * THE ATTRIBUTE IS CONDITIONAL, and that is not tidiness. A page with install prose but
              * no contract and no `styleGroups` (a pattern page, a survey of several components) has
              * no Vanilla half to generate, so it gets no switch  -  and if its one half still wore
              * `data-sk-install-binding="react"`, the stylesheet would hide the whole Installation
              * section from every reader whose preference is Vanilla, which is the default.
              */}
            <div class="docs-install__half" data-sk-install-binding={canToggleInstall ? "react" : undefined}>
              <slot name="install" />
            </div>

            {canToggleInstall && (
            <div class="docs-install__half" data-sk-install-binding="vanilla">
              {hasVanillaInstall ? (
                <slot name="installVanilla" />
              ) : (
                <>
                  <p>{t("install.vanillaGenerated")}</p>
                  <CodeBlock code={vanillaInstallCommand} label="terminal" />
                  {vanillaStyleImports.length > 0 && (
                    <CodeBlock code={vanillaStyleImports} label="CSS" lang="css" />
                  )}
                  {vanillaMountSnippet ? (
                    <>
                      <p set:html={t("install.vanillaMount", { name: vanillaMount!.name })} />
                      <CodeBlock code={vanillaMountSnippet} label="JavaScript" />
                    </>
                  ) : (
                    <p>{t("install.vanillaNoMount")}</p>
                  )}
                </>
              )}
            </div>
            )}
            </>
          )
        }
      </div>

      {
        hasContract && contractId && (
          <div class="sk-tabs__content sk-layout-grid" data-sk-tabs-content data-value="contract">
            {/*
              * THE ANATOMY DIAGRAM OPENS THIS TAB, above the generated reference, because the two are
              * the same information twice and this is the order they are useful in: the drawing names
              * the parts and points at them, the table below then says what each one accepts. In Uso
              * it sat above the demos, where it was answering a question ("what is this made of")
              * that a reader scrolling examples has not asked yet.
              *
              * A SLOT, not something this shell can render: the specimen is composed per page from
              * that component's own demo module, so only the page knows the tree. Pages that have no
              * diagram pass nothing and the panel opens on the reference exactly as before.
              */}
            {hasAnatomy && (
              <>
                {/* A real heading, so the panel's rail has something to list above "Referencia" and
                    the outline does not open on un-headed prose. */}
                <h2>{t("component.anatomy")}</h2>
                <slot name="anatomy" />
              </>
            )}
            <ContractReference id={contractId} />
          </div>
        )
      }

      {
        hasStyle && (
          <div class="sk-tabs__content sk-layout-grid" data-sk-tabs-content data-value="style">
            {derivedStyleGroups.length > 0 && <StylingHooks groups={derivedStyleGroups} />}
            <slot name="style" />
          </div>
        )
      }

      {
        hasA11y && (
          <div class="sk-tabs__content sk-layout-grid" data-sk-tabs-content data-value="a11y">
            <h2>{t("component.tabA11y")}</h2>
            <slot name="a11y" />
          </div>
        )
      }

      {
        hasTests && (
          <div class="sk-tabs__content sk-layout-grid" data-sk-tabs-content data-value="tests">
            <TestCoverage files={testFiles} groups={testFiles ? undefined : tests} hasReference={hasContract} />
          </div>
        )
      }

      {
        hasChanges && contractId && (
          <div class="sk-tabs__content sk-layout-grid" data-sk-tabs-content data-value="changes">
            <ContractChangelog id={contractId} />
          </div>
        )
      }
    </div>
  </div>
</Base>
