---
import "@skryensya/core/components/calendar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { calendarAnatomyTree, calendarMonthAnatomyHtml, calendarYearAnatomyHtml, calendarMinMaxTree, calendarRangeTree, calendarTree } from "../../demos/calendar";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const styles = `@import "@skryensya/core/components/calendar.css";`;
---

<ComponentPageShell
  title="Calendar"
  description={t("calendar.description")}
  badge={t("calendar.betaBadge")}
  contractId="calendar"
  testFiles={["packages/vanilla/src/components/calendar.svelte.test.ts"]}}
>
  <Fragment slot="anatomy">
    <p set:html={t("calendar.anatomyBody")} />
    <ComponentPreview
      tree={calendarAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("calendar.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("calendar.lede")} />
    <p set:html={t("calendar.anatomyMonthBody")} />
    <ComponentPreview
      html={calendarMonthAnatomyHtml(t)}
      css={annotationDemoCss}
      label={t("calendar.anatomyMonthPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <p set:html={t("calendar.anatomyYearBody")} />
    <ComponentPreview
      html={calendarYearAnatomyHtml(t)}
      css={annotationDemoCss}
      label={t("calendar.anatomyYearPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <h3>{t("calendar.gridTitle")}</h3>
    <p set:html={t("calendar.gridBody")} />
    <ComponentPreview tree={calendarTree(t)} label={t("calendar.gridLabel")} viewport="auto" />

    <h3>{t("calendar.viewTitle")}</h3>
    <p set:html={t("calendar.viewBody1")} />
    <p set:html={t("calendar.viewBody2")} />

    <h3>{t("calendar.rangeTitle")}</h3>
    <p set:html={t("calendar.rangeBody1")} />
    <p set:html={t("calendar.rangeBody2")} />
    <ComponentPreview tree={calendarRangeTree(t)} label={t("calendar.rangeLabel")} viewport="auto" />

    <h3>{t("calendar.minMaxTitle")}</h3>
    <p set:html={t("calendar.minMaxBody1")} />
    <p set:html={t("calendar.minMaxBody2")} />
    <ComponentPreview tree={calendarMinMaxTree(t)} label={t("calendar.minMaxLabel")} viewport="auto" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("calendar.contractItem1")} />
      <li set:html={t("calendar.contractItem2")} />
      <li set:html={t("calendar.contractItem3")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("calendar.a11yBody")} />
  </Fragment>
</ComponentPageShell>
