---
import "@skryensya/core/components/calendar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  calendarAnatomyTree,
  calendarLimitsGuideHtml,
  calendarMinMaxTree,
  calendarNoLimitsGuideHtml,
  calendarRangeGuideHtml,
  calendarRangeTree,
  calendarTree,
  calendarTwoGuideHtml,
} from "../../demos/calendar";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla`;
const styles = `@import "@skryensya/core/components/calendar.css";`;
const storybookTitle = "Components/Forms/Calendar";

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`calendar.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Calendar"
  description={t("calendar.description")}
  contractId="calendar"
  testFiles={["packages/vanilla/src/components/calendar.svelte.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("calendar.lede")} />

    <UsagePreview
      tree={calendarTree(t)}
      optionName="selectionMode"
      title={t("calendar.prop.selectionMode.title")}
      description={t("calendar.prop.selectionMode.body")}
      explain={explain("selectionMode", ["single", "range"])}
      stageMinBlockSize="22rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={calendarTree(t)} title={t("calendar.gridTitle")} description={t("calendar.gridBody")} storybookTitle={storybookTitle} storybookStory="Default" />
    <UsagePreview tree={calendarRangeTree(t)} title={t("calendar.rangeTitle")} description={t("calendar.rangeBody1")} storybookTitle={storybookTitle} storybookStory="Range" />
    <UsagePreview tree={calendarMinMaxTree(t)} title={t("calendar.minMaxTitle")} description={t("calendar.minMaxBody1")} storybookTitle={storybookTitle} storybookStory="MinMax" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "calendar.contract").map((item) => <li set:html={item} />)}
    </ul>

    <UsagePreview
      tree={variantsTree(calendarTree(t), [{ label: t("component.state.default"), options: {} }, { label: t("component.state.disabled"), options: { disabled: true } }])}
      title={t("component.statesTitle")}
      description={t("component.statesBody")}
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("calendar.anatomyBody")} />
    <UsagePreview
      tree={calendarAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("calendar.anatomyPreviewLabel")}
      bare
    />


  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("calendar.guidelinesLede")} />
    <WhenToUse use={tList(t, "calendar.when")} avoid={tList(t, "calendar.whenNot")} />
    <DoDont
      title={t("calendar.dd.range.title")}
      do={{ html: calendarRangeGuideHtml(t), caption: t("calendar.dd.range.do") }}
      dont={{ html: calendarTwoGuideHtml(t), caption: t("calendar.dd.range.dont") }}
    />
    <DoDont
      title={t("calendar.dd.limits.title")}
      do={{ html: calendarLimitsGuideHtml(t), caption: t("calendar.dd.limits.do") }}
      dont={{ html: calendarNoLimitsGuideHtml(t), caption: t("calendar.dd.limits.dont") }}
    />
    <ContentRules items={tList(t, "calendar.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("calendar.a11yIntro")}
      does={tList(t, "calendar.a11yDoes")}
      yours={tList(t, "calendar.a11yYours")}
      keys={[
        { keys: ["←", "→", "↑", "↓"], action: t("calendar.a11yKeyArrows") },
        { keys: ["PageUp", "PageDown"], action: t("calendar.a11yKeyPage") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("calendar.a11yKeyHomeEnd") },
        { keys: ["Enter", t("component.key.space")], action: t("calendar.a11yKeyEnter") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
