---
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { getLocale, useTranslations } from "../../i18n";
import cssSource from "@core/css/components/fade-edge.css?raw";
import "@skryensya/core/components/fade-edge.css";
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/avatar.css";
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/scrollbar.css";

const t = useTranslations(getLocale(Astro.url));

const sourceFiles = [
  { id: "packages/core/css/components/fade-edge.css", source: cssSource, language: "css" },
] as const;

/*
 * A real activity feed, seven rows deep: enough that the box (max-height 11rem, ~3 rows visible)
 * has real content to scroll THROUGH, not just a static clip. `overflow-y: auto` on the fade-edge
 * element itself is what makes that legible: `mask-image` paints relative to the element's own box,
 * not its content, so the faded band stays pinned to the edge while rows scroll underneath it  -  the
 * same trick as a `background-attachment: local` gradient, just via the mask layer instead.
 */
const activityItem = (initials: string, palette: string, name: string, action: string, time: string) => `
      <li class="sk-list__item">
        <span class="sk-list__leading">
          <span class="sk-avatar" data-size="sm" aria-label="${name}" style="--sk-avatar-bg: var(--palette-${palette}); --sk-avatar-fg: var(--palette-white);">${initials}</span>
        </span>
        <span class="sk-list__content">
          <span class="sk-list__title">${name}</span>
          <span class="sk-list__description">${action}</span>
        </span>
        <span class="sk-list__trailing">
          <span class="sk-text" data-tone="tertiary" data-size="sm">${time}</span>
        </span>
      </li>`;

const activityRows = [
  activityItem("AL", "blue-600", "Ada Lovelace", 'Comentó en "Rediseño del dashboard"', "2m"),
  activityItem("GH", "emerald-600", "Grace Hopper", "Aprobó el pull request #482", "15m"),
  activityItem("AT", "sky-600", "Alan Turing", 'Creó el ticket "Migrar auth a OAuth2"', "1h"),
  activityItem("MH", "red-600", "Margaret Hamilton", "Cerró 3 issues en el sprint actual", "2h"),
  activityItem("DK", "amber-600", "Donald Knuth", "Subió una nueva build a staging", "5h"),
  activityItem("KP", "emerald-600", "Katherine Johnson", 'Editó la página "Roadmap Q3"', "8h"),
  activityItem("BL", "blue-600", "Barbara Liskov", "Invitó a 2 personas al equipo", "1d"),
].join("");

const fadeBottomHtml = `<div class="sk-box" data-surface="raised" data-border="subtle" data-padding="md" style="inline-size: 22rem;">
  <div class="sk-fade-edge sk-scrollbar" style="max-height: 11rem; overflow-y: auto;">
    <ul class="sk-list" data-dividers="none" aria-label="Actividad reciente">${activityRows}
    </ul>
  </div>
</div>`;

const fadeTopHtml = `<div class="sk-box" data-surface="raised" data-border="subtle" data-padding="md" style="inline-size: 22rem;">
  <div id="fade-top-scroll" class="sk-fade-edge sk-scrollbar" data-direction="to-top" style="max-height: 11rem; overflow-y: auto;">
    <ul class="sk-list" data-dividers="none" aria-label="Actividad reciente, scrolleada hacia abajo">${activityRows}
    </ul>
  </div>
</div>`;

const fadeTopScript = `
const region = document.getElementById("fade-top-scroll");
if (region) region.scrollTop = region.scrollHeight;
`;

const tagRow = `
      <span class="sk-tag">Diseño</span>
      <span class="sk-tag" data-tone="accent">Frontend</span>
      <span class="sk-tag" data-tone="success">Aprobado</span>
      <span class="sk-tag" data-tone="warning">En revisión</span>
      <span class="sk-tag" data-tone="danger">Bloqueado</span>
      <span class="sk-tag">Backend</span>
      <span class="sk-tag">Accesibilidad</span>
      <span class="sk-tag">Performance</span>
      <span class="sk-tag">Documentación</span>
      <span class="sk-tag" data-tone="accent">QA</span>`;

const fadeRightHtml = `<div class="sk-box" data-surface="raised" data-border="subtle" data-padding="md" style="inline-size: 20rem;">
  <div class="sk-fade-edge sk-scrollbar" data-direction="to-right" style="overflow-x: auto;">
    <div class="sk-inline" data-gap="sm" data-wrap="false">${tagRow}
    </div>
  </div>
</div>`;

const fadeLeftHtml = `<div class="sk-box" data-surface="raised" data-border="subtle" data-padding="md" style="inline-size: 20rem;">
  <div id="fade-left-scroll" class="sk-fade-edge sk-scrollbar" data-direction="to-left" style="overflow-x: auto;">
    <div class="sk-inline" data-gap="sm" data-wrap="false">${tagRow}
    </div>
  </div>
</div>`;

const fadeLeftScript = `
const region = document.getElementById("fade-left-scroll");
if (region) region.scrollLeft = region.scrollWidth;
`;

/*
 * The scrim pattern: a photo card whose caption needs to stay legible over whatever the image
 * happens to show. `data-fade="color"` paints an opaque gradient instead of revealing the
 * backdrop, which is the point here  -  there is no flat surface behind the photo to fade into.
 */
const fadeColorHtml = `<div class="sk-box" data-border="subtle" style="inline-size: 20rem; overflow: hidden;">
  <div style="position: relative;">
    <div
      class="sk-fade-edge"
      data-fade="color"
      style="--sk-fade-edge-color: rgb(15 23 42 / 85%); --sk-fade-edge-size: 7rem; block-size: 12rem; background: linear-gradient(135deg, var(--palette-blue-600), var(--palette-sky-400));"
    ></div>
    <div style="position: absolute; inset: auto 0 0 0; padding: var(--space-inset-md);">
      <span class="sk-text" data-size="lg" style="color: white; font-weight: var(--font-weight-label); display: block;">Vista desde el mirador</span>
      <span class="sk-text" data-size="sm" style="color: rgb(255 255 255 / 85%);">Patagonia, Argentina</span>
    </div>
  </div>
</div>`;

/*
 * The intensity control: a real range input driving `--sk-fade-edge-size` live, over the SAME
 * scrollable feed as the first demo. Pixels, not rem, on the input itself  -  `<input type="range">`
 * has no unit, and converting on read (`sync`) keeps the label honest in the unit the CSS variable
 * actually documents.
 */
const fadeIntensityHtml = `<div class="sk-stack" data-gap="md" style="inline-size: 22rem;">
  <div class="sk-box" data-surface="raised" data-border="subtle" data-padding="md">
    <div id="fade-intensity-region" class="sk-fade-edge sk-scrollbar" style="--sk-fade-edge-size: 64px; max-height: 11rem; overflow-y: auto;">
      <ul class="sk-list" data-dividers="none" aria-label="Actividad reciente">${activityRows}
      </ul>
    </div>
  </div>
  <label class="sk-stack" data-gap="xs">
    <span class="sk-text" data-size="sm" data-tone="secondary">Intensidad del desvanecido: <strong id="fade-intensity-value">4.0rem</strong></span>
    <input id="fade-intensity-range" type="range" min="8" max="88" step="4" value="64" style="inline-size: 100%;" aria-label="Ajustar el tamaño del desvanecido" />
  </label>
</div>`;

const fadeIntensityScript = `
const region = document.getElementById("fade-intensity-region");
const range = document.getElementById("fade-intensity-range");
const output = document.getElementById("fade-intensity-value");

function sync() {
  const px = Number(range.value);
  region.style.setProperty("--sk-fade-edge-size", \`\${px}px\`);
  output.textContent = \`\${(px / 16).toFixed(1)}rem\`;
}

range.addEventListener("input", sync);
sync();
`;
---

<ComponentPageShell
  title="FadeEdge"
  description={t("fadeEdge.description")}
  badge={t("fadeEdge.betaBadge")}
  styleGroups={[{ file: "components/fade-edge.css", probe: "sk-fade-edge" }]}
  sourceFiles={sourceFiles}
>
  <Fragment slot="usage">
    <p class="lede">FadeEdge desvanece un borde del contenido, en CSS puro. Dos formas de hacerlo: hacia transparencia, dejando ver lo que hay detrás, o hacia un color determinado, pintando un degradé encima. Úsalo para indicar que hay más contenido por descubrir, en vez de cortarlo de golpe con <code>overflow: hidden</code>.</p>

    <h3>Cuándo usarlo</h3>
    <ul>
      <li>Una lista o feed con scroll, para insinuar que hay más filas por debajo sin una flecha ni un scrollbar grueso</li>
      <li>Una fila de chips o tags que se desborda horizontalmente</li>
      <li>Un párrafo truncado, con un botón "Leer más" flotando sobre el desvanecido</li>
      <li>Contenido que se desplaza detrás de una cabecera fija</li>
    </ul>

    <h3>Fundido hacia abajo</h3>
    <p>Una lista con scroll real y altura acotada: el borde inferior se desvanece para señalar que faltan filas por ver. Desplazate adentro del recuadro  -  el degradé queda fijo en el borde mientras el contenido pasa debajo, así se aprecia el efecto en acción.</p>
    <ComponentPreview html={fadeBottomHtml} label="Fade to bottom" />

    <h3>Fundido hacia arriba</h3>
    <p>El mismo feed, arrancando ya scrolleado hasta el final: lo que falta está arriba, y el degradé lo señala ahí. Subí el scroll para verlo desaparecer.</p>
    <ComponentPreview html={fadeTopHtml} previewScript={fadeTopScript} label="Fade to top" />

    <h3>Fundido hacia la derecha</h3>
    <p>Una fila de tags que no entra en el ancho disponible, con scroll horizontal real. El desvanecido a la derecha avisa que hay más sin necesidad de una flecha visible.</p>
    <ComponentPreview html={fadeRightHtml} label="Fade to right" />

    <h3>Fundido hacia la izquierda</h3>
    <p>La misma fila, arrancando ya scrolleada hasta el final: el desvanecido a la izquierda indica que hay contenido anterior.</p>
    <ComponentPreview html={fadeLeftHtml} previewScript={fadeLeftScript} label="Fade to left" />

    <h3>Fundido a un color determinado</h3>
    <p>Cuando no hay una superficie plana detrás para revelar  -  una foto, por ejemplo  -  <code>data-fade="color"</code> pinta un degradé opaco encima en vez de hacer transparente el contenido. Es el patrón clásico del scrim: un texto legible sobre una imagen, sin importar qué colores tenga la foto.</p>
    <ComponentPreview html={fadeColorHtml} label="Fade a color" />

    <h3>Ajustar la intensidad</h3>
    <p>La variable <code>--sk-fade-edge-size</code> controla qué tan ancha es la zona que se desvanece (por defecto <code>4rem</code>), en cualquiera de los dos modos. Movés el control y el CSS se actualiza en vivo sobre el mismo feed con scroll de arriba.</p>
    <ComponentPreview html={fadeIntensityHtml} previewScript={fadeIntensityScript} label="Intensidad del desvanecido" />

    <h3>Variables y atributos</h3>
    <ul>
      <li><code>data-fade</code>: <code>transparent</code> (por defecto, revela el fondo detrás) o <code>color</code> (pinta un degradé opaco encima)</li>
      <li><code>data-direction</code>: <code>to-bottom</code> (por defecto), <code>to-top</code>, <code>to-right</code>, <code>to-left</code></li>
      <li><code>--sk-fade-edge-size</code>: el alto o ancho de la zona que se desvanece (por defecto: <code>4rem</code>)</li>
      <li><code>--sk-fade-edge-color</code>: el color de destino del degradé en modo <code>color</code> (por defecto: <code>var(--color-bg-canvas)</code>); no tiene efecto en modo <code>transparent</code></li>
    </ul>

    <h3>Notas de implementación</h3>
    <ul>
      <li>Modo <code>transparent</code>: usa <code>mask-image</code> con un <code>linear-gradient</code>. El contenido sigue en el DOM y es seleccionable  -  solo se enmascara visualmente. Solo se nota si lo que hay detrás es un fondo sólido y contrasta con el contenido</li>
      <li>Modo <code>color</code>: un <code>::after</code> posicionado encima pinta el degradé, así que el elemento necesita <code>position: relative</code> (ya lo trae por defecto) y el resto de tu contenido no debe competir por ese mismo pseudo-elemento</li>
      <li>El desvanecido queda fijo en el borde del elemento aunque el contenido interno tenga scroll  -  no hace falta recalcularlo al desplazarse</li>
      <li>Ponele <code>overflow: auto</code> (o <code>hidden</code>, si no necesitás scroll) al mismo elemento cuando el contenido interno se desborda, para que no se vea por fuera del área desvanecida</li>
      <li>Para accesibilidad, asegurate de que el contenido crítico no quede oculto detrás del desvanecido</li>
    </ul>
  </Fragment>
</ComponentPageShell>
