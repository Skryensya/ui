---
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  fadeBottomTree,
  fadeColorTree,
  fadeEdgeAnatomyTree,
  fadeIntensityTree,
  fadeHorizontalAgendaTree,
  fadeScrollAwareTree,
  fadeTopTree,
  fadeDoFitsTree,
  fadeDontFitsTree,
  fadeDirectionGuideTree,
  fadeDontDirectionTree,
  fadeDontModeTree,
  fadeDontNestedScrollTree,
} from "../../demos/fade-edge";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/fade-edge.css";
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/avatar.css";
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/scrollbar.css";
import "@skryensya/core/components/annotation.css";
import { annotationDemoCss } from "../../demos/annotation";
/* `input.css` for the intensity control, which is a real `NativeInput` now rather than a bare
   `<input>` in a string; `stack`/`inline` ride in through `patterns/layout.css` globally. */
import "@skryensya/core/components/input.css";

const t = useTranslations(getLocale(Astro.url));

/*
 * THE DEMOS THEMSELVES LIVE IN `demos/fade-edge.ts`, AS TREES.
 *
 * They were six HTML string literals right here, which is why this page had a Vanilla stage and no
 * React one at all: `ComponentPreview` derives both bindings from a tree, and a string is only ever
 * one of them. Nothing about FadeEdge was blocking that; the strings simply predate the compiler.
 *
 * The three scripts below stay here, because they ARE page-level app code: what a consumer would
 * write around the pattern, not part of it. Each runs inside the stage for both bindings, so it
 * drives the demo through the DOM and never through a binding's own API.
 */
const storybookTitle = "Components/Layout/FadeEdge";

const fadeTopScript = `
const region = document.getElementById("fade-top-scroll");
if (region) region.scrollTop = region.scrollHeight;
`;

const fadeLeftScript = `
const region = document.getElementById("fade-left-scroll");
if (region) region.scrollLeft = region.scrollWidth;
`;

const fadeIntensityScript = `
const region = document.getElementById("fade-intensity-region");
const range = document.getElementById("fade-intensity-range");
const output = document.getElementById("fade-intensity-value");

function sync() {
  const px = Number(range.value);
  region.style.setProperty("--sk-fade-edge-size", \`\${px}px\`);
  output.textContent = \`\${(px / 16).toFixed(1)}rem\`;
}

range.addEventListener("input", sync);
sync();
`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`fadeEdge.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="FadeEdge"
  description={t("fadeEdge.description")}
  contractId="fade-edge"
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("fadeEdge.lede")} />

    <UsagePreview
      tree={fadeBottomTree}
      target={["children", 0]}
      optionName="direction"
      title={t("fadeEdge.prop.direction.title")}
      description={t("fadeEdge.prop.direction.body")}
      explain={explain("direction", ["to-bottom", "to-top", "to-right", "to-left"])}
      stageMinBlockSize="14rem"
      storybookTitle={storybookTitle}
      storybookStory="FadeBottom"
    />

    <UsagePreview
      tree={fadeBottomTree}
      target={["children", 0]}
      optionName="mode"
      title={t("fadeEdge.prop.mode.title")}
      description={t("fadeEdge.prop.mode.body")}
      explain={explain("mode", ["transparent", "color"])}
      stageMinBlockSize="14rem"
      storybookTitle={storybookTitle}
      storybookStory="FadeBottom"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <h3>{t("fadeEdge.topTitle")}</h3>
    <p set:html={t("fadeEdge.topBody")} />
    <UsagePreview tree={fadeTopTree} script={fadeTopScript} label={t("fadeEdge.topLabel")} />
    <UsagePreview tree={fadeHorizontalAgendaTree(t)} title={t("fadeEdge.rightTitle")} description={t("fadeEdge.rightBody")} storybookTitle={storybookTitle} storybookStory="FadeRight" />
    <h3>{t("fadeEdge.leftTitle")}</h3>
    <p set:html={t("fadeEdge.leftBody")} />
    <UsagePreview tree={fadeHorizontalAgendaTree(t, "to-left")} script={fadeLeftScript} label={t("fadeEdge.leftLabel")} />
    <UsagePreview tree={fadeColorTree} title={t("fadeEdge.colorTitle")} description={t("fadeEdge.colorBody")} storybookTitle={storybookTitle} storybookStory="FadeColor" />
    <h3>{t("fadeEdge.intensityTitle")}</h3>
    <p set:html={t("fadeEdge.intensityBody")} />
    <UsagePreview tree={fadeIntensityTree} script={fadeIntensityScript} label={t("fadeEdge.intensityLabel")} />
    <UsagePreview tree={fadeScrollAwareTree} title={t("fadeEdge.scrollAwareTitle")} description={t("fadeEdge.scrollAwareBody")} storybookTitle={storybookTitle} storybookStory="FadeScrollAware" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "fadeEdge.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("fadeEdge.anatomyBody")} />
    <UsagePreview
      tree={fadeEdgeAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("fadeEdge.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("fadeEdge.guidelinesLede")} />
    <WhenToUse use={tList(t, "fadeEdge.when")} avoid={tList(t, "fadeEdge.whenNot")} />
    <DoDont
      title={t("fadeEdge.dd.fits.title")}
      interactive
      do={{ tree: fadeDoFitsTree, caption: t("fadeEdge.dd.fits.do") }}
      dont={{ tree: fadeDontFitsTree, caption: t("fadeEdge.dd.fits.dont") }}
    />
    <DoDont
      title={t("fadeEdge.dd.direction.title")}
      interactive
      do={{ tree: fadeDirectionGuideTree, caption: t("fadeEdge.dd.direction.do") }}
      dont={{ tree: fadeDontDirectionTree, caption: t("fadeEdge.dd.direction.dont") }}
    />
    {/*
      Inline, right after the pair, so both rows open at their middle before the first paint. A row
      in a tab that is still hidden has no width yet, so it is centred the first time it gets one.
    */}
    <script is:inline>
      document.querySelectorAll("[data-dd-middle]").forEach((row) => {
        const centre = () => {
          if (!row.clientWidth) return false;
          row.scrollLeft = (row.scrollWidth - row.clientWidth) / 2;
          return true;
        };
        if (centre()) return;
        const observer = new ResizeObserver(() => centre() && observer.disconnect());
        observer.observe(row);
      });
    </script>
    <DoDont
      title={t("fadeEdge.dd.mode.title")}
      do={{ tree: fadeColorTree, caption: t("fadeEdge.dd.mode.do") }}
      dont={{ tree: fadeDontModeTree, caption: t("fadeEdge.dd.mode.dont") }}
    />
    <DoDont
      title={t("fadeEdge.dd.scroll.title")}
      interactive
      do={{ tree: fadeScrollAwareTree, caption: t("fadeEdge.dd.scroll.do") }}
      dont={{ tree: fadeDontNestedScrollTree, caption: t("fadeEdge.dd.scroll.dont") }}
    />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("fadeEdge.a11yIntro")} does={tList(t, "fadeEdge.a11yDoes")} yours={tList(t, "fadeEdge.a11yYours")} />
  </Fragment>
</ComponentPageShell>

