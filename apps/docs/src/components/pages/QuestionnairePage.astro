---
/*
 * Questionnaire composes Tile, Checkbox, FormField, Input, Button, Kbd, Progress and Steps, so this
 * page loads every one of their sheets: a preview frame only copies the styles THIS page loaded.
 *
 * Select and FileUpload are NOT composed by the contract  -  they are what the `control` slot demo
 * puts INTO it, and a slotted control brings its own stylesheet the same as a composed part. Without
 * these two the demo rendered as bare markup: the trigger showed both chevrons at once and the label
 * sat inline beside it, because none of `select.css` had ever reached the frame.
 */
import "@skryensya/core/components/questionnaire.css";
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/file-upload.css";
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/radio-group.css";
import "@skryensya/core/components/kbd.css";
import "@skryensya/core/components/progress.css";
import "@skryensya/core/components/steps.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import "@skryensya/core/components/annotation.css";
import { annotationDemoCss } from "../../demos/annotation";
import {
  questionnaireAnatomyTree,
  questionnaireBarTree,
  questionnaireBranchingTree,
  questionnaireChoicesOnlyTree,
  questionnaireControlTree,
  questionnaireRailTree,
  questionnaireSegmentsTree,
  questionnaireFollowUpTree,
  questionnaireLikertTree,
  questionnaireShortcutsTree,
  questionnaireStepsTree,
  questionnaireTree,
} from "../../demos/questionnaire";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="Questionnaire"
  badge="Beta"
  description={t("questionnairePage.description")}
  contractId="questionnaire"
  testFiles={[
    "packages/core/src/questionnaire.test.ts",
    "packages/react/src/components/questionnaire.test.tsx",
    "packages/vanilla/src/components/questionnaire.test.ts",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("questionnairePage.lede")} />

    <h3>{t("questionnairePage.showcaseTitle")}</h3>
    <p set:html={t("questionnairePage.showcaseBody")} />

    <UsagePreview tree={questionnaireTree(t)} />
    <p set:html={t("component.reactNote")} />

    <h3>{t("questionnairePage.stateTitle")}</h3>
    <p set:html={t("questionnairePage.stateBody")} />

    <h3>{t("questionnairePage.choicesOnlyTitle")}</h3>
    <p set:html={t("questionnairePage.choicesOnlyBody")} />
    <UsagePreview tree={questionnaireChoicesOnlyTree(t)} />

    <h3>{t("questionnairePage.likertTitle")}</h3>
    <p set:html={t("questionnairePage.likertBody")} />
    <UsagePreview tree={questionnaireLikertTree(t)} />

    <h3>{t("questionnairePage.branchTitle")}</h3>
    <p set:html={t("questionnairePage.branchBody")} />
    <UsagePreview tree={questionnaireBranchingTree(t)} />

    <h3>{t("questionnairePage.followUpTitle")}</h3>
    <p set:html={t("questionnairePage.followUpBody")} />
    <UsagePreview tree={questionnaireFollowUpTree(t)} />

    <h3>{t("questionnairePage.controlTitle")}</h3>
    <p set:html={t("questionnairePage.controlBody")} />
    <UsagePreview tree={questionnaireControlTree(t)} />

    <h3>{t("questionnairePage.progressTitle")}</h3>
    <p set:html={t("questionnairePage.progressBody")} />
    <UsagePreview tree={questionnaireBarTree(t)} />
    <UsagePreview tree={questionnaireStepsTree(t)} />
    <UsagePreview tree={questionnaireSegmentsTree(t)} />

    <h3>{t("questionnairePage.railTitle")}</h3>
    <p set:html={t("questionnairePage.railBody")} />
    <!--
      PINNED TO A FRAME WIDE ENOUGH TO SHOW ITS OWN SUBJECT. The two columns need 746px and the page
      default is Tablet, whose frame is 805px but whose questionnaire falls back below `desktop`
      (832px). A Free frame is ~974px and clears it, so the section documenting the side rail shows
      the side rail rather than its fallback. Same reason Vaul pins Mobile, at the other end.
    -->
    <UsagePreview tree={questionnaireRailTree(t)} />

    <h3>{t("questionnairePage.heightTitle")}</h3>
    <p set:html={t("questionnairePage.heightBody")} />

    <h3>{t("questionnairePage.keyboardTitle")}</h3>
    <p set:html={t("questionnairePage.keyboardBody")} />
    <UsagePreview tree={questionnaireShortcutsTree(t)} />

    <h3>{t("questionnairePage.skipTitle")}</h3>
    <p set:html={t("questionnairePage.skipBody")} />

    <h3>{t("questionnairePage.noScriptTitle")}</h3>
    <p set:html={t("questionnairePage.noScriptBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("questionnairePage.anatomyBody")} />
    <ComponentPreview
      tree={questionnaireAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("questionnairePage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("questionnairePage.guidelinesLede")} />
    <ul>
      <li set:html={t("questionnairePage.guide.item1")} />
      <li set:html={t("questionnairePage.guide.item2")} />
      <li set:html={t("questionnairePage.guide.item3")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
