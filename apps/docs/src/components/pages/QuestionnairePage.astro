---
/*
 * Questionnaire composes Tile, Checkbox, FormField, Input, Button, Kbd, Progress and Steps, so this
 * page loads every one of their sheets: a preview frame only copies the styles THIS page loaded.
 *
 * Select and FileUpload are NOT composed by the contract  -  they are what the `control` slot demo
 * puts INTO it, and a slotted control brings its own stylesheet the same as a composed part. Without
 * these two the demo rendered as bare markup: the trigger showed both chevrons at once and the label
 * sat inline beside it, because none of `select.css` had ever reached the frame.
 */
import "@skryensya/core/components/questionnaire.css";
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/file-upload.css";
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/radio-group.css";
import "@skryensya/core/components/kbd.css";
import "@skryensya/core/components/progress.css";
import "@skryensya/core/components/steps.css";
import "@skryensya/core/components/presence.css";
import "@skryensya/core/components/callout.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/layout.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import ComparisonTable from "../ComparisonTable.astro";
import WhenToUse from "../WhenToUse.astro";
import DoDont from "../DoDont.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import "@skryensya/core/components/annotation.css";
import { annotationDemoCss } from "../../demos/annotation";
import {
  questionnaireSubmitScript,
  questionnaireSubmittedTree,
  questionnaireAnatomyTree,
  questionnaireBranchingTree,
  questionnaireChoicesOnlyTree,
  questionnaireControlTree,
  questionnaireDoEmailTree,
  questionnaireDoFewTree,
  questionnaireDontEmailTree,
  questionnaireDontManyTree,
  questionnaireTextAnswersTree,
  questionnaireRailTree,
  questionnaireFollowUpTree,
  questionnaireLikertTree,
  questionnaireShortcutsTree,
  questionnaireTree,
} from "../../demos/questionnaire";
import { getLocale, tList, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
/* A key as it is pressed: "Ctrl+Enter" is two keys joined by "+", several that do the same are separate. */
const keysHtml = (combos: readonly string[]) =>
  combos.map((combo) => (combo.length > 1 ? combo.split("+") : [combo]).map((key) => `<kbd class="sk-kbd">${key}</kbd>`).join("+")).join(", ");
const tt = (key: string) => t(`questionnairePage.${key}` as Parameters<typeof t>[0]);
const keyRows = [
  { id: "modEnter", keys: ["⌘+Enter", "Ctrl+Enter"] },
  { id: "enter", keys: ["Enter"] },
  { id: "updown", keys: ["↑", "↓"] },
  { id: "left", keys: ["←"] },
  { id: "right", keys: ["→"] },
  { id: "letters", keys: ["A–Z"] },
  { id: "numbers", keys: ["1–9"] },
].map(({ id, keys }) => ({
  label: keys.join(" / "),
  /* One line per row: a key combination broken across two reads as two different keys. */
  labelHtml: `<span style="white-space: nowrap">${keysHtml(keys)}</span>`,
  cells: [tt(`keysTable.${id}.choosing`), tt(`keysTable.${id}.typing`)],
}));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`questionnairePage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Questionnaire"
  description={t("questionnairePage.description")}
  contractId="questionnaire"
  testFiles={[
    "packages/core/src/questionnaire.test.ts",
    "packages/react/src/components/questionnaire.test.tsx",
    "packages/vanilla/src/components/questionnaire.test.ts",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("questionnairePage.lede")} />

    <UsagePreview
      tree={questionnaireTree(t)}
      optionName="progress"
      title={t("questionnairePage.prop.progress.title")}
      description={t("questionnairePage.prop.progress.body")}
      explain={explain("progress", ["text", "bar", "steps", "segments"])}
      stageMinBlockSize="26rem"
    />
    <UsagePreview
      tree={questionnaireTree(t)}
      optionName="shortcuts"
      title={t("questionnairePage.prop.shortcuts.title")}
      description={t("questionnairePage.prop.shortcuts.body")}
      explain={explain("shortcuts", ["none", "letters", "numbers"])}
      stageMinBlockSize="26rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={questionnaireTree(t)} title={t("questionnairePage.basicTitle")} description={t("questionnairePage.basicBody")} />
    <UsagePreview
      tree={questionnaireSubmittedTree(t)}
      script={questionnaireSubmitScript}
      title={t("questionnairePage.submittedTitle")}
      description={t("questionnairePage.submittedBody")}
      label={t("questionnairePage.submittedTitle")}
      stageMinBlockSize="22rem"
    />
    <UsagePreview tree={questionnaireChoicesOnlyTree(t)} title={t("questionnairePage.choicesOnlyTitle")} description={t("questionnairePage.choicesOnlyBody")} />
    <UsagePreview tree={questionnaireLikertTree(t)} title={t("questionnairePage.likertTitle")} description={t("questionnairePage.likertBody")} />
    <UsagePreview tree={questionnaireBranchingTree(t)} title={t("questionnairePage.branchTitle")} description={t("questionnairePage.branchBody")} />
    <UsagePreview tree={questionnaireFollowUpTree(t)} title={t("questionnairePage.followUpTitle")} description={t("questionnairePage.followUpBody")} />
    <UsagePreview tree={questionnaireControlTree(t)} title={t("questionnairePage.controlTitle")} description={t("questionnairePage.controlBody")} />
    {/* The side rail needs about 750px; below `desktop` it falls back to the top bar. */}
    <UsagePreview tree={questionnaireRailTree(t)} title={t("questionnairePage.railTitle")} description={t("questionnairePage.railBody")} />
    <UsagePreview tree={questionnaireTextAnswersTree(t)} title={t("questionnairePage.textTitle")} description={t("questionnairePage.textBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "questionnairePage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("questionnairePage.anatomyBody")} />
    <UsagePreview
      tree={questionnaireAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("questionnairePage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("questionnairePage.guidelinesLede")} />
    <WhenToUse use={tList(t, "questionnairePage.when")} avoid={tList(t, "questionnairePage.whenNot")} />
    <DoDont
      canvas
      title={t("questionnairePage.dd.email.title")}
      do={{ tree: questionnaireDoEmailTree(t), caption: t("questionnairePage.dd.email.do") }}
      dont={{ tree: questionnaireDontEmailTree(t), caption: t("questionnairePage.dd.email.dont") }}
    />
    <DoDont
      canvas
      title={t("questionnairePage.dd.few.title")}
      do={{ tree: questionnaireDoFewTree(t), caption: t("questionnairePage.dd.few.do") }}
      dont={{ tree: questionnaireDontManyTree(t), caption: t("questionnairePage.dd.few.dont") }}
    />
    <ContentRules items={tList(t, "questionnairePage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("questionnairePage.a11yIntro")}
      does={tList(t, "questionnairePage.a11yDoes")}
      yours={tList(t, "questionnairePage.a11yYours")}
    />

    <h3>{t("component.a11yKeyboardTitle")}</h3>
    <p set:html={t("questionnairePage.keysIntro")} />
    <ComparisonTable
      aspectLabel={t("questionnairePage.keysTable.aspect")}
      columns={[t("questionnairePage.keysTable.choosing"), t("questionnairePage.keysTable.typing")]}
      rows={keyRows}
    />
    <p>{t("questionnairePage.keysNoteShort")}</p>
    <UsagePreview tree={questionnaireShortcutsTree(t)} title={t("questionnairePage.keyboardTitle")} description={t("questionnairePage.keyboardBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
