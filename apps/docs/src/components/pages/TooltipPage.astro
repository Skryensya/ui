---
// The preview clones the sheets from the page's <head>, so whatever the demo uses has to be imported
// here: `.sk-truncate` belongs to the demo, not to the package.
import "../../examples/tooltip.css";
import "@skryensya/core/components/tooltip.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/button.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { tooltipAnatomyCss, tooltipAnatomyHtml, tooltipTree } from "../../demos/tooltip";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;
---

<ComponentPageShell
  title="Tooltip"
  description={t("tooltipPage.description")}
  contractId="tooltip"
  styleGroups={[{ file: "components/tooltip.css", probe: "sk-tooltip" }]}
  tests={[
    {
      file: "packages/react/src/components/tooltip.test.tsx",
      tests: [
        { name: "describes the trigger rather than naming it", description: t("tooltipPage.test1") },
        { name: "stays closed while disabled", description: t("tooltipPage.test2") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tooltipPage.lede")} />

    <p set:html={t("tooltipPage.anatomyBody")} />
    <ComponentPreview
      html={tooltipAnatomyHtml(t)}
      css={tooltipAnatomyCss}
      label={t("tooltipPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />


    {/* `menu`: the tooltip paints out of flow, and in a stage sized to the content it would have
        nowhere to go, so the real placement would never be visible. */}
    <ComponentPreview tree={tooltipTree(t)} label="Tooltip" viewport="menu" />

    <h3>{t("tooltipPage.ruleTitle")}</h3>
    <p set:html={t("tooltipPage.ruleBody1")} />
    <p set:html={t("tooltipPage.ruleBody2")} />

    <h3>{t("tooltipPage.wcagTitle")}</h3>
    <p set:html={t("tooltipPage.wcagBody1")} />
    <p set:html={t("tooltipPage.wcagBody2")} />

    <h3>{t("tooltipPage.placementTitle")}</h3>
    <p set:html={t("tooltipPage.placementBody")} />

    <h3>{t("tooltipPage.positioningTitle")}</h3>
    <p set:html={t("tooltipPage.positioningBody1")} />
    <p set:html={t("tooltipPage.positioningBody2")} />

    <p set:html={t("component.reactNote")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
