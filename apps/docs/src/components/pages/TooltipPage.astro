---
// The preview clones the sheets from the page's <head>, so whatever the demo uses has to be imported
// here: `.sk-truncate` belongs to the demo, not to the package.
import "../../examples/tooltip.css";
import "@skryensya/core/components/tooltip.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/button.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  tooltipAnatomyCss,
  tooltipAnatomyHtml,
  tooltipDoIconTree,
  tooltipDontLongTree,
  tooltipDontRepeatTree,
  tooltipSingleTree,
  tooltipTree,
} from "../../demos/tooltip";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`tooltipPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Tooltip"
  description={t("tooltipPage.description")}
  contractId="tooltip"
  testFiles={["packages/react/src/components/tooltip.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tooltipPage.lede")} />

    <UsagePreview
      tree={tooltipSingleTree(t)}
      optionName="placement"
      title={t("tooltipPage.prop.placement.title")}
      description={t("tooltipPage.prop.placement.body")}
      explain={explain("placement", ["block-start", "block-end", "inline-start", "inline-end"])}
      stageMinBlockSize="12rem"
      labels={{ "block-start": t("tooltipPage.prop.placement.top"), "block-end": t("tooltipPage.prop.placement.bottom"), "inline-start": t("tooltipPage.prop.placement.start"), "inline-end": t("tooltipPage.prop.placement.end") }}
    />

    <UsagePreview
      tree={tooltipSingleTree(t)}
      optionName="arrow"
      title={t("tooltipPage.prop.arrow.title")}
      description={t("tooltipPage.prop.arrow.body")}
      explain={explain("arrow", ["false", "true"])}
      stageMinBlockSize="12rem"
      labels={{ false: t("tooltipPage.prop.arrow.falseLabel"), true: t("tooltipPage.prop.arrow.trueLabel") }}
    />

    <h3>{t("tooltipPage.showcaseTitle")}</h3>
    <p set:html={t("tooltipPage.showcaseBody")} />
    {/* `menu`: the tooltip paints out of flow, and in a stage sized to the content it would have
        nowhere to go, so the real placement would never be visible. */}
    <ComponentPreview tree={tooltipTree(t)} label="Tooltip" viewport="menu" />

    <h3>{t("tooltipPage.ruleTitle")}</h3>
    <p set:html={t("tooltipPage.ruleBody1")} />
    <p set:html={t("tooltipPage.ruleBody2")} />

    <h3>{t("tooltipPage.wcagTitle")}</h3>
    <p set:html={t("tooltipPage.wcagBody1")} />
    <p set:html={t("tooltipPage.wcagBody2")} />

    <h3>{t("tooltipPage.placementTitle")}</h3>
    <p set:html={t("tooltipPage.placementBody")} />

    <h3>{t("tooltipPage.positioningTitle")}</h3>
    <p set:html={t("tooltipPage.positioningBody1")} />
    <p set:html={t("tooltipPage.positioningBody2")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("tooltipPage.anatomyBody")} />
    <ComponentPreview
      html={tooltipAnatomyHtml(t)}
      css={tooltipAnatomyCss}
      label={t("tooltipPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tooltipPage.guidelinesLede")} />
    <DoDont
      title={t("tooltipPage.dd.short.title")}
      do={{ tree: tooltipDoIconTree(t), caption: t("tooltipPage.dd.short.do") }}
      dont={{ tree: tooltipDontLongTree(t), caption: t("tooltipPage.dd.short.dont") }}
    />
    <DoDont
      title={t("tooltipPage.dd.repeat.title")}
      do={{ tree: tooltipDoIconTree(t), caption: t("tooltipPage.dd.repeat.do") }}
      dont={{ tree: tooltipDontRepeatTree(t), caption: t("tooltipPage.dd.repeat.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
