---
// The preview clones the sheets from the page's <head>, so whatever the demo uses has to be imported
// here: `.sk-truncate` belongs to the demo, not to the package.
import "../../examples/tooltip.css";
import "@skryensya/core/components/tooltip.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/button.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  tooltipDoIconTree,
  tooltipDontLongTree,
  tooltipDontRepeatTree,
  tooltipTree,
} from "../../demos/tooltip";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;
---

<ComponentPageShell
  title="Tooltip"
  description={t("tooltipPage.description")}
  contractId="tooltip"
  testFiles={["packages/react/src/components/tooltip.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tooltipPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    {/* `menu`: the tooltip paints out of flow, and in a stage sized to the content it would have
        nowhere to go, so the real placement would never be visible. */}
    <UsagePreview tree={tooltipTree(t)} title={t("tooltipPage.casesTitle")} description={t("tooltipPage.casesBody")} viewport="menu" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "tooltipPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tooltipPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "tooltipPage.when")} avoid={tList(t, "tooltipPage.whenNot")} />
    <DoDont
      title={t("tooltipPage.dd.short.title")}
      do={{ tree: tooltipDoIconTree(t), caption: t("tooltipPage.dd.short.do") }}
      dont={{ tree: tooltipDontLongTree(t), caption: t("tooltipPage.dd.short.dont") }}
    />
    <DoDont
      title={t("tooltipPage.dd.repeat.title")}
      do={{ tree: tooltipDoIconTree(t), caption: t("tooltipPage.dd.repeat.do") }}
      dont={{ tree: tooltipDontRepeatTree(t), caption: t("tooltipPage.dd.repeat.dont") }}
    />
    <ContentRules items={tList(t, "tooltipPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes
      intro={t("tooltipPage.a11yIntro")}
      does={tList(t, "tooltipPage.a11yDoes")}
      yours={tList(t, "tooltipPage.a11yYours")}
      keys={[
        { keys: ["Tab"], action: t("tooltipPage.key.focus") },
        { keys: ["Esc"], action: t("tooltipPage.key.escape") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
