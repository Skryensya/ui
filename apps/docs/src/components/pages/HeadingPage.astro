---
import "@skryensya/core/components/dialog.css";
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  headingAnatomyTree,
  headingCompactTree,
  headingDisplayTree,
  headingDocumentTree,
  headingFlushTree,
  headingOutlineTree,
  headingPageTitleTree,
} from "../../demos/typography";
import { getLocale, useTranslations } from "../../i18n";
import { annotationDemoCss } from "../../demos/annotation";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`heading.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Heading"
  description={t("heading.description")}
  contractId="typography"
  tests={[
    {
      file: "packages/react/src/components/typography.test.tsx",
      tests: [
        { name: "separates heading hierarchy from its visual size", description: t("heading.test1") },
        { name: "opts into flush with an explicit attribute, not by position", description: t("heading.test2") },
        { name: "floors h5 and h6 visual size at h4", description: t("heading.test3") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("heading.lede")} />

    <UsagePreview
      tree={headingFlushTree(t)}
      optionName="headingSize"
      title={t("heading.prop.headingSize.title")}
      description={t("heading.prop.headingSize.body")}
      explain={explain("headingSize", ["display-lg", "display-md", "display-sm", "h1", "h2", "h3", "h4", "h5", "h6", "sm", "md", "lg", "display"])}
      stageMinBlockSize="9rem"
    />

    <UsagePreview
      tree={headingFlushTree(t)}
      optionName="headingElement"
      title={t("heading.prop.headingElement.title")}
      description={t("heading.prop.headingElement.body")}
      explain={explain("headingElement", ["h1", "h2", "h3", "h4", "h5", "h6"])}
      stageMinBlockSize="9rem"
    />

    <UsagePreview
      tree={headingFlushTree(t)}
      optionName="flush"
      title={t("heading.prop.flush.title")}
      description={t("heading.prop.flush.body")}
      explain={explain("flush", ["false", "true"])}
      labels={{ false: t("heading.prop.flush.falseLabel"), true: t("heading.prop.flush.trueLabel") }}
      stageMinBlockSize="9rem"
    />

    <h3>{t("heading.showcaseTitle")}</h3>
    <p set:html={t("heading.showcaseBody")} />
    <UsagePreview tree={headingDisplayTree(t)} title={t("heading.displayTitle")} description={t("heading.displayBody")} />
    <UsagePreview tree={headingDocumentTree(t)} title={t("heading.documentTitle")} description={t("heading.documentBody")} />
    <UsagePreview tree={headingPageTitleTree(t)} title={t("heading.pageTitleTitle")} description={t("heading.pageTitleBody")} />
    <UsagePreview tree={headingOutlineTree(t)} title={t("heading.outlineTitle")} description={t("heading.outlineBody")} />
    <UsagePreview tree={headingCompactTree(t)} title={t("heading.compactTitle")} description={t("heading.compactBody")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("heading.contractItem1")} />
      <li set:html={t("heading.contractItem2")} />
      <li set:html={t("heading.contractItem3")} />
      <li set:html={t("heading.contractItem4")} />
      <li set:html={t("heading.contractItem5")} />
      <li set:html={t("heading.contractItem6")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("heading.anatomyBody")} />
    <ComponentPreview
      tree={headingAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("heading.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("heading.guidelinesLede")} />
    <DoDont
      title={t("heading.dd.level.title")}
      do={{ tree: headingOutlineTree(t), caption: t("heading.dd.level.do") }}
      dont={{ tree: headingDisplayTree(t), caption: t("heading.dd.level.dont") }}
    />
    <DoDont
      title={t("heading.dd.compact.title")}
      do={{ tree: headingCompactTree(t), caption: t("heading.dd.compact.do") }}
      dont={{ tree: headingPageTitleTree(t), caption: t("heading.dd.compact.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
