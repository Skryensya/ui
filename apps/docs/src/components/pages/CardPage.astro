---
/*
 * A composition guide, not a component page: there is no `sk-card`, no `@skryensya/react/card` and
 * no compiled contract to publish, on purpose (see the callout below). The shell runs with no
 * `contractId`, so Referencia and Cambios drop out. There is no single compiled artifact for
 * "Box + Tile + ImageFrame + Stack" to read either tab from, same as Primitivas. Instalación,
 * Estilo, Accesibilidad and Tests are all independent of `contractId`, so they still run: Estilo
 * reads the REAL published hooks of the pieces Card composes (Box, Tile, Checkbox, ImageFrame),
 * and Tests reads two real files written for this page (see their own comments).
 */
/* Box, Stack, ImageFrame and typography ride in globally through Base.astro's own
 * `patterns/layout.css` (which itself pulls box.css and image-frame.css) and `components/typography.css`.
 * Tile and Checkbox do not: every other page that uses TileLink/TileButton/TileCheckbox imports
 * these explicitly, and the card examples that sit on them (link, action, select, mediaLink) need
 * them too. Without checkbox.css, EVERY indicator painted both the check and the dash glyph at
 * once: the state-scoped visibility rule that hides one of them never loaded. */
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/chart.css";
import "@skryensya/core/components/stat.css";
import "../../examples/card.css";
import CodeBlock from "../CodeBlock.astro";
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { cardCopy } from "../../examples/card-data";
import { cardSources } from "../../examples/card-sources";
import {
  CardActionDemo,
  CardBasicDemo,
  CardGradientDemo,
  CardLinkDemo,
  CardMediaDemo,
  CardMediaLinkDemo,
  CardMetaDemo,
  CardPlainMediaDemo,
  CardProductDemo,
  CardSelectDemo,
  CardStatDemo,
} from "../react-demos/card";
import { ChartCardDemo } from "../react-demos/chart-card";
import { getLocale, useTranslations } from "../../i18n";

/* The eleven examples are a LADDER: each rung adds one decision to the one before it, and every
 * rung is shown as a grid of three, because a card that only looks right on its own is a card whose
 * height, media and footer were never tested against its siblings. */
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const copy = cardCopy[locale];
const src = cardSources(copy);

/* Same snippet Primitivas installs: Card asks nothing beyond the two packages every example here
 * already imports from. */
const install = `pnpm add @skryensya/core @skryensya/react`;
/* The composition, and only ONE chart. The other two cards and the Chart piece itself live on
 * `/components/charts`; this rung is about the card around it. */
const chartSource = `import { Badge } from "@skryensya/react/badge";
import { Button } from "@skryensya/react/button";
import { Chart } from "@skryensya/charts/react";
import { Box, Inline, Stack } from "@skryensya/react/layout";
import { Heading, Text } from "@skryensya/react/typography";

<Box as="article" border="subtle" padding="lg" surface="surface">
  <Stack gap="md">
    <Inline align="start" justify="between">
      <Stack gap="xs">
        <Heading as="h3" flush size="h4">
          Analytics
        </Heading>
        <Inline align="center" gap="sm">
          <Text as="span" tone="secondary">
            418.2K Visitors
          </Text>
          <Badge tone="success">+10%</Badge>
        </Inline>
      </Stack>
      <Button size="sm" variant="translucent">
        View Analytics
      </Button>
    </Inline>
    <Chart
      flush
      format="compact"
      height="sm"
      kind="area"
      label="Visits per week"
      labels={false}
      points={visits}
    />
  </Stack>
</Box>;`;
---

<ComponentPageShell
  title="Card"
  description={t("cardPage.description")}
  styleGroups={[
    { file: "patterns/box.css", probe: "sk-box", title: "Box" },
    { file: "components/tile.css", probe: "sk-tile", title: "Tile" },
    { file: "components/checkbox.css", probe: "sk-checkbox", title: "Checkbox" },
    { file: "patterns/image-frame.css", probe: "sk-image-frame", title: "ImageFrame" },
  ]}
  tests={[
    {
      file: "apps/docs/src/examples/card-sources.test.ts",
      tests: [
        { name: "keeps every example's data array at exactly three cards", description: t("cardPage.testGridOfThree") },
        {
          name: "marks the select example's initial state on the label, not on the input",
          description: t("cardPage.testSelectDefaultChecked"),
        },
      ],
    },
    {
      file: "apps/docs/src/components/pages/CardPage.test.ts",
      tests: [
        { name: "imports tile.css, which Base.astro never loads globally", description: t("cardPage.testImportsTile") },
        {
          name: "imports checkbox.css, without which every indicator paints both the check and the dash glyph at once",
          description: t("cardPage.testImportsCheckbox"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("cardPage.lede")} />

    <div class="sk-callout" data-tone="info">
      <div class="sk-callout__content">
        <div class="sk-callout__description" set:html={t("cardPage.calloutBody")} />
      </div>
    </div>

    <h3>{t("cardPage.chooseTitle")}</h3>
    <p set:html={t("cardPage.chooseBody")} />
    <div class="sk-table-scroll">
      <table class="sk-table">
        <thead class="sk-table__head">
          <tr class="sk-table__row"><th class="sk-table__header">{t("cardPage.tableHeadSurface")}</th><th class="sk-table__header">{t("cardPage.tableHeadUses")}</th><th class="sk-table__header">{t("cardPage.tableHeadElement")}</th></tr>
        </thead>
        <tbody class="sk-table__body">
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow1Surface")}</td><td class="sk-table__cell"><a href="/components/box">Box</a></td><td set:html={t("cardPage.tableRow1Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow2Surface")}</td><td class="sk-table__cell"><a href="/components/link">TileLink</a></td><td set:html={t("cardPage.tableRow2Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow3Surface")}</td><td class="sk-table__cell"><a href="/components/button">TileButton</a></td><td set:html={t("cardPage.tableRow3Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow4Surface")}</td><td class="sk-table__cell"><a href="/components/checkbox">TileCheckbox</a></td><td set:html={t("cardPage.tableRow4Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow5Surface")}</td><td class="sk-table__cell"><a href="/components/radio-group">TileRadioGroup</a></td><td set:html={t("cardPage.tableRow5Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow6Surface")}</td><td class="sk-table__cell"><a href="/components/accordion">Accordion</a></td><td set:html={t("cardPage.tableRow6Element")} class="sk-table__cell" /></tr>
        </tbody>
      </table>
    </div>
    <p set:html={t("cardPage.geometryBody")} />

    <h3 id="contenido">{t("cardPage.plainMediaTitle")}</h3>
    <p set:html={t("cardPage.plainMediaBody")} />
    <ComponentPreview html={src.plainMedia.html} react={src.plainMedia.react} label={copy.labels.plainMedia} note={t("cardPage.plainMediaNote")}>
      <Fragment slot="react">
        <CardPlainMediaDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="basic">{t("cardPage.basicTitle")}</h3>
    <p set:html={t("cardPage.basicBody")} />
    <ComponentPreview html={src.basic.html} react={src.basic.react} label={copy.labels.basic} note={t("cardPage.basicNote")}>
      <Fragment slot="react">
        <CardBasicDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="meta">{t("cardPage.metaTitle")}</h3>
    <p set:html={t("cardPage.metaBody")} />
    <ComponentPreview html={src.meta.html} react={src.meta.react} label={copy.labels.meta} note={t("cardPage.metaNote")}>
      <Fragment slot="react">
        <CardMetaDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="stat-card">{t("cardPage.statTitle")}</h3>
    <p set:html={t("cardPage.statBody")} />
    <ComponentPreview html={src.stat.html} react={src.stat.react} label={copy.labels.stat} note={t("cardPage.statNote")}>
      <Fragment slot="react">
        <CardStatDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="chart-card">{t("cardPage.chartTitle")}</h3>
    <p set:html={t("cardPage.chartBody")} />
    <ComponentPreview react={chartSource} label={t("cardPage.chartLabel")} note={t("cardPage.chartNote")} minHeight="25rem">
      <Fragment slot="react">
        <ChartCardDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>
    <p set:html={t("cardPage.chartMore")} />

    <h3 id="enlace">{t("cardPage.linkTitle")}</h3>
    <p set:html={t("cardPage.linkBody")} />
    <ComponentPreview html={src.link.html} react={src.link.react} label={copy.labels.link} note={t("cardPage.linkNote")}>
      <Fragment slot="react">
        <CardLinkDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="accion">{t("cardPage.actionTitle")}</h3>
    <p set:html={t("cardPage.actionBody")} />
    <ComponentPreview html={src.action.html} react={src.action.react} label={copy.labels.action} note={t("cardPage.actionNote")}>
      <Fragment slot="react">
        <CardActionDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="seleccion">{t("cardPage.selectTitle")}</h3>
    <p set:html={t("cardPage.selectBody")} />
    <ComponentPreview html={src.select.html} react={src.select.react} label={copy.labels.select} note={t("cardPage.selectNote")}>
      <Fragment slot="react">
        <CardSelectDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="imagen">{t("cardPage.mediaTitle")}</h3>
    <p set:html={t("cardPage.mediaBody")} />
    <ComponentPreview html={src.media.html} react={src.media.react} label={copy.labels.media} note={t("cardPage.mediaNote")}>
      <Fragment slot="react">
        <CardMediaDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="gradiente">{t("cardPage.gradientTitle")}</h3>
    <p set:html={t("cardPage.gradientBody")} />
    <ComponentPreview html={src.gradient.html} react={src.gradient.react} label={copy.labels.gradient} note={t("cardPage.gradientNote")}>
      <Fragment slot="react">
        <CardGradientDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="imagen-enlace">{t("cardPage.mediaLinkTitle")}</h3>
    <p set:html={t("cardPage.mediaLinkBody")} />
    <ComponentPreview html={src.mediaLink.html} react={src.mediaLink.react} label={copy.labels.mediaLink} note={t("cardPage.mediaLinkNote")}>
      <Fragment slot="react">
        <CardMediaLinkDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3 id="producto">{t("cardPage.productTitle")}</h3>
    <p set:html={t("cardPage.productBody")} />
    <ComponentPreview html={src.product.html} react={src.product.react} label={copy.labels.product} note={t("cardPage.productNote")}>
      <Fragment slot="react">
        <CardProductDemo client:visible lang={locale} />
      </Fragment>
    </ComponentPreview>

    <h3>Do &amp; Don't</h3>
    <div class="sk-grid" data-columns="2" data-gap="md" data-multicol>
      <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="lg">
        <div class="sk-stack" data-gap="sm">
          <span class="sk-badge" data-tone="success">{t("cardPage.doTitle")}</span>
          <h4 class="sk-heading" data-size="h4">{t("cardPage.doHeading")}</h4>
          <ul>
            <li set:html={t("cardPage.doItem1")} />
            <li set:html={t("cardPage.doItem2")} />
            <li set:html={t("cardPage.doItem3")} />
            <li set:html={t("cardPage.doItem4")} />
            <li set:html={t("cardPage.doItem5")} />
          </ul>
        </div>
      </section>
      <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="lg">
        <div class="sk-stack" data-gap="sm">
          <span class="sk-badge" data-tone="danger">{t("cardPage.dontTitle")}</span>
          <h4 class="sk-heading" data-size="h4">{t("cardPage.dontHeading")}</h4>
          <ul>
            <li set:html={t("cardPage.dontItem1")} />
            <li set:html={t("cardPage.dontItem2")} />
            <li set:html={t("cardPage.dontItem3")} />
            <li set:html={t("cardPage.dontItem4")} />
            <li set:html={t("cardPage.dontItem5")} />
          </ul>
        </div>
      </section>
    </div>

    <h3>{t("cardPage.implTitle")}</h3>
    <p set:html={t("cardPage.implBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("cardPage.a11yP1")} />
    <p set:html={t("cardPage.a11yP2")} />
    <p set:html={t("cardPage.a11yP3")} />
    <p set:html={t("cardPage.a11yP4")} />
    <p set:html={t("cardPage.a11yP5")} />
  </Fragment>
</ComponentPageShell>
