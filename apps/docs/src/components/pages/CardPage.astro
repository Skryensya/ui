---
/*
 * A composition guide, not a component page: there is no `sk-card`, no `@skryensya/react/card` and
 * no compiled contract to publish. This page therefore teaches the decision rule, not a gallery of
 * every card-looking thing the system can compose.
 */
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/checkbox.css";
import CodeBlock from "../CodeBlock.astro";
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import { cardCopy } from "../../examples/card-data";
import {
  cardActionTree,
  cardBasicTree,
  cardLinkTree,
  cardPlainMediaTree,
  cardProductTree,
  cardSelectTree,
} from "../../demos/card";
import { getLocale, localizePath, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);
const copy = cardCopy[locale];
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`cardPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const install = `# There is no Card package.
pnpm add @skryensya/core @skryensya/react

# Import the pieces your composition actually uses, for example:
@import "@skryensya/core/patterns/box.css";
@import "@skryensya/core/components/tile.css";
@import "@skryensya/core/components/checkbox.css";
@import "@skryensya/core/patterns/image-frame.css";`;
---

<ComponentPageShell
  title="Card"
  description={t("cardPage.description")}
  styleGroups={[
    { file: "patterns/box.css", probe: "sk-box", title: "Box" },
    { file: "components/tile.css", probe: "sk-tile", title: "Tile" },
    { file: "components/checkbox.css", probe: "sk-checkbox", title: "Checkbox" },
    { file: "patterns/image-frame.css", probe: "sk-image-frame", title: "ImageFrame" },
    { file: "components/badge.css", probe: "sk-badge", title: "Badge" },
    { file: "components/button.css", probe: "sk-button", title: "Button" },
    { file: "components/link.css", probe: "sk-link", title: "Link" },
  ]}
  testFiles={["apps/docs/src/examples/card-sources.test.ts", "apps/docs/src/components/pages/CardPage.test.ts"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("cardPage.lede")} />

    <div class="sk-callout" data-tone="info">
      <div class="sk-callout__content">
        <div class="sk-callout__description" set:html={t("cardPage.calloutBody")} />
      </div>
    </div>

    <h3>{t("cardPage.chooseTitle")}</h3>
    <p set:html={t("cardPage.chooseBody")} />
    <div class="sk-table-scroll">
      <table class="sk-table">
        <thead class="sk-table__head">
          <tr class="sk-table__row"><th class="sk-table__header">{t("cardPage.tableHeadSurface")}</th><th class="sk-table__header">{t("cardPage.tableHeadUses")}</th><th class="sk-table__header">{t("cardPage.tableHeadElement")}</th></tr>
        </thead>
        <tbody class="sk-table__body">
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow1Surface")}</td><td class="sk-table__cell"><a href={href("/components/box")}>Box</a></td><td set:html={t("cardPage.tableRow1Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow2Surface")}</td><td class="sk-table__cell"><a href={href("/components/link")}>TileLink</a></td><td set:html={t("cardPage.tableRow2Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow3Surface")}</td><td class="sk-table__cell"><a href={href("/components/button")}>TileButton</a></td><td set:html={t("cardPage.tableRow3Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow4Surface")}</td><td class="sk-table__cell"><a href={href("/components/checkbox")}>TileCheckbox</a></td><td set:html={t("cardPage.tableRow4Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow5Surface")}</td><td class="sk-table__cell"><a href={href("/components/radio-group")}>TileRadioGroup</a></td><td set:html={t("cardPage.tableRow5Element")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("cardPage.tableRow6Surface")}</td><td class="sk-table__cell"><a href={href("/components/accordion")}>Accordion</a></td><td set:html={t("cardPage.tableRow6Element")} class="sk-table__cell" /></tr>
        </tbody>
      </table>
    </div>

    <h3>{t("cardPage.showcaseTitle")}</h3>
    <p set:html={t("cardPage.showcaseBody")} />

    <UsagePreview
      tree={cardPlainMediaTree(copy)}
      title={t("cardPage.plainMediaTitle")}
      description={t("cardPage.plainMediaBody")}
      caption={t("cardPage.plainMediaNote")}
    />

    <UsagePreview
      tree={cardBasicTree(copy)}
      optionName="surface"
      target={["children", 0]}
      title={t("cardPage.prop.surface.title")}
      description={t("cardPage.prop.surface.body")}
      explain={explain("surface", ["none", "sunken", "surface", "raised"])}
      stageMinBlockSize="18rem"
    />

    <UsagePreview
      tree={cardBasicTree(copy)}
      optionName="padding"
      target={["children", 0]}
      title={t("cardPage.prop.padding.title")}
      description={t("cardPage.prop.padding.body")}
      explain={explain("padding", ["none", "xs", "sm", "md", "lg", "xl"])}
      stageMinBlockSize="18rem"
    />

    <UsagePreview
      tree={cardLinkTree(copy)}
      optionName="appearance"
      target={["children", 0]}
      title={t("cardPage.prop.appearance.title")}
      description={t("cardPage.prop.appearance.body")}
      explain={explain("appearance", ["plain", "tactile", "brutalist", "frosted"])}
      stageMinBlockSize="18rem"
    />

    <UsagePreview
      tree={cardActionTree(copy)}
      title={t("cardPage.actionTitle")}
      description={t("cardPage.actionBody")}
      caption={t("cardPage.actionNote")}
    />

    <UsagePreview
      tree={cardSelectTree(copy)}
      optionName="defaultChecked"
      target={["children", 0]}
      title={t("cardPage.prop.defaultChecked.title")}
      description={t("cardPage.prop.defaultChecked.body")}
      explain={explain("defaultChecked", ["false", "true"])}
      labels={{ false: t("cardPage.prop.defaultChecked.falseLabel"), true: t("cardPage.prop.defaultChecked.trueLabel") }}
      stageMinBlockSize="18rem"
    />

    <UsagePreview
      tree={cardProductTree(copy)}
      title={t("cardPage.productTitle")}
      description={t("cardPage.productBody")}
      caption={t("cardPage.productNote")}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("cardPage.guidelinesLede")} />

    <div class="sk-grid" data-columns="2" data-gap="md" data-multicol>
      <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="lg">
        <div class="sk-stack" data-gap="sm">
          <span class="sk-badge" data-tone="success">{t("cardPage.doTitle")}</span>
          <h3 class="sk-heading" data-size="h4">{t("cardPage.doHeading")}</h3>
          <ul>
            <li set:html={t("cardPage.doItem1")} />
            <li set:html={t("cardPage.doItem2")} />
            <li set:html={t("cardPage.doItem3")} />
            <li set:html={t("cardPage.doItem4")} />
            <li set:html={t("cardPage.doItem5")} />
          </ul>
        </div>
      </section>
      <section class="sk-box" data-surface="surface" data-border="subtle" data-padding="lg">
        <div class="sk-stack" data-gap="sm">
          <span class="sk-badge" data-tone="danger">{t("cardPage.dontTitle")}</span>
          <h3 class="sk-heading" data-size="h4">{t("cardPage.dontHeading")}</h3>
          <ul>
            <li set:html={t("cardPage.dontItem1")} />
            <li set:html={t("cardPage.dontItem2")} />
            <li set:html={t("cardPage.dontItem3")} />
            <li set:html={t("cardPage.dontItem4")} />
            <li set:html={t("cardPage.dontItem5")} />
          </ul>
        </div>
      </section>
    </div>

    <h3>{t("cardPage.geometryTitle")}</h3>
    <p set:html={t("cardPage.geometryBody")} />

    <h3>{t("cardPage.implTitle")}</h3>
    <p set:html={t("cardPage.implBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("cardPage.a11yP1")} />
    <p set:html={t("cardPage.a11yP2")} />
    <p set:html={t("cardPage.a11yP3")} />
    <p set:html={t("cardPage.a11yP4")} />
    <p set:html={t("cardPage.a11yP5")} />
  </Fragment>
</ComponentPageShell>
