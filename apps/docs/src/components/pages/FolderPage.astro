---
import "@skryensya/core/components/folder.css";
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
/* Not Folder's own sheet: every demo below stands the folders on a `Box`, because a folder at rest
 * is invisible by being its GROUND's colour and needs one to disappear against. Without this the
 * React stage renders that Box unpainted, the binding finds nothing painted to match, and the
 * folders fall back to the stylesheet's guess instead of the surface a reader can see. */
import "@skryensya/core/patterns/box.css";
/* The reveal demo fans a few `ImageFrame`s out of its folders, through the `previews` slot. */
import "@skryensya/core/patterns/image-frame.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  folderActiveTree,
  folderAnatomyCss,
  folderAnatomyTree,
  folderPlainTree,
  folderRaisedTree,
  folderSunkenTree,
  folderTree,
} from "../../demos/folder";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/components/folder.css";

/* Folder needs no other sheet. The demos on this page also import
   patterns/box.css, for the surface the folders stand on. */`;

const js = `import { mountFolder } from "@skryensya/vanilla/folder";

mountFolder();`;
---

<ComponentPageShell
  title="Folder"
  description={t("folderPage.description")}
  contractId="folder"
  testFiles={["packages/core/src/folder.test.ts", "packages/react/src/components/folder.test.tsx", "packages/vanilla/src/components/folder.test.ts"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("folderPage.lede")} />

    <p set:html={t("folderPage.anatomyBody")} />
    <ComponentPreview
      tree={folderAnatomyTree(t)}
      css={`${annotationDemoCss}\n${folderAnatomyCss}`}
      js={js}
      label={t("folderPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={folderTree(t)} js={js} label="FolderStack" viewport="auto" />

    <h3>{t("folderPage.revealTitle")}</h3>
    <p set:html={t("folderPage.revealBody")} />

    <h3>{t("folderPage.previewsTitle")}</h3>
    <p set:html={t("folderPage.previewsBody")} />
    <ComponentPreview tree={folderPlainTree(t)} js={js} label={t("folderPage.plainLabel")} viewport="auto" />

    <h3>{t("folderPage.touchTitle")}</h3>
    <p set:html={t("folderPage.touchBody")} />
    <ComponentPreview tree={folderActiveTree(t)} js={js} label={t("folderPage.touchLabel")} viewport="auto" />

    <h3>{t("folderPage.groundTitle")}</h3>
    <p set:html={t("folderPage.groundBody")} />
    <ComponentPreview tree={folderSunkenTree(t)} js={js} label={t("folderPage.groundSunkenLabel")} viewport="auto" />
    <ComponentPreview tree={folderRaisedTree(t)} js={js} label={t("folderPage.groundRaisedLabel")} viewport="auto" />

    <h3>{t("folderPage.shapeTitle")}</h3>
    <p set:html={t("folderPage.shapeBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("folderPage.contractItem1")} />
      <li set:html={t("folderPage.contractItem2")} />
      <li set:html={t("folderPage.contractItem3")} />
      <li set:html={t("folderPage.contractItem4")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
    <CodeBlock code={js} label="JS" lang="ts" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("folderPage.a11yBody")} />
    <ul>
      <li set:html={t("folderPage.a11yItem1")} />
      <li set:html={t("folderPage.a11yItem2")} />
      <li set:html={t("folderPage.a11yItem3")} />
    </ul>
  </Fragment>
</ComponentPageShell>
