---
import "@skryensya/core/components/folder.css";
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
/* Not Folder's own sheet: every demo below stands the folders on a `Box`, because a folder at rest
 * is invisible by being its GROUND's colour and needs one to disappear against. Without this the
 * React stage renders that Box unpainted, the binding finds nothing painted to match, and the
 * folders fall back to the stylesheet's guess instead of the surface a reader can see. */
import "@skryensya/core/patterns/box.css";
/* The reveal demo fans a few `ImageFrame`s out of its folders, through the `previews` slot. */
import "@skryensya/core/patterns/image-frame.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  folderActiveTree,
  folderAlbumsTree,
  folderAppearanceTree,
  folderAnatomyCss,
  folderAnatomyTree,
  folderDoCollectionTree,
  folderDoNamesTree,
  folderDoSameKindTree,
  folderDontMixedKindTree,
  folderDontNamesTree,
  folderDontSingleTree,
  folderFilesTree,
  folderPlainTree,
  folderRaisedTree,
  folderSunkenTree,
  folderTree,
} from "../../demos/folder";
import { annotationDemoCss } from "../../demos/annotation";
import { onAppearanceStage } from "../../lib/frost-stage";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const storybookTitle = "Components/Content/Folder";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`folderPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const styles = `@import "@skryensya/core/components/folder.css";

/* Folder needs no other sheet. The demos on this page also import
   patterns/box.css, for the surface the folders stand on. */`;

const js = `import { mountFolder } from "@skryensya/vanilla/folder";

mountFolder();`;
---

<ComponentPageShell
  title="Folder"
  description={t("folderPage.description")}
  contractId="folder"
  appearanceTargetSelector=".sk-folder"
  testFiles={["packages/core/src/folder.test.ts", "packages/react/src/components/folder.test.tsx", "packages/vanilla/src/components/folder.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("folderPage.lede")} />

    <UsagePreview
      tree={folderAppearanceTree(t)}
      optionName="active"
      target={["children", "children", 0]}
      title={t("folderPage.prop.active.title")}
      description={t("folderPage.prop.active.body")}
      explain={explain("active", ["false", "true"])}
      stageMinBlockSize="18rem"
      storybookTitle={storybookTitle}
      storybookStory="Appearance"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={folderTree(t)} title={t("folderPage.stackTitle")} description={t("folderPage.stackBody")} stageMinBlockSize="24rem" storybookTitle={storybookTitle} storybookStory="Default" />
    <UsagePreview tree={folderAlbumsTree(t)} title={t("folderPage.albumsTitle")} description={t("folderPage.albumsBody")} stageMinBlockSize="24rem" />
    <UsagePreview tree={folderFilesTree(t)} title={t("folderPage.filesTitle")} description={t("folderPage.filesBody")} stageMinBlockSize="22rem" />
    <UsagePreview tree={folderPlainTree(t)} title={t("folderPage.previewsTitle")} description={t("folderPage.previewsBody")} stageMinBlockSize="22rem" storybookTitle={storybookTitle} storybookStory="Plain" />
    <UsagePreview tree={folderActiveTree(t)} title={t("folderPage.touchTitle")} description={t("folderPage.touchBody")} stageMinBlockSize="24rem" storybookTitle={storybookTitle} storybookStory="Active" />
    <UsagePreview tree={folderSunkenTree(t)} title={t("folderPage.groundTitle")} description={t("folderPage.groundBody")} storybookTitle={storybookTitle} storybookStory="Sunken" />
    <UsagePreview tree={folderRaisedTree(t)} storybookTitle={storybookTitle} storybookStory="Raised" />
    <UsagePreview tree={onAppearanceStage(folderAppearanceTree(t))} title={t("folderPage.appearanceTitle")} description={t("folderPage.appearanceBody")} stageMinBlockSize="18rem" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "folderPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("folderPage.anatomyBody")} />
    <UsagePreview
      tree={folderAnatomyTree(t)}
      css={`${annotationDemoCss}\n${folderAnatomyCss}`}
      label={t("folderPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("folderPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "folderPage.when")} avoid={tList(t, "folderPage.whenNot")} />
    <DoDont
      canvas
      title={t("folderPage.dd.collection.title")}
      do={{ tree: folderDoCollectionTree(t), caption: t("folderPage.dd.collection.do") }}
      dont={{ tree: folderDontSingleTree(t), caption: t("folderPage.dd.collection.dont") }}
    />
    <DoDont
      canvas
      title={t("folderPage.dd.names.title")}
      do={{ tree: folderDoNamesTree(t), caption: t("folderPage.dd.names.do") }}
      dont={{ tree: folderDontNamesTree(t), caption: t("folderPage.dd.names.dont") }}
    />
    <DoDont
      canvas
      title={t("folderPage.dd.kind.title")}
      do={{ tree: folderDoSameKindTree(t), caption: t("folderPage.dd.kind.do") }}
      dont={{ tree: folderDontMixedKindTree(t), caption: t("folderPage.dd.kind.dont") }}
    />
    <ContentRules items={tList(t, "folderPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
    <CodeBlock code={js} label="JS" lang="ts" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("folderPage.a11yIntro")} does={tList(t, "folderPage.a11yDoes")} yours={tList(t, "folderPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
