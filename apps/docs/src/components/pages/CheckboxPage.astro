---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/checkbox.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { checkboxAnatomyTree, checkboxGroupTree, checkboxTree, tileCheckboxTree } from "../../demos/checkbox";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const tileCheckboxVanilla = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// ${t("checkbox.iconsComment1")}
// ${t("checkbox.iconsComment2")}
mountIcons(document, lucideIcons);

// ${t("checkbox.iconsComment3").split("\n").join("\n// ")}
// ${t("checkbox.iconsComment4")}
await initComponents();

for (const root of document.querySelectorAll(
  "[data-sk-tile-checkbox]",
)) {
  root.addEventListener("sk:checkedchange", (event) => {
    console.log(root.dataset.value, event.detail.checked);
  });
}`;
---

<ComponentPageShell
  title="Checkbox"
  description={t("checkbox.description")}
  contractId="checkbox"
  styleGroups={[{ file: "components/checkbox.css", probe: "sk-checkbox" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/checkbox-group.svelte.test.ts",
      tests: [
        {
          name: "derives the parent's three states from its children on mount and on every change",
          description: t("checkbox.groupTest1"),
        },
        {
          name: "checks and unchecks every child from the parent, and reports what changed",
          description: t("checkbox.groupTest2"),
        },
        {
          name: "leaves a disabled child alone and does not let it hold the parent back from 'all'",
          description: t("checkbox.groupTest3"),
        },
        {
          name: "counts only its own children, never a nested group's",
          description: t("checkbox.groupTest4"),
        },
        {
          name: "re-derives the parent after a form reset, which restores the children silently",
          description: t("checkbox.groupTest5"),
        },
      ],
    },
    {
      file: "packages/vanilla/src/components/tile-checkbox.svelte.test.ts",
      tests: [
        {
          name: "toggles checked state and root data-state on click, emitting sk:checkedchange",
          description: t("checkbox.test1"),
        },
        { name: "is form-associated and honours its default-checked", description: t("checkbox.test2") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("checkbox.lede")} />

    <p set:html={t("checkbox.anatomyBody")} />
    <ComponentPreview
      tree={checkboxAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("checkbox.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={checkboxTree(t)} label="Checkbox" />
    <p set:html={t("checkbox.body")} />

    <h3>{t("checkbox.groupTitle")}</h3>
    <p set:html={t("checkbox.groupBody1")} />
    <ComponentPreview
      tree={checkboxGroupTree(t)}
      label="CheckboxGroup"
      note={t("checkbox.groupNote")}
    />
    <p set:html={t("checkbox.groupBody2")} />
    <p set:html={t("checkbox.groupBody3")} />

    <h3>{t("checkbox.tileTitle")}</h3>
    <p set:html={t("checkbox.tileBody1")} />
    <ComponentPreview tree={tileCheckboxTree(t)} label="TileCheckbox" />
    <p set:html={t("checkbox.tileBody2")} />
    <CodeBlock code={tileCheckboxVanilla} label="JavaScript" />

    <p set:html={`${t("component.reactNote")} ${t("checkbox.reactBody")}`} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("checkbox.contractItem1")} />
      <li set:html={t("checkbox.contractItem2")} />
      <li set:html={t("checkbox.contractItem3")} />
      <li set:html={t("checkbox.contractItem4")} />
      <li set:html={t("checkbox.contractItem5")} />
      <li set:html={t("checkbox.contractItem6")} />
      <li set:html={t("checkbox.contractItem7")} />
    </ul>
  </Fragment>
</ComponentPageShell>
