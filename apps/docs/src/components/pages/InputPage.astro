---
/* The anatomy diagram is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import { annotationDemoCss } from "../../demos/annotation";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  inputAnatomyTree,
  inputDoLabelTree,
  inputDoLongTree,
  inputDontLongTree,
  inputDontPlaceholderTree,
  inputFormatTree,
  inputSingleTree,
  inputTree,
  textareaTree,
} from "../../demos/input";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));

const phoneSetup = `pnpm add @skryensya/phone

// once, at application startup
import { registerPhoneFormat } from "@skryensya/phone";
registerPhoneFormat();`;

const css = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/input.css";
@import "@skryensya/core/components/form-field.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`inputPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title={t("inputPage.title")}
  description={t("inputPage.description")}
  contractId="input"
  appearanceTargetSelector=".sk-input"
  testFiles={[
    /* The arithmetic first: the page claims these formats are checked for real, and this is the
       suite that proves it. The two bindings below prove they both ask it the same question. */
    "packages/core/src/input-format.test.ts",
    "packages/phone/src/index.test.ts",
    "packages/react/src/components/input.test.tsx",
    "packages/vanilla/src/components/input.test.ts",
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("inputPage.lede")} />

    <UsagePreview
      tree={inputSingleTree(t)}
      optionName="appearance"
      title={t("inputPage.prop.appearance.title")}
      description={t("inputPage.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist", "frosted"])}
      stageMinBlockSize="8rem"
      target={["children"]}
    />

    <UsagePreview
      tree={inputSingleTree(t)}
      optionName="controlSize"
      title={t("inputPage.prop.controlSize.title")}
      description={t("inputPage.prop.controlSize.body")}
      explain={explain("controlSize", ["sm", "md", "lg"])}
      stageMinBlockSize="8rem"
      labels={{ sm: "sm", md: "md", lg: "lg" }}
      target={["children"]}
    />

    <UsagePreview
      tree={inputSingleTree(t)}
      optionName="disabled"
      title={t("inputPage.prop.disabled.title")}
      description={t("inputPage.prop.disabled.body")}
      explain={explain("disabled", ["false", "true"])}
      stageMinBlockSize="8rem"
      labels={{ false: t("inputPage.prop.disabled.falseLabel"), true: t("inputPage.prop.disabled.trueLabel") }}
      target={["children"]}
    />

    <h3>{t("inputPage.showcaseTitle")}</h3>
    <p set:html={t("inputPage.showcaseBody")} />
    <UsagePreview tree={inputTree(t)} />
    <p set:html={t("inputPage.densityBody")} />

    <h3>{t("inputPage.oneClassTitle")}</h3>
    <p set:html={t("inputPage.oneClassBody")} />
    <UsagePreview tree={textareaTree(t)} />
    <h3>{t("inputPage.formFieldTitle")}</h3>
    <p set:html={t("inputPage.formFieldBody")} />

    <h3>{t("inputPage.formatTitle")}</h3>
    <p set:html={t("inputPage.formatBody")} />
    <UsagePreview tree={inputFormatTree(t)} />
    <p set:html={t("inputPage.formatCheckBody")} />
    <p set:html={t("inputPage.formatMessageBody")} />

    <h4>{t("inputPage.formatPhoneTitle")}</h4>
    <p set:html={t("inputPage.formatPhoneBody")} />
    <p set:html={t("inputPage.formatPhoneUsage")} />
    <CodeBlock code={phoneSetup} label="TypeScript" />
    <p set:html={t("inputPage.formatPhoneMissing")} />
    <p set:html={t("inputPage.formatPhoneEvidence")} />

    <h3>{t("inputPage.nativeTitle")}</h3>
    <p set:html={t("inputPage.nativeBody")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("inputPage.anatomyBody")} />
    <ComponentPreview
      tree={inputAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("inputPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("inputPage.guidelinesLede")} />
    <DoDont
      title={t("inputPage.dd.label.title")}
      do={{ tree: inputDoLabelTree(t), caption: t("inputPage.dd.label.do") }}
      dont={{ tree: inputDontPlaceholderTree(t), caption: t("inputPage.dd.label.dont") }}
    />
    <DoDont
      title={t("inputPage.dd.long.title")}
      do={{ tree: inputDoLongTree(t), caption: t("inputPage.dd.long.do") }}
      dont={{ tree: inputDontLongTree(t), caption: t("inputPage.dd.long.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" />
  </Fragment>
</ComponentPageShell>
