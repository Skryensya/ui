---
import "@skryensya/core/components/tabs.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  tabsAdvancedScript,
  tabsAdvancedTree,
  tabsAnatomyTree,
  tabsBasicTree,
  tabsDontManyTree,
  tabsDontStepsTree,
  tabsStatesTree,
} from "../../demos/tabs";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const css = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/tabs.css";
@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/patterns/layout.css";`;

const vanillaJs = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);
await initComponents();`;

const t = useTranslations(getLocale(Astro.url));

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`tabsPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Tabs"
  description={t("tabsPage.description")}
  contractId="tabs"
  testFiles={["packages/react/src/components/tabs.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tabsPage.lede")} />

    <UsagePreview
      tree={tabsBasicTree(t)}
      optionName="variant"
      title={t("tabsPage.prop.variant.title")}
      description={t("tabsPage.prop.variant.body")}
      explain={explain("variant", ["underline", "hanging"])}
      stageMinBlockSize="12rem"
    />

    <UsagePreview
      tree={tabsBasicTree(t)}
      optionName="size"
      title={t("tabsPage.prop.size.title")}
      description={t("tabsPage.prop.size.body")}
      explain={explain("size", ["sm", "md"])}
      stageMinBlockSize="12rem"
      labels={{ sm: "sm", md: "md" }}
    />

    <UsagePreview
      tree={tabsBasicTree(t)}
      optionName="orientation"
      title={t("tabsPage.prop.orientation.title")}
      description={t("tabsPage.prop.orientation.body")}
      explain={explain("orientation", ["horizontal", "vertical"])}
      stageMinBlockSize="14rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={tabsBasicTree(t)} title={t("tabsPage.basicTitle")} description={t("tabsPage.basicBody")} />
    <UsagePreview tree={tabsStatesTree(t)} title={t("tabsPage.statesTitle")} description={t("tabsPage.statesBody")} />
    <UsagePreview tree={tabsAdvancedTree(t)} script={tabsAdvancedScript} title={t("tabsPage.advancedTitle")} description={t("tabsPage.advancedBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "tabsPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("tabsPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("tabsPage.anatomyBody")} />
    <UsagePreview tree={tabsAnatomyTree(t)} css={annotationDemoCss} label={t("tabsPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tabsPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "tabsPage.when")} avoid={tList(t, "tabsPage.whenNot")} />
    <DoDont
      canvas
      title={t("tabsPage.dd.few.title")}
      do={{ tree: tabsBasicTree(t), caption: t("tabsPage.dd.few.do") }}
      dont={{ tree: tabsDontManyTree(t), caption: t("tabsPage.dd.few.dont") }}
    />
    <DoDont
      title={t("tabsPage.dd.steps.title")}
      do={{ tree: tabsBasicTree(t), caption: t("tabsPage.dd.steps.do") }}
      dont={{ tree: tabsDontStepsTree(t), caption: t("tabsPage.dd.steps.dont") }}
    />
    <ContentRules items={tList(t, "tabsPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" lang="css" />

    <h3>{t("tabsPage.vanillaInitTitle")}</h3>
    <p set:html={t("tabsPage.vanillaInitBody")} />
    <CodeBlock code={vanillaJs} label="JavaScript" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes
      intro={t("tabsPage.a11yIntro")}
      does={tList(t, "tabsPage.a11yDoes")}
      yours={tList(t, "tabsPage.a11yYours")}
      keys={[
        { keys: ["←", "→"], action: t("tabsPage.key.arrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("tabsPage.key.homeEnd") },
        { keys: ["Tab"], action: t("tabsPage.key.tab") },
        { keys: ["Enter", t("component.key.space")], action: t("tabsPage.key.select") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
