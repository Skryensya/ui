---
import "@skryensya/core/components/tabs.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  tabsAdvancedScript,
  tabsAdvancedTree,
  tabsAnatomyTree,
  tabsBasicTree,
  tabsDontManyTree,
  tabsDontStepsTree,
  tabsHangingTree,
  tabsSizeTree,
  tabsStatesTree,
} from "../../demos/tabs";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const css = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/tabs.css";
@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/patterns/layout.css";`;

const vanillaJs = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);
await initComponents();`;

const t = useTranslations(getLocale(Astro.url));

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`tabsPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Tabs"
  description={t("tabsPage.description")}
  contractId="tabs"
  appearanceTargetSelector=".sk-tabs"
  testFiles={["packages/react/src/components/tabs.test.tsx"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("tabsPage.lede")} />

    <UsagePreview
      tree={tabsBasicTree(t)}
      optionName="variant"
      title={t("tabsPage.prop.variant.title")}
      description={t("tabsPage.prop.variant.body")}
      explain={explain("variant", ["underline", "hanging"])}
      stageMinBlockSize="12rem"
    />

    <UsagePreview
      tree={tabsBasicTree(t)}
      optionName="size"
      title={t("tabsPage.prop.size.title")}
      description={t("tabsPage.prop.size.body")}
      explain={explain("size", ["sm", "md"])}
      stageMinBlockSize="12rem"
      labels={{ sm: "sm", md: "md" }}
    />

    <UsagePreview
      tree={tabsBasicTree(t)}
      optionName="orientation"
      title={t("tabsPage.prop.orientation.title")}
      description={t("tabsPage.prop.orientation.body")}
      explain={explain("orientation", ["horizontal", "vertical"])}
      stageMinBlockSize="14rem"
    />

    <UsagePreview
      tree={tabsBasicTree(t)}
      optionName="appearance"
      title={t("tabsPage.prop.appearance.title")}
      description={t("tabsPage.prop.appearance.body")}
      explain={explain("appearance", ["plain", "tactile", "brutalist", "frosted"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("tabsPage.showcaseTitle")}</h3>
    <p set:html={t("tabsPage.showcaseBody")} />
    <h3>{t("tabsPage.basicTitle")}</h3>
    <p set:html={t("tabsPage.basicBody")} />
    <UsagePreview tree={tabsBasicTree(t)} />

    <h3>{t("tabsPage.statesTitle")}</h3>
    <p set:html={t("tabsPage.statesBody")} />
    <UsagePreview tree={tabsStatesTree(t)} />

    <h3>{t("tabsPage.advancedTitle")}</h3>
    <p set:html={t("tabsPage.advancedBody")} />
    <ComponentPreview tree={tabsAdvancedTree(t)} js={tabsAdvancedScript} previewScript={tabsAdvancedScript} label={t("tabsPage.advancedLabel")} />

    <h3>{t("tabsPage.sizeTitle")}</h3>
    <p set:html={t("tabsPage.sizeBody")} />
    <UsagePreview tree={tabsSizeTree(t)} />

    <h3>{t("tabsPage.hangingTitle")}</h3>
    <p set:html={t("tabsPage.hangingBody")} />
    <UsagePreview tree={tabsHangingTree(t)} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("tabsPage.contractItem1")} />
      <li set:html={t("tabsPage.contractItem2")} />
      <li set:html={t("tabsPage.contractItem3")} />
      <li set:html={t("tabsPage.contractItem4")} />
      <li set:html={t("tabsPage.contractItem5")} />
      <li set:html={t("tabsPage.contractItem6")} />
    </ul>

    <p set:html={t("tabsPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("tabsPage.anatomyBody")} />
    <ComponentPreview
      tree={tabsAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("tabsPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tabsPage.guidelinesLede")} />
    <DoDont
      canvas
      title={t("tabsPage.dd.few.title")}
      do={{ tree: tabsBasicTree(t), caption: t("tabsPage.dd.few.do") }}
      dont={{ tree: tabsDontManyTree(t), caption: t("tabsPage.dd.few.dont") }}
    />
    <DoDont
      title={t("tabsPage.dd.steps.title")}
      do={{ tree: tabsBasicTree(t), caption: t("tabsPage.dd.steps.do") }}
      dont={{ tree: tabsDontStepsTree(t), caption: t("tabsPage.dd.steps.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" lang="css" />

    <h3>{t("tabsPage.vanillaInitTitle")}</h3>
    <p set:html={t("tabsPage.vanillaInitBody")} />
    <CodeBlock code={vanillaJs} label="JavaScript" />
  </Fragment>
</ComponentPageShell>
