---
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/components/avatar.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  carouselAnatomyTree,
  carouselAutoplayTree,
  carouselBareTree,
  carouselCardsTree,
  carouselFocusableTree,
  carouselStatsTree,
  carouselQuotesTree,
  carouselProductsTree,
  carouselDontFewTree,
} from "../../demos/carousel";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/button.css";
import "@skryensya/core/patterns/state-layer.css";
import "@skryensya/core/components/carousel.css";
import "@skryensya/core/components/fade-edge.css";
import "@skryensya/icons-phosphor/carousel.css";
import "../../examples/carousel.css";

const t = useTranslations(getLocale(Astro.url));

const storybookTitle = "Components/Carousel";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`carousel.prop.${option}.${value}` as Parameters<typeof t>[0])]));

// The dot box is 1.5rem (the 24px target minimum); at 0.8 zoom it would draw 19px, so it is sized up by the same factor.
const zoomOut = ".sk-carousel { zoom: 0.8; } .sk-carousel__dot { --sk-carousel-dot-box: 1.875rem; }";

const installIcons = `pnpm add @skryensya/icons-phosphor`;

const bootstrap = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { phosphorIcons } from "@skryensya/icons-phosphor";

mountIcons(document, phosphorIcons);
await initComponents(); // ${t("carousel.bootstrapComment")}`;

const api = `const carousel = document.querySelector("[data-sk-carousel]");

// ${t("carousel.apiComment1")}
carousel.dispatchEvent(new CustomEvent("sk:carouselgoto", { detail: { index: 2 } }));

// ${t("carousel.apiComment2")}
carousel.addEventListener("sk:carouselchange", (event) => {
  console.log(event.detail); // ${t("carousel.apiComment3")}
});`;
import { carouselTitlesDoTree, carouselTitlesDontTree } from "../../demos/dodont-more";
---

<ComponentPageShell
  hookPlayground={{ tree: carouselCardsTree(t) }}
  title="Carousel"
  description={t("carousel.description")}
  contractId="carousel"
  badge="Beta"
  extraSheets={["@skryensya/core/components/button.css", "@skryensya/core/patterns/state-layer.css", "@skryensya/icons-phosphor/carousel.css", "@skryensya/core/components/fade-edge.css", "@skryensya/core/patterns/image-frame.css", "@skryensya/core/patterns/media-overlay.css"]}
  vanillaInstallSteps={[
    { title: t("install.stepInstall"), blocks: [{ kind: "code", code: installIcons, lang: "bash", label: "terminal" }] },
    { title: t("install.stepMount"), blocks: [{ kind: "code", code: bootstrap, lang: "ts", label: "JavaScript" }] },
  ]}
  reactInstallSteps={[{ title: t("install.stepInstall"), blocks: [{ kind: "code", code: installIcons, lang: "bash", label: "terminal" }] }]}
  testFiles={["packages/react/src/components/carousel.test.tsx", "packages/vanilla/src/components/carousel.svelte.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("carousel.lede")} />

    <UsagePreview
      tree={carouselCardsTree(t)}
      optionName="controls"
      title={t("carousel.prop.controls.title")}
      description={t("carousel.prop.controls.body")}
      explain={explain("controls", ["auto", "none"])}
      stageMinBlockSize="24rem"
      css={zoomOut}
      storybookTitle={storybookTitle}
      storybookStory="Cards" />
    <UsagePreview
      tree={carouselCardsTree(t)}
      optionName="indicator"
      title={t("carousel.prop.indicator.title")}
      description={t("carousel.prop.indicator.body")}
      explain={explain("indicator", ["dots", "count"])}
      stageMinBlockSize="24rem"
      css={zoomOut}
      storybookTitle={storybookTitle}
      storybookStory="Cards" />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview css={zoomOut} tree={carouselCardsTree(t)} title={t("carousel.cardsTitle")} description={t("carousel.cardsBody")} storybookTitle={storybookTitle} storybookStory="Cards" />
    <UsagePreview css={zoomOut} tree={carouselAutoplayTree(t)} title={t("carousel.multiTitle")} description={t("carousel.multiBody1")} storybookTitle={storybookTitle} storybookStory="Autoplay" />
    <UsagePreview css={zoomOut} tree={carouselFocusableTree(t)} title={t("carousel.focusTitle")} description={t("carousel.focusBody1")} storybookTitle={storybookTitle} storybookStory="Focusable" />
    <UsagePreview css={zoomOut} tree={carouselStatsTree(t)} title={t("carousel.statsTitle")} description={t("carousel.statsBody")} storybookTitle={storybookTitle} storybookStory="Stats" />
    <UsagePreview css={zoomOut} tree={carouselQuotesTree(t)} title={t("carousel.quotesTitle")} description={t("carousel.quotesBody")} storybookTitle={storybookTitle} storybookStory="Quotes" />
    <UsagePreview css={zoomOut} tree={carouselProductsTree(t)} title={t("carousel.productsTitle")} description={t("carousel.productsBody")} storybookTitle={storybookTitle} storybookStory="Products" />
    <UsagePreview css={zoomOut} tree={carouselBareTree(t)} title={t("carousel.bareTitle")} description={t("carousel.bareBody1")} storybookTitle={storybookTitle} storybookStory="Bare" />

    <h3>{t("carousel.apiTitle")}</h3>
    <p set:html={t("carousel.apiBody")} />
    <CodeBlock code={api} label="JS" lang="ts" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "carousel.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("carousel.anatomyBody")} />
    <UsagePreview
      tree={carouselAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("carousel.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("carousel.guidelinesLede")} />
    <WhenToUse use={tList(t, "carousel.when")} avoid={tList(t, "carousel.whenNot")} />
    <DoDont
      canvas
      title={t("carousel.dd.few.title")}
      do={{ tree: carouselCardsTree(t), caption: t("carousel.dd.few.do") }}
      dont={{ tree: carouselDontFewTree(t), caption: t("carousel.dd.few.dont") }}
    />
    <DoDont
      title={t("dd3.carousel.title")}
      do={{ tree: carouselTitlesDoTree(t), caption: t("dd3.carousel.do") }}
      dont={{ tree: carouselTitlesDontTree(t), caption: t("dd3.carousel.dont") }}
    />
    <ContentRules items={tList(t, "carousel.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("carousel.a11yIntro")}
      does={tList(t, "carousel.a11yDoes")}
      yours={tList(t, "carousel.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("carousel.a11yKeyTab") },
        { keys: ["←", "→"], action: t("carousel.a11yKeyArrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("carousel.a11yKeyHomeEnd") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
