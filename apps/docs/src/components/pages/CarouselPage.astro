---
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  carouselAnatomyTree,
  carouselAutoplayTree,
  carouselBareTree,
  carouselCardsTree,
  carouselFocusableTree,
  carouselNativeTree,
  carouselDontFewTree,
} from "../../demos/carousel";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/carousel.css";
import "@skryensya/icons-lucide/carousel.css";
import "../../examples/carousel.css";

const t = useTranslations(getLocale(Astro.url));

const storybookTitle = "Components/Content/Carousel";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`carousel.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const install = `pnpm add @skryensya/core @skryensya/vanilla \\
  @skryensya/icons-lucide`;

const styles = `@import "@skryensya/core/components/carousel.css";
@import "@skryensya/icons-lucide/carousel.css";
@import "@skryensya/core/patterns/image-frame.css";
@import "@skryensya/core/patterns/media-gradient.css";`;

const bootstrap = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);
await initComponents(); // ${t("carousel.bootstrapComment")}`;

const nativeCss = `@import "@skryensya/icons-lucide/carousel.css";

/* ${t("carousel.nativeCssComment1")} */
.sk-carousel__track { scroll-marker-group: after; }
.sk-carousel__track::scroll-button(inline-start) {
  content: var(--sk-carousel-native-previous-icon) / "${t("carousel.nativeCssComment2")}";
  grid-column: 1;
}
.sk-carousel__track::scroll-button(inline-end) {
  content: var(--sk-carousel-native-next-icon) / "${t("carousel.nativeCssComment3")}";
  grid-column: 3;
}
.sk-carousel__track::scroll-marker-group {
  grid-column: 2; /* ${t("carousel.nativeCssComment4")} */
}
.sk-carousel__slide::scroll-marker { content: ""; }
.sk-carousel__slide::scroll-marker:target-current { /* activo */ }

/* ${t("carousel.nativeCssComment5")} */`;

const api = `const carousel = document.querySelector("[data-sk-carousel]");

// ${t("carousel.apiComment1")}
carousel.dispatchEvent(new CustomEvent("sk:carouselgoto", { detail: { index: 2 } }));

// ${t("carousel.apiComment2")}
carousel.addEventListener("sk:carouselchange", (event) => {
  console.log(event.detail); // ${t("carousel.apiComment3")}
});`;
---

<ComponentPageShell
  title="Carousel"
  description={t("carousel.description")}
  contractId="carousel"
  testFiles={["packages/react/src/components/carousel.test.tsx", "packages/vanilla/src/components/carousel.svelte.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("carousel.lede")} />

    <UsagePreview
      tree={carouselCardsTree(t)}
      optionName="controls"
      title={t("carousel.prop.controls.title")}
      description={t("carousel.prop.controls.body")}
      explain={explain("controls", ["auto", "none"])}
      stageMinBlockSize="24rem"
      storybookTitle={storybookTitle}
      storybookStory="Cards"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={carouselCardsTree(t)} title={t("carousel.cardsTitle")} description={t("carousel.cardsBody")} storybookTitle={storybookTitle} storybookStory="Cards" />
    <UsagePreview tree={carouselAutoplayTree(t)} title={t("carousel.multiTitle")} description={t("carousel.multiBody1")} storybookTitle={storybookTitle} storybookStory="Autoplay" />
    <UsagePreview tree={carouselFocusableTree(t)} title={t("carousel.focusTitle")} description={t("carousel.focusBody1")} storybookTitle={storybookTitle} storybookStory="Focusable" />
    <UsagePreview tree={carouselBareTree(t)} title={t("carousel.bareTitle")} description={t("carousel.bareBody1")} storybookTitle={storybookTitle} storybookStory="Bare" />

    {/* ComponentPreview, not UsagePreview: this one is the markup WITHOUT the enhancer, which only a
        Vanilla frame can show; the React stage always mounts the machine. */}
    <h3>{t("carousel.nativeTitle")}</h3>
    <p set:html={t("carousel.nativeBody")} />
    <UsagePreview tree={carouselNativeTree(t)} label={t("carousel.nativeLabel")} caption={t("carousel.nativeNote")} />
    <CodeBlock code={nativeCss} label={t("carousel.nativeCssLabel")} lang="css" />

    <h3>{t("carousel.apiTitle")}</h3>
    <p set:html={t("carousel.apiBody")} />
    <CodeBlock code={api} label="JS" lang="ts" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "carousel.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("carousel.anatomyBody")} />
    <UsagePreview
      tree={carouselAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("carousel.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("carousel.guidelinesLede")} />
    <WhenToUse use={tList(t, "carousel.when")} avoid={tList(t, "carousel.whenNot")} />
    <DoDont
      canvas
      title={t("carousel.dd.few.title")}
      do={{ tree: carouselCardsTree(t), caption: t("carousel.dd.few.do") }}
      dont={{ tree: carouselDontFewTree(t), caption: t("carousel.dd.few.dont") }}
    />
    <ContentRules items={tList(t, "carousel.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
    <CodeBlock code={bootstrap} label="JavaScript" lang="ts" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("carousel.a11yIntro")}
      does={tList(t, "carousel.a11yDoes")}
      yours={tList(t, "carousel.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("carousel.a11yKeyTab") },
        { keys: ["←", "→"], action: t("carousel.a11yKeyArrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("carousel.a11yKeyHomeEnd") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
