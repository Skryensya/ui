---
/* The skin is already global (Base.astro imports it for the ⌘K badge), so this page needs no import. */
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { kbdAccentTree, kbdAnatomyTree, kbdTree } from "../../demos/kbd";
import { getLocale, useTranslations } from "../../i18n";
import { annotationDemoCss } from "../../demos/annotation";
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
---

<ComponentPageShell
  title="Kbd"
  description={t("kbdPage.description")}
  contractId="kbd"
  testFiles={["packages/react/src/components/kbd.test.tsx"]}}
>
  <Fragment slot="anatomy">
    <p set:html={t("kbdPage.anatomyBody")} />
    <ComponentPreview
      tree={kbdAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("kbdPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("kbdPage.lede")} />
    <ComponentPreview tree={kbdTree} label="Kbd" />

    <h3>{t("kbdPage.toneTitle")}</h3>
    <p set:html={t("kbdPage.toneBody")} />
    <ComponentPreview tree={kbdAccentTree} label="Kbd accent" />

    <h3>{t("kbdPage.squareTitle")}</h3>
    <p set:html={t("kbdPage.squareBody")} />

    <h3>{t("kbdPage.pressedTitle")}</h3>
    <p set:html={t("kbdPage.pressedBody1")} />
    <p set:html={t("kbdPage.pressedBody2")} />
    <div class="key-echo" role="group" aria-label={t("kbdPage.echoAriaLabel")}>
      <kbd class="sk-kbd" data-key="meta">⌘</kbd>
      <kbd class="sk-kbd" data-key="control">Ctrl</kbd>
      <kbd class="sk-kbd" data-key="shift">⇧</kbd>
      <kbd class="sk-kbd" data-key="k">K</kbd>
      <kbd class="sk-kbd" data-key="escape">Esc</kbd>
      <kbd class="sk-kbd" data-key="enter">↵</kbd>
      <kbd class="sk-kbd" data-key="arrowup">↑</kbd>
      <kbd class="sk-kbd" data-key="arrowdown">↓</kbd>
      <kbd class="sk-kbd" data-key="/">/</kbd>
    </div>
    <p set:html={t("kbdPage.chordBody")} />
    <p set:html={t("kbdPage.scriptBody")} />

    <p set:html={t("component.reactNote")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>

<style>
  .key-echo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-sm);
    align-items: center;
    margin-block: var(--space-stack-md);
  }
</style>

<script>
  import { initKeyEcho } from "../../scripts/key-echo";
  initKeyEcho();
</script>
