---
/* The skin is already global (Base.astro imports it for the ⌘K badge), so this page needs no import. */
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  kbdAccentTree,
  kbdAnatomyTree,
  kbdDoAccentTree,
  kbdDoChordTree,
  kbdDoInlineTree,
  kbdDontAccentTree,
  kbdDontAloneTree,
  kbdDontChordTree,
  kbdSingleTree,
  kbdTree,
} from "../../demos/kbd";
import { getLocale, tList, useTranslations } from "../../i18n";
import { annotationDemoCss } from "../../demos/annotation";
import "@skryensya/core/components/annotation.css";
/* Do/Don't specimens use a small surface so the key rows read as examples, not loose glyphs. */
import "@skryensya/core/patterns/box.css";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const storybookTitle = "Components/Content/Kbd";

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`kbdPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Kbd"
  description={t("kbdPage.description")}
  contractId="kbd"
  appearanceTargetSelector=".sk-kbd"
  testFiles={["packages/react/src/components/kbd.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable"), frosted: t("prefs.appearanceFrostedUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("kbdPage.lede")} />

    <UsagePreview
      tree={kbdSingleTree}
      optionName="tone"
      title={t("kbdPage.prop.tone.title")}
      description={t("kbdPage.prop.tone.body")}
      explain={explain("tone", ["neutral", "accent"])}
      stageMinBlockSize="7rem"
    />
    <UsagePreview
      tree={kbdSingleTree}
      optionName="appearance"
      title={t("kbdPage.prop.appearance.title")}
      description={t("kbdPage.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist"])}
      stageMinBlockSize="7rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview
      tree={kbdTree}
      title={t("kbdPage.keysTitle")}
      description={t("kbdPage.keysBody")}
      storybookTitle={storybookTitle}
      storybookStory="Default"
    />
    <UsagePreview
      tree={kbdAccentTree}
      title={t("kbdPage.accentTitle")}
      description={t("kbdPage.toneBody")}
      storybookTitle={storybookTitle}
      storybookStory="Accent"
    />


    <h3>{t("kbdPage.pressedTitle")}</h3>
    <p set:html={t("kbdPage.pressedBody1")} />
    <div class="key-echo" role="group" aria-label={t("kbdPage.echoAriaLabel")}>
      <kbd class="sk-kbd" data-key="meta">⌘</kbd>
      <kbd class="sk-kbd" data-key="control">Ctrl</kbd>
      <kbd class="sk-kbd" data-key="shift">⇧</kbd>
      <kbd class="sk-kbd" data-key="k">K</kbd>
      <kbd class="sk-kbd" data-key="escape">Esc</kbd>
      <kbd class="sk-kbd" data-key="enter">↵</kbd>
      <kbd class="sk-kbd" data-key="arrowup">↑</kbd>
      <kbd class="sk-kbd" data-key="arrowdown">↓</kbd>
      <kbd class="sk-kbd" data-key="/">/</kbd>
    </div>
    <p set:html={t("kbdPage.chordBody")} />
    <p set:html={t("kbdPage.scriptBody")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("kbdPage.anatomyBody")} />
    <UsagePreview tree={kbdAnatomyTree(t)} css={annotationDemoCss} label={t("kbdPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("kbdPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "kbdPage.when")} avoid={tList(t, "kbdPage.whenNot")} />
    <DoDont
      title={t("kbdPage.dd.context.title")}
      do={{ tree: kbdDoInlineTree(t), caption: t("kbdPage.dd.context.do") }}
      dont={{ tree: kbdDontAloneTree, caption: t("kbdPage.dd.context.dont") }}
    />
    <DoDont
      title={t("kbdPage.dd.chord.title")}
      do={{ tree: kbdDoChordTree, caption: t("kbdPage.dd.chord.do") }}
      dont={{ tree: kbdDontChordTree, caption: t("kbdPage.dd.chord.dont") }}
    />
    <DoDont
      title={t("kbdPage.dd.accent.title")}
      do={{ tree: kbdDoAccentTree(t), caption: t("kbdPage.dd.accent.do") }}
      dont={{ tree: kbdDontAccentTree(t), caption: t("kbdPage.dd.accent.dont") }}
    />
    <ContentRules items={tList(t, "kbdPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes intro={t("kbdPage.a11yIntro")} does={tList(t, "kbdPage.a11yDoes")} yours={tList(t, "kbdPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>

<style>
  .key-echo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline-sm);
    align-items: center;
    margin-block: var(--space-stack-md);
  }
</style>

<script>
  import { initKeyEcho } from "../../scripts/key-echo";
  initKeyEcho();
</script>
