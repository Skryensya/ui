---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import DoDont from "../DoDont.astro";
import { marqueeDoLinksTree, marqueeDontLinksTree } from "../../demos/marquee";
import UsagePreview from "../UsagePreview.astro";
import {
  marqueeAnatomyTree,
  marqueeAutoplayTree,
  marqueeAvatarTree,
  marqueeBadgeTree,
  marqueeControlTree,
  marqueeManualTree,
  marqueeVerticalTree,
} from "../../demos/marquee";
import { annotationDemoCss } from "../../demos/annotation";
import { emitReactSource } from "@skryensya/ai-compiler/emit";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/marquee.css";
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla
# or
pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/marquee.css";`;
const vanilla = `import "@skryensya/vanilla/auto";`;
const react = emitReactSource(marqueeAutoplayTree(), {
  component: "MarqueeExample",
}).component;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`marquee.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Marquee"
  description={t("marquee.description")}
  contractId="marquee"
  testFiles={["packages/react/src/components/marquee.test.tsx", "packages/vanilla/src/components/marquee.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("marquee.lede")} />

    <UsagePreview
      tree={marqueeManualTree(t)}
      optionName="speed"
      title={t("marquee.prop.speed.title")}
      description={t("marquee.prop.speed.body")}
      explain={explain("speed", ["slow", "normal", "fast"])}
      stageMinBlockSize="9rem"
      remountOnChange={false}
    />

    <UsagePreview
      tree={marqueeManualTree(t)}
      optionName="fade"
      title={t("marquee.prop.fade.title")}
      description={t("marquee.prop.fade.body")}
      explain={explain("fade", ["edges", "none"])}
      stageMinBlockSize="9rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={marqueeAutoplayTree()} title={t("marquee.autoplayTitle")} description={t("marquee.autoplayBody")} storybookTitle="Components/Content/Marquee" storybookStory="Autoplay" />
    <UsagePreview tree={marqueeControlTree(t)} title={t("marquee.controlTitle")} description={t("marquee.controlBody")} storybookTitle="Components/Content/Marquee" storybookStory="Control" />
    <UsagePreview tree={marqueeBadgeTree(t)} title={t("marquee.anyChildTitle")} description={t("marquee.anyChildBody")} storybookTitle="Components/Content/Marquee" storybookStory="Badge" />
    <UsagePreview tree={marqueeAvatarTree(t)} storybookTitle="Components/Content/Marquee" storybookStory="Avatar" />
    <UsagePreview tree={marqueeVerticalTree(t)} title={t("marquee.verticalTitle")} description={t("marquee.verticalBody")} storybookTitle="Components/Content/Marquee" storybookStory="Vertical" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "marquee.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("marquee.anatomyBody")} />
    <UsagePreview tree={marqueeAnatomyTree(t)} css={annotationDemoCss} label={t("marquee.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("marquee.guidelinesLede")} />
    <WhenToUse use={tList(t, "marquee.when")} avoid={tList(t, "marquee.whenNot")} />
    <DoDont
      title={t("marquee.dd.links.title")}
      do={{ tree: marqueeDoLinksTree(t), caption: t("marquee.dd.links.do") }}
      dont={{ tree: marqueeDontLinksTree(t), caption: t("marquee.dd.links.dont") }}
    />
    <ContentRules items={tList(t, "marquee.content")} />
  </Fragment>

  <Fragment slot="install">
    <p set:html={t("marquee.installBody")} />
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
    <CodeBlock code={vanilla} label="Vanilla" lang="ts" />
    <CodeBlock code={react} label="React" lang="tsx" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("marquee.a11yIntro")}
      does={tList(t, "marquee.a11yDoes")}
      yours={tList(t, "marquee.a11yYours")}
      keys={[{ keys: [t("component.key.space"), "Enter"], action: t("marquee.key.toggle") }]}
    />
  </Fragment>
</ComponentPageShell>
