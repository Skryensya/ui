---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  marqueeAnatomyTree,
  marqueeAutoplayTree,
  marqueeAvatarTree,
  marqueeBadgeTree,
  marqueeControlTree,
  marqueeManualTree,
  marqueeNoFadeTree,
  marqueeVerticalTree,
} from "../../demos/marquee";
import { annotationDemoCss } from "../../demos/annotation";
import { emitReactSource } from "@skryensya/ai-compiler/emit";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/marquee.css";
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla
# or
pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/marquee.css";`;
const vanilla = `import "@skryensya/vanilla/auto";`;
const react = emitReactSource(marqueeAutoplayTree(), {
  component: "MarqueeExample",
}).component;
---

<ComponentPageShell
  title="Marquee"
  description={t("marquee.description")}
  badge={t("marquee.betaBadge")}
  contractId="marquee"
  testFiles={["packages/react/src/components/marquee.test.tsx", "packages/vanilla/src/components/marquee.test.ts"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("marquee.lede")} />

    <p set:html={t("marquee.anatomyBody")} />
    <ComponentPreview
      tree={marqueeAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("marquee.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <h3>{t("marquee.whenTitle")}</h3>
    <p set:html={t("marquee.whenBody")} />

    <h3>{t("marquee.manualTitle")}</h3>
    <p set:html={t("marquee.manualBody")} />
    <ComponentPreview tree={marqueeManualTree(t)} label={t("marquee.manualLabel")} minHeight="9rem" />

    <h3>{t("marquee.autoplayTitle")}</h3>
    <p set:html={t("marquee.autoplayBody")} />
    <ComponentPreview
      tree={marqueeAutoplayTree()}
      label={t("marquee.autoplayLabel")}
      note={t("marquee.autoplayNote")}
      minHeight="6rem"
    />

    <h3>{t("marquee.controlTitle")}</h3>
    <p set:html={t("marquee.controlBody")} />
    <ComponentPreview tree={marqueeControlTree(t)} label={t("marquee.controlLabel")} minHeight="9rem" />

    <h3>{t("marquee.anyChildTitle")}</h3>
    <p set:html={t("marquee.anyChildBody")} />
    <ComponentPreview tree={marqueeBadgeTree(t)} label={t("marquee.badgeLabel")} minHeight="6rem" />
    <ComponentPreview tree={marqueeAvatarTree(t)} label={t("marquee.avatarLabel")} minHeight="7rem" />

    <h3>{t("marquee.verticalTitle")}</h3>
    <p set:html={t("marquee.verticalBody")} />
    <ComponentPreview tree={marqueeVerticalTree(t)} label={t("marquee.verticalLabel")} minHeight="18rem" />

    <h3>{t("marquee.fadeTitle")}</h3>
    <p set:html={t("marquee.fadeBody")} />
    <ComponentPreview tree={marqueeNoFadeTree()} label={t("marquee.fadeLabel")} minHeight="6rem" />

    <h3>{t("marquee.behaviorTitle")}</h3>
    <p set:html={t("marquee.behaviorBody1")} />
    <p set:html={t("marquee.behaviorBody2")} />
    <p set:html={t("marquee.behaviorBody3")} />

    <h3>{t("marquee.optionsTitle")}</h3>
    <p set:html={t("marquee.optionsBody")} />
  </Fragment>

  <Fragment slot="install">
    <p set:html={t("marquee.installBody")} />
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
    <CodeBlock code={vanilla} label="Vanilla" lang="ts" />
    <CodeBlock code={react} label="React" lang="tsx" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("marquee.a11yP1")} />
    <p set:html={t("marquee.a11yP2")} />
    <p>
      <a href="https://www.w3.org/WAI/WCAG22/Understanding/pause-stop-hide.html">WCAG 2.2.2: Pause, Stop, Hide</a>
      ·
      <a href="https://www.w3.org/WAI/WCAG22/Techniques/css/C39">Technique C39: prefers-reduced-motion</a>
    </p>
  </Fragment>
</ComponentPageShell>
