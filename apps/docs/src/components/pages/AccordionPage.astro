---
/*
 * THE Accordion page: one component, both locales.
 *
 * `pages/componentes/accordion.astro` and `pages/en/components/accordion.astro` used to be two
 * full copies of this markup, one per language, and they drifted: the English twin missed the
 * hero, the tabs, the Style hooks and Accesibilidad panels entirely, because nothing forced a
 * change here to land there too. Every string below goes through `t()`, the exact pattern
 * `demos/accordion.ts` already used for its trees ("one composition read in two languages"); this
 * extends it to the page ITSELF. The two route files that remain are shells: they exist because
 * the site's URLs differ per locale (`/components/accordion` vs `/components/accordion`,
 * folder name translated, English prefixed); see `i18n/index.ts`; not because the content does.
 *
 * The hero, the tablist and the Referencia/Style hooks/Cambios wiring now live in
 * `ComponentPageShell`, the piece this page piloted and every other component page is meant to
 * reuse; only the hand-written Uso, Instalación and Accesibilidad prose stay here, as named slots.
 */
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/accordion.css";
/* The "Details nativo" preview paints `.sk-details*`, and a preview frame only ever copies the
   styles ITS page loaded; a page that never imports this sheet gets a bare <details> with the
   browser's own marker on that stage. */
import "@skryensya/core/components/details.css";
/* Structure diagram: same Annotated Accordion specimen as the Annotation page; the frame only
   clones styles this page loaded, so Annotation's sheet has to land here too. */
import "@skryensya/core/components/annotation.css";
/* The "which half" decision is a Diagram now, and a preview frame only clones the styles ITS page
   loaded: without this the drawing arrives as an unstyled list of nodes with the edge labels in a
   row underneath it, which is exactly what a reader with no JavaScript gets. */
import "@skryensya/core/components/diagram.css";
import CodeBlock from "../CodeBlock.astro";
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import VanillaMount from "../VanillaMount.astro";
import { vanillaMounts } from "../../lib/vanilla-mounts";
import {
  accordionChoiceCss,
  accordionChoiceTree,
  accordionExclusiveTree,
  accordionMultipleTree,
  accordionSingleTree,
  detailsAnatomyTree,
  detailsGroupTree,
} from "../../demos/accordion";
import { annotationAnatomyTree, annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

/*
 * The one thing VanillaMount's generic boilerplate cannot know: an accordion's chevron is a
 * placeholder (<span data-sk-icon="chevron-*">), and no component mounts an icon set for you;
 * the set is always a deliberate choice, so this line is not optional setup. Code, not prose:
 * identical in both locales, so it stays a plain constant rather than an i18n key.
 */
const iconsSetup = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);`;

/*
 * Accordion's enhanced surface is a composition: accordion.css owns the frame and tile.css owns
 * each expandable item. Details is its own native, CSS-only path below.
 */
const enhancedStyles = `@import "@skryensya/core/components/accordion.css";
@import "@skryensya/core/components/tile.css";`;
const reactInstall = `pnpm add @skryensya/core @skryensya/react`;

const nativeInstall = `pnpm add @skryensya/core`;
const nativeStyles = `@import "@skryensya/core/components/details.css";`;

/* The link inside `accordion.intro` and `accordion.a11yP3`; its LABEL is the only part that
   differs by locale, so it is built here from `accordion.detailsNativoLabel` and spliced into
   those strings as {detailsLink}, the same `set:html` + var pattern the footer uses for `{core}`. */
const detailsLink = `<a href="#details-nativo">${t("accordion.detailsNativoLabel")}</a>`;
---

<ComponentPageShell
  title="Accordion"
  description={t("accordion.description")}
  contractId="accordion"
  styleGroups={[
    { file: "components/accordion.css", probe: "sk-accordion", title: "Accordion" },
    { file: "components/details.css", probe: "sk-details", title: t("accordion.detailsNativoLabel") },
  ]}
  testFiles={["packages/react/src/components/accordion.test.tsx", "packages/vanilla/src/components/accordion.svelte.test.ts"]}
>
  {/*
    * TWO DIAGRAMS, because this contract has two anatomies. The first is the machine-driven
    * accordion (`sk-accordion` + the Tile parts); the second is the platform's, whose five
    * `sk-details*` classes share nothing with it but the paint. One drawing covering four of eight
    * signatures was the gap the merge left behind.
    */}
  <Fragment slot="anatomy">
    <ComponentPreview
      tree={annotationAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("annotation.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <h3>{t("accordion.nativeAnatomyLabel")}</h3>
    <p set:html={t("accordion.nativeAnatomyBody")} />
    <ComponentPreview
      tree={detailsAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("accordion.nativeAnatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="usage">
    <div class="sk-callout" data-tone="info">
      <div class="sk-callout__content">
        <p set:html={t("accordion.intro", { detailsLink })} />
      </div>
    </div>

    {/*
      * CHOOSING COMES FIRST, and this section moving up here is the whole restructure.
      *
      * The decision table used to sit at the very bottom, INSIDE a trailing "Details nativo"
      * section, which is what made the page read as two components: everything above was
      * "Accordion", and then at the end came a second thing with its own heading, its own preview
      * and its own contract list. A reader met the alternative only after learning the one they
      * might not have needed. Now the page names both halves in its first paragraph, hands over the
      * table before any demo, and the demos below are jobs rather than components.
      */}
    <h3 id="que-mitad">{t("accordion.choiceTitle")}</h3>
    <p set:html={t("accordion.choiceBody")} />
    {/*
      * A DRAWING AND NOT A TABLE, and the change is about what the six rows actually were: four
      * capabilities the machine has that the platform does not, and one answer for needing none of
      * them. Six lookups made the reader do that reduction; the diagram does it on the page.
      *
      * The no-JavaScript case is the paragraph under it rather than a fifth box, because it is a
      * precedence and not a condition: it outranks the question instead of feeding it.
      */}
    {/*
      * THE LIST IS RIGHT ABOVE THE DRAWING BECAUSE THE DRAWING POINTS AT IT. The question inside
      * the first rhombus is "do you need any of that", and a rhombus can only hold a short question
      * - the slopes take the corners away, so a list drawn inside one hangs off both sides. Four
      * shapes were tried with these four items inside the drawing and each cost more than it
      * bought; a list belongs where a list already reads, and the drawing asks about it.
      */}
    <ul>
      <li set:html={t("accordion.choiceListMultiple")} />
      <li set:html={t("accordion.choiceListValue")} />
      <li set:html={t("accordion.choiceListChange")} />
      <li set:html={t("accordion.choiceListDisabled")} />
    </ul>
    <ComponentPreview
      tree={accordionChoiceTree(t)}
      css={accordionChoiceCss}
      label={t("accordion.choicePreviewLabel")}
    />
    <p set:html={t("accordion.choiceNoJs")} />

    <h3>{t("accordion.oneItemTitle")}</h3>
    <p set:html={t("accordion.oneItemBody")} />
    <ComponentPreview tree={accordionSingleTree(t)} label={t("accordion.oneItemLabel")} />

    <h3>{t("accordion.exclusiveTitle")}</h3>
    <p set:html={t("accordion.exclusiveBody")} />
    <ComponentPreview tree={accordionExclusiveTree(t)} label={t("accordion.exclusiveLabel")} />

    {/*
      * THE PLATFORM'S ANSWER TO THE SECTION ABOVE, and it sits here for that reason: `name` on a
      * set of siblings is the same job `type="single"` just did, so the two demos belong next to
      * each other rather than one at the top of the page and one at the foot of it.
      *
      * `id="details-nativo"` is load-bearing and stays whatever this heading is called:
      * `/components/details` is a 301 onto this anchor, and `accordion.intro` / `accordion.a11yP3`
      * both link to it.
      */}
    <h3 id="details-nativo">{t("accordion.nativeTitle")}</h3>
    <p class="lede" set:html={t("accordion.nativeLede")} />
    <p set:html={t("accordion.nativeBody")} />
    <ComponentPreview tree={detailsGroupTree(t)} label={t("accordion.nativePreviewLabel")} />

    <h4>{t("accordion.nativeContractTitle")}</h4>
    <ul>
      <li set:html={t("accordion.nativeContractItem1")} />
      <li set:html={t("accordion.nativeContractItem2")} />
      <li set:html={t("accordion.nativeContractItem3")} />
      <li set:html={t("accordion.nativeContractItem4")} />
      <li set:html={t("accordion.nativeContractItem5")} />
    </ul>

    {/* Machine-only, and the table above says why: the platform has no `multiple`. */}
    <h3>{t("accordion.multipleTitle")}</h3>
    <p set:html={t("accordion.multipleBody")} />
    <ComponentPreview tree={accordionMultipleTree(t)} label={t("accordion.multipleLabel")} />

    {/*
      * Two bullets, where there were seven. The other five said what the Referencia tab now
      * renders from the compiled contract itself: the mount attribute, the part classes, the
      * options and their defaults, and that an item needs a `value`. Restating those here meant
      * two statements of one truth, and only the contract's fails a build when it is wrong.
      *
      * These two survive because they are not IN the contract. The first is a design rule about
      * what opening a section must not look like; the second is where the event's payload lands,
      * which the contract names the event for but says nothing about the shape of.
      */}
    <h3>{t("accordion.contractTitle")}</h3>
    <ul>
      <li set:html={t("accordion.contractSelection")} />
      <li set:html={t("accordion.contractEvent")} />
    </ul>
    <p set:html={t("accordion.contractRest", { reference: `<strong>${t("contract.tab")}</strong>` })} />
  </Fragment>

  {/*
    * SPLIT ACROSS THE SHELL'S TWO INSTALL HALVES, because this page had three stories stacked in one
    * panel and a reader only ever needed one of them. The lede is the same sentence on both sides
    * (one `t()` call, so the two cannot drift); everything else divides cleanly.
    *
    * THE NATIVE `<details>` PATH IS FILED UNDER VANILLA, which is a judgement and worth stating: it
    * is markup plus a stylesheet and no script at all, so it belongs with the half whose whole claim
    * is that you write the markup yourself. A React consumer composing `Details` from
    * `@skryensya/react/details` installs it the React way, which the React half already covers.
    */}
  <Fragment slot="install">
    <p class="lede">{t("accordion.installIntro")}</p>

    <h3>{t("accordion.reactInstallTitle")}</h3>
    <p>{t("accordion.reactInstallBody")}</p>
    <CodeBlock code={reactInstall} label="terminal" />
    <CodeBlock code={enhancedStyles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="installVanilla">
    <p class="lede">{t("accordion.installIntro")}</p>

    <VanillaMount {...vanillaMounts["/components/accordion"]} headingLevel="h3" />
    <p set:html={t("accordion.iconsNote")} />
    <CodeBlock code={iconsSetup} label="JavaScript" />

    <h3>{t("accordion.nativeInstallTitle")}</h3>
    <p set:html={t("accordion.nativeInstallBody")} />
    <CodeBlock code={nativeInstall} label="terminal" />
    <CodeBlock code={nativeStyles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p class="lede" set:html={t("accordion.a11yIntro")} />

    <h3>{t("accordion.a11ySemanticsTitle")}</h3>
    <ul>
      <li set:html={t("accordion.a11ySemanticsItem1")} />
      <li set:html={t("accordion.a11ySemanticsItem2")} />
      <li set:html={t("accordion.a11ySemanticsItem3")} />
    </ul>

    <h3>{t("accordion.a11yKeyboardTitle")}</h3>
    <p set:html={t("accordion.a11yKeyboardBody")} />

    <h3>{t("accordion.a11yNativeTitle")}</h3>
    <p set:html={t("accordion.a11yNativeBody")} />
  </Fragment>
</ComponentPageShell>
