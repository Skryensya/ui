---
import "@skryensya/core/components/timeline.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The dots carry the kit's Icon, and a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/patterns/icon.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  timelineAnatomyTree,
  timelineDoTimeTree,
  timelineDontTimeTree,
  timelineDontToneTree,
  timelineTonesTree,
  timelineTree,
} from "../../demos/timeline";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/timeline.css";
@import "@skryensya/core/patterns/icon.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`timelinePage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Timeline"
  description={t("timelinePage.description")}
  contractId="timeline"
  testFiles={["packages/react/src/components/timeline.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("timelinePage.lede")} />

    <UsagePreview
      tree={timelineDoTimeTree(t)}
      optionName="tone"
      title={t("timelinePage.prop.tone.title")}
      description={t("timelinePage.prop.tone.body")}
      explain={explain("tone", ["neutral", "accent", "success", "warning", "danger"])}
      stageMinBlockSize="14rem"
      target={["children", 0]}
    />

    <h3>{t("timelinePage.showcaseTitle")}</h3>
    <p set:html={t("timelinePage.showcaseBody")} />
    <UsagePreview tree={timelineTree(t)} />

    <h3>{t("timelinePage.tonesTitle")}</h3>
    <p set:html={t("timelinePage.tonesBody")} />
    <UsagePreview tree={timelineTonesTree(t)} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("timelinePage.contractItem1")} />
      <li set:html={t("timelinePage.contractItem2")} />
      <li set:html={t("timelinePage.contractItem3")} />
      <li set:html={t("timelinePage.contractItem4")} />
      <li set:html={t("timelinePage.contractItem5")} />
      <li set:html={t("timelinePage.contractItem6")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("timelinePage.anatomyBody")} />
    <ComponentPreview
      tree={timelineAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("timelinePage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("timelinePage.guidelinesLede")} />
    <h3>{t("timelinePage.whenTitle")}</h3>
    <ul>
      <li set:html={t("timelinePage.whenItem1")} />
      <li set:html={t("timelinePage.whenItem2")} />
      <li set:html={t("timelinePage.whenItem3")} />
      <li set:html={t("timelinePage.whenItem4")} />
    </ul>
    <DoDont
      title={t("timelinePage.dd.time.title")}
      do={{ tree: timelineDoTimeTree(t), caption: t("timelinePage.dd.time.do") }}
      dont={{ tree: timelineDontTimeTree(t), caption: t("timelinePage.dd.time.dont") }}
    />
    <DoDont
      title={t("timelinePage.dd.tone.title")}
      do={{ tree: timelineDoTimeTree(t), caption: t("timelinePage.dd.tone.do") }}
      dont={{ tree: timelineDontToneTree(t), caption: t("timelinePage.dd.tone.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>
