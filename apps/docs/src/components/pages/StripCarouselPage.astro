---
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { stripCarouselNewsTree, stripCarouselShortTree } from "../../demos/strip-carousel";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/button.css";
import "@skryensya/core/patterns/state-layer.css";
import "@skryensya/core/components/carousel.css";
import "@skryensya/core/patterns/image-frame.css";
import "@skryensya/core/components/typography.css";
import "@/icon-sets/ph.css";

const t = useTranslations(getLocale(Astro.url));
const storybookTitle = "Components/StripCarousel";
---

<ComponentPageShell
  hookPlayground={{ tree: stripCarouselNewsTree(t) }}
  title="StripCarousel"
  description={t("stripCarousel.description")}
  contractId="carousel"
  badge="Beta"
  extraSheets={["@skryensya/core/components/button.css", "@skryensya/core/patterns/state-layer.css", "./icons.css", "@skryensya/core/patterns/image-frame.css"]}
  testFiles={["packages/react/src/components/carousel.test.tsx", "packages/vanilla/src/components/carousel.svelte.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("stripCarousel.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={stripCarouselNewsTree(t)} title={t("stripCarousel.newsTitle")} description={t("stripCarousel.newsBody")} storybookTitle={storybookTitle} storybookStory="News" />
    <UsagePreview tree={stripCarouselShortTree(t)} title={t("stripCarousel.shortTitle")} description={t("stripCarousel.shortBody")} storybookTitle={storybookTitle} storybookStory="Short" />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("stripCarousel.guidelinesLede")} />
    <WhenToUse use={tList(t, "stripCarousel.when")} avoid={tList(t, "stripCarousel.whenNot")} />
    <ContentRules items={tList(t, "stripCarousel.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("stripCarousel.a11yIntro")} does={tList(t, "stripCarousel.a11yDoes")} yours={tList(t, "stripCarousel.a11yYours")} />
  </Fragment>
</ComponentPageShell>
