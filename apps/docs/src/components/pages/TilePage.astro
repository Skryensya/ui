---
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/button.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { annotationDemoCss } from "../../demos/annotation";
import { expandableTileTree, tileAnatomyTree } from "../../demos/tile";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="Tile"
  description={t("tilePage.description")}
  contractId="tile"
  styleGroups={[{ file: "components/tile.css", probe: "sk-tile" }]}
  tests={[
    {
      file: "packages/react/src/components/tile.test.tsx",
      tests: [
        {
          name: "renders every React Tile root with an explicit interactive or disclosure variant",
          description: t("tilePage.test1"),
        },
        {
          name: "renders the shared title and description anatomy for selectable tiles",
          description: t("tilePage.test2"),
        },
        { name: "supports uncontrolled checkbox changes", description: t("tilePage.test3") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tilePage.lede")} />

    <p set:html={t("tilePage.anatomyBody")} />
    <ComponentPreview
      tree={tileAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("tilePage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={expandableTileTree(t)} label={t("tilePage.expandableLabel")} />

    <p set:html={t("tilePage.body1")} />
    <p set:html={t("tilePage.body2")} />

    <h3>{t("tilePage.chooseTitle")}</h3>
    <div class="sk-table-scroll">
      <table class="sk-table">
        <thead class="sk-table__head">
          <tr class="sk-table__row"><th class="sk-table__header">{t("tilePage.headNeed")}</th><th class="sk-table__header">{t("tilePage.headComponent")}</th><th class="sk-table__header">{t("tilePage.headNative")}</th></tr>
        </thead>
        <tbody class="sk-table__body">
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row1Need")}</td><td class="sk-table__cell"><a href="/components/box">Box</a></td><td set:html={t("tilePage.row1Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row2Need")}</td><td class="sk-table__cell"><a href="/components/link">Link</a></td><td set:html={t("tilePage.row2Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row3Need")}</td><td class="sk-table__cell"><a href="/components/button">Button</a></td><td set:html={t("tilePage.row3Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row4Need")}</td><td class="sk-table__cell"><a href="/components/checkbox">Checkbox</a></td><td set:html={t("tilePage.row4Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row5Need")}</td><td class="sk-table__cell"><a href="/components/switch">Switch</a></td><td set:html={t("tilePage.row5Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row6Need")}</td><td class="sk-table__cell"><a href="/components/radio-group">RadioGroup</a></td><td set:html={t("tilePage.row6Native")} class="sk-table__cell" /></tr>
          <tr class="sk-table__row"><td class="sk-table__cell">{t("tilePage.row7Need")}</td><td class="sk-table__cell"><a href="/components/accordion">Accordion</a></td><td set:html={t("tilePage.row7Native")} class="sk-table__cell" /></tr>
        </tbody>
      </table>
    </div>

    <h3>{t("tilePage.contractsTitle")}</h3>
    <ul>
      <li set:html={t("tilePage.contractItem1")} />
      <li set:html={t("tilePage.contractItem2")} />
      <li set:html={t("tilePage.contractItem3")} />
      <li set:html={t("tilePage.contractItem4")} />
      <li set:html={t("tilePage.contractItem5")} />
    </ul>
  </Fragment>
</ComponentPageShell>
