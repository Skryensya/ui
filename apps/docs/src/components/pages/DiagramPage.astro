---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import "@skryensya/core/components/annotation.css";
import {
  diagramAnatomyCss,
  diagramAnatomyTree,
  diagramAwsCss,
  diagramAwsTree,
  diagramBranchTree,
  diagramCanvasTree,
  diagramCycleCss,
  diagramDemoCss,
  diagramFlowCss,
  diagramFlowTree,
  diagramGateCss,
  diagramHalfAdderCss,
  diagramGateRuleCss,
  diagramGateRuleTree,
  diagramGateTree,
  diagramInfraTree,
  diagramLogicTree,
  diagramModelCss,
  diagramModelTree,
  diagramProcessTree,
  diagramStateTree,
  diagramTreeCss,
  diagramTreeTree,
  diagramZonedCss,
  diagramDontLongEdgeTree,
  diagramGuideBranchTree,
  diagramGuideLinearTree,
} from "../../demos/diagram";
import { getLocale, tList, useTranslations } from "../../i18n";
/* The sheet itself, not only its source: the Style hooks table resolves each hook against a real
   element, and a page that never loads this stylesheet shows every value blank. Nothing else is
   needed here, and that is worth noticing: a diagram's nodes are whatever text the author wrote, so
   unlike Annotation this page slots no other component into its demos. */
import "@skryensya/core/components/diagram.css";
/* The infrastructure demo puts a mark in each node's `logo` slot: an ImageFrame around an SVG for
   the services, an Icon for the visitor. A preview only gets the CSS its page imported, and a
   slotted child counts. */
import "@skryensya/core/patterns/image-frame.css";
/* The canvas demo wraps the tree in a Canvas, which brings its own sheet (and the button one it
   imports for the zoom bar). */
import "@skryensya/core/components/canvas.css";

const t = useTranslations(getLocale(Astro.url));

const storybookTitle = "Components/Content/Diagram";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`diagram.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/diagram.css";`;

const html = `<div
  class="sk-diagram"
  data-sk-diagram
  role="group"
  aria-label="Flujo de autenticación"
  style="--sk-diagram-columns: 2"
>
  <!-- vacío a propósito: el enhancer dibuja acá, con números que sólo existen medidos -->
  <svg class="sk-diagram__connectors" aria-hidden="true" focusable="false"></svg>

  <ul class="sk-diagram__nodes">
    <li class="sk-diagram__node" data-node="request" data-shape="terminal"
        style="--sk-diagram-node-span: 2">Petición</li>
    <li class="sk-diagram__node" data-node="session" data-shape="decision"
        style="--sk-diagram-node-span: 2">¿Sesión válida?</li>
    <li class="sk-diagram__node" data-node="app">Panel</li>
    <li class="sk-diagram__node" data-node="login">Ingreso</li>
  </ul>

  <ul class="sk-diagram__edges">
    <li class="sk-diagram__edge" data-from="request" data-to="session"></li>
    <li class="sk-diagram__edge" data-from="session" data-to="app">sí</li>
    <li class="sk-diagram__edge" data-from="session" data-to="login">no</li>
    <li class="sk-diagram__edge" data-from="login" data-to="session">reintenta</li>
  </ul>
</div>`;

const react = `import { Diagram } from "@skryensya/react/diagram";

<Diagram
  label="Flujo de autenticación"
  columns={2}
  nodes={[
    { node: "request", shape: "terminal", span: 2, children: "Petición" },
    { node: "session", shape: "decision", span: 2, children: "¿Sesión válida?" },
    { node: "app", children: "Panel" },
    { node: "login", children: "Ingreso" },
  ]}
  edges={[
    { from: "request", to: "session" },
    { from: "session", to: "app", children: "sí" },
    { from: "session", to: "login", children: "no" },
    { from: "login", to: "session", children: "reintenta" },
  ]}
/>`;

/* The hooks a diagram actually retunes, and the one nobody guesses: the row gap, because it is the
   vertical run of every connector and therefore the whole rhythm of the drawing. */
const hooks = `.mi-diagrama {
  /* la separacion entre filas ES el tramo vertical de cada conector:
     con poco, el dibujo se lee como una pila y no como pasos */
  --sk-diagram-row-gap: var(--space-stack-xl);
  --sk-diagram-column-gap: var(--space-inline-lg);

  /* el techo de un nodo: lo que impide que una traduccion larga
     convierta tres columnas en seis filas */
  --sk-diagram-node-max-inline-size: 11rem;
  --sk-diagram-node-min-inline-size: 7rem;

  /* el conector es cromo, no contenido: a dos pixeles de acento
     pasa a ser lo mas ruidoso de un dibujo que es sobre las cajas */
  --sk-diagram-connector-color: var(--color-border-strong);
  --sk-diagram-connector-width: 1.5px;

  /* la capsula de la etiqueta necesita fondo: la linea pasa por debajo */
  --sk-diagram-edge-bg: var(--color-bg-canvas);
  --sk-diagram-edge-color: var(--color-text-secondary);
}`;
---

<ComponentPageShell
  title="Diagram"
  description={t("diagram.description")}
  contractId="diagram"
  testFiles={["packages/core/src/diagram.test.ts", "packages/vanilla/src/components/diagram.test.ts", "packages/react/src/components/diagram.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("diagram.lede")} />

    <UsagePreview
      tree={diagramFlowTree(t)}
      optionName="arrow"
      target={["edges", 0]}
      title={t("diagram.prop.arrow.title")}
      description={t("diagram.prop.arrow.body")}
      explain={explain("arrow", ["end", "both", "none"])}
      css={diagramFlowCss}
      storybookTitle={storybookTitle}
      storybookStory="Flow"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={diagramBranchTree(t)} css={diagramCycleCss} title={t("diagram.branchTitle")} description={t("diagram.branchBody")} storybookTitle={storybookTitle} storybookStory="Branch" />
    <UsagePreview tree={diagramTreeTree(t)} css={diagramTreeCss} title={t("diagram.treeTitle")} description={t("diagram.treeBody")} storybookTitle={storybookTitle} storybookStory="Default" />
    <UsagePreview tree={diagramCanvasTree(t)} css={diagramDemoCss} title={t("diagram.canvasTitle")} description={t("diagram.canvasBody")} storybookTitle={storybookTitle} storybookStory="Canvas" />
    <UsagePreview tree={diagramStateTree(t)} css={diagramCycleCss} title={t("diagram.stateTitle")} description={t("diagram.stateBody")} storybookTitle={storybookTitle} storybookStory="State" />
    <UsagePreview tree={diagramProcessTree(t)} css={diagramDemoCss} title={t("diagram.processTitle")} description={t("diagram.processBody")} storybookTitle={storybookTitle} storybookStory="Process" />
    <UsagePreview tree={diagramLogicTree(t)} css={diagramDemoCss} title={t("diagram.logicTitle")} description={t("diagram.logicBody")} storybookTitle={storybookTitle} storybookStory="Logic" />
    <UsagePreview tree={diagramGateTree(t)} css={diagramHalfAdderCss} title={t("diagram.gateTitle")} description={t("diagram.gateBody")} storybookTitle={storybookTitle} storybookStory="Gate" />
    <UsagePreview tree={diagramGateRuleTree(t)} css={diagramGateRuleCss} title={t("diagram.gateRuleTitle")} description={t("diagram.gateRuleBody")} storybookTitle={storybookTitle} storybookStory="GateRule" />
    <UsagePreview tree={diagramModelTree(t)} css={diagramModelCss} title={t("diagram.modelTitleDiagram")} description={t("diagram.modelBodyDiagram")} storybookTitle={storybookTitle} storybookStory="Model" />
    <UsagePreview tree={diagramInfraTree(t)} css={diagramZonedCss} title={t("diagram.infraTitle")} description={t("diagram.infraBody")} storybookTitle={storybookTitle} storybookStory="Infra" />
    <UsagePreview tree={diagramAwsTree(t)} css={diagramAwsCss} title={t("diagram.awsTitle")} description={t("diagram.awsBody")} storybookTitle={storybookTitle} storybookStory="Aws" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "diagram.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("diagram.anatomyBody")} />
    <UsagePreview tree={diagramAnatomyTree(t)} css={diagramAnatomyCss} label={t("diagram.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("diagram.guidelinesLede")} />
    <WhenToUse use={tList(t, "diagram.when")} avoid={tList(t, "diagram.whenNot")} />
    <DoDont
      canvas
      title={t("diagram.dd.linear.title")}
      do={{ tree: diagramGuideBranchTree(t), caption: t("diagram.dd.linear.do") }}
      dont={{ tree: diagramGuideLinearTree(t), caption: t("diagram.dd.linear.dont") }}
    />
    <DoDont
      canvas
      title={t("diagram.dd.edges.title")}
      do={{ tree: diagramGuideBranchTree(t), caption: t("diagram.dd.edges.do") }}
      dont={{ tree: diagramDontLongEdgeTree(t), caption: t("diagram.dd.edges.dont") }}
    />
    <ContentRules items={tList(t, "diagram.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
    <CodeBlock code={html} label="HTML" lang="html" />
    <CodeBlock code={react} label="React" lang="tsx" />

    <h4>{t("diagram.cssTitle")}</h4>
    <p set:html={t("diagram.cssBody")} />
    <CodeBlock code={hooks} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("diagram.a11yIntro")} does={tList(t, "diagram.a11yDoes")} yours={tList(t, "diagram.a11yYours")} />
  </Fragment>
</ComponentPageShell>
