---
/* The resizable demo hosts a TreeView, and a component's CSS is opt-in (decision 17): the frame
   copies THIS page's styles, so a stylesheet the page never imports is a stylesheet the demo never
   gets. */
import "@skryensya/core/components/tree-view.css";
import "@skryensya/core/components/sidebar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  sidebarAnatomyTree,
  sidebarFloatingTriggerTree,
  sidebarResizableTree,
  sidebarTree,
} from "../../demos/sidebar";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const css = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/sidebar.css";
@import "@skryensya/core/patterns/nav-list.css";
@import "@skryensya/core/patterns/icon.css";
@import "@skryensya/core/patterns/state-layer.css";`;

const js = `import { initComponents } from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// ${t("sidebarPage.iconsComment").split("\n").join("\n// ")}
mountIcons(document, lucideIcons);

await initComponents();`;
---

<ComponentPageShell
  title="Sidebar"
  description={t("sidebarPage.description")}
  contractId="sidebar"
  appearanceTargetSelector=".sk-sidebar"
  testFiles={["packages/react/src/components/sidebar.test.tsx", "packages/vanilla/src/components/sidebar.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("sidebarPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    {/* The `.app-shell` around the Sidebar is inside the tree: a rail only reads beside a main
        that widens when it collapses. */}
    <UsagePreview tree={sidebarTree(t, { home: "/", reports: "/reportes" })} title={t("sidebarPage.collapseTitle")} description={t("sidebarPage.collapseBody")} flush />
    <UsagePreview tree={sidebarResizableTree(t)} title={t("sidebarPage.widthTitle")} description={t("sidebarPage.widthBody1")} flush />
    <UsagePreview
      tree={sidebarFloatingTriggerTree(t, { home: "/", reports: "/reportes" })}
      title={t("sidebarPage.floatingTriggerTitle")}
      description={t("sidebarPage.floatingTriggerBody")}
      flush
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "sidebarPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("sidebarPage.anatomyBody")} />
    <UsagePreview
      tree={sidebarAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("sidebarPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("sidebarPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "sidebarPage.when")} avoid={tList(t, "sidebarPage.whenNot")} />
    <ContentRules items={tList(t, "sidebarPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("sidebarPage.a11yIntro")}
      does={tList(t, "sidebarPage.a11yDoes")}
      yours={tList(t, "sidebarPage.a11yYours")}
      keys={[
        { keys: ["Enter", t("component.key.space")], action: t("sidebarPage.key.toggle") },
        { keys: ["←", "→"], action: t("sidebarPage.key.arrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("sidebarPage.key.homeEnd") },
        { keys: ["Enter"], action: t("sidebarPage.key.reset") },
      ]}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" />

    <h3>{t("sidebarPage.vanillaInitTitle")}</h3>
    <CodeBlock code={js} label="JavaScript" />
  </Fragment>
</ComponentPageShell>
