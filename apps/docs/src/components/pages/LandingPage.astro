---
/*
 * Marketing home for skryensya/ui. Full-bleed (no docs rail): the header chrome stays so theme
 * prefs remain available; demos that must isolate from :root use a scoped stage instead.
 */
import Base from "../../layouts/Base.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import ContrastToggle from "../ContrastToggle.astro";
import ThemeToggle from "../ThemeToggle.astro";
import {
  compositionComboboxTree,
  compositionFormDialogTree,
  compositionInputButtonListboxTree,
  compositionInputButtonTree,
  compositionInputTree,
  compositionStages,
  landingDialogScript,
  type CompositionStageId,
} from "../../demos/landing/composition";
import { comboboxTree } from "../../demos/combobox";
import { getLocale, localizePath, useTranslations, type UIKey } from "../../i18n";
import { tokens } from "../../lib/tokens";
import { createRamp, defaultRampColors } from "../../lib/ramps";
import { recipes } from "@skryensya/recipes";
import type { UsageTree } from "@skryensya/core/usage-tree";

import "../../styles/landing.css";
import "@skryensya/core/components/slider.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/combobox.css";
import "@skryensya/core/components/dialog.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/components/theme-toggle.css";
import "@skryensya/core/components/kbd.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/process-list.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/patterns/scrollbar.css";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const href = (path: string) => localizePath(path, locale);

const mountJs = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;

const appShell = recipes.find((recipe) => recipe.id === "app-shell");
const formRecipe = recipes.find((recipe) => recipe.id === "form");
const fullInterfaceTree = (appShell ?? formRecipe)!.states.success;

const stageTrees: Record<Exclude<CompositionStageId, "full">, UsageTree> = {
  input: compositionInputTree(t),
  "input-button": compositionInputButtonTree(t),
  "input-button-listbox": compositionInputButtonListboxTree(t),
  combobox: compositionComboboxTree(t, locale),
  "form-dialog": compositionFormDialogTree(t, locale),
};

const vanillaSnippet = `<div data-ui="dialog">
  ...
</div>`;

const reactSnippet = `<Dialog>
  ...
</Dialog>`;

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const ACCENT_SWATCHES = [
  { id: "azul", color: "oklch(50.4% 0.169 259.6)", label: locale === "en" ? "Blue" : "Azul" },
  { id: "violeta", color: "oklch(51% 0.185 300)", label: locale === "en" ? "Violet" : "Violeta" },
  { id: "teal", color: "oklch(50% 0.115 210)", label: locale === "en" ? "Teal" : "Turquesa" },
  { id: "rosa", color: "oklch(56% 0.185 354)", label: locale === "en" ? "Pink" : "Rosa" },
  { id: "naranja", color: "oklch(52% 0.15 50)", label: locale === "en" ? "Orange" : "Naranja" },
  { id: "lima", color: "oklch(62% 0.16 130)", label: locale === "en" ? "Lime" : "Lima" },
  { id: "neutral", color: defaultRampColors.neutral, label: locale === "en" ? "Neutral" : "Neutro" },
] as const;

const DENSITY_PRESETS = [
  { value: 75, label: t("landing.lab.densityCompact") },
  { value: 100, label: t("landing.lab.densityDefault") },
  { value: 115, label: t("landing.lab.densityComfortable") },
] as const;

const RADIUS_PRESETS = ["none", "sm", "md", "lg", "xl"] as const;

const accentRampCss = ACCENT_SWATCHES.map((swatch) => {
  const ramp = createRamp("accent", swatch.color);
  const decls = Object.entries(ramp)
    .map(([name, value]) => `  ${name}: ${value};`)
    .join("\n");
  return `[data-landing-stage][data-landing-accent="${swatch.id}"] {\n${decls}\n}`;
}).join("\n");

const SCOPED_PREFIXES = ["--color-", "--space-", "--size-", "--radius-"];
const scopedSemantics =
  "@layer semantic {\n[data-landing-stage] {\n" +
  tokens
    .filter(
      (token) =>
        token.tier === "semantic" &&
        SCOPED_PREFIXES.some((p) => token.name.startsWith(p)) &&
        token.name !== "--radius-multiplier",
    )
    .map((token) => `  ${token.name}: ${token.value};`)
    .join("\n") +
  "\n}\n}";

const startCards = [
  {
    title: t("landing.start.components.title"),
    body: t("landing.start.components.body"),
    items: t("landing.start.components.items"),
    cta: t("landing.start.components.cta"),
    href: href("/componentes"),
  },
  {
    title: t("landing.start.primitives.title"),
    body: t("landing.start.primitives.body"),
    items: t("landing.start.primitives.items"),
    cta: t("landing.start.primitives.cta"),
    href: href("/componentes/primitivas"),
  },
  {
    title: t("landing.start.foundations.title"),
    body: t("landing.start.foundations.body"),
    items: t("landing.start.foundations.items"),
    cta: t("landing.start.foundations.cta"),
    href: href("/referencia"),
  },
  {
    title: t("landing.start.patterns.title"),
    body: t("landing.start.patterns.body"),
    items: t("landing.start.patterns.items"),
    cta: t("landing.start.patterns.cta"),
    href: href("/recetas"),
  },
] as const;

const ruleCards = [
  {
    titleKey: "landing.rules.color.title" as UIKey,
    bodyKey: "landing.rules.color.body" as UIKey,
    ctaKey: "landing.rules.color.cta" as UIKey,
    href: href("/referencia"),
  },
  {
    titleKey: "landing.rules.dimensions.title" as UIKey,
    bodyKey: "landing.rules.dimensions.body" as UIKey,
    ctaKey: "landing.rules.dimensions.cta" as UIKey,
    href: href("/dimensiones"),
  },
  {
    titleKey: "landing.rules.density.title" as UIKey,
    bodyKey: "landing.rules.density.body" as UIKey,
    ctaKey: "landing.rules.density.cta" as UIKey,
    href: href("/densidad"),
  },
  {
    titleKey: "landing.rules.motion.title" as UIKey,
    bodyKey: "landing.rules.motion.body" as UIKey,
    ctaKey: "landing.rules.motion.cta" as UIKey,
    href: href("/motion"),
  },
  {
    titleKey: "landing.rules.states.title" as UIKey,
    bodyKey: "landing.rules.states.body" as UIKey,
    ctaKey: "landing.rules.states.cta" as UIKey,
    href: href("/state-layer"),
  },
] as const;

const needCards = [
  {
    titleKey: "landing.needs.forms.title" as UIKey,
    itemsKey: "landing.needs.forms.items" as UIKey,
    ctaKey: "landing.needs.forms.cta" as UIKey,
    href: href("/componentes"),
  },
  {
    titleKey: "landing.needs.selection.title" as UIKey,
    itemsKey: "landing.needs.selection.items" as UIKey,
    ctaKey: "landing.needs.selection.cta" as UIKey,
    href: href("/componentes"),
  },
  {
    titleKey: "landing.needs.overlays.title" as UIKey,
    itemsKey: "landing.needs.overlays.items" as UIKey,
    ctaKey: "landing.needs.overlays.cta" as UIKey,
    href: href("/componentes"),
  },
  {
    titleKey: "landing.needs.nav.title" as UIKey,
    itemsKey: "landing.needs.nav.items" as UIKey,
    ctaKey: "landing.needs.nav.cta" as UIKey,
    href: href("/componentes"),
  },
  {
    titleKey: "landing.needs.data.title" as UIKey,
    itemsKey: "landing.needs.data.items" as UIKey,
    ctaKey: "landing.needs.data.cta" as UIKey,
    href: href("/componentes"),
  },
] as const;

const patternCards = [
  {
    titleKey: "landing.patterns.search.title" as UIKey,
    bodyKey: "landing.patterns.search.body" as UIKey,
    ctaKey: "landing.patterns.search.cta" as UIKey,
    href: href("/componentes/combobox"),
  },
  {
    titleKey: "landing.patterns.settings.title" as UIKey,
    bodyKey: "landing.patterns.settings.body" as UIKey,
    ctaKey: "landing.patterns.settings.cta" as UIKey,
    href: href("/recetas"),
  },
  {
    titleKey: "landing.patterns.command.title" as UIKey,
    bodyKey: "landing.patterns.command.body" as UIKey,
    ctaKey: "landing.patterns.command.cta" as UIKey,
    href: href("/componentes/command-palette"),
  },
  {
    titleKey: "landing.patterns.appNav.title" as UIKey,
    bodyKey: "landing.patterns.appNav.body" as UIKey,
    ctaKey: "landing.patterns.appNav.cta" as UIKey,
    href: href("/componentes/sidebar"),
  },
] as const;
---

<Base fullBleed title={t("landing.title")} description={t("landing.description")} hideVanillaMount>
  <style is:global set:html={scopedSemantics + "\n" + accentRampCss}></style>

  <div class="landing">
    <section class="landing__section landing__hero">
      <div class="sk-wrapper" data-size="md">
        <div class="sk-stack" data-gap="lg">
          <header class="sk-stack" data-gap="none">
            <h1 class="sk-heading" data-size="display-lg" data-flush>{t("landing.hero.title")}</h1>
            <p class="sk-text" data-role="subtitle">{t("landing.hero.lede")}</p>
          </header>
          <div class="sk-inline" data-gap="sm">
            <a class="sk-button sk-interactive" data-variant="primary" href={href("/componentes")}>
              {t("landing.hero.ctaComponents")}
            </a>
            <a class="sk-button sk-interactive" data-variant="subtle" href={href("/playground")}>
              {t("landing.hero.ctaPlayground")}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="landing__section">
      <div class="sk-wrapper sk-stack" data-size="md" data-gap="xl">
        <div class="sk-grid landing__intro" data-columns="2" data-gap="xl">
          <h2 class="sk-heading" data-size="display-sm" data-flush>{t("landing.start.title")}</h2>
          <div class="sk-stack" data-gap="sm">
            <p class="sk-text" data-role="subtitle">{t("landing.start.lede")}</p>
            <p class="sk-text" data-tone="secondary">{t("landing.start.body")}</p>
            <p class="sk-text" data-tone="secondary">{t("landing.start.meet")}</p>
          </div>
        </div>
        <div class="sk-grid" data-multicol data-columns="2" data-gap="md">
          {
            startCards.map((card) => (
              <article class="sk-box sk-stack" data-surface="raised" data-border="subtle" data-padding="lg" data-gap="sm">
                <h3 class="sk-heading" data-size="h3" data-flush>{card.title}</h3>
                <p class="sk-text" data-tone="secondary" data-size="sm">{card.body}</p>
                <p class="sk-text" data-size="caption" data-tone="tertiary">{card.items}</p>
                <a class="sk-link sk-interactive" data-tone="primary" href={card.href}>
                  {card.cta}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="landing__section landing__section--proof">
      <div class="sk-wrapper sk-stack" data-size="md" data-gap="xl">
        <div class="sk-grid landing__intro" data-columns="2" data-gap="xl">
          <h2 class="sk-heading" data-size="display-sm" data-flush>{t("landing.composition.title")}</h2>
          <div class="sk-stack" data-gap="sm">
            <p class="sk-text" data-role="subtitle">{t("landing.composition.lede")}</p>
          </div>
        </div>

        {/*
         * SCROLLYTELLING, not click-tabs: the reader scrolls PAST each stage rather than choosing
         * one, so the section demonstrates the thing its own copy claims ("no son piezas aisladas,
         * comparten fundamentos para poder componerse") by composing in front of the reader instead
         * of asserting it. `[data-landing-scrolly]` below is a JS enhancer, not a CSS scroll-timeline:
         * `animation-timeline` can drive a fade on the element crossing the viewport, but has no way
         * to make a DIFFERENT, non-scrolling sibling (the sticky preview) react to that crossing.
         * IntersectionObserver is the right tool for cross-element sync, and it degrades safely —
         * see the fallback note below.
         *
         * ONE SET OF SIX PREVIEWS, never twelve: each `ComponentPreview` is a sandboxed iframe (see
         * `docs-previews-are-inline` in project memory), so a separate fallback copy for a no-JS path
         * would double the iframes this page ships. Instead the FIRST frame is `data-active` in the
         * authored HTML — a reader with JS disabled, or before the enhancer below has run, sees a
         * static "Input" stage, which is the same honest baseline every other progressive-enhancement
         * block on this page uses (the docs hero collapse works the same way).
         *
         * THE INACTIVE FIVE need no `aria-hidden`/`inert` of their own: `visibility: hidden`
         * (`landing.css`) already pulls an element and its focusable descendants out of both the tab
         * order and the accessibility tree, real iframes included, in every engine that matters here.
         * That is also why the mobile fallback below can just flip `visibility` back to `visible` and
         * have every preview become reachable again — nothing else has to be undone alongside it.
         */}
        <div class="landing__scrolly" data-landing-scrolly role="group" aria-label={t("landing.composition.stagesLabel")}>
          <div class="landing__scrolly-steps">
            {
              compositionStages.map((stage, index) => (
                <div class="landing__scrolly-step" data-landing-scrolly-step={stage.id} data-active={index === 0 ? "" : undefined}>
                  <p class="sk-text" data-tone="secondary">{t(stage.captionKey)}</p>
                  <h3 class="sk-heading" data-size="h3" data-flush>{t(stage.labelKey)}</h3>
                </div>
              ))
            }
          </div>

          <div class="landing__scrolly-stage">
            {
              compositionStages.map((stage, index) => (
                <div
                  class="sk-box landing__stage landing__scrolly-frame"
                  data-surface="raised"
                  data-border="subtle"
                  data-padding="lg"
                  data-landing-scrolly-frame={stage.id}
                  data-active={index === 0 ? "" : undefined}
                >
                  {stage.id === "full" ? (
                    <ComponentPreview
                      tree={fullInterfaceTree}
                      label={t(stage.labelKey)}
                      flush
                      screens={false}
                      hideSource
                      measure="48rem"
                    />
                  ) : (
                    <ComponentPreview
                      tree={stageTrees[stage.id]}
                      js={mountJs}
                      previewScript={stage.id === "form-dialog" ? landingDialogScript : undefined}
                      label={t(stage.labelKey)}
                      screens={false}
                      hideSource
                      viewport={
                        stage.id === "combobox" || stage.id === "input-button-listbox"
                          ? "menu"
                          : stage.id === "form-dialog"
                            ? "overlay"
                            : "auto"
                      }
                    />
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <div class="sk-stack" data-gap="md">
          <p class="sk-text" data-tone="secondary">{t("landing.composition.after")}</p>
          <div class="sk-inline" data-gap="sm">
            <a class="sk-link sk-interactive" href={href("/recetas")}>{t("landing.composition.cta")}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="landing__section">
      <div class="sk-wrapper sk-stack" data-size="md" data-gap="xl">
        <div class="sk-grid landing__intro" data-columns="2" data-gap="xl">
          <h2 class="sk-heading" data-size="display-sm" data-flush>{t("landing.rules.title")}</h2>
          <div class="sk-stack" data-gap="sm">
            <p class="sk-text" data-role="subtitle">{t("landing.rules.lede")}</p>
          </div>
        </div>
        <div class="sk-tile-grid">
          {
            ruleCards.map((card) => (
              <a class="sk-tile sk-tile--interactive sk-interactive" data-padding="lg" href={card.href}>
                <span class="sk-tile__content">
                  <span class="sk-tile__title">{t(card.titleKey)}</span>
                  <span class="sk-tile__description">{t(card.bodyKey)}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="landing__section">
      <div class="sk-wrapper sk-stack" data-size="md" data-gap="xl">
        <h2 class="sk-heading" data-size="display-sm" data-flush>{t("landing.lab.title")}</h2>
        <div class="sk-grid landing-lab__grid" data-columns="2" data-gap="lg" data-landing-lab>
          <div
            class="sk-box sk-stack landing-lab__controls"
            data-surface="raised"
            data-border="subtle"
            data-padding="lg"
            data-gap="lg"
          >
            <div class="sk-form-field">
              <span class="sk-form-field__label">{t("landing.lab.accent")}</span>
              <div class="sk-inline landing-lab__swatches" data-gap="xs" role="group" aria-label={t("landing.lab.accent")}>
                {
                  ACCENT_SWATCHES.map((swatch, index) => (
                    <button
                      class="landing-lab__swatch sk-interactive"
                      type="button"
                      data-landing-accent-swatch={swatch.id}
                      aria-label={swatch.label}
                      aria-pressed={index === 0 ? "true" : "false"}
                      style={`--swatch: ${swatch.color}`}
                    />
                  ))
                }
              </div>
            </div>

            <div class="sk-form-field">
              <span class="sk-form-field__label">{t("landing.lab.density")}</span>
              <input
                class="sk-slider"
                data-landing-density
                type="range"
                min="0"
                max="2"
                value="1"
                step="1"
                aria-valuetext={t("landing.lab.densityDefault")}
              />
              <div
                class="landing-lab__presets landing-lab__presets--density"
                role="group"
                aria-label={t("landing.lab.densityPresets")}
              >
                {
                  DENSITY_PRESETS.map((preset) => (
                    <button
                      class="sk-button sk-interactive landing-lab__preset"
                      type="button"
                      data-variant="ghost"
                      data-size="sm"
                      data-landing-density-preset={preset.value}
                      aria-pressed={preset.value === 100 ? "true" : "false"}
                    >
                      {preset.label}
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="sk-form-field">
              <span class="sk-form-field__label">{t("landing.lab.radius")}</span>
              <input
                class="sk-slider"
                data-landing-radius
                type="range"
                min="0"
                max="4"
                value="2"
                step="1"
                aria-valuetext="md"
              />
              <div
                class="landing-lab__presets landing-lab__presets--radius"
                role="group"
                aria-label={t("landing.lab.radiusPresets")}
              >
                {
                  RADIUS_PRESETS.map((preset) => (
                    <button
                      class="sk-button sk-interactive landing-lab__preset landing-lab__preset--token"
                      type="button"
                      data-variant="ghost"
                      data-size="sm"
                      data-landing-radius-preset={preset}
                      aria-pressed={preset === "md" ? "true" : "false"}
                    >
                      {preset}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <div
            class="sk-box sk-stack landing-lab__preview"
            data-surface="raised"
            data-border="subtle"
            data-padding="none"
            data-gap="none"
            data-landing-stage
            data-landing-accent="azul"
            data-sk-density-scope
            data-radius="md"
            style="--sk-density: 1"
          >
            <header class="sk-inline landing-lab__header" data-justify="end" data-gap="xs">
              <ThemeToggle size="sm" scoped cycle="appearance" />
              <ContrastToggle size="sm" scoped />
            </header>
            <div class="landing-lab__stage">
              <div class="sk-box sk-stack" data-surface="surface" data-border="subtle" data-padding="lg" data-gap="md">
                <h3 class="sk-heading" data-size="h3" data-flush>{t("landing.lab.previewTitle")}</h3>
                <div class="sk-form-field">
                  <label class="sk-form-field__label" for="landing-lab-name">{t("landing.lab.nameLabel")}</label>
                  <input
                    class="sk-input"
                    id="landing-lab-name"
                    type="text"
                    placeholder={t("landing.lab.namePlaceholder")}
                  />
                </div>
                <div class="sk-form-field">
                  <label class="sk-form-field__label" for="landing-lab-plan">{t("landing.lab.planLabel")}</label>
                  <select class="sk-input" id="landing-lab-plan">
                    <option>Starter</option>
                    <option>Pro</option>
                    <option>Team</option>
                  </select>
                </div>
                <div class="sk-inline" data-gap="sm">
                  <button class="sk-button sk-interactive" data-variant="primary" type="button">
                    {t("landing.lab.submit")}
                  </button>
                  <button class="sk-button sk-interactive" data-variant="ghost" type="button">
                    {t("landing.lab.cancel")}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="sk-stack" data-gap="md">
          <p class="sk-text" data-tone="secondary">{t("landing.lab.after")}</p>
          <div class="sk-inline" data-gap="sm">
            <a class="sk-button sk-interactive" data-variant="subtle" href={href("/personalizar")}>
              {t("landing.lab.ctaTheming")}
            </a>
            <a class="sk-button sk-interactive" data-variant="ghost" href={href("/playground")}>
              {t("landing.lab.ctaPlayground")}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="landing__section">
      <div class="sk-wrapper sk-stack" data-size="md" data-gap="xl">
        <div class="sk-grid landing__intro" data-columns="2" data-gap="xl">
          <h2 class="sk-heading" data-size="display-sm" data-flush>{t("landing.platform.title")}</h2>
          <div class="sk-stack" data-gap="sm">
            <p class="sk-text" data-role="subtitle">{t("landing.platform.lede")}</p>
          </div>
        </div>
        <ol class="sk-process-list">
          <li class="sk-process-list__item">
            <div class="sk-process-list__content">
              <span class="sk-process-list__title">{t("landing.platform.html.title")}</span>
              <p class="sk-text" data-tone="secondary">{t("landing.platform.html.body")}</p>
            </div>
          </li>
          <li class="sk-process-list__item">
            <div class="sk-process-list__content">
              <span class="sk-process-list__title">{t("landing.platform.css.title")}</span>
              <p class="sk-text" data-tone="secondary">{t("landing.platform.css.body")}</p>
            </div>
          </li>
          <li class="sk-process-list__item">
            <div class="sk-process-list__content">
              <span class="sk-process-list__title">{t("landing.platform.js.title")}</span>
              <p class="sk-text" data-tone="secondary">{t("landing.platform.js.body")}</p>
