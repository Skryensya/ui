        <div class="landing-body">
          {copy.ideaBody.map((paragraph) => <p class="sk-text landing-prose" data-tone="secondary" data-read>{paragraph}</p>)}
        </div>
      </section>

      <section class="landing-row" aria-labelledby="landing-points-title">
