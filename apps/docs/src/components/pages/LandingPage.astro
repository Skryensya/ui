  children: translate("demo.alertRetry.body"),
});

/** A person row: avatar and name/role on one side, a status Tag on the other. */
const profileRowTree = (translate: Translate): UsageTree => ({
  contract: "layout",
  signature: "Inline",
  options: { gap: "sm", inlineAlign: "center", justify: "between" },
  children: [
    {
      contract: "layout",
      signature: "Inline",
      options: { gap: "sm", inlineAlign: "center" },
      children: [
        { contract: "avatar", signature: "Avatar.initials", options: { size: "md", name: "Grace Hopper" }, children: "GH" },
        {
          contract: "layout",
          signature: "Stack",
          options: { gap: "none" },
          children: [
            { contract: "typography", signature: "Text", options: { weight: "emphasis" }, children: "Grace Hopper" },
            { contract: "typography", signature: "Text", options: { tone: "secondary", size: "sm" }, children: translate("demo.popoverStructured.role") },
          ],
        },
      ],
    },
    { contract: "tag", signature: "Tag", options: { tone: "success" }, children: translate("demo.profile.status") },
  ],
});

/** One dashboard figure: a Box around a Stat, the same shape `metric-panel`'s own notes describe
 *  ("no hay componente MetricPanel"), just one card instead of that pattern's row of three. */
const metricCardTree = (translate: Translate): UsageTree => ({
  contract: "box",
  signature: "Box",
  options: { surface: "surface", border: "subtle", padding: "lg" },
  children: {
    contract: "stat",
    signature: "Stat",
    options: { trend: "up" },
    slots: {
      label: translate("demo.stat.income"),
      value: locale === "es" ? "48.200 €" : "$48,200",
      change: [
        { contract: "icon", signature: "Icon", options: { name: "arrow-up", size: "sm" } },
