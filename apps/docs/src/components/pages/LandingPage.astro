const signature = "Button.action";
const shownOptions = ["variant", "tone", "iconOnly"] as const;
const optionRows = shownOptions.map((name) => {
  const option = buttonContract.options[name];
  return {
    name,
    values: "values" in option ? option.values.join(" · ") : "true · false",
    writes: option.attr,
  };
});

const buttonTree: UsageTree = {
  contract: "button",
  signature,
  options: { variant: "soft", tone: "danger" },
  children: es ? "Eliminar" : "Delete",
};
const buttonTreeSource = JSON.stringify(buttonTree, null, 2);
const badTree: UsageTree = { contract: "button", signature, options: { iconOnly: true }, children: "×" };
const badCheck = validateUsageTree(badTree);
const badProblem = badCheck.problems[0];
const badTreeSource = JSON.stringify(badTree, null, 2);
const buttonMarkup = emitMarkup(buttonTree, { fillDefaults: false, idPrefix: "landing-contract" });

/* The four steps are a plain Stack of the system's own components, written as usage trees and emitted like any
   other: Text, Badge, Table, Callout and CodePreview carry the look, this page adds none of its own. Every
   figure in them is read from the contract or computed by the validator and the emitter at build time. */
const steps = copy.contractSteps;
const text = (children: UsageTree["children"], options: Record<string, string> = {}): UsageTree => ({
  contract: "typography",
  signature: "Text",
  options: { tone: "secondary", size: "sm", ...options },
  children,
});
const code = (children: string): UsageTree => ({ contract: "typography", signature: "Code", children });
const stack = (children: UsageTree[]): UsageTree => ({ contract: "layout", signature: "Stack", children });
const snippet = (source: string, label: string): UsageTree => ({
  contract: "code-preview",
  signature: "CodePreview",
  slots: { label },
  children: source,
});
const callout = (tone: string, title: string, children: UsageTree["children"]): UsageTree => ({
  contract: "callout",
  signature: "Callout",
  options: { tone },
  slots: { title },
  children,
});
const step = (copyStep: { title: string; lead: string }, children: UsageTree[]): UsageTree => ({
  ...stack([text(copyStep.title, { tone: "primary", size: "body" }), text(copyStep.lead), ...children]),
  attrs: { "data-read": "" },
});
const cell = (signature: string, children: UsageTree["children"], options?: Record<string, string>): UsageTree => ({
  contract: "table",
  signature,
  ...(options ? { options } : {}),
  children,
});
const row = (cells: UsageTree[]): UsageTree => cell("TableRow", cells);

const contractTable: UsageTree = {
  contract: "table",
  signature: "TableScroll",
  children: {
    contract: "table",
    signature: "Table",
    attrs: { "aria-label": copy.contractTableLabel },
    children: [
      cell("TableHead", [
        row([
          cell("TableHeader", copy.contractCols.option),
          cell("TableHeader", copy.contractCols.values),
          cell("TableHeader", copy.contractCols.writes),
        ]),
      ]),
      cell("TableBody", optionRows.map((option) =>
        row([cell("TableHeader", code(option.name), { scope: "row" }), cell("TableCell", option.values), cell("TableCell", code(option.writes))]),
      )),
    ],
  },
};

const stepsTree: UsageTree = {
  contract: "layout",
  signature: "Stack",
  options: { gap: "xl" },
  children: [
    step(steps.contract, [contractTable]),
    step(steps.tree, [snippet(buttonTreeSource, "usage tree")]),
    step(steps.validate, [
      snippet(badTreeSource, "usage tree"),
      ...(badProblem ? [callout("danger", steps.validate.verdictBad, [`${steps.validate.rule}: `, code(badProblem.rule), ` · ${badProblem.message}`])] : []),
    ]),
    step(steps.result, [{ contract: "layout", signature: "Stack", options: { align: "start" }, children: buttonTree }, snippet(buttonMarkup, "HTML")]),
  ],
};
// A page that renders an invalid tree would ship broken markup: fail the build instead.
const stepsCheck = validateUsageTree(stepsTree);
if (!stepsCheck.valid) {
  throw new Error(`Landing contract steps are not a valid usage tree: ${JSON.stringify(stepsCheck.problems, null, 2)}`);
}
const stepsMarkup = emitMarkup(stepsTree, { fillDefaults: false, idPrefix: "landing-steps" });

// The cycle is every set once (A to E). The track repeats it and keeps a few sets past the end so the
// band is never wider than the track: it only ever shifts by one whole cycle, so the frame at the end of a
// loop is the frame at its start. The boxes and their content live in `lib/landing-bento.ts`, which a
// test checks against the contracts.
const bentoCycle = buildBentoSets(es);

/*
 * The fields in the marquee are examples, never something to type into, so the browser and the password
 * managers must not treat them as a form to fill or remember. The contracts cannot say this: PasswordInput and
 * NumberField forward no `autocomplete`, so it is written on the emitted markup, once, here. `off` is ignored
 * for a password, which is why that one asks for `new-password` (nothing saved to offer). The data attributes
 * are the opt-outs 1Password, LastPass and Bitwarden read, and `data-form-type` is Dashlane's.
 */
const quiet = (html: string) =>
  html.replace(/<(input|textarea|select)\b[^>]*>/g, (tag, name: string) => {
    const autocomplete = /\stype="password"/.test(tag) ? "new-password" : "off";
    const own = /\sautocomplete=/.test(tag) ? "" : ` autocomplete="${autocomplete}"`;
    return tag.replace(`<${name}`, `<${name}${own} data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"`);
  });
const bentoSets = Array.from({ length: bentoCycle.length + 3 }, (_, index) => bentoCycle[index % bentoCycle.length]);
---

<Base fullBleed title={copy.title} description={copy.description} hideVanillaMount>
  <main class="landing-page">
    <div class="sk-wrapper" data-size="md" data-gutter="lg">
      <section class="landing-hero" aria-labelledby="landing-title">
        <div class="landing-hero__copy">
          <p class="landing-kicker">{copy.eyebrow}</p>
          <h1 id="landing-title" class="landing-title">{copy.heroTitle}</h1>
          <p class="sk-text landing-prose" data-size="lg" data-tone="secondary">{copy.heroBody}</p>
          <div class="sk-inline" data-gap="sm" data-wrap>
            <a class="sk-button sk-interactive" data-sk-button data-tone="accent" href={href("/components")}>{copy.ctaComponents}</a>
            <a class="sk-button sk-interactive" data-sk-button data-variant="ghost" href={href("/architecture")}>{copy.ctaArchitecture}</a>
          </div>
        </div>
      </section>

      <section class="landing-row" aria-labelledby="landing-idea-title">
