          {copy.status.map((item) => (
            <li data-read>
              <h3 class="landing-subheading">{item.title}</h3>
              <p class="sk-text" data-tone="secondary">{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="landing-row" aria-labelledby="landing-roadmap-title">
        <div class="landing-heading-group">
          <h2 id="landing-roadmap-title" class="landing-heading">{copy.roadmapTitle}</h2>
          <p class="sk-text" data-tone="secondary">{copy.roadmapBody}</p>
        </div>
        <div class="landing-body">
          <ol class="landing-roadmap">
            {copy.roadmap.map((item, index) => (
              <li data-read>
                <span class="landing-roadmap__index">{String(index + 1).padStart(2, "0")}</span>
                <div class="landing-roadmap__text">
                  <h3 class="landing-subheading">{item.title}</h3>
                  <p class="sk-text" data-tone="secondary">{item.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

    </div>

    <div class="sk-wrapper" data-size="md" data-gutter="lg">
      <section class="landing-closing" aria-labelledby="landing-closing-title">
        <h2 id="landing-closing-title" class="landing-closing__title">{copy.closeTitle}</h2>
        <div class="landing-closing__body">
          <p class="sk-text landing-prose" data-tone="secondary">{copy.closeBody}</p>
          <div class="sk-inline" data-gap="sm" data-wrap>
            <a class="sk-button sk-interactive" data-sk-button data-tone="accent" data-size="lg" href={href("/components")}>{copy.closeCta}</a>
            <a class="sk-button sk-interactive" data-sk-button data-variant="soft" data-size="lg" href={href("/installation")}>{copy.closeInstall}</a>
          </div>
        </div>
      </section>

    </div>

    <div class="sk-wrapper" data-size="md" data-gutter="lg">
      <div class="landing-marquee" aria-hidden="true" style={`--bento-cycle: ${bentoCycle.length}`}>
        <div class="landing-marquee__track">
          {bentoSets.map((tiles, loop) => (
            <div class="landing-bento" inert>
              {tiles.map((tile) => (
                <div
                  class="sk-box landing-tile"
                  data-surface="surface"
                  data-border="subtle"
                  data-appearance="plain"
                  data-accent={tile.accent ? "" : undefined}
                  data-phone={tile.phone ? "" : undefined}
                  data-link={tile.link ? "" : undefined}
                  style={`grid-area: ${tile.area[0]} / ${tile.area[1]} / span ${tile.area[2]} / span ${tile.area[3]};${tile.link ? ` --link-y: ${tile.link};` : ""}`}
                >
                  <div class="landing-tile__demo" set:html={quiet(emitMarkup(tile.tree, { fillDefaults: false, idPrefix: `bento-${loop}-${tile.id}` }))} />
                </div>
              ))}
            </div>
          ))}
        </div>
        <script is:inline>
        /* Remember the marquee's place in its cycle. It is stored as a fraction of the cycle, not as milliseconds,
           so adding or removing a set does not make a saved position land somewhere else. This runs right after
           the markup, before the first paint, so a reload never shows the track at its start for a frame. */
        (function () {
          var track = document.querySelector(".landing-marquee__track");
          if (!track) return;
          /* Nobody is watching a hidden tab, so the marquee stops and resumes where it was. The flag is on <html>
             and the CSS reads it. */
          function syncVisibility() {
            document.documentElement.toggleAttribute("data-tab-hidden", document.visibilityState === "hidden");
          }
          syncVisibility();
          document.addEventListener("visibilitychange", syncVisibility);
          var KEY = "sk-docs-landing-marquee";
          var cycle = parseFloat(getComputedStyle(track).animationDuration) * 1000;
          if (!cycle) return; /* reduced motion: nothing is animating */
          try {
            var saved = parseFloat(localStorage.getItem(KEY));
            if (saved >= 0 && saved < 1) track.style.animationDelay = -saved * cycle + "ms";
          } catch (e) {}
          /* `progress` is where the effect is inside its current iteration. `currentTime` is not: a negative
             delay (the restored position) is not part of it, so reading it would lose the saved offset. */
          function save() {
            try {
              var animation = track.getAnimations()[0];
              var progress = animation && animation.effect && animation.effect.getComputedTiming().progress;
              if (typeof progress !== "number") return;
              localStorage.setItem(KEY, String(progress));
            } catch (e) {}
          }
          addEventListener("pagehide", save);
          document.addEventListener("visibilitychange", function () {
            if (document.visibilityState === "hidden") save();
          });
        })();
        </script>
      </div>
    </div>

    {/* Outside any wrapper: the footer band is a surface and spans the page edge to edge; only its
        CONTENT sits in the md measure (the rules below, on `.site-footer__inner`). */}
    <div class="landing-footer-wrap">
      <SiteFooter nav={navigation} locale={locale} />
    </div>
  </main>
</Base>

<script>
  // Highlights the right-column block that sits in the reading band while scrolling.
  // Only one block is active at a time (the first in document order that crosses the band).
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-read]"));
  const inBand = new Set<HTMLElement>();

  const sync = () => {
    const active = items.find((item) => inBand.has(item));
    for (const item of items) item.toggleAttribute("data-active", item === active);
  };

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBand.add(entry.target as HTMLElement);
          else inBand.delete(entry.target as HTMLElement);
        }
        sync();
      },
      { rootMargin: "-35% 0px -50% 0px" },
    );
    for (const item of items) observer.observe(item);
  }
</script>

<style>
  .landing-page {
    --landing-read-bg: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    background: var(--color-surface-canvas);
  }

  .landing-hero,
  .landing-row {
    display: grid;
    gap: var(--space-stack-lg);
    padding-block: clamp(3rem, 6vw, 5rem);
