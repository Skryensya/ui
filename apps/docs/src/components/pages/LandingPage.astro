  <script>
    import {
      applyAppearance,
      colorModeLabel,
      nextAppearance,
      readAppearance,
      themeToggleAttrs,
      type Appearance,
    } from "@skryensya/core/theme-toggle";

    const RADIUS = ["none", "sm", "md", "lg", "xl"] as const;
    const DENSITY = [75, 100, 115] as const;
    const DENSITY_LABELS = ["compact", "default", "comfortable"] as const;
    const prefersDark = () => window.matchMedia("(prefers-color-scheme: dark)").matches;

    document.querySelectorAll<HTMLElement>("[data-landing-lab]").forEach((lab) => {
      const stage = lab.querySelector<HTMLElement>("[data-landing-stage]");
      if (!stage) return;

      const theme = lab.querySelector<HTMLButtonElement>('[data-theme-toggle-scoped][data-cycle="appearance"]');
      if (theme) {
        const labels = {
          light: theme.getAttribute(themeToggleAttrs.labelLight) ?? undefined,
          dark: theme.getAttribute(themeToggleAttrs.labelDark) ?? undefined,
        };
        let appearance: Appearance = readAppearance(document.documentElement, prefersDark());
        const paintTheme = (mode: Appearance) => {
          appearance = mode;
          applyAppearance(stage, mode);
          applyAppearance(theme, mode);
          theme.setAttribute("aria-label", colorModeLabel(mode, labels));
        };
        paintTheme(appearance);
        theme.addEventListener("click", () => {
          paintTheme(nextAppearance(appearance));
        });
      }

      const contrast = lab.querySelector<HTMLButtonElement>("[data-contrast-toggle-scoped]");
      if (contrast) {
        let high = false;
        const paintContrast = () => {
          if (high) stage.setAttribute("data-contrast", "high");
          else stage.removeAttribute("data-contrast");
          const text = (high ? contrast.dataset.labelHigh : contrast.dataset.labelNormal) ?? "";
          contrast.setAttribute("aria-pressed", String(high));
          contrast.setAttribute("aria-label", text);
          contrast.setAttribute("title", text);
        };
        paintContrast();
        contrast.addEventListener("click", () => {
          high = !high;
          paintContrast();
        });
      }

      lab.querySelectorAll<HTMLButtonElement>("[data-landing-accent-swatch]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-landing-accent-swatch");
          if (!id) return;
          stage.setAttribute("data-landing-accent", id);
          lab.querySelectorAll<HTMLButtonElement>("[data-landing-accent-swatch]").forEach((peer) => {
            peer.setAttribute("aria-pressed", String(peer === button));
          });
        });
      });

      const density = lab.querySelector<HTMLInputElement>("[data-landing-density]");
      const densityPresets = lab.querySelectorAll<HTMLButtonElement>("[data-landing-density-preset]");
      const densityLabel = (index: number) =>
        densityPresets[index]?.textContent?.trim() ?? DENSITY_LABELS[index] ?? "";
      const paintDensity = (index: number) => {
        if (!density) return;
        const clamped = Math.min(DENSITY.length - 1, Math.max(0, index));
        const min = Number(density.min);
        const max = Number(density.max);
        const factor = DENSITY[clamped]! / 100;
        density.value = String(clamped);
        stage.style.setProperty("--sk-density", String(factor));
        density.style.setProperty("--sk-slider-fill", String((clamped - min) / (max - min)));
        density.setAttribute("aria-valuetext", densityLabel(clamped));
        densityPresets.forEach((preset, presetIndex) => {
          preset.setAttribute("aria-pressed", String(presetIndex === clamped));
        });
      };
      density?.addEventListener("input", () => paintDensity(Number(density.value)));
      densityPresets.forEach((preset, presetIndex) => {
        preset.addEventListener("click", () => paintDensity(presetIndex));
      });
      paintDensity(Number(density?.value ?? 1));

      const radius = lab.querySelector<HTMLInputElement>("[data-landing-radius]");
      const radiusPresets = lab.querySelectorAll<HTMLButtonElement>("[data-landing-radius-preset]");
      const paintRadius = (index: number) => {
        if (!radius) return;
        const clamped = Math.min(RADIUS.length - 1, Math.max(0, index));
        const min = Number(radius.min);
        const max = Number(radius.max);
        const token = RADIUS[clamped]!;
        radius.value = String(clamped);
        stage.setAttribute("data-radius", token);
        radius.style.setProperty("--sk-slider-fill", String((clamped - min) / (max - min)));
        radius.setAttribute("aria-valuetext", token);
        radiusPresets.forEach((preset, presetIndex) => {
          preset.setAttribute("aria-pressed", String(presetIndex === clamped));
        });
      };
      radius?.addEventListener("input", () => paintRadius(Number(radius.value)));
      radiusPresets.forEach((preset, presetIndex) => {
        preset.addEventListener("click", () => paintRadius(presetIndex));
      });
      paintRadius(Number(radius?.value ?? 2));
    });

    /*
     * THE COMPOSITION SCROLLY. IntersectionObserver, not `animation-timeline`: a scroll-driven CSS
     * animation can only ever drive properties on the element whose timeline it is (see the docs
     * hero collapse for that pattern used correctly, one element reacting to its own scroll
     * progress). Here a caption crossing the viewport has to change a DIFFERENT, non-scrolling
     * sibling — the sticky preview — and CSS has no primitive for "when THIS element crosses the
     * viewport, change THAT one." IntersectionObserver is built for exactly that cross-element sync,
     * and it also just works in every engine, with no `@supports` gate needed for a Chrome-only
     * timeline API.
     *
     * `rootMargin: "-45% 0px -45% 0px"` shrinks the observed viewport to a thin band across its
     * vertical centre, so a caption is "current" only once it has scrolled to roughly the middle of
     * the screen — the same rough trigger line most scrollytelling pieces use, rather than firing
     * the instant a caption's top edge appears at the bottom of the viewport.
     *
     * `matchMedia` gates the observer on the SAME breakpoint `landing.css` uses to drop the sticky
     * layout: below it every caption and every preview is already visible at once (the mobile
     * fallback), so there is nothing for scroll position to choose between, and leaving the observer
     * running there would just fight the CSS for no visible effect.
     */
    const desktopScrolly = window.matchMedia("(min-width: 52rem)");

    document.querySelectorAll<HTMLElement>("[data-landing-scrolly]").forEach((root) => {
      const steps = [...root.querySelectorAll<HTMLElement>("[data-landing-scrolly-step]")];
      const frames = [...root.querySelectorAll<HTMLElement>("[data-landing-scrolly-frame]")];
      if (!steps.length || !frames.length) return;

      const setActive = (id: string | undefined) => {
        if (!id) return;
        for (const step of steps) {
          step.toggleAttribute("data-active", step.dataset.landingScrollyStep === id);
        }
        for (const frame of frames) {
          frame.toggleAttribute("data-active", frame.dataset.landingScrollyFrame === id);
        }
      };

      let observer: IntersectionObserver | undefined;
      const connect = () => {
        if (!desktopScrolly.matches || observer) return;
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) setActive((entry.target as HTMLElement).dataset.landingScrollyStep);
            }
          },
          { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
        );
        for (const step of steps) observer.observe(step);
      };
      const disconnect = () => {
        observer?.disconnect();
        observer = undefined;
      };

      connect();
      desktopScrolly.addEventListener("change", (event) => (event.matches ? connect() : disconnect()));
    });
  </script>
