---
/*
 * Landing page: sober and text-led. One idea (the contract), what exists today, and one real
 * contract rendered from a usage tree.
 */
import Base from "../../layouts/Base.astro";
import SiteFooter from "../SiteFooter.astro";
import { getNavigation } from "../../lib/navigation";
import { getLocale, localizePath } from "../../i18n";
import { emitMarkup } from "@skryensya/ai-compiler/emit";
import { buttonContract } from "@skryensya/core/button";
import type { UsageTree } from "@skryensya/core/usage-tree";

import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/patterns/wrapper.css";
import "@skryensya/core/patterns/footer.css";
import "@skryensya/core/patterns/nav-list.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/badge.css";
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/callout.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/stat.css";
import "@skryensya/core/components/progress.css";

const locale = getLocale(Astro.url);
const href = (path: string) => localizePath(path, locale);
const navigation = getNavigation(locale);
const es = locale === "es";

const copy = es
  ? {
      title: "skryensya/ui",
      description: "Sistema de diseño contract-first: cada componente parte de una definición y React o Vanilla la realizan igual.",
      eyebrow: "Sistema de diseño contract-first",
      heroTitle: "Componentes que parten de un contrato.",
      heroBody:
        "Cada componente se define primero: qué partes tiene, qué opciones acepta, qué atributos escribe, qué reglas de accesibilidad cumple y qué combinaciones tienen sentido. El código se escribe después, a partir de esa definición.",
      ctaComponents: "Ver componentes",
      ctaArchitecture: "Cómo funciona",
      ideaTitle: "Una alternativa al stack único",
      ideaBody: [
        "En sistemas institucionales lo habitual es ordenar el caos con un stack único para todos los proveedores. Baja la variación, pero fuerza una decisión técnica, reduce el grupo de proveedores posibles y sube el costo para la institución.",
        "Este sistema permite React, Vue o Vanilla sin convertirse en tres implementaciones paralelas: el comportamiento y la estructura viven en el contrato, y cada runtime los pinta.",
      ],
      pointsTitle: "Lo que ya existe",
      points: [
        { title: "100+ componentes documentados", body: "Cada página muestra el contrato, las opciones, las notas de accesibilidad y ejemplos renderizados." },
        { title: "Dos implementaciones", body: "React y Vanilla producen el mismo resultado a partir de la misma definición. No es una promesa futura." },
        { title: "Contratos legibles como datos", body: "Partes, opciones, atributos y reglas de accesibilidad están declarados como estructura, no escondidos en el código." },
      ],
      contractTitle: "Un contrato, paso a paso",
      contractBody:
        "Así se ve el contrato de Button. Los valores de la tabla se leen directamente del contrato real, no están copiados.",
      contractSteps: {
        contract: { title: "Contrato", note: "Lo que el componente declara" },
        tree: { title: "Árbol de uso", note: "Lo que alguien (o un asistente) propone" },
        result: { title: "Resultado", note: "Lo que se emite y se valida" },
      },
      contractCols: { option: "Opción", values: "Valores", writes: "Escribe" },
      contractParts: "Partes",
      contractRuleLabel: "Regla de accesibilidad",
      contractRule: "Si iconOnly es verdadero, el botón no muestra texto: exige aria-label o aria-labelledby.",
      contractResultNote: "El mismo árbol da el mismo markup en React y en Vanilla; los gates lo comparan.",
      statusTitle: "Estado actual",
      statusBody:
        "Es un WIP grande y deliberadamente ambicioso, pero ya tiene una base funcionando.",
      status: [
        { title: "Core", body: "Fuente de verdad: cada contrato vive aquí y los demás lo leen." },
        { title: "Documentación pública", body: "Contrato, opciones, accesibilidad y ejemplos por componente." },
        { title: "React y Vanilla", body: "Dos implementaciones que deben producir el mismo resultado." },
        { title: "Gates de consistencia", body: "Comparan árboles de uso entre bindings y convierten “debería ser consistente” en evidencia." },
      ],
      roadmapTitle: "Roadmap",
      roadmapBody:
        "Lo siguiente aprovecha la misma estructura para cosas que normalmente se construyen aparte.",
      roadmap: [
        { title: "Plugin para Figma", body: "Llevar los contratos al diseño, para que diseño e implementación partan de la misma definición." },
        { title: "Editor visual", body: "Componer interfaces sobre el catálogo, con árboles de uso válidos por construcción." },
        { title: "MCP que valida interfaces", body: "Consultar el catálogo como estructura y revisar una interfaz de forma programática: composición, atributos y markup esperado." },
      ],
      closeTitle: "Explora el catálogo",
      closeBody: "Más de 100 componentes documentados, cada uno con su contrato, opciones, notas de accesibilidad y ejemplos renderizados.",
      closeCta: "Ver componentes",
      closeInstall: "Instalación",
    }
  : {
      title: "skryensya/ui",
      description: "A contract-first design system: every component starts from a definition, and React or Vanilla realize it the same way.",
      eyebrow: "Contract-first design system",
      heroTitle: "Components that start from a contract.",
      heroBody:
        "Every component is defined first: which parts it has, which options it accepts, which attributes it writes, which accessibility rules it meets and which combinations make sense. The code is written afterwards, from that definition.",
      ctaComponents: "View components",
      ctaArchitecture: "How it works",
      ideaTitle: "An alternative to the single stack",
      ideaBody: [
        "In institutional systems the usual way to tame chaos is one stack for every vendor. It lowers variation, but it forces a technical decision, shrinks the pool of possible vendors and raises the cost for the institution.",
        "This system allows React, Vue or Vanilla without becoming three parallel implementations: behavior and structure live in the contract, and each runtime renders them.",
      ],
      pointsTitle: "What exists today",
      points: [
        { title: "100+ documented components", body: "Each page shows the contract, the options, accessibility notes and rendered examples." },
        { title: "Two implementations", body: "React and Vanilla produce the same result from the same definition. It is not a future promise." },
        { title: "Contracts readable as data", body: "Parts, options, attributes and accessibility rules are declared as structure, not buried in code." },
      ],
      contractTitle: "A contract, step by step",
      contractBody:
        "This is the Button contract. The values in the table are read straight from the real contract, not copied.",
      contractSteps: {
        contract: { title: "Contract", note: "What the component declares" },
        tree: { title: "Usage tree", note: "What a person (or an assistant) proposes" },
        result: { title: "Result", note: "What gets emitted and validated" },
      },
      contractCols: { option: "Option", values: "Values", writes: "Writes" },
      contractParts: "Parts",
      contractRuleLabel: "Accessibility rule",
      contractRule: "When iconOnly is true the button shows no text: it requires aria-label or aria-labelledby.",
      contractResultNote: "The same tree gives the same markup in React and Vanilla; the gates compare them.",
      statusTitle: "Current state",
      statusBody:
        "A large, deliberately ambitious work in progress, but with a working base already.",
      status: [
        { title: "Core", body: "The source of truth: every contract lives here and everything else reads it." },
        { title: "Public documentation", body: "Contract, options, accessibility and examples for each component." },
        { title: "React and Vanilla", body: "Two implementations that must produce the same result." },
        { title: "Consistency gates", body: "They compare usage trees across bindings and turn “this should be consistent” into evidence." },
      ],
      roadmapTitle: "Roadmap",
      roadmapBody:
        "What comes next reuses the same structure for things that are usually built separately.",
      roadmap: [
        { title: "Figma plugin", body: "Bring the contracts into design, so design and implementation start from the same definition." },
        { title: "Visual editor", body: "Compose interfaces on top of the catalogue, with usage trees valid by construction." },
        { title: "MCP that validates interfaces", body: "Query the catalogue as structure and check an interface programmatically: composition, attributes and expected markup." },
      ],
      closeTitle: "Explore the catalogue",
      closeBody: "100+ documented components, each with its contract, options, accessibility notes and rendered examples.",
      closeCta: "View components",
      closeInstall: "Installation",
    };

const signature = "Button.action";
const shownOptions = ["variant", "tone", "size", "iconOnly", "pressed"] as const;
const optionRows = shownOptions.map((name) => {
  const option = buttonContract.options[name];
  return {
    name,
    values: "values" in option ? option.values.join(" · ") : "true · false",
    writes: option.attr,
  };
});
const partNames = Object.keys(buttonContract.parts).join(" · ");

const buttonTree: UsageTree = {
  contract: "button",
  signature,
  options: { variant: "soft", tone: "danger" },
  children: es ? "Eliminar" : "Delete",
};
const buttonTreeSource = JSON.stringify(buttonTree, null, 2);
const buttonMarkup = emitMarkup(buttonTree, { fillDefaults: false, idPrefix: "landing-contract" });

const btn = (children: string, options: Record<string, string> = {}): UsageTree => ({
  contract: "button",
  signature: "Button.action",
  options,
  children,
});
const inline = (children: UsageTree[], gap = "sm"): UsageTree => ({
  contract: "layout",
  signature: "Inline",
  options: { gap, wrap: true },
  children,
});
const stack = (children: UsageTree[], gap = "sm"): UsageTree => ({
  contract: "layout",
  signature: "Stack",
  options: { gap },
  children,
});
const badge = (children: string, tone: string): UsageTree => ({
  contract: "badge",
  signature: "Badge",
  options: { tone },
  children,
});
const tag = (children: string, tone: string): UsageTree => ({
  contract: "tag",
  signature: "Tag",
  options: { tone },
  children,
});

// Bento cells on a 12 x 6 grid: [row, column, rowSpan, columnSpan]. A full tiling: the 13 tiles cover
// all 72 cells with no hole. Cut lines drift from band to band and tall tiles cross them, so edges
// rarely line up. `link` draws a stitch to the tile on its right (`linkY` is where along the tile it
// leaves).
type BentoTile = {
  id: string;
  label: string;
  area: [number, number, number, number];
  tree: UsageTree;
  link?: string;
  accent?: boolean;
};
const sized = (children: string, size: string): UsageTree => btn(children, { variant: "soft", tone: "accent", size });
const bentoTiles: BentoTile[] = [
  { id: "button", label: "Button", area: [1, 1, 2, 5], link: "50%", tree: inline([btn(es ? "Guardar" : "Save", { tone: "accent" }), btn(es ? "Cancelar" : "Cancel", { variant: "soft" }), btn(es ? "Omitir" : "Skip", { variant: "ghost" })]) },
  { id: "stat", label: "Stat", area: [1, 6, 2, 2], link: "25%", accent: true, tree: { contract: "stat", signature: "Stat", slots: { label: es ? "Componentes" : "Components", value: "100+" } } },
  { id: "badges", label: "Badge", area: [1, 8, 1, 5], tree: inline([badge("neutral", "neutral"), badge("accent", "accent"), badge("success", "success"), badge("warning", "warning"), badge("danger", "danger")], "xs") },
  {
    id: "card",
    label: "Heading · Button",
    area: [2, 8, 3, 3], link: "50%",
   
    tree: stack(
      [
        { contract: "typography", signature: "Heading", options: { headingSize: "h3", flush: true }, children: es ? "Aprobar solicitud" : "Approve request" },
        { contract: "typography", signature: "Text", options: { tone: "secondary" }, children: es ? "Un árbol de uso describe intención, estructura y reglas." : "A usage tree describes intent, structure and rules." },
        inline([btn(es ? "Aprobar" : "Approve", { tone: "accent" }), btn(es ? "Rechazar" : "Reject", { variant: "soft", tone: "danger" })]),
      ],
      "md",
    ),
  },
  { id: "tag", label: "Tag", area: [2, 11, 1, 2], tree: inline([tag("Beta", "accent"), tag(es ? "Nuevo" : "New", "success")], "xs") },
  { id: "tones", label: "Button", area: [3, 11, 3, 2], tree: stack([btn("Neutral"), btn("Accent", { tone: "accent" }), btn("Danger", { tone: "danger" })], "sm") },
  {
    id: "field",
    label: "FormField · Input",
    area: [3, 1, 2, 3], link: "24%",
   
    tree: { contract: "form-field", signature: "FormField", slots: { label: es ? "Nombre del proyecto" : "Project name" }, children: { contract: "input", signature: "Input", options: { controlSize: "md" }, attrs: { placeholder: "Aurora" } } },
  },
  { id: "progress", label: "Progress", area: [3, 4, 1, 4], tree: { contract: "progress", signature: "Progress", options: { value: 64, label: es ? "Avance" : "Progress" } } },
  {
    id: "callout",
    label: "Callout",
    area: [4, 4, 2, 4], link: "25%",
   
    tree: { contract: "callout", signature: "Callout", options: { tone: "info" }, slots: { title: es ? "Regla explícita" : "Explicit rule" }, children: es ? "iconOnly exige un nombre accesible." : "iconOnly requires an accessible name." },
  },
  { id: "sizes", label: "Button · size", area: [5, 1, 2, 3], link: "25%", tree: inline([sized("sm", "sm"), sized("md", "md"), sized("lg", "lg")]) },
  { id: "progress-b", label: "Progress", area: [5, 8, 1, 3], tree: { contract: "progress", signature: "Progress", options: { value: 32, label: es ? "Avance" : "Progress" } } },
  { id: "tag-b", label: "Tag", area: [6, 4, 1, 4], tree: inline([tag(es ? "Borrador" : "Draft", "warning"), tag(es ? "Obsoleto" : "Deprecated", "danger")], "xs") },
  { id: "bindings", label: "Bindings", area: [6, 8, 1, 5], tree: inline([tag("Vanilla", "neutral"), tag("React", "accent")], "xs") },
];
// Seven copies, the middle one centred: there is always a copy on both sides, and the track only ever
// shifts by one set.
const bentoLoops = [0, 1, 2, 3, 4, 5, 6];
---

<Base fullBleed title={copy.title} description={copy.description} hideVanillaMount alwaysShowNavTrigger={false}>
  <main class="landing-page">
    <div class="sk-wrapper" data-size="lg" data-gutter="lg">
      <section class="landing-hero" aria-labelledby="landing-title">
        <p class="landing-kicker">{copy.eyebrow}</p>
        <h1 id="landing-title" class="landing-title">{copy.heroTitle}</h1>
        <p class="sk-text landing-prose" data-size="lg" data-tone="secondary">{copy.heroBody}</p>
        <div class="sk-inline" data-gap="sm" data-wrap>
          <a class="sk-button sk-interactive" data-sk-button data-tone="accent" href={href("/components")}>{copy.ctaComponents}</a>
          <a class="sk-button sk-interactive" data-sk-button data-variant="ghost" href={href("/architecture")}>{copy.ctaArchitecture}</a>
        </div>
      </section>

      <section class="landing-row" aria-labelledby="landing-idea-title">
        <h2 id="landing-idea-title" class="landing-heading">{copy.ideaTitle}</h2>
        <div class="landing-body">
          {copy.ideaBody.map((paragraph) => <p class="sk-text landing-prose" data-tone="secondary" data-read>{paragraph}</p>)}
        </div>
      </section>

      <section class="landing-row" aria-labelledby="landing-points-title">
        <h2 id="landing-points-title" class="landing-heading">{copy.pointsTitle}</h2>
        <ul class="landing-body landing-list">
          {copy.points.map((point) => (
            <li data-read>
              <h3 class="landing-subheading">{point.title}</h3>
              <p class="sk-text" data-tone="secondary">{point.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="landing-row" aria-labelledby="landing-contract-title">
        <div class="landing-heading-group">
          <h2 id="landing-contract-title" class="landing-heading">{copy.contractTitle}</h2>
          <p class="sk-text" data-tone="secondary">{copy.contractBody}</p>
        </div>
        <div class="landing-body landing-steps">
          <figure class="landing-step" data-read>
            <figcaption>
              <span class="landing-step__index">01</span>
              <span class="landing-step__title">{copy.contractSteps.contract.title}</span>
              <span class="landing-step__note">{copy.contractSteps.contract.note}</span>
            </figcaption>
            <div class="landing-step__body">
              <p class="landing-meta"><span>{signature}</span><span>{copy.contractParts}: <code>{partNames}</code></span></p>
              <table class="landing-table">
                <thead>
                  <tr><th scope="col">{copy.contractCols.option}</th><th scope="col">{copy.contractCols.values}</th><th scope="col">{copy.contractCols.writes}</th></tr>
                </thead>
                <tbody>
                  {optionRows.map((row) => (
                    <tr><th scope="row"><code>{row.name}</code></th><td>{row.values}</td><td><code>{row.writes}</code></td></tr>
                  ))}
                </tbody>
              </table>
              <p class="landing-rule"><strong>{copy.contractRuleLabel}.</strong> {copy.contractRule}</p>
            </div>
          </figure>

          <figure class="landing-step" data-read>
            <figcaption>
              <span class="landing-step__index">02</span>
              <span class="landing-step__title">{copy.contractSteps.tree.title}</span>
              <span class="landing-step__note">{copy.contractSteps.tree.note}</span>
            </figcaption>
            <div class="landing-step__body"><pre class="landing-code"><code>{buttonTreeSource}</code></pre></div>
          </figure>

          <figure class="landing-step" data-read>
            <figcaption>
              <span class="landing-step__index">03</span>
              <span class="landing-step__title">{copy.contractSteps.result.title}</span>
              <span class="landing-step__note">{copy.contractSteps.result.note}</span>
            </figcaption>
            <div class="landing-step__body">
              <div class="landing-result" set:html={buttonMarkup} />
              <pre class="landing-code"><code>{buttonMarkup}</code></pre>
              <p class="landing-rule">{copy.contractResultNote}</p>
            </div>
          </figure>
        </div>
      </section>

      <section class="landing-row" aria-labelledby="landing-status-title">
        <div class="landing-heading-group">
          <h2 id="landing-status-title" class="landing-heading">{copy.statusTitle}</h2>
          <p class="sk-text" data-tone="secondary">{copy.statusBody}</p>
        </div>
        <ul class="landing-body landing-list">
          {copy.status.map((item) => (
            <li data-read>
              <h3 class="landing-subheading">{item.title}</h3>
              <p class="sk-text" data-tone="secondary">{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="landing-row" aria-labelledby="landing-roadmap-title">
        <div class="landing-heading-group">
          <h2 id="landing-roadmap-title" class="landing-heading">{copy.roadmapTitle}</h2>
          <p class="sk-text" data-tone="secondary">{copy.roadmapBody}</p>
        </div>
        <div class="landing-body">
          <ol class="landing-roadmap">
            {copy.roadmap.map((item, index) => (
              <li data-read>
                <span class="landing-roadmap__index">{String(index + 1).padStart(2, "0")}</span>
                <div class="landing-roadmap__text">
                  <h3 class="landing-subheading">{item.title}</h3>
                  <p class="sk-text" data-tone="secondary">{item.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

    </div>

    <div class="sk-wrapper" data-size="lg" data-gutter="lg">
      <section class="landing-closing" aria-labelledby="landing-closing-title">
        <h2 id="landing-closing-title" class="landing-closing__title">{copy.closeTitle}</h2>
        <div class="landing-closing__body">
          <p class="sk-text landing-prose" data-tone="secondary">{copy.closeBody}</p>
          <div class="sk-inline" data-gap="sm" data-wrap>
            <a class="sk-button sk-interactive" data-sk-button data-tone="accent" data-size="lg" href={href("/components")}>{copy.closeCta}</a>
            <a class="sk-button sk-interactive" data-sk-button data-variant="soft" data-size="lg" href={href("/installation")}>{copy.closeInstall}</a>
          </div>
        </div>
      </section>

    </div>

    <div class="landing-marquee" aria-hidden="true">
      <div class="landing-marquee__track">
        {bentoLoops.map((loop) => (
          <div class="landing-bento" inert>
            {bentoTiles.map((tile) => (
              <div
                class="sk-box landing-tile"
                data-surface="surface"
                data-border="subtle"
                data-accent={tile.accent ? "" : undefined}
                data-link={tile.link ? "" : undefined}
                style={`grid-area: ${tile.area[0]} / ${tile.area[1]} / span ${tile.area[2]} / span ${tile.area[3]};${tile.link ? ` --link-y: ${tile.link};` : ""}`}
              >
                <span class="landing-tile__label">{tile.label}</span>
                <div class="landing-tile__demo" set:html={emitMarkup(tile.tree, { fillDefaults: false, idPrefix: `bento-${loop}-${tile.id}` })} />
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="sk-wrapper" data-size="lg" data-gutter="lg">
      <SiteFooter nav={navigation} locale={locale} />
    </div>
  </main>
</Base>

<script>
  // Highlights the right-column block that sits in the reading band while scrolling.
  // Only one block is active at a time (the first in document order that crosses the band).
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-read]"));
  const inBand = new Set<HTMLElement>();

  const sync = () => {
    const active = items.find((item) => inBand.has(item));
    for (const item of items) item.toggleAttribute("data-active", item === active);
  };

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBand.add(entry.target as HTMLElement);
          else inBand.delete(entry.target as HTMLElement);
        }
        sync();
      },
      { rootMargin: "-35% 0px -50% 0px" },
    );
    for (const item of items) observer.observe(item);
  }
</script>

<style>
  .landing-page {
    --landing-read-bg: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    background: var(--color-surface-canvas);
  }

  .landing-hero,
  .landing-row {
    display: grid;
    gap: var(--space-stack-lg);
    padding-block: clamp(3rem, 6vw, 5rem);
    border-block-end: 1px solid var(--color-border-subtle);
  }

  .landing-hero {
    justify-items: start;
    padding-block-start: clamp(4rem, 8vw, 7rem);
  }

  .landing-row {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }

  .landing-row > :first-child {
    position: sticky;
    inset-block-start: 6rem;
  }

  /* Reading highlight: the block in the reading band gets a raised background. */
  .landing-page [data-read] {
    margin-inline-start: calc(-1 * var(--space-inset-md));
    padding-inline: var(--space-inset-md);
    border-radius: var(--radius-md);
    transition: background-color 0.2s ease;
  }

  .landing-list > li,
  .landing-body > p[data-read] {
    margin-block: calc(-1 * var(--space-inset-sm));
    padding-block: var(--space-inset-sm);
  }

  [data-read][data-active] {
    background: var(--landing-read-bg);
  }

  [data-read].sk-text[data-active],
  [data-read][data-active] .sk-text,
  [data-read][data-active] .landing-subheading {
    color: var(--color-text-primary);
  }

  .landing-kicker {
    margin: 0;
    color: var(--color-text-secondary);
    font: var(--font-label-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .landing-title {
    margin: 0;
    max-inline-size: 22ch;
    font-size: clamp(2rem, 4.5vw, 3rem);
