---
/*
 * How a component is built: the contract, the stylesheet, the machine, the binding.
 *
 * This was the Accordion page's "Arquitectura" tab, and it was never about the Accordion. Every
 * string in it described the platform, and its own lede said so ("esta página usa Accordion como
 * ejemplo"), while living under `accordion.*` keys inside a tab strip that promised the page's own
 * contents. Sixty component pages would each have carried the same four paragraphs, updated in one.
 *
 * So it is a page, and the component pages link to it. The Accordion worked example stays: the model
 * is easier to believe against something real than in the abstract.
 */
import Base from "../../layouts/Base.astro";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
---

<Base title={t("architecture.title")} description={t("architecture.lede")} documentLayout="grid">
  <h1>{t("architecture.title")}</h1>
  <p class="lede" set:html={t("architecture.lede")} />

  <h2>{t("architecture.layersTitle")}</h2>
  <ol>
    <li set:html={t("architecture.layer1")} />
    <li set:html={t("architecture.layer2")} />
    <li set:html={t("architecture.layer3")} />
    <li set:html={t("architecture.layer4")} />
  </ol>

  <h2>{t("architecture.flowTitle")}</h2>
  <ol>
    <li set:html={t("architecture.flow1")} />
    <li set:html={t("architecture.flow2")} />
    <li set:html={t("architecture.flow3")} />
    <li set:html={t("architecture.flow4")} />
  </ol>

  <h2>{t("architecture.useTitle")}</h2>
  <ul>
    <li set:html={t("architecture.use1")} />
    <li set:html={t("architecture.use2")} />
    <li set:html={t("architecture.use3")} />
  </ul>

  <h2>{t("architecture.exampleTitle")}</h2>
  <p set:html={t("architecture.exampleBody")} />
</Base>
