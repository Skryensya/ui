---
import "@skryensya/core/components/separator.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The demos put the rule between real content, and a frame only copies styles THIS page loaded. */
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/patterns/layout.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { separatorDoSpaceTree, separatorDontEveryRowTree } from "../../demos/separator";
import {
  separatorAnatomyTree,
  separatorLabelledTree,
  separatorSingleTree,
  separatorTree,
  separatorVerticalTree,
  separatorScaleSpecimenTree,
} from "../../demos/separator";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`separatorPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
const styles = `@import "@skryensya/core/components/separator.css";`;
---

<ComponentPageShell
  title="Separator"
  description={t("separatorPage.description")}
  contractId="separator"
  testFiles={["packages/react/src/components/separator.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("separatorPage.lede")} />

    <UsagePreview
      tree={separatorSingleTree()}
      optionName="tone"
      title={t("separatorPage.prop.tone.title")}
      description={t("separatorPage.prop.tone.body")}
      explain={explain("tone", ["subtle", "default", "strong"])}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={separatorSingleTree()}
      optionName="orientation"
      title={t("separatorPage.prop.orientation.title")}
      description={t("separatorPage.prop.orientation.body")}
      explain={explain("orientation", ["horizontal", "vertical"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={separatorTree(t)} title={t("separatorPage.meaningTitle")} description={t("separatorPage.meaningBody")} />
    <UsagePreview tree={separatorVerticalTree(t)} title={t("separatorPage.verticalTitle")} description={t("separatorPage.verticalBody")} />
    <UsagePreview tree={separatorLabelledTree(t)} title={t("separatorPage.labelledTitle")} description={t("separatorPage.labelledBody")} />
    <UsagePreview
      tree={variantsTree(separatorScaleSpecimenTree(), [{ label: "none", options: { spacing: "none" } }, { label: "sm", options: { spacing: "sm" } }, { label: "md", options: { spacing: "md" } }, { label: "lg", options: { spacing: "lg" } }], ["children", 1])}
      title={t("component.scaleTitle", { option: "spacing" })}
      description={t("component.scaleBody")}
    />


    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "separatorPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("separatorPage.anatomyBody")} />
    <UsagePreview
      tree={separatorAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("separatorPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("separatorPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "separatorPage.when")} avoid={tList(t, "separatorPage.whenNot")} />
    <DoDont
      title={t("separatorPage.dd.meaning.title")}
      do={{ tree: separatorDoSpaceTree, caption: t("separatorPage.dd.meaning.do") }}
      dont={{ tree: separatorDontEveryRowTree, caption: t("separatorPage.dd.meaning.dont") }}
    />
    <ContentRules items={tList(t, "separatorPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("separatorPage.a11yIntro")} does={tList(t, "separatorPage.a11yDoes")} yours={tList(t, "separatorPage.a11yYours")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>
