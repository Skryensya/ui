---
import "@skryensya/core/components/separator.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The demos put the rule between real content, and a frame only copies styles THIS page loaded. */
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/patterns/layout.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  separatorAnatomyTree,
  separatorLabelledTree,
  separatorTonesTree,
  separatorSingleTree,
  separatorTree,
  separatorVerticalTree,
  separatorScaleSpecimenTree,
} from "../../demos/separator";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`separatorPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
const styles = `@import "@skryensya/core/components/separator.css";`;
---

<ComponentPageShell
  title="Separator"
  description={t("separatorPage.description")}
  contractId="separator"
  testFiles={["packages/react/src/components/separator.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("separatorPage.lede")} />

    <UsagePreview
      tree={separatorSingleTree()}
      optionName="tone"
      title={t("separatorPage.prop.tone.title")}
      description={t("separatorPage.prop.tone.body")}
      explain={explain("tone", ["subtle", "default", "strong"])}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={separatorSingleTree()}
      optionName="orientation"
      title={t("separatorPage.prop.orientation.title")}
      description={t("separatorPage.prop.orientation.body")}
      explain={explain("orientation", ["horizontal", "vertical"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("separatorPage.showcaseTitle")}</h3>
    <p set:html={t("separatorPage.showcaseBody")} />
    <UsagePreview tree={separatorTree(t)} title="Separator" description={t("separatorPage.meaningBody")} />
    <UsagePreview tree={separatorTonesTree(t)} title={t("separatorPage.tonesTitle")} description={t("separatorPage.tonesBody")} />
    <UsagePreview tree={separatorVerticalTree(t)} title={t("separatorPage.verticalTitle")} description={t("separatorPage.verticalBody")} />
    <UsagePreview tree={separatorLabelledTree(t)} title={t("separatorPage.labelledTitle")} description={t("separatorPage.labelledBody")} />

    <h3>{t("separatorPage.whenTitle")}</h3>
    <ul>
      <li set:html={t("separatorPage.whenItem1")} />
      <li set:html={t("separatorPage.whenItem2")} />
      <li set:html={t("separatorPage.whenItem3")} />
      <li set:html={t("separatorPage.whenItem4")} />
    </ul>

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("separatorPage.contractItem1")} />
      <li set:html={t("separatorPage.contractItem2")} />
      <li set:html={t("separatorPage.contractItem3")} />
      <li set:html={t("separatorPage.contractItem4")} />
    </ul>

    <UsagePreview
      tree={variantsTree(separatorScaleSpecimenTree(), [{ label: "none", options: { spacing: "none" } }, { label: "sm", options: { spacing: "sm" } }, { label: "md", options: { spacing: "md" } }, { label: "lg", options: { spacing: "lg" } }], ["children", 1])}
      title={t("component.scaleTitle", { option: "spacing" })}
      description={t("component.scaleBody")}
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("separatorPage.anatomyBody")} />
    <ComponentPreview
      tree={separatorAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("separatorPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("separatorPage.guidelinesLede")} />
    <DoDont
      title={t("separatorPage.dd.meaning.title")}
      do={{ tree: separatorTree(t), caption: t("separatorPage.dd.meaning.do") }}
      dont={{ tree: separatorTonesTree(t), caption: t("separatorPage.dd.meaning.dont") }}
    />
    <DoDont
      title={t("separatorPage.dd.label.title")}
      do={{ tree: separatorLabelledTree(t), caption: t("separatorPage.dd.label.do") }}
      dont={{ tree: separatorVerticalTree(t), caption: t("separatorPage.dd.label.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>
