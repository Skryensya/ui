---
import "@skryensya/core/components/expressive-avatar.css";
import "@skryensya/core/components/expressive-avatar-tileset.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import WhenToUse from "../WhenToUse.astro";
import A11yNotes from "../A11yNotes.astro";
import ComparisonTable from "../ComparisonTable.astro";
import "@skryensya/core/components/procedure.css";
import { Procedure, ProcedureStep } from "@skryensya/react/procedure";
import { ExpressiveAvatar } from "@skryensya/react/expressive-avatar";
import { ExpressiveAvatarTriggers } from "../react-demos/expressive-avatar-triggers";
import {
  expressiveAvatarGrid,
  expressiveAvatarLeftEyeTiles,
  expressiveAvatarMouthLeftTiles,
  expressiveAvatarOutfitIndices,
  expressiveAvatarRequiredTiles,
  type ExpressiveAvatarDirection,
  type ExpressiveAvatarMouth,
} from "@skryensya/core/expressive-avatar";
import { expressiveAvatarAtlasLayout } from "@skryensya/core/expressive-avatar-atlas";
import { getLocale } from "../../i18n";

const locale = getLocale(Astro.url);
const copy = locale === "es"
