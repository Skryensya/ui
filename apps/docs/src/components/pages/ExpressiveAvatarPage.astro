---
import "@skryensya/core/components/expressive-avatar.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import WhenToUse from "../WhenToUse.astro";
import A11yNotes from "../A11yNotes.astro";
import ComparisonTable from "../ComparisonTable.astro";
import "@skryensya/core/components/procedure.css";
import { Procedure, ProcedureStep } from "@skryensya/react/procedure";
import { ExpressiveAvatar } from "@skryensya/react/expressive-avatar";
import { ExpressiveAvatarTriggers } from "../react-demos/expressive-avatar-triggers";
import { ExpressiveAvatarCheck } from "../react-demos/expressive-avatar-check";
import { expressiveAvatarImages, expressiveAvatarLooks } from "@skryensya/core/expressive-avatar";
import { getLocale } from "../../i18n";

const locale = getLocale(Astro.url);
const copy = locale === "es"
  ? {
      description: "Avatar reactivo con expresiones: una imagen entera por cada estado. Te mira, parpadea y habla.",
      lede: "ExpressiveAvatar muestra una identidad visual que te mira, parpadea y habla. Cada expresión es una <strong>imagen entera</strong> y el componente solo decide cuál mostrar: la dibujas como quieras (pixel art, ilustración, fotos) y una expresión nueva es una imagen más.",
      aliveTitle: "Viva: te mira y te habla",
      aliveBody: "Con <code>interactive</code> sigue el puntero con la mirada, parpadea sola y, al hacer clic, dice su siguiente frase moviendo la boca. Pasa el cursor por encima y haz clic.",
      phrases: {
        greetings: [{ text: "Hola, soy Allison", category: "short" as const }, { text: "Qué bueno verte por aquí", category: "short" as const }],
        general: [
          { text: "Me gustan las cosas pequeñas y bien hechas", category: "mid" as const },
          { text: "Los componentes también pueden tener cara", category: "mid" as const },
          { text: "¿Viste cómo te seguía con la mirada?", category: "mid" as const },
          { text: "Cada gesto mío es una imagen entera", category: "short" as const },
        ],
      },
      imagesTitle: "Una imagen por expresión",
      imagesBody: "Le das un mapa de nombres a imágenes. Solo <code>base</code> es obligatoria: es la cara de frente y la que muestra cuando una expresión no tiene imagen. Si tus archivos llevan el nombre de la expresión, <code>expressiveAvatarImages</code> arma el mapa desde la carpeta; si solo tienes una imagen, <code>src</code> basta.",
      imagesOne: "Una cara es una expresión a la vez: al hablar mira al frente y un parpadeo a mitad de palabra se omite. Con <code>interactive</code> se cargan todas las imágenes y se apilan, así que cambiar de expresión es cambiar cuál se ve y nunca muestra un hueco.",
      expressionsTitle: "Las diecinueve expresiones",
      expressionsBody: "Nueve miradas, parpadeo y guiño, y ocho bocas (una por vocal, una cerrada para m, b y p, una neutra y la sonrisa). Con <code>expression</code> pides una por su nombre; al seguir el puntero o hablar, el componente elige solo.",
      gazeLabel: "Mirada",
      eyesLabel: "Ojos",
      mouthLabel: "Boca",
      extendTitle: "Crea tus propias expresiones y dispáralas",
      extendLede: "Una expresión es un nombre con una imagen. No hay nada más que registrar: la agregas al mapa <code>images</code> y la pides por ese nombre.",
      extendSteps: [
        { title: "Dibuja la imagen", body: "Con el mismo tamaño y encuadre que las demás: así la cara cambia sin saltar." },
        { title: "Dale un nombre", body: "Agrégala a <code>images</code> con el nombre que quieras (<code>asombro</code>, <code>pensando</code>). Un nombre sin imagen no cambia nada: sigue la cara que había." },
        { title: "Dispárala", body: "De cuatro formas, abajo: el valor <code>expression</code>, el manejador del avatar, un evento en su elemento y una frase que la pide mientras habla." },
      ],
      triggersTitle: "Cómo dispararla",
      triggerColumns: ["Cuándo sirve"],
      triggerAspect: "Forma",
      triggerRows: [
        { label: "El valor <code>expression</code>", cells: ["Cuando el estado depende de tu interfaz: un formulario con error, un asistente que piensa. El avatar la muestra mientras valga."] },
        { label: "El manejador (<code>apiRef</code>)", cells: ["Cuando algo ocurre en un momento: un botón, un temporizador, una respuesta que llega. Puede durar un tiempo y se quita sola."] },
        { label: "Un evento en el avatar", cells: ["Cuando quien lo dispara no tiene una referencia al componente: otro script, otro framework, un elemento en otra parte de la página."] },
        { label: "Una frase", cells: ["Cuando la expresión va con lo que dice: la frase la pide y la mantiene mientras se escribe y se lee. Mientras vale, la boca no se mueve: la expresión es la cara entera."] },
      ],
      triggersDemoTitle: "Pruébalo",
      triggersDemoBody: "Tres expresiones propias, <code>asombro</code>, <code>duda</code> y <code>picaro</code>: cada una es un nombre con una imagen. Aquí reutilizan imágenes que ya existen; en tu cara serían dibujos nuevos. Cada botón la dispara de una forma distinta.",
      triggers: {
        asombro: "Asombro",
        duda: "Duda",
        picaro: "Pícaro",
        clear: "Quitar",
        viaApi: "Con el manejador",
        viaEvent: "Con un evento en el avatar",
        viaPhrase: "Con una frase",
        phrase: "¡Sorpresa!",
        eventButton: "Asombro, por evento",
        phraseButton: "Decir una frase pícara",
      },
      guideTitle: "Haz tu propia cara",
      guideLede: "Dibuja una imagen por expresión, todas con el mismo encuadre, y pásalas al componente. Con la base basta para empezar: las que falten muestran la base.",
      guideSteps: [
        { title: "Decide el encuadre", body: "Un retrato cuadrado, de frente, con la cabeza centrada. Todas las imágenes comparten tamaño y encuadre: es lo que hace que la cara cambie sin saltar." },
        { title: "Dibuja la base", body: "<code>base</code> es la cara de frente con la boca en reposo. Es la única obligatoria, y la que se muestra mientras no haya nada mejor." },
        { title: "Dibuja los ojos", body: "Ocho miradas hacia los lados (<code>top-left</code>, <code>top</code>, <code>top-right</code>, <code>left</code>, <code>right</code>, <code>bottom-left</code>, <code>bottom</code>, <code>bottom-right</code>), <code>blink</code> y <code>wink</code>. Solo cambian los ojos: deja la boca y la cabeza como en la base." },
        { title: "Dibuja la boca", body: "Una por vocal (<code>a</code>, <code>e</code>, <code>i</code>, <code>o</code>, <code>u</code>), <code>closed</code> para m, b y p, <code>neutral</code> y <code>smile</code>. Son las que usa al hablar." },
        { title: "Exporta una imagen por expresión", body: "Cuadradas, con fondo transparente y el nombre de la expresión como nombre de archivo: <code>base.webp</code>, <code>top-left.webp</code>… Desde 320 píxeles de lado se ve nítida en el tamaño más grande con pantallas densas." },
        { title: "Compruébalas aquí", body: "Elige todos los archivos juntos en la comprobación de abajo: te dice qué falta, si alguna no es cuadrada o de otro tamaño, y te enseña tu cara viva con tus imágenes." },
        { title: "Úsalas", body: "Ponlas en una carpeta pública y pásalas con <code>expressiveAvatarImages</code>. Con <code>looks</code> listas solo las que dibujaste y las expresiones nuevas." },
      ],
      tipsTitle: "Para que se vea bien",
      tips: [
        "Cada imagen es una cara completa, no una pieza: dibuja y exporta cada expresión entera.",
        "Con fondo transparente, el círculo es el papel y sigue claro en dark mode: dibuja tinta oscura, o cambia el fondo con <code>--sk-expressive-avatar-bg</code>.",
        "Pixel art: pon <code>--sk-expressive-avatar-image-rendering: pixelated</code> y exporta a un múltiplo entero del tamaño en que se verá.",
        "Una imagen de 250 píxeles en WebP sin pérdida pesa unos 7 KB: las diecinueve son unos 130 KB. Con <code>interactive</code> se cargan todas.",
      ],
      checkTitle: "Comprueba tus imágenes",
      checkBody: "Elige todos los archivos de una vez. No salen de tu navegador.",
      check: {
        choose: "Elegir imágenes",
        idle: "Esperando imágenes.",
        reading: "Leyendo las imágenes…",
        notImages: "Esos archivos no son imágenes.",
        ok: "Todo en orden: {count} imágenes, todas de {size}.",
        missingBase: "Falta <code>base</code>: es la imagen de respaldo y la única obligatoria. El archivo se llama <code>base</code> más la extensión.",
        notSquare: "No son cuadradas: {names}.",
        mixedSizes: "Tienen tamaños distintos ({sizes}): la cara saltaría al cambiar de expresión.",
        builtIn: "{found} de {total} expresiones incluidas.",
        fallsBack: "Estas muestran la base: {names}.",
        custom: "Expresiones propias: {names}.",
        preview: "Tu cara",
      },
      accessibility: "El nombre accesible identifica a la persona, personaje o asistente. Las imágenes internas son decorativas, y la frase que dice se anuncia una sola vez a los lectores de pantalla.",
      use: ["Asistentes, mascotas y personajes que expresan estados."],
      avoid: ["Identidades estáticas y compactas en listas: usa Avatar."],
      install: "Instala el paquete React y la hoja de estilos del componente.",
    }
  : {
      description: "Reactive avatar with expressions: one whole image per state. It looks at you, blinks and talks.",
      lede: "ExpressiveAvatar shows a visual identity that looks at you, blinks and talks. Each expression is a <strong>whole image</strong> and the component only decides which one to show: draw it however you like (pixel art, illustration, photos), and a new expression is one more image.",
      aliveTitle: "Alive: it looks at you and talks to you",
      aliveBody: "With <code>interactive</code> it follows the pointer with its eyes, blinks on its own and, on a click, says its next phrase moving its mouth. Move the cursor over it and click.",
      phrases: {
        greetings: [{ text: "Hi, I'm Allison", category: "short" as const }, { text: "Good to see you here", category: "short" as const }],
        general: [
          { text: "I like small things done well", category: "mid" as const },
          { text: "Components can have a face too", category: "mid" as const },
          { text: "Did you see it follow you with its eyes?", category: "mid" as const },
          { text: "Every gesture of mine is a whole image", category: "short" as const },
        ],
      },
      imagesTitle: "One image per expression",
      imagesBody: "You give it a map of names to images. Only <code>base</code> is required: it is the face looking ahead, and what it shows when an expression has no image. If your files are named after the expressions, <code>expressiveAvatarImages</code> builds the map from the folder; with a single image, <code>src</code> is enough.",
      imagesOne: "A face is in one expression at a time: it looks ahead while it talks, and a blink in the middle of a word is skipped. With <code>interactive</code> every image is loaded and stacked, so changing expression is changing which one is visible and never shows a gap.",
      expressionsTitle: "The nineteen expressions",
      expressionsBody: "Nine gazes, a blink and a wink, and eight mouths (one per vowel, a closed one for m, b and p, a neutral one and the smile). You ask for one by name with <code>expression</code>; following the pointer or talking, the component picks on its own.",
      gazeLabel: "Gaze",
      eyesLabel: "Eyes",
      mouthLabel: "Mouth",
      extendTitle: "Create your own expressions and trigger them",
      extendLede: "An expression is a name with an image. There is nothing else to register: you add it to the <code>images</code> map and ask for it by that name.",
      extendSteps: [
        { title: "Draw the image", body: "Same size and framing as the others, so the face changes without jumping." },
        { title: "Give it a name", body: "Add it to <code>images</code> under any name (<code>astonished</code>, <code>thinking</code>). A name with no image changes nothing: the face carries on as it was." },
        { title: "Trigger it", body: "Four ways, below: the <code>expression</code> value, the avatar's handle, an event on its element and a phrase that asks for it while it speaks." },
      ],
      triggersTitle: "How to trigger it",
      triggerColumns: ["When it fits"],
      triggerAspect: "Way",
      triggerRows: [
        { label: "The <code>expression</code> value", cells: ["When the state depends on your interface: a form with an error, an assistant that is thinking. The avatar shows it for as long as it holds."] },
        { label: "The handle (<code>apiRef</code>)", cells: ["When something happens at a moment: a button, a timer, a response arriving. It can last a while and lifts by itself."] },
        { label: "An event on the avatar", cells: ["When whatever triggers it has no reference to the component: another script, another framework, an element elsewhere on the page."] },
        { label: "A phrase", cells: ["When the expression goes with what it says: the phrase asks for it and holds it while it is typed and read. While it holds, the mouth does not move: the expression is the whole face."] },
      ],
      triggersDemoTitle: "Try it",
      triggersDemoBody: "Three expressions of its own, <code>asombro</code>, <code>duda</code> and <code>picaro</code>: each is a name with an image. Here they reuse images that already exist; on your face they would be new drawings. Each button triggers it a different way.",
      triggers: {
        asombro: "Amazed",
        duda: "Doubt",
        picaro: "Cheeky",
        clear: "Clear",
        viaApi: "With the handle",
        viaEvent: "With an event on the avatar",
        viaPhrase: "With a phrase",
        phrase: "Surprise!",
        eventButton: "Amazed, by event",
        phraseButton: "Say a cheeky phrase",
      },
      guideTitle: "Make your own face",
      guideLede: "Draw one image per expression, all with the same framing, and pass them to the component. The base is enough to start: the ones you leave out show the base.",
      guideSteps: [
        { title: "Decide the framing", body: "A square portrait, front on, head centred. Every image shares size and framing: that is what lets the face change without jumping." },
        { title: "Draw the base", body: "<code>base</code> is the face looking ahead with the mouth at rest. It is the only one required, and the one shown while there is nothing better." },
        { title: "Draw the eyes", body: "Eight side looks (<code>top-left</code>, <code>top</code>, <code>top-right</code>, <code>left</code>, <code>right</code>, <code>bottom-left</code>, <code>bottom</code>, <code>bottom-right</code>), <code>blink</code> and <code>wink</code>. Only the eyes change: leave the mouth and head as in the base." },
        { title: "Draw the mouth", body: "One per vowel (<code>a</code>, <code>e</code>, <code>i</code>, <code>o</code>, <code>u</code>), <code>closed</code> for m, b and p, <code>neutral</code> and <code>smile</code>. These are what it uses to talk." },
        { title: "Export one image per expression", body: "Square, with a transparent background and the expression's name as the file name: <code>base.webp</code>, <code>top-left.webp</code>… From 320 pixels a side it stays sharp at the largest size on dense screens." },
        { title: "Check them here", body: "Choose all the files together in the check below: it tells you what is missing, whether any is not square or a different size, and shows your face alive with your images." },
        { title: "Use them", body: "Put them in a public folder and pass them with <code>expressiveAvatarImages</code>. With <code>looks</code> you list only the ones you drew and your new expressions." },
      ],
      tipsTitle: "To make it look right",
      tips: [
        "Each image is a whole face, not a piece: draw and export every expression complete.",
        "With a transparent background, the circle is the paper and stays light in dark mode: draw dark ink, or change the ground with <code>--sk-expressive-avatar-bg</code>.",
        "Pixel art: set <code>--sk-expressive-avatar-image-rendering: pixelated</code> and export at a whole multiple of the size it will show at.",
        "A 250 pixel image as lossless WebP weighs about 7 KB: all nineteen are about 130 KB. With <code>interactive</code> they are all loaded.",
      ],
      checkTitle: "Check your images",
      checkBody: "Choose all the files at once. They never leave your browser.",
      check: {
        choose: "Choose images",
        idle: "Waiting for images.",
        reading: "Reading the images…",
        notImages: "Those files are not images.",
        ok: "All in order: {count} images, every one {size}.",
        missingBase: "<code>base</code> is missing: it is the fallback and the only one required. The file is called <code>base</code> plus its extension.",
        notSquare: "Not square: {names}.",
        mixedSizes: "They have different sizes ({sizes}): the face would jump when the expression changes.",
        builtIn: "{found} of {total} built-in expressions.",
        fallsBack: "These show the base: {names}.",
        custom: "Your own expressions: {names}.",
        preview: "Your face",
      },
      accessibility: "The accessible name identifies the person, character, or assistant. Internal images are decorative, and the phrase it says is announced once to screen readers.",
      use: ["Assistants, mascots, and characters that express states."],
      avoid: ["Compact static identities in lists: use Avatar."],
      install: "Install the React package and the component's stylesheet.",
    };

/* The bundled example face: nineteen images, one per expression. */
const stateImages = expressiveAvatarImages("/expressive-avatar/states");

/* Expressions of its own, for the triggers demo: each a name with an image (here, one that already exists). */
const triggerImages = {
  ...stateImages,
  asombro: stateImages.o!,
  duda: stateImages["top-right"]!,
  picaro: stateImages.wink!,
};

/* Every look, drawn as a card: the face and its name. */
type Look = { key: string; name: string };
const look = (names: readonly string[]): Look[] => names.map((name) => ({ key: name, name }));
const lookSections = [
  { title: copy.gazeLabel, looks: look(expressiveAvatarLooks.filter((name) => name === "base" || /^(top|bottom|left|right)/.test(name))) },
  { title: copy.eyesLabel, looks: look(["blink", "wink"]) },
  { title: copy.mouthLabel, looks: look(expressiveAvatarLooks.filter((name) => ["neutral", "closed", "a", "e", "i", "o", "u", "smile"].includes(name))) },
];

const usage = `import { ExpressiveAvatar } from "@skryensya/react/expressive-avatar";
import { expressiveAvatarImages } from "@skryensya/core/expressive-avatar";
import "@skryensya/core/components/expressive-avatar.css";

// /avatars/ada/base.webp, blink.webp, smile.webp, top-left.webp ...
const images = expressiveAvatarImages("/avatars/ada");

<ExpressiveAvatar
  name="Ada"
  size="xl"
  images={images}
  interactive
  phrases={{ greetings: [{ text: "Hi!" }], general: [{ text: "Nice to see you" }] }}
/>`;
const customUsage = `const images = {
  ...expressiveAvatarImages("/avatars/ada"),
  astonished: "/avatars/ada/astonished.webp", // a name of your own: one more image
};

<ExpressiveAvatar name="Ada" images={images} expression="astonished" />`;
const install = `pnpm add @skryensya/core @skryensya/react`;
---

<ComponentPageShell
  title="Expressive Avatar"
  description={copy.description}
  contractId="expressive-avatar"
  badge="Beta"
  testFiles={["packages/react/src/components/expressive-avatar.test.tsx", "packages/core/src/expressive-avatar-behavior.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={copy.lede} />

    <h3>{copy.aliveTitle}</h3>
    <p set:html={copy.aliveBody} />
    <div class="ea-stage">
      <ExpressiveAvatar client:visible name="Allison" size="xl" interactive images={stateImages} phrases={copy.phrases} />
    </div>

    <h3>{copy.imagesTitle}</h3>
    <p set:html={copy.imagesBody} />
    <CodeBlock code={usage} label="React" lang="tsx" note={copy.install} />
    <p set:html={copy.imagesOne} />

    <h3>{copy.expressionsTitle}</h3>
    <p set:html={copy.expressionsBody} />
    {lookSections.map((section) => (
      <section class="ea-looks" aria-label={section.title}>
        <h4 class="ea-looks__title">{section.title} <span class="ea-count">{section.looks.length}</span></h4>
        <ul class="ea-looks__grid" role="list">
          {section.looks.map((item) => (
            <li class="ea-look">
              <div class="ea-look__face">
                <ExpressiveAvatar name={item.name} size="md" images={stateImages} expression={item.name} loading="eager" />
              </div>
              <code class="ea-look__name">{item.name}</code>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <h3>{copy.extendTitle}</h3>
    <p set:html={copy.extendLede} />
    <Procedure>
      {copy.extendSteps.map((step) => (
        <ProcedureStep title={step.title}>
          <p set:html={step.body} />
        </ProcedureStep>
      ))}
    </Procedure>
    <CodeBlock code={customUsage} label="React" lang="tsx" />

    <h4>{copy.triggersTitle}</h4>
    <ComparisonTable
      aspectLabel={copy.triggerAspect}
      columns={copy.triggerColumns}
      rows={copy.triggerRows.map((row) => ({ label: row.label.replace(/<[^>]+>/g, ""), labelHtml: row.label, cells: row.cells }))}
    />

    <h4>{copy.triggersDemoTitle}</h4>
    <p set:html={copy.triggersDemoBody} />
    <div class="ea-stage ea-stage--triggers">
      <ExpressiveAvatarTriggers client:visible copy={copy.triggers} images={triggerImages} />
    </div>
  </Fragment>

  <Fragment slot="guidelines">
    <WhenToUse use={copy.use} avoid={copy.avoid} />

    <h3>{copy.guideTitle}</h3>
    <p class="lede" set:html={copy.guideLede} />
    <Procedure>
      {copy.guideSteps.map((step) => (
        <ProcedureStep title={step.title}>
          <p set:html={step.body} />
        </ProcedureStep>
      ))}
    </Procedure>

    <h4>{copy.tipsTitle}</h4>
    <ul>
      {copy.tips.map((tip) => <li set:html={tip} />)}
    </ul>

    <h3>{copy.checkTitle}</h3>
    <p>{copy.checkBody}</p>
    <div>
      <ExpressiveAvatarCheck client:visible copy={copy.check} />
    </div>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={copy.accessibility} does={[]} yours={[]} />
  </Fragment>
</ComponentPageShell>

<style>
  .ea-stage {
    display: flex;
    justify-content: center;
    padding: 7rem var(--space-inset-lg) var(--space-inset-lg);
    margin-block: var(--space-stack-lg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-surface);
    background: var(--color-bg-surface);
  }

  .ea-count {
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-regular, 400);
  }

  /* ── The looks ─────────────────────────────────────────────────────────── */
  .ea-looks {
    margin-block: var(--space-stack-lg);
  }

  .ea-looks__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: var(--space-stack-md) var(--space-inline-md);
    margin: var(--space-stack-md) 0 0;
    padding: 0;
    list-style: none;
  }

  .ea-look {
    display: grid;
    justify-items: center;
    gap: var(--space-stack-xs);
    padding: var(--space-inset-md) var(--space-inset-sm);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-surface);
    background: var(--color-bg-surface);
  }

  .ea-look__face {
    display: grid;
    place-items: center;
    padding-block-end: var(--space-stack-xs);
  }

  .ea-look__name {
    font-size: var(--font-size-body-xs, 0.75rem);
    color: var(--color-text-primary);
    white-space: nowrap;
  }
</style>

<style is:global>
  /* The triggers demo and the check are React islands: their own markup, outside this page's scope. */
  .ea-triggers {
    display: grid;
    justify-items: center;
    gap: var(--space-stack-lg);
  }

  .ea-triggers__group {
    display: grid;
    justify-items: center;
    gap: var(--space-stack-xs);
  }

  .ea-triggers__label {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-sm);
  }

  .ea-triggers__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-inline-sm);
  }

  .ea-triggers__button {
    padding: var(--space-inset-xs) var(--space-inset-md);
