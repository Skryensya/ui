    }
  : {
      description: "Reactive avatar with expressions. Its face is a tileset: one image of named tiles.",
      lede: "ExpressiveAvatar shows a visual identity that looks at you, blinks and talks. Its face is a <strong>tileset</strong>, one image divided into named tiles, and each expression is a set of tiles that gets swapped. You can use your own, create new expressions and trigger them whenever you want.",
      expressionsTitle: "Every expression",
      expressionsBody: "Nineteen states: nine gazes, a blink and a wink, and eight mouths (one per vowel, a closed one for m, b and p, a neutral one and the smile).",
      gazeLabel: "Gaze",
      eyesLabel: "Eyes",
      mouthLabel: "Mouth",
      tilesetTitle: "The tileset",
      tilesetBody: "This is the image the avatar uses, whole: an 8 by 8 grid of 25 pixel cells, one file. Each tile is a place in the grid, and the avatar shows one by moving the image behind a 25 by 25 window, so changing the eyes or the mouth loads nothing.",
