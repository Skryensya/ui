<script>
  const root = document.querySelector<HTMLElement>("[data-ea-check]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-ea-file]")!;
    const status = root.querySelector<HTMLElement>("[data-ea-status]")!;
    const missingList = root.querySelector<HTMLElement>("[data-ea-missing]")!;
    const preview = root.querySelector<HTMLElement>("[data-ea-preview]")!;
    const columns = Number(root.dataset.columns);
    const rows = Number(root.dataset.rows);
    const names: string[] = JSON.parse(root.dataset.names ?? "[]");
    const required: string[] = JSON.parse(root.dataset.required ?? "[]");
    const message = (key: string) => root.dataset[key] ?? "";
    const fill = (template: string, values: Record<string, string>) =>
      Object.entries(values).reduce((text, [name, value]) => text.replace(`{${name}}`, value), template);

    const load = (src: string) =>
      new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        image.onload = () => resolve(image);
        image.onerror = reject;
        image.src = src;
      });

    /* Which cells of an image have any ink: a cell is a square of `size` pixels, read through a canvas. */
    const inkedCells = (image: HTMLImageElement, size: number) => {
      const canvas = document.createElement("canvas");
      canvas.width = columns * size;
      canvas.height = rows * size;
      const context = canvas.getContext("2d", { willReadFrequently: true })!;
      context.drawImage(image, 0, 0, canvas.width, canvas.height);
      const inked = new Set<number>();
      for (let index = 0; index < columns * rows; index++) {
        const data = context.getImageData((index % columns) * size, Math.floor(index / columns) * size, size, size).data;
        for (let pixel = 3; pixel < data.length; pixel += 4) {
          if (data[pixel]! > 8) {
            inked.add(index);
            break;
          }
        }
      }
      return inked;
    };

    let objectUrl: string | null = null;
    let reference: Set<number> | null = null;

    input.addEventListener("change", async () => {
      const file = input.files?.[0];
      if (!file) return;
      missingList.replaceChildren();
      missingList.hidden = true;
      preview.hidden = true;

      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(file);
      const image = await load(objectUrl);

      /* The grid: `columns` by `rows` square cells. */
      const cell = image.naturalWidth / columns;
      if (!Number.isInteger(cell) || Math.abs(image.naturalHeight - rows * cell) > 1) {
        status.textContent = fill(message("msgShape"), {
          columns: String(columns),
          rows: String(rows),
          width: String(image.naturalWidth),
          height: String(image.naturalHeight),
        });
        return;
      }

      /* A needed cell with no ink is a missing tile, except the ones the bundled tileset leaves transparent
         on purpose: those are learned from the bundled image itself. */
      reference ??= inkedCells(await load(root.dataset.atlas!), 25);
      const mine = inkedCells(image, Math.min(Math.round(cell), 100));
      const empty = required.filter((name) => {
        const index = names.indexOf(name);
        return reference!.has(index) && !mine.has(index);
      });

      if (empty.length === 0) status.textContent = message("msgOk");
      else {
        status.textContent = fill(message("msgEmpty"), { count: String(empty.length) });
        for (const name of empty) {
          const item = document.createElement("li");
          const code = document.createElement("code");
          code.textContent = `${names.indexOf(name)} · ${name}`;
          item.append(code);
          missingList.append(item);
        }
        missingList.hidden = false;
      }

      /* The face, drawn with the image that was dropped: the same component, pointed at the file. */
      preview.querySelector<HTMLElement>(".sk-expressive-avatar")?.style.setProperty("--sk-expressive-avatar-atlas", `url("${objectUrl}")`);
      preview.hidden = false;
    });
  }
</script>

