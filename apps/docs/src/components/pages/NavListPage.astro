---
import "@skryensya/core/patterns/nav-list.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import { navListAnatomyTree, navListCollapsibleTree, navListHorizontalTree, navListProductTree } from "../../demos/nav-list";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const isEnglish = locale === "en";

const componentHref = isEnglish ? "/components" : "/components";
const tokenHref = isEnglish ? "/reference" : "/reference";
const startHref = isEnglish ? "/installation" : "/installation";

const styles = `@import "@skryensya/core/patterns/nav-list.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`navListPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Nav list"
  description={t("navListPage.description")}
  contractId="nav-list"
  testFiles={["packages/react/src/components/nav-list.test.tsx", "packages/vanilla/src/components/nav-list.test.ts"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("navListPage.lede")} />

    <UsagePreview
      tree={navListProductTree(t, { dashboard: "#", inbox: "#", customers: "#", segments: "#", automations: "#", settings: "#" })}
      optionName="orientation"
      title={t("navListPage.prop.orientation.title")}
      description={t("navListPage.prop.orientation.body")}
      explain={explain("orientation", ["vertical", "horizontal"])}
      stageMinBlockSize="16rem"
    />

    <h3>{t("navListPage.showcaseTitle")}</h3>
    <p set:html={t("navListPage.showcaseBody")} />
    <h3>{t("navListPage.productTitle")}</h3>
    <p set:html={t("navListPage.productBody")} />
    <ComponentPreview
      tree={navListProductTree(t, {
        dashboard: "/app/dashboard",
        inbox: "/app/inbox",
        customers: "/app/customers",
        segments: "/app/customers/segments",
        automations: "/app/automations",
        settings: "/app/settings",
      })}
      label={t("demo.navList.productLabel")}
      measure="18rem"
    />

    <h3>{t("navListPage.horizontalTitle")}</h3>
    <p set:html={t("navListPage.horizontalBody")} />
    <ComponentPreview
      tree={navListHorizontalTree(t, {
        overview: "/app",
        projects: "/app/projects",
        reports: "/app/reports",
        team: "/app/team",
      })}
      label={t("demo.navList.horizontalLabel")}
      measure="34rem"
      minHeight="9rem"
    />

    <h3>{t("navListPage.disclosureTitle")}</h3>
    <p set:html={t("navListPage.disclosureBody")} />
    <ComponentPreview
      tree={navListCollapsibleTree(t, {
        start: startHref,
        components: componentHref,
        tokens: tokenHref,
        profile: "/account/profile",
        billing: "/account/billing",
      })}
      label={t("demo.navList.collapsibleNavLabel")}
      measure="18rem"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("navListPage.contractBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("navListPage.anatomyBody")} />
    <ComponentPreview
      tree={navListAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("navListPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("navListPage.guidelinesLede")} />
    <ul>
      <li set:html={t("navListPage.guide.use1")} />
      <li set:html={t("navListPage.guide.avoid1")} />
      <li set:html={t("navListPage.guide.avoid2")} />
      <li set:html={t("navListPage.guide.avoid3")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <p set:html={t("navListPage.installIntro")} />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("navListPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
