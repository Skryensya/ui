---
import "@skryensya/core/patterns/nav-list.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  navListAnatomyTree,
  navListCollapsibleTree,
  navListDoDestinationsTree,
  navListDontActionsTree,
  navListDontLongNamesTree,
  navListDontTwoCurrentTree,
  navListDontVagueGroupsTree,
  navListDoOneCurrentTree,
  navListDoShortNamesTree,
  navListDoTopicGroupsTree,
  navListHorizontalTree,
  navListOrientationTree,
  navListProductTree,
} from "../../demos/nav-list";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
/* A column is a sidebar's width, not the stage's; a row sizes itself and the stage centres it. */
const orientationCardCss = `.sk-nav-list:not([data-orientation="horizontal"]) { inline-size: min(100%, 16rem); }`;
const isEnglish = locale === "en";

const componentHref = isEnglish ? "/components" : "/components";
const tokenHref = isEnglish ? "/reference" : "/reference";
const startHref = isEnglish ? "/installation" : "/installation";

const styles = `@import "@skryensya/core/patterns/nav-list.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`navListPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Nav list"
  description={t("navListPage.description")}
  contractId="nav-list"
  testFiles={["packages/react/src/components/nav-list.test.tsx", "packages/vanilla/src/components/nav-list.test.ts"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("navListPage.lede")} />

    <UsagePreview
      tree={navListOrientationTree(t, { dashboard: "#", inbox: "#", customers: "#", automations: "#", settings: "#" })}
      optionName="orientation"
      title={t("navListPage.prop.orientation.title")}
      description={t("navListPage.prop.orientation.body")}
      explain={explain("orientation", ["vertical", "horizontal"])}
      css={orientationCardCss}
      stageMinBlockSize="14rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <h3>{t("navListPage.productTitle")}</h3>
    <p set:html={t("navListPage.productBody")} />
    <UsagePreview
      tree={navListProductTree(t, {
        dashboard: "/app/dashboard",
        inbox: "/app/inbox",
        customers: "/app/customers",
        segments: "/app/customers/segments",
        automations: "/app/automations",
        settings: "/app/settings",
      })}
      label={t("demo.navList.productLabel")}
      measure="18rem"
    />

    <h3>{t("navListPage.horizontalTitle")}</h3>
    <p set:html={t("navListPage.horizontalBody")} />
    <UsagePreview
      tree={navListHorizontalTree(t, {
        overview: "/app",
        projects: "/app/projects",
        reports: "/app/reports",
        team: "/app/team",
      })}
      label={t("demo.navList.horizontalLabel")}
      measure="34rem"
      stageMinBlockSize="9rem"
    />

    <h3>{t("navListPage.disclosureTitle")}</h3>
    <p set:html={t("navListPage.disclosureBody")} />
    <UsagePreview
      tree={navListCollapsibleTree(t, {
        start: startHref,
        components: componentHref,
        tokens: tokenHref,
        profile: "/account/profile",
        billing: "/account/billing",
      })}
      label={t("demo.navList.collapsibleNavLabel")}
      measure="18rem"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "navListPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("navListPage.anatomyBody")} />
    <UsagePreview
      tree={navListAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("navListPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("navListPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "navListPage.when")} avoid={tList(t, "navListPage.whenNot")} />
    <DoDont
      title={t("navListPage.dd.names.title")}
      do={{ tree: navListDoShortNamesTree(t), caption: t("navListPage.dd.names.do") }}
      dont={{ tree: navListDontLongNamesTree(t), caption: t("navListPage.dd.names.dont") }}
    />
    <DoDont
      title={t("navListPage.dd.groups.title")}
      do={{ tree: navListDoTopicGroupsTree(t), caption: t("navListPage.dd.groups.do") }}
      dont={{ tree: navListDontVagueGroupsTree(t), caption: t("navListPage.dd.groups.dont") }}
    />
    <DoDont
      title={t("navListPage.dd.current.title")}
      do={{ tree: navListDoOneCurrentTree(t), caption: t("navListPage.dd.current.do") }}
      dont={{ tree: navListDontTwoCurrentTree(t), caption: t("navListPage.dd.current.dont") }}
    />
    <DoDont
      title={t("navListPage.dd.destinations.title")}
      do={{ tree: navListDoDestinationsTree(t), caption: t("navListPage.dd.destinations.do") }}
      dont={{ tree: navListDontActionsTree(t), caption: t("navListPage.dd.destinations.dont") }}
    />
    <ContentRules items={tList(t, "navListPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <p set:html={t("navListPage.installIntro")} />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("navListPage.a11yIntro")} does={tList(t, "navListPage.a11yDoes")} yours={tList(t, "navListPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
