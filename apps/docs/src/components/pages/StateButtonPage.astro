---
import "@skryensya/core/components/state-button.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  stateButtonAnatomyTree,
  stateButtonBasicTree,
  stateButtonCopyTree,
  stateButtonDemoScript,
  stateButtonThemeToggleTree,
} from "../../demos/state-button";
import { getLocale, tList, useTranslations } from "../../i18n";
import { annotationDemoCss } from "../../demos/annotation";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/state-button.css";`;
import { stateButtonDoTree, stateButtonDontTree, stateButtonSwitchDoTree, stateButtonSwitchDontTree } from "../../demos/dodont-pairs";
---

<ComponentPageShell
  title="StateButton"
  description={t("stateButtonPage.description")}
  contractId="state-button"
  appearanceTargetSelector=".sk-icon-toggle"
  testFiles={["packages/react/src/components/state-button.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("stateButtonPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={stateButtonBasicTree(t)} script={stateButtonDemoScript} title={t("stateButtonPage.viewTitle")} description={t("stateButtonPage.viewBody")} />
    <UsagePreview tree={stateButtonThemeToggleTree(t)} script={stateButtonDemoScript} title={t("stateButtonPage.themeTitle")} description={t("stateButtonPage.themeBody")} />
    <UsagePreview tree={stateButtonCopyTree(t)} script={stateButtonDemoScript} title={t("stateButtonPage.copyTitle")} description={t("stateButtonPage.copyBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "stateButtonPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("stateButtonPage.anatomyDiagramBody")} />
    <UsagePreview
      tree={stateButtonAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("stateButtonPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("stateButtonPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "stateButtonPage.when")} avoid={tList(t, "stateButtonPage.whenNot")} />
    <DoDont
      title={t("stateButtonPage.dd.icons.title")}
      do={{ tree: stateButtonDoTree(t), caption: t("stateButtonPage.dd.icons.do") }}
      dont={{ tree: stateButtonDontTree(t), caption: t("stateButtonPage.dd.icons.dont") }}
    />
    <DoDont
      title={t("stateButtonPage.dd.switch.title")}
      do={{ tree: stateButtonSwitchDoTree(t), caption: t("stateButtonPage.dd.switch.do") }}
      dont={{ tree: stateButtonSwitchDontTree(t), caption: t("stateButtonPage.dd.switch.dont") }}
    />
    <ContentRules items={tList(t, "stateButtonPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("stateButtonPage.a11yIntro")}
      does={tList(t, "stateButtonPage.a11yDoes")}
      yours={tList(t, "stateButtonPage.a11yYours")}
      keys={[{ keys: ["Enter", t("component.key.space")], action: t("stateButtonPage.key.run") }]}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>
