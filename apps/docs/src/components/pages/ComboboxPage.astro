---
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  comboboxAnatomyCss,
  comboboxAnatomyHtml,
  comboboxDontFewTree,
  comboboxSingleTree,
  comboboxTree,
} from "../../demos/combobox";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/combobox.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/patterns/scrollbar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import { variantsTree } from "../../demos/variants";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/form-field.css";
@import "@skryensya/core/components/combobox.css";
/* The list scrolls: the rail is painted by the pattern, marked with sk-scrollbar. */
@import "@skryensya/core/patterns/scrollbar.css";`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
---

<ComponentPageShell
  title="Combobox"
  description={t("combobox.description")}
  badge={t("combobox.betaBadge")}
  contractId="combobox"
  appearanceTargetSelector=".sk-combobox"
  styleGroups={[
    { file: "components/combobox.css", probe: "sk-combobox", title: "Combobox" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
    { file: "components/button.css", probe: "sk-button", title: "Heredados de Button" },
  ]}
  testFiles={["packages/react/src/components/combobox.test.tsx", "packages/vanilla/src/components/combobox.test.ts"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("combobox.lede")} />

    <h3>{t("combobox.showcaseTitle")}</h3>
    <p set:html={t("combobox.showcaseBody")} />
    <ComponentPreview tree={comboboxTree(t, locale)} js={js} label="Combobox" viewport="menu" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("combobox.contractBody1")} />
    <p set:html={t("combobox.contractBody2")} />

    <UsagePreview
      tree={variantsTree(comboboxSingleTree(t, locale), [{ label: t("component.state.default"), options: {} }, { label: t("component.state.disabled"), options: { disabled: true } }, { label: t("component.state.invalid"), options: { invalid: true } }])}
      title={t("component.statesTitle")}
      description={t("component.statesBody")}
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("combobox.anatomyBody")} />
    <ComponentPreview
      html={comboboxAnatomyHtml(t)}
      css={comboboxAnatomyCss}
      label={t("combobox.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("combobox.guidelinesLede")} />
    <DoDont
      title={t("combobox.dd.many.title")}
      do={{ tree: comboboxSingleTree(t, locale), caption: t("combobox.dd.many.do") }}
      dont={{ tree: comboboxDontFewTree(t), caption: t("combobox.dd.many.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("combobox.a11yBody1")} />
    <p set:html={t("combobox.a11yBody2")} />
  </Fragment>
</ComponentPageShell>
