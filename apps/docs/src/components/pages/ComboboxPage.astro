---
/* Appearances: the preview menu switches between them, so each one's sheet loads with the page (each base, then its appearances). */
import "@skryensya/core/components/combobox.css";
import "@skryensya/core/components/combobox.brutalist.css";
import "@skryensya/core/components/combobox.frosted.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  comboboxDoFewTree,
  comboboxDontFewHtml,
  comboboxMultipleTree,
  comboboxSingleTree,
} from "../../demos/combobox";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/combobox.css";
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/radio-group.css";
import "@skryensya/core/patterns/scrollbar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import { withOptionAt } from "../react-demos/usage-tree-path";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const storybookTitle = "Components/Combobox";
import { dd2 } from "../../demos/dodont-labels";
---

<ComponentPageShell
  hookPlayground={{ tree: comboboxSingleTree(t, locale) }}
  title="Combobox"
  description={t("combobox.description")}
  contractId="combobox"
  extraSheets={["@skryensya/core/patterns/anchored.css", "@skryensya/core/components/button.css", "@skryensya/core/components/form-field.css", "@skryensya/core/components/tag.css", "@skryensya/core/patterns/scrollbar.css"]}
  appearanceTargetSelector=".sk-combobox"
  styleGroups={[
    { file: "components/combobox.css", probe: "sk-combobox", title: "Combobox" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
    { file: "components/button.css", probe: "sk-button", title: "Heredados de Button" },
    { file: "components/tag.css", probe: "sk-tag", title: "Heredados de Tag" },
  ]}
  testFiles={["packages/react/src/components/combobox.test.tsx", "packages/vanilla/src/components/combobox.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("combobox.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={comboboxSingleTree(t, locale)} title={t("combobox.singleTitle")} description={t("combobox.singleBody")} stageMinBlockSize="22rem" storybookTitle={storybookTitle} storybookStory="Single" />
    <UsagePreview tree={comboboxMultipleTree(t, locale)} title={t("combobox.multipleTitle")} description={t("combobox.multipleBody")} stageMinBlockSize="22rem" storybookTitle={storybookTitle} storybookStory="Multiple" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "combobox.contract").map((item) => <li set:html={item} />)}
    </ul>

    <UsagePreview
      variants={[
        { value: "default", label: t("component.state.default"), tree: comboboxSingleTree(t, locale) },
        { value: "disabled", label: t("component.state.disabled"), tree: withOptionAt(comboboxSingleTree(t, locale), [], "disabled", true) },
        { value: "invalid", label: t("component.state.invalid"), tree: withOptionAt(comboboxSingleTree(t, locale), [], "invalid", true) },
      ]}
      variantsLabel={t("component.statesTitle")}
      stageMinBlockSize="12rem"
      title={t("component.statesTitle")}
      description={t("component.statesBody")}
      storybookTitle="Components/Combobox"
      storybookStory="Single"
    />

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("combobox.guidelinesLede")} />
    <WhenToUse use={tList(t, "combobox.when")} avoid={tList(t, "combobox.whenNot")} />
    <DoDont
      title={t("combobox.dd.many.title")}
      do={{ tree: comboboxDoFewTree(t), caption: t("combobox.dd.many.do") }}
      dont={{ html: comboboxDontFewHtml(t), caption: t("combobox.dd.many.dont") }}
    />
    <DoDont
      title={t("dd2.combobox.title")}
      do={{ tree: dd2.combobox.do(t), caption: t("dd2.combobox.do") }}
      dont={{ tree: dd2.combobox.dont(t), caption: t("dd2.combobox.dont") }}
    />
    <ContentRules items={tList(t, "combobox.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("combobox.a11yIntro")}
      does={tList(t, "combobox.a11yDoes")}
      yours={tList(t, "combobox.a11yYours")}
      keys={[
        { keys: ["↓", "↑"], action: t("combobox.a11yKeyArrows") },
        { keys: ["Enter"], action: t("combobox.a11yKeyEnter") },
        { keys: ["Esc"], action: t("combobox.a11yKeyEsc") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
