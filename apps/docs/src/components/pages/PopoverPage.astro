---
import "@skryensya/core/components/popover.css";
import "@skryensya/core/patterns/box.css";
/* Structure diagram: the Annotated specimen is drawn by Annotation's own sheet. */
import "@skryensya/core/components/annotation.css";
/* The bare specimen's filler is an authored Checkbox rather than one mounted from a tree, so its
   sheet has to come from here. */
import "@skryensya/core/components/checkbox.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  popoverCardCase,
  popoverDoInteractiveTree,
  popoverDoActionTree,
  popoverDoNameTree,
  popoverDoShortTree,
  popoverDontDecisionTree,
  popoverDontNameTree,
  popoverDontLabelTree,
  popoverDontLongTree,
  popoverGuideCss,
  popoverAnatomyCss,
  popoverAnatomyTree,
  popoverTree,
  popoverStructuredTree,
  popupTree,
  popupAnatomyTree,
  popupAnatomyCss,
} from "../../demos/popover";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

/* What each value of a property is for, read from this page's messages. Same model Badge and Menu use. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`popoverPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
const prop = (option: string) => ({
  title: t(`popoverPage.prop.${option}.title` as Parameters<typeof t>[0]),
  description: t(`popoverPage.prop.${option}.body` as Parameters<typeof t>[0]),
});

const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/popover.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);`;
---

<ComponentPageShell
  title="Popover"
  description={t("popoverPage.description")}
  contractId="popover"
  appearanceTargetSelector=".sk-popover"
  styleGroups={[
    { file: "components/popover.css", probe: "sk-popover", title: "Popover" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
  ]}
  testFiles={["packages/react/src/components/popover.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("popoverPage.lede")} />

    {/* One card per option with a closed set of values. The panel opens over the card, so each stage is
        reserved tall enough, and wide enough for a side placement, not to move when it opens. */}
    <UsagePreview tree={popoverCardCase(t, "placement")} optionName="placement" {...prop("placement")} explain={explain("placement", ["block-start", "block-end", "inline-start", "inline-end"])} labels={{ "block-start": "Arriba", "block-end": "Abajo", "inline-start": "Inicio", "inline-end": "Final" }} stageMinBlockSize="24rem" />
    <UsagePreview tree={popoverCardCase(t, "arrow")} optionName="arrow" {...prop("arrow")} explain={explain("arrow", ["false", "true"])} labels={{ false: t("popoverPage.prop.arrow.off"), true: t("popoverPage.prop.arrow.on") }} stageMinBlockSize="24rem" />
    <UsagePreview tree={popoverCardCase(t, "triggerVariant")} optionName="triggerVariant" {...prop("triggerVariant")} explain={explain("triggerVariant", ["solid", "soft", "ghost"])} stageMinBlockSize="24rem" />
    <UsagePreview tree={popoverCardCase(t, "triggerTone")} optionName="triggerTone" {...prop("triggerTone")} explain={explain("triggerTone", ["neutral", "accent", "danger"])} stageMinBlockSize="24rem" />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={popoverTree(t)} title={t("popoverPage.simpleTitle")} description={t("popoverPage.simpleBody")} viewport="overlay" />

    <UsagePreview tree={popoverStructuredTree(t)} title={t("popoverPage.structuredTitle")} description={t("popoverPage.structuredBody")} viewport="overlay" />

    {/*
      * POPUP IS THIS FAMILY'S BARE SIGNATURE, not a component of its own, and this section is where
      * that stopped being two pages. `/components/popup` documented `Popover.bare` under a second
      * name: same contract, same stylesheet, same anchoring pattern, one signature down. The two
      * pages made a reader pick between them before knowing they were the same thing, and the
      * catalogue counted one family twice. The route is a 301 onto this heading now.
      *
      * The id is `popup` in both locales, deliberately: the word does not translate, and the two
      * redirects (`pages/components/popup.astro` and `pages/es/componentes/popup.astro`) both
      * point at it. A per-locale id would need a per-locale fragment in each of them.
      */}
    <h3 id="popup">{t("popoverPage.popupTitle")}</h3>
    <p set:html={t("popoverPage.popupBody")} />
    <UsagePreview tree={popupTree(t)} label="Popup" viewport="menu" />

    <p set:html={t("popoverPage.popupAnatomyBody")} />
    <UsagePreview
      tree={popupAnatomyTree(t)}
      css={popupAnatomyCss}
      label={t("popoverPage.popupAnatomyPreviewLabel")}
      bare
    />
    <p set:html={t("popoverPage.popupContractBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "popoverPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("popoverPage.anatomyBody")} />
    <UsagePreview
      tree={popoverAnatomyTree(t)}
      css={popoverAnatomyCss}
      label={t("popoverPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("popoverPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "popoverPage.when")} avoid={tList(t, "popoverPage.whenNot")} />
    <DoDont
      canvas
      compact
      title={t("popoverPage.dd.interactive.title")}
      do={{ tree: popoverDoInteractiveTree(t), caption: t("popoverPage.dd.interactive.do") }}
      dont={{ tree: popoverDontLabelTree(t), caption: t("popoverPage.dd.interactive.dont") }}
    />
    <DoDont
      canvas
      compact
      title={t("popoverPage.dd.short.title")}
      do={{ tree: popoverDoShortTree(t), caption: t("popoverPage.dd.short.do") }}
      dont={{ tree: popoverDontLongTree(t), caption: t("popoverPage.dd.short.dont") }}
    />
    <DoDont
      canvas
      compact
      title={t("popoverPage.dd.name.title")}
      do={{ tree: popoverDoNameTree(t), caption: t("popoverPage.dd.name.do") }}
      dont={{ tree: popoverDontNameTree(t), caption: t("popoverPage.dd.name.dont") }}
    />
    <DoDont
      canvas
      compact
      title={t("popoverPage.dd.decision.title")}
      do={{ tree: popoverDoActionTree(t), caption: t("popoverPage.dd.decision.do") }}
      dont={{ tree: popoverDontDecisionTree(t), caption: t("popoverPage.dd.decision.dont") }}
    />
    <ContentRules items={tList(t, "popoverPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("popoverPage.a11yIntro")}
      does={tList(t, "popoverPage.a11yDoes")}
      yours={tList(t, "popoverPage.a11yYours")}
      keys={[
        { keys: ["Enter", t("component.key.space")], action: t("popoverPage.key.open") },
        { keys: ["Tab", "Shift+Tab"], action: t("popoverPage.key.tab") },
        { keys: ["Esc"], action: t("popoverPage.key.escape") },
      ]}
    />
  </Fragment>
</ComponentPageShell>

<style is:global set:html={popoverGuideCss}></style>
