---
import "@skryensya/core/components/popover.css";
import "@skryensya/core/patterns/box.css";
/* Structure diagram: the Annotated specimen is drawn by Annotation's own sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { popoverAnatomyCss, popoverAnatomyHtml, popoverTree, popoverStructuredTree, popoverPlacementTree } from "../../demos/popover";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/popover.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);`;
---

<ComponentPageShell
  title="Popover"
  description={t("popoverPage.description")}
  contractId="popover"
  styleGroups={[
    { file: "components/popover.css", probe: "sk-popover", title: "Popover" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
  ]}
  testFiles={["packages/react/src/components/popover.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("popoverPage.description")} />

    <p set:html={t("popoverPage.anatomyBody")} />
    <ComponentPreview
      html={popoverAnatomyHtml(t)}
      css={popoverAnatomyCss}
      label={t("popoverPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={popoverTree(t)} js={js} label="Popover" viewport="overlay" />

    <h3>{t("popoverPage.structuredTitle")}</h3>
    <p set:html={t("popoverPage.structuredBody")} />
    <ComponentPreview tree={popoverStructuredTree(t)} js={js} label={t("popoverPage.structuredLabel")} viewport="overlay" />

    <h3>{t("popoverPage.placementTitle")}</h3>
    <p set:html={t("popoverPage.placementBody")} />
    <ComponentPreview tree={popoverPlacementTree(t)} js={js} label={t("popoverPage.placementLabel")} viewport="overlay" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("popoverPage.contractBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("popoverPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
