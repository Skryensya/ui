---
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import { footerColumnsTree, footerCreditTree } from "../../demos/layout";
import { getLocale, useTranslations } from "../../i18n";
import { footerAnatomyTree, layoutAnatomyFillCss } from "../../demos/layout-anatomy";
import "@skryensya/core/components/annotation.css";
/* The sheet itself, not only its source: the Style hooks table resolves each hook against a real
   element, and a page that never loads `patterns/footer.css` shows every value blank. */
import "@skryensya/core/patterns/footer.css";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const docsHref = locale === "en" ? "/en" : "/";

const footerSiteTree = footerColumnsTree(t, docsHref);
const footerOneLineTree = footerCreditTree(t);

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`footer.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Footer"
  description={t("footer.description")}
  badge={t("footer.betaBadge")}
  contractId="footer"
  appearanceTargetSelector=".sk-footer"
  styleGroups={[{ file: "patterns/footer.css", probe: "sk-footer" }]}
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        {
          name: "renders Footer as a contentinfo landmark with its documented defaults",
          description: t("footer.test1"),
        },
        {
          name: "lets Footer opt out of the divider, change padding/surface, and drop the landmark via `as`",
          description: t("footer.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("footer.lede")} />

    <UsagePreview
      tree={footerSiteTree}
      optionName="surface"
      title={t("footer.prop.surface.title")}
      description={t("footer.prop.surface.body")}
      explain={explain("surface", ["none", "sunken", "surface", "raised"])}
      stageMinBlockSize="14rem"
    />

    <UsagePreview
      tree={footerSiteTree}
      optionName="appearance"
      title={t("footer.prop.appearance.title")}
      description={t("footer.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist", "frosted"])}
      stageMinBlockSize="14rem"
    />

    <h3>{t("footer.showcaseTitle")}</h3>
    <p set:html={t("footer.showcaseBody")} />

    <h3>{t("footer.htmlTitle")}</h3>

    <h4>{t("footer.patternSiteTitle")}</h4>
    <p>{t("footer.patternSiteDescription")}</p>
    <UsagePreview tree={footerSiteTree} />

    <h4>{t("footer.patternCreditTitle")}</h4>
    <p>{t("footer.patternCreditDescription")}</p>
    <UsagePreview tree={footerOneLineTree} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("footer.contractItem1")} />
      <li set:html={t("footer.contractItem2")} />
      <li set:html={t("footer.contractItem3")} />
      <li set:html={t("footer.contractItem4")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("footer.anatomyBody")} />
    <ComponentPreview
      tree={footerAnatomyTree(t)}
      css={layoutAnatomyFillCss}
      label={t("footer.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("footer.guidelinesLede")} />
    <h3>{t("footer.whenTitle")}</h3>
    <p set:html={t("footer.whenBody1")} />
    <p set:html={t("footer.whenBody2")} />
    <p set:html={t("footer.whenBody3")} />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("footer.a11yP1")} />
    <p set:html={t("footer.a11yP2")} />
    <p set:html={t("footer.a11yP3")} />
  </Fragment>
</ComponentPageShell>
