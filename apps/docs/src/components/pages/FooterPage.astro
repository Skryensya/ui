---
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  footerColumnsTree,
  footerCreditTree,
  footerCrowdedDontTree,
  footerLeanDoTree,
  footerSurfaceDoTree,
  footerSurfaceDontTree,
} from "../../demos/layout";
import { getLocale, tList, useTranslations } from "../../i18n";
import { footerAnatomyTree, layoutAnatomyFillCss } from "../../demos/layout-anatomy";
import "@skryensya/core/components/annotation.css";
/* The sheet itself, not only its source: the Style hooks table resolves each hook against a real
   element, and a page that never loads `patterns/footer.css` shows every value blank. */
import "@skryensya/core/patterns/footer.css";
/* The Do/Don't specimens include a last content block before the footer, drawn as a Box. */
import "@skryensya/core/patterns/box.css";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const docsHref = locale === "en" ? "/en" : "/";

const footerSiteTree = footerColumnsTree(t, docsHref);
const footerOneLineTree = footerCreditTree(t);

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`footer.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Footer"
  description={t("footer.description")}
  contractId="footer"
  appearanceTargetSelector=".sk-footer"
  styleGroups={[{ file: "patterns/footer.css", probe: "sk-footer" }]}
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        {
          name: "renders Footer as a contentinfo landmark with its documented defaults",
          description: t("footer.test1"),
        },
        {
          name: "lets Footer opt out of the divider, change padding/surface, and drop the landmark via `as`",
          description: t("footer.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("footer.lede")} />

    <UsagePreview
      tree={footerSiteTree}
      optionName="surface"
      title={t("footer.prop.surface.title")}
      description={t("footer.prop.surface.body")}
      explain={explain("surface", ["none", "sunken", "surface", "raised"])}
      stageMinBlockSize="14rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={footerSiteTree} title={t("footer.patternSiteTitle")} description={t("footer.patternSiteDescription")} />
    <UsagePreview tree={footerOneLineTree} title={t("footer.patternCreditTitle")} description={t("footer.patternCreditDescription")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "footer.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("footer.anatomyBody")} />
    <UsagePreview tree={footerAnatomyTree(t)} css={layoutAnatomyFillCss} label={t("footer.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("footer.guidelinesLede")} />
    <WhenToUse use={tList(t, "footer.when")} avoid={tList(t, "footer.whenNot")} />
    <DoDont
      canvas
      title={t("footer.dd.surface.title")}
      do={{ tree: footerSurfaceDoTree(t), caption: t("footer.dd.surface.do") }}
      dont={{ tree: footerSurfaceDontTree(t), caption: t("footer.dd.surface.dont") }}
    />
    <DoDont
      canvas
      title={t("footer.dd.scope.title")}
      do={{ tree: footerLeanDoTree(t, docsHref), caption: t("footer.dd.scope.do") }}
      dont={{ tree: footerCrowdedDontTree(t, docsHref), caption: t("footer.dd.scope.dont") }}
    />
    <ContentRules items={tList(t, "footer.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("footer.a11yIntro")} does={tList(t, "footer.a11yDoes")} yours={tList(t, "footer.a11yYours")} />
  </Fragment>
</ComponentPageShell>
