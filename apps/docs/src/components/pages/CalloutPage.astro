---
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet the
   same way Accordion's, Button's and Breadcrumb's do. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  calloutAnatomyTree,
  calloutInfoTree,
  calloutNeutralTree,
  calloutSuccessTree,
  calloutWarningTree,
} from "../../demos/callout";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`callout.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Callout"
  description={t("callout.description")}
  badge={t("callout.betaBadge")}
  contractId="callout"
  appearanceTargetSelector=".sk-callout"
  testFiles={["packages/react/src/components/callout.test.tsx"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("callout.lede1")} />

    <UsagePreview
      tree={calloutNeutralTree(t)}
      optionName="tone"
      title={t("callout.prop.tone.title")}
      description={t("callout.prop.tone.body")}
      explain={explain("tone", ["neutral", "info", "success", "warning", "danger"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("callout.showcaseTitle")}</h3>
    <p set:html={t("callout.showcaseBody")} />
    <UsagePreview tree={calloutNeutralTree(t)} title={t("callout.neutralTitle")} description={t("callout.neutralBody")} />
    <UsagePreview tree={calloutInfoTree(t)} title={t("callout.infoTitle")} description={t("callout.infoBody")} />
    <UsagePreview tree={calloutWarningTree(t)} title={t("callout.warningTitle")} description={t("callout.warningBody")} />
    <UsagePreview tree={calloutSuccessTree(t)} title={t("callout.successTitle")} description={t("callout.successBody")} />

    <h3>{t("callout.anatomyTitle")}</h3>
    <ul>
      <li set:html={t("callout.anatomyItem1")} />
      <li set:html={t("callout.anatomyItem2")} />
      <li set:html={t("callout.anatomyItem3")} />
      <li set:html={t("callout.anatomyItem4")} />
    </ul>

    <p set:html={t("callout.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("callout.anatomyBody")} />
    <ComponentPreview
      tree={calloutAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("callout.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("callout.guidelinesLede")} />
    <DoDont
      title={t("callout.dd.persistence.title")}
      do={{ tree: calloutInfoTree(t), caption: t("callout.dd.persistence.do") }}
      dont={{ tree: calloutSuccessTree(t), caption: t("callout.dd.persistence.dont") }}
    />
    <DoDont
      title={t("callout.dd.recovery.title")}
      do={{ tree: calloutWarningTree(t), caption: t("callout.dd.recovery.do") }}
      dont={{ tree: calloutNeutralTree(t), caption: t("callout.dd.recovery.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
