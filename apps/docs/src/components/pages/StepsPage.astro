---
import "@skryensya/core/components/steps.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { stepsAnatomyTree, stepsTree, stepsVerticalTree } from "../../demos/steps";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="Steps"
  description={t("stepsPage.description")}
  contractId="steps"
  styleGroups={[{ file: "components/steps.css", probe: "sk-steps" }]}
  tests={[
    {
      file: "packages/react/src/components/steps.test.tsx",
      tests: [
        { name: "derives complete / current / upcoming from the current index", description: t("stepsPage.test1") },
        { name: "lets a step override its status explicitly", description: t("stepsPage.test2") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("stepsPage.lede")} />

    <p set:html={t("stepsPage.anatomyBody")} />
    <ComponentPreview
      tree={stepsAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("stepsPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={stepsTree(t)} label="Steps" />
    <p set:html={t("stepsPage.body")} />

    <h3>{t("stepsPage.mobileTitle")}</h3>
    <p set:html={t("stepsPage.mobileBody")} />

    <h3>{t("stepsPage.verticalTitle")}</h3>
    <p set:html={t("stepsPage.verticalBody")} />
    <ComponentPreview tree={stepsVerticalTree(t)} label={t("stepsPage.verticalLabel")} />

    <p set:html={t("component.reactNote")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
