---
import "@skryensya/core/components/steps.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  stepsAnatomyTree,
  stepsDontColorTree,
  stepsDontManyTree,
  stepsTree,
  stepsVerticalTree,
} from "../../demos/steps";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`stepsPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Steps"
  description={t("stepsPage.description")}
  contractId="steps"
  testFiles={["packages/react/src/components/steps.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("stepsPage.lede")} />

    <UsagePreview
      tree={stepsTree(t)}
      optionName="orientation"
      title={t("stepsPage.prop.orientation.title")}
      description={t("stepsPage.prop.orientation.body")}
      explain={explain("orientation", ["horizontal", "vertical"])}
      stageMinBlockSize="20rem"
    />

    <UsagePreview
      tree={stepsTree(t)}
      optionName="appearance"
      title={t("stepsPage.prop.appearance.title")}
      description={t("stepsPage.prop.appearance.body")}
      explain={explain("appearance", ["markers", "segments"])}
      stageMinBlockSize="10rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={stepsTree(t)} title={t("stepsPage.checkoutTitle")} description={t("stepsPage.checkoutBody")} />
    <UsagePreview tree={stepsVerticalTree(t)} title={t("stepsPage.verticalTitle")} description={t("stepsPage.verticalBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "stepsPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("stepsPage.anatomyBody")} />
    <UsagePreview tree={stepsAnatomyTree(t)} css={annotationDemoCss} label={t("stepsPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("stepsPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "stepsPage.when")} avoid={tList(t, "stepsPage.whenNot")} />
    <DoDont
      canvas
      title={t("stepsPage.dd.few.title")}
      do={{ tree: stepsTree(t), caption: t("stepsPage.dd.few.do") }}
      dont={{ tree: stepsDontManyTree(t), caption: t("stepsPage.dd.few.dont") }}
    />
    <DoDont
      canvas
      title={t("stepsPage.dd.cue.title")}
      do={{ tree: stepsTree(t), caption: t("stepsPage.dd.cue.do") }}
      dont={{ tree: stepsDontColorTree(t), caption: t("stepsPage.dd.cue.dont") }}
    />
    <ContentRules items={tList(t, "stepsPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes intro={t("stepsPage.a11yIntro")} does={tList(t, "stepsPage.a11yDoes")} yours={tList(t, "stepsPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
