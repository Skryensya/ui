---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import { annotationDemoCss } from "../../demos/annotation";
import {
  listboxAnatomyTree,
  listboxDontActionsTree,
  listboxHorizontalTree,
  listboxMultipleTree,
  listboxPlainTree,
  listboxSingleTree,
} from "../../demos/listbox";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/listbox.css";
/* The anatomy diagram is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));

const react = `import { Listbox } from "@skryensya/react/listbox";
import "@skryensya/core/components/listbox.css";

<Listbox
  label="Labels"
  selectionMode="multiple"
  items={labels}
  onValueChange={({ value }) => setFilters(value)}
/>`;

const vanilla = `document.addEventListener("sk:listboxvaluechange", (event) => {
  setFilters(event.detail.value);
});`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`listbox.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Listbox"
  description={t("listbox.description")}
  badge={t("listbox.betaBadge")}
  contractId="listbox"
  styleGroups={[{ file: "components/listbox.css", probe: "sk-listbox" }]}
  testFiles={[
    "packages/vanilla/src/components/listbox.svelte.test.ts",
    "packages/react/src/components/listbox.test.tsx",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("listbox.lede")} />

    <UsagePreview
      tree={listboxPlainTree(t)}
      optionName="selectionMode"
      title={t("listbox.prop.selectionMode.title")}
      description={t("listbox.prop.selectionMode.body")}
      explain={explain("selectionMode", ["single", "multiple", "extended"])}
      stageMinBlockSize="12rem"
    />

    <UsagePreview
      tree={listboxPlainTree(t)}
      optionName="orientation"
      title={t("listbox.prop.orientation.title")}
      description={t("listbox.prop.orientation.body")}
      explain={explain("orientation", ["vertical", "horizontal"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("listbox.showcaseTitle")}</h3>
    <p set:html={t("listbox.showcaseBody")} />

    <h3>{t("listbox.singleTitle")}</h3>
    <p set:html={t("listbox.singleBody")} />
    <UsagePreview tree={listboxSingleTree(t)} />

    <h3>{t("listbox.multipleTitle")}</h3>
    <p set:html={t("listbox.multipleBody")} />
    <UsagePreview tree={listboxMultipleTree(t)} />

    <h3>{t("listbox.horizontalTitle")}</h3>
    <p set:html={t("listbox.horizontalBody")} />
    <UsagePreview tree={listboxHorizontalTree(t)} />

    <h3>{t("listbox.keyboardTitle")}</h3>
    <ul>
      <li set:html={t("listbox.keyboardItem1")} />
      <li set:html={t("listbox.keyboardItem2")} />
      <li set:html={t("listbox.keyboardItem3")} />
    </ul>

    <h3>{t("listbox.eventsTitle")}</h3>
    <p set:html={t("listbox.eventsBody")} />
    <CodeBlock code={react} label="React" lang="tsx" />
    <CodeBlock code={vanilla} label="JavaScript" lang="ts" />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("listbox.anatomyBody")} />
    <ComponentPreview
      tree={listboxAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("listbox.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("listbox.guidelinesLede")} />
    <h3>{t("listbox.whenTitle")}</h3>
    <ul>
      <li set:html={t("listbox.whenItem1")} />
      <li set:html={t("listbox.whenItem2")} />
      <li set:html={t("listbox.whenItem3")} />
    </ul>
    <DoDont
      title={t("listbox.dd.actions.title")}
      do={{ tree: listboxPlainTree(t), caption: t("listbox.dd.actions.do") }}
      dont={{ tree: listboxDontActionsTree(t), caption: t("listbox.dd.actions.dont") }}
    />
  </Fragment>
</ComponentPageShell>
