---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { annotationDemoCss } from "../../demos/annotation";
import {
  listboxAnatomyTree,
  listboxDoDisabledTree,
  listboxDoHorizontalShortTree,
  listboxDoMultipleFiltersTree,
  listboxDoNaturalOrderTree,
  listboxDontActionsTree,
  listboxDontAlphabeticalDaysTree,
  listboxDontHorizontalLongTree,
  listboxDontMissingTree,
  listboxDontSingleFiltersTree,
  listboxHorizontalTree,
  listboxMultipleTree,
  listboxPlainTree,
  listboxSingleTree,
} from "../../demos/listbox";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/listbox.css";
/* The anatomy diagram is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));

const react = `import { Listbox } from "@skryensya/react/listbox";
import "@skryensya/core/components/listbox.css";

<Listbox
  label="Labels"
  selectionMode="multiple"
  items={labels}
  onValueChange={({ value }) => setFilters(value)}
/>`;

const vanilla = `document.addEventListener("sk:listboxvaluechange", (event) => {
  setFilters(event.detail.value);
});`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`listbox.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Listbox"
  description={t("listbox.description")}
  contractId="listbox"
  styleGroups={[{ file: "components/listbox.css", probe: "sk-listbox" }]}
  testFiles={[
    "packages/vanilla/src/components/listbox.svelte.test.ts",
    "packages/react/src/components/listbox.test.tsx",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("listbox.lede")} />

    <UsagePreview
      tree={listboxPlainTree(t)}
      optionName="selectionMode"
      title={t("listbox.prop.selectionMode.title")}
      description={t("listbox.prop.selectionMode.body")}
      explain={explain("selectionMode", ["single", "multiple", "extended"])}
      stageMinBlockSize="12rem"
    />

    <UsagePreview
      tree={listboxPlainTree(t)}
      optionName="orientation"
      title={t("listbox.prop.orientation.title")}
      description={t("listbox.prop.orientation.body")}
      explain={explain("orientation", ["vertical", "horizontal"])}
      stageMinBlockSize="12rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={listboxSingleTree(t)} title={t("listbox.singleTitle")} description={t("listbox.singleBody")} />
    <UsagePreview tree={listboxMultipleTree(t)} title={t("listbox.multipleTitle")} description={t("listbox.multipleBody")} />
    <UsagePreview tree={listboxHorizontalTree(t)} title={t("listbox.horizontalTitle")} description={t("listbox.horizontalBody")} />

    <h3>{t("listbox.eventsTitle")}</h3>
    <p set:html={t("listbox.eventsBody")} />
    <CodeBlock code={react} label="React" lang="tsx" />
    <CodeBlock code={vanilla} label="JavaScript" lang="ts" />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("listbox.anatomyBody")} />
    <UsagePreview tree={listboxAnatomyTree(t)} css={annotationDemoCss} label={t("listbox.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("listbox.guidelinesLede")} />
    <WhenToUse use={tList(t, "listbox.when")} avoid={tList(t, "listbox.whenNot")} />
    <DoDont
      title={t("listbox.dd.actions.title")}
      do={{ tree: listboxPlainTree(t), caption: t("listbox.dd.actions.do") }}
      dont={{ tree: listboxDontActionsTree(t), caption: t("listbox.dd.actions.dont") }}
    />
    <DoDont
      title={t("listbox.dd.multiple.title")}
      do={{ tree: listboxDoMultipleFiltersTree(t), caption: t("listbox.dd.multiple.do") }}
      dont={{ tree: listboxDontSingleFiltersTree(t), caption: t("listbox.dd.multiple.dont") }}
    />
    <DoDont
      title={t("listbox.dd.horizontal.title")}
      do={{ tree: listboxDoHorizontalShortTree(t), caption: t("listbox.dd.horizontal.do") }}
      dont={{ tree: listboxDontHorizontalLongTree(t), caption: t("listbox.dd.horizontal.dont") }}
    />
    <DoDont
      title={t("listbox.dd.disabled.title")}
      do={{ tree: listboxDoDisabledTree(t), caption: t("listbox.dd.disabled.do") }}
      dont={{ tree: listboxDontMissingTree(t), caption: t("listbox.dd.disabled.dont") }}
    />
    <DoDont
      title={t("listbox.dd.order.title")}
      do={{ tree: listboxDoNaturalOrderTree(t), caption: t("listbox.dd.order.do") }}
      dont={{ tree: listboxDontAlphabeticalDaysTree(t), caption: t("listbox.dd.order.dont") }}
    />
    <ContentRules items={tList(t, "listbox.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("listbox.a11yIntro")}
      does={tList(t, "listbox.a11yDoes")}
      yours={tList(t, "listbox.a11yYours")}
      keys={[
        { keys: ["↑", "↓"], action: t("listbox.key.arrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("listbox.key.homeEnd") },
        { keys: [t("component.key.space"), "Enter"], action: t("listbox.key.select") },
        { keys: ["A–Z"], action: t("listbox.key.letter") },
        { keys: ["Tab"], action: t("listbox.key.tab") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
