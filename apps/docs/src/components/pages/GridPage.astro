---
/* The anatomy diagram is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import { annotationDemoCss } from "../../demos/annotation";
import { gridAnatomyTree } from "../../demos/layout-anatomy";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import { gridMulticolTree, gridResponsiveTree, gridTree, gridScaleSpecimenTree } from "../../demos/layout";
import { getLocale, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));

const multicolCss = `/* data-columns="5": 1 carril → 2 → 3 → 4 → 5,
   según el viewport. */
.sk-grid[data-multicol] {
  column-count: 1;
  column-gap: var(--sk-grid-gap);
}

.sk-grid[data-multicol] > * {
  break-inside: avoid;
  margin-block-end: var(--sk-grid-gap);
}

@media (min-width: 36rem) {
  .sk-grid[data-multicol][data-columns="2"],
  .sk-grid[data-multicol][data-columns="3"],
  .sk-grid[data-multicol][data-columns="4"],
  .sk-grid[data-multicol][data-columns="5"] {
    column-count: 2;
  }
}

@media (min-width: 52rem) {
  .sk-grid[data-multicol][data-columns="3"],
  .sk-grid[data-multicol][data-columns="4"],
  .sk-grid[data-multicol][data-columns="5"] {
    column-count: 3;
  }
}

@media (min-width: 72rem) {
  .sk-grid[data-multicol][data-columns="4"],
  .sk-grid[data-multicol][data-columns="5"] {
    column-count: 4;
  }
}

@media (min-width: 90rem) {
  .sk-grid[data-multicol][data-columns="5"] {
    column-count: 5;
  }
}`;

const responsiveCss = `/* data-responsive: la misma progresión de carriles, pero Grid CSS real:
   cada fila iguala su alto a la celda más alta. */
.sk-grid[data-responsive][data-columns] {
  grid-auto-flow: dense;
  align-items: start;
}

/* A direct child asks for more tracks with data-span (up to the grid's
   maximum), clamped to whatever exists at each breakpoint. */
@media (min-width: 36rem) {
  .sk-grid[data-responsive] > [data-span="2"],
  .sk-grid[data-responsive] > [data-span="3"],
  .sk-grid[data-responsive] > [data-span="4"],
  .sk-grid[data-responsive] > [data-span="5"] {
    grid-column: span 2;
  }
}`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`grid.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Grid"
  description={t("grid.description")}
  badge={t("grid.betaBadge")}
  contractId="layout"
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        {
          name: "renders Stack, Inline and Grid as the documented layout contracts",
          description: t("grid.test1"),
        },
        {
          name: "switches Grid into responsive rows and lets a child request a wider span",
          description: t("grid.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("grid.lede")} />

    <UsagePreview
      tree={gridTree(t)}
      optionName="columns"
      title={t("grid.prop.columns.title")}
      description={t("grid.prop.columns.body")}
      explain={explain("columns", ["1", "2", "3", "4", "5"])}
      stageMinBlockSize="14rem"
    />

    <h3>{t("grid.showcaseTitle")}</h3>
    <p set:html={t("grid.showcaseBody")} />
    <UsagePreview tree={gridTree(t)} />
    <h3>{t("grid.multicolTitle")}</h3>
    <p set:html={t("grid.multicolBody1")} />
    <p set:html={t("grid.multicolBody2")} />
    <CodeBlock code={multicolCss} label="patterns/layout.css" />
    <UsagePreview tree={gridMulticolTree(t)} />
    <p set:html={t("grid.multicolBody3")} />

    <h3>{t("grid.responsiveTitle")}</h3>
    <p set:html={t("grid.responsiveBody1")} />
    <p set:html={t("grid.responsiveBody2")} />
    <CodeBlock code={responsiveCss} label="patterns/layout.css" />
    <UsagePreview tree={gridResponsiveTree(t)} />

    <h3>{t("grid.htmlTitle")}</h3>
    <p set:html={t("grid.htmlBody")} />
    <p set:html={t("grid.reactBody")} />
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("grid.contractItem1")} />
      <li set:html={t("grid.contractItem2")} />
      <li set:html={t("grid.contractItem3")} />
      <li set:html={t("grid.contractItem4")} />
      <li set:html={t("grid.contractItem5")} />
    </ul>

    <UsagePreview
      tree={variantsTree(gridScaleSpecimenTree(t), [{ label: "none", options: { gap: "none" } }, { label: "xs", options: { gap: "xs" } }, { label: "sm", options: { gap: "sm" } }, { label: "md", options: { gap: "md" } }, { label: "lg", options: { gap: "lg" } }, { label: "xl", options: { gap: "xl" } }], [], "3")}
      title={t("component.scaleTitle", { option: "gap" })}
      description={t("component.scaleBody")}
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("grid.anatomyBody")} />
    <ComponentPreview
      tree={gridAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("grid.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("grid.guidelinesLede")} />
    <ul>
      <li set:html={t("grid.guide.use1")} />
      <li set:html={t("grid.guide.use2")} />
      <li set:html={t("grid.guide.avoid1")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
