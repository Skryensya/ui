---
import "../../examples/loader.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import HookPlayground from "../HookPlayground.astro";
import {
  loaderContextsTree,
  loaderHookPlaygroundControls,
  loaderHookPlaygroundTree,
  loaderSimulationScript,
  loaderSimulationTree,
  loaderSizesTree,
  loaderSpeedsTree,
} from "../../demos/loader";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/loader.css";`;
const t = useTranslations(getLocale(Astro.url));

const customSpeed = `.sk-loader.mi-loader {
  --sk-loader-duration: 2s;
}`;
---

<ComponentPageShell
  title="Loader"
  description={t("loaderPage.description")}
  contractId="loader"
  styleGroups={[{ file: "components/loader.css", probe: "sk-loader" }]}
  tests={[
    {
      file: "packages/react/src/components/loader.test.tsx",
      tests: [
        { name: "exposes labelled indeterminate work as a polite status", description: t("loaderPage.test1") },
        { name: "writes orthogonal variant and speed axes onto the root", description: t("loaderPage.test2") },
        {
          name: "stays decorative when the surrounding control already carries the status meaning",
          description: t("loaderPage.test3"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("loaderPage.lede")} />

    <div class="sk-callout" data-tone="info">
      <div class="sk-callout__content">
        <div class="sk-callout__description" set:html={t("loaderPage.calloutBody")} />
      </div>
    </div>

    <h3>{t("loaderPage.simTitle")}</h3>
    <p set:html={t("loaderPage.simBody")} />
    <ComponentPreview
      tree={loaderSimulationTree(t)}
      js={loaderSimulationScript}
      previewScript={loaderSimulationScript}
      label={t("loaderPage.simLabel")}
      note={t("loaderPage.simNote")}
    />
    <p set:html={t("loaderPage.simBody2")} />

    <h3>{t("loaderPage.contextsTitle")}</h3>
    <p set:html={t("loaderPage.contextsBody")} />
    <ComponentPreview tree={loaderContextsTree(t)} label={t("loaderPage.contextsLabel")} note={t("loaderPage.contextsNote")} />
    <ul>
      <li set:html={t("loaderPage.contextsItem1")} />
      <li set:html={t("loaderPage.contextsItem2")} />
      <li set:html={t("loaderPage.contextsItem3")} />
    </ul>

    <h3>{t("loaderPage.sizeTitle")}</h3>
    <p set:html={t("loaderPage.sizeBody")} />
    <ComponentPreview tree={loaderSizesTree(t)} label={t("loaderPage.sizeLabel")} />

    <h3>{t("loaderPage.speedTitle")}</h3>
    <p set:html={t("loaderPage.speedBody")} />
    <ComponentPreview tree={loaderSpeedsTree(t)} label={t("loaderPage.speedLabel")} />
    <CodeBlock code={customSpeed} label={t("loaderPage.speedOverrideLabel")} lang="css" />

    <h3>{t("loaderPage.semanticsTitle")}</h3>
    <ul>
      <li set:html={t("loaderPage.semanticsItem1")} />
      <li set:html={t("loaderPage.semanticsItem2")} />
      <li set:html={t("loaderPage.semanticsItem3")} />
      <li set:html={t("loaderPage.semanticsItem4")} />
    </ul>

    <h3>{t("loaderPage.reducedTitle")}</h3>
    <p set:html={t("loaderPage.reducedBody")} />

    <p set:html={t("loaderPage.reactBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="style">
    <h3>{t("loaderPage.hookPlaygroundTitle")}</h3>
    <p set:html={t("loaderPage.hookPlaygroundBody")} />
    <HookPlayground
      tree={loaderHookPlaygroundTree(t)}
      controls={loaderHookPlaygroundControls}
      label={t("loaderPage.hookPlaygroundLabel")}
      probe=".sk-loader"
    />
  </Fragment>
</ComponentPageShell>
