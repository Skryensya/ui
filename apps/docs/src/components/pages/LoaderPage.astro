---
import "../../examples/loader.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import DoDont from "../DoDont.astro";
import "@skryensya/core/components/progress.css";
import "@skryensya/core/components/placeholder.css";
import UsagePreview from "../UsagePreview.astro";
import HookPlayground from "../HookPlayground.astro";
import {
  loaderAnatomyTree,
  loaderContextsTree,
  loaderHookPlaygroundControls,
  loaderHookPlaygroundTree,
  loaderPseudoVariantsTree,
  loaderSimulationScript,
  loaderSimulationTree,
  loaderSingleTree,
  loaderDoTextTree,
  loaderDontAloneTree,
  loaderDoProgressTree,
  loaderDontProgressTree,
  loaderDoControlTree,
  loaderDontControlTree,
  loaderDoShapeTree,
  loaderDontShapeTree,
  loaderStaggeredVariantsTree,
} from "../../demos/loader";
import { getLocale, tList, useTranslations } from "../../i18n";
import { annotationDemoCss } from "../../demos/annotation";
import "@skryensya/core/components/annotation.css";

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/loader.css";`;
const t = useTranslations(getLocale(Astro.url));

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`loaderPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Loader"
  description={t("loaderPage.description")}
  contractId="loader"
  testFiles={["packages/react/src/components/loader.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("loaderPage.lede")} />

    <UsagePreview
      tree={loaderSingleTree(t)}
      optionName="size"
      title={t("loaderPage.prop.size.title")}
      description={t("loaderPage.prop.size.body")}
      explain={explain("size", ["sm", "md", "lg"])}
      stageMinBlockSize="8rem"
      labels={{ sm: "sm", md: "md", lg: "lg" }}
    />

    <UsagePreview
      tree={loaderSingleTree(t)}
      optionName="speed"
      title={t("loaderPage.prop.speed.title")}
      description={t("loaderPage.prop.speed.body")}
      explain={explain("speed", ["fast", "normal", "slow"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <h3>{t("loaderPage.simTitle")}</h3>
    <p set:html={t("loaderPage.simBody")} />
    <UsagePreview tree={loaderSimulationTree(t)} script={loaderSimulationScript} label={t("loaderPage.simLabel")} />
    <UsagePreview tree={loaderContextsTree(t)} title={t("loaderPage.contextsTitle")} description={t("loaderPage.contextsBody")} />
    <UsagePreview tree={loaderPseudoVariantsTree(t)} title={t("loaderPage.variantsTitle")} description={t("loaderPage.variantsBody")} storybookTitle="Components/Feedback/Loader" storybookStory="Default" />
    <UsagePreview tree={loaderStaggeredVariantsTree(t)} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "loaderPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("loaderPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("loaderPage.anatomyBody")} />
    <UsagePreview
      tree={loaderAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("loaderPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("loaderPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "loaderPage.when")} avoid={tList(t, "loaderPage.whenNot")} />
    <DoDont
      title={t("loaderPage.dd.text.title")}
      do={{ tree: loaderDoTextTree(t), caption: t("loaderPage.dd.text.do") }}
      dont={{ tree: loaderDontAloneTree, caption: t("loaderPage.dd.text.dont") }}
    />
    <DoDont
      title={t("loaderPage.dd.progress.title")}
      do={{ tree: loaderDoProgressTree(t), caption: t("loaderPage.dd.progress.do") }}
      dont={{ tree: loaderDontProgressTree(t), caption: t("loaderPage.dd.progress.dont") }}
    />
    <DoDont
      title={t("loaderPage.dd.control.title")}
      do={{ tree: loaderDoControlTree(t), caption: t("loaderPage.dd.control.do") }}
      dont={{ tree: loaderDontControlTree(t), caption: t("loaderPage.dd.control.dont") }}
    />
    <DoDont
      title={t("loaderPage.dd.shape.title")}
      do={{ tree: loaderDoShapeTree(t), caption: t("loaderPage.dd.shape.do") }}
      dont={{ tree: loaderDontShapeTree(t), caption: t("loaderPage.dd.shape.dont") }}
    />
    <ContentRules items={tList(t, "loaderPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("loaderPage.a11yIntro")} does={tList(t, "loaderPage.a11yDoes")} yours={tList(t, "loaderPage.a11yYours")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="style">
    <h3>{t("loaderPage.hookPlaygroundTitle")}</h3>
    <p set:html={t("loaderPage.hookPlaygroundBody")} />
    <HookPlayground
      tree={loaderHookPlaygroundTree(t)}
      controls={loaderHookPlaygroundControls}
      label={t("loaderPage.hookPlaygroundLabel")}
      probe=".sk-loader"
    />
  </Fragment>
</ComponentPageShell>
