---
import "../../examples/loader.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import HookPlayground from "../HookPlayground.astro";
import {
  loaderAnatomyTree,
  loaderContextsTree,
  loaderHookPlaygroundControls,
  loaderHookPlaygroundTree,
  loaderPseudoVariantsTree,
  loaderSimulationScript,
  loaderSimulationTree,
  loaderSingleTree,
  loaderSizesTree,
  loaderSpeedsTree,
  loaderStaggeredVariantsTree,
} from "../../demos/loader";
import { getLocale, useTranslations } from "../../i18n";
import { annotationDemoCss } from "../../demos/annotation";
import "@skryensya/core/components/annotation.css";

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/loader.css";`;
const t = useTranslations(getLocale(Astro.url));

const customSpeed = `.sk-loader.mi-loader {
  --sk-loader-duration: 2s;
}`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`loaderPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Loader"
  description={t("loaderPage.description")}
  contractId="loader"
  testFiles={["packages/react/src/components/loader.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("loaderPage.lede")} />

    <UsagePreview
      tree={loaderSingleTree(t)}
      optionName="variant"
      title={t("loaderPage.prop.variant.title")}
      description={t("loaderPage.prop.variant.body")}
      explain={explain("variant", ["ring", "sweep", "bars", "dots", "arc", "comet", "orbit", "clock", "spokes", "ticks", "compass", "beads"])}
      stageMinBlockSize="8rem"
      labels={{ ring: "ring", sweep: "sweep", bars: "bars", dots: "dots", arc: "arc", comet: "comet", orbit: "orbit", clock: "clock", spokes: "spokes", ticks: "ticks", compass: "compass", beads: "beads" }}
    />

    <UsagePreview
      tree={loaderSingleTree(t)}
      optionName="size"
      title={t("loaderPage.prop.size.title")}
      description={t("loaderPage.prop.size.body")}
      explain={explain("size", ["sm", "md", "lg"])}
      stageMinBlockSize="8rem"
      labels={{ sm: "sm", md: "md", lg: "lg" }}
    />

    <UsagePreview
      tree={loaderSingleTree(t)}
      optionName="speed"
      title={t("loaderPage.prop.speed.title")}
      description={t("loaderPage.prop.speed.body")}
      explain={explain("speed", ["fast", "normal", "slow"])}
      stageMinBlockSize="8rem"
    />

    <h3>{t("loaderPage.showcaseTitle")}</h3>
    <p set:html={t("loaderPage.showcaseBody")} />

    <div class="sk-callout" data-tone="info">
      <div class="sk-callout__content">
        <div class="sk-callout__description" set:html={t("loaderPage.calloutBody")} />
      </div>
    </div>

    <h3>{t("loaderPage.simTitle")}</h3>
    <p set:html={t("loaderPage.simBody")} />
    <ComponentPreview
      tree={loaderSimulationTree(t)}
      js={loaderSimulationScript}
      previewScript={loaderSimulationScript}
      label={t("loaderPage.simLabel")}
      note={t("loaderPage.simNote")}
    />
    <p set:html={t("loaderPage.simBody2")} />

    <h3>{t("loaderPage.contextsTitle")}</h3>
    <p set:html={t("loaderPage.contextsBody")} />
    <ComponentPreview tree={loaderContextsTree(t)} label={t("loaderPage.contextsLabel")} note={t("loaderPage.contextsNote")} />
    <ul>
      <li set:html={t("loaderPage.contextsItem1")} />
      <li set:html={t("loaderPage.contextsItem2")} />
      <li set:html={t("loaderPage.contextsItem3")} />
    </ul>

    <h3>{t("loaderPage.variantsTitle")}</h3>
    <p set:html={t("loaderPage.variantsBody")} />
    <UsagePreview tree={loaderPseudoVariantsTree(t)} />
    <p set:html={t("loaderPage.staggeredVariantsBody")} />
    <ComponentPreview
      tree={loaderStaggeredVariantsTree(t)}
      label={t("loaderPage.staggeredVariantsLabel")}
      note={t("loaderPage.staggeredVariantsNote")}
    />

    <h3>{t("loaderPage.sizeTitle")}</h3>
    <p set:html={t("loaderPage.sizeBody")} />
    <UsagePreview tree={loaderSizesTree(t)} />

    <h3>{t("loaderPage.speedTitle")}</h3>
    <p set:html={t("loaderPage.speedBody")} />
    <UsagePreview tree={loaderSpeedsTree(t)} />
    <CodeBlock code={customSpeed} label={t("loaderPage.speedOverrideLabel")} lang="css" />

    <h3>{t("loaderPage.tempoTitle")}</h3>
    <p set:html={t("loaderPage.tempoBody")} />

    <h3>{t("loaderPage.semanticsTitle")}</h3>
    <ul>
      <li set:html={t("loaderPage.semanticsItem1")} />
      <li set:html={t("loaderPage.semanticsItem2")} />
      <li set:html={t("loaderPage.semanticsItem3")} />
      <li set:html={t("loaderPage.semanticsItem4")} />
    </ul>

    <h3>{t("loaderPage.reducedTitle")}</h3>
    <p set:html={t("loaderPage.reducedBody")} />

    <p set:html={t("loaderPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("loaderPage.anatomyBody")} />
    <ComponentPreview
      tree={loaderAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("loaderPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("loaderPage.guidelinesLede")} />
    <ul>
      <li set:html={t("loaderPage.guide.use1")} />
      <li set:html={t("loaderPage.guide.avoid1")} />
      <li set:html={t("loaderPage.guide.avoid2")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="style">
    <h3>{t("loaderPage.hookPlaygroundTitle")}</h3>
    <p set:html={t("loaderPage.hookPlaygroundBody")} />
    <HookPlayground
      tree={loaderHookPlaygroundTree(t)}
      controls={loaderHookPlaygroundControls}
      label={t("loaderPage.hookPlaygroundLabel")}
      probe=".sk-loader"
    />
  </Fragment>
</ComponentPageShell>
