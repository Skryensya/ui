---
import "@skryensya/core/components/feed.css";
import "@skryensya/core/components/list.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The activity demo composes a real Tag and the loading one a Placeholder; neither sheet is
   global. A preview frame only copies the sheets this page imported, so a missing one here is an
   unstyled demo there rather than a build error. Avatar, Button, Table, Kbd and Typography come
   from `Base.astro` already and are deliberately not repeated. */
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/placeholder.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  feedActivityTree,
  feedAnatomyTree,
  feedBusyTree,
  feedCommentsTree,
  feedInfiniteTree,
  feedTree,
  feedDontSpinnerTree,
  feedDontGenericLabelsTree,
  feedDontMixedOrderTree,
  feedGuideTree,
  feedDontFixedListTree,
  feedFixedListTree,
} from "../../demos/feed";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import loadMoreScript from "../../demos/scripts/feed-load-more.ts?raw";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;

/* The keyboard model is the one part of this component that is not markup, so it gets the one
   code sample: the same option in both bindings, side by side. */
const keyboardSample = `<!-- Authored markup: the enhancer reads the attribute off the DOM. -->
<div class="sk-feed" data-sk-feed data-keyboard="true" role="feed" aria-label="Actividad reciente">
  <article class="sk-feed__article" role="article" aria-posinset="1" aria-setsize="-1"
           aria-labelledby="post-1-label">
    <div class="sk-feed__article-label" id="post-1-label">María. Hace 2 horas</div>
    <p>Publicó el resumen del sprint.</p>
  </article>
</div>`;

const keyboardReact = `import { Feed, FeedArticle } from "@skryensya/react/feed";

// \`keyboard\` is off by default: a five-post panel does not need Page Down, and the pattern
// does not require it. Turn it on for a stream long enough that scrolling is the alternative.
<Feed keyboard label="Actividad reciente">
  <FeedArticle label="María. Hace 2 horas" posInset={1} setSize={-1}>
    Publicó el resumen del sprint.
  </FeedArticle>
</Feed>`;
---

<ComponentPageShell
  title="Feed"
  description={t("feedPage.description")}
  contractId="feed"
  testFiles={[
    "packages/core/src/feed.test.ts",
    "packages/react/src/components/feed.test.tsx",
    "packages/vanilla/src/components/feed.test.ts",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("feedPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={feedTree(t)} title={t("feedPage.demoTitle")} description={t("feedPage.demoBody")} storybookTitle="Components/Content/Feed" storybookStory="Default" />
    <UsagePreview tree={feedActivityTree(t)} title={t("feedPage.demoActivityTitle")} description={t("feedPage.demoActivityBody")} storybookTitle="Components/Content/Feed" storybookStory="Activity" />
    <UsagePreview tree={feedBusyTree(t)} title={t("feedPage.demoBusyTitle")} description={t("feedPage.demoBusyBody")} storybookTitle="Components/Content/Feed" storybookStory="Busy" />
    <h3>{t("feedPage.demoInfiniteTitle")}</h3>
    <p set:html={t("feedPage.demoInfiniteBody")} />
    <UsagePreview script={loadMoreScript} tree={feedInfiniteTree(t)} label={t("feedPage.demoInfiniteLabel")} />
    <UsagePreview tree={feedCommentsTree(t)} title={t("feedPage.demoCommentsTitle")} description={t("feedPage.demoCommentsBody")} storybookTitle="Components/Content/Feed" storybookStory="Comments" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "feedPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <CodeBlock code={keyboardSample} label="HTML" lang="html" />
    <CodeBlock code={keyboardReact} label="React" lang="tsx" />
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("feedPage.anatomyBody")} />
    <UsagePreview tree={feedAnatomyTree(t)} css={annotationDemoCss} label={t("feedPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("feedPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "feedPage.when")} avoid={tList(t, "feedPage.whenNot")} />
    <DoDont
      canvas
      title={t("feedPage.dd.loading.title")}
      do={{ tree: feedGuideTree(t, feedBusyTree(t)), caption: t("feedPage.dd.loading.do") }}
      dont={{ tree: feedGuideTree(t, feedDontSpinnerTree(t)), caption: t("feedPage.dd.loading.dont") }}
    />
    <DoDont
      canvas
      title={t("feedPage.dd.fixed.title")}
      do={{ tree: feedGuideTree(t, feedFixedListTree(t), true), caption: t("feedPage.dd.fixed.do") }}
      dont={{ tree: feedGuideTree(t, feedDontFixedListTree(t), true), caption: t("feedPage.dd.fixed.dont") }}
    />
    <DoDont
      canvas
      title={t("feedPage.dd.labels.title")}
      do={{ tree: feedGuideTree(t, feedTree(t)), caption: t("feedPage.dd.labels.do") }}
      dont={{ tree: feedGuideTree(t, feedDontGenericLabelsTree(t)), caption: t("feedPage.dd.labels.dont") }}
    />
    <DoDont
      canvas
      title={t("feedPage.dd.order.title")}
      do={{ tree: feedGuideTree(t, feedTree(t)), caption: t("feedPage.dd.order.do") }}
      dont={{ tree: feedGuideTree(t, feedDontMixedOrderTree(t)), caption: t("feedPage.dd.order.dont") }}
    />
    <ContentRules items={tList(t, "feedPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("feedPage.a11yIntro")}
      does={tList(t, "feedPage.a11yDoes")}
      yours={tList(t, "feedPage.a11yYours")}
      keysNote={t("feedPage.a11yKeysNote")}
      keys={[
        { keys: ["PageDown"], action: t("feedPage.keyboardPageDown") },
        { keys: ["PageUp"], action: t("feedPage.keyboardPageUp") },
        { keys: [`Ctrl+${t("component.key.end")}`], action: t("feedPage.keyboardCtrlEnd") },
        { keys: [`Ctrl+${t("component.key.home")}`], action: t("feedPage.keyboardCtrlHome") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
