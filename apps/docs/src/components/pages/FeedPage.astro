---
import "@skryensya/core/components/feed.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { feedAnatomyTree, feedTree } from "../../demos/feed";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
---

<ComponentPageShell
  title="Feed"
  description={t("feedPage.description")}
  contractId="feed"
  styleGroups={[{ file: "components/feed.css", probe: "sk-feed" }]}
  tests={[
    {
      file: "packages/react/src/components/feed.test.tsx",
      tests: [
        {
          name: "sets role=feed, names it, and reflects aria-busy",
          description: t("feedPage.test1"),
        },
        {
          name: "each article gets role=article with aria-posinset/aria-setsize and a real labelled name",
          description: t("feedPage.test2"),
        },
        {
          name: "allows setSize=-1 for an undetermined total, per WAI's own allowance",
          description: t("feedPage.test3"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("feedPage.lede")} />

    <p set:html={t("feedPage.anatomyBody")} />
    <ComponentPreview
      tree={feedAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("feedPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={feedTree(t)} label="Feed" />
    <p set:html={t("feedPage.body")} />
    <p set:html={t("component.reactNote")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("feedPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
