---
import "@skryensya/core/components/table.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/components/treegrid.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  treegridAnatomyTree,
  treegridDontOneColumnTree,
  treegridInboxTree,
  treegridStressTree,
} from "../../demos/treegrid";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

/*
 * `TreegridScroll` reuses `.sk-table-scroll` and `Treegrid`/its rows reuse `.sk-table`/
 * `.sk-table__*` (the contract's `also`, see `treegrid.ts`). Border, striping, sticky header/column
 * all come from `table.css` for free, so a consumer imports BOTH stylesheets, never `treegrid.css`
 * alone.
 */
const install = `@import "@skryensya/core/components/table.css";
@import "@skryensya/core/components/treegrid.css";`;

const indentHook = `.sk-treegrid {
  /* One level wider, and a smaller disclosure column. */
  --sk-treegrid-indent: var(--space-inset-xl);
  --sk-treegrid-indicator-size: var(--size-icon-sm);
}`;
import { treegridHeadersDoTree, treegridHeadersDontTree } from "../../demos/dodont-more";
---

<ComponentPageShell
  title="Treegrid"
  description={t("treegridPage.description")}
  contractId="treegrid"
  styleGroups={[
    { file: "components/table.css", probe: "sk-table", title: "Heredados de Table" },
    { file: "components/treegrid.css", probe: "sk-treegrid", title: "Treegrid" },
    { file: "patterns/state-layer.css", probe: "sk-interactive", title: "Heredados de State layer" },
  ]}
  testFiles={["packages/vanilla/src/components/treegrid.test.ts", "packages/react/src/components/treegrid.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("treegridPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={treegridInboxTree(t)} title={t("treegridPage.minimalTitle")} description={t("treegridPage.minimalBody")} />
    <UsagePreview tree={treegridStressTree(t)} title={t("treegridPage.stressTitle")} description={t("treegridPage.stressBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "treegridPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("treegridPage.anatomyBody")} />
    <UsagePreview
      tree={treegridAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("treegridPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("treegridPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "treegridPage.when")} avoid={tList(t, "treegridPage.whenNot")} />
    <DoDont
      canvas
      title={t("treegridPage.dd.columns.title")}
      do={{ tree: treegridInboxTree(t), caption: t("treegridPage.dd.columns.do") }}
      dont={{ tree: treegridDontOneColumnTree(t), caption: t("treegridPage.dd.columns.dont") }}
    />
    <DoDont
      title={t("dd3.treegrid.title")}
      do={{ tree: treegridHeadersDoTree(t), caption: t("dd3.treegrid.do") }}
      dont={{ tree: treegridHeadersDontTree(t), caption: t("dd3.treegrid.dont") }}
    />
    <ContentRules items={tList(t, "treegridPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="CSS" lang="css" />
    <p set:html={t("treegridPage.hooksBody")} />
    <CodeBlock code={indentHook} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("treegridPage.a11yIntro")}
      does={tList(t, "treegridPage.a11yDoes")}
      yours={tList(t, "treegridPage.a11yYours")}
      keys={[
        { keys: ["↑", "↓"], action: t("treegridPage.key.updown") },
        { keys: ["→"], action: t("treegridPage.key.right") },
        { keys: ["←"], action: t("treegridPage.key.left") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("treegridPage.key.homeEnd") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
