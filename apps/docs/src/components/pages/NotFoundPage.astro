---
/*
 * THE 404, ONE PAGE FOR BOTH LANGUAGES.
 *
 * It used to be two files, each with its own copy of the markup and its own hardcoded strings - and
 * they had already drifted: the ENGLISH page offered "Prerrequisitos" and "Dimensiones" as its
 * onward links, because the labels were typed in rather than read from the dictionary. One component
 * with `t()` cannot do that.
 *
 * WHAT A 404 OWES THE READER, in order: what they asked for, where it probably was, and the whole
 * index if neither of those is it. The first two cannot be rendered here (a static 404 is one file
 * served for every missing path, so it has no idea which one it was) and arrive from
 * `scripts/not-found.ts`; the third is the header's search and index, since this page has no rail.
 */
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/components/empty-state.css";
import "@skryensya/core/patterns/layout.css";
import { emitMarkup } from "@skryensya/ai-compiler/emit";
import type { UsageTree } from "@skryensya/core/usage-tree";
import { getLocale, localizePath, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/* The index the suggestions are matched against: the same endpoint ⌘K reads, per locale. */
const searchIndex = localizePath("/search-index.json", locale);

/*
 * THE PAGE IS A TREE OF THE KIT'S OWN SIGNATURES (validated with `validate_ui`), not hand-written markup: an EmptyState opens it,
 * a Stack carries the rhythm, the actions are real Buttons and the suggestions a List. The `data-docs-not-found-*` attributes
 * are this page's own hooks for `scripts/not-found.ts`, which fills the failed path and the suggestions (a static 404 is one
 * file for every missing path, so it cannot know either). The List ships ONE placeholder row only because a List needs a
 * row to be valid; the script replaces it, and the whole panel stays `hidden` until it has real suggestions.
 */
const tree: UsageTree = {
  contract: "layout",
  signature: "Stack",
  options: { gap: "lg" },
  attrs: { "data-docs-not-found": searchIndex },
  children: [
    {
      contract: "empty-state",
      signature: "EmptyState",
      options: { headingElement: "h1" },
      attrs: { style: "--sk-empty-state-title-size: var(--font-size-display-sm); --sk-empty-state-max-inline-size: 40rem; margin-inline: auto;" },
      slots: {
        icon: { contract: "icon", signature: "Icon", options: { name: "search" } },
        title: t("notFound.heading"),
        description: [
          { contract: "typography", signature: "Text", options: { size: "lg", tone: "secondary" }, children: t("notFound.lede") },
          {
            contract: "typography",
            signature: "Text",
            options: { size: "sm", tone: "tertiary" },
            children: [
              `${t("notFound.requested")} `,
              { contract: "typography", signature: "Code", attrs: { "data-docs-not-found-path": "" }, children: "/" },
            ],
          },
        ],
        actions: [
          { contract: "button", signature: "Button.navigation", options: { href: localizePath("/", locale), tone: "accent" }, children: t("notFound.home") },
          {
            contract: "button",
            signature: "Button.action",
            options: { variant: "ghost" },
            attrs: { "data-docs-not-found-search": "", "aria-keyshortcuts": "Meta+K Control+K" },
            children: t("notFound.searchHint"),
          },
        ],
      },
    },
    {
      contract: "layout",
      signature: "Stack",
      options: { gap: "sm" },
      attrs: { "data-docs-not-found-suggestions": "", hidden: "" },
      children: [
        { contract: "typography", signature: "Heading", options: { headingSize: "h5", headingElement: "h2", flush: true }, children: t("notFound.suggestions") },
        {
          contract: "list",
          signature: "List",
          attrs: { "data-docs-not-found-list": "" },
          children: [{ contract: "list", signature: "ListItemLink", options: { href: localizePath("/", locale) }, slots: { title: "…" } }],
        },
      ],
    },
  ],
};

const markup = emitMarkup(tree, { fillDefaults: false });
---

<div class="docs-not-found">
  <Fragment set:html={markup} />
</div>

<style>
  /* The kit lays the page out; this only gives it a measure, a margin and room under the header,
     centred in the viewport the way an error state reads best. */
  .docs-not-found {
    box-sizing: border-box;
    inline-size: min(100%, 48rem);
    min-block-size: max(24rem, calc(100dvh - 14rem));
    margin-inline: auto;
    padding-block: var(--space-section);
    padding-inline: var(--space-inset-md);
    display: grid;
    align-content: center;
  }

  /* The suggestions panel is `hidden` until the script has real ones; the layout's own `display` would otherwise win over it. */
  .docs-not-found :global([hidden]) {
    display: none;
  }

  /* The failed path is a URL, not words: it must wrap anywhere, or a long one scrolls the page sideways. */
  .docs-not-found :global([data-docs-not-found-path]) {
    overflow-wrap: anywhere;
  }
</style>
