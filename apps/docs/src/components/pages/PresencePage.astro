---
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  presenceAnatomyTree,
  presenceFieldsTree,
  presenceNoticeTree,
  presenceToastCss,
  presencePlaygroundTree,
  presenceMotionFadeTree,
  presenceMotionSlowTree,
  presenceMotionTree,
} from "../../demos/presence";
import { getLocale, tList, useTranslations } from "../../i18n";
import { storybookDocsUrl, storybookReactUrl, storybookVanillaUrl } from "../../lib/navigation";
import "@skryensya/core/components/presence.css";
import "@skryensya/core/components/callout.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/switch.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/layout.css";
import "@skryensya/core/components/annotation.css";
import { annotationDemoCss } from "../../demos/annotation";

const t = useTranslations(getLocale(Astro.url));
const reactStorybook = storybookDocsUrl(storybookReactUrl, "Components/Layout/Presence", "Notice");
const vanillaStorybook = storybookDocsUrl(storybookVanillaUrl, "Components/Layout/Presence", "Notice");

/*
 * Page-level app code, not part of the component. Each script drives its demo through the DOM,
 * which is exactly the authored-markup API (`hidden` + `data-state`), so the same script runs in
 * both stages. `show` is the two writes `setPresent` makes; the demos inline it rather than import
 * it because a preview script runs as plain page code.
 */
const show = `
function show(element, present) {
  element.hidden = !present;
  element.setAttribute("data-state", present ? "open" : "closed");
}
`;

/* Every click restarts the countdown, so saving twice keeps the notice up instead of racing it. */
const noticeScript = `${show}
const save = document.getElementById("presence-notice-save");
const notice = document.getElementById("presence-notice");
let timer;
save.addEventListener("click", () => {
  show(notice, true);
  clearTimeout(timer);
  timer = setTimeout(() => show(notice, false), 2500);
});
`;

const fieldsScript = `${show}
const toggle = document.getElementById("presence-fields-switch");
const fields = document.getElementById("presence-fields");
toggle.addEventListener("change", () => show(fields, toggle.checked));
`;

import { presenceFramesDoTree, presenceFramesDontTree, presenceSpaceDoTree, presenceSpaceDontTree } from "../../demos/dodont-mocks";
---

<ComponentPageShell
  title="Presence"
  description={t("presence.description")}
  contractId="presence"
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("presence.lede")} />

    <UsagePreview
      tree={presencePlaygroundTree(t)}
      optionName="present"
      title={t("presence.presentTitle")}
      description={t("presence.presentBody")}
      labels={{ false: t("presence.present.false"), true: t("presence.present.true") }}
      explain={{ false: t("presence.presentExplain.false"), true: t("presence.presentExplain.true") }}
      remountOnChange={false}
      stageMinBlockSize="9rem"
    />

    <UsagePreview
      variants={(["default", "fade", "slow"] as const).map((motion) => ({
        value: motion,
        label: t(`presence.tuning${motion === "default" ? "Default" : motion === "fade" ? "Fade" : "Slow"}` as Parameters<typeof t>[0]),
        tree: { default: presenceMotionTree, fade: presenceMotionFadeTree, slow: presenceMotionSlowTree }[motion](t),
        explain: t(`presence.motion.${motion}.explain` as Parameters<typeof t>[0]),
      }))}
      initialVariant="default"
      variantsLabel={t("presence.motionLabel")}
      toggleLabel={t("presence.tuningToggle")}
      title={t("presence.tuningHeading")}
      description={t("presence.tuningIntro")}
      remountOnChange={false}
      stageMinBlockSize="6rem"
    />

    <h3>{t("component.examplesTitle")}</h3>

    <h3>{t("presence.noticeHeading")}</h3>
    <p set:html={t("presence.noticeIntro")} />
    <UsagePreview tree={presenceNoticeTree(t)} script={noticeScript} css={presenceToastCss} label={t("presence.noticeLabel")} />

    <h3>{t("presence.fieldsHeading")}</h3>
    <p set:html={t("presence.fieldsIntro")} />
    <UsagePreview tree={presenceFieldsTree(t)} script={fieldsScript} label={t("presence.fieldsLabel")} />

    <h3>{t("presence.reactTitle")}</h3>
    <p>
      {t("presence.reactBody")}
      {reactStorybook && <a class="sk-link sk-interactive" href={reactStorybook} rel="noreferrer" target="_blank">Storybook React</a>}
      {reactStorybook && vanillaStorybook && " · "}
      {vanillaStorybook && <a class="sk-link sk-interactive" href={vanillaStorybook} rel="noreferrer" target="_blank">Storybook Vanilla</a>}
    </p>

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "presence.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("presence.anatomyBody")} />
    <UsagePreview
      tree={presenceAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("presence.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("presence.guidelinesLede")} />
    <WhenToUse use={tList(t, "presence.when")} avoid={tList(t, "presence.whenNot")} />
    <DoDont
      canvas
      title={t("presence.dd.frames.title")}
      do={{ tree: presenceFramesDoTree(t), caption: t("presence.dd.frames.do") }}
      dont={{ tree: presenceFramesDontTree(t), caption: t("presence.dd.frames.dont") }}
    />
    <DoDont
      canvas
      title={t("presence.dd.space.title")}
      do={{ tree: presenceSpaceDoTree(t), caption: t("presence.dd.space.do") }}
      dont={{ tree: presenceSpaceDontTree(t), caption: t("presence.dd.space.dont") }}
    />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("presence.a11yIntro")} does={tList(t, "presence.a11yDoes")} yours={tList(t, "presence.a11yYours")} />
  </Fragment>
</ComponentPageShell>
