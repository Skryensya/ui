---
import "@skryensya/core/patterns/state-layer.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/number-field.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { numberFieldAnatomyTree, numberFieldTree } from "../../demos/number-field";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const styles = `@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/number-field.css";`;
---

<ComponentPageShell
  title="NumberField"
  description={t("numberFieldPage.description")}
  contractId="number-field"
  styleGroups={[{ file: "components/number-field.css", probe: "sk-number-field", title: "NumberField" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/number-field.test.ts",
      tests: [
        {
          name: "wires the accessible names from the authored aria-label onto the triggers",
          description: t("numberFieldPage.testVanilla1"),
        },
        {
          name: "increments and decrements by step, emitting sk-value-change",
          description: t("numberFieldPage.testVanilla2"),
        },
        {
          name: "disables the increment trigger at max and the decrement trigger at min",
          description: t("numberFieldPage.testVanilla3"),
        },
        {
          name: "pressing a disabled trigger at the bound is a no-op",
          description: t("numberFieldPage.testVanilla4"),
        },
        {
          name: "commits a typed value on blur and emits sk-value-change",
          description: t("numberFieldPage.testVanilla5"),
        },
        {
          name: "clamps a typed value past max down to the bound on blur",
          description: t("numberFieldPage.testVanilla6"),
        },
        {
          name: "disables the input and both triggers when the root's own input is authored disabled",
          description: t("numberFieldPage.testVanilla7"),
        },
        {
          name: "wires role=spinbutton with aria-valuemin/aria-valuemax/aria-valuenow",
          description: t("numberFieldPage.testVanilla8"),
        },
        {
          name: "ArrowUp/ArrowDown step from the keyboard, Home/End jump to the bounds",
          description: t("numberFieldPage.testVanilla9"),
        },
      ],
    },
    {
      file: "packages/react/src/components/number-field.test.tsx",
      tests: [
        {
          name: "wires the accessible names from decrementLabel/incrementLabel onto the triggers",
          description: t("numberFieldPage.testReact1"),
        },
        {
          name: "increments and decrements by step, calling onValueChange",
          description: t("numberFieldPage.testReact2"),
        },
        {
          name: "disables the increment trigger at max and the decrement trigger at min",
          description: t("numberFieldPage.testReact3"),
        },
        {
          name: "pressing a disabled trigger at the bound is a no-op",
          description: t("numberFieldPage.testReact4"),
        },
        {
          name: "commits a typed value on blur and calls onValueChange",
          description: t("numberFieldPage.testReact5"),
        },
        {
          name: "clamps a typed value past max down to the bound on blur",
          description: t("numberFieldPage.testReact6"),
        },
        {
          name: "disables the input and both triggers when disabled",
          description: t("numberFieldPage.testReact7"),
        },
        {
          name: "wires aria-valuemin/aria-valuemax/aria-valuenow",
          description: t("numberFieldPage.testReact8"),
        },
        {
          name: "ArrowUp/ArrowDown step from the keyboard, Home/End jump to the bounds",
          description: t("numberFieldPage.testReact9"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("numberFieldPage.description")} />

    <p set:html={t("numberFieldPage.anatomyBody")} />
    <ComponentPreview
      tree={numberFieldAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("numberFieldPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={numberFieldTree(t)} label="NumberField" viewport="auto" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("numberFieldPage.contractBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("numberFieldPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
