---
import "@skryensya/core/patterns/state-layer.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/number-field.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  numberFieldAnatomyTree,
  numberFieldDontApproxTree,
  numberFieldSingleTree,
  numberFieldTree,
} from "../../demos/number-field";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const styles = `@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/number-field.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`numberFieldPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="NumberField"
  description={t("numberFieldPage.description")}
  contractId="number-field"
  appearanceTargetSelector=".sk-number-field"
  testFiles={["packages/vanilla/src/components/number-field.test.ts", "packages/react/src/components/number-field.test.tsx"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("numberFieldPage.description")} />

    <UsagePreview
      tree={numberFieldSingleTree(t)}
      optionName="appearance"
      title={t("numberFieldPage.prop.appearance.title")}
      description={t("numberFieldPage.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist", "frosted"])}
      stageMinBlockSize="8rem"
    />

    <UsagePreview
      tree={numberFieldSingleTree(t)}
      optionName="disabled"
      title={t("numberFieldPage.prop.disabled.title")}
      description={t("numberFieldPage.prop.disabled.body")}
      explain={explain("disabled", ["false", "true"])}
      stageMinBlockSize="8rem"
      labels={{ false: t("numberFieldPage.prop.disabled.falseLabel"), true: t("numberFieldPage.prop.disabled.trueLabel") }}
    />

    <h3>{t("numberFieldPage.showcaseTitle")}</h3>
    <p set:html={t("numberFieldPage.showcaseBody")} />
    <ComponentPreview tree={numberFieldTree(t)} label="NumberField" viewport="auto" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("numberFieldPage.contractBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("numberFieldPage.anatomyBody")} />
    <ComponentPreview
      tree={numberFieldAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("numberFieldPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("numberFieldPage.guidelinesLede")} />
    <DoDont
      title={t("numberFieldPage.dd.exact.title")}
      do={{ tree: numberFieldSingleTree(t), caption: t("numberFieldPage.dd.exact.do") }}
      dont={{ tree: numberFieldDontApproxTree(t), caption: t("numberFieldPage.dd.exact.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("numberFieldPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
