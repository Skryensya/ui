---
import "@skryensya/core/patterns/state-layer.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/number-field.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  numberFieldAnatomyTree,
  numberFieldDecimalTree,
  numberFieldDoBoundsTree,
  numberFieldDoLabelTree,
  numberFieldDontApproxTree,
  numberFieldDontBoundsTree,
  numberFieldDontLabelTree,
  numberFieldLocaleTree,
  numberFieldSingleTree,
  numberFieldUnboundedTree,
} from "../../demos/number-field";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
/* The locales the number is written in: three groupings, so the difference shows at rest. */
const locales = ["en-US", "es-CL", "en-IN"] as const;

/* The states a field can be in, each an option the contract already declares. */
const states = [
  { value: "default", options: {} },
  { value: "readOnly", options: { readOnly: true } },
  { value: "invalid", options: { invalid: true } },
  { value: "disabled", options: { disabled: true } },
] as const;

const styles = `@import "@skryensya/core/patterns/state-layer.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/number-field.css";`;
---

<ComponentPageShell
  title="NumberField"
  description={t("numberFieldPage.description")}
  contractId="number-field"
  appearanceTargetSelector=".sk-number-field"
  testFiles={["packages/vanilla/src/components/number-field.test.ts", "packages/react/src/components/number-field.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("numberFieldPage.lede")} />

    <UsagePreview
      tree={numberFieldLocaleTree(t, locales[0])}
      variants={locales.map((locale) => ({
        value: locale,
        label: locale,
        tree: numberFieldLocaleTree(t, locale),
        explain: t(`numberFieldPage.prop.locale.${locale}` as Parameters<typeof t>[0]),
      }))}
      variantsLabel={t("numberFieldPage.prop.locale.label")}
      title={t("numberFieldPage.prop.locale.title")}
      description={t("numberFieldPage.prop.locale.body")}
      stageMinBlockSize="9rem"
    />

    <UsagePreview
      tree={numberFieldSingleTree(t)}
      variants={states.map(({ value, options }) => ({
        value,
        label: t(`component.state.${value}` as Parameters<typeof t>[0]),
        tree: { ...numberFieldSingleTree(t), options: { ...numberFieldSingleTree(t).options, ...options } },
        explain: t(`numberFieldPage.state.${value}` as Parameters<typeof t>[0]),
      }))}
      variantsLabel={t("numberFieldPage.state.label")}
      title={t("numberFieldPage.state.title")}
      description={t("numberFieldPage.state.body")}
      stageMinBlockSize="9rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={numberFieldSingleTree(t)} title={t("numberFieldPage.quantityTitle")} description={t("numberFieldPage.quantityBody")} />
    <UsagePreview tree={numberFieldDecimalTree(t)} title={t("numberFieldPage.decimalTitle")} description={t("numberFieldPage.decimalBody")} />
    <UsagePreview tree={numberFieldUnboundedTree(t)} title={t("numberFieldPage.unboundedTitle")} description={t("numberFieldPage.unboundedBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "numberFieldPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("numberFieldPage.anatomyBody")} />
    <UsagePreview
      tree={numberFieldAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("numberFieldPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("numberFieldPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "numberFieldPage.when")} avoid={tList(t, "numberFieldPage.whenNot")} />
    <DoDont
      title={t("numberFieldPage.dd.exact.title")}
      do={{ tree: numberFieldSingleTree(t), caption: t("numberFieldPage.dd.exact.do") }}
      dont={{ tree: numberFieldDontApproxTree(t), caption: t("numberFieldPage.dd.exact.dont") }}
    />
    <DoDont
      title={t("numberFieldPage.dd.bounds.title")}
      do={{ tree: numberFieldDoBoundsTree(t), caption: t("numberFieldPage.dd.bounds.do") }}
      dont={{ tree: numberFieldDontBoundsTree(t), caption: t("numberFieldPage.dd.bounds.dont") }}
    />
    <DoDont
      title={t("numberFieldPage.dd.label.title")}
      do={{ tree: numberFieldDoLabelTree(t), caption: t("numberFieldPage.dd.label.do") }}
      dont={{ tree: numberFieldDontLabelTree(t), caption: t("numberFieldPage.dd.label.dont") }}
    />
    <ContentRules items={tList(t, "numberFieldPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("numberFieldPage.a11yIntro")}
      does={tList(t, "numberFieldPage.a11yDoes")}
      yours={tList(t, "numberFieldPage.a11yYours")}
      keys={[
        { keys: ["↑", "↓"], action: t("numberFieldPage.key.arrows") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("numberFieldPage.key.homeEnd") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
