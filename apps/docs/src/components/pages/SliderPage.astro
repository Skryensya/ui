---
import "@skryensya/core/components/slider.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { sliderAnatomyTree, sliderRangeTree, sliderTree } from "../../demos/slider";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="Slider"
  description={t("sliderPage.description")}
  contractId="slider"
  styleGroups={[{ file: "components/slider.css", probe: "sk-slider" }]}
  tests={[
    {
      file: "packages/react/src/components/slider.test.tsx",
      tests: [
        {
          name: "uses the Zag slider machine anatomy and value state",
          description: t("sliderPage.test1"),
        },
      ],
    },
    {
      file: "packages/vanilla/src/components/slider.test.ts",
      tests: [
        {
          name: "mounts the Zag slider machine over authored markup",
          description: t("sliderPage.test2"),
        },
      ],
    },
    {
      file: "packages/core/src/slider-range.test.ts",
      tests: [
        {
          name: "bounds the low thumb's max at the high thumb's current value, and vice versa",
          description: t("sliderPage.testRange1"),
        },
      ],
    },
    {
      file: "packages/react/src/components/slider-range.test.tsx",
      tests: [
        {
          name: "bounds each thumb's max/min at the other's CURRENT value",
          description: t("sliderPage.testRange2"),
        },
      ],
    },
    {
      file: "packages/vanilla/src/components/slider-range.test.ts",
      tests: [
        {
          name: "paints the fill bar's start/end offsets from each thumb's value",
          description: t("sliderPage.testRange3"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("sliderPage.lede")} />

    <p set:html={t("sliderPage.anatomyBody")} />
    <ComponentPreview
      tree={sliderAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("sliderPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={sliderTree(t)} label="Slider" />
    <p set:html={t("sliderPage.body1")} />
    <p set:html={t("sliderPage.body2")} />
    <p set:html={t("component.reactNote")} />

    <h3>{t("sliderPage.rangeTitle")}</h3>
    <p set:html={t("sliderPage.rangeBody")} />
    <ComponentPreview tree={sliderRangeTree(t)} label={t("sliderPage.rangeLabel")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
