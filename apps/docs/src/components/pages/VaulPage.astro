---
/* The pattern's sheet the shell does not load, and the same one the installation block further down
 * asks the consumer for. Without it the demo's `<dialog>` falls back to the browser's default style. */
import "@skryensya/core/patterns/vaul.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/radio-group.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import UsagePreview from "../UsagePreview.astro";
import { vaulAnatomyCss, vaulAnatomyTree, vaulDeleteTree, vaulFiltersTree, vaulShareTree } from "../../demos/vaul";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const import_ = `@import "@skryensya/core/patterns/vaul.css";
@import "@skryensya/core/patterns/scroll-lock.css";`;

const edges = `
<dialog class="sk-vaul" data-edge="inline-start">…</dialog>
<dialog class="sk-vaul" data-edge="inline-end">…</dialog>
<dialog class="sk-vaul" data-edge="block-end">…</dialog>`;

const vanilla = `import { connectVaul } from "@skryensya/vanilla/vaul";

// ${t("vaulPage.vanillaComment1")}
// ${t("vaulPage.vanillaComment2")}
const cleanup = connectVaul(document.querySelector("#demo-vaul"), {
  // ${t("vaulPage.vanillaComment3")}
  dismissThreshold: 0.4,
  // ${t("vaulPage.vanillaComment4")}
  dismissVelocity: 0.5,
  onOpenChange(details) {
    console.log(details.open);
  },
});`;

const noDrag = `<dialog
  class="sk-vaul"
  data-sk-vaul
  data-draggable="false"
  data-edge="block-end"
>
  <!-- ${t("vaulPage.noDragComment")} -->
</dialog>`;
---

<ComponentPageShell
  title="Vaul"
  description={t("vaulPage.description")}
  contractId="vaul"
  appearanceTargetSelector=".sk-vaul"
  tests={[
    {
      file: "packages/react/src/components/vaul.test.tsx",
      tests: [
        { name: "carries the enhancer's scope markers at rest", description: t("vaulPage.test1") },
        { name: "draws the handle hidden from assistive tech, always", description: t("vaulPage.test2") },
      ],
    },
    {
      file: "packages/core/src/vaul-gesture.test.ts",
      tests: [
        {
          name: "dismisses a far-enough slow drag (distance alone)",
          description: t("vaulPage.test3"),
        },
        {
          name: "dismisses a fast short flick even when the distance is small",
          description: t("vaulPage.test4"),
        },
        {
          name: "a flick BACK home overrules a far drag, direction beats distance",
          description: t("vaulPage.test5"),
        },
      ],
    },
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="anatomy">
    <p set:html={t("vaulPage.anatomyBody")} />
    <UsagePreview tree={vaulAnatomyTree(t)} css={vaulAnatomyCss} label={t("vaulPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("vaulPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    {/* Each sheet on a phone-sized stage, where the drag gesture is live. */}
    <h3>{t("vaulPage.completeTitle")}</h3>
    <p set:html={t("vaulPage.completeBody")} />
    <UsagePreview
      tree={vaulShareTree(t)}
      label={t("vaulPage.completeLabel")}
      viewport="overlay"
      stageMinBlockSize="24rem"
    />

    <h3>{t("vaulPage.examplesTitle")}</h3>
    <p set:html={t("vaulPage.examplesBody")} />
    <UsagePreview
      tree={vaulDeleteTree(t)}
      label={t("vaulPage.deleteLabel")}
      viewport="overlay"
      stageMinBlockSize="24rem"
    />

    <UsagePreview
      tree={vaulFiltersTree(t)}
      label={t("vaulPage.filtersLabel")}
      viewport="overlay"
      stageMinBlockSize="24rem"
    />

    <h3>{t("vaulPage.edgeTitle")}</h3>
    <p set:html={t("vaulPage.edgeBody")} />
    <CodeBlock code={edges} label="HTML" />

    <h3>{t("vaulPage.dragTitle")}</h3>
    <p set:html={t("vaulPage.dragBody1")} />
    <CodeBlock code={vanilla} label="JavaScript" />
    <p set:html={t("vaulPage.dragBody2")} />
    <CodeBlock code={noDrag} label={t("vaulPage.noDragLabel")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "vaulPage.contract").map((item) => <li set:html={item} />)}
    </ul>
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("vaulPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "vaulPage.when")} avoid={tList(t, "vaulPage.whenNot")} />
    <ContentRules items={tList(t, "vaulPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("vaulPage.a11yIntro")}
      does={tList(t, "vaulPage.a11yDoes")}
      yours={tList(t, "vaulPage.a11yYours")}
      keys={[
        { keys: ["Esc"], action: t("vaulPage.key.escape") },
        { keys: ["Tab", "Shift+Tab"], action: t("vaulPage.key.tab") },
      ]}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={import_} label="CSS" />
  </Fragment>
</ComponentPageShell>

<style is:global>
  /* The demo's skin belongs to the consumer, as always: the pattern brings hooks and structure, not
     paint. The width is decided by the pattern's clamp; the height comes from the content up to the
     sheet's ceiling.
     `is:global`: the authored HTML lives inside the srcdoc and does not carry Astro's scope attribute;
     the adapter copies this global rule into the frame, a scoped rule could not reach it. */
  @media (max-width: 52rem) {
    .docs-vaul-step,
    .docs-vaul-complete {
      grid-template-columns: 1fr;
    }
  }
  .demo-vaul {
    --sk-vaul-radius: var(--radius-surface) var(--radius-surface) 0 0;
    --demo-vaul-inset: calc(var(--space-inset-md) + var(--space-inset-xs));
  }

  .demo-vaul[open] {
    display: flex;
    flex-direction: column;
  }

  .demo-vaul__header {
    display: flex;
    gap: var(--space-inline-md);
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--space-inset-sm) var(--demo-vaul-inset);
  }

  .demo-vaul__heading {
    display: grid;
    gap: 2px;
    min-inline-size: 0;
  }

  .demo-vaul__title {
    margin: 0;
    font-size: var(--font-size-heading-sm);
    line-height: var(--font-line-height-heading);
    font-weight: var(--font-weight-heading);
  }

  .demo-vaul__meta {
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
  }

  .demo-vaul__link {
    flex: none;
    padding: var(--space-inset-sm) var(--demo-vaul-inset);
    border-block: 1px solid var(--color-border-subtle);
  }

  .demo-vaul__people {
    --sk-list-row-padding-x: var(--demo-vaul-inset);

    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .demo-vaul__actions {
    display: flex;
    gap: var(--space-inline-sm);
    justify-content: flex-end;
    padding: var(--space-inset-sm) var(--demo-vaul-inset);
    border-block-start: 1px solid var(--color-border-subtle);
  }

  /* POCO CONTENIDO: title, description, two buttons; no header, no scroll region needed. */
  .demo-vaul-delete {
    --sk-vaul-radius: var(--radius-surface) var(--radius-surface) 0 0;
  }

  .demo-vaul-delete[open] {
    display: flex;
    flex-direction: column;
  }

  .demo-vaul-delete__body {
    display: grid;
    gap: var(--space-stack-xs);
    padding: var(--space-inset-md);
  }

  .demo-vaul-delete__title {
    margin: 0;
    font-size: var(--font-size-heading-sm);
    line-height: var(--font-line-height-heading);
    font-weight: var(--font-weight-heading);
  }

  .demo-vaul-delete__desc {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-sm);
  }

  .demo-vaul-delete__actions {
    display: flex;
    gap: var(--space-inline-sm);
    justify-content: flex-end;
    padding: var(--space-inset-sm) var(--space-inset-md);
    border-block-start: 1px solid var(--color-border-subtle);
  }

  /* MÁS CONTENIDO: three grouped sections, tall enough that the body needs its own scroll. */
  .demo-vaul-filters {
    --sk-vaul-radius: var(--radius-surface) var(--radius-surface) 0 0;
  }

  .demo-vaul-filters[open] {
    display: flex;
    flex-direction: column;
  }

  .demo-vaul-filters__header {
    display: flex;
    gap: var(--space-inline-md);
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--space-inset-sm) var(--space-inset-md);
  }

  .demo-vaul-filters__title {
    margin: 0;
    font-size: var(--font-size-heading-sm);
    line-height: var(--font-line-height-heading);
    font-weight: var(--font-weight-heading);
  }

  .demo-vaul-filters__body {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: var(--space-stack-md);
    padding: 0 var(--space-inset-md) var(--space-inset-md);
  }

  .demo-vaul-filters__section {
    display: grid;
    gap: var(--space-stack-xs);
  }

  .demo-vaul-filters__actions {
    display: flex;
    gap: var(--space-inline-sm);
    justify-content: flex-end;
    padding: var(--space-inset-sm) var(--space-inset-md);
    border-block-start: 1px solid var(--color-border-subtle);
  }
</style>
