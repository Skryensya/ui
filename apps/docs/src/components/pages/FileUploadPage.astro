---
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { fileUploadTree } from "../../demos/file-upload";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/file-upload.css";
import contractSource from "@contracts/semantic/file-upload.yaml?raw";
import coreSource from "@core/src/file-upload.ts?raw";
import cssSource from "@core/css/components/file-upload.css?raw";
import vanillaMountSource from "@vanilla/src/components/file-upload.ts?raw";
import vanillaTestSource from "@vanilla/src/components/file-upload.test.ts?raw";
import reactSource from "@react/src/components/file-upload.tsx?raw";
import reactTestSource from "@react/src/components/file-upload.test.tsx?raw";

const t = useTranslations(getLocale(Astro.url));

const sourceFiles = [
  { id: "contracts/semantic/file-upload.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/file-upload.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/file-upload.css", source: cssSource, language: "css" },
  { id: "packages/vanilla/src/components/file-upload.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/vanilla/src/components/file-upload.test.ts", source: vanillaTestSource, language: "ts" },
  { id: "packages/react/src/components/file-upload.tsx", source: reactSource, language: "tsx" },
  { id: "packages/react/src/components/file-upload.test.tsx", source: reactTestSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="FileUpload"
  description={t("fileUploadPage.description")}
  contractId="file-upload"
  sourceFiles={sourceFiles}
  styleGroups={[{ file: "components/file-upload.css", probe: "sk-file-upload", title: "FileUpload" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/file-upload.test.ts",
      tests: [
        {
          name: "wires the dropzone as a real, tabbable button, and the trigger as a native one",
          description: t("fileUploadPage.testVanilla1"),
        },
        {
          name: "opens the file picker from the dropzone via Enter or Space, not just a pointer click",
          description: t("fileUploadPage.testVanilla8"),
        },
        {
          name: "selecting a valid file emits sk-file-change with it accepted",
          description: t("fileUploadPage.testVanilla2"),
        },
        {
          name: "selecting an oversized file emits sk-file-change with it rejected instead of accepted",
          description: t("fileUploadPage.testVanilla3"),
        },
        {
          name: "keeps the clear trigger hidden until a file is accepted, and shows it once one is",
          description: t("fileUploadPage.testVanilla4"),
        },
        {
          name: "clicking the clear trigger empties the accepted files and re-hides itself",
          description: t("fileUploadPage.testVanilla5"),
        },
        {
          name: "does nothing without an authored dropzone/input/trigger to scan",
          description: t("fileUploadPage.testVanilla6"),
        },
        {
          name: "stops the machine when the mount is destroyed",
          description: t("fileUploadPage.testVanilla7"),
        },
      ],
    },
    {
      file: "packages/react/src/components/file-upload.test.tsx",
      tests: [
        {
          name: "announces a rejected file's reason instead of failing silently",
          description: t("fileUploadPage.testReact1"),
        },
        {
          name: "clears the rejection message once a valid selection follows",
          description: t("fileUploadPage.testReact2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("fileUploadPage.description")} />
    <ComponentPreview tree={fileUploadTree(t)} label="FileUpload" viewport="auto" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("fileUploadPage.contractBody")} />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("fileUploadPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
