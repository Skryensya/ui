---
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  fileUploadDoInstructionTree,
  fileUploadDoLimitsTree,
  fileUploadDoTriggerTree,
  fileUploadDontInstructionTree,
  fileUploadDontLimitsTree,
  fileUploadDontTriggerTree,
  fileUploadPageDropTree,
  fileUploadTree,
} from "../../demos/file-upload";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/file-upload.css";
import "@skryensya/core/components/button.css";
/* The rows draw the kit's own ghost icon button and two icon glyphs. */
import "@skryensya/core/patterns/icon.css";
import { variantsTree } from "../../demos/variants";

const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="Drop zone"
  description={t("fileUploadPage.description")}
  contractId="file-upload"
  testFiles={[
    "packages/core/src/file-upload.test.ts",
    "packages/vanilla/src/components/file-upload.test.ts",
    "packages/react/src/components/file-upload.test.tsx",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("fileUploadPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    {/* 31rem reserves the room two chosen files take, so adding them does not push the page. */}
    <UsagePreview
      tree={fileUploadTree(t)}
      css={`.sk-file-upload { inline-size: min(100%, 30rem); margin-inline: auto; }`}
      title={t("fileUploadPage.basicTitle")}
      description={t("fileUploadPage.basicBody")}
      stageMinBlockSize="26rem"
      storybookTitle="Components/Forms/Drop zone"
      storybookStory="Default"
    />
    <h3>{t("fileUploadPage.pageDropTitle")}</h3>
    <p set:html={t("fileUploadPage.pageDropBody")} />
    <UsagePreview
      tree={fileUploadPageDropTree(t)}
      css={`.sk-file-upload { inline-size: min(100%, 30rem); margin-inline: auto; }`}
      label={t("fileUploadPage.pageDropLabel")}
      measure="32rem"
      stageMinBlockSize="26rem"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "fileUploadPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <UsagePreview
      tree={variantsTree(fileUploadTree(t), [{ label: t("component.state.default"), options: {} }, { label: t("component.state.disabled"), options: { disabled: true } }])}
      title={t("component.statesTitle")}
      description={t("component.statesBody")}
    />

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("fileUploadPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "fileUploadPage.when")} avoid={tList(t, "fileUploadPage.whenNot")} />
    <DoDont
      canvas
      title={t("fileUploadPage.dd.limits.title")}
      do={{ tree: fileUploadDoLimitsTree(t), caption: t("fileUploadPage.dd.limits.do") }}
      dont={{ tree: fileUploadDontLimitsTree(t), caption: t("fileUploadPage.dd.limits.dont") }}
    />
    <DoDont
      canvas
      title={t("fileUploadPage.dd.instruction.title")}
      do={{ tree: fileUploadDoInstructionTree(t), caption: t("fileUploadPage.dd.instruction.do") }}
      dont={{ tree: fileUploadDontInstructionTree(t), caption: t("fileUploadPage.dd.instruction.dont") }}
    />
    <DoDont
      canvas
      title={t("fileUploadPage.dd.trigger.title")}
      do={{ tree: fileUploadDoTriggerTree(t), caption: t("fileUploadPage.dd.trigger.do") }}
      dont={{ tree: fileUploadDontTriggerTree(t), caption: t("fileUploadPage.dd.trigger.dont") }}
    />
    <ContentRules items={tList(t, "fileUploadPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("fileUploadPage.a11yIntro")}
      does={tList(t, "fileUploadPage.a11yDoes")}
      yours={tList(t, "fileUploadPage.a11yYours")}
      keys={[
        { keys: ["Tab", "Shift+Tab"], action: t("fileUploadPage.a11yKeyTab") },
        { keys: ["Enter", t("component.key.space")], action: t("fileUploadPage.a11yKeyEnter") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
