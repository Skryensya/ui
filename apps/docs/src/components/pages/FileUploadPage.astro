---
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  fileUploadAnatomyCss,
  fileUploadAnatomyHtml,
  fileUploadDoLimitsTree,
  fileUploadDontLimitsTree,
  fileUploadPageDropTree,
  fileUploadTree,
} from "../../demos/file-upload";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/file-upload.css";
import "@skryensya/core/components/button.css";
/* The rows draw the kit's own ghost icon button and two icon glyphs. */
import "@skryensya/core/patterns/icon.css";

const t = useTranslations(getLocale(Astro.url));

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`fileUploadPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="FileUpload"
  description={t("fileUploadPage.description")}
  contractId="file-upload"
  testFiles={[
    "packages/core/src/file-upload.test.ts",
    "packages/vanilla/src/components/file-upload.test.ts",
    "packages/react/src/components/file-upload.test.tsx",
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("fileUploadPage.description")} />

    <UsagePreview
      tree={fileUploadTree(t)}
      optionName="disabled"
      title={t("fileUploadPage.prop.disabled.title")}
      description={t("fileUploadPage.prop.disabled.body")}
      explain={explain("disabled", ["false", "true"])}
      stageMinBlockSize="20rem"
      labels={{ false: t("fileUploadPage.prop.disabled.falseLabel"), true: t("fileUploadPage.prop.disabled.trueLabel") }}
    />

    <h3>{t("fileUploadPage.showcaseTitle")}</h3>
    <p set:html={t("fileUploadPage.showcaseBody")} />

    {/*
      * A FLOOR, NOT A MEASUREMENT. `preview-heights.json` reserves what a demo settles at, and this
      * one settles EMPTY: the whole point of the control is that you add files to it, and each row
      * pushed the page down under the reader's pointer. Measured on this demo at 1920px: 323px
      * empty, 426 with one file, 496 with two (and 368 with three, where `maxFiles` is reached and
      * the dropzone hides). 31rem is that 496, so the first two files land in room that is already
      * there and nothing below the preview moves.
      */}
    <ComponentPreview
      tree={fileUploadTree(t)}
      label="FileUpload"
      measure="28rem"
      minHeight="31rem"
      viewport="auto"
    />

    <h3 id="validation">{t("fileUploadPage.validationTitle")}</h3>
    <p set:html={t("fileUploadPage.validationBody")} />

    <h3 id="chosen-files">{t("fileUploadPage.chosenTitle")}</h3>
    <p set:html={t("fileUploadPage.chosenBody")} />

    <h3 id="drop-scope">{t("fileUploadPage.dropScopeTitle")}</h3>
    <p set:html={t("fileUploadPage.dropScopeBody")} />
    {/* Same floor as the demo above, and this one needs it more: with no `maxFiles` the dropzone
        never steps aside, so every file added is height added. */}
    <ComponentPreview
      tree={fileUploadPageDropTree(t)}
      label={t("fileUploadPage.pageDropLabel")}
      measure="28rem"
      minHeight="31rem"
      viewport="auto"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("fileUploadPage.contractBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("fileUploadPage.anatomyBody")} />
    {/* Ten labels need the whole track, and `breakout` is how a preview asks for it. It was a no-op
        until the `justify-self` rule in site.css: the panel placed every preview on that track and
        then centred it, so the room was there and nothing took it. */}
    <ComponentPreview
      html={fileUploadAnatomyHtml(t)}
      css={fileUploadAnatomyCss}
      label={t("fileUploadPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
      width="breakout"
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("fileUploadPage.guidelinesLede")} />
    <DoDont
      canvas
      title={t("fileUploadPage.dd.limits.title")}
      do={{ tree: fileUploadDoLimitsTree(t), caption: t("fileUploadPage.dd.limits.do") }}
      dont={{ tree: fileUploadDontLimitsTree(t), caption: t("fileUploadPage.dd.limits.dont") }}
    />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("fileUploadPage.a11yBody")} />
    <p set:html={t("fileUploadPage.dropScopeA11yBody")} />
  </Fragment>
</ComponentPageShell>
