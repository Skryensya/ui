---
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  fileUploadAnatomyCss,
  fileUploadAnatomyHtml,
  fileUploadTree,
} from "../../demos/file-upload";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/file-upload.css";
import "@skryensya/core/components/button.css";

const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="FileUpload"
  description={t("fileUploadPage.description")}
  contractId="file-upload"
  testFiles={["packages/vanilla/src/components/file-upload.test.ts", "packages/react/src/components/file-upload.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("fileUploadPage.description")} />

    <p set:html={t("fileUploadPage.anatomyBody")} />
    <ComponentPreview
      html={fileUploadAnatomyHtml(t)}
      css={fileUploadAnatomyCss}
      label={t("fileUploadPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={fileUploadTree(t)} label="FileUpload" viewport="auto" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("fileUploadPage.contractBody")} />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("fileUploadPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
