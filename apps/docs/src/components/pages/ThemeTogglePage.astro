---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { themeToggleTree } from "../../demos/theme-toggle";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/theme-toggle.yaml?raw";
import coreSource from "@core/src/theme-toggle.ts?raw";
import cssSource from "@core/css/components/theme-toggle.css?raw";
import vanillaMountSource from "@vanilla/src/components/theme-toggle.ts?raw";
import vanillaTestSource from "@vanilla/src/components/theme-toggle.test.ts?raw";
import reactSource from "@react/src/components/theme-toggle.tsx?raw";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;

const css = `@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/theme-toggle.css";`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
await initComponents();

// Persistencia (opcional): el enhancer aplica el modo;
// la app guarda la preferencia. La preferencia ya viene
// declarada, ver /almacenamiento.
import { setPreference } from "@skryensya/vanilla/storage";
import { colorModePreference } from "@skryensya/core/theme-toggle";

document.addEventListener("sk-theme-toggle-change", (event) => {
  setPreference(colorModePreference, event.detail.value);
});`;

const sourceFiles = [
  { id: "contracts/semantic/theme-toggle.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/theme-toggle.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/theme-toggle.css", source: cssSource, language: "css" },
  { id: "packages/vanilla/src/components/theme-toggle.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/vanilla/src/components/theme-toggle.test.ts", source: vanillaTestSource, language: "ts" },
  { id: "packages/react/src/components/theme-toggle.tsx", source: reactSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="Theme Toggle"
  description={t("themeTogglePage.description")}
  contractId="theme-toggle"
  styleGroups={[{ file: "components/theme-toggle.css", probe: "sk-theme-toggle" }]}
  sourceFiles={sourceFiles}
  tests={[
    {
      file: "packages/vanilla/src/components/theme-toggle.test.ts",
      tests: [
        {
          name: "mounts once and cycles system → light → dark on click",
          description: t("themeTogglePage.test1"),
        },
        {
          name: "dispatches sk-theme-toggle-change with the new mode",
          description: t("themeTogglePage.test2"),
        },
        { name: "keeps every ThemeToggle in sync when one cycles", description: t("themeTogglePage.test3") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("themeTogglePage.lede")} />
    <ComponentPreview tree={themeToggleTree(t)} js={js} label="Theme Toggle" note={t("themeTogglePage.previewNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("themeTogglePage.contractItem1")} />
      <li set:html={t("themeTogglePage.contractItem2")} />
      <li set:html={t("themeTogglePage.contractItem3")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" lang="css" />
  </Fragment>
</ComponentPageShell>
