---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  codeTree,
  outputTree,
  textAnatomyTree,
  textFeedbackTree,
  textInlineTree,
  textReadingTree,
  textTitleTree,
} from "../../demos/typography";
import { getLocale, useTranslations } from "../../i18n";
import { annotationDemoCss } from "../../demos/annotation";
import "@skryensya/core/components/annotation.css";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="Text"
  description={t("textPage.description")}
  contractId="typography"
  tests={[
    {
      file: "packages/react/src/components/typography.test.tsx",
      tests: [
        { name: "keeps Text semantic and applies its named reading role", description: t("textPage.test1") },
      ],
    },
  ]}
>
  <Fragment slot="anatomy">
    <p set:html={t("textPage.anatomyBody")} />
    <ComponentPreview
      tree={textAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("textPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("textPage.lede")} />

    <h3>{t("textPage.titleBlockTitle")}</h3>
    <p set:html={t("textPage.titleBlockBody")} />
    <ComponentPreview tree={textTitleTree(t)} label={t("textPage.titleBlockLabel")} />

    <h3>{t("textPage.readingTitle")}</h3>
    <p set:html={t("textPage.readingBody")} />
    <ComponentPreview tree={textReadingTree(t)} label={t("textPage.readingLabel")} />

    <h3>{t("textPage.inlineTitle")}</h3>
    <p set:html={t("textPage.inlineBody")} />
    <ComponentPreview tree={textInlineTree(t)} label={t("textPage.inlineLabel")} />

    <h3>{t("textPage.feedbackTitle")}</h3>
    <p set:html={t("textPage.feedbackBody")} />
    <ComponentPreview tree={textFeedbackTree(t)} label={t("textPage.feedbackLabel")} />

    <h3>{t("textPage.codeTitle")}</h3>
    <p set:html={t("textPage.codeBody")} />
    <ComponentPreview tree={codeTree(t)} label={t("textPage.codeLabel")} />

    <h3>{t("textPage.outputTitle")}</h3>
    <p set:html={t("textPage.outputBody")} />
    <ComponentPreview tree={outputTree(t)} label={t("textPage.outputLabel")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("textPage.contractItem1")} />
      <li set:html={t("textPage.contractItem2")} />
      <li set:html={t("textPage.contractItem3")} />
      <li set:html={t("textPage.contractItem4")} />
      <li set:html={t("textPage.contractItem5")} />
      <li set:html={t("textPage.contractItem6")} />
      <li set:html={t("textPage.contractItem7")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
