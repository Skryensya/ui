---
import "@skryensya/core/components/description-list.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
/* The rich row puts a Tag and a Link in the value, and a frame only copies styles THIS page loaded. */
import "@skryensya/core/components/tag.css";
import "@skryensya/core/components/typography.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  descriptionListAnatomyTree,
  descriptionListColumnsTree,
  descriptionListDividedTree,
  descriptionListRichTree,
  descriptionListTree,
  descriptionListDontManyTree,
  descriptionListLongTermsTree,
  descriptionListDontLongTermsTree,
  descriptionListUnitsTree,
  descriptionListDontUnitsTree,
  descriptionListMissingTree,
  descriptionListDontMissingTree,
  descriptionListShortTermsTree,
  descriptionListDontLongLabelTree,
  descriptionListLinkedValueTree,
  descriptionListDontLinkedValueTree,
} from "../../demos/description-list";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const storybookTitle = "Components/Data/DescriptionList";
const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/description-list.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`descriptionListPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="DescriptionList"
  description={t("descriptionListPage.description")}
  contractId="description-list"
  testFiles={["packages/react/src/components/description-list.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("descriptionListPage.lede")} />

    <UsagePreview
      tree={descriptionListTree(t)}
      optionName="layout"
      title={t("descriptionListPage.prop.layout.title")}
      description={t("descriptionListPage.prop.layout.body")}
      explain={explain("layout", ["stacked", "columns"])}
      stageMinBlockSize="14rem"
    />

    <UsagePreview
      tree={descriptionListTree(t)}
      optionName="dividers"
      title={t("descriptionListPage.prop.dividers.title")}
      description={t("descriptionListPage.prop.dividers.body")}
      explain={explain("dividers", ["false", "true"])}
      stageMinBlockSize="14rem"
      labels={{ false: t("descriptionListPage.prop.dividers.falseLabel"), true: t("descriptionListPage.prop.dividers.trueLabel") }}
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={descriptionListTree(t)} title={t("descriptionListPage.basicTitle")} description={t("descriptionListPage.basicBody")} storybookTitle={storybookTitle} storybookStory="Default" />
    <UsagePreview tree={descriptionListColumnsTree(t)} title={t("descriptionListPage.columnsTitle")} description={t("descriptionListPage.columnsBody")} storybookTitle={storybookTitle} storybookStory="Columns" />
    <UsagePreview tree={descriptionListDividedTree(t)} title={t("descriptionListPage.dividedTitle")} description={t("descriptionListPage.dividedBody")} storybookTitle={storybookTitle} storybookStory="Divided" />
    <UsagePreview tree={descriptionListRichTree(t)} title={t("descriptionListPage.richTitle")} description={t("descriptionListPage.richBody")} storybookTitle={storybookTitle} storybookStory="Rich" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "descriptionListPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("descriptionListPage.anatomyBody")} />
    <UsagePreview
      tree={descriptionListAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("descriptionListPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("descriptionListPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "descriptionListPage.when")} avoid={tList(t, "descriptionListPage.whenNot")} />
    <DoDont
      title={t("descriptionListPage.dd.one.title")}
      do={{ tree: descriptionListTree(t), caption: t("descriptionListPage.dd.one.do") }}
      dont={{ tree: descriptionListDontManyTree(t), caption: t("descriptionListPage.dd.one.dont") }}
    />
    <DoDont
      title={t("descriptionListPage.dd.terms.title")}
      do={{ tree: descriptionListLongTermsTree(t), caption: t("descriptionListPage.dd.terms.do") }}
      dont={{ tree: descriptionListDontLongTermsTree(t), caption: t("descriptionListPage.dd.terms.dont") }}
    />
    <DoDont
      title={t("descriptionListPage.dd.units.title")}
      do={{ tree: descriptionListUnitsTree(t), caption: t("descriptionListPage.dd.units.do") }}
      dont={{ tree: descriptionListDontUnitsTree(t), caption: t("descriptionListPage.dd.units.dont") }}
    />
    <DoDont
      title={t("descriptionListPage.dd.missing.title")}
      do={{ tree: descriptionListMissingTree(t), caption: t("descriptionListPage.dd.missing.do") }}
      dont={{ tree: descriptionListDontMissingTree(t), caption: t("descriptionListPage.dd.missing.dont") }}
    />
    <DoDont
      title={t("descriptionListPage.dd.labels.title")}
      do={{ tree: descriptionListShortTermsTree(t), caption: t("descriptionListPage.dd.labels.do") }}
      dont={{ tree: descriptionListDontLongLabelTree(t), caption: t("descriptionListPage.dd.labels.dont") }}
    />
    <DoDont
      title={t("descriptionListPage.dd.links.title")}
      do={{ tree: descriptionListLinkedValueTree(t), caption: t("descriptionListPage.dd.links.do") }}
      dont={{ tree: descriptionListDontLinkedValueTree(t), caption: t("descriptionListPage.dd.links.dont") }}
    />
    <ContentRules items={tList(t, "descriptionListPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("descriptionListPage.a11yIntro")} does={tList(t, "descriptionListPage.a11yDoes")} yours={tList(t, "descriptionListPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
