---
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/table.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  tableAnatomyTree,
  tableInBoxTree,
  tableResizableColumnsTree,
  tableStickyColumnTree,
  tableStickyHeaderTree,
  tableTree,
  tableDensityTree,
  tablePagerTree,
} from "../../demos/table";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
---

<ComponentPageShell
  title="Table"
  description={t("tablePage.description")}
  contractId="table"
  styleGroups={[{ file: "components/table.css", probe: "sk-table" }]}
  tests={[
    {
      file: "packages/react/src/components/table.test.tsx",
      tests: [
        {
          name: "renders the native table structure with every stable part class",
          description: t("tablePage.test1"),
        },
        {
          name: "defaults headers to columns while preserving explicit row scope",
          description: t("tablePage.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tablePage.lede")} />

    <p set:html={t("tablePage.anatomyBody")} />
    <ComponentPreview
      tree={tableAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("tablePage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={tableTree(t)} label="Table" />

    <h3>{t("tablePage.scrollTitle")}</h3>
    <p set:html={t("tablePage.scrollBody")} />

    <h3>{t("tablePage.stickyColTitle")}</h3>
    <p set:html={t("tablePage.stickyColBody")} />
    <ComponentPreview tree={tableStickyColumnTree(t)} label={t("tablePage.stickyColLabel")} />

    <h3>{t("tablePage.stickyHeadTitle")}</h3>
    <p set:html={t("tablePage.stickyHeadBody")} />
    <ComponentPreview tree={tableStickyHeaderTree(t)} label={t("tablePage.stickyHeadLabel")} />

    <h3>{t("tablePage.resizableTitle")}</h3>
    <p set:html={t("tablePage.resizableBody")} />
    <ComponentPreview tree={tableResizableColumnsTree(t)} label={t("tablePage.resizableLabel")} />

    <h3>{t("tablePage.pagerTitle")}</h3>
    <p set:html={t("tablePage.pagerBody")} />
    <ComponentPreview tree={tablePagerTree(t)} label={t("tablePage.pagerLabel")} />

    <h3>{t("tablePage.boxTitle")}</h3>
    <p set:html={t("tablePage.boxBody")} />
    <ComponentPreview tree={tableInBoxTree(t)} label={t("tablePage.boxLabel")} />

    <h3>{t("tablePage.densityTitle")}</h3>
    <p set:html={t("tablePage.densityBody")} />
    <ComponentPreview tree={tableDensityTree(t, 1.2)} label={t("tablePage.densityWideLabel")} />
    <ComponentPreview tree={tableDensityTree(t, 0.6)} label={t("tablePage.densityCompactLabel")} />

    <p set:html={t("tablePage.reactBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
