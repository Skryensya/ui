---
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/table.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  tableAnatomyTree,
  tableDensityTree,
  tableDontListTree,
  tableInBoxTree,
  tableResizableColumnsTree,
  tableStickyColumnTree,
  tableStickyHeaderTree,
  tableTree,
} from "../../demos/table";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
import { tableHeadersDoTree, tableHeadersDontTree } from "../../demos/dodont-more";
---

<ComponentPageShell
  title="Table"
  description={t("tablePage.description")}
  contractId="table"
  testFiles={["packages/react/src/components/table.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("tablePage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={tableTree(t)} title={t("tablePage.basicTitle")} description={t("tablePage.basicBody")} />
    <UsagePreview tree={tableStickyColumnTree(t)} title={t("tablePage.stickyColTitle")} description={t("tablePage.stickyColBody")} />
    <UsagePreview tree={tableStickyHeaderTree(t)} title={t("tablePage.stickyHeadTitle")} description={t("tablePage.stickyHeadBody")} />
    <UsagePreview tree={tableResizableColumnsTree(t)} title={t("tablePage.resizableTitle")} description={t("tablePage.resizableBody")} />
    <UsagePreview tree={tableInBoxTree(t)} title={t("tablePage.boxTitle")} description={t("tablePage.boxBody")} />
    <UsagePreview tree={tableDensityTree(t, 1.2)} title={t("tablePage.densityTitle")} description={t("tablePage.densityBody")} label={t("tablePage.densityWideLabel")} />
    <UsagePreview tree={tableDensityTree(t, 0.6)} label={t("tablePage.densityCompactLabel")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "tablePage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("tablePage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("tablePage.anatomyBody")} />
    <UsagePreview tree={tableAnatomyTree(t)} css={annotationDemoCss} label={t("tablePage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("tablePage.guidelinesLede")} />
    <WhenToUse use={tList(t, "tablePage.when")} avoid={tList(t, "tablePage.whenNot")} />
    <DoDont
      canvas
      title={t("tablePage.dd.data.title")}
      do={{ tree: tableTree(t), caption: t("tablePage.dd.data.do") }}
      dont={{ tree: tableDontListTree(t), caption: t("tablePage.dd.data.dont") }}
    />
    <DoDont
      title={t("dd3.table.title")}
      do={{ tree: tableHeadersDoTree(t), caption: t("dd3.table.do") }}
      dont={{ tree: tableHeadersDontTree(t), caption: t("dd3.table.dont") }}
    />
    <ContentRules items={tList(t, "tablePage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes
      intro={t("tablePage.a11yIntro")}
      does={tList(t, "tablePage.a11yDoes")}
      yours={tList(t, "tablePage.a11yYours")}
      keys={[{ keys: ["←", "→"], action: t("tablePage.key.arrows") }]}
    />
  </Fragment>
</ComponentPageShell>
