---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  stickerAnatomyTree,
  stickerHooksTree,
  stickerOriginsTree,
  stickerPlacementTree,
  stickerTree,
} from "../../demos/sticker";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/sticker.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/layout.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));

/*
 * Page-level app code, not part of the component: the product deciding where the sticker is. It
 * writes `data-state`, which is the whole authored-markup API, so the same script drives both stages.
 */
const placementScript = `
const sticker = document.getElementById("sticker-placement");
for (const button of document.querySelectorAll("[data-sticker-to]")) {
  button.addEventListener("click", () => sticker.setAttribute("data-state", button.dataset.stickerTo));
}
`;

const react = `import { Sticker } from "@skryensya/react/sticker";
import "@skryensya/core/components/sticker.css";

<Sticker src="/badges/early.png" alt="Early supporter" state={earned ? "applied" : "idle"} />

<Sticker state="peeled" peelOrigin="block-start-inline-end">
  <svg role="img" aria-label="Moon" viewBox="0 0 100 100">…</svg>
</Sticker>`;

const html = `<span class="sk-sticker" data-state="idle" data-peel-origin="block-end-inline-end">
  <span class="sk-sticker__art"><img src="/badges/early.png" alt="Early supporter"></span>
  <span class="sk-sticker__flap" aria-hidden="true">
    <span class="sk-sticker__art"><img src="/badges/early.png" alt=""></span>
  </span>
</span>`;

const vanilla = `document.querySelector(".sk-sticker").setAttribute("data-state", "applied");`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`sticker.prop.${option}.${value}` as Parameters<typeof t>[0])]));
import { stickerDoTree, stickerDontTree, stickerShapeDoTree, stickerShapeDontTree } from "../../demos/dodont-pairs";
---

<ComponentPageShell
  title="Sticker"
  description={t("sticker.description")}
  contractId="sticker"
  testFiles={["packages/react/src/components/sticker.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("sticker.lede")} />

    <UsagePreview
      tree={stickerTree(t)}
      optionName="state"
      title={t("sticker.prop.state.title")}
      description={t("sticker.prop.state.body")}
      explain={explain("state", ["idle", "peeled", "applied"])}
      stageMinBlockSize="10rem"
      target={["children", 0]}
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={stickerTree(t)} title={t("sticker.setTitle")} description={t("sticker.setBody")} />
    <UsagePreview tree={stickerPlacementTree(t)} script={placementScript} title={t("sticker.placementHeading")} description={t("sticker.placementIntro")} />
    <UsagePreview tree={stickerOriginsTree(t)} title={t("sticker.originsHeading")} description={t("sticker.originsIntro")} />
    <UsagePreview tree={stickerHooksTree(t)} title={t("sticker.hooksHeading")} description={t("sticker.hooksIntro")} />
    <h4>{t("sticker.reactTitle")}</h4>
    <p set:html={t("sticker.reactBody")} />
    <CodeBlock code={react} label="React" lang="tsx" />
    <h4>{t("sticker.vanillaTitle")}</h4>
    <p set:html={t("sticker.vanillaBody")} />
    <CodeBlock code={html} label="HTML" lang="html" />
    <CodeBlock code={vanilla} label="JavaScript" lang="ts" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "sticker.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("sticker.anatomyBody")} />
    <UsagePreview tree={stickerAnatomyTree(t)} css={annotationDemoCss} label={t("sticker.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("sticker.guidelinesLede")} />
    <WhenToUse use={tList(t, "sticker.when")} avoid={tList(t, "sticker.whenNot")} />
    <DoDont
      title={t("stickerPage.dd.status.title")}
      do={{ tree: stickerDoTree(t), caption: t("stickerPage.dd.status.do") }}
      dont={{ tree: stickerDontTree(t), caption: t("stickerPage.dd.status.dont") }}
    />
    <DoDont
      title={t("stickerPage.dd.shape.title")}
      do={{ tree: stickerShapeDoTree(t), caption: t("stickerPage.dd.shape.do") }}
      dont={{ tree: stickerShapeDontTree(t), caption: t("stickerPage.dd.shape.dont") }}
    />
    <ContentRules items={tList(t, "sticker.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("sticker.a11yIntro")} does={tList(t, "sticker.a11yDoes")} yours={tList(t, "sticker.a11yYours")} />
  </Fragment>
</ComponentPageShell>
