---
/*
 * THE Window page. The demos are usage trees, so each renders in both bindings from one source. The
 * Vanilla stage is its own iframe, which is exactly the viewport a `position: fixed` window needs;
 * the React stage portals to the page, where the window centres on the reader's own screen.
 */
import "@skryensya/core/components/window.css";
import "@skryensya/core/components/table.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import "@skryensya/core/components/annotation.css";
import { windowAnatomyCss, windowAnatomyTree, windowTree } from "../../demos/window";
import windowAnatomyScript from "../../demos/scripts/window-anatomy.ts?raw";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/window.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);`;
import { windowTitleDoTree, windowTitleDontTree, windowBesideDoTree, windowBesideDontTree } from "../../demos/dodont-mocks";
---

<style is:global>
  .sk-do-dont .dd-window {
    display: grid;
    justify-items: start;
    gap: var(--space-stack-xs);
  }

  .sk-do-dont .dd-window__trigger,
  .sk-do-dont .dd-window .sk-window__trigger {
    --sk-button-height: var(--size-control-sm);
  }

  .sk-do-dont .dd-window .sk-window__positioner {
    position: static !important;
    inset: auto !important;
    translate: none !important;
    transform: none !important;
  }

  .sk-do-dont .dd-window .sk-window__content {
    position: relative;
    min-inline-size: 0;
    min-block-size: 0;
  }

  .sk-do-dont .dd-window .sk-window__body {
    min-block-size: 0;
    padding: var(--space-inset-sm);
  }

  .sk-do-dont .dd-window .sk-window__header {
    min-block-size: 2rem;
  }

  .sk-do-dont .dd-window--floating,
  .sk-do-dont .dd-window--dialogish {
    position: absolute;
    z-index: 2;
  }

  .sk-do-dont .dd-window--floating .sk-window__content,
  .sk-do-dont .dd-window--dialogish .sk-window__content {
    inline-size: 14rem !important;
    block-size: 9rem !important;
  }

  .sk-do-dont .dd-window--floating {
    inset-block-start: 2rem;
    inset-inline-end: 1.5rem;
  }

  .sk-do-dont .dd-window--floating .sk-window__trigger,
  .sk-do-dont .dd-window--dialogish .sk-window__trigger {
    display: none;
  }

  .sk-do-dont .dd-window--dialogish {
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
  }
</style>

<ComponentPageShell
  title="Window"
  description={t("windowPage.description")}
  contractId="window"
  styleGroups={[{ file: "components/window.css", probe: "sk-window", title: "Window" }]}
  appearanceTargetSelector=".sk-window__content"
  testFiles={[
    "packages/vanilla/src/components/window.svelte.test.ts",
    "packages/react/src/components/window.test.tsx",
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("windowPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview
      tree={windowTree(t)}
      optionName="resizable"
      title={t("windowPage.resizeTitle")}
      description={t("windowPage.resizeBody")}
      labels={{ true: t("windowPage.enabled"), false: t("windowPage.disabled") }}
      explain={{ true: t("windowPage.freeBody"), false: t("windowPage.fixedBody") }}
      viewport="overlay"
      stageMinBlockSize="24rem"
    />
    <UsagePreview
      tree={windowTree(t)}
      optionName="draggable"
      title={t("windowPage.dragTitle")}
      description={t("windowPage.dragBody")}
      labels={{ true: t("windowPage.enabled"), false: t("windowPage.disabled") }}
      explain={{ true: t("windowPage.dragOn"), false: t("windowPage.dragOff") }}
      viewport="overlay"
      stageMinBlockSize="24rem"
    />
    <UsagePreview
      tree={windowTree(t)}
      optionName="appearance"
      title={t("windowPage.appearanceTitle")}
      description={t("windowPage.appearanceBody")}
      viewport="overlay"
      stageMinBlockSize="24rem"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "windowPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("windowPage.anatomyBody")} />
    <UsagePreview tree={windowAnatomyTree(t)} css={windowAnatomyCss} script={windowAnatomyScript} label={t("windowPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("windowPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "windowPage.when")} avoid={tList(t, "windowPage.whenNot")} />
    <DoDont
      canvas
      title={t("windowPage.dd.title.title")}
      do={{ tree: windowTitleDoTree(t), caption: t("windowPage.dd.title.do") }}
      dont={{ tree: windowTitleDontTree(t), caption: t("windowPage.dd.title.dont") }}
    />
    <DoDont
      canvas
      stacked
      compact
      title={t("windowPage.dd.beside.title")}
      do={{ tree: windowBesideDoTree(t), caption: t("windowPage.dd.beside.do") }}
      dont={{ tree: windowBesideDontTree(t), caption: t("windowPage.dd.beside.dont") }}
    />
    <ContentRules items={tList(t, "windowPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("windowPage.a11yIntro")}
      does={tList(t, "windowPage.a11yDoes")}
      yours={tList(t, "windowPage.a11yYours")}
      keys={[
        { keys: ["←", "→", "↑", "↓"], action: t("window.key.arrows") },
        { keys: ["Esc"], action: t("window.key.escape") },
      ]}
      keysNote={t("window.key.dblclick")}
    />
  </Fragment>
</ComponentPageShell>
