---
/*
 * THE Window page. The demos are usage trees, so each renders in both bindings from one source. The
 * Vanilla stage is its own iframe, which is exactly the viewport a `position: fixed` window needs;
 * the React stage portals to the page, where the window centres on the reader's own screen.
 */
import "@skryensya/core/components/window.css";
import "@skryensya/core/components/table.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import "@skryensya/core/components/annotation.css";
import { windowAnatomyCss, windowAnatomyTree, windowFixedTree, windowTree } from "../../demos/window";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/window.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

mountIcons(document, lucideIcons);`;
import { windowTitleDoTree, windowTitleDontTree, windowBesideDoTree, windowBesideDontTree } from "../../demos/dodont-mocks";
---

<ComponentPageShell
  title="Window"
  description={t("windowPage.description")}
  contractId="window"
  styleGroups={[{ file: "components/window.css", probe: "sk-window", title: "Window" }]}
  appearanceTargetSelector=".sk-window__content"
  testFiles={[
    "packages/vanilla/src/components/window.svelte.test.ts",
    "packages/react/src/components/window.test.tsx",
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("windowPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={windowTree(t)} title={t("windowPage.freeTitle")} description={t("windowPage.freeBody")} viewport="overlay" />
    <UsagePreview tree={windowFixedTree(t)} title={t("windowPage.fixedTitle")} description={t("windowPage.fixedBody")} viewport="overlay" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "windowPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("windowPage.anatomyBody")} />
    <UsagePreview tree={windowAnatomyTree(t)} css={windowAnatomyCss} label={t("windowPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("windowPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "windowPage.when")} avoid={tList(t, "windowPage.whenNot")} />
    <DoDont
      canvas
      title={t("windowPage.dd.title.title")}
      do={{ tree: windowTitleDoTree(t), caption: t("windowPage.dd.title.do") }}
      dont={{ tree: windowTitleDontTree(t), caption: t("windowPage.dd.title.dont") }}
    />
    <DoDont
      canvas
      title={t("windowPage.dd.beside.title")}
      do={{ tree: windowBesideDoTree(t), caption: t("windowPage.dd.beside.do") }}
      dont={{ tree: windowBesideDontTree(t), caption: t("windowPage.dd.beside.dont") }}
    />
    <ContentRules items={tList(t, "windowPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("windowPage.a11yIntro")}
      does={tList(t, "windowPage.a11yDoes")}
      yours={tList(t, "windowPage.a11yYours")}
      keys={[
        { keys: ["←", "→", "↑", "↓"], action: t("window.key.arrows") },
        { keys: ["Esc"], action: t("window.key.escape") },
      ]}
      keysNote={t("window.key.dblclick")}
    />
  </Fragment>
</ComponentPageShell>
