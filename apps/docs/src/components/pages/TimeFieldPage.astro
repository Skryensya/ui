---
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/time-field.css";
import "@skryensya/core/patterns/anchored.css";
import "@skryensya/core/components/select.css";
import "@skryensya/core/patterns/scrollbar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  timeFieldDoCycleTree,
  timeFieldDontCycleTree,
  timeFieldForced24Tree,
  timeFieldNativeTree,
  timeFieldQuarterHourTree,
  timeFieldTree,
} from "../../demos/time-field";
import { getLocale, tList, useTranslations } from "../../i18n";

const styles = `@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/time-field.css";
@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/select.css";
/* The dropdown always scrolls (48 rows at the default step): the rail is painted by the pattern,
   marked with sk-scrollbar on the picker's own listbox. */
@import "@skryensya/core/patterns/scrollbar.css";`;

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`timeFieldPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="TimeField"
  description={t("timeFieldPage.description")}
  contractId="time-field"
  appearanceTargetSelector=".sk-time-field"
  styleGroups={[
    { file: "components/time-field.css", probe: "sk-time-field", title: "TimeField" },
    { file: "components/button.css", probe: "sk-button", title: "Heredados de Button" },
  ]}
  testFiles={["packages/vanilla/src/components/time-field.svelte.test.ts"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("timeFieldPage.lede")} />

    <UsagePreview
      tree={timeFieldDoCycleTree(t)}
      optionName="hourCycle"
      title={t("timeFieldPage.prop.hourCycle.title")}
      description={t("timeFieldPage.prop.hourCycle.body")}
      explain={explain("hourCycle", ["h12", "h24"])}
      stageMinBlockSize="9rem"
      labels={{ h12: "12 h", h24: "24 h" }}
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={timeFieldTree(t, { locale: "es-DO", name: "salida" })} title={t("timeFieldPage.basicTitle")} description={t("timeFieldPage.basicBody")} viewport="menu" />
    <UsagePreview tree={timeFieldForced24Tree(t, { locale: "es", name: "llegada" })} title={t("timeFieldPage.forced24Title")} description={t("timeFieldPage.forced24Body")} viewport="menu" />
    <UsagePreview tree={timeFieldQuarterHourTree(t, { locale: "es", name: "reunion" })} title={t("timeFieldPage.optionsTitle")} description={t("timeFieldPage.optionsBody")} viewport="menu" />
    {/* The native fallback goes last: the exit for a reader who found everything above too much.
        `measure` matches `--sk-time-field-inline-size`, since `.sk-input` fills its container. */}
    <UsagePreview tree={timeFieldNativeTree(t, { name: "inicio" })} title={t("timeFieldPage.nativeTitle")} description={t("timeFieldPage.nativeBody")} measure="12rem" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "timeFieldPage.contract").map((item) => <li set:html={item} />)}
    </ul>

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("timeFieldPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "timeFieldPage.when")} avoid={tList(t, "timeFieldPage.whenNot")} />
    <DoDont
      title={t("timeFieldPage.dd.cycle.title")}
      do={{ tree: timeFieldDoCycleTree(t), caption: t("timeFieldPage.dd.cycle.do") }}
      dont={{ tree: timeFieldDontCycleTree(t), caption: t("timeFieldPage.dd.cycle.dont") }}
    />
    <ContentRules items={tList(t, "timeFieldPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("timeFieldPage.a11yIntro")}
      does={tList(t, "timeFieldPage.a11yDoes")}
      yours={tList(t, "timeFieldPage.a11yYours")}
      keys={[
        { keys: ["↑", "↓"], action: t("timeFieldPage.key.arrows") },
        { keys: ["←", "→"], action: t("timeFieldPage.key.move") },
        { keys: ["0–9"], action: t("timeFieldPage.key.digits") },
        { keys: ["Alt+↓"], action: t("timeFieldPage.key.open") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
