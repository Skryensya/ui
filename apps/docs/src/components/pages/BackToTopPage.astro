---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  backToTopAnatomyCss,
  backToTopAnatomyTree,
  backToTopDemoCss,
  backToTopScrollTree,
  backToTopTree,
} from "../../demos/back-to-top";
import { getLocale, useTranslations } from "../../i18n";
/* The sheet itself, not only its source: the Style hooks table resolves each hook against a real
   element, and a page that never loads this stylesheet shows every value blank. */
import "@skryensya/core/components/back-to-top.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/back-to-top.css";`;

const html = `<button class="sk-back-to-top sk-interactive" type="button" data-sk-back-to-top hidden>
  <span class="sk-back-to-top__icon" aria-hidden="true">
    <span data-sk-icon="chevron-up" data-sk-icon-size="sm"></span>
  </span>
  <span class="sk-back-to-top__label">Volver arriba</span>
</button>`;

/* The `target` half, which is the one nobody remembers: it moves FOCUS after the scroll so the next
   Tab starts from the top. The destination has to be focusable itself. */
const htmlTarget = `<button
  class="sk-back-to-top sk-interactive"
  type="button"
  data-sk-back-to-top
  data-threshold="600"
  data-target="#top"
  hidden
>
  <span class="sk-back-to-top__icon" aria-hidden="true">
    <span data-sk-icon="chevron-up" data-sk-icon-size="sm"></span>
  </span>
  <span class="sk-back-to-top__label">Volver arriba</span>
</button>
…
<h1 id="top" tabindex="-1">…</h1>`;

const react = `import { BackToTop } from "@skryensya/react/back-to-top";

// window scroller, focus moves to the heading up top
<BackToTop threshold={600} target="#top">Volver arriba</BackToTop>

// an inner overflow pane instead of the window
<BackToTop scroller="#panel">Volver arriba</BackToTop>`;

/* The labelled-pill escape hatch: the accessible name is already right, this only un-clips it. */
const pill = `.mi-back-to-top {
  --sk-back-to-top-size: auto;
  padding-inline: var(--space-inset-md);
}
.mi-back-to-top .sk-back-to-top__label {
  position: static;
  inline-size: auto;
  block-size: auto;
  clip-path: none;
}`;
---

<ComponentPageShell
  title="BackToTop"
  description={t("backToTop.description")}
  badge={t("backToTop.betaBadge")}
  contractId="back-to-top"
  styleGroups={[{ file: "components/back-to-top.css", probe: "sk-back-to-top", title: "BackToTop" }]}
  tests={[
    {
      file: "packages/react/src/components/back-to-top.test.tsx",
      tests: [
        {
          name: "renders hidden, and names the control from its children once shown",
          description: t("backToTop.test1"),
        },
        {
          name: "reveals once scrolled past the threshold and hides again above it",
          description: t("backToTop.test2"),
        },
        {
          name: "returns the window to the top on click, smoothly by default",
          description: t("backToTop.test3"),
        },
        {
          name: "jumps instantly when the reader prefers reduced motion",
          description: t("backToTop.test4"),
        },
        {
          name: "moves focus to `target` after scrolling, without a second scroll",
          description: t("backToTop.test5"),
        },
        {
          name: "acts on a named inner scroller instead of the window",
          description: t("backToTop.test6"),
        },
        {
          name: "still calls a consumer's onClick, and lets it opt out of the scroll",
          description: t("backToTop.test7"),
        },
      ],
    },
    {
      file: "packages/vanilla/src/components/back-to-top.test.ts",
      tests: [
        { name: "reveals at or past the threshold, never before", description: t("backToTop.test8") },
        { name: "shows from the first pixel when the threshold is 0", description: t("backToTop.test9") },
        {
          name: "treats a broken threshold as the default, not as always- or never-on",
          description: t("backToTop.test10"),
        },
        { name: "never reveals on a non-finite scroll position", description: t("backToTop.test11") },
        {
          name: "parses data-threshold, falling back to the default on empty or unparseable input",
          description: t("backToTop.test12"),
        },
        {
          name: "animates the scroll unless the reader asked for less motion",
          description: t("backToTop.test13"),
        },
        {
          name: "stays hidden below the threshold and reveals once past it",
          description: t("backToTop.test14"),
        },
        { name: "honours a custom data-threshold", description: t("backToTop.test15") },
        {
          name: "returns the window to the top on click, smoothly by default",
          description: t("backToTop.test16"),
        },
        {
          name: "jumps instantly when the reader prefers reduced motion",
          description: t("backToTop.test17"),
        },
        {
          name: "moves focus to `target` after the scroll, without starting a second one",
          description: t("backToTop.test18"),
        },
        {
          name: "acts on a named inner scroller instead of the window",
          description: t("backToTop.test19"),
        },
        { name: "stops syncing once cleaned up", description: t("backToTop.test20") },
        { name: "mounts once per authored root", description: t("backToTop.test21") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("backToTop.lede")} />

    <p set:html={t("backToTop.anatomyBody")} />
    <ComponentPreview
      tree={backToTopAnatomyTree(t)}
      css={backToTopAnatomyCss}
      label={t("backToTop.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <h3>{t("backToTop.whenTitle")}</h3>
    <p set:html={t("backToTop.whenBody1")} />
    <p set:html={t("backToTop.whenBody2")} />

    <h3>{t("backToTop.demoStaticTitle")}</h3>
    <p set:html={t("backToTop.demoStaticBody")} />
    <ComponentPreview
      tree={backToTopTree(t)}
      css={backToTopDemoCss}
      label={t("backToTop.demoStaticLabel")}
      minHeight="9rem"
      screens={false}
    />

    <h3>{t("backToTop.demoScrollTitle")}</h3>
    <p set:html={t("backToTop.demoScrollBody")} />
    {/*
      `measure` IS WHAT GIVES THIS DEMO SOMETHING TO SCROLL. Measured at the stage's full width, the
      three paragraphs stack to 296px inside a 288px frame: 8px of travel against a 96px threshold,
      so the button could never appear and the card silently showed nothing. Capped to a reading
      column they wrap tall enough for the reveal to actually happen.
    */}
    <ComponentPreview
      tree={backToTopScrollTree(t)}
      css={backToTopDemoCss}
      label={t("backToTop.demoScrollLabel")}
      note={t("backToTop.demoScrollHint")}
      scroll
      minHeight="18rem"
      measure="30rem"
      screens={false}
    />

    <h3>{t("backToTop.behaviorTitle")}</h3>
    <p set:html={t("backToTop.behaviorBody1")} />
    <p set:html={t("backToTop.behaviorBody2")} />

    <h3>{t("backToTop.optionsTitle")}</h3>
    <p set:html={t("backToTop.optionsBody")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("backToTop.contractItem1")} />
      <li set:html={t("backToTop.contractItem2")} />
      <li set:html={t("backToTop.contractItem3")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />

    <h4>{t("backToTop.htmlTitle")}</h4>
    <CodeBlock code={html} label="HTML" lang="html" />

    <h4>{t("backToTop.targetTitle")}</h4>
    <p set:html={t("backToTop.targetBody")} />
    <CodeBlock code={htmlTarget} label="HTML" lang="html" />
    <CodeBlock code={react} label="React" lang="tsx" />

    <h4>{t("backToTop.pillTitle")}</h4>
    <p set:html={t("backToTop.pillBody")} />
    <CodeBlock code={pill} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("backToTop.a11yP1")} />
    <p set:html={t("backToTop.a11yP2")} />
  </Fragment>
</ComponentPageShell>
