---
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import {
  imageFrameAnatomyTree,
  imageFrameAspectTree,
  imageFrameFitTree,
  imageFramePositionTree,
  imageFrameSingleTree,
  imageFrameTree,
} from "../../demos/image-frame";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/patterns/image-frame.css";
import "@skryensya/core/patterns/media-gradient.css";

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/patterns/image-frame.css";
/* or patterns/layout.css, which already includes it */`;

const t = useTranslations(getLocale(Astro.url));

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`imageFrame.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="ImageFrame"
  description={t("imageFrame.description")}
  contractId="image-frame"
  appearanceTargetSelector=".sk-image-frame"
  testFiles={["packages/react/src/components/image-frame.test.tsx"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable"), frosted: t("prefs.appearanceFrostedUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("imageFrame.lede")} />

    <UsagePreview
      tree={imageFrameSingleTree(t)}
      optionName="aspect"
      title={t("imageFrame.prop.aspect.title")}
      description={t("imageFrame.prop.aspect.body")}
      explain={explain("aspect", ["auto", "1/1", "4/3", "3/2", "16/9", "3/4", "2/3", "9/16"])}
      stageMinBlockSize="26rem"
    />

    <UsagePreview
      tree={imageFrameSingleTree(t)}
      optionName="radius"
      title={t("imageFrame.prop.radius.title")}
      description={t("imageFrame.prop.radius.body")}
      explain={explain("radius", ["none", "top", "control", "surface", "pill"])}
      stageMinBlockSize="26rem"
    />

    <h3>{t("imageFrame.showcaseTitle")}</h3>
    <p set:html={t("imageFrame.showcaseBody")} />
    <UsagePreview tree={imageFrameTree(t)} />

    <h3>{t("imageFrame.aspectTitle")}</h3>
    <p set:html={t("imageFrame.aspectBody")} />
    <UsagePreview tree={imageFrameAspectTree(t)} />

    <h3>{t("imageFrame.fitTitle")}</h3>
    <p set:html={t("imageFrame.fitBody")} />
    <UsagePreview tree={imageFrameFitTree(t)} />

    <h3>{t("imageFrame.positionTitle")}</h3>
    <p set:html={t("imageFrame.positionBody")} />
    <UsagePreview tree={imageFramePositionTree(t)} />

    <p set:html={t("imageFrame.reactBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("imageFrame.contractItem1")} />
      <li set:html={t("imageFrame.contractItem2")} />
      <li set:html={t("imageFrame.contractItem3")} />
      <li set:html={t("imageFrame.contractItem4")} />
      <li set:html={t("imageFrame.contractItem5")} />
      <li set:html={t("imageFrame.contractItem6")} />
      <li set:html={t("imageFrame.contractItem7")} />
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("imageFrame.anatomyBody")} />
    <ComponentPreview
      tree={imageFrameAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("imageFrame.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("imageFrame.guidelinesLede")} />
    <ul>
      <li set:html={t("imageFrame.guide.use1")} />
      <li set:html={t("imageFrame.guide.use2")} />
      <li set:html={t("imageFrame.guide.use3")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" />
  </Fragment>
</ComponentPageShell>
