---
/* The anatomy diagram is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import { annotationDemoCss } from "../../demos/annotation";
import { stackAnatomyTree } from "../../demos/layout-anatomy";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import { stackTree, stackScaleSpecimenTree } from "../../demos/layout";
import { getLocale, useTranslations } from "../../i18n";
import { variantsTree } from "../../demos/variants";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`stackPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Stack"
  description={t("stackPage.description")}
  contractId="layout"
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        {
          name: "renders Stack, Inline and Grid as the documented layout contracts",
          description: t("stackPage.test1"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("stackPage.lede")} />

    <UsagePreview
      tree={stackTree(t, "/components/stack")}
      optionName="align"
      title={t("stackPage.prop.align.title")}
      description={t("stackPage.prop.align.body")}
      explain={explain("align", ["start", "center", "end", "stretch"])}
      stageMinBlockSize="16rem"
    />

    <h3>{t("stackPage.showcaseTitle")}</h3>
    <p set:html={t("stackPage.showcaseBody")} />
    <UsagePreview tree={stackTree(t, "/components/stack")} title="Stack" description={t("stackPage.htmlBody")} />

    <h3>{t("stackPage.htmlTitle")}</h3>
    <p set:html={t("stackPage.htmlBody")} />

    <p set:html={t("stackPage.reactBody")} />
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("stackPage.contractItem1")} />
      <li set:html={t("stackPage.contractItem2")} />
      <li set:html={t("stackPage.contractItem3")} />
      <li set:html={t("stackPage.contractItem4")} />
    </ul>

    <UsagePreview
      tree={variantsTree(stackScaleSpecimenTree(t), [{ label: "none", options: { gap: "none" } }, { label: "xs", options: { gap: "xs" } }, { label: "sm", options: { gap: "sm" } }, { label: "md", options: { gap: "md" } }, { label: "lg", options: { gap: "lg" } }, { label: "xl", options: { gap: "xl" } }], [], "3")}
      title={t("component.scaleTitle", { option: "gap" })}
      description={t("component.scaleBody")}
    />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("stackPage.anatomyBody")} />
    <ComponentPreview
      tree={stackAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("stackPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("stackPage.guidelinesLede")} />
    <DoDont
      title={t("stackPage.dd.axis.title")}
      do={{ tree: stackTree(t, "/components/stack"), caption: t("stackPage.dd.axis.do") }}
      dont={{ tree: stackTree(t, "/components/stack"), caption: t("stackPage.dd.axis.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
