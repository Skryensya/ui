---
import "@skryensya/core/components/split-button.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/components/menu.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import {
  splitButtonAnatomyTree,
  splitButtonTree,
  splitButtonSmallTree,
  splitButtonMenuFirstTree,
  splitButtonSubtleTree,
  splitButtonTranslucentTree,
  splitButtonGhostTree,
  splitButtonDangerTree,
} from "../../demos/split-button";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/split-button.css";
@import "@skryensya/core/components/menu.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/patterns/layout.css";`;
const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;
---

<ComponentPageShell
  title="SplitButton"
  description={t("splitButtonPage.description")}
  contractId="split-button"
  styleGroups={[
    { file: "components/split-button.css", probe: "sk-split-button", title: "SplitButton" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
  ]}
  tests={[
    {
      file: "packages/react/src/components/split-button.test.tsx",
      tests: [
        {
          name: "renders a labelled group holding the action button and the menu's icon-only trigger",
          description: t("splitButtonPage.testReact1"),
        },
        {
          name: "clicking the action button fires onClick, independent of the menu",
          description: t("splitButtonPage.testReact2"),
        },
        {
          name: "opens the fallback menu from its trigger and selects an item",
          description: t("splitButtonPage.testReact3"),
        },
        {
          name: "disables both the action button and the menu trigger together",
          description: t("splitButtonPage.testReact4"),
        },
        {
          name: "pairs the fallback trigger's shape and variant/size with the action button",
          description: t("splitButtonPage.testReact6"),
        },
        {
          name: "renders a hand-composed action and menu verbatim instead of the flat-prop fallback",
          description: t("splitButtonPage.testReact5"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("splitButtonPage.description")} />

    <p set:html={t("splitButtonPage.anatomyBody")} />
    <ComponentPreview
      tree={splitButtonAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("splitButtonPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={splitButtonTree(t)} js={js} label="SplitButton" viewport="menu" />

    <h3>{t("splitButtonPage.smallTitle")}</h3>
    <p set:html={t("splitButtonPage.smallBody")} />
    <ComponentPreview
      tree={splitButtonSmallTree(t)}
      js={js}
      label={t("splitButtonPage.smallLabel")}
      viewport="menu"
    />

    <h3>{t("splitButtonPage.menuFirstTitle")}</h3>
    <p set:html={t("splitButtonPage.menuFirstBody")} />
    <ComponentPreview
      tree={splitButtonMenuFirstTree(t)}
      js={js}
      label={t("splitButtonPage.menuFirstLabel")}
      viewport="menu"
    />

    <h3>{t("splitButtonPage.subtleTitle")}</h3>
    <p set:html={t("splitButtonPage.subtleBody")} />
    <ComponentPreview
      tree={splitButtonSubtleTree(t)}
      js={js}
      label={t("splitButtonPage.subtleLabel")}
      viewport="menu"
    />

    <h3>{t("splitButtonPage.translucentTitle")}</h3>
    <p set:html={t("splitButtonPage.translucentBody")} />
    <ComponentPreview
      tree={splitButtonTranslucentTree(t)}
      js={js}
      label={t("splitButtonPage.translucentLabel")}
      viewport="menu"
    />

    <h3>{t("splitButtonPage.ghostTitle")}</h3>
    <p set:html={t("splitButtonPage.ghostBody")} />
    <ComponentPreview
      tree={splitButtonGhostTree(t)}
      js={js}
      label={t("splitButtonPage.ghostLabel")}
      viewport="menu"
    />

    <h3>{t("splitButtonPage.dangerTitle")}</h3>
    <p set:html={t("splitButtonPage.dangerBody")} />
    <ComponentPreview
      tree={splitButtonDangerTree(t)}
      js={js}
      label={t("splitButtonPage.dangerLabel")}
      viewport="menu"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("splitButtonPage.contractBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("splitButtonPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
