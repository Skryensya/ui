---
import "@skryensya/core/components/split-button.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/components/menu.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  splitButtonAnatomyTree,
  splitButtonTree,
  splitButtonVerticalBySize,
  splitButtonSmallTree,
  splitButtonSubtleTree,
  splitButtonOverMediaTree,
  splitButtonGhostTree,
  splitButtonDangerTree,
} from "../../demos/split-button";
import { annotationDemoCss } from "../../demos/annotation";

import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/split-button.css";
@import "@skryensya/core/components/menu.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/patterns/layout.css";`;
import { splitButtonDoTree, splitButtonDontTree, splitButtonSingleDoTree, splitButtonSingleDontTree } from "../../demos/dodont-pairs";
---

<ComponentPageShell
  title="SplitButton"
  description={t("splitButtonPage.description")}
  contractId="split-button"
  appearanceTargetSelector=".sk-split-button .sk-button"
  styleGroups={[
    { file: "components/split-button.css", probe: "sk-split-button", title: "SplitButton" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
  ]}
  testFiles={["packages/react/src/components/split-button.test.tsx"]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("splitButtonPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <h4>{t("splitButtonPage.mainTitle")}</h4>
    <UsagePreview tree={splitButtonTree(t)} description={t("splitButtonPage.mainBody")} label={t("splitButtonPage.mainTitle")} viewport="menu" />
    <h4>{t("splitButtonPage.verticalTitle")}</h4>
    <UsagePreview
      variants={[
        { value: "xs", label: "xs", tree: splitButtonVerticalBySize("xs")(t) },
        { value: "sm", label: "sm", tree: splitButtonVerticalBySize("sm")(t) },
        { value: "md", label: "md", tree: splitButtonVerticalBySize("md")(t) },
        { value: "lg", label: "lg", tree: splitButtonVerticalBySize("lg")(t) },
      ]}
      initialVariant="sm"
      variantsLabel={t("splitButtonPage.verticalTitle")}
      description={t("splitButtonPage.verticalBody")}
      label={t("splitButtonPage.verticalTitle")}
    />
    <h4>{t("splitButtonPage.smallTitle")}</h4>
    <UsagePreview tree={splitButtonSmallTree(t)} description={t("splitButtonPage.smallBody")} label={t("splitButtonPage.smallTitle")} viewport="menu" />
    <h4>{t("splitButtonPage.subtleTitle")}</h4>
    <UsagePreview tree={splitButtonSubtleTree(t)} description={t("splitButtonPage.subtleBody")} label={t("splitButtonPage.subtleTitle")} viewport="menu" />
    <h4>{t("splitButtonPage.overMediaTitle")}</h4>
    <UsagePreview tree={splitButtonOverMediaTree(t)} description={t("splitButtonPage.overMediaBody")} label={t("splitButtonPage.overMediaTitle")} viewport="menu" />
    <h4>{t("splitButtonPage.ghostTitle")}</h4>
    <UsagePreview tree={splitButtonGhostTree(t)} description={t("splitButtonPage.ghostBody")} label={t("splitButtonPage.ghostTitle")} viewport="menu" />
    <h4>{t("splitButtonPage.dangerTitle")}</h4>
    <UsagePreview tree={splitButtonDangerTree(t)} description={t("splitButtonPage.dangerBody")} label={t("splitButtonPage.dangerTitle")} viewport="menu" />
    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "splitButtonPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("splitButtonPage.anatomyBody")} />
    <UsagePreview
      tree={splitButtonAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("splitButtonPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("splitButtonPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "splitButtonPage.when")} avoid={tList(t, "splitButtonPage.whenNot")} />
    <DoDont
      title={t("splitButtonPage.dd.label.title")}
      do={{ tree: splitButtonDoTree(t), caption: t("splitButtonPage.dd.label.do") }}
      dont={{ tree: splitButtonDontTree(t), caption: t("splitButtonPage.dd.label.dont") }}
    />
    <DoDont
      title={t("splitButtonPage.dd.single.title")}
      do={{ tree: splitButtonSingleDoTree(t), caption: t("splitButtonPage.dd.single.do") }}
      dont={{ tree: splitButtonSingleDontTree(t), caption: t("splitButtonPage.dd.single.dont") }}
    />
    <ContentRules items={tList(t, "splitButtonPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("splitButtonPage.a11yIntro")}
      does={tList(t, "splitButtonPage.a11yDoes")}
      yours={tList(t, "splitButtonPage.a11yYours")}
      keys={[
        { keys: ["Tab"], action: t("splitButtonPage.key.tab") },
        { keys: ["Enter", t("component.key.space")], action: t("splitButtonPage.key.run") },
        { keys: ["↑", "↓"], action: t("splitButtonPage.key.arrows") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
