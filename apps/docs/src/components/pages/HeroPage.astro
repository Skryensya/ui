---
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { heroDontActionsTree } from "../../demos/layout-guide";
import {
  heroAppBadgesTree,
  heroAudienceTabsTree,
  heroCenteredTree,
  heroCodePreviewTree,
  heroEmailCaptureTree,
  heroEyebrowTree,
  heroLogoWallTree,
  heroPricingToggleTree,
  heroSocialProofTree,
  heroSplitTree,
  heroTestimonialTree,
  heroTree,
  heroVideoDemoTree,
} from "../../demos/layout";
import { getLocale, tList, useTranslations } from "../../i18n";
import { heroAnatomyTree, layoutAnatomyFillCss } from "../../demos/layout-anatomy";
import "@skryensya/core/components/annotation.css";
/* The sheet itself, not only its source: the Style hooks table resolves each hook
   against a real element, and a page that never loads `patterns/hero.css` would show every
   value blank. */
import "@skryensya/core/patterns/hero.css";
/*
 * `avatar.css`, for the social-proof pattern's own `AvatarGroup`. Confirmed live as the ROOT CAUSE
 * of an earlier "the CSS looks broken" report: this page's `stat`-based pattern rendered every
 * number with zero styling because `components/stat.css` was never imported here either. Docs
 * curates its CSS per page (the same convention `BoxPage.astro` follows for `patterns/box.css`), so
 * every family a page's own demo trees actually use has to be imported by hand: there is no global
 * bundle to fall back on silently supplying it.
 */
import "@skryensya/core/components/avatar.css";
/* `wrapper.css`, for the `Wrapper` shell every pattern below composes its content inside now. */
import "@skryensya/core/patterns/wrapper.css";
/* `patterns/box.css`, for the email-capture pattern's own full-width highlighted band. */
import "@skryensya/core/patterns/box.css";
/*
 * The remaining patterns after the original five each pull in one more family's own CSS: `form-
 * field`/`input` (email capture), `segmented` (pricing toggle), `code-preview` (developer hero)
 * and `tabs` (audience switch). Same rule as `avatar.css` above: every family a page's own demo
 * trees actually use has to be imported by hand here, or it paints unstyled the same way the old
 * stat-row pattern once did.
 */
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/components/code-preview.css";
import "@skryensya/core/components/tabs.css";
/* `patterns/icon.css`, for the audience-tabs pattern's own feature rows (a leading `Icon` beside
   each line). */
import "@skryensya/core/patterns/icon.css";

const t = useTranslations(getLocale(Astro.url));

/*
 * Thirteen real patterns, all valid against the same minimal contract: the same range an agent
 * reaches via `get_examples` (`contracts/examples/fixed/hero-*.ts`), shown here so a person sees it too
 * instead of only reading it in prose. The `label` prop on each `ComponentPreview` stays a literal
 * pattern name, not translated (the same reason `component.contractNotesTitle`'s own list items
 * stay close to the contract's own vocabulary), but each pattern ALSO gets its own translated
 * `<h4>` title and one-line description right above its card: `Base.astro`'s own document indexer
 * walks `h3`/`h4` inside this "usage" panel (`lib/document-index.ts`'s `indexHeroTabPanel`, `depth
 * === 0` only, so these headings sit as direct siblings here, never nested in another wrapper) and
 * an `h4` is what surfaces as a NESTED row under "HTML escrito a mano" in the page's own "En esta
 * página" rail, one entry per pattern instead of the rail knowing only that section exists.
 *
 * A `search` and a `command-hint` pattern were tried and dropped: reported back as not earning
 * their place in this catalogue, not a bug in either.
 */
const heroPitchTree = heroTree(t);
const heroCenteredMinimalTree = heroCenteredTree(t);
const heroEyebrowLabelTree = heroEyebrowTree(t);
const heroSplitMediaTree = heroSplitTree(t);
const heroProofTree = heroSocialProofTree(t);
const heroEmailTree = heroEmailCaptureTree(t);
const heroAppTree = heroAppBadgesTree(t);
const heroLogosTree = heroLogoWallTree(t);
const heroPricingTree = heroPricingToggleTree(t);
const heroCodeTree = heroCodePreviewTree(t);
const heroVideoTree = heroVideoDemoTree(t);
const heroTabsTree = heroAudienceTabsTree(t);
const heroQuoteTree = heroTestimonialTree(t);

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`hero.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Hero"
  description={t("hero.description")}
  contractId="hero"
  appearanceTargetSelector=".sk-hero"
  styleGroups={[{ file: "patterns/hero.css", probe: "sk-hero" }]}
  tests={[
    {
      file: "packages/react/src/components/layout.test.tsx",
      tests: [
        {
          name: "renders Hero as a plain div with its documented defaults",
          description: t("hero.test1"),
        },
        {
          name: "lets Hero change align/padding/surface and render as a different element via `as`",
          description: t("hero.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("hero.lede")} />

    <UsagePreview
      tree={heroTree(t)}
      optionName="align"
      title={t("hero.prop.align.title")}
      description={t("hero.prop.align.body")}
      explain={explain("align", ["start", "center"])}
      stageMinBlockSize="20rem"
    />

    <UsagePreview
      tree={heroTree(t)}
      optionName="surface"
      title={t("hero.prop.surface.title")}
      description={t("hero.prop.surface.body")}
      explain={explain("surface", ["none", "sunken", "surface", "raised"])}
      stageMinBlockSize="20rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={heroPitchTree} title={t("hero.patternPitchTitle")} description={t("hero.patternPitchDescription")} />
    <UsagePreview tree={heroCenteredMinimalTree} title={t("hero.patternCenteredTitle")} description={t("hero.patternCenteredDescription")} />
    <UsagePreview tree={heroEyebrowLabelTree} title={t("hero.patternEyebrowTitle")} description={t("hero.patternEyebrowDescription")} />
    <UsagePreview tree={heroSplitMediaTree} title={t("hero.patternSplitTitle")} description={t("hero.patternSplitDescription")} />
    <UsagePreview tree={heroProofTree} title={t("hero.patternProofTitle")} description={t("hero.patternProofDescription")} />
    <UsagePreview tree={heroEmailTree} title={t("hero.patternEmailTitle")} description={t("hero.patternEmailDescription")} />
    <UsagePreview tree={heroAppTree} title={t("hero.patternAppBadgesTitle")} description={t("hero.patternAppBadgesDescription")} />
    <UsagePreview tree={heroLogosTree} title={t("hero.patternLogoWallTitle")} description={t("hero.patternLogoWallDescription")} />
    <UsagePreview tree={heroPricingTree} title={t("hero.patternPricingTitle")} description={t("hero.patternPricingDescription")} />
    <UsagePreview tree={heroCodeTree} title={t("hero.patternCodePreviewTitle")} description={t("hero.patternCodePreviewDescription")} />
    <UsagePreview tree={heroVideoTree} title={t("hero.patternVideoDemoTitle")} description={t("hero.patternVideoDemoDescription")} />
    <UsagePreview tree={heroTabsTree} title={t("hero.patternAudienceTabsTitle")} description={t("hero.patternAudienceTabsDescription")} />
    <UsagePreview tree={heroQuoteTree} title={t("hero.patternTestimonialTitle")} description={t("hero.patternTestimonialDescription")} />
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "hero.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("hero.anatomyBody")} />
    <UsagePreview tree={heroAnatomyTree(t)} css={layoutAnatomyFillCss} label={t("hero.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("hero.guidelinesLede")} />
    <WhenToUse use={tList(t, "hero.when")} avoid={tList(t, "hero.whenNot")} />
    <DoDont
      canvas
      title={t("hero.dd.actions.title")}
      do={{ tree: heroTree(t), caption: t("hero.dd.actions.do") }}
      dont={{ tree: heroDontActionsTree(t), caption: t("hero.dd.actions.dont") }}
    />
    <ContentRules items={tList(t, "hero.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("hero.a11yIntro")} does={tList(t, "hero.a11yDoes")} yours={tList(t, "hero.a11yYours")} />
  </Fragment>
</ComponentPageShell>
