---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { copyButtonTree } from "../../demos/copy-button";
import { getLocale, useTranslations } from "../../i18n";
import contractSource from "@contracts/semantic/copy-button.yaml?raw";
import coreSource from "@core/src/copy-button.ts?raw";
import cssSource from "@core/css/components/copy-button.css?raw";
import vanillaMountSource from "@vanilla/src/components/copy-button.ts?raw";
import vanillaTestSource from "@vanilla/src/components/copy-button.test.ts?raw";
import reactSource from "@react/src/components/copy-button.tsx?raw";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const css = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/button.css";
@import "@skryensya/core/components/copy-button.css";`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

// ${t("copyButton.iconsComment").split("\n").join("\n// ")}
mountIcons(document, lucideIcons);
await initComponents();`;

const sourceFiles = [
  { id: "contracts/semantic/copy-button.yaml", source: contractSource, language: "yaml" },
  { id: "packages/core/src/copy-button.ts", source: coreSource, language: "ts" },
  { id: "packages/core/css/components/copy-button.css", source: cssSource, language: "css" },
  { id: "packages/vanilla/src/components/copy-button.ts", source: vanillaMountSource, language: "ts" },
  { id: "packages/vanilla/src/components/copy-button.test.ts", source: vanillaTestSource, language: "ts" },
  { id: "packages/react/src/components/copy-button.tsx", source: reactSource, language: "tsx" },
] as const;
---

<ComponentPageShell
  title="CopyButton"
  description={t("copyButton.description")}
  contractId="copy-button"
  sourceFiles={sourceFiles}
  styleGroups={[{ file: "components/copy-button.css", probe: "sk-copy-button" }]}
  tests={[
    {
      file: "packages/vanilla/src/components/copy-button.test.ts",
      tests: [
        { name: "copies its authored target, announces success and resets", description: t("copyButton.test1") },
        { name: "names the anchor tying one button to its own flag", description: t("copyButton.test2") },
        { name: "reports an authored target that does not exist", description: t("copyButton.test3") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("copyButton.lede")} />
    <ComponentPreview tree={copyButtonTree(t)} js={js} label="CopyButton" note={t("copyButton.previewNote")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      <li set:html={t("copyButton.contractItem1")} />
      <li set:html={t("copyButton.contractItem2")} />
      <li set:html={t("copyButton.contractItem3")} />
      <li set:html={t("copyButton.contractItem4")} />
      <li set:html={t("copyButton.contractItem5")} />
      <li set:html={t("copyButton.contractItem6")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" lang="css" />
  </Fragment>
</ComponentPageShell>
