---
/*
 * UserSelect's page: its own contract (`userSelectContract`), so the shell renders Referencia and
 * Cambios, and the anatomy opens Referencia like every other family's. Estilo lists its own sheet and
 * the ones it composes; Tests reads the two real files written for both bindings.
 */
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/combobox.css";
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/user-select.css";
/* The anatomy diagram's own sheets: the specimen is annotated in place. */
import "@skryensya/core/components/canvas.css";
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  userSelectJs,
  userSelectListen,
  userSelectLoadingTree,
  userSelectMultipleTree,
  userSelectTree,
} from "../../demos/user-select";

import { getLocale, tList, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const reactSource = `<UserSelect
  users={users}
  value={value}
  onValueChange={setValue}
  term="${t("userSelectPage.label.term")}"${
    t("userSelectPage.label.term") === "users"
      ? ""
      : `
  labels={{
    placeholder: "${t("userSelectPage.label.placeholder")}",
    count: "${t("userSelectPage.label.count")}",
    selectedCount: "${t("userSelectPage.label.selectedCount")}",
    clear: "${t("userSelectPage.label.clear")}",
    // ...every key in userSelectLabels
  }}`
  }
/>`;
import { userSelectEmailDoTree, userSelectEmailDontTree, userSelectNameDoTree, userSelectNameDontTree } from "../../demos/dodont-mocks";
---

<ComponentPageShell
  hookPlayground={{ tree: userSelectTree(t) }}
  title="UserSelect"
  description={t("userSelectPage.description")}
  contractId="user-select"
  badge="Beta"
  extraSheets={[
    "@skryensya/core/patterns/anchored.css",
    "@skryensya/core/components/select.css",
    "@skryensya/core/components/combobox.css",
    "@skryensya/core/components/avatar.css",
    "@skryensya/core/components/checkbox.css",
  ]}
  vanillaInstallSteps={[
    {
      title: t("install.stepMount"),
      blocks: [
        { kind: "html", html: t("userSelectPage.explicitMountNote") },
        { kind: "code", code: userSelectJs, lang: "ts", label: "JavaScript" },
      ],
    },
    { title: t("userSelectPage.listenTitle"), blocks: [{ kind: "code", code: userSelectListen, lang: "ts", label: "JavaScript" }] },
  ]}
  styleGroups={[
    { file: "components/user-select.css", probe: "sk-select", title: "UserSelect" },
    { file: "components/select.css", probe: "sk-select", title: "Select" },
    { file: "components/combobox.css", probe: "sk-combobox", title: "Combobox" },
    { file: "components/avatar.css", probe: "sk-avatar", title: "Avatar" },
    { file: "components/checkbox.css", probe: "sk-checkbox", title: "Checkbox" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
  ]}
  testFiles={["packages/react/src/components/user-select.test.tsx", "packages/vanilla/src/components/user-select.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("userSelectPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <h3>{t("userSelectPage.basicTitle")}</h3>
    <p set:html={t("userSelectPage.basicBody")} />
    <UsagePreview tree={userSelectTree(t)} label="UserSelect" viewport="menu-deep" storybookTitle="Components/UserSelect" storybookStory="Default" />

    <h3>{t("userSelectPage.statesTitle")}</h3>
    <p set:html={t("userSelectPage.statesBody")} />
    <UsagePreview tree={userSelectMultipleTree(t)} label="UserSelect (multiple)" viewport="menu" storybookTitle="Components/UserSelect" storybookStory="Multiple" />
    <UsagePreview tree={userSelectLoadingTree(t)} label="UserSelect (loading)" viewport="menu" storybookTitle="Components/UserSelect" storybookStory="Loading" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "userSelectPage.contract").map((item) => <li set:html={item} />)}
    </ul>

  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("userSelectPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "userSelectPage.when")} avoid={tList(t, "userSelectPage.whenNot")} />
    <DoDont
      canvas
      title={t("userSelectPage.dd.email.title")}
      do={{ tree: userSelectEmailDoTree(t), caption: t("userSelectPage.dd.email.do") }}
      dont={{ tree: userSelectEmailDontTree(t), caption: t("userSelectPage.dd.email.dont") }}
    />
    <DoDont
      canvas
      title={t("userSelectPage.dd.name.title")}
      do={{ tree: userSelectNameDoTree(t), caption: t("userSelectPage.dd.name.do") }}
      dont={{ tree: userSelectNameDontTree(t), caption: t("userSelectPage.dd.name.dont") }}
    />
    <ContentRules items={tList(t, "userSelectPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("userSelectPage.a11yIntro")}
      does={tList(t, "userSelectPage.a11yDoes")}
      yours={tList(t, "userSelectPage.a11yYours")}
      keys={[
        { keys: ["Enter", t("component.key.space")], action: t("userSelectPage.key.open") },
        { keys: ["↑", "↓"], action: t("userSelectPage.key.arrows") },
        { keys: ["Enter"], action: t("userSelectPage.key.enter") },
        { keys: ["Esc"], action: t("userSelectPage.key.escape") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
