---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  badgeDoAccentOnceTree,
  badgeDoAnchoredDotTree,
  badgeDoCountTree,
  badgeDoWordsTree,
  badgeDontAccentAllTree,
  badgeDontColorOnlyTree,
  badgeDontCountTree,
  badgeDontLoneDotTree,
  badgeDoBesideTree,
  badgeDoPulseTree,
  badgeDoShortTree,
  badgeDoToneTree,
  badgeDontControlTree,
  badgeDontLongTree,
  badgeDontPulseTree,
  badgeDontToneTree,
} from "../../demos/badge";
import { badgeAnatomyCss, badgeAnatomyTree, badgeHoldersTree, badgeLabelTree, badgeLoneDotTree, badgeTagTree } from "../../demos/badge";
import { getLocale, useTranslations } from "../../i18n";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;

/*
 * PILOT (see ADR/plan on delegating per-example source to Storybook): every "kind" below is exactly
 * what each storybook app's own generate-stories.ts computes for this page's demos
 * (Components, then the catalog group in English, then the label - here "Components/Content/Badge",
 * read off `lib/navigation.ts`'s own catalog), so this one constant is the only place that can drift
 * from the generator. Each `storybookStory` name matches its tree's generated story export 1:1:
 * unlike the hand-written `tree` this page used to keep locally, every preview below now points at a
 * demo module export so the generator actually sees it and a story exists to link to.
 */
const storybookTitle = "Components/Content/Badge";

/* What each value of a property is for, read from this page's messages: `badge.prop.<option>.<value>`. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`badge.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Badge"
  description={t("badge.description")}
  contractId="badge"
  untitledCode
  testFiles={["packages/react/src/components/badge.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("badge.lede")} />

    <UsagePreview
      tree={badgeLabelTree(t)}
      optionName="tone"
      title={t("badge.prop.tone.title")}
      description={t("badge.prop.tone.body")}
      explain={explain("tone", ["neutral", "accent", "success", "warning", "danger"])}
      stageMinBlockSize="8rem"
      storybookTitle={storybookTitle}
      storybookStory="Label"
    />

    <UsagePreview
      tree={badgeLabelTree(t)}
      optionName="size"
      title={t("badge.prop.size.title")}
      description={t("badge.prop.size.body")}
      explain={explain("size", ["sm", "md"])}
      labels={{ sm: "sm", md: "md" }}
      stageMinBlockSize="8rem"
      storybookTitle={storybookTitle}
      storybookStory="Label"
    />

    <UsagePreview
      tree={badgeLabelTree(t)}
      optionName="appearance"
      title={t("badge.prop.appearance.title")}
      description={t("badge.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist"])}
      stageMinBlockSize="8rem"
      storybookTitle={storybookTitle}
      storybookStory="Label"
    />

    <UsagePreview
      tree={badgeLoneDotTree(t)}
      optionName="pulse"
      title={t("badge.prop.pulse.title")}
      description={t("badge.prop.pulse.body")}
      explain={explain("pulse", ["false", "true"])}
      labels={{ false: t("badge.prop.pulse.falseLabel"), true: t("badge.prop.pulse.trueLabel") }}
      stageMinBlockSize="8rem"
      storybookTitle={storybookTitle}
      storybookStory="LoneDot"
    />

    <UsagePreview
      tree={badgeTagTree(t)}
      title={t("badge.tagTitle")}
      description={t("badge.tagBody")}
      storybookTitle={storybookTitle}
      storybookStory="Tag"
    />

    <UsagePreview
      tree={badgeHoldersTree(t)}
      title={t("badge.cornerTitle")}
      description={t("badge.cornerBody")}
      storybookTitle={storybookTitle}
      storybookStory="Holders"
    />

    <p set:html={t("component.reactNote")} />

    {/* The anatomy closes the Overview, not the Reference tab: first what Badge is and how it looks, then its parts by name. */}
    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("badge.anatomyBody")} />
    <ComponentPreview
      tree={badgeAnatomyTree(t)}
      css={badgeAnatomyCss}
      label={t("badge.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede">{t("badge.dd.lede")}</p>
    <DoDont
      title={t("badge.dd.tone.title")}
      do={{ tree: badgeDoToneTree(t), caption: t("badge.dd.tone.do") }}
      dont={{ tree: badgeDontToneTree(t), caption: t("badge.dd.tone.dont") }}
    />
    <DoDont
      title={t("badge.dd.short.title")}
      do={{ tree: badgeDoShortTree(t), caption: t("badge.dd.short.do") }}
      dont={{ tree: badgeDontLongTree(t), caption: t("badge.dd.short.dont") }}
    />
    <DoDont
      title={t("badge.dd.control.title")}
      do={{ tree: badgeDoBesideTree(t), caption: t("badge.dd.control.do") }}
      dont={{ tree: badgeDontControlTree(t), caption: t("badge.dd.control.dont") }}
    />
    <DoDont
      title={t("badge.dd.accent.title")}
      do={{ tree: badgeDoAccentOnceTree(t), caption: t("badge.dd.accent.do") }}
      dont={{ tree: badgeDontAccentAllTree(t), caption: t("badge.dd.accent.dont") }}
    />
    <DoDont
      title={t("badge.dd.words.title")}
      do={{ tree: badgeDoWordsTree(t), caption: t("badge.dd.words.do") }}
      dont={{ tree: badgeDontColorOnlyTree(t), caption: t("badge.dd.words.dont") }}
    />
    <DoDont
      title={t("badge.dd.count.title")}
      do={{ tree: badgeDoCountTree(t), caption: t("badge.dd.count.do") }}
      dont={{ tree: badgeDontCountTree(t), caption: t("badge.dd.count.dont") }}
    />
    <DoDont
      title={t("badge.dd.anchored.title")}
      do={{ tree: badgeDoAnchoredDotTree(t), caption: t("badge.dd.anchored.do") }}
      dont={{ tree: badgeDontLoneDotTree(t), caption: t("badge.dd.anchored.dont") }}
    />
    <DoDont
      title={t("badge.dd.pulse.title")}
      do={{ tree: badgeDoPulseTree(t), caption: t("badge.dd.pulse.do") }}
      dont={{ tree: badgeDontPulseTree(t), caption: t("badge.dd.pulse.dont") }}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} lang="bash" />
  </Fragment>
</ComponentPageShell>
