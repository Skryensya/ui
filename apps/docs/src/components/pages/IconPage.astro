---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { iconSizeTree, iconTree } from "../../demos/icon";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const vanilla = `<!-- Geometry outside the set: you write it. -->
<svg
  class="sk-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  aria-hidden="true"
  focusable="false"
>
  <path d="M6 9l6 6 6-6" />
</svg>`;

const vanillaHydrate = `<!-- You write the role's name, not the <svg>. -->
<span data-sk-icon="chevron-down"></span>
<span data-sk-icon="close" data-sk-icon-label="Cerrar"></span>`;

const vanillaBind = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// replaces every [data-sk-icon] with the set's <svg>. The
// set is explicit.
mountIcons(document, lucideIcons);`;

const reactApi = `import { Icon } from "@skryensya/react/icon";

// no configuration: it draws with Phosphor, the default set
<Icon name="chevron-down" />
{/* a system role */}
<Icon name="close" label="Cerrar" />
{/* means something on its own → role="img" */}
<Icon data={sparkle} />
{/* outside the set, the only opt-in part */}`;

const provider = `import { IconSetProvider, Icon } from "@skryensya/react/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// another set? you bind it once, at the root, just like
// choosing a brand
<IconSetProvider set={lucideIcons}>
  <App />
</IconSetProvider>;`;

const sizesCss = `/* another size? you re-declare the hook, like every
   arbitrary value in the system */
.hero .sk-icon { --sk-icon-size: 2rem; }`;
---

<ComponentPageShell
  title="Icon"
  description={t("iconPage.description")}
  contractId="icon"
  tests={[
    {
      file: "packages/react/src/components/icon.test.tsx",
      tests: [
        { name: "resolves a stable name against the bound set", description: t("iconPage.test1") },
        { name: "renders project geometry without any binding", description: t("iconPage.test2") },
        { name: "is decorative without a label, and content with one", description: t("iconPage.test3") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("iconPage.lede")} />
    <ComponentPreview tree={iconTree} label="Icon" />

    <h3>{t("iconPage.reactTitle")}</h3>
    <p set:html={t("iconPage.reactBody1")} />
    <CodeBlock code={reactApi} label="React" note={t("iconPage.reactNote")} />
    <p set:html={t("iconPage.reactBody2")} />
    <CodeBlock code={provider} label={t("iconPage.providerLabel")} note={t("iconPage.providerNote")} />

    <h3>{t("iconPage.vanillaTitle")}</h3>
    <p set:html={t("iconPage.vanillaBody1")} />
    <CodeBlock code={vanillaHydrate} label="HTML" note={t("iconPage.vanillaHydrateNote")} />
    <CodeBlock code={vanillaBind} label={t("iconPage.vanillaBindLabel")} note={t("iconPage.vanillaBindNote")} />
    <p set:html={t("iconPage.vanillaBody2")} />
    <CodeBlock code={vanilla} label={t("iconPage.vanillaRawLabel")} note={t("iconPage.vanillaRawNote")} />

    <h3>{t("iconPage.sizeTitle")}</h3>
    <p set:html={t("iconPage.sizeBody")} />
    <ComponentPreview tree={iconSizeTree} label={t("iconPage.sizeLabel")} />
    <CodeBlock code={sizesCss} label="tamaño arbitrario" note={t("iconPage.sizeNote")} />
  </Fragment>

  <Fragment slot="a11y">
    <ul>
      <li set:html={t("iconPage.a11yItem1")} />
      <li set:html={t("iconPage.a11yItem2")} />
      <li set:html={t("iconPage.a11yItem3")} />
      <li set:html={t("iconPage.a11yItem4")} />
    </ul>
  </Fragment>
</ComponentPageShell>
