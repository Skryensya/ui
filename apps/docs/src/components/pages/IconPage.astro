---
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { annotationDemoCss } from "../../demos/annotation";
import {
  iconAnatomyTree,
  iconDoSizeTree,
  iconDoStatusTree,
  iconDirectionExampleTree,
  iconDoTextTree,
  iconDoToneTree,
  iconDontSizeTree,
  iconDontStatusTree,
  iconDontTextTree,
  iconDontToneTree,
  iconSingleTree,
  iconSizesExampleTree,
  iconStatusExampleTree,
  iconTree,
} from "../../demos/icon";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/annotation.css";
/* Icon examples use small labelled cards to explain role names. */
import "@skryensya/core/patterns/box.css";

const t = useTranslations(getLocale(Astro.url));
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`iconPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));

const vanilla = `<!-- Geometry outside the set: you write it. -->
<svg
  class="sk-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  aria-hidden="true"
  focusable="false"
>
  <path d="M6 9l6 6 6-6" />
</svg>`;

const vanillaHydrate = `<!-- You write the role's name, not the <svg>. -->
<span data-sk-icon="chevron-down"></span>
<span data-sk-icon="close" data-sk-icon-label="Cerrar"></span>`;

const vanillaBind = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// replaces every [data-sk-icon] with the set's <svg>. The
// set is explicit.
mountIcons(document, lucideIcons);`;

const reactApi = `import { Icon } from "@skryensya/react/icon";

// no configuration: it draws with Lucide, the default set
<Icon name="chevron-down" />
{/* a system role */}
<Icon name="close" label="Cerrar" />
{/* means something on its own → role="img" */}
<Icon data={sparkle} />
{/* outside the set, the only opt-in part */}`;

const provider = `import { IconSetProvider, Icon } from "@skryensya/react/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// another set? you bind it once, at the root, just like
// choosing a brand
<IconSetProvider set={lucideIcons}>
  <App />
</IconSetProvider>;`;

const sizesCss = `/* another size? you re-declare the hook, like every
   arbitrary value in the system */
.hero .sk-icon { --sk-icon-size: 2rem; }`;
---

<ComponentPageShell
  title="Icon"
  description={t("iconPage.description")}
  contractId="icon"
  testFiles={["packages/react/src/components/icon.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("iconPage.lede")} />

    <UsagePreview
      tree={iconSingleTree}
      optionName="size"
      title={t("iconPage.prop.size.title")}
      description={t("iconPage.prop.size.body")}
      explain={explain("size", ["sm", "md", "lg"])}
      stageMinBlockSize="7rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={iconTree(t)} title={t("iconPage.vocabularyTitle")} description={t("iconPage.vocabularyBody")} stageMinBlockSize="18rem" />
    <UsagePreview tree={iconSizesExampleTree(t)} title={t("iconPage.sizeExamplesTitle")} description={t("iconPage.sizeExamplesBody")} stageMinBlockSize="18rem" />
    <UsagePreview tree={iconStatusExampleTree(t)} title={t("iconPage.statusExamplesTitle")} description={t("iconPage.statusExamplesBody")} stageMinBlockSize="18rem" />
    <UsagePreview tree={iconDirectionExampleTree(t)} title={t("iconPage.directionExamplesTitle")} description={t("iconPage.directionExamplesBody")} stageMinBlockSize="18rem" />

    <h3>{t("iconPage.reactTitle")}</h3>
    <p set:html={t("iconPage.reactBody1")} />
    <CodeBlock code={reactApi} label="React" note={t("iconPage.reactNote")} />
    <p set:html={t("iconPage.reactBody2")} />
    <CodeBlock code={provider} label={t("iconPage.providerLabel")} note={t("iconPage.providerNote")} />

    <h3>{t("iconPage.vanillaTitle")}</h3>
    <p set:html={t("iconPage.vanillaBody1")} />
    <CodeBlock code={vanillaHydrate} label="HTML" note={t("iconPage.vanillaHydrateNote")} />
    <CodeBlock code={vanillaBind} label={t("iconPage.vanillaBindLabel")} note={t("iconPage.vanillaBindNote")} />
    <p set:html={t("iconPage.vanillaBody2")} />
    <CodeBlock code={vanilla} label={t("iconPage.vanillaRawLabel")} note={t("iconPage.vanillaRawNote")} />

    <h3>{t("iconPage.customSizeTitle")}</h3>
    <p set:html={t("iconPage.customSizeBody")} />
    <CodeBlock code={sizesCss} label={t("iconPage.customSizeLabel")} note={t("iconPage.sizeNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("iconPage.anatomyBody")} />
    <UsagePreview tree={iconAnatomyTree(t)} css={annotationDemoCss} label={t("iconPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("iconPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "iconPage.when")} avoid={tList(t, "iconPage.whenNot")} />
    <DoDont
      title={t("iconPage.dd.text.title")}
      do={{ tree: iconDoTextTree(t), caption: t("iconPage.dd.text.do") }}
      dont={{ tree: iconDontTextTree, caption: t("iconPage.dd.text.dont") }}
    />
    <DoDont
      title={t("iconPage.dd.size.title")}
      do={{ tree: iconDoSizeTree(t), caption: t("iconPage.dd.size.do") }}
      dont={{ tree: iconDontSizeTree(t), caption: t("iconPage.dd.size.dont") }}
    />
    <DoDont
      title={t("iconPage.dd.status.title")}
      do={{ tree: iconDoStatusTree(t), caption: t("iconPage.dd.status.do") }}
      dont={{ tree: iconDontStatusTree, caption: t("iconPage.dd.status.dont") }}
    />
    <DoDont
      title={t("iconPage.dd.tone.title")}
      do={{ tree: iconDoToneTree(t), caption: t("iconPage.dd.tone.do") }}
      dont={{ tree: iconDontToneTree(t), caption: t("iconPage.dd.tone.dont") }}
    />
    <ContentRules items={tList(t, "iconPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("iconPage.a11yIntro")} does={tList(t, "iconPage.a11yDoes")} yours={tList(t, "iconPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
