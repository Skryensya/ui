---
import "@skryensya/core/components/navbar.css";
import "@skryensya/core/patterns/nav-list.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/avatar.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import AppearanceMenu from "../AppearanceMenu.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import { navbarAnatomyTree, navbarAppTree, navbarBareCss, navbarBareTree, navbarTree } from "../../demos/navbar";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const t = useTranslations(getLocale(Astro.url));

const hrefs = { home: "/", projects: "/proyectos", reports: "/reportes", team: "/equipo" };

const css = `@import "@skryensya/core/tokens.scss";
@import "@skryensya/core/components/navbar.css";
@import "@skryensya/core/patterns/nav-list.css";`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`navbarPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Navbar"
  description={t("navbarPage.description")}
  contractId="navbar"
  appearanceTargetSelector=".sk-navbar"
  testFiles={["packages/react/src/components/navbar.test.tsx"]}}
>
  <Fragment slot="appearance">
    <AppearanceMenu label={t("prefs.appearance")} values={["plain", "brutalist", "frosted"]} unavailable={{ tactile: t("prefs.appearanceTactileUnavailable") }} />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("navbarPage.lede")} />

    <UsagePreview
      tree={navbarBareTree(t, hrefs)}
      optionName="appearance"
      title={t("navbarPage.prop.appearance.title")}
      description={t("navbarPage.prop.appearance.body")}
      explain={explain("appearance", ["plain", "brutalist", "frosted"])}
      stageMinBlockSize="7rem"
    />

    <h3>{t("navbarPage.showcaseTitle")}</h3>
    <p set:html={t("navbarPage.showcaseBody")} />
    <h3>{t("navbarPage.linksTitle")}</h3>
    <p set:html={t("navbarPage.linksBody")} />
    <ComponentPreview
      tree={navbarTree(t, {
        home: "/",
        projects: "/proyectos",
        reports: "/reportes",
        team: "/equipo",
      })}
      label="Navbar"
      flush
      minHeight="10rem"
      zoomedDesktop
    />

    <h3>{t("navbarPage.bareTitle")}</h3>
    <p set:html={t("navbarPage.bareBody")} />
    <ComponentPreview
      tree={navbarBareTree(t, hrefs)}
      css={navbarBareCss}
      label={t("navbarPage.bareTitle")}
      flush
      minHeight="10rem"
      zoomedDesktop
    />

    <h3>{t("navbarPage.appTitle")}</h3>
    <p set:html={t("navbarPage.appBody")} />
    <ComponentPreview
      tree={navbarAppTree(t, hrefs)}
      label={t("navbarPage.appTitle")}
      flush
      minHeight="10rem"
      zoomedDesktop
    />

    <h3>{t("navbarPage.currentTitle")}</h3>
    <p set:html={t("navbarPage.currentBody")} />

    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("navbarPage.anatomyBody")} />
    <ComponentPreview
      tree={navbarAnatomyTree(t, {
        home: "/",
        projects: "/proyectos",
        reports: "/reportes",
        team: "/equipo",
      })}
      css={annotationDemoCss}
      label={t("navbarPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("navbarPage.guidelinesLede")} />
    <ul>
      <li set:html={t("navbarPage.guide.use1")} />
      <li set:html={t("navbarPage.guide.avoid1")} />
      <li set:html={t("navbarPage.guide.avoid2")} />
    </ul>
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={css} label="CSS" />
  </Fragment>
</ComponentPageShell>
