---
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/canvas.css";
import "@skryensya/core/components/process-list.css";
import "@skryensya/core/components/diagram.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import "@skryensya/core/components/annotation.css";
import { canvasAnatomyTree, canvasDiagramCss, canvasDiagramTree, canvasDontFitsTree } from "../../demos/canvas";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/react`;
const styles = `@import "@skryensya/core/components/canvas.css";`;
const html = `<div class="sk-canvas" data-sk-canvas aria-label="Flujo de publicación" role="group">
  <div class="sk-canvas__viewport" tabindex="0">
    <div class="sk-canvas__content">
      <!-- un diagrama, plano o anatomía estático -->
    </div>
  </div>
  <!-- controles y avisos los emite el árbol -->
</div>`;
const react = `import { Canvas } from "@skryensya/react/canvas";

<Canvas label="Flujo de publicación">
  <PublicationDiagram />
</Canvas>`;
const storybookTitle = "Components/Content/Canvas";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`canvas.prop.${option}.${value}` as Parameters<typeof t>[0])]));
const hooks = `.mi-canvas {
  --sk-canvas-max-block-size: 34rem;
  --sk-canvas-viewport-bg: var(--color-bg-canvas);
  --sk-canvas-grid-size: 20px;
  --sk-canvas-grid-color: color-mix(
    in oklab, var(--color-border-subtle) 35%, transparent
  );
}`;
---

<ComponentPageShell
  title="Canvas"
  description={t("canvas.description")}
  contractId="canvas"
  testFiles={["packages/core/src/canvas.test.ts", "packages/vanilla/src/components/canvas.test.ts", "packages/react/src/components/canvas.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("canvas.lede")} />

    <UsagePreview
      tree={canvasDiagramTree(t)}
      optionName="fitOnly"
      title={t("canvas.prop.fitOnly.title")}
      description={t("canvas.prop.fitOnly.body")}
      explain={explain("fitOnly", ["false", "true"])}
      css={canvasDiagramCss}
      storybookTitle={storybookTitle}
      storybookStory="Diagram"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview
      tree={canvasDiagramTree(t)}
      title={t("canvas.demoTitle")}
      description={t("canvas.demoBody")}
      css={canvasDiagramCss}
      storybookTitle={storybookTitle}
      storybookStory="Diagram"
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "canvas.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("canvas.anatomyBody")} />
    <UsagePreview tree={canvasAnatomyTree(t)} css={annotationDemoCss} label={t("canvas.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("canvas.guidelinesLede")} />
    <WhenToUse use={tList(t, "canvas.when")} avoid={tList(t, "canvas.whenNot")} />
    <DoDont
      title={t("canvas.dd.fit.title")}
      do={{ tree: canvasDiagramTree(t), caption: t("canvas.dd.fit.do") }}
      dont={{ tree: canvasDontFitsTree(t), caption: t("canvas.dd.fit.dont") }}
    />
    <ContentRules items={tList(t, "canvas.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <CodeBlock code={styles} label="CSS" lang="css" />
    <CodeBlock code={html} label="HTML" lang="html" />
    <CodeBlock code={react} label="React" lang="tsx" />

    <h4>{t("canvas.cssTitle")}</h4>
    <p set:html={t("canvas.cssBody")} />
    <CodeBlock code={hooks} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("canvas.a11yIntro")}
      does={tList(t, "canvas.a11yDoes")}
      yours={tList(t, "canvas.a11yYours")}
      keys={[
        { keys: ["+", "-"], action: t("canvas.a11yKeyZoom") },
        { keys: ["0"], action: t("canvas.a11yKeyFit") },
        { keys: ["←", "→", "↑", "↓"], action: t("canvas.a11yKeyArrows") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
