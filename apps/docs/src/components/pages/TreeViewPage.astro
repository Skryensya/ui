---
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/tree-view.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  treeViewAnatomyTree,
  treeViewDisabledTree,
  treeViewDontFlatTree,
  treeViewEventsScript,
  treeViewEventsTree,
  treeViewInitialTree,
  treeViewMinimalTree,
  treeViewMultipleTree,
} from "../../demos/tree-view";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `@import "@skryensya/core/components/tree-view.css";`;

const indentHook = `.sk-tree-view {
  /* One level wider and roomier rows, and without the vertical guides. */
  --sk-tree-indent: var(--space-inset-xl);
  --sk-tree-row-inset: var(--space-inset-sm);
  --sk-tree-guide-color: transparent;
}`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`treeViewPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="TreeView"
  description={t("treeViewPage.description")}
  contractId="tree-view"
  styleGroups={[
    { file: "components/tree-view.css", probe: "sk-tree-view", title: "TreeView" },
    { file: "patterns/state-layer.css", probe: "sk-interactive", title: "Heredados de State layer" },
  ]}
  testFiles={["packages/vanilla/src/components/tree-view.test.ts", "packages/react/src/components/tree-view.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("treeViewPage.lede")} />

    <UsagePreview
      tree={treeViewInitialTree(t)}
      optionName="selectionMode"
      title={t("treeViewPage.prop.selectionMode.title")}
      description={t("treeViewPage.prop.selectionMode.body")}
      explain={explain("selectionMode", ["single", "multiple"])}
      stageMinBlockSize="16rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={treeViewMinimalTree(t)} title={t("treeViewPage.minimalTitle")} description={t("treeViewPage.minimalBody")} />
    <UsagePreview tree={treeViewInitialTree(t)} title={t("treeViewPage.initialTitle")} description={t("treeViewPage.initialBody")} />
    <UsagePreview tree={treeViewMultipleTree(t)} title={t("treeViewPage.multipleTitle")} description={t("treeViewPage.multipleBody")} />
    <UsagePreview tree={treeViewDisabledTree(t)} title={t("treeViewPage.disabledTitle")} description={t("treeViewPage.disabledBody")} />
    <UsagePreview tree={treeViewEventsTree(t)} script={treeViewEventsScript} title={t("treeViewPage.eventsTitle")} description={t("treeViewPage.eventsBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "treeViewPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("treeViewPage.anatomyBody")} />
    <UsagePreview
      tree={treeViewAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("treeViewPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("treeViewPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "treeViewPage.when")} avoid={tList(t, "treeViewPage.whenNot")} />
    <DoDont
      title={t("treeViewPage.dd.nested.title")}
      do={{ tree: treeViewMinimalTree(t), caption: t("treeViewPage.dd.nested.do") }}
      dont={{ tree: treeViewDontFlatTree(t), caption: t("treeViewPage.dd.nested.dont") }}
    />
    <ContentRules items={tList(t, "treeViewPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="CSS" lang="css" />
    <p set:html={t("treeViewPage.hooksBody")} />
    <CodeBlock code={indentHook} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("treeViewPage.a11yIntro")}
      does={tList(t, "treeViewPage.a11yDoes")}
      yours={tList(t, "treeViewPage.a11yYours")}
      keys={[
        { keys: ["↑", "↓"], action: t("treeViewPage.key.updown") },
        { keys: ["→"], action: t("treeViewPage.key.right") },
        { keys: ["←"], action: t("treeViewPage.key.left") },
        { keys: [t("component.key.home"), t("component.key.end")], action: t("treeViewPage.key.homeEnd") },
        { keys: ["Enter", t("component.key.space")], action: t("treeViewPage.key.select") },
      ]}
    />
  </Fragment>
</ComponentPageShell>
