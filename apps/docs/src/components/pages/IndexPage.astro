---
/*
 * The component CATALOG, not a component's own page: one List per component type, linking out to every
 * migrated page, so `ComponentPageShell`'s tabs (Uso/Instalación/Referencia…) do not apply. There
 * is no single "usage" to tab into. What carries over for visual consistency with the pages this
 * links to is only the hero header block itself (eyebrow + h1), used here directly rather than
 * through the shell, with no tab strip underneath it.
 */
import "@skryensya/core/components/list.css";
import Base from "../../layouts/Base.astro";
import CommandPalette from "../CommandPalette.astro";
import { getLocale, useTranslations } from "../../i18n";
import { iconMarkup } from "../../icons";
import { getComponentDescription } from "../../lib/component-catalog";
import { componentIconMarkup } from "../../lib/component-icons";
import { getNavigation } from "../../lib/navigation";

const locale = getLocale(Astro.url);
const componentSection = getNavigation(locale).find((section) => section.id === "components");
if (!componentSection) throw new Error("Missing components navigation section");

const searchIcon = iconMarkup("search");
const t = useTranslations(locale);

/*
 * THIS PAGE'S SEARCH IS THE CATALOGUE'S, not the site's. The chrome's ⌘K palette still indexes every
 * documentation destination and is a keystroke away; a reader who came here and typed into the box
 * labelled "Buscar componentes" is asking about components, so the palette behind it indexes exactly
 * what the lists below hold. The components navigation section, and nothing from guides or ADRs.
 * `!todo` mirrors the site index: an entry with no page behind it is not a destination.
 */
const componentSearchIndex = componentSection.groups.flatMap((group) =>
  group.items
    .filter((item) => !item.todo)
    .map((item) => ({
      label: item.label,
      aliases: item.aliases ?? [],
      href: item.href,
      /* Section is constant here, so the context line carries the group alone: "Formularios" beside
       * a result says something the page's own heading does not repeat. */
      context: group.group,
    })),
);

---

<Base title={t("indexPage.title")} description={t("indexPage.description")} documentLayout="grid">
  <header class="docs-component-hero">
    <h1>{t("indexPage.title")}</h1>
  </header>

  <p class="lede" set:html={t("indexPage.lede")} />

  {/*
    Opens the catalogue's OWN palette (`docs-cmdk-components`), not the chrome's: `aria-controls` is
    what the enhancer reads to decide which triggers belong to which dialog, so pointing it here is
    the whole scoping mechanism. No ⌘K badge and no `aria-keyshortcuts` either. That shortcut still
    belongs to the site-wide palette, and this button is not it.
  */}
  <button
    class="sk-button sk-interactive docs-catalog-search"
    data-variant="ghost"
    type="button"
    aria-controls="docs-cmdk-components"
    aria-expanded="false"
    data-sk-command-palette-open
  >
    <Fragment set:html={searchIcon} />
    <span class="docs-catalog-search__label">{t("indexPage.searchLabel")}</span>
  </button>

  <CommandPalette
    slot="palette"
    id="docs-cmdk-components"
    entries={componentSearchIndex}
    label={t("search.componentsDialog")}
    placeholder={t("search.componentsPlaceholder")}
  />

  {/*
    ONE BOX PER GROUP, flowing as two columns (`.docs-catalog-groups`, site.css). The boxes are
    layout, not content, so both carry `data-toc-transparent`: `indexDocument()` reads a heading
    inside them as a section of the page and the rail keeps every group.
  */}
  <div class="docs-catalog-groups" data-toc-transparent>
    {
      componentSection.groups.map((group, groupIndex) => {
        const headingId = `catalog-group-${groupIndex}`;

        return (
          <section class="docs-catalog-section" aria-labelledby={headingId} data-toc-transparent>
            <h2 class="docs-catalog-section__title" id={headingId} data-flush>{group.group}</h2>
            {group.blurb && <p class="docs-catalog-section__blurb">{group.blurb}</p>}

            <ul class="sk-list" role="list">
              {group.items.map((item) => (
                <li class="sk-list__item">
                  <a href={item.href} class="sk-list__action sk-interactive">
                    <span class="sk-list__leading" set:html={componentIconMarkup(item.href)} />
                    <span class="sk-list__content">
                      <span class="sk-list__title">{item.label}</span>
                      <span class="sk-list__description">{getComponentDescription(item.href, locale)}</span>
                    </span>
                    {item.trailing && (
                      <span class="sk-list__trailing">
                        <span class="sk-badge" data-size="sm" data-tone="warning">{item.trailing}</span>
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</Base>
