---
/*
 * The component CATALOG, not a component's own page: a directory of tiles linking out to every
 * migrated page, so `ComponentPageShell`'s tabs (Uso/Instalación/Referencia…) do not apply — there
 * is no single "usage" to tab into. What carries over for visual consistency with the pages this
 * links to is only the hero header block itself (eyebrow + h1), used here directly rather than
 * through the shell, with no tab strip underneath it.
 */
import "@skryensya/core/components/tile.css";
import Base from "../../layouts/Base.astro";
import { getLocale, useTranslations } from "../../i18n";
import { iconMarkup } from "../../icons";
import { getComponentDescription } from "../../lib/component-catalog";
import { componentStatus, getNavigation } from "../../lib/navigation";

const locale = getLocale(Astro.url);
const componentSection = getNavigation(locale).find((section) => section.id === "components");
if (!componentSection) throw new Error("Missing components navigation section");

const searchIcon = iconMarkup("search");
const t = useTranslations(locale);
---

<Base title={t("indexPage.title")} description={t("indexPage.description")}>
  <header class="docs-component-hero">
    <h1>{t("indexPage.title")}</h1>
  </header>

  <p class="lede" set:html={t("indexPage.lede")} />

  <button
    class="sk-button sk-interactive docs-catalog-search"
    data-variant="ghost"
    type="button"
    aria-controls="docs-cmdk"
    aria-expanded="false"
    aria-keyshortcuts="Meta+K Control+K"
    data-sk-command-palette-open
  >
    <Fragment set:html={searchIcon} />
    <span class="docs-catalog-search__label">{t("indexPage.searchLabel")}</span>
    <kbd class="sk-kbd" data-sk-command-palette-hint aria-hidden="true">⌘K</kbd>
  </button>

  <div class="docs-catalog-groups">
    {
      componentSection.groups.map((group, groupIndex) => {
        const headingId = `catalog-group-${groupIndex}`;

        return (
          <section class="docs-catalog-section" aria-labelledby={headingId}>
            <header class="docs-catalog-section__header">
              <div>
                <h2 class="docs-catalog-section__title" id={headingId} data-flush>
                  {group.group}
                </h2>
                {group.blurb && <p class="docs-catalog-section__blurb">{group.blurb}</p>}
              </div>
              <span class="docs-catalog-section__count">
                {group.items.length} {t("indexPage.countSuffix")}
              </span>
            </header>

            <ul class="docs-catalog">
              {group.items.map((item) => (
                <li class="docs-catalog__item">
                  <a
                    class="docs-catalog__link sk-tile sk-tile--interactive sk-interactive"
                    data-padding="md"
                    href={item.href}
                    data-scope="tile"
                    data-part="root"
                  >
                    <span class="sk-tile__content" data-part="content">
                      <span class="sk-tile__title">{item.label}</span>
                      <span class="sk-tile__description">
                        {getComponentDescription(item.href, locale)}
                      </span>
                    </span>
                    {componentStatus(item) === "wip" && (
                      <span class="sk-badge" data-tone="warning">
                        {t("status.wip")}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</Base>
