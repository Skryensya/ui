---
import "@skryensya/core/components/toast.css";
import "@skryensya/core/components/callout.css";
/* The anatomy diagram at the top of the page is an Annotated frame, so this page needs its sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  toastActionTree,
  toastAnatomyCss,
  toastAnatomyTree,
  toastEmitScript,
  toastEmitTree,
  toastSimpleTree,
  toastStackScript,
  toastStackTree,
  toastStatusScript,
  toastStatusTree,
} from "../../demos/toast";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const install = `pnpm add @skryensya/core @skryensya/vanilla @skryensya/react`;

const vanilla = `import {
  initComponents,
} from "@skryensya/vanilla/auto";
import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";

// ${t("toastPage.vanillaComment").split("\n").join("\n// ")}
mountIcons(document, lucideIcons);

await initComponents();`;
---

<ComponentPageShell
  title="Toast"
  description={t("toastPage.description")}
  contractId="content"
  styleGroups={[{ file: "components/toast.css", probe: "sk-toast" }]}
  testFiles={["packages/vanilla/src/components/toast.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("toastPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={toastEmitTree(t)} script={toastEmitScript} title={t("toastPage.emitTitle")} description={t("toastPage.emitBody")} viewport="menu" />
    <UsagePreview tree={toastSimpleTree(t)} title={t("toastPage.simpleTitle")} description={t("toastPage.simpleBody")} viewport="menu" />
    <UsagePreview tree={toastStatusTree(t)} script={toastStatusScript} title={t("toastPage.statusTitle")} description={t("toastPage.statusBody1")} viewport="overlay" />
    <UsagePreview tree={toastActionTree(t)} title={t("toastPage.actionTitle")} description={t("toastPage.actionBody")} viewport="menu" />
    <UsagePreview tree={toastStackTree(t)} script={toastStackScript} title={t("toastPage.stackTitle")} description={t("toastPage.stackBody1")} caption={t("toastPage.stackNote")} viewport="overlay" />
    <CodeBlock code={vanilla} label="JavaScript" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "toastPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("toastPage.reactBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("toastPage.anatomyBody")} />
    <UsagePreview tree={toastAnatomyTree(t)} css={toastAnatomyCss} label={t("toastPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("toastPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "toastPage.when")} avoid={tList(t, "toastPage.whenNot")} />
    <ContentRules items={tList(t, "toastPage.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes
      intro={t("toastPage.a11yIntro")}
      does={tList(t, "toastPage.a11yDoes")}
      yours={tList(t, "toastPage.a11yYours")}
      keys={[{ keys: ["Enter", t("component.key.space")], action: t("toastPage.key.dismiss") }]}
    />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
