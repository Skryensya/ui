---
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { emptyStateAnatomyTree, emptyStateTree } from "../../demos/empty-state";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/empty-state.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="EmptyState"
  description={t("emptyState.description")}
  badge={t("emptyState.betaBadge")}
  contractId="empty-state"
  styleGroups={[{ file: "components/empty-state.css", probe: "sk-empty-state", title: "EmptyState" }]}
  tests={[
    {
      file: "packages/react/src/components/empty-state.test.tsx",
      tests: [
        {
          name: "renders the title as a heading, with no icon, description or actions by default",
          description: t("emptyState.testReact1"),
        },
        {
          name: "renders an icon, hidden from assistive tech, only when given",
          description: t("emptyState.testReact2"),
        },
        { name: "renders a description only when given", description: t("emptyState.testReact3") },
        { name: "renders actions only when given", description: t("emptyState.testReact4") },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("emptyState.description")} />

    <p set:html={t("emptyState.anatomyBody")} />
    <ComponentPreview
      tree={emptyStateAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("emptyState.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={emptyStateTree(t)} label="Empty State" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("emptyState.contractBody")} />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("emptyState.a11yBody")} />
  </Fragment>
</ComponentPageShell>
