---
import ComponentPageShell from "./ComponentPageShell.astro";
import ComponentPreview from "../ComponentPreview.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import {
  emptyStateAnatomyTree,
  emptyStateDontVagueTree,
  emptyStateTree,
} from "../../demos/empty-state";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";
import "@skryensya/core/components/empty-state.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="EmptyState"
  description={t("emptyState.description")}
  badge={t("emptyState.betaBadge")}
  contractId="empty-state"
  testFiles={["packages/react/src/components/empty-state.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("emptyState.description")} />

    <h3>{t("emptyState.showcaseTitle")}</h3>
    <p set:html={t("emptyState.showcaseBody")} />
    <UsagePreview tree={emptyStateTree(t)} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("emptyState.contractBody")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("emptyState.anatomyBody")} />
    <ComponentPreview
      tree={emptyStateAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("emptyState.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("emptyState.guidelinesLede")} />
    <DoDont
      title={t("emptyState.dd.next.title")}
      do={{ tree: emptyStateTree(t), caption: t("emptyState.dd.next.do") }}
      dont={{ tree: emptyStateDontVagueTree(t), caption: t("emptyState.dd.next.dont") }}
    />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("emptyState.a11yBody")} />
  </Fragment>
</ComponentPageShell>
