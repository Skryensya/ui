---
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  emptyStateAnatomyTree,
  emptyStateSearchDoGuideTree,
  emptyStateSearchDontGuideTree,
  emptyStateSearchTree,
  emptyStateTree,
  emptyStateFirstDoGuideTree,
  emptyStateFirstDontGuideTree,
  emptyStateLoadingDoTree,
  emptyStateLoadingDontTree,
} from "../../demos/empty-state";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";
import "@skryensya/core/components/empty-state.css";
import "@skryensya/core/components/loader.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";

const t = useTranslations(getLocale(Astro.url));
---

<ComponentPageShell
  title="EmptyState"
  description={t("emptyState.description")}
  contractId="empty-state"
  testFiles={["packages/react/src/components/empty-state.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("emptyState.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={emptyStateTree(t)} title={t("emptyState.firstTitle")} description={t("emptyState.firstBody")} storybookTitle="Components/Feedback/EmptyState" storybookStory="Default" />
    <UsagePreview tree={emptyStateSearchTree(t)} title={t("emptyState.searchTitle")} description={t("emptyState.searchBody")} storybookTitle="Components/Feedback/EmptyState" storybookStory="Search" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "emptyState.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("emptyState.anatomyBody")} />
    <UsagePreview
      tree={emptyStateAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("emptyState.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("emptyState.guidelinesLede")} />
    <WhenToUse use={tList(t, "emptyState.when")} avoid={tList(t, "emptyState.whenNot")} />
    <DoDont
      title={t("emptyState.dd.next.title")}
      do={{ tree: emptyStateSearchDoGuideTree(t), caption: t("emptyState.dd.next.do") }}
      dont={{ tree: emptyStateSearchDontGuideTree(t), caption: t("emptyState.dd.next.dont") }}
    />
    <DoDont
      title={t("emptyState.dd.first.title")}
      do={{ tree: emptyStateFirstDoGuideTree(t), caption: t("emptyState.dd.first.do") }}
      dont={{ tree: emptyStateFirstDontGuideTree(t), caption: t("emptyState.dd.first.dont") }}
    />
    <DoDont
      title={t("emptyState.dd.loading.title")}
      do={{ tree: emptyStateLoadingDoTree(t), caption: t("emptyState.dd.loading.do") }}
      dont={{ tree: emptyStateLoadingDontTree(t), caption: t("emptyState.dd.loading.dont") }}
    />
    <ContentRules items={tList(t, "emptyState.content")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("emptyState.a11yIntro")} does={tList(t, "emptyState.a11yDoes")} yours={tList(t, "emptyState.a11yYours")} />
  </Fragment>
</ComponentPageShell>
