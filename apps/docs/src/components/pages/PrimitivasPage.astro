---
/*
 * A survey page, not a single component's page: Box, Wrapper, ImageFrame, Stack, Inline, Grid,
 * Text, Heading and Link each already have their own contract and their own migrated page under
 * `componentes/*`. There is no ninth compiled artifact for "all of them at once" to hang a
 * Referencia tab off of, so this one runs the shell with no `contractId`: Uso and Instalación
 * only, same as any component page that has nothing to report on Referencia/Style hooks/Cambios.
 */
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import WhenToUse from "../WhenToUse.astro";
import { primitivesTree } from "../../demos/layout";
import { getLocale, tList, useTranslations } from "../../i18n";

const install = `pnpm add @skryensya/core @skryensya/react`;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const path = "/components/primitives";
---

<ComponentPageShell title={t("primitivasPage.title")} description={t("primitivasPage.description")}>
  <Fragment slot="usage">
    <p class="lede" set:html={t("primitivasPage.lede")} />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={primitivesTree(t, path)} title={t("primitivasPage.exampleTitle")} description={t("primitivasPage.exampleBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "primitivasPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("primitivasPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "primitivasPage.which")} avoid={tList(t, "primitivasPage.whichNot")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
