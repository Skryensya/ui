---
import "@skryensya/core/components/popover.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
/* The anatomy diagram is an Annotated frame, so this page needs its sheet; the checkbox inside the
   specimen needs its own, since the frozen markup is authored rather than mounted from a tree. */
import "@skryensya/core/components/annotation.css";
import "@skryensya/core/components/checkbox.css";
import { popupAnatomyCss, popupAnatomyHtml, popupTree } from "../../demos/popup";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/popover.css";`;
---

<ComponentPageShell
  title="Popup"
  description={t("popupPage.description")}
  badge={t("popupPage.betaBadge")}
  contractId="popover"
  styleGroups={[
    { file: "components/popover.css", probe: "sk-popover", title: "Popup" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("popupPage.description")} />
    <ComponentPreview tree={popupTree(t)} label="Popup" viewport="menu" />

    <p set:html={t("popupPage.anatomyBody")} />
    <ComponentPreview
      html={popupAnatomyHtml(t)}
      css={popupAnatomyCss}
      label={t("popupPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("popupPage.contractBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("popupPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
