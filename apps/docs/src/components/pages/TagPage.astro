---
import "@skryensya/core/components/tag.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { tagAnatomyTree, tagLinksTree, tagRemovableTree, tagSimpleTree, tagTonesTree } from "../../demos/tag";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
---

<ComponentPageShell
  title="Tag"
  description={t("tagPage.description")}
  contractId="tag"
  testFiles={["packages/react/src/components/tag.test.tsx"]}}
>
  <Fragment slot="anatomy">
    <p set:html={t("tagPage.anatomyBody")} />
    <ComponentPreview
      tree={tagAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("tagPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />
  </Fragment>

  <Fragment slot="usage">
    <p class="lede" set:html={t("tagPage.lede")} />
    <h3>{t("tagPage.simpleTitle")}</h3>
    <p set:html={t("tagPage.simpleBody")} />
    <ComponentPreview tree={tagSimpleTree(t)} label={t("tagPage.simpleLabel")} />

    <h3>{t("tagPage.tonesTitle")}</h3>
    <p set:html={t("tagPage.tonesBody")} />
    <ComponentPreview tree={tagTonesTree(t)} label={t("tagPage.tonesLabel")} />

    <h3>{t("tagPage.linksTitle")}</h3>
    <p set:html={t("tagPage.linksBody")} />
    <ComponentPreview tree={tagLinksTree(t)} label={t("tagPage.linksLabel")} />

    <h3>{t("tagPage.removableTitle")}</h3>
    <p set:html={t("tagPage.removableBody")} />
    <ComponentPreview tree={tagRemovableTree(t)} label={t("tagPage.removableLabel")} />

  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
