---
import "@skryensya/core/components/megamenu.css";
import "@skryensya/core/patterns/nav-list.css";
import "@skryensya/core/patterns/anchored.css";
/* Structure diagram: the Annotated specimen is drawn by Annotation's own sheet. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { megamenuAnatomyCss, megamenuAnatomyHtml, megamenuTree } from "../../demos/megamenu";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

const styles = `@import "@skryensya/core/patterns/anchored.css";
@import "@skryensya/core/components/megamenu.css";
@import "@skryensya/core/patterns/nav-list.css";`;

const js = `import { mountIcons } from "@skryensya/vanilla/icon";
import { lucideIcons } from "@skryensya/icons-lucide";
import { initComponents } from "@skryensya/vanilla/auto";

mountIcons(document, lucideIcons);
initComponents();`;

const hrefs = { overview: "#", pricing: "#", integrations: "#", teams: "#", enterprise: "#" };
---

<ComponentPageShell
  title="Megamenu"
  description={t("megamenuPage.description")}
  contractId="megamenu"
  styleGroups={[
    { file: "components/megamenu.css", probe: "sk-megamenu", title: "Megamenu" },
    { file: "patterns/anchored.css", probe: "sk-anchored", title: "Heredados de Anclaje" },
    { file: "patterns/nav-list.css", probe: "sk-nav-list", title: "Heredados de NavList" },
  ]}
  testFiles={["packages/vanilla/src/components/megamenu.test.ts", "packages/react/src/components/megamenu.test.tsx"]}}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("megamenuPage.description")} />

    <p set:html={t("megamenuPage.anatomyBody")} />
    <ComponentPreview
      html={megamenuAnatomyHtml(t)}
      css={megamenuAnatomyCss}
      label={t("megamenuPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={megamenuTree(t, hrefs)} js={js} label="Megamenu" viewport="overlay" flush />

    <h3>{t("component.contractNotesTitle")}</h3>
    <p set:html={t("megamenuPage.contractBody")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={styles} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <p set:html={t("megamenuPage.a11yBody")} />
  </Fragment>
</ComponentPageShell>
