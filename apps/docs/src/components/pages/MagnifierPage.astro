---
import "@skryensya/core/components/magnifier.css";
/* The demos hold their photos in an ImageFrame. */
import "@skryensya/core/patterns/image-frame.css";
/* The product example: the Product template's gallery and buy box. A preview only copies styles THIS page loaded. */
import "@skryensya/core/components/badge.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/button.tactile.css";
import "@skryensya/core/components/gallery.css";
import "@skryensya/core/components/lightbox.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/loader.css";
import "@skryensya/core/components/number-field.css";
import "@skryensya/core/components/rating.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/icon.css";
import "@skryensya/core/patterns/layout.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import WhenToUse from "../WhenToUse.astro";
import A11yNotes from "../A11yNotes.astro";
import DoDont from "../DoDont.astro";
import UsagePreview from "../UsagePreview.astro";
import {
  magnifierCroppedTree,
  magnifierDetailTree,
  magnifierDoDetailTree,
  magnifierDontDetailTree,
  magnifierDontSizeTree,
  magnifierDontZoomTree,
  magnifierFilterTree,
  magnifierDoSizeTree,
  magnifierDoZoomTree,
  magnifierProductTree,
  magnifierStrongTree,
  magnifierTree,
} from "../../demos/magnifier";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));

/* Simplest first: a photo, what the options change, then a whole product page. */
const storybookTitle = "Components/Magnifier";
const firstExamples = [
  { key: "photo", story: "Default", tree: magnifierTree },
  { key: "detail", story: "Detail", tree: magnifierDetailTree },
  { key: "cropped", story: "Cropped", tree: magnifierCroppedTree },
  { key: "strong", story: "Strong", tree: magnifierStrongTree },
] as const;
const lastExamples = [{ key: "product", story: "Product", tree: magnifierProductTree }] as const;
const filters = ["none", "red", "green", "blue", "cyan", "magenta", "yellow"] as const;
const filterLabels = Object.fromEntries(filters.map((f) => [f, t(`magnifierPage.filter.${f}` as Parameters<typeof t>[0])]));

const [, doesColumn] = t("magnifierPage.hooksColumns").split("|");
const hookNotes = {
  "--sk-magnifier-bg": t("magnifierPage.hook.bg"),
  "--sk-magnifier-size": t("magnifierPage.hook.size"),
  "--sk-magnifier-lens-shadow": t("magnifierPage.hook.lensShadow"),
};

const html = `<div class="sk-magnifier" data-sk-magnifier data-zoom="2">
  <img src="product.jpg" alt="The red sneaker, side view" />
  <canvas class="sk-magnifier__lens" aria-hidden="true"></canvas>
</div>`;
const react = `import { Magnifier } from "@skryensya/react/magnifier";

<Magnifier zoom={3}>
  <img src="product.jpg" alt="The red sneaker, side view" />
</Magnifier>`;
const tune = `.sk-magnifier {
  --sk-magnifier-size: 14rem;          /* a bigger lens */
  --sk-magnifier-lens-shadow: none;
  --sk-magnifier-bg: var(--color-bg-surface);  /* past the photo: a fill instead of clear glass */
}`;
---

<ComponentPageShell
  hookPlayground={{ tree: magnifierTree(t) }}
  title="Magnifier"
  description={t("magnifierPage.description")}
  contractId="magnifier"
  badge="Beta"
  hookNotes={hookNotes}
  hookNotesLabel={doesColumn}
  testFiles={["packages/core/src/magnifier.test.ts"]}
  vanillaInstallSteps={[{ title: "HTML", blocks: [{ kind: "code", code: html, lang: "html", label: "HTML" }] }]}
  reactInstallSteps={[{ title: "React", blocks: [{ kind: "code", code: react, lang: "tsx", label: "React" }] }]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("magnifierPage.lede")} />

    <h3>{t("magnifierPage.examplesTitle")}</h3>
    <p set:html={t("magnifierPage.examplesBody")} />
    {
      firstExamples.map(({ key, story, tree }) => (
        <UsagePreview
          tree={tree(t)}
          title={t(`magnifierPage.variant.${key}` as Parameters<typeof t>[0])}
          description={t(`magnifierPage.variant.${key}.explain` as Parameters<typeof t>[0])}
          storybookTitle={storybookTitle}
          storybookStory={story}
        />
      ))
    }
    <UsagePreview
      tree={magnifierFilterTree(t)}
      optionName="filter"
      labels={filterLabels}
      title={t("magnifierPage.variant.filter")}
      description={t("magnifierPage.variant.filter.explain")}
      storybookTitle={storybookTitle}
      storybookStory="Filter"
    />
    {
      lastExamples.map(({ key, story, tree }) => (
        <UsagePreview
          tree={tree(t)}
          title={t(`magnifierPage.variant.${key}` as Parameters<typeof t>[0])}
          description={t(`magnifierPage.variant.${key}.explain` as Parameters<typeof t>[0])}
          storybookTitle={storybookTitle}
          storybookStory={story}
        />
      ))
    }

    <h3>{t("magnifierPage.howTitle")}</h3>
    <ul>
      <li set:html={t("magnifierPage.how.media")} />
      <li set:html={t("magnifierPage.how.glass")} />
      <li set:html={t("magnifierPage.how.edge")} />
      <li set:html={t("magnifierPage.how.touch")} />
      <li set:html={t("magnifierPage.how.feel")} />
      <li set:html={t("magnifierPage.how.lazy")} />
      <li set:html={t("magnifierPage.how.live")} />
    </ul>

    <h3>{t("magnifierPage.contractTitle")}</h3>
    <ul>
      {tList(t, "magnifierPage.contract").map((item) => <li set:html={item} />)}
    </ul>
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("magnifierPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "magnifierPage.when")} avoid={tList(t, "magnifierPage.whenNot")} />
    <DoDont
      interactive
      title={t("magnifierPage.dd.detail.title")}
      do={{ tree: magnifierDoDetailTree(t), caption: t("magnifierPage.dd.detail.do") }}
      dont={{ tree: magnifierDontDetailTree(t), caption: t("magnifierPage.dd.detail.dont") }}
    />
    <DoDont
      interactive
      title={t("magnifierPage.dd.size.title")}
      do={{ tree: magnifierDoSizeTree(t), caption: t("magnifierPage.dd.size.do") }}
      dont={{ tree: magnifierDontSizeTree(t), caption: t("magnifierPage.dd.size.dont") }}
    />
    <DoDont
      interactive
      title={t("magnifierPage.dd.zoom.title")}
      do={{ tree: magnifierDoZoomTree(t), caption: t("magnifierPage.dd.zoom.do") }}
      dont={{ tree: magnifierDontZoomTree(t), caption: t("magnifierPage.dd.zoom.dont") }}
    />
  </Fragment>

  <Fragment slot="style">
    <h3>{t("magnifierPage.hooksTitle")}</h3>
    <p set:html={t("magnifierPage.hooksBody")} />
    <CodeBlock code={tune} label="CSS" lang="css" />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("magnifierPage.a11yIntro")} does={tList(t, "magnifierPage.a11yDoes")} yours={tList(t, "magnifierPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
