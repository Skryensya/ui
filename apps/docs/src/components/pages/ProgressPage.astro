---
import "@skryensya/core/components/progress.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import ComponentPreview from "../ComponentPreview.astro";
import { progressAnatomyTree, progressTree } from "../../demos/progress";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;
---

<ComponentPageShell
  title="Progress"
  description={t("progressPage.description")}
  contractId="progress"
  styleGroups={[{ file: "components/progress.css", probe: "sk-progress" }]}
  tests={[
    {
      file: "packages/react/src/components/progress.test.tsx",
      tests: [
        {
          name: "exposes the value on the progressbar role and paints the matching fill",
          description: t("progressPage.test1"),
        },
        {
          name: "clamps an out-of-range value so the paint and aria-valuenow agree",
          description: t("progressPage.test2"),
        },
      ],
    },
  ]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("progressPage.lede")} />

    <p set:html={t("progressPage.anatomyBody")} />
    <ComponentPreview
      tree={progressAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("progressPage.anatomyPreviewLabel")}
      screens={false}
      hideSource
      chrome={false}
    />

    <ComponentPreview tree={progressTree(t)} label="Progress" />
    <p set:html={t("progressPage.body")} />
    <p set:html={t("component.reactNote")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
</ComponentPageShell>
