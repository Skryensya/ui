---
import "@skryensya/core/components/progress.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import ComponentPageShell from "./ComponentPageShell.astro";
import CodeBlock from "../CodeBlock.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  progressAnatomyTree,
  progressDoRunningTree,
  progressDoTaskTree,
  progressDontMeasureTree,
  progressDontRunningTree,
  progressSingleTree,
  progressTree,
} from "../../demos/progress";
import { annotationDemoCss } from "../../demos/annotation";
import { getLocale, tList, useTranslations } from "../../i18n";

const t = useTranslations(getLocale(Astro.url));
const install = `pnpm add @skryensya/core @skryensya/react`;

/* What each value of a property is for, read from this page's messages. Same model Badge uses. */
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`progressPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
---

<ComponentPageShell
  title="Progress"
  description={t("progressPage.description")}
  contractId="progress"
  testFiles={["packages/react/src/components/progress.test.tsx"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("progressPage.lede")} />

    <UsagePreview
      tree={progressSingleTree(t)}
      optionName="tone"
      title={t("progressPage.prop.tone.title")}
      description={t("progressPage.prop.tone.body")}
      explain={explain("tone", ["accent", "success", "warning", "danger"])}
      stageMinBlockSize="7rem"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <UsagePreview tree={progressTree(t)} title={t("progressPage.tasksTitle")} description={t("progressPage.tasksBody")} />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "progressPage.contract").map((item) => <li set:html={item} />)}
    </ul>
    <p set:html={t("component.reactNote")} />

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("progressPage.anatomyBody")} />
    <UsagePreview
      tree={progressAnatomyTree(t)}
      css={annotationDemoCss}
      label={t("progressPage.anatomyPreviewLabel")}
      bare
    />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("progressPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "progressPage.when")} avoid={tList(t, "progressPage.whenNot")} />
    <DoDont
      title={t("progressPage.dd.tone.title")}
      do={{ tree: progressDoRunningTree(t), caption: t("progressPage.dd.tone.do") }}
      dont={{ tree: progressDontRunningTree(t), caption: t("progressPage.dd.tone.dont") }}
    />
    <DoDont
      title={t("progressPage.dd.task.title")}
      do={{ tree: progressDoTaskTree(t), caption: t("progressPage.dd.task.do") }}
      dont={{ tree: progressDontMeasureTree(t), caption: t("progressPage.dd.task.dont") }}
    />
    <ContentRules items={tList(t, "progressPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
  </Fragment>
  <Fragment slot="a11y">
    <A11yNotes intro={t("progressPage.a11yIntro")} does={tList(t, "progressPage.a11yDoes")} yours={tList(t, "progressPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
