---
import { emitMarkup } from "@skryensya/ai-compiler/emit";
import "@skryensya/core/components/navbar.css";
import "@skryensya/core/components/sidebar.css";
import "@skryensya/core/components/typography.css";
import "@skryensya/core/patterns/box.css";
import "@skryensya/core/patterns/nav-list.css";
import "@skryensya/core/patterns/icon.css";
import "@skryensya/core/patterns/layout.css";
/*
 * One import per contract the templates below compose. A page loads the CSS it uses and nothing
 * else (see `i18n/index.ts`'s note on why that matters here in particular: every ComponentPreview
 * stage clones this document's `<head>`), so adding a template means adding its contracts' sheets
 * to this list. The emitter writes the classes, it does not carry the styles.
 */
import "@skryensya/core/components/badge.css";
import "@skryensya/core/components/breadcrumb.css";
import "@skryensya/core/components/button.css";
import "@skryensya/core/components/callout.css";
import "@skryensya/core/components/checkbox.css";
import "@skryensya/core/components/form-field.css";
import "@skryensya/core/components/input.css";
import "@skryensya/core/components/kbd.css";
import "@skryensya/core/components/list.css";
import "@skryensya/core/components/pagination.css";
import "@skryensya/core/components/password-input.css";
import "@skryensya/core/components/procedure.css";
import "@skryensya/core/components/segmented.css";
import "@skryensya/core/components/select.css";
import "@skryensya/core/components/separator.css";
import "@skryensya/core/components/stat.css";
import "@skryensya/core/components/steps.css";
import "@skryensya/core/components/switch.css";
import "@skryensya/core/components/table.css";
import "@skryensya/core/components/toc.css";
import "@skryensya/core/components/avatar.css";
import "@skryensya/core/patterns/wrapper.css";
import "@skryensya/core/components/tile.css";
import "@skryensya/core/components/tabs.css";
import "@skryensya/core/components/accordion.css";
import "@skryensya/core/components/quote.css";
import "@skryensya/core/patterns/hero.css";
import "@skryensya/core/patterns/image-frame.css";
import "@skryensya/core/patterns/media-overlay.css";
import "@skryensya/core/components/rating.css";
import "@skryensya/core/components/number-field.css";
import "@skryensya/core/components/description-list.css";
import "@skryensya/core/components/calendar.css";
import "@skryensya/core/components/changelog.css";
import "@skryensya/core/components/empty-state.css";
import "@skryensya/core/components/tag.css";
import "@skryensya/core/patterns/footer.css";
import { templateTrees } from "../../demos/templates/registry";
import { makerUrl } from "../../lib/navigation";
import { getLocale, useTranslations } from "../../i18n";
import { templateGroups, templateSections } from "../../lib/templates-nav";
import SidebarNav from "../SidebarNav.astro";
import type { NavigationSection } from "../../lib/navigation";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/*
 * The tree per section id. The section list itself (id, labels, order) lives in
 * `lib/templates-nav.ts` so this page's rail and the mobile drawer entry cannot list different
 * templates; here we only attach the emitted markup. Adding a template is one entry there plus one
 * tree here.
 */
const TREES = templateTrees(t, locale);
/* The SAME rail component as the rest of the site (`SidebarNav`), fed the templates' groups: open, and
   opening and closing like Foundations'. An empty caption: the page's own title already says where this is. */
const railNavigation: NavigationSection[] = [
  {
    id: "templates",
    section: t("templates.navLabel"),
    blurb: "",
    caption: "",
    groups: templateGroups(t).map((group) => ({
      id: `templates-${group.id}`,
      group: group.label,
      collapsible: true,
      defaultOpen: true,
      items: group.sections.map((section) => ({ href: `#${section.id}`, label: section.navLabel })),
    })),
  },
];

const templates = templateSections(t).map((section) => ({
  ...section,
  markup: emitMarkup(TREES[section.id](), { fillDefaults: false }),
  /* The Maker opens a new project as this template, in this page's language. */
  openInMaker: makerUrl
    ? emitMarkup({
        contract: "button",
        signature: "Button.navigation",
        options: { href: `${makerUrl}?template=${encodeURIComponent(section.id)}&lang=${locale}`, variant: "soft", size: "sm" },
        attrs: { target: "_blank", rel: "noopener" },
        children: t("templates.openInMaker"),
      })
    : undefined,
}));
---

<div class="templates">
  <aside class="sk-sidebar templates__sidebar">
    <div class="sk-sidebar__content">
      <SidebarNav nav={railNavigation} path="" idPrefix="templates-nav" />
    </div>
  </aside>

  <main class="templates__stage">
    {
      templates.map((template) => (
        <section id={template.id} class="templates__section" aria-label={template.title}>
          {template.openInMaker ? <div class="templates__actions" set:html={template.openInMaker} /> : null}
          <section class="templates__example" aria-label={template.label}>
            <Fragment set:html={template.markup} />
          </section>
        </section>
      ))
    }
  </main>
</div>

<style lang="scss">
  /* Same line the docs rail / drawer switch pivots on (`_breakpoints.scss` `desktop`, 52rem): the
     sticky column below has no room on a phone, so it goes `display: none` and the same jump links
     ride into the mobile drawer instead, as a "Templates" collapsible section `Base.astro` builds
     from `templateSections`. */
  @use "@skryensya/core/breakpoints" as bp;

  .templates {
    display: flex;
    align-items: flex-start;
  }

  @include bp.down("desktop") {
    .templates__sidebar {
      display: none;
    }

    .templates__stage {
      padding: var(--space-inset-md);
    }
  }

  /* Same sticky arithmetic as the docs rail (site.css `.docs-sidebar`): flush under the measured
     navbar height, filling the rest of the viewport, so a tall list of templates still leaves the
     nav reachable without scrolling the whole page. */
  .templates__sidebar {
    position: sticky;
    top: var(--docs-navbar-h, var(--docs-header-block-size));
    block-size: calc(100dvh - var(--docs-navbar-h, var(--docs-header-block-size)));
    flex: none;
  }

  .templates__stage {
    flex: 1;
    min-inline-size: 0;
    padding: var(--space-inset-xl);
  }

  .templates__section {
    scroll-margin-top: calc(var(--docs-navbar-h, var(--docs-header-block-size)) + var(--space-stack-md));
  }

  .templates__actions {
    display: flex;
    justify-content: flex-end;
    margin-block-end: var(--space-stack-xs);
  }

  .templates__section + .templates__section {
    margin-block-start: var(--space-stack-xl);
  }
</style>
