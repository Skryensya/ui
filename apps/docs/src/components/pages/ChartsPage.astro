---
/*
 * THE CHART CONTRACT'S PAGE, and it opens on the composition people actually want: a card with a
 * chart inside it. Chart itself has no title, no action and no surface (see `core/chart.ts`); those
 * belong to Box, Heading, Stat and Button. Publishing a `<ChartCard>` would have grown the card with
 * variants that Card refuses to be.
 *
 * `contractId="chart"` so Referencia and Cambios read the compiled artifact. Bars, lines and areas
 * all come from Core and React: Chart draws the path itself, in both bindings. TanStack is a separate
 * subpath and is not the API this page teaches.
 */
import "@skryensya/core/components/chart.css";
import "@skryensya/core/components/stat.css";
/* Structure diagram: Annotated specimen; a preview frame only copies styles THIS page loaded. */
import "@skryensya/core/components/annotation.css";
import CodeBlock from "../CodeBlock.astro";
import ComponentPageShell from "./ComponentPageShell.astro";
import UsagePreview from "../UsagePreview.astro";
import DoDont from "../DoDont.astro";
import WhenToUse from "../WhenToUse.astro";
import ContentRules from "../ContentRules.astro";
import A11yNotes from "../A11yNotes.astro";
import {
  chartAnalyticsCardTree,
  chartComparisonTree,
  chartGalleryTree,
  chartHistoryCardTree,
  chartLegendCardTree,
  chartMetricTabsTree,
  chartPointDetailTree,
  chartsAnatomyCss,
  chartsAnatomyTree,
  chartsAreaTree,
  chartsBarTree,
  chartsLineTree,
  chartTableCardTree,
  chartUsageCardTree,
  chartsDoOneToneTree,
  chartsDontRainbowTree,
  chartsDontThreeTree,
  chartsValuesTree,
} from "../../demos/charts";
import { getLocale, tList, useTranslations } from "../../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const install = `pnpm add @skryensya/core @skryensya/react`;
const storybookTitle = "Components/Data/Charts";
const explain = (option: string, values: readonly string[]) =>
  Object.fromEntries(values.map((value) => [value, t(`chartsPage.prop.${option}.${value}` as Parameters<typeof t>[0])]));
const installLine = `pnpm add @skryensya/charts`;

const tanstackSource = `import { TanStackChart } from "@skryensya/charts/react/tanstack";`;
---

<ComponentPageShell
  title="Charts"
  description={t("chartsPage.description")}
  contractId="chart"
  testFiles={["packages/charts/src/react/chart.test.tsx", "apps/docs/src/components/pages/ChartsPage.test.ts"]}
>
  <Fragment slot="usage">
    <p class="lede" set:html={t("chartsPage.lede")} />

    <UsagePreview
      tree={chartsBarTree(t)}
      optionName="tone"
      title={t("chartsPage.prop.tone.title")}
      description={t("chartsPage.prop.tone.body")}
      explain={explain("tone", ["accent", "success", "warning", "danger", "info", "neutral"])}
      storybookTitle={storybookTitle}
      storybookStory="Bar"
    />
    <UsagePreview
      tree={chartsValuesTree(t)}
      optionName="format"
      title={t("chartsPage.prop.format.title")}
      description={t("chartsPage.prop.format.body")}
      explain={explain("format", ["number", "compact", "percent", "currency"])}
      storybookTitle={storybookTitle}
      storybookStory="Values"
    />

    <h3>{t("component.examplesTitle")}</h3>
    <h3 id="cards">{t("chartsPage.cardsTitle")}</h3>
    <p set:html={t("chartsPage.cardsBody")} />

    <h3 id="analitica">{t("chartsPage.analyticsTitle")}</h3>
    <p set:html={t("chartsPage.analyticsBody")} />
    <UsagePreview tree={chartAnalyticsCardTree(t)} label={t("chartsPage.analyticsLabel")} caption={t("chartsPage.analyticsNote")} stageMinBlockSize="26rem" />

    <h3 id="historial">{t("chartsPage.historyTitle")}</h3>
    <p set:html={t("chartsPage.historyBody")} />
    <UsagePreview tree={chartHistoryCardTree(t)} />

    <h3 id="consumo">{t("chartsPage.usageTitle")}</h3>
    <p set:html={t("chartsPage.usageBody")} />
    <UsagePreview tree={chartUsageCardTree(t)} />

    <h3 id="chart">{t("chartsPage.pieceTitle")}</h3>
    <p set:html={t("chartsPage.pieceBody")} />

    <h3 id="barras">{t("chartsPage.barTitle")}</h3>
    <p set:html={t("chartsPage.barBody")} />
    <UsagePreview tree={chartsBarTree(t)} />

    <h3 id="linea">{t("chartsPage.lineTitle")}</h3>
    <p set:html={t("chartsPage.lineBody")} />
    <UsagePreview tree={chartsLineTree(t)} label={t("chartsPage.lineLabel")} caption={t("chartsPage.lineNote")} measure="40rem" stageMinBlockSize="22rem" />

    <h3 id="area">{t("chartsPage.areaTitle")}</h3>
    <p set:html={t("chartsPage.areaBody")} />
    <UsagePreview tree={chartsAreaTree(t)} label={t("chartsPage.areaLabel")} caption={t("chartsPage.areaNote")} measure="40rem" stageMinBlockSize="22rem" />

    <h3 id="integraciones">{t("chartsPage.integrationsTitle")}</h3>
    <p set:html={t("chartsPage.integrationsBody")} />

    <h4 id="tabla">{t("chartsPage.tableTitle")}</h4>
    <p set:html={t("chartsPage.tableBody")} />
    <UsagePreview tree={chartTableCardTree(t)} />

    <h4 id="detalle">{t("chartsPage.detailTitle")}</h4>
    <p set:html={t("chartsPage.detailBody")} />
    <UsagePreview tree={chartPointDetailTree(t)} />

    <h4 id="galeria">{t("chartsPage.galleryTitle")}</h4>
    <p set:html={t("chartsPage.galleryBody")} />
    <UsagePreview tree={chartGalleryTree(t)} label={t("chartsPage.galleryLabel")} caption={t("chartsPage.galleryNote")} stageMinBlockSize="32rem" />

    <h4 id="metricas">{t("chartsPage.metricTabsTitle")}</h4>
    <p set:html={t("chartsPage.metricTabsBody")} />
    <UsagePreview tree={chartMetricTabsTree(t)} />

    <h4 id="leyenda">{t("chartsPage.legendTitle")}</h4>
    <p set:html={t("chartsPage.legendBody")} />
    <UsagePreview tree={chartLegendCardTree(t)} />

    <h4 id="comparacion">{t("chartsPage.comparisonTitle")}</h4>
    <p set:html={t("chartsPage.comparisonBody")} />
    <UsagePreview tree={chartComparisonTree(t)} label={t("chartsPage.comparisonLabel")} caption={t("chartsPage.comparisonNote")} stageMinBlockSize="26rem" />

    <h3 id="tanstack">{t("chartsPage.tanstackTitle")}</h3>
    <p set:html={t("chartsPage.tanstackBody")} />
    <CodeBlock code={tanstackSource} label="tsx" />

    <h3>{t("component.contractNotesTitle")}</h3>
    <ul>
      {tList(t, "chartsPage.contract").map((item) => <li set:html={item} />)}
    </ul>

    <h3>{t("component.anatomy")}</h3>
    <p set:html={t("chartsPage.anatomyBody")} />
    <UsagePreview tree={chartsAnatomyTree(t)} css={chartsAnatomyCss} label={t("chartsPage.anatomyPreviewLabel")} bare />
  </Fragment>

  <Fragment slot="guidelines">
    <p class="lede" set:html={t("chartsPage.guidelinesLede")} />
    <WhenToUse use={tList(t, "chartsPage.when")} avoid={tList(t, "chartsPage.whenNot")} />
    <DoDont
      title={t("chartsPage.dd.tone.title")}
      do={{ tree: chartsDoOneToneTree(t), caption: t("chartsPage.dd.tone.do") }}
      dont={{ tree: chartsDontRainbowTree(t), caption: t("chartsPage.dd.tone.dont") }}
    />
    <DoDont
      title={t("chartsPage.dd.count.title")}
      do={{ tree: chartsBarTree(t), caption: t("chartsPage.dd.count.do") }}
      dont={{ tree: chartsDontThreeTree(t), caption: t("chartsPage.dd.count.dont") }}
    />
    <ContentRules items={tList(t, "chartsPage.content")} />
  </Fragment>

  <Fragment slot="install">
    <CodeBlock code={install} label="terminal" />
    <p set:html={t("chartsPage.installBody")} />
    <CodeBlock code={installLine} label="terminal" />
    <p set:html={t("chartsPage.installLineBody")} />
  </Fragment>

  <Fragment slot="a11y">
    <A11yNotes intro={t("chartsPage.a11yIntro")} does={tList(t, "chartsPage.a11yDoes")} yours={tList(t, "chartsPage.a11yYours")} />
  </Fragment>
</ComponentPageShell>
