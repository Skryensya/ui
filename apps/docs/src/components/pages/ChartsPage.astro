const tableSource = `import { Chart } from "@skryensya/react/chart";
import {
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
  TableScroll,
} from "@skryensya/react/table";

<Chart
  format="compact"
  height="md"
  kind="bar"
  label="Revenue by quarter"
  points={quarterlyRevenue}
  tone="neutral"
/>
<TableScroll>
  <Table>
    <TableCaption>Revenue by quarter, in dollars</TableCaption>
    <TableHead>
      <TableRow>
        <TableHeader scope="col">Quarter</TableHeader>
        <TableHeader scope="col">Revenue</TableHeader>
        <TableHeader scope="col">Change</TableHeader>
      </TableRow>
    </TableHead>
    <TableBody>
      {quarterlyRevenue.map((row) => (
        <TableRow key={row.label}>
          <TableHeader scope="row">{row.label}</TableHeader>
          <TableCell>{row.revenue}</TableCell>
          <TableCell>{row.delta ?? "—"}</TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
</TableScroll>;`;

const detailSource = `import { Chart } from "@skryensya/react/chart";
import { Button } from "@skryensya/react/button";
import { Tooltip } from "@skryensya/react/tooltip";
import { Stack } from "@skryensya/react/layout";
import { formatChartValue } from "@skryensya/core/chart";

<Stack gap="md">
  <Chart
    height="md"
    kind="bar"
    label="Latency by endpoint"
    labels={false}
    points={latency}
    tone="info"
  />
  {/* One grid column per point, matching the chart's own bar columns exactly —
      not a wrapping row, whose widths would follow each label's own text length. */}
  <div style={{ display: "grid", gridAutoFlow: "column", gridAutoColumns: "1fr", gap: "var(--space-inline-xs)" }}>
    {latency.map((point) => (
      <Tooltip content={\`\${formatChartValue(point.value)} ms\`} key={point.label}>
        <Button size="sm" style={{ inlineSize: "100%" }} variant="ghost">
          {point.label}
        </Button>
      </Tooltip>
    ))}
  </div>
</Stack>;`;

const gallerySource = `import { Chart } from "@skryensya/react/chart";
import { Chart as PathChart } from "@skryensya/charts/react";
import { Grid } from "@skryensya/react/layout";

<Grid columns={2} gap="md">
  <Chart height="md" kind="bar" format="percent" tone="success" values points={conversion} label="Daily conversion" />
  <PathChart height="md" kind="line" tone="danger" points={errors} label="Errors per day" />
  <PathChart height="md" kind="area" flush labels={false} tone="warning" points={cpu} label="CPU usage" />
  <Chart height="md" kind="bar" format="currency" currency="USD" grid tone="neutral" points={spend} label="Daily spend" />
</Grid>;`;

const metricTabsSource = `import { Tabs } from "@skryensya/react/tabs";
import { Chart } from "@skryensya/react/chart";
import { Stat } from "@skryensya/react/stat";
import { Stack } from "@skryensya/react/layout";
import { Heading } from "@skryensya/react/typography";

function MetricPanel({ heading, statLabel, value, chartLabel, points, tone }) {
  return (
    <Stack gap="md">
      <Stack gap="xs">
        <Heading as="h4" flush size="h5">{heading}</Heading>
        <Stat label={statLabel} value={value} />
      </Stack>
      <Chart height="md" kind="bar" label={chartLabel} points={points} tone={tone} />
    </Stack>
  );
}

<Tabs
  aria-label="Choose metric"
  defaultValue="revenue"
  items={[
    { value: "revenue", label: "Revenue", children: <MetricPanel {...revenue} /> },
    { value: "users", label: "Users", children: <MetricPanel {...users} /> },
    { value: "errors", label: "Errors", children: <MetricPanel {...errors} /> },
  ]}
/>;`;

const legendSource = `import { Badge } from "@skryensya/react/badge";
import { Chart } from "@skryensya/react/chart";
import { Box, Inline, Stack } from "@skryensya/react/layout";
import { Heading, Text } from "@skryensya/react/typography";

const budget = [
  { label: "Eng", value: 182000, tone: "accent" },
  { label: "Sales", value: 96000, tone: "success" },
  { label: "Support", value: 54000, tone: "warning" },
