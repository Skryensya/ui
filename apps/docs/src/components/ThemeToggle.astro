---
/*
 * Header chrome: cycles color mode system → light → dark. Preference lives in localStorage["sk"]
 * under `scheme` (FOUC + persistence listener). Markup is the ThemeToggle contract from the DS.
 *
 * The three labels are ATTRIBUTES, read by the vanilla enhancer when it swaps state, so they are
 * translated here at build rather than by the enhancer: the DS component has no business knowing
 * what language its host speaks.
 */
import { getLocale, useTranslations } from "../i18n";

const t = useTranslations(getLocale(Astro.url));
---

<button
  class="sk-button sk-interactive sk-theme-toggle"
  data-variant="ghost"
  data-icon-only
  data-sk-theme-toggle
  data-sk-theme-toggle-label-system={t("prefs.modeSystem")}
  data-sk-theme-toggle-label-light={t("prefs.modeLight")}
  data-sk-theme-toggle-label-dark={t("prefs.modeDark")}
  type="button"
  aria-label={t("prefs.modeSystem")}
>
  <span data-sk-icon="mode-system" data-sk-theme-toggle-icon="system"></span>
  <span data-sk-icon="mode-light" data-sk-theme-toggle-icon="light"></span>
  <span data-sk-icon="mode-dark" data-sk-theme-toggle-icon="dark"></span>
</button>
