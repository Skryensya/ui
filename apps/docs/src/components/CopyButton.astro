---
/*
 * The kit's `CopyButton` (the `clipboard` contract), authored for the code blocks. The markup is the
 * contract's; the behaviour is `@skryensya/vanilla/clipboard`, which the lazy registry mounts on
 * `[data-sk-clipboard]` like any other component. The icons are inlined here rather than left as
 * `data-sk-icon` placeholders, so a block that arrives late (DeferredCode) never shows an empty box.
 */
import { iconMarkup } from "../icons";
import "@skryensya/core/components/clipboard.css";
/* The feedback flag is an anchored box: the pattern is where its placement and its arrow live. */
import "@skryensya/core/patterns/anchored.css";
import { getLocale, useTranslations } from "../i18n";

interface Props {
  target: string;
  /**
   * Overrides the "copy code" wording for a button that copies something other than a code
   * block, a table cell's own value for instance: without this every such button would announce
   * itself identically as "Copy code", indistinguishable from its neighbours to a screen reader
   * moving button to button.
   */
  label?: string;
}

const { target, label } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const copyIcon = iconMarkup("copy");
const copiedIcon = iconMarkup("check");
---

{/*
 * `data-sk-density-scope` WITH NO FACTOR, which is the published way of saying "the system's
 * density, whatever this container's is". The source panels this button floats over sit in a 0.72
 * scope (ComponentPreview.astro) so their CODE reads dense, and a density scope shrinks a control
 * but deliberately never its glyph (core `semantic/_size.scss`). At 0.72 the sm box lands on the
 * 24px WCAG floor while the icon stays 20px: under 2px of air, and visibly smaller than every
 * other sm icon button on the page. The compaction is for the text; the one control sitting on top
 * of it opts back out.
 */}
<button
  class="sk-copy-button sk-button sk-interactive sk-icon-toggle sk-anchor"
  data-sk-clipboard
  data-sk-clipboard-trigger
  data-target={target}
  data-variant="soft"
  data-size="sm"
  data-icon-only
  data-sk-density-scope
  type="button"
  aria-label={label ?? t("copy.code")}
>
  <span class="sk-copy-button__icon" data-face="idle" aria-hidden="true"><Fragment set:html={copyIcon} /></span>
  <span class="sk-copy-button__icon" data-face="copied" aria-hidden="true"><Fragment set:html={copiedIcon} /></span>
  <span class="sk-copy-button__label" data-sk-clipboard-status aria-live="polite"></span>
  <span
    class="sk-copy-button__feedback sk-anchored"
    data-sk-clipboard-feedback
    data-sk-placement="inline-start"
    aria-hidden="true"
  >
    <span data-sk-clipboard-feedback-text="copied">{t("copy.copied")}</span>
    <span data-sk-clipboard-feedback-text="error">{t("copy.error")}</span>
    <span class="sk-anchored-arrow" aria-hidden="true"></span>
  </span>
</button>
