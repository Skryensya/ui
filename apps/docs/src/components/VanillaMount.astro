---
/*
 * One installation contract for every enhanced docs page.
 *
 * `initComponents()` is the async selector manifest: it imports only enhancer types found below the
 * chosen root. A named mount remains the smallest seam when the caller already knows the one module
 * it ships.
 */
import CodeBlock from "./CodeBlock.astro";
import { getLocale, localizePath, useTranslations } from "../i18n";
import { vanillaMountSections } from "../lib/vanilla-mount-sections";

interface Props {
  name: string;
  entrypoint: string;
  mount: string;
  selector: string;
  /**
   * Every OTHER page has this land as a page-level section, `<h2>`/`<h3>`. The accordion pilot
   * composes it INSIDE a tab panel instead (`hideVanillaMount` on `Base`, see the note there),
   * one level deeper than a normal top-of-page section: "h3" shifts both headings down a step
   * so the outline still nests correctly under that panel's own `<h2>`.
   */
  headingLevel?: "h2" | "h3";
}

const { name, entrypoint, mount, selector, headingLevel = "h2" } = Astro.props;
const Title = headingLevel === "h3" ? "h3" : "h2";
const Section = headingLevel === "h3" ? "h4" : "h3";
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/*
 * The same three sections `Base.astro` puts in the rail, from the same list (`../lib/
 * vanilla-mount-sections.ts`), so the anchors it links to are the ids rendered here. They used to
 * be assigned in the browser by the layout's heading scan, which is exactly the runtime work the
 * build-time index removed.
 */
const [titleSection, autoSection, onlySection] = vanillaMountSections(t, name);

/*
 * The full explanation of `initComponents()` (the map-not-a-list-of-imports shape, idempotence,
 * scoping the scan to a root) used to be repeated inline on every page that mounts this component
 * (copy paste, ~17 places at last count). It now lives once at `/montaje-automatico`
 * (`/en/automatic-mounting`), and this paragraph only orients the reader toward it; the same
 * `{link}` splice `accordion.intro` already used for its own cross-reference.
 */
const autoLink = `<a href="${localizePath("/montaje-automatico", locale)}">${t("vanilla.autoLinkLabel")}</a>`;

const install = `pnpm add @skryensya/core @skryensya/vanilla`;

const auto = `import { initComponents } from "@skryensya/vanilla/auto";

// ${t("vanilla.autoComment")}
await initComponents();`;

const component = `import { ${mount} } from "${entrypoint}";

// ${t("vanilla.componentComment", { name })}
${mount}();`;

const instance = `import { ${mount} } from "${entrypoint}";

const root = document.querySelector<HTMLElement>("${selector}");
if (root) ${mount}(root);`;
---

<Title id={titleSection.id}>{titleSection.label}</Title>
<p>{t("vanilla.intro")}</p>
<CodeBlock code={install} label="terminal" />

<Section id={autoSection.id}>{autoSection.label}</Section>
<p set:html={t("vanilla.autoBody", { autoLink })} />
<CodeBlock code={auto} label="JavaScript" />

<Section id={onlySection.id}>{onlySection.label}</Section>
<p>{t("vanilla.onlyBody", { name })}</p>
<CodeBlock code={component} label="JavaScript" />
<CodeBlock code={instance} label={t("vanilla.instance")} />
