---
/*
 * The mobile drawer's navigation: the WHOLE site index as ONE nested, collapsible tree, so a reader
 * on any page can reach any other without the drawer first deciding which section they are "in".
 * The desktop rail keeps its own `SidebarNav` (one section, always expanded): a persistent rail and
 * a summoned drawer answer different questions, the same split the rail and the `/components`
 * catalog already make.
 *
 * Structure is the `nav-list` pattern, nothing hand-rolled:
 *   - each documentation section is a `NavListGroup` with `collapsible`, the WAI-ARIA APG "Disclosure
 *     (Navigation)" pattern: the label IS a real <button aria-expanded>, the list it owns toggles `hidden`,
 *     and the vanilla enhancer (`data-sk-nav-list-group-trigger`) adds the generated `aria-controls`
 *     id and Escape-to-close. Not `role="menu"`: these are links, not application commands.
 *   - the section that contains the current page starts open; the rest start closed. This is the one
 *     place we override nav-list's "start open" default: three whole sections open at once turns the
 *     drawer back into the wall of links this change exists to replace.
 *   - a section with no children (Home, and Presets in prose) is a plain `NavListLink` in an
 *     unlabelled group; a disabled one (a dev-only page in a production build) is a non-navigating
 *     `<button>`. Templates and Presets are ordinary rows in this one tree now, not a rail of their
 *     own poured in above it: on a phone their in-page section rail is `display: none`, so their
 *     jump links ride in here as a collapsible section like every other page's.
 *
 * Every `href` is already resolved for the active locale by `getNavigation` / `getGlobalNavigation`
 * upstream (translated route where the page exists, default-locale route where it does not), so no
 * link here can 404 on a locale that has the page.
 */
import { getLocale, useTranslations } from "../i18n";
import NavGroupItems from "./NavGroupItems.astro";
import type { NavigationItem, NavigationSection } from "../lib/navigation";

/** A `NavigationSection`, or a synthetic one the layout builds for Templates / Presets. */
export type DrawerSection = Omit<NavigationSection, "id"> & {
  id: string;
  /** Prod build, dev-only page: render the label as a disabled `<button>`, not a link. */
  disabled?: boolean;
};

interface Props {
  /** The documentation sections plus any synthetic ones, hrefs already locale-resolved, in order. */
  sections: readonly DrawerSection[];
  /** The site root link. */
  home: NavigationItem;
  /** The current path, `/`-trimmed, already in this locale's vocabulary. */
  path: string;
}

const { sections, home, path } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const sectionContainsPath = (section: DrawerSection): boolean =>
  section.href === path ||
  section.groups.some((group) => group.items.some((item) => item.href === path));

/*
 * Every section keeps its AUTHORED order (Fundamentos' "Arquitectura → Tiers → Tokens" is a reading path,
 * not an alphabet), and a section whose groups are `collapsible` (the component catalog) keeps its groups:
 * each becomes a disclosure nested inside the section's own, the same shape the rail draws. Any other
 * section is flattened, because a nav-list `<ul>` has no legal slot for a visible sub-label.
 */
const hasCollapsibleGroups = (section: DrawerSection): boolean => section.groups.some((group) => group.collapsible);
const itemsFor = (section: DrawerSection): readonly NavigationItem[] => section.groups.flatMap((group) => group.items);
const holdsCurrentPage = (items: readonly NavigationItem[]): boolean => items.some((item) => item.href === path);
---

<nav class="sk-nav-list docs-drawer-nav" aria-label={t("nav.siteNav")}>
  <div class="sk-nav-list__group">
    <ul class="sk-nav-list__list" role="list">
      <li class="sk-nav-list__item">
        <a
          class="sk-nav-list__link sk-interactive"
          href={home.href}
          aria-current={path === home.href ? "page" : undefined}
        >
          <span class="sk-nav-list__label">{home.label}</span>
        </a>
      </li>
    </ul>
  </div>

  {
    sections.map((section) => {
      const items = itemsFor(section);

      /* No children: a plain link (or a disabled button on a prod build of a dev-only page). Same
         shape as the Home row above, so it reads as one more top-level destination, not an empty
         disclosure. */
      if (items.length === 0) {
        return (
          <div class="sk-nav-list__group">
            <ul class="sk-nav-list__list" role="list">
              <li class="sk-nav-list__item">
                {section.disabled || !section.href ? (
                  <button
                    class="sk-nav-list__link sk-interactive"
                    type="button"
                    disabled
                    title={t("nav.comingSoon")}
                    aria-label={t("nav.comingSoon")}
                  >
                    <span class="sk-nav-list__label">{section.section}</span>
                  </button>
                ) : (
                  <a
                    class="sk-nav-list__link sk-interactive"
                    href={section.href}
                    aria-current={path === section.href ? "page" : undefined}
                  >
                    <span class="sk-nav-list__label">{section.section}</span>
                  </a>
                )}
              </li>
            </ul>
          </div>
        );
      }

      const open = sectionContainsPath(section);
      return (
        <div class="sk-nav-list__group" data-collapsible data-default-open={open ? undefined : "false"}>
          <button
            class="sk-nav-list__group-label sk-interactive"
            type="button"
            data-sk-nav-list-group-trigger
            aria-expanded={open ? "true" : "false"}
          >
            {section.section}
          </button>
          <ul class="sk-nav-list__list" role="list" data-sk-nav-list-group-list hidden={!open}>
            {section.href && (
              <li class="sk-nav-list__item">
                <a
                  class="sk-nav-list__link sk-interactive"
                  href={section.href}
                  aria-current={path === section.href ? "page" : undefined}
                >
                  <span class="sk-nav-list__label">{t("nav.sectionOverview")}</span>
                </a>
              </li>
            )}
            {hasCollapsibleGroups(section) ? (
              section.groups.map((group, groupIndex) => {
                const labelId = `docs-drawer-${section.id}-${groupIndex}`;
                const groupOpen = holdsCurrentPage(group.items);
                return (
                  <li class="sk-nav-list__item">
                    <div class="sk-nav-list__group" data-collapsible data-default-open={groupOpen ? undefined : "false"}>
                      <button
                        class="sk-nav-list__group-label sk-interactive"
                        type="button"
                        id={labelId}
                        data-sk-nav-list-group-trigger
                        data-nav-group-trigger={group.id}
                        data-nav-group-active={groupOpen ? "true" : "false"}
                        aria-expanded={groupOpen ? "true" : "false"}
                        aria-controls={`${labelId}-list`}
                      >
                        {group.group}
                      </button>
                      <ul class="sk-nav-list__list" role="list" id={`${labelId}-list`} data-sk-nav-list-group-list hidden={!groupOpen}>
                        <NavGroupItems items={group.items} path={path} />
                      </ul>
                    </div>
                  </li>
                );
              })
            ) : (
              <NavGroupItems items={items} path={path} />
            )}
          </ul>
        </div>
      );
    })
  }
</nav>
