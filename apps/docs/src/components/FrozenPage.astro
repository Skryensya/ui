---
/*
 * THE FRAME EVERY ARCHIVED PAGE WEARS: the version banner, the date it was cut, and the way back to
 * the living page.
 *
 * It exists because the archive is not a components feature. A frozen version is a whole site
 * (ADR-0022), so a foundations page, a pattern page and a component page are frozen by the same
 * mechanism and must announce themselves the same way. Anything a snapshot page needs that is NOT
 * its own baked content belongs here, once, rather than in each page that happens to be archived.
 *
 * WHAT IT DELIBERATELY DOES NOT DO is read anything live. The title and the copy arrive as props
 * from the page, which baked them at the cut; the only live thing on the screen is the chrome around
 * the document, and the banner is what tells the reader that the chrome and the content are from
 * different days.
 */
import "@skryensya/core/components/callout.css";
import Base from "../layouts/Base.astro";
import { canonicalPath, getLocale, localizePath, useTranslations } from "../i18n";

interface Props {
  /** The archived page's own title, as it read at the cut. */
  title: string;
  /** Its description, likewise baked. */
  description: string;
  /** The version this archive is, written the way the release ledger writes it. */
  version: string;
  /** The day of the cut, ISO. Rendered in the reader's locale. */
  frozenAt: string;
  /**
   * Say that the interactive examples are not part of this archive. True for a page whose live
   * version carries demos (a component); false for one that is prose and tokens either way, where
   * the note would name an absence the reader was never going to look for.
   */
  demosOmitted?: boolean;
  /** Page layout, passed through to `Base` unchanged. */
  documentLayout?: "column" | "grid";
}

const { title, description, version, frozenAt, demosOmitted = false, documentLayout = "grid" } = Astro.props;

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const canonical = canonicalPath(Astro.url.pathname);
const latestHref = localizePath(canonical, locale, null);

/* `timeZone: "UTC"`, or the build machine's offset moves the cut date by a day: a tag dated the
 * 30th rendered as the 29th for anyone west of Greenwich, this machine included. */
const frozenDate = new Intl.DateTimeFormat(locale === "es" ? "es-CL" : "en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${frozenAt}T00:00:00Z`));
---

<Base title={title} description={description} documentLayout={documentLayout}>
  <div class="sk-callout" data-tone="warning">
    <div class="sk-callout__content">
      <p><strong>{t("version.frozenTitle", { number: version, date: frozenDate })}</strong></p>
      <p>{t("version.frozenBody")}</p>
      <p><a href={latestHref}>{t("version.frozenLink")}</a></p>
    </div>
  </div>

  <h1>{title}</h1>
  {demosOmitted && <p><em>{t("version.noDemos")}</em></p>}

  <slot />
</Base>
