---
/*
 * The reference tab: the contract itself, as JSON.
 *
 * It used to be tables. Every option, slot and part was read off the compiled contract and laid out
 * in six of them, plus a per-signature list, plus the same object again as JSON at the foot of the
 * page: one truth stated twice on one screen, with the reader scrolling past the reading to reach
 * the thing being read.
 *
 * A CONTRACT IS A VALUE (decision 28), which is exactly why this can be so short. The object below
 * is the one the validator, both bindings and the MCP server consume, with no extraction step
 * between it and them, and it is the same shape `get_contract` answers with, so a reader here and an
 * agent there are looking at one thing. There is nothing a table could add that the value does not
 * already say, and nothing a table could get wrong that a build would catch.
 *
 * `template` and `wiring` come along now, and that is a change of promise rather than an oversight.
 * The tables deliberately hid them: they are how a binding realizes the contract, the emitter writes
 * that markup (decision 29), and a reader who needs the template to use the component is a reader
 * the emitter failed. But this is no longer a reading with things left out of it, it is the artifact.
 */
import CodeBlock from "./CodeBlock.astro";
import { contractDoc, contractJson } from "../lib/contract-reference";
import { getLocale, useTranslations } from "../i18n";

interface Props {
  /** The contract id, as `packages/core` declares it and the manifest keys it. */
  id: string;
  heading?: string;
}

const { id, heading } = Astro.props;
const t = useTranslations(getLocale(Astro.url));

const contract = contractDoc(id);
---

<h2>{heading ?? t("contract.title")}</h2>

{/* `open`, because here the code IS the page. Disclosure earns its place when a long block would
    bury the prose after it; this tab has no prose after it, so a toggle would only hide five sixths
    of the one thing the reader came for. */}
<CodeBlock code={contractJson(contract)} label={`${contract.id}.json`} lang="json" open />
