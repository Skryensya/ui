# Docs site only (@skryensya/docs). Build context must be the monorepo root.
# Dokploy: Dockerfile path = Dockerfile.docs

FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@10.18.2 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages
COPY contracts ./contracts
COPY evals ./evals
COPY artifacts ./artifacts
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile

# Filter builds docs and its workspace dependencies (core CSS, icons, compiler, …).
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN pnpm turbo run build --filter=@skryensya/docs

FROM nginx:1.27-alpine AS runtime

COPY nginx.docs.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/docs/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
