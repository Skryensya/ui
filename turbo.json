{
  "$schema": "https://turbo.build/schema.json",
  // Read by a task but owned by no package, so nothing else hashes them.
  // `ai-compiler`'s check runs `tsx src/cli.ts ../..`, which compiles the contracts from the repo
  // root; `inputs` cannot reach outside a package, so without these two globs editing a contract left
  // every hash untouched and `check` replayed a green log without ever re-validating the change.
  // `contracts/snippets` is a workspace package and hashes through the dependency graph already;
  // these two are plain directories and do not.
  "globalDependencies": [
    "contracts/semantic/**",
    "contracts/changelog/**"
  ],
  "tasks": {
    "check": {
      "dependsOn": [
        "^check",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "scss/**",
        "css/**",
        "contrast-pairs.json",
        "scripts/**",
        "src/**",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "scss/**",
        "css/**",
        "src/**",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": [
        "dist/**",
        "css/**"
      ]
    },
    /* The browser gates, kept OUT of `check` on purpose: about 19 minutes, and load-sensitive
     * enough that a red result on a contended machine is weak evidence (CONTRIBUTING says so at
     * length). `pnpm check:gates` runs this; `pnpm check` no longer has to filter the package out,
     * because ai-gates' own `check` is now the cheap half: a typecheck plus the two deterministic
     * gates that never needed a browser. */
    "test:browser": {
      "cache": false,
      "persistent": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
