{
  "$schema": "./_meta.json",
  "id": "select-native",
  "consume": {
    "css": "@skryensya/core/components/select.css",
    "prefer": "react"
  },
  "surfaces": {
    "NativeSelect": {
      "use": "native selection",
      "element": "select",
      "react": {
        "from": "@skryensya/react/select-native",
        "name": "NativeSelect"
      }
    }
  },
  "rules": {
    "accessibleName": "NativeSelect has no visible label of its own; pair it with a <label htmlFor> or provide aria-label.",
    "select": "Use Select instead when the closed/open visuals must be custom-styled beyond what the platform picker allows."
  },
  "examples": {
    "NativeSelect": {
      "labelled": "<NativeSelect aria-label=\"Plan\" name=\"plan\" options={plans} />",
      "children": "<NativeSelect aria-label=\"Country\" name=\"country\"><option value=\"cl\">Chile</option><option value=\"ar\">Argentina</option></NativeSelect>"
    }
  }
}
