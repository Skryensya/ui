{
  "$schema": "./_meta.json",
  "id": "select",
  "consume": {
    "css": [
      "@skryensya/core/patterns/anchored.css",
      "@skryensya/core/components/select.css"
    ],
    "prefer": "react",
    "vanilla": {
      "classes": ["sk-select"],
      "attributes": ["data-sk-select"],
      "init": {
        "from": "@skryensya/vanilla/auto",
        "name": "initComponents"
      }
    }
  },
  "surfaces": {
    "Select": {
      "use": "custom-styled single selection",
      "element": "button",
      "react": {
        "from": "@skryensya/react/select",
        "name": "Select"
      },
      "requires": ["options"]
    }
  },
  "rules": {
    "options": "Give every option a stable value and label.",
    "select-native": "Use NativeSelect instead when the platform's own picker UI is acceptable and the Zag dependency is not worth pulling in."
  },
  "examples": {
    "Select": {
      "labelled": "<Select label=\"Plan\" options={plans} placeholder=\"Choose a plan\" />",
      "controlled": "<Select onValueChange={setPlan} options={plans} value={plan} />"
    }
  }
}
