{
  "$schema": "./_meta.json",
  "id": "layout",
  "consume": {
    "css": "@skryensya/core/patterns/layout.css",
    "prefer": "react"
  },
  "surfaces": {
    "Box": {
      "use": "surface, padding and border wrapper",
      "element": "div",
      "react": {
        "from": "@skryensya/react/layout",
        "name": "Box"
      }
    },
    "Stack": {
      "use": "vertical rhythm",
      "element": "div",
      "react": {
        "from": "@skryensya/react/layout",
        "name": "Stack"
      }
    },
    "Inline": {
      "use": "horizontal row, wraps by default",
      "element": "div",
      "react": {
        "from": "@skryensya/react/layout",
        "name": "Inline"
      }
    },
    "Grid": {
      "use": "fixed-column grid",
      "element": "div",
      "react": {
        "from": "@skryensya/react/layout",
        "name": "Grid"
      }
    },
    "Wrapper": {
      "use": "max-width reading column",
      "element": "div",
      "react": {
        "from": "@skryensya/react/layout",
        "name": "Wrapper"
      }
    }
  },
  "props": {
    "gap": ["none", "xs", "sm", "md", "lg", "xl"],
    "padding": ["none", "xs", "sm", "md", "lg", "xl"],
    "surface": ["none", "sunken", "surface", "raised"],
    "border": ["none", "subtle", "default"],
    "align": ["start", "center", "end", "stretch"],
    "justify": ["start", "center", "end", "between"],
    "size": ["sm", "md", "lg", "full"]
  },
  "meanings": {
    "surface": {
      "none": "transparent, inherits the page background",
      "sunken": "recessed, e.g. a code block or input well",
      "surface": "the default card/panel background",
      "raised": "elevated above surface, e.g. a popover body"
    },
    "size": {
      "sm": "narrow reading column",
      "md": "default column width",
      "lg": "wide column",
      "full": "no max-width cap"
    }
  },
  "children": ["any"],
  "rules": {
    "as": "Every surface is polymorphic: pass as to render a different host element (e.g. Stack as=\"section\") without changing props or classes.",
    "Grid.columns": "A fixed integer 1-4, not a responsive prop; there is no auto-fit mode. Pick the columns value for the narrowest viewport this Grid must support.",
    "Inline.wrap": "Boolean, true by default. Set false only when the row must never wrap, e.g. a fixed toolbar.",
    "Box.padding": "Independent from surface and border — a Box can have surface=\"none\" and still take padding for spacing alone.",
    "composition": "These are the primitives every other component's layout is built from (Card, Toolbar, form rows, …); reach for one of these before writing a bespoke flex/grid div."
  },
  "examples": {
    "Box": {
      "panel": "<Box surface=\"surface\" border=\"subtle\" padding=\"md\">Content</Box>"
    },
    "Stack": {
      "form": "<Stack gap=\"sm\"><Input label=\"Name\" /><Input label=\"Email\" /></Stack>"
    },
    "Inline": {
      "actions": "<Inline gap=\"sm\" justify=\"end\"><Button variant=\"neutral\">Cancel</Button><Button variant=\"primary\">Save</Button></Inline>"
    },
    "Grid": {
      "cards": "<Grid columns={3} gap=\"md\"><Card /><Card /><Card /></Grid>"
    },
    "Wrapper": {
      "article": "<Wrapper size=\"md\"><Heading>Title</Heading><Text>Body copy.</Text></Wrapper>"
    }
  }
}
