{
  "$schema": "./_meta.json",
  "id": "switch",
  "consume": {
    "css": "@skryensya/core/components/switch.css",
    "prefer": "react"
  },
  "surfaces": {
    "Switch": {
      "use": "preference that takes effect immediately",
      "element": "input",
      "react": {
        "from": "@skryensya/react/switch",
        "name": "Switch"
      }
    }
  },
  "children": ["text"],
  "rules": {
    "accessibleName": "Provide children as the visible label, or aria-label when there is no visible text.",
    "selection": "Use Checkbox instead when the choice is submitted with a form and confirmed by an explicit action, not applied immediately."
  },
  "examples": {
    "Switch": {
      "label": "<Switch defaultChecked name=\"auto-deploy\">Deploy automatically</Switch>",
      "standalone": "<Switch aria-label=\"Dark mode\" checked={dark} name=\"dark-mode\" onCheckedChange={toggleDark} />"
    }
  }
}
