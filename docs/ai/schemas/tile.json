{
  "$schema": "./_meta.json",
  "id": "tile",
  "consume": {
    "css": [
      "@skryensya/core/components/tile.css",
      "@skryensya/core/components/checkbox.css",
      "@skryensya/core/components/switch.css",
      "@skryensya/core/patterns/state-layer.css"
    ],
    "prefer": "react"
  },
  "surfaces": {
    "TileButton": {
      "use": "surface action",
      "element": "button",
      "react": {
        "from": "@skryensya/react/tile-button",
        "name": "TileButton"
      },
      "forbids": ["href"]
    },
    "TileLink": {
      "use": "surface navigation",
      "element": "a",
      "react": {
        "from": "@skryensya/react/tile-link",
        "name": "TileLink"
      },
      "requires": ["href"],
      "forbids": ["disabled"]
    },
    "TileCheckbox": {
      "use": "independent surface selection",
      "element": "label",
      "react": {
        "from": "@skryensya/react/tile-checkbox",
        "name": "TileCheckbox"
      }
    },
    "TileSwitch": {
      "use": "surface preference that takes effect immediately",
      "element": "label",
      "react": {
        "from": "@skryensya/react/tile-switch",
        "name": "TileSwitch"
      }
    },
    "TileRadioGroup": {
      "use": "exclusive surface selection",
      "element": "div",
      "react": {
        "from": "@skryensya/react/tile-radio-group",
        "name": "TileRadioGroup"
      },
      "requires": ["items", "name"],
      "props": {
        "orientation": [null, "horizontal", "vertical"]
      }
    },
    "ExpandableTile": {
      "use": "surface disclosure",
      "element": "section",
      "react": {
        "from": "@skryensya/react/expandable-tile",
        "name": "ExpandableTile"
      },
      "requires": ["ExpandableTile.Trigger", "ExpandableTile.Content"],
      "props": {
        "as": [null, "section", "article", "div"]
      }
    }
  },
  "props": {
    "padding": ["md", "none", "xs", "sm", "lg", "xl"]
  },
  "rules": {
    "TileButton.href": "Use TileLink for navigation.",
    "TileLink.disabled": "Render a non-link surface when the destination is unavailable.",
    "interaction": "A Tile owns exactly one interaction; use Box when content contains independent controls.",
    "TileRadioGroup.items": "Give every item a stable value and content.",
    "ExpandableTile": "Place Trigger and Content directly inside the same ExpandableTile root."
  },
  "examples": {
    "TileButton": {
      "action": "<TileButton onClick={deploy}>Run deployment</TileButton>"
    },
    "TileLink": {
      "navigation": "<TileLink href=\"/reports\">Open reports</TileLink>"
    },
    "TileCheckbox": {
      "selection": "<TileCheckbox name=\"alerts\" value=\"enabled\">Enable alerts</TileCheckbox>"
    },
    "TileSwitch": {
      "preference": "<TileSwitch name=\"auto-deploy\" defaultChecked>Deploy automatically</TileSwitch>"
    },
    "TileRadioGroup": {
      "selection": "<TileRadioGroup defaultValue=\"pro\" items={plans} name=\"plan\" />"
    },
    "ExpandableTile": {
      "disclosure": "<ExpandableTile><ExpandableTile.Trigger>Details</ExpandableTile.Trigger><ExpandableTile.Content>Deployment details</ExpandableTile.Content></ExpandableTile>"
    }
  }
}
