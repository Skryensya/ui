{
  "$schema": "./_meta.json",
  "id": "loader",
  "consume": {
    "css": "@skryensya/core/components/loader.css",
    "prefer": "react"
  },
  "surfaces": {
    "Loader": {
      "use": "indeterminate work indicator",
      "element": "span",
      "react": {
        "from": "@skryensya/react/loader",
        "name": "Loader"
      }
    }
  },
  "props": {
    "size": ["md", "sm", "lg"],
    "variant": ["ring", "sweep", "bars", "dots"],
    "speed": ["normal", "fast", "slow"]
  },
  "meanings": {
    "size": {
      "sm": "inline beside text or inside a small control",
      "md": "default standalone loading region",
      "lg": "a full section or page is loading"
    },
    "variant": {
      "ring": "default, neutral motion",
      "sweep": "an alternate continuous motion",
      "bars": "a denser, multi-element motion",
      "dots": "a compact motion for tight spaces"
    },
    "speed": {
      "fast": "short expected waits",
      "normal": "typical expected waits",
      "slow": "long expected waits, to avoid an anxious rhythm"
    }
  },
  "rules": {
    "label": "Omit label to keep Loader decorative beside an already-labelled status; provide it when Loader is the only status text."
  },
  "examples": {
    "Loader": {
      "decorative": "<Loader />",
      "labelled": "<Loader label=\"Guardando cambios\" size=\"sm\" variant=\"dots\" />"
    }
  }
}
