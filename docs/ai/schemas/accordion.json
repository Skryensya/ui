{
  "$schema": "./_meta.json",
  "id": "accordion",
  "consume": {
    "css": [
      "@skryensya/core/components/accordion.css",
      "@skryensya/core/components/tile.css",
      "@skryensya/core/patterns/state-layer.css"
    ],
    "prefer": "react",
    "vanilla": {
      "classes": ["sk-accordion"],
      "attributes": ["data-sk-accordion"],
      "init": {
        "from": "@skryensya/vanilla/auto",
        "name": "initComponents"
      }
    }
  },
  "surfaces": {
    "Accordion": {
      "use": "stack of mutually framed disclosures",
      "element": "div",
      "react": {
        "from": "@skryensya/react/accordion",
        "name": "Accordion"
      },
      "requires": ["Accordion.Item", "Accordion.Trigger", "Accordion.Content"]
    }
  },
  "props": {
    "type": ["single", "multiple"],
    "collapsible": [false, true]
  },
  "meanings": {
    "type": {
      "single": "only one item can stay open at a time",
      "multiple": "several items can stay open together"
    }
  },
  "rules": {
    "Accordion": "Nest Accordion.Item, Accordion.Trigger and Accordion.Content directly inside the same Accordion, one Item per entry, each with a stable value.",
    "collapsible": "With type=\"single\", collapsible lets the open item close again by activating its own trigger.",
    "frame": "Accordion frames its items into one bordered stack; a lone disclosure that doesn't need that framing is an ExpandableTile instead."
  },
  "examples": {
    "Accordion": {
      "single": "<Accordion type=\"single\"><Accordion.Item value=\"shipping\"><Accordion.Trigger>Envío</Accordion.Trigger><Accordion.Content>Entrega en 3 días.</Accordion.Content></Accordion.Item><Accordion.Item value=\"returns\"><Accordion.Trigger>Devoluciones</Accordion.Trigger><Accordion.Content>30 días para devolver.</Accordion.Content></Accordion.Item></Accordion>",
      "multiple": "<Accordion type=\"multiple\"><Accordion.Item value=\"shipping\"><Accordion.Trigger>Envío</Accordion.Trigger><Accordion.Content>Entrega en 3 días.</Accordion.Content></Accordion.Item></Accordion>"
    }
  }
}
