{
  "$schema": "./_meta.json",
  "id": "checkbox",
  "consume": {
    "css": [
      "@skryensya/core/components/checkbox.css",
      "@skryensya/core/patterns/state-layer.css"
    ],
    "prefer": "react"
  },
  "surfaces": {
    "Checkbox": {
      "use": "independent selection",
      "element": "input",
      "react": {
        "from": "@skryensya/react/checkbox",
        "name": "Checkbox"
      }
    }
  },
  "children": ["text"],
  "rules": {
    "accessibleName": "Provide children as the visible label, or aria-label when there is no visible text.",
    "indeterminate": "Pass checked=\"indeterminate\" for a partial selection state; it still submits as unchecked."
  },
  "examples": {
    "Checkbox": {
      "label": "<Checkbox name=\"terms\" onCheckedChange={setTerms}>Accept terms</Checkbox>",
      "standalone": "<Checkbox aria-label=\"Select row\" name=\"row-1\" />"
    }
  }
}
