{
  "$schema": "./_meta.json",
  "id": "navbar",
  "consume": {
    "css": [
      "@skryensya/core/components/navbar.css",
      "@skryensya/core/patterns/nav-list.css"
    ],
    "prefer": "react"
  },
  "surfaces": {
    "Navbar": {
      "use": "site header bar",
      "element": "header",
      "react": {
        "from": "@skryensya/react/navbar",
        "name": "Navbar"
      }
    },
    "NavbarBrand": {
      "use": "brand or logo slot",
      "element": "div",
      "react": {
        "from": "@skryensya/react/navbar",
        "name": "NavbarBrand"
      }
    },
    "NavbarActions": {
      "use": "trailing actions slot",
      "element": "div",
      "react": {
        "from": "@skryensya/react/navbar",
        "name": "NavbarActions"
      }
    }
  },
  "children": ["NavList"],
  "composes": {
    "NavList": {
      "from": "@skryensya/react/nav-list",
      "name": "NavList"
    }
  },
  "rules": {
    "NavList": "Put the site links inside Navbar as a NavList with orientation=\"horizontal\"; the sidebar hosts the same list vertically instead of a second one that could drift.",
    "actions": "Place trailing controls like a theme toggle or an account menu inside NavbarActions; it pushes to the end of the bar."
  },
  "examples": {
    "Navbar": {
      "basic": "<Navbar><NavbarBrand>Acme</NavbarBrand><NavList orientation=\"horizontal\"><NavListLink href=\"/\" current>Inicio</NavListLink></NavList><NavbarActions><Button variant=\"ghost\">Salir</Button></NavbarActions></Navbar>"
    },
    "NavbarBrand": {
      "logo": "<NavbarBrand>Acme</NavbarBrand>"
    },
    "NavbarActions": {
      "trailing": "<NavbarActions><Button variant=\"ghost\">Salir</Button></NavbarActions>"
    }
  }
}
