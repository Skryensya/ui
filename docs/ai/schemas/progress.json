{
  "$schema": "./_meta.json",
  "id": "progress",
  "consume": {
    "css": "@skryensya/core/components/progress.css",
    "prefer": "react"
  },
  "surfaces": {
    "Progress": {
      "use": "determinate completion status",
      "element": "div",
      "react": {
        "from": "@skryensya/react/progress",
        "name": "Progress"
      },
      "requires": ["value"]
    }
  },
  "props": {
    "tone": ["accent", "success", "warning", "danger"]
  },
  "meanings": {
    "tone": {
      "accent": "ordinary in-progress completion",
      "success": "the tracked operation finished favorably",
      "warning": "completion is at risk or nearing a limit",
      "danger": "the tracked operation is failing"
    }
  },
  "rules": {
    "value": "Progress is determinate; it always needs a known value out of max.",
    "label": "Provide label for the bar's accessible name, or wrap it in an already-labelled region."
  },
  "examples": {
    "Progress": {
      "basic": "<Progress label=\"Subiendo archivo\" value={72} />",
      "danger": "<Progress label=\"Uso de cuota\" tone=\"danger\" value={95} />"
    }
  }
}
