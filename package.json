{
  "name": "skryensya-ui",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24"
  },
  "description": "Turborepo for skryensya/ui. Core contains tokens and the framework-agnostic component contract.",
  "scripts": {
    "lint": "turbo run lint",
    "check": "turbo run check --concurrency=1",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^24.13.3"
    }
  }
}
